@page "/Approval"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using System.Security.Claims
@using UT_WMSDotnet.Models
@using WMS_UnitedTracors_Blazor.Services
@inject ApprovalService ApprovalService
@inject TransactionService TransactionService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>WMS - Approvals</PageTitle>

<div class="py-8 bg-[#f5f4f0] min-h-screen font-sans">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="mb-6">
            <h1 class="text-[1.6rem] font-bold text-[#1a1a1a] leading-none tracking-tight">Persetujuan <span class="text-[#e8a000]">Admin</span></h1>
            <div class="text-[0.72rem] font-medium text-[#a09e99] mt-1">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</div>
        </div>

        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="mb-6 flex items-center gap-3 bg-[#eef9f0] border border-[#b8e8c0] text-[#1a7a30] px-4 py-3 rounded-lg text-sm font-semibold">
                <svg class="w-4 h-4 shrink-0 text-[#1a7a30]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                @SuccessMessage
            </div>
        }
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="mb-6 flex items-center gap-3 bg-[#fef0f0] border border-[#f8c0c0] text-[#d94040] px-4 py-3 rounded-lg text-sm font-semibold">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                @ErrorMessage
            </div>
        }

        <!-- Tabs -->
        <div class="flex items-center gap-2 mb-6 border-b border-[#e5e3dc] pb-1 overflow-x-auto">
            <button @onclick='() => ActiveTab = "new"' class="px-4 py-2 text-sm font-bold rounded-lg transition-all @(ActiveTab == "new" ? "bg-[#1a1a1a] text-white" : "text-[#8a8880] hover:text-[#1a1a1a] hover:bg-[#faf9f5]")">
                New Requests
                @if (GroupedApprovals?.Count > 0)
                {
                    <span class="ml-1.5 px-1.5 py-0.5 rounded-full text-[10px] @(ActiveTab == "new" ? "bg-[#e8a000] text-[#1a1a1a]" : "bg-[#e5e3dc] text-[#1a1a1a]")">@GroupedApprovals.Count</span>
                }
            </button>
            <button @onclick='() => ActiveTab = "handovers"' class="px-4 py-2 text-sm font-bold rounded-lg transition-all @(ActiveTab == "handovers" ? "bg-[#1a1a1a] text-white" : "text-[#8a8880] hover:text-[#1a1a1a] hover:bg-[#faf9f5]")">
                Serah Terima
                @if (GroupedHandovers?.Count > 0)
                {
                    <span class="ml-1.5 px-1.5 py-0.5 rounded-full text-[10px] @(ActiveTab == "handovers" ? "bg-[#e8a000] text-[#1a1a1a]" : "bg-[#e5e3dc] text-[#1a1a1a]")">@GroupedHandovers.Count</span>
                }
            </button>
            <button @onclick='() => ActiveTab = "returns"' class="px-4 py-2 text-sm font-bold rounded-lg transition-all @(ActiveTab == "returns" ? "bg-[#1a1a1a] text-white" : "text-[#8a8880] hover:text-[#1a1a1a] hover:bg-[#faf9f5]")">
                Returns
                @if (PendingReturns?.Count > 0)
                {
                    <span class="ml-1.5 px-1.5 py-0.5 rounded-full text-[10px] @(ActiveTab == "returns" ? "bg-[#e8a000] text-[#1a1a1a]" : "bg-[#e5e3dc] text-[#1a1a1a]")">@PendingReturns.Count</span>
                }
            </button>
            <button @onclick='() => ActiveTab = "profiles"' class="px-4 py-2 text-sm font-bold rounded-lg transition-all @(ActiveTab == "profiles" ? "bg-[#1a1a1a] text-white" : "text-[#8a8880] hover:text-[#1a1a1a] hover:bg-[#faf9f5]")">
                Profile Updates
                @if (PendingProfileRequests?.Count > 0)
                {
                    <span class="ml-1.5 px-1.5 py-0.5 rounded-full text-[10px] @(ActiveTab == "profiles" ? "bg-[#e8a000] text-[#1a1a1a]" : "bg-[#e5e3dc] text-[#1a1a1a]")">@PendingProfileRequests.Count</span>
                }
            </button>
        </div>

        @if (ActiveTab == "new")
        {
            @if (GroupedApprovals == null)
            {
                <div class="bg-white p-12 rounded-xl border border-[#e5e3dc] text-center shadow-sm text-gray-500">Loading requests...</div>
            }
            else if (GroupedApprovals.Count == 0)
            {
                <div class="bg-white p-12 rounded-xl border border-[#e5e3dc] text-center shadow-sm">
                    <svg class="w-12 h-12 text-[#d1d0cb] mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
                    <p class="text-sm font-bold text-[#8a8880] tracking-wide">No pending requests at the moment.</p>
                </div>
            }
            else
            {
                var borrowGroups = GroupedApprovals.Where(g => g.Value.FirstOrDefault()?.request_type == "BORROW").ToList();
                var giveawayGroups = GroupedApprovals.Where(g => g.Value.FirstOrDefault()?.request_type == "GIVEAWAY").ToList();

                @if (giveawayGroups.Count > 0)
                {
                    <div class="mb-8">
                        <h3 class="text-sm font-bold text-gray-900 mb-3 uppercase tracking-wider">Giveaway Requests</h3>
                        <div class="space-y-4">
                            @foreach (var group in giveawayGroups)
                            {
                                @RenderGroup(group)
                            }
                        </div>
                    </div>
                }

                @if (borrowGroups.Count > 0)
                {
                    <div class="mb-8">
                        <h3 class="text-sm font-bold text-gray-900 mb-3 uppercase tracking-wider">Borrow Requests</h3>
                        <div class="space-y-4">
                            @foreach (var group in borrowGroups)
                            {
                                @RenderGroup(group)
                            }
                        </div>
                    </div>
                }

                @* Batch action bar — sticky di bawah agar tidak tertukar dengan "Approve All" per-grup *@
                <div class="sticky bottom-4 z-20 mt-6 flex justify-end">
                    <button type="button" @onclick="OpenBatchConfirmModal" disabled="@(Decisions.Count == 0 || IsProcessing)"
                            class="inline-flex items-center gap-2 px-6 py-3 bg-[#1a1a1a] text-white text-sm font-bold rounded-xl shadow-lg hover:bg-[#333] transition disabled:opacity-40 disabled:shadow-none">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                        Process Selected Items (@Decisions.Count)
                    </button>
                </div>
            }
        }
        else if (ActiveTab == "handovers")
        {
            @if (GroupedHandovers == null || GroupedHandovers.Count == 0)
            {
                <div class="bg-white p-12 rounded-xl border border-[#e5e3dc] text-center shadow-sm">
                    <p class="text-sm font-bold text-[#8a8880] tracking-wide">No pending handovers.</p>
                </div>
            }
            else
            {
                <div class="space-y-4">
                    @foreach (var group in GroupedHandovers)
                    {
                        var firstItem = group.Value.First();
                        var isWaitingInput = group.Value.Any(i => i.status == WorkflowStatuses.WaitingHandover);
                        var isWaitingUserConfirm = group.Value.Any(i => i.status == WorkflowStatuses.WaitingHandoverConfirm && i.handover_uploaded_by == "USER");
                        var isWaitingVerification = group.Value.Any(i => i.status == WorkflowStatuses.WaitingAdminHandover);
                        var isGiveawayHandover = group.Value.All(i => i.request_type == "GIVEAWAY");
                        <div class="bg-white rounded-xl border border-[#e5e3dc] shadow-sm overflow-hidden animate-fadeIn">
                            <div class="px-5 py-4 border-b border-[#f0ede5] flex flex-col sm:flex-row sm:items-center justify-between bg-gray-50/50 gap-4">
                                <div>
                                    <h4 class="font-bold text-[#1a1a1a]">Event: @(firstItem.event_name ?? "-")</h4>
                                    <div class="text-xs text-gray-500 mt-1">Pemohon: @(firstItem.applicant_name ?? firstItem.Requester?.name) | @(group.Value.Count) Items</div>
                                    <div class="mt-2">
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-[11px] font-bold uppercase tracking-[0.08em] @(isWaitingVerification ? "bg-[#eef9f0] text-[#1a7a30] border border-[#b8e8c0]" : isWaitingUserConfirm ? "bg-[#e0f2fe] text-[#1a6b8a] border border-[#bae6fd]" : "bg-[#fffbeb] text-[#b77900] border border-[#f3d37a]")">
                                            @(isWaitingVerification ? "Menunggu Verifikasi Admin" : isWaitingUserConfirm ? "Menunggu Konfirmasi SI" : "Menunggu Input Serah Terima")
                                        </span>
                                    </div>
                                </div>
                                <div class="flex gap-2">
                                    @if (isWaitingInput)
                                    {
                                        <button type="button" @onclick="() => OpenApprovalHandoverModal(group.Value)" class="px-4 py-2 bg-[#e8a000] text-[#1a1a1a] text-xs font-bold rounded-lg shadow-sm hover:bg-[#d49300] transition">
                                            @(TransactionService.HasStoredFiles(firstItem.handover_photo) ? "Ubah Draft Serah Terima" : "Isi Form Serah Terima")
                                        </button>
                                        @if (TransactionService.HasStoredFiles(firstItem.handover_photo))
                                        {
                                            <button type="button" @onclick='() => AskConfirm(isGiveawayHandover ? "Selesaikan Serah Terima" : "Submit Serah Terima", isGiveawayHandover ? "Selesaikan serah terima giveaway ini? Stok akan dipotong dan sistem akan menunggu dokumentasi user." : "Kirim bukti serah terima ke admin untuk diverifikasi?", () => SubmitApprovalHandover(group.Value), isGiveawayHandover ? "Ya, Selesaikan" : "Ya, Submit")' disabled="@IsProcessing" class="px-4 py-2 bg-[#1a7a30] text-white text-xs font-bold rounded-lg shadow-sm hover:bg-[#166528] transition disabled:opacity-50">
                                                @(isGiveawayHandover ? "Selesaikan Serah Terima" : "Submit ke Verifikasi")
                                            </button>
                                        }
                                    }
                                    @if (isWaitingUserConfirm)
                                    {
                                        <button type="button" @onclick='() => AskConfirm("Konfirmasi Serah Terima", "Konfirmasi penerimaan bukti serah terima ini?", () => ConfirmHandoverBySi(group.Key, true), "Ya, Konfirmasi")' disabled="@IsProcessing" class="px-4 py-2 bg-[#1a7a30] text-white text-xs font-bold rounded-lg shadow-sm hover:bg-[#166528] transition disabled:opacity-50">Konfirmasi Serah Terima</button>
                                        <button type="button" @onclick='() => AskConfirm("Tolak Serah Terima", "Tolak bukti serah terima ini?", () => ConfirmHandoverBySi(group.Key, false), "Ya, Tolak")' disabled="@IsProcessing" class="px-4 py-2 bg-white border border-red-200 text-red-600 text-xs font-bold rounded-lg hover:bg-red-50 transition disabled:opacity-50">Tolak</button>
                                    }
                                    @if (isWaitingVerification)
                                    {
                                        <button type="button" @onclick='() => AskConfirm("Approve Serah Terima", "Setujui bukti serah terima ini? Barang akan tercatat sebagai sedang dipinjam.", () => ApproveHandoverBatch(group.Key), "Ya, Setujui")' disabled="@IsProcessing" class="px-4 py-2 bg-gray-900 text-white text-xs font-bold rounded-lg shadow-sm hover:bg-gray-800 transition">Approve Handover</button>
                                        <button type="button" @onclick="() => OpenHandoverRejectModal(group.Key)" class="px-4 py-2 bg-white border border-red-200 text-red-600 text-xs font-bold rounded-lg hover:bg-red-50 transition">Reject Proof</button>
                                    }
                                </div>
                            </div>
                            
                            <div class="overflow-x-auto">
                                <table class="w-full text-left border-collapse">
                                    <thead>
                                        <tr class="bg-white border-b border-gray-100">
                                            <th class="p-4 pl-6 text-[10px] font-bold uppercase tracking-wider text-[#8a8880] w-1/3">Item</th>
                                            <th class="p-4 text-[10px] font-bold uppercase tracking-wider text-[#8a8880] w-12">Qty</th>
                                            <th class="p-4 text-[10px] font-bold uppercase tracking-wider text-[#8a8880]">Bukti & Catatan</th>
                                            <th class="p-4 text-[10px] font-bold uppercase tracking-wider text-[#8a8880]">Status</th>
                                            <th class="p-4 pr-6 text-[10px] font-bold uppercase tracking-wider text-[#8a8880] text-right">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-gray-100">
                                        @foreach (var item in group.Value)
                                        {
                                            var parsedFiles = TransactionService.ParseStoredFiles(item.handover_photo);
                                            <tr class="hover:bg-gray-50/50 transition">
                                                <td class="p-4 pl-6 align-middle">
                                                    <div class="flex items-center gap-3">
                                                        <div class="w-9 h-9 rounded border border-gray-200 overflow-hidden flex-shrink-0 bg-white flex items-center justify-center">
                                                            <img src="@ImageHelper.ResolveProduct(item.Product, "/img/logo.svg")" class="w-full h-full object-cover">
                                                        </div>
                                                        <div>
                                                            <div class="font-bold text-gray-900 text-sm">@(item.Product?.name)</div>
                                                            <div class="flex flex-wrap items-center gap-2 mt-0.5">
                                                                <code class="text-[10px] text-gray-500 bg-white border border-gray-100 px-1.5 py-0.5 rounded">@(item.Product?.sku)</code>
                                                                @if (item.request_type == "BORROW")
                                                                {
                                                                    <span class="inline-flex items-center gap-1 bg-blue-50 text-blue-700 px-1.5 py-0.5 rounded border border-blue-100 text-[10px] font-semibold">
                                                                        Pinjam: @(item.borrow_start_date?.ToString("dd MMM yyyy") ?? "-") s/d @(item.expected_return_date?.ToString("dd MMM yyyy") ?? "-")
                                                                    </span>
                                                                }
                                                                else if (item.request_type == "GIVEAWAY")
                                                                {
                                                                    <span class="inline-flex items-center gap-1 bg-purple-50 text-purple-700 px-1.5 py-0.5 rounded border border-purple-100 text-[10px] font-semibold">
                                                                        Pengambilan: @(item.pickup_date?.ToString("dd MMM yyyy") ?? "-")
                                                                    </span>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="p-4 align-middle text-sm font-semibold text-[#1a1a1a]">
                                                    @item.quantity
                                                </td>
                                                <td class="p-4 align-middle">
                                                    <div class="flex flex-col gap-1.5">
                                                        @if (parsedFiles.Any())
                                                        {
                                                            <div class="flex gap-1.5">
                                                                @foreach (var file in parsedFiles.Take(3))
                                                                {
                                                                    <div class="w-9 h-9 rounded border border-[#e5e3dc] overflow-hidden bg-white shrink-0">
                                                                        @if (file.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                                                                        {
                                                                            <a href="@($"/{file.TrimStart('/')}")" target="_blank" class="w-full h-full flex items-center justify-center bg-red-50">
                                                                                <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                                                                            </a>
                                                                        }
                                                                        else
                                                                        {
                                                                            <a href="@($"/{file.TrimStart('/')}")" target="_blank" data-image-popup>
                                                                                <img src="@($"/{file.TrimStart('/')}")" class="w-full h-full object-cover" />
                                                                            </a>
                                                                        }
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                        @if (!string.IsNullOrEmpty(item.handover_notes))
                                                        {
                                                            <span class="text-[10px] text-gray-500 italic max-w-[150px] truncate block" title="@item.handover_notes">"@item.handover_notes"</span>
                                                        }
                                                    </div>
                                                </td>
                                                <td class="p-4 align-middle">
                                                    <span class="inline-flex items-center px-2 py-0.5 border rounded text-[10px] font-bold @(GetHandoverStatusClass(item.status))">
                                                        @GetHandoverStatusLabel(item.status)
                                                    </span>
                                                    @if (item.status == WorkflowStatuses.WaitingHandover && !string.IsNullOrEmpty(item.rejection_reason))
                                                    {
                                                        <div class="text-[9px] text-[#d94040] mt-1 max-w-[150px]" title="@item.rejection_reason">Ditolak: "@item.rejection_reason"</div>
                                                    }
                                                </td>
                                                <td class="p-4 pr-6 align-middle text-right">
                                                    <div class="flex justify-end gap-2 flex-wrap">
                                                        @if (item.status == WorkflowStatuses.WaitingHandover)
                                                        {
                                                            <button type="button" @onclick="() => OpenApprovalHandoverModal(new List<Transaction> { item })" class="px-3 py-1.5 bg-[#e8a000] text-[#1a1a1a] text-xs font-bold rounded-lg shadow-sm hover:bg-[#d49300] transition">
                                                                @(TransactionService.HasStoredFiles(item.handover_photo) ? "Ubah" : "Isi Bukti")
                                                            </button>
                                                            @if (TransactionService.HasStoredFiles(item.handover_photo))
                                                            {
                                                                <button type="button" @onclick='() => AskConfirm(item.request_type == "GIVEAWAY" ? "Selesaikan Serah Terima" : "Submit Serah Terima", item.request_type == "GIVEAWAY" ? "Selesaikan serah terima giveaway ini?" : "Kirim bukti serah terima ke admin?", () => SubmitApprovalHandover(new List<Transaction> { item }), "Ya, Kirim")' disabled="@IsProcessing" class="px-3 py-1.5 bg-[#1a7a30] text-white text-xs font-bold rounded-lg shadow-sm hover:bg-[#166528] transition disabled:opacity-50">
                                                                    Submit
                                                                </button>
                                                            }
                                                        }
                                                        else if (item.status == WorkflowStatuses.WaitingAdminHandover)
                                                        {
                                                            <button type="button" @onclick='() => AskConfirm("Approve Serah Terima", "Setujui bukti serah terima ini?", () => ApproveHandoverItem(item.id), "Ya, Setujui")' disabled="@IsProcessing" class="px-3 py-1.5 bg-gray-900 text-white text-xs font-bold rounded-lg shadow-sm hover:bg-gray-800 transition">Approve</button>
                                                            <button type="button" @onclick="() => OpenHandoverItemRejectModal(item.id)" class="px-3 py-1.5 bg-white border border-red-200 text-red-600 text-xs font-bold rounded-lg hover:bg-red-50 transition">Reject</button>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>
            }
        }
        else if (ActiveTab == "returns")
        {
            @if (PendingReturns == null || PendingReturns.Count == 0)
            {
                <div class="bg-white p-12 rounded-xl border border-[#e5e3dc] text-center shadow-sm">
                    <p class="text-sm font-bold text-[#8a8880] tracking-wide">No pending returns.</p>
                </div>
            }
            else
            {
                <div class="space-y-4">
                    @foreach (var item in PendingReturns)
                    {
                        <div class="bg-white rounded-xl border border-[#e5e3dc] shadow-sm overflow-hidden">
                            <div class="px-5 py-4 border-b border-[#f0ede5] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                                <div class="flex items-center gap-3 min-w-0">
                                    <div class="w-12 h-12 rounded-lg border border-[#e5e3dc] overflow-hidden bg-white shrink-0">
                                        <img src="@ImageHelper.ResolveProduct(item.Product, "/img/logo.svg")" class="w-full h-full object-cover">
                                    </div>
                                    <div class="min-w-0">
                                        <h4 class="font-bold text-[#1a1a1a] truncate">@item.Product?.name</h4>
                                        <div class="text-xs text-gray-500 mt-1">Pemohon: @(item.applicant_name ?? item.Requester?.name) | Pengembalian: @item.pending_return_quantity dari @item.quantity</div>
                                    </div>
                                </div>
                                <div class="flex gap-2 shrink-0">
                                    <button type="button" @onclick='() => AskConfirm("Approve Pengembalian", "Setujui pengembalian ini? Stok akan dikembalikan dan tindakan ini tidak bisa dibatalkan.", () => ApproveReturn(item.id), "Ya, Setujui")' disabled="@IsProcessing" class="px-4 py-2 bg-gray-900 text-white text-xs font-bold rounded-lg shadow-sm hover:bg-gray-800 transition disabled:opacity-50">Approve Pengembalian</button>
                                    <button type="button" @onclick="() => OpenRejectModal(item.id, true)" class="px-4 py-2 bg-white border border-red-200 text-red-600 text-xs font-bold rounded-lg hover:bg-red-50 transition">Reject</button>
                                </div>
                            </div>

                            <div class="p-4 bg-gray-50/50 flex flex-col md:flex-row gap-6">
                                <div class="w-32 h-32 rounded-lg border border-[#e5e3dc] overflow-hidden bg-white shrink-0">
                                    @if (!string.IsNullOrEmpty(item.return_photo) && item.return_photo != "forced-by-admin")
                                    {
                                        <a href="@ImageHelper.Resolve(item.return_photo)" target="_blank" data-image-popup>
                                            <img src="@ImageHelper.Resolve(item.return_photo)" class="w-full h-full object-cover" />
                                        </a>
                                    }
                                    else { <div class="w-full h-full flex items-center justify-center text-[10px] text-gray-300">No Photo</div> }
                                </div>
                                <div class="flex-1">
                                    <h5 class="text-[10px] font-bold text-[#8a8880] uppercase mb-1">Kondisi Barang</h5>
                                    <p class="text-xs text-[#5a5855] font-semibold capitalize">@(item.return_status ?? "-")</p>

                                    @if (!string.IsNullOrEmpty(item.return_reason))
                                    {
                                        <h5 class="text-[10px] font-bold text-[#8a8880] uppercase mb-1 mt-3">Catatan / Alasan</h5>
                                        <p class="text-xs text-[#5a5855] italic">"@item.return_reason"</p>
                                    }

                                    <div class="mt-4">
                                        <h5 class="text-[10px] font-bold text-[#8a8880] uppercase mb-2">Detail Item</h5>
                                        <div class="flex flex-wrap gap-2">
                                            <div class="px-2 py-1 bg-white border border-[#e5e3dc] rounded text-[10px] font-semibold text-[#1a1a1a]">SKU: @item.Product?.sku</div>
                                            <div class="px-2 py-1 bg-white border border-[#e5e3dc] rounded text-[10px] font-semibold text-[#1a1a1a]">Dipinjam: @item.quantity</div>
                                            <div class="px-2 py-1 bg-amber-50 border border-amber-200 rounded text-[10px] font-semibold text-amber-700">Diajukan kembali: @item.pending_return_quantity</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
        else if (ActiveTab == "profiles")
        {
            @if (PendingProfileRequests == null || PendingProfileRequests.Count == 0)
            {
                <div class="bg-white p-12 rounded-xl border border-[#e5e3dc] text-center shadow-sm text-gray-500">No profile updates pending.</div>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    @foreach (var pr in PendingProfileRequests)
                    {
                        <div class="bg-white border border-[#e5e3dc] rounded-xl p-5 shadow-sm">
                            <div class="flex items-center gap-3 mb-4">
                                <div class="w-10 h-10 rounded-full bg-[#e8a000] flex items-center justify-center text-xs font-bold text-[#1a1a1a]">@pr.User?.name?.Substring(0, 2).ToUpper()</div>
                                <div>
                                    <h4 class="text-sm font-bold text-[#1a1a1a]">@pr.User?.name</h4>
                                    <p class="text-[10px] text-[#8a8880]">@pr.created_at?.ToString("dd MMM yyyy")</p>
                                </div>
                            </div>
                            <div class="space-y-2 mb-4 p-3 bg-gray-50 rounded-lg">
                                <div class="text-[10px] text-gray-400 uppercase font-bold">Proposed NRP</div>
                                <div class="text-xs font-bold">@pr.nrp</div>
                                <div class="text-[10px] text-gray-400 uppercase font-bold mt-2">Proposed Division</div>
                                <div class="text-xs font-bold">@pr.Division?.name</div>
                            </div>
                            <div class="flex gap-2">
                                <button @onclick='() => AskConfirm("Approve Perubahan Profil", "Setujui perubahan data profil ini? Data user akan diperbarui.", () => ApproveProfileRequest(pr.id), "Ya, Setujui")' class="flex-1 py-2 bg-gray-900 text-white text-xs font-bold rounded-lg hover:bg-gray-800 transition">Approve</button>
                                <button @onclick='() => AskConfirm("Tolak Perubahan Profil", "Tolak permintaan perubahan profil ini?", () => RejectProfileRequest(pr.id), "Ya, Tolak")' class="flex-1 py-2 bg-white border border-red-200 text-red-600 text-xs font-bold rounded-lg hover:bg-red-50 transition">Reject</button>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

