@page "/Tracking"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using UT_WMSDotnet.Models
@using UT_WMSDotnet.ViewModels
@using WMS_UnitedTracors_Blazor.Services
@inject TransactionService TransactionService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Tracking & Returns</PageTitle>

<div class="px-4 md:px-10 py-6 pb-24 font-sans bg-[#f5f4f0] min-h-screen">
    <div class="flex justify-between items-center mb-6">
        <h2 class="font-semibold text-xl text-gray-800 leading-tight">Return Items / Tracking</h2>
    </div>

    @if (!string.IsNullOrEmpty(SuccessMessage))
    {
        <div class="mb-4 bg-green-50 text-green-700 px-4 py-3 rounded-lg text-sm border border-green-200">@SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="mb-4 bg-red-50 text-red-700 px-4 py-3 rounded-lg text-sm border border-red-200">@ErrorMessage</div>
    }

    <div class="bg-white rounded-xl shadow-sm border border-[#e5e3dc] overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="bg-[#faf9f5] border-b border-[#e5e3dc]">
                        <th class="py-3 px-6 text-xs font-bold text-[#8a8880] uppercase tracking-wider">Transaksi</th>
                        <th class="py-3 px-6 text-xs font-bold text-[#8a8880] uppercase tracking-wider">Produk</th>
                        <th class="py-3 px-6 text-xs font-bold text-[#8a8880] uppercase tracking-wider text-center">Qty</th>
                        <th class="py-3 px-6 text-xs font-bold text-[#8a8880] uppercase tracking-wider">Status Kembali</th>
                        <th class="py-3 px-6 text-xs font-bold text-[#8a8880] uppercase tracking-wider text-right">Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[#f0ede5]">
                    @if (Transactions == null)
                    {
                        <tr><td colspan="5" class="p-6 text-center text-gray-500">Loading...</td></tr>
                    }
                    else if (!Transactions.Any())
                    {
                        <tr><td colspan="5" class="p-6 text-center text-gray-500">Tidak ada data peminjaman.</td></tr>
                    }
                    else
                    {
                        @foreach (var t in Transactions)
                        {
                            int remaining = (t.quantity ?? 0) - (t.returned_quantity ?? 0) - (t.pending_return_quantity ?? 0);
                            
                            <tr class="hover:bg-[#faf9f5]">
                                <td class="py-3 px-6">
                                    <div class="text-sm font-bold text-[#1a1a1a]">@t.event_name</div>
                                    <div class="text-xs text-[#8a8880]">@t.created_at.ToString("dd MMM yyyy")</div>
                                </td>
                                <td class="py-3 px-6">
                                    <div class="text-sm font-bold text-[#1a1a1a]">@(t.Product?.name ?? "-")</div>
                                    <div class="text-xs text-[#8a8880]">@(t.Product?.sku ?? "-")</div>
                                </td>
                                <td class="py-3 px-6 text-sm text-center font-bold text-[#1a1a1a]">
                                    @t.quantity
                                </td>
                                <td class="py-3 px-6">
                                    @if (t.returned_quantity >= t.quantity)
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-[#eef9f0] text-[#1a7a30] border border-[#b8e8c0]">Selesai</span>
                                    }
                                    else if (t.pending_return_quantity > 0 && t.is_return_draft != 0)
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-[#ede9fe] text-[#6d28d9] border border-[#c4b5fd]">Draft (@t.pending_return_quantity)</span>
                                    }
                                    else if (t.pending_return_quantity > 0 && t.is_return_draft == 0)
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-[#e0f2fe] text-[#1a6b8a] border border-[#bae6fd]">Menunggu ACC (@t.pending_return_quantity)</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-[#fff8e6] text-[#b37a00] border border-[#ffe099]">Belum Kembali (@remaining)</span>
                                    }
                                </td>
                                <td class="py-3 px-6 text-right">
                                    @if (t.is_return_draft != 0 && t.pending_return_quantity > 0)
                                    {
                                        <button @onclick='() => SubmitBatch(t.created_at, t.requester_id, t.applicant_name ?? "")' class="text-purple-600 hover:text-purple-800 text-xs font-bold mr-3">Ajukan Draft</button>
                                        <button @onclick="() => CancelDraft(t.id)" class="text-red-600 hover:text-red-800 text-xs font-bold">Batal Draft</button>
                                    }
                                    else if (remaining > 0)
                                    {
                                        <button @onclick="() => OpenReturnModal(t)" class="px-3 py-1.5 bg-yellow-500 hover:bg-yellow-600 text-black text-xs font-bold rounded shadow-sm transition">
                                            Return Item
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (TotalPages > 1)
        {
            <div class="px-6 py-4 border-t border-[#f0ede5] flex justify-between items-center bg-[#faf9f5]">
                <span class="text-xs text-[#8a8880]">Halaman @CurrentPage dari @TotalPages</span>
                <div class="flex gap-2">
                    <button disabled="@(CurrentPage == 1)" @onclick="() => LoadData(CurrentPage - 1)" class="px-3 py-1 bg-white border border-[#e5e3dc] rounded text-sm disabled:opacity-50 hover:bg-gray-50">Prev</button>
                    <button disabled="@(CurrentPage == TotalPages)" @onclick="() => LoadData(CurrentPage + 1)" class="px-3 py-1 bg-white border border-[#e5e3dc] rounded text-sm disabled:opacity-50 hover:bg-gray-50">Next</button>
                </div>
            </div>
        }
    </div>
</div>

@if (ShowReturnModal && SelectedTransaction != null)
{
    <div class="fixed inset-0 z-[70] flex min-h-full items-center justify-center p-4 text-center">
        <div class="fixed inset-0 backdrop-blur-sm bg-black/60 transition-opacity" @onclick="CloseReturnModal"></div>
        <div class="relative transform overflow-hidden rounded-xl bg-white text-left shadow-2xl transition-all w-full max-w-md border border-[#e5e3dc] z-10">
            <div class="px-6 py-4 border-b border-[#f0ede5] flex items-center justify-between">
                <h3 class="font-bold text-[#1a1a1a] text-lg">Pengembalian Barang</h3>
                <button type="button" @onclick="CloseReturnModal" class="text-[#a09e99] hover:text-[#1a1a1a] transition font-bold text-xl">&times;</button>
            </div>
            <div class="p-6">
                <p class="text-sm text-gray-600 mb-4">Mengembalikan <strong class="text-gray-900">@(SelectedTransaction.Product?.name)</strong>.</p>
                <div class="mb-4">
                    <label class="block text-sm font-bold text-gray-700 mb-1">Jumlah Kembali</label>
                    <input type="number" @bind="ReturnModel.return_quantity" min="1" max="@((SelectedTransaction.quantity ?? 0) - (SelectedTransaction.returned_quantity ?? 0))" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm" />
                </div>
                <div class="mb-4">
                    <label class="block text-sm font-bold text-gray-700 mb-1">Status Barang</label>
                    <select @bind="ReturnModel.return_status" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm">
                        <option value="baik">Baik (Good)</option>
                        <option value="rusak">Rusak (Damaged)</option>
                        <option value="hilang">Hilang (Lost)</option>
                    </select>
                </div>
                @if (ReturnModel.return_status == "rusak" || ReturnModel.return_status == "hilang")
                {
                    <div class="mb-4">
                        <label class="block text-sm font-bold text-gray-700 mb-1">Alasan</label>
                        <textarea @bind="ReturnModel.return_reason" rows="2" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm resize-none"></textarea>
                    </div>
                }
                
                <div class="flex justify-end gap-3 mt-6">
                    <button type="button" @onclick="CloseReturnModal" class="px-5 py-2.5 bg-gray-100 text-gray-700 font-bold rounded-lg hover:bg-gray-200 transition">Batal</button>
                    <button type="button" @onclick="SaveReturn" disabled="@IsSaving" class="px-5 py-2.5 bg-yellow-500 text-black font-bold rounded-lg hover:bg-yellow-600 transition disabled:opacity-50">
                        @(IsSaving ? "Menyimpan..." : "Simpan Draft")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Transaction>? Transactions;
    private int CurrentPage = 1;
    private int TotalPages = 1;

    private int CurrentUserId = 0;
    private string? UserRole;

    private bool ShowReturnModal = false;
    private bool IsSaving = false;
    private string? ErrorMessage;
    private string? SuccessMessage;
    
    private Transaction? SelectedTransaction;
    private ReturnItemViewModel ReturnModel = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            if (int.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out int id))
                CurrentUserId = id;
            UserRole = user.FindFirst(ClaimTypes.Role)?.Value;
        }

        await LoadData(1);
    }

    private async Task LoadData(int page)
    {
        CurrentPage = page;
        var result = await TransactionService.GetHistoryAsync(CurrentUserId, UserRole, "OUT", null, null, CurrentPage, 20);
        // Filter in memory for simplicity to only show APPROVED BORROW OUT
        Transactions = result.Transactions.Where(t => t.request_type == "BORROW" && t.status == "APPROVED").ToList();
        TotalPages = result.TotalPages;
    }

    private void OpenReturnModal(Transaction t)
    {
        SelectedTransaction = t;
        int remaining = (t.quantity ?? 0) - (t.returned_quantity ?? 0) - (t.pending_return_quantity ?? 0);
        ReturnModel = new ReturnItemViewModel
        {
            transaction_id = t.id,
            return_quantity = remaining,
            return_status = "baik"
        };
        ShowReturnModal = true;
        ErrorMessage = null;
        SuccessMessage = null;
    }

    private void CloseReturnModal()
    {
        ShowReturnModal = false;
        SelectedTransaction = null;
    }

    private async Task SaveReturn()
    {
        IsSaving = true;
        ErrorMessage = null;
        SuccessMessage = null;

        var err = await TransactionService.ReturnItemAsync(ReturnModel);
        if (err != null)
        {
            ErrorMessage = err;
        }
        else
        {
            SuccessMessage = "Draft pengembalian berhasil disimpan.";
            CloseReturnModal();
            await LoadData(CurrentPage);
        }

        IsSaving = false;
    }

    private async Task CancelDraft(int id)
    {
        ErrorMessage = null;
        SuccessMessage = null;
        
        var err = await TransactionService.CancelReturnDraftAsync(id);
        if (err != null) ErrorMessage = err;
        else
        {
            SuccessMessage = "Draft dibatalkan.";
            await LoadData(CurrentPage);
        }
    }

    private async Task SubmitBatch(DateTime createdAt, int requesterId, string applicantName)
    {
        ErrorMessage = null;
        SuccessMessage = null;
        
        var groupId = TransactionService.CreateGroupId(createdAt, requesterId, applicantName);
        var err = await TransactionService.SubmitReturnBatchAsync(groupId);
        if (err != null) ErrorMessage = err;
        else
        {
            SuccessMessage = "Draft berhasil diajukan untuk disetujui.";
            await LoadData(CurrentPage);
        }
    }
}
