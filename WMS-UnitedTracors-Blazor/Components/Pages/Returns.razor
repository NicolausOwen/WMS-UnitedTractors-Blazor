@page "/Returns"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Web
@using UT_WMSDotnet.Models
@using UT_WMSDotnet.ViewModels
@using WMS_UnitedTracors_Blazor.Services
@inject TransactionService TransactionService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Tracking & Returns</PageTitle>

<div class="py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <h2 class="font-semibold text-xl text-gray-800 leading-tight mb-6">
            Return Items / Tracking
        </h2>

        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="mb-6 bg-[#eef9f0] border border-[#b8e8c0] text-[#1a7a30] px-5 py-4 rounded-xl flex items-center gap-3">
                <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <p class="text-sm font-semibold">@SuccessMessage</p>
            </div>
        }
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="mb-6 bg-[#fef0f0] border border-[#f8c0c0] text-[#d94040] px-5 py-4 rounded-xl flex items-center gap-3">
                <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <p class="text-sm font-semibold">@ErrorMessage</p>
            </div>
        }

        <div class="bg-white rounded-xl border border-[#e5e3dc] mb-6 overflow-hidden shadow-sm">
            <div class="px-5 py-4">
                <div class="flex flex-col lg:flex-row flex-wrap gap-3 items-end">
                    <div class="flex-1 min-w-[180px] w-full">
                        <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Search Product</label>
                        <div class="relative">
                            <input type="text" placeholder="Search..." @bind="SearchQuery" @bind:event="oninput" @onkeydown="HandleSearchKeyDown"
                                class="block w-full pl-9 pr-3 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none transition-colors duration-150 text-[#1a1a1a]">
                            <svg class="w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                        </div>
                    </div>
                    <div class="min-w-[150px] w-full lg:w-auto">
                        <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Return Status</label>
                        <select @bind="StatusFilter" class="block w-full px-3 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none transition-colors duration-150 text-[#1a1a1a]">
                            <option value="">All Types</option>
                            <option value="pending">Borrowed (Pending Return)</option>
                            <option value="returned">Borrowed (Returned)</option>
                        </select>
                    </div>
                    <div class="flex gap-2 w-full lg:w-auto justify-end">
                        <button type="button" @onclick="() => LoadData(1)" class="px-5 py-2 bg-[#e8a000] hover:bg-[#d49300] text-[#1a1a1a] text-xs font-bold rounded-lg transition active:scale-95 cursor-pointer whitespace-nowrap">
                            Apply
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="space-y-4">
            @if (GroupedUsages == null || !GroupedUsages.Any())
            {
                <div class="bg-white rounded-xl border border-[#e5e3dc] p-16 text-center shadow-sm">
                    <div class="w-16 h-16 bg-[#f5f4f0] rounded-full flex items-center justify-center mx-auto mb-4">
                        <svg class="w-8 h-8 text-[#8a8780]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/></svg>
                    </div>
                    <h3 class="text-lg font-bold text-[#1a1a1a] mb-1">Tidak ada data</h3>
                    <p class="text-sm text-[#8a8780]">Belum ada barang yang sedang dipinjam atau perlu dikembalikan.</p>
                </div>
            }
            else
            {
                @foreach (var group in GroupedUsages)
                {
                    var groupId = group.Key;
                    var groupItems = group.Value;
                    var firstItem = groupItems.First();
                     int totalItems = groupItems.Select(i => i.quantity ?? 0).Sum();
                     int totalReturned = groupItems.Select(i => i.returned_quantity ?? 0).Sum();
                    bool allReturned = totalReturned >= totalItems;
                    bool isExpanded = ExpandedGroups.Contains(groupId);

                    <div class="bg-white rounded-xl border border-[#e5e3dc] overflow-hidden shadow-sm transition-all duration-200">
                        <div @onclick="() => ToggleGroup(groupId)" 
                             class="px-5 py-4 cursor-pointer hover:bg-[#faf9f5] transition flex items-center justify-between gap-4">
                            
                            <div class="flex items-center gap-4 flex-1 min-w-0">
                                <div class="w-10 h-10 rounded-full bg-[#f5f4f0] border border-[#e5e3dc] flex items-center justify-center shrink-0">
                                    <svg class="w-5 h-5 text-[#e8a000]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-2 mb-1">
                                        <h3 class="font-syne font-bold text-[#1a1a1a] truncate">@(firstItem.event_name ?? "Peminjaman Barang")</h3>
                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#f5f4f0] text-[#8a8780] border border-[#e5e3dc]">@(groupItems.Count()) Items</span>
                                        @if (allReturned) {
                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#eef9f0] text-[#1a7a30] border border-[#b8e8c0]">Selesai</span>
                                        } else {
                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#fff8e6] text-[#b37a00] border border-[#ffe099]">Sedang Dipinjam</span>
                                        }
                                    </div>
                                    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-gray-500">
                                        <div class="flex items-center gap-1.5">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                                            @(firstItem.applicant_name ?? firstItem.Requester?.name ?? "-")
                                        </div>
                                        <div class="flex items-center gap-1.5">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                            Pinjam: @(firstItem.created_at.ToString("dd MMM yyyy"))
                                        </div>
                                        @if (firstItem.expected_return_date.HasValue || firstItem.borrow_duration_days > 0) {
                                        <div class="flex items-center gap-1.5">
                                            <svg class="w-3.5 h-3.5 text-[#e8a000]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                            @if (firstItem.borrow_start_date.HasValue && firstItem.expected_return_date.HasValue) {
                                                @:Masa Pinjam: @firstItem.borrow_start_date.Value.ToString("dd MMM yyyy") - @firstItem.expected_return_date.Value.ToString("dd MMM yyyy")
                                            } else {
                                                @:Durasi: @(firstItem.borrow_duration_days > 0 ? firstItem.borrow_duration_days.ToString() + " Hari" : "-")
                                            }
                                        </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full flex items-center justify-center text-gray-400 group-hover:text-gray-600 group-hover:bg-[#f0ede5] transition">
                                    <svg class="w-5 h-5 transition-transform duration-200 @(isExpanded ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                                </div>
                            </div>
                        </div>

                        @if (isExpanded)
                        {
                            <div class="border-t border-[#e5e3dc] bg-[#faf9f5]">
                                <!-- Desktop Items Table -->
                                <div class="hidden md:block overflow-x-auto">
                                    <table class="w-full text-left border-collapse">
                                        <thead>
                                            <tr class="bg-[#f5f4f0] border-b border-[#e5e3dc]">
                                                <th class="px-5 py-3 text-[0.65rem] font-bold tracking-wider uppercase text-[#8a8780]">Product</th>
                                                <th class="px-5 py-3 text-[0.65rem] font-bold tracking-wider uppercase text-[#8a8780]">Qty Pinjam</th>
                                                <th class="px-5 py-3 text-[0.65rem] font-bold tracking-wider uppercase text-[#8a8780]">Status Pengembalian</th>
                                                <th class="px-5 py-3 text-[0.65rem] font-bold tracking-wider uppercase text-[#8a8780] text-right">Aksi</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-[#e5e3dc]">
                                            @foreach (var usage in groupItems) {
                                            <tr class="bg-white hover:bg-[#faf9f5] transition-colors">
                                                <td class="px-5 py-3.5 align-middle">
                                                    <div class="text-sm font-semibold text-[#1a1a1a]">@(usage.Product?.name ?? "-")</div>
                                                    <div class="flex items-center gap-2 mt-0.5">
                                                        <code class="text-[10px] text-gray-500 font-mono">@(usage.Product?.sku ?? "-")</code>
                                                    </div>
                                                </td>
                                                <td class="px-5 py-3.5 align-middle">
                                                     <span class="text-sm font-bold text-[#1a1a1a]">@(usage.quantity ?? 0)</span>
                                                    <span class="text-xs text-gray-500">@(usage.Product?.Unit?.name ?? "unit")</span>
                                                </td>
                                                <td class="px-5 py-3.5 align-middle">
                                                    @if (usage.returned_quantity >= usage.quantity) {
                                                        <span class="inline-flex items-center px-2 py-0.5 border border-[#b8e8c0] rounded text-[10px] font-bold bg-[#eef9f0] text-[#1a7a30]">
                                                            Sudah Kembali (@(usage.returned_quantity)/@(usage.quantity))
                                                        </span>
                                                    } else if (usage.pending_return_quantity > 0 && usage.is_return_draft != 0) {
                                                        <span class="inline-flex items-center px-2 py-0.5 border border-[#c4b5fd] rounded text-[10px] font-bold bg-[#ede9fe] text-[#6d28d9]">
                                                            DRAFT (@(usage.pending_return_quantity) @(usage.Product?.Unit?.name ?? "unit"))
                                                        </span>
                                                    } else if (usage.pending_return_quantity > 0 && usage.is_return_draft == 0) {
                                                        <span class="inline-flex items-center px-2 py-0.5 border border-[#bae6fd] rounded text-[10px] font-bold bg-[#e0f2fe] text-[#1a6b8a]">
                                                            Menunggu ACC (@(usage.pending_return_quantity))
                                                        </span>
                                                    } else {
                                                        <span class="inline-flex items-center px-2 py-0.5 border border-[#fde68a] rounded text-[10px] font-bold bg-[#fef3c7] text-[#92400e]">
                                                            Belum Kembali (@(usage.returned_quantity)/@(usage.quantity))
                                                        </span>
                                                    }
                                                </td>
                                                <td class="px-5 py-3.5 text-right align-middle">
                                                     @{
                                                         int remainingReturn = (usage.quantity ?? 0) - (usage.returned_quantity ?? 0) - (usage.pending_return_quantity ?? 0);
                                                     }

                                                    @if (usage.is_return_draft != 0 && usage.pending_return_quantity > 0) {
                                                        <div class="flex items-center justify-end gap-2">
                                                            <button type="button" @onclick="() => CancelDraft(usage.id)" class="inline-flex items-center gap-1 px-2.5 py-1.5 bg-[#fef0f0] border border-[#f8c0c0] hover:bg-[#fee2e2] text-[#d94040] rounded-lg text-xs font-bold transition cursor-pointer">
                                                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                                                                Batal
                                                            </button>
                                                        </div>
                                                    } else if (remainingReturn > 0) {
                                                        <button type="button" @onclick="() => OpenReturnModal(usage)" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-[#e8a000] border border-transparent hover:bg-[#d49300] text-[#1a1a1a] rounded-lg text-xs font-bold transition cursor-pointer">
                                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/></svg>
                                                            Return Item
                                                        </button>
                                                    }
                                                </td>
                                            </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <!-- Mobile Items Card View -->
                                <div class="block md:hidden divide-y divide-[#e5e3dc]">
                                    @foreach (var usage in groupItems) {
                                        <div class="p-4 flex flex-col gap-3 bg-white">
                                            <div class="flex justify-between items-start gap-2">
                                                <div class="text-left">
                                                    <div class="text-sm font-semibold text-[#1a1a1a]">@(usage.Product?.name ?? "-")</div>
                                                    <code class="text-[10px] text-gray-500 font-mono">@(usage.Product?.sku ?? "-")</code>
                                                </div>
                                                <div class="text-right">
                                                     <span class="text-sm font-bold text-[#1a1a1a]">Qty: @(usage.quantity ?? 0)</span>
                                                    <span class="text-xs text-gray-500">@(usage.Product?.Unit?.name ?? "unit")</span>
                                                </div>
                                            </div>
                                            
                                            <div class="flex items-center justify-between text-xs mt-1">
                                                <div class="text-left">
                                                    @if (usage.returned_quantity >= usage.quantity) {
                                                        <span class="inline-flex items-center px-2 py-0.5 border border-[#b8e8c0] rounded text-[10px] font-bold bg-[#eef9f0] text-[#1a7a30]">
                                                            Kembali (@(usage.returned_quantity)/@(usage.quantity))
                                                        </span>
                                                    } else if (usage.pending_return_quantity > 0 && usage.is_return_draft != 0) {
                                                        <span class="inline-flex items-center px-2 py-0.5 border border-[#c4b5fd] rounded text-[10px] font-bold bg-[#ede9fe] text-[#6d28d9]">
                                                            DRAFT (@(usage.pending_return_quantity))
                                                        </span>
                                                    } else if (usage.pending_return_quantity > 0 && usage.is_return_draft == 0) {
                                                        <span class="inline-flex items-center px-2 py-0.5 border border-[#bae6fd] rounded text-[10px] font-bold bg-[#e0f2fe] text-[#1a6b8a]">
                                                            Wait ACC (@(usage.pending_return_quantity))
                                                        </span>
                                                    } else {
                                                        <span class="inline-flex items-center px-2 py-0.5 border border-[#fde68a] rounded text-[10px] font-bold bg-[#fef3c7] text-[#92400e]">
                                                            Dipinjam (@(usage.returned_quantity)/@(usage.quantity))
                                                        </span>
                                                    }
                                                </div>
                                                <div class="text-right">
                                                     @{
                                                         int remainingReturn = (usage.quantity ?? 0) - (usage.returned_quantity ?? 0) - (usage.pending_return_quantity ?? 0);
                                                     }

                                                    @if (usage.is_return_draft != 0 && usage.pending_return_quantity > 0) {
                                                        <button type="button" @onclick="() => CancelDraft(usage.id)" class="inline-flex items-center gap-1 px-2.5 py-1.5 bg-[#fef0f0] border border-[#f8c0c0] hover:bg-[#fee2e2] text-[#d94040] rounded-lg text-xs font-bold transition cursor-pointer">
                                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                                                            Batal
                                                        </button>
                                                    } else if (remainingReturn > 0) {
                                                        <button type="button" @onclick="() => OpenReturnModal(usage)" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-[#e8a000] border border-transparent hover:bg-[#d49300] text-[#1a1a1a] rounded-lg text-xs font-bold transition cursor-pointer shadow-sm">
                                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/></svg>
                                                            Return
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>

                                 @{
                                     int totalDraft = groupItems.Where(i => i.is_return_draft != 0).Select(i => i.pending_return_quantity ?? 0).Sum();
                                     int totalPendingAcc = groupItems.Where(i => i.is_return_draft == 0).Select(i => i.pending_return_quantity ?? 0).Sum();
                                     bool allProcessed = (totalReturned + totalDraft + totalPendingAcc) >= totalItems;
                                 }

                                @if (totalDraft > 0) {
                                    @if (allProcessed) {
                                    <div class="px-5 py-4 bg-[#ede9fe] border-t border-[#c4b5fd] flex items-center justify-between">
                                        <div class="flex items-center gap-2">
                                            <svg class="w-4 h-4 text-[#6d28d9]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                            <span class="text-xs font-bold text-[#6d28d9]">@(groupItems.Count(i => i.is_return_draft != 0 && i.pending_return_quantity > 0)) item siap diajukan pengembalian</span>
                                        </div>
                                        <button type="button" @onclick="() => SubmitBatch(firstItem.created_at, firstItem.requester_id, firstItem.applicant_name ?? string.Empty)" class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#6d28d9] hover:bg-[#5b21b6] active:scale-[0.98] text-white text-xs font-bold tracking-wider rounded-lg transition cursor-pointer shadow-sm">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                            Ajukan Pengembalian
                                        </button>
                                    </div>
                                    } else {
                                    <div class="px-5 py-4 bg-[#fff8e6] border-t border-[#ffe099] flex items-center justify-between">
                                        <div class="flex items-center gap-2">
                                            <svg class="w-4 h-4 text-[#b37a00]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                                            <span class="text-xs font-bold text-[#b37a00]">Harap isi form pengembalian (kondisi & foto) untuk SEMUA barang di event ini sebelum dapat mengajukan.</span>
                                        </div>
                                    </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>

        @if (TotalPages > 1)
        {
            <div class="mt-4 shadow-sm border border-[#e5e3dc] rounded-xl overflow-hidden bg-white flex items-center justify-between px-6 py-4">
                <span class="text-sm text-gray-500 font-medium">Halaman @CurrentPage dari @TotalPages</span>
                <div class="flex gap-2">
                    <button disabled="@(CurrentPage == 1)" @onclick="() => LoadData(CurrentPage - 1)" class="px-3 py-1.5 border border-[#e5e3dc] rounded-md text-sm font-semibold hover:bg-gray-50 disabled:opacity-50 transition">Previous</button>
                    <button disabled="@(CurrentPage == TotalPages)" @onclick="() => LoadData(CurrentPage + 1)" class="px-3 py-1.5 border border-[#e5e3dc] rounded-md text-sm font-semibold hover:bg-gray-50 disabled:opacity-50 transition">Next</button>
                </div>
            </div>
        }
    </div>
</div>

@if (ShowReturnModal && SelectedTransaction != null)
{
    <div class="fixed inset-0 z-[70] flex min-h-full items-center justify-center p-4 text-center">
        <div class="fixed inset-0 backdrop-blur-sm bg-black/60 transition-opacity" @onclick="CloseReturnModal"></div>
        <div class="relative transform overflow-hidden rounded-xl bg-white text-left shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-md border border-[#e5e3dc] z-10">
            <div class="px-6 py-4 border-b border-[#f0ede5] flex items-center justify-between">
                <h3 class="font-syne text-[1.05rem] font-bold text-[#1a1a1a]">Pengembalian Barang</h3>
                <button type="button" @onclick="CloseReturnModal" class="text-[#a09e99] hover:text-[#1a1a1a] transition font-bold text-xl">&times;</button>
            </div>
            <div class="p-6">
                <p class="text-sm text-gray-600 mb-4">Mengembalikan <strong class="text-gray-900">@(SelectedTransaction.Product?.name)</strong>.</p>
                <div class="mb-4">
                    <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Jumlah Kembali</label>
                    <input type="number" @bind="ReturnModel.return_quantity" min="1" max="@(SelectedTransaction.quantity - SelectedTransaction.returned_quantity)" class="w-full px-3.5 py-2.5 text-xs bg-[#f5f4f0] border border-[#e5e3dc] rounded-lg outline-none text-[#1a1a1a] focus:border-[#e8a000] transition" />
                </div>
                <div class="mb-4">
                    <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Status Barang</label>
                    <select @bind="ReturnModel.return_status" class="w-full px-3.5 py-2.5 text-xs bg-[#f5f4f0] border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none text-[#1a1a1a] transition">
                        <option value="baik">Baik (Good)</option>
                        <option value="rusak">Rusak (Damaged)</option>
                        <option value="hilang">Hilang (Lost)</option>
                    </select>
                </div>
                @if (ReturnModel.return_status == "rusak" || ReturnModel.return_status == "hilang")
                {
                    <div class="mb-4">
                        <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Alasan</label>
                        <textarea @bind="ReturnModel.return_reason" rows="2" class="w-full px-3.5 py-2.5 text-xs bg-[#f5f4f0] border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none text-[#1a1a1a] resize-none transition"></textarea>
                    </div>
                }

                <div class="mb-4">
                    <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Foto Bukti Pengembalian *</label>
                    <InputFile OnChange="HandleFileSelected" class="w-full px-3.5 py-2 text-xs bg-[#f5f4f0] border border-[#e5e3dc] rounded-lg outline-none text-[#1a1a1a] focus:border-[#e8a000] transition" />
                </div>
                
                <div class="flex flex-row-reverse justify-start gap-3 mt-6 pt-4 border-t border-[#f0ede5]">
                    <button type="button" @onclick="SaveReturn" disabled="@IsSaving" class="px-5 py-2.5 bg-[#e8a000] hover:bg-[#d49300] active:scale-[0.98] text-[#1a1a1a] text-xs font-bold tracking-wider rounded-lg transition shadow-sm disabled:opacity-50">
                        @(IsSaving ? "Menyimpan..." : "Simpan Draft")
                    </button>
                    <button type="button" @onclick="CloseReturnModal" class="inline-flex justify-center px-5 py-2.5 bg-white border border-[#e5e3dc] hover:bg-[#f0ede5] text-[#3a3835] text-xs font-bold rounded-lg transition cursor-pointer">
                        Batal
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private Dictionary<string, List<Transaction>> GroupedUsages = new();
    private HashSet<string> ExpandedGroups = new();
    
    private int CurrentPage = 1;
    private int TotalPages = 1;

    private int CurrentUserId = 0;
    private string? UserRole;

    private bool ShowReturnModal = false;
    private bool IsSaving = false;
    private string? ErrorMessage;
    private string? SuccessMessage;
    
    private Transaction? SelectedTransaction;
    private ReturnItemViewModel ReturnModel = new();

    private string SearchQuery = "";
    private string StatusFilter = "";
    private IBrowserFile? selectedReturnPhoto;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            if (int.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out int id))
                CurrentUserId = id;
            UserRole = user.FindFirst(ClaimTypes.Role)?.Value;
        }

        await LoadData(1);
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedReturnPhoto = e.File;
    }

    private async Task LoadData(int page)
    {
        var result = await TransactionService.GetHistoryAsync(CurrentUserId, UserRole, "OUT", null, null, 1, 1000);
        
        var filtered = result.Transactions.Where(t => t.request_type == "BORROW" && t.status == "APPROVED").ToList();
        
        if (!string.IsNullOrWhiteSpace(SearchQuery))
        {
            filtered = filtered.Where(t => t.Product != null && 
                (t.Product.name.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) || 
                 t.Product.sku.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase))).ToList();
        }
        
        if (StatusFilter == "pending")
        {
            filtered = filtered.Where(t => t.quantity > t.returned_quantity).ToList();
        }
        else if (StatusFilter == "returned")
        {
            filtered = filtered.Where(t => t.returned_quantity >= t.quantity).ToList();
        }
        
        int pageSize = 20;
        int totalItems = filtered.Count;
        TotalPages = (int)Math.Ceiling(totalItems / (double)pageSize);
        if (TotalPages < 1) TotalPages = 1;
        
        CurrentPage = Math.Min(page, TotalPages);
        if (CurrentPage < 1) CurrentPage = 1;
        
        var paginatedTransactions = filtered
            .Skip((CurrentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
            
        GroupedUsages = paginatedTransactions
            .GroupBy(t => TransactionService.CreateGroupId(t.created_at, t.requester_id, t.applicant_name ?? string.Empty))
            .ToDictionary(g => g.Key, g => g.ToList());
    }

    private void ToggleGroup(string groupId)
    {
        if (ExpandedGroups.Contains(groupId))
        {
            ExpandedGroups.Remove(groupId);
        }
        else
        {
            ExpandedGroups.Add(groupId);
        }
    }

    private void OpenReturnModal(Transaction t)
    {
        SelectedTransaction = t;
        int remaining = (t.quantity ?? 0) - (t.returned_quantity ?? 0) - (t.pending_return_quantity ?? 0);
        ReturnModel = new ReturnItemViewModel
        {
            transaction_id = t.id,
            return_quantity = remaining,
            return_status = "baik"
        };
        selectedReturnPhoto = null;
        ShowReturnModal = true;
        ErrorMessage = null;
        SuccessMessage = null;
    }

    private void CloseReturnModal()
    {
        ShowReturnModal = false;
        SelectedTransaction = null;
        selectedReturnPhoto = null;
    }

    private async Task SaveReturn()
    {
        IsSaving = true;
        ErrorMessage = null;
        SuccessMessage = null;

        if (selectedReturnPhoto != null)
        {
            var ms = new System.IO.MemoryStream();
            await selectedReturnPhoto.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(ms);
            ms.Position = 0;
            ReturnModel.return_photo = new Microsoft.AspNetCore.Http.FormFile(ms, 0, selectedReturnPhoto.Size, "return_photo", selectedReturnPhoto.Name)
            {
                Headers = new Microsoft.AspNetCore.Http.HeaderDictionary(),
                ContentType = selectedReturnPhoto.ContentType
            };
        }

        var err = await TransactionService.ReturnItemAsync(ReturnModel);
        if (err != null)
        {
            ErrorMessage = err;
        }
        else
        {
            SuccessMessage = "Draft pengembalian berhasil disimpan.";
            CloseReturnModal();
            await LoadData(CurrentPage);
        }

        IsSaving = false;
    }

    private async Task CancelDraft(int id)
    {
        ErrorMessage = null;
        SuccessMessage = null;
        
        var err = await TransactionService.CancelReturnDraftAsync(id);
        if (err != null) ErrorMessage = err;
        else
        {
            SuccessMessage = "Draft dibatalkan.";
            await LoadData(CurrentPage);
        }
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoadData(1);
        }
    }

    private async Task SubmitBatch(DateTime createdAt, int requesterId, string applicantName)
    {
        ErrorMessage = null;
        SuccessMessage = null;
        
        var groupId = TransactionService.CreateGroupId(createdAt, requesterId, applicantName);
        var err = await TransactionService.SubmitReturnBatchAsync(groupId);
        if (err != null) ErrorMessage = err;
        else
        {
            SuccessMessage = "Draft berhasil diajukan untuk disetujui.";
            await LoadData(CurrentPage);
        }
    }
}
