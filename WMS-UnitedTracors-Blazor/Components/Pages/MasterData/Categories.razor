@page "/Category"
@using UT_WMSDotnet.Models
@using UT_WMSDotnet.ViewModels
@using WMS_UnitedTracors_Blazor.Services
@using WMS_UnitedTracors_Blazor.Components.Shared
@inject CategoryService CategoryService
@inject ProductService ProductService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>WMS - Categories</PageTitle>

<LoadingOverlay IsVisible="IsSubmitting" Message="@LoadingMessage" SubMessage="Mohon tunggu sebentar..." />

<div class="py-8 min-h-screen">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="flex justify-between items-center mb-6">
            <h2 class="font-semibold text-xl text-gray-800 leading-tight font-syne">
                Categories
            </h2>
        </div>

        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="mb-6 flex items-center gap-3 bg-[#eef9f0] border border-[#b8e8c0] text-[#1a7a30] px-4 py-3 rounded-lg text-sm" role="alert">
                <svg class="w-4 h-4 shrink-0 text-[#1a7a30]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                @SuccessMessage
            </div>
        }
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="mb-6 flex items-center gap-3 bg-[#fef0f0] border border-[#f8c0c0] text-[#d94040] px-4 py-3 rounded-lg text-sm" role="alert">
                <svg class="w-4 h-4 shrink-0 text-[#d94040]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                @ErrorMessage
            </div>
        }

        @* Add Category *@
        @if (CanManage)
        {
            <div class="bg-white rounded-xl border border-[#e5e3dc] mb-6 overflow-hidden shadow-sm">
                <div class="px-6 py-4 border-b border-[#f0ede5] bg-[#faf9f5]">
                    <h3 class="text-sm font-bold text-[#1a1a1a] font-syne">Add New Category</h3>
                </div>
                <div class="px-6 py-5">
                    <form @onsubmit="SaveCategory" class="flex flex-col sm:flex-row gap-3 items-end">
                        <div class="flex-1 w-full">
                            <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Name <span class="text-red-500">*</span></label>
                            <input type="text" @bind="Model.name" required placeholder="Category name"
                                   class="block w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none transition-colors duration-150 text-[#1a1a1a]">
                        </div>
                        <div class="flex-1 w-full">
                            <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Description <span class="text-gray-400 font-normal font-sans">(Optional)</span></label>
                            <input type="text" @bind="Model.description" placeholder="Description (optional)"
                                   class="block w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none transition-colors duration-150 text-[#1a1a1a]">
                        </div>
                        <button type="submit" class="px-5 py-2 bg-[#e8a000] hover:bg-[#d49300] text-[#1a1a1a] text-xs font-bold rounded-lg transition active:scale-95 cursor-pointer whitespace-nowrap">
                            Add Category
                        </button>
                    </form>
                    <p class="text-xs text-gray-500 mt-2">* Wajib diisi</p>
                </div>
            </div>
        }

        @* Categories List *@
        <div class="bg-transparent md:bg-white md:rounded-xl md:border md:border-[#e5e3dc] md:overflow-hidden md:shadow-sm">
            <!-- Desktop Table View -->
            <div class="hidden md:block overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-[#1a1a1a]">
                            <th class="px-6 py-3.5 text-[0.68rem] font-bold tracking-wider uppercase text-[#c8c5bc] w-12">#</th>
                            <th class="px-6 py-3.5 text-[0.68rem] font-bold tracking-wider uppercase text-[#c8c5bc]">Name</th>
                            <th class="px-6 py-3.5 text-[0.68rem] font-bold tracking-wider uppercase text-[#c8c5bc]">Description</th>
                            <th class="px-6 py-3.5 text-[0.68rem] font-bold tracking-wider uppercase text-[#c8c5bc]">Products</th>
                            @if (CanManage)
                            {
                                <th class="px-6 py-3.5 text-[0.68rem] font-bold tracking-wider uppercase text-[#c8c5bc] w-32"></th>
                            }
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[#f0ede5]">
                        @if (CategoriesList == null || !CategoriesList.Any())
                        {
                            <tr>
                                <td colspan="@(CanManage ? 5 : 4)" class="px-6 py-16 text-center">
                                    <p class="text-sm text-gray-500">No categories yet.</p>
                                    <p class="text-xs text-gray-400 mt-1">Add a category above to organize your products.</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            int index = (CurrentPage - 1) * 10;
                            foreach (var category in CategoriesList)
                            {
                                index++;
                                bool isEditing = EditingCategoryId == category.Id;
                                
                                <tr class="@(isEditing ? "hidden" : "") hover:bg-[#faf9f5] border-b border-[#f0ede5] transition-colors duration-100">
                                    <td class="px-6 py-4 text-sm text-gray-400 align-middle">@index</td>
                                    <td class="px-6 py-4 text-sm font-semibold text-[#1a1a1a] whitespace-nowrap align-middle">@category.Name</td>
                                    <td class="px-6 py-4 text-sm text-gray-600 align-middle">@(category.Description ?? "--")</td>
                                    <td class="px-6 py-4 whitespace-nowrap align-middle">
                                        <span @onclick="() => OpenProductsModal(category.Id, category.Name)" class="inline-flex items-center px-2 py-0.5 rounded bg-[#eef9f0] border border-[#b8e8c0] text-[#1a7a30] hover:bg-[#1a7a30] hover:text-white transition cursor-pointer text-xs font-bold shadow-sm">
                                            @category.ProductsCount
                                        </span>
                                        <span class="text-xs text-gray-400 ml-1">items</span>
                                    </td>
                                    @if (CanManage)
                                    {
                                        <td class="px-6 py-4 whitespace-nowrap align-middle">
                                            <div class="flex items-center gap-2 justify-end">
                                                <button type="button" @onclick="() => StartEdit(category)"
                                                        class="text-xs font-bold text-[#3a3835] hover:text-[#1a1a1a] px-3 py-1.5 rounded bg-white border border-[#e5e3dc] hover:bg-[#f0ede5] transition cursor-pointer">
                                                    Edit
                                                </button>
                                                <button type="button" @onclick="() => DeleteCategory(category.Id)"
                                                        class="text-xs font-bold text-[#d94040] hover:text-[#b83535] px-3 py-1.5 rounded bg-[#fef0f0] border border-[#f8c0c0] hover:bg-[#fee2e2] transition cursor-pointer">
                                                    Delete
                                                </button>
                                            </div>
                                        </td>
                                    }
                                </tr>
                                
                                @if (CanManage)
                                {
                                    <tr class="@(isEditing ? "" : "hidden") bg-[#faf9f5]">
                                        <td class="px-6 py-4" colspan="5">
                                            <p class="text-xs text-gray-500 mb-3">* Wajib diisi</p>
                                            <form @onsubmit="() => UpdateCategory(category.Id)" class="flex flex-col sm:flex-row gap-3 items-end">
                                                <div class="flex-1 w-full">
                                                    <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Name <span class="text-red-500">*</span></label>
                                                    <input type="text" @bind="EditModel.name" required
                                                           class="block w-full px-3 py-1.5 text-xs bg-white border border-[#e5e3dc] focus:border-[#e8a000] focus:ring-0 rounded-lg outline-none text-[#1a1a1a] transition-all duration-150">
                                                </div>
                                                <div class="flex-1 w-full">
                                                    <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Description</label>
                                                    <input type="text" @bind="EditModel.description"
                                                           class="block w-full px-3 py-1.5 text-xs bg-white border border-[#e5e3dc] focus:border-[#e8a000] focus:ring-0 rounded-lg outline-none text-[#1a1a1a] transition-all duration-150">
                                                </div>
                                                <div class="flex gap-2 w-full sm:w-auto">
                                                    <button type="submit" class="flex-1 sm:flex-none px-4 py-2 bg-[#e8a000] hover:bg-[#d49300] text-[#1a1a1a] text-xs font-bold rounded-lg transition cursor-pointer">Save</button>
                                                    <button type="button" @onclick="CancelEdit" class="flex-1 sm:flex-none px-4 py-2 bg-white border border-[#e5e3dc] hover:bg-[#f0ede5] text-[#3a3835] text-xs font-bold rounded-lg transition cursor-pointer">Cancel</button>
                                                </div>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mobile Card View -->
            <div class="block md:hidden space-y-3">
                @if (CategoriesList == null || !CategoriesList.Any())
                {
                    <div class="px-6 py-16 text-center bg-white rounded-xl border border-[#e5e3dc] shadow-sm">
                        <p class="text-sm text-gray-500">No categories yet.</p>
                        <p class="text-xs text-gray-400 mt-1">Add a category above to organize your products.</p>
                    </div>
                }
                else
                {
                    int index = (CurrentPage - 1) * 10;
                    foreach (var category in CategoriesList)
                    {
                        index++;
                        bool isEditing = EditingCategoryId == category.Id;
                        
                        @if (!isEditing)
                        {
                            <div class="p-5 bg-white border border-[#e5e3dc] rounded-xl shadow-sm hover:shadow transition-shadow">
                                <div class="flex justify-between items-start mb-2">
                                    <div>
                                        <span class="text-xs text-gray-400 font-bold">#@index</span>
                                        <h4 class="text-sm font-semibold text-[#1a1a1a] mt-0.5">@category.Name</h4>
                                    </div>
                                    <span @onclick="() => OpenProductsModal(category.Id, category.Name)" class="cursor-pointer inline-flex items-center px-2 py-0.5 rounded bg-[#eef9f0] border border-[#b8e8c0] text-[#1a7a30] text-[10px] font-bold hover:bg-[#1a7a30] hover:text-white transition shadow-sm">
                                        @category.ProductsCount items
                                    </span>
                                </div>
                                <p class="text-xs text-gray-600 mb-4">@(category.Description ?? "No description provided.")</p>
                                
                                @if (CanManage)
                                {
                                    <div class="flex items-center gap-2 pt-3 border-t border-[#f0ede5] justify-end">
                                        <button type="button" @onclick="() => StartEdit(category)"
                                                class="flex-1 text-center text-xs font-bold text-[#3a3835] hover:text-[#1a1a1a] py-2 rounded bg-white border border-[#e5e3dc] hover:bg-[#f0ede5] transition cursor-pointer">
                                            Edit
                                        </button>
                                        <button type="button" @onclick="() => DeleteCategory(category.Id)"
                                                class="flex-1 text-center text-xs font-bold text-[#d94040] hover:text-[#b83535] py-2 rounded bg-[#fef0f0] border border-[#f8c0c0] hover:bg-[#fee2e2] transition cursor-pointer">
                                            Delete
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="p-5 bg-[#faf9f5] border border-[#e5e3dc] rounded-xl shadow-sm">
                                <p class="text-xs text-gray-500 mb-3">* Wajib diisi</p>
                                <form @onsubmit="() => UpdateCategory(category.Id)" class="space-y-4">
                                    <div>
                                        <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1">Name <span class="text-red-500">*</span></label>
                                        <input type="text" @bind="EditModel.name" required
                                               class="block w-full px-3 py-2 text-xs bg-white border border-[#e5e3dc] focus:border-[#e8a000] focus:ring-0 rounded-lg outline-none text-[#1a1a1a] transition-all duration-150">
                                    </div>
                                    <div>
                                        <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1">Description</label>
                                        <input type="text" @bind="EditModel.description"
                                               class="block w-full px-3 py-2 text-xs bg-white border border-[#e5e3dc] focus:border-[#e8a000] focus:ring-0 rounded-lg outline-none text-[#1a1a1a] transition-all duration-150">
                                    </div>
                                    <div class="flex gap-2 pt-2">
                                        <button type="submit" class="flex-1 px-4 py-2 bg-[#e8a000] hover:bg-[#d49300] text-[#1a1a1a] text-xs font-bold rounded-lg transition cursor-pointer">Save</button>
                                        <button type="button" @onclick="CancelEdit" class="flex-1 px-4 py-2 bg-white border border-[#e5e3dc] hover:bg-[#f0ede5] text-[#3a3835] text-xs font-bold rounded-lg transition cursor-pointer">Cancel</button>
                                    </div>
                                </form>
                            </div>
                        }
                    }
                }
            </div>
            
            @if (TotalPages > 1)
            {
                <div class="mt-4 px-6 py-4 border border-[#e5e3dc] rounded-xl flex justify-between items-center bg-white shadow-sm">
                    <span class="text-xs text-[#8a8880]">Halaman @CurrentPage dari @TotalPages</span>
                    <div class="flex gap-2">
                        <button disabled="@(CurrentPage == 1)" @onclick="() => LoadData(CurrentPage - 1)" class="px-3 py-1 bg-white border border-[#e5e3dc] rounded text-sm disabled:opacity-50 hover:bg-gray-50">Prev</button>
                        <button disabled="@(CurrentPage == TotalPages)" @onclick="() => LoadData(CurrentPage + 1)" class="px-3 py-1 bg-white border border-[#e5e3dc] rounded text-sm disabled:opacity-50 hover:bg-gray-50">Next</button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<ProductsModal 
    Show="ShowProductsModal" 
    OnClose="CloseProductsModal" 
    Title="@ModalTitle" 
    Type="category" 
    TargetId="ModalTargetId" 
    CanManage="CanManage" 
    OnProductDeleted="() => LoadData(CurrentPage)" />

@code {
    private List<CategoryDto>? CategoriesList;
    private int CurrentPage = 1;
    private int TotalPages = 1;
    
    private CategoryViewModel Model = new();
    private CategoryViewModel EditModel = new();
    private int? EditingCategoryId;
    
    private string? ErrorMessage;
    private string? SuccessMessage;
    private bool CanManage = false;
    private bool IsSubmitting = false;
    private string LoadingMessage = "Memuat data...";

    private bool ShowProductsModal = false;
    private string ModalTitle = "";
    private int ModalTargetId;

    private async Task OpenProductsModal(int id, string name)
    {
        ModalTargetId = id;
        ModalTitle = $"Products in Category: {name}";
        ShowProductsModal = true;
    }

    private void CloseProductsModal()
    {
        ShowProductsModal = false;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        
        CanManage = authState.User.HasPermission(WMS_UnitedTracors_Blazor.Helpers.Permissions.MasterDataManage);

        await LoadData(1);
    }

    private async Task LoadData(int page)
    {
        IsSubmitting = true;
        LoadingMessage = "Memuat data kategori...";
        StateHasChanged();
        try
        {
            CurrentPage = page;
            var result = await CategoryService.GetCategoriesAsync(CurrentPage, 10);
            CategoriesList = result.Categories;
            TotalPages = result.TotalPages;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task SaveCategory()
    {
        if (string.IsNullOrWhiteSpace(Model.name))
        {
            ErrorMessage = "Nama kategori wajib diisi.";
            return;
        }

        ErrorMessage = null;
        SuccessMessage = null;
        IsSubmitting = true;
        LoadingMessage = "Menyimpan kategori baru...";
        StateHasChanged();

        try
        {
            string? error = await CategoryService.CreateCategoryAsync(Model);

            if (error != null)
            {
                ErrorMessage = error;
            }
            else
            {
                SuccessMessage = "Kategori berhasil ditambahkan.";
                Model = new CategoryViewModel(); // Reset form
                await LoadData(CurrentPage);
            }
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private void StartEdit(CategoryDto cat)
    {
        EditingCategoryId = cat.Id;
        EditModel = new CategoryViewModel { name = cat.Name, description = cat.Description };
        ErrorMessage = null;
        SuccessMessage = null;
    }

    private void CancelEdit()
    {
        EditingCategoryId = null;
    }

    private async Task UpdateCategory(int id)
    {
        if (string.IsNullOrWhiteSpace(EditModel.name))
        {
            ErrorMessage = "Nama kategori wajib diisi.";
            return;
        }

        ErrorMessage = null;
        SuccessMessage = null;
        IsSubmitting = true;
        LoadingMessage = "Menyimpan perubahan kategori...";
        StateHasChanged();

        try
        {
            string? error = await CategoryService.UpdateCategoryAsync(id, EditModel);

            if (error != null)
            {
                ErrorMessage = error;
            }
            else
            {
                SuccessMessage = "Kategori berhasil diupdate.";
                EditingCategoryId = null;
                await LoadData(CurrentPage);
            }
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task DeleteCategory(int id)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Apakah Anda yakin ingin menghapus kategori ini?");
        if (confirmed)
        {
            IsSubmitting = true;
            LoadingMessage = "Menghapus kategori...";
            StateHasChanged();
            try
            {
                await CategoryService.DeleteCategoryAsync(id);
                SuccessMessage = "Kategori berhasil dihapus.";
                await LoadData(CurrentPage);
            }
            finally
            {
                IsSubmitting = false;
            }
        }
    }
}
