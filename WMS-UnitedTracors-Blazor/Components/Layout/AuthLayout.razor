@inherits LayoutComponentBase

<div id="auth-root" class="fixed inset-0 z-[9999] bg-[#faf9f5] overflow-y-auto px-4 py-8 flex items-center justify-center">
    <!-- Google Fonts: Montserrat -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <div class="w-full max-w-[500px] flex flex-col items-center">
        <!-- Logo -->
        <div class="mb-8">
            <a href="/">
                <img src="img/logo.svg" alt="United Tractors Logo" class="w-16 h-16 object-contain" />
            </a>
        </div>

        <!-- Card -->
        <div class="w-full bg-white border border-[#e5e3dc]/70 rounded-[28px] shadow-[0_8px_30px_rgba(0,0,0,0.015)] p-10 md:p-12 mb-8">
            @Body
        </div>

        <!-- Footer -->
        <div class="text-center">
            <span class="text-[10px] tracking-[0.08em] font-bold text-[#a09e99] uppercase">
                &copy; 2026 UNITED TRACTORS CORPORATE UNIVERSITY (CORPU)
            </span>
        </div>
    </div>
</div>

<style>
    /* Force Montserrat font on all auth elements */
    #auth-root, 
    #auth-root * {
        font-family: 'Montserrat', sans-serif !important;
    }
</style>
