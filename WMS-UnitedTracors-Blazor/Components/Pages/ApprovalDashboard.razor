        <div class="fixed inset-0 bg-black/50 backdrop-blur-sm transition-opacity"></div>
        
        <!-- Wrapper -->
        <div class="fixed inset-0 z-[200] overflow-y-auto flex items-end justify-center sm:items-center p-0 sm:p-4 text-center">
            <!-- Sheet/Modal Container -->
            <div class="relative transform overflow-hidden rounded-t-3xl sm:rounded-2xl bg-white text-left shadow-2xl transition-all w-full sm:max-w-xl border border-[#e5e3dc] pb-[calc(20px+env(safe-area-inset-bottom))] sm:pb-0">
                <!-- Drag handle -->
                <div class="w-12 h-1.5 bg-gray-300 rounded-full mx-auto my-3 sm:hidden shrink-0"></div>

                <div class="bg-[#faf9f5] px-5 py-4 border-b border-[#e5e3dc] flex items-center justify-between gap-4 shrink-0">
                    <div class="flex items-center gap-3">
                        <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-[#fef0f0]">
                            <svg class="h-5.5 w-5.5 text-[#d94040]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                            </svg>
                        </div>
                        <div>
                            <h3 class="text-base sm:text-lg font-extrabold text-[#1a1a1a] leading-tight" id="modal-title">@(IsRejectingReturn ? "Tolak Pengembalian" : "Tolak / Minta Revisi Item")</h3>
                            <p class="text-xs text-[#6b665e] font-medium mt-0.5">Berikan alasan catatan untuk pemohon sebelum memproses keputusan.</p>
                        </div>
                    </div>
                </div>
                
                <div class="p-5 space-y-4 max-h-[60vh] overflow-y-auto bg-white">
                    @if (!IsRejectingReturn && RejectItemId > 0)
                    {
                        var rejectItem = GetApprovalItemById(RejectItemId);
                        if (rejectItem != null)
                        {
                            <div class="rounded-xl border border-[#e5e3dc] bg-[#faf9f5] p-3.5 flex items-center justify-between gap-3 text-xs font-semibold">
                                <div class="min-w-0">
                                    <div class="text-[#8a8880] text-[10px] font-bold uppercase tracking-wider">Item Diproses</div>
                                    <div class="font-extrabold text-gray-900 truncate mt-0.5">@rejectItem.Product?.name</div>
                                    <code class="text-[9px] font-mono text-gray-500 mt-0.5 block">SKU: @(rejectItem.Product?.sku ?? "-")</code>
                                </div>
                                <div class="text-right shrink-0 bg-white border border-[#e5e3dc] px-2.5 py-1.5 rounded-lg">
                                    <div class="text-[9px] text-[#8a8880] font-bold uppercase tracking-wider">Qty Diajukan</div>
                                    <div class="font-extrabold text-gray-900">@rejectItem.quantity @(rejectItem.Product?.Unit?.name ?? "unit")</div>
                                </div>
                            </div>
                        }
