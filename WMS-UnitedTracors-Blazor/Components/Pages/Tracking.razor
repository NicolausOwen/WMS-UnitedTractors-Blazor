    private async Task OpenReturnModal(Transaction transaction, bool force)
    {
        if (transaction.status == WorkflowStatuses.WaitingHandoverConfirm)
        {
            IsSubmitting = true;
            try
            {
                var err = await TransactionService.ConfirmHandoverReceiptByUserAsync(transaction.group_id, CurrentUserId, true, null);
                if (err != null)
                {
                    ErrorMessage = err;
                    return;
                }
                await LoadData();
                if (GroupedUsages.TryGetValue(transaction.group_id, out var groupItems))
                {
                    var updatedTx = groupItems.FirstOrDefault(t => t.id == transaction.id);
                    if (updatedTx != null)
                    {
                        transaction = updatedTx;
                    }
                }
            }
            finally
            {
                IsSubmitting = false;
            }
        }

        ReturnTransaction = transaction;
        IsForceReturn = force;
        IsReturnModalOpen = true;
        SelectedFile = null;
        ModalError = null;
        ReturnModel = new UT_WMSDotnet.ViewModels.ReturnItemViewModel
        {
            transaction_id = transaction.id,
            return_quantity = (transaction.quantity ?? 0) - (transaction.returned_quantity ?? 0),
            return_status = "baik"
        };
    }

