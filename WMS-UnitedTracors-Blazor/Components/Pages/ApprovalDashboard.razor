                await LoadData();
            }
            else
            {
                ErrorMessage = err;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Terjadi kesalahan saat submit serah terima: " + ex.Message;
        }
        finally
        {
            IsProcessing = false;
        }
    }

