@page "/Approval"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using UT_WMSDotnet.Models
@using WMS_UnitedTracors_Blazor.Services
@inject ApprovalService ApprovalService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Approvals</PageTitle>

<div class="py-8 bg-[#f5f4f0] min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <h2 class="font-semibold text-xl text-gray-800 leading-tight mb-6">Approvals</h2>

        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="mb-4 flex items-center gap-3 bg-[#eef9f0] border border-[#b8e8c0] text-[#1a7a30] px-4 py-3 rounded-lg text-sm font-semibold">
                <svg class="w-4 h-4 shrink-0 text-[#1a7a30]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                @SuccessMessage
            </div>
        }
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="mb-4 flex items-center gap-3 bg-[#fef0f0] border border-[#f8c0c0] text-[#d94040] px-4 py-3 rounded-lg text-sm font-semibold">
                <svg class="w-4 h-4 shrink-0 text-[#d94040]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                @ErrorMessage
            </div>
        }

        <div class="mb-8">
            <h3 class="text-lg font-bold text-[#1a1a1a] mb-4">Pending Requests</h3>
            
            @if (GroupedApprovals == null)
            {
                <div class="bg-white p-12 rounded-xl border border-[#e5e3dc] text-center shadow-sm text-gray-500">Loading...</div>
            }
            else if (GroupedApprovals.Count == 0)
            {
                <div class="bg-white p-12 rounded-xl border border-[#e5e3dc] text-center shadow-sm">
                    <svg class="w-12 h-12 text-[#d1d0cb] mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
                    <p class="text-sm font-bold text-[#8a8880] tracking-wide">No pending requests at the moment.</p>
                </div>
            }
            else
            {
                <div class="flex justify-end mb-4">
                    <button type="button" @onclick="ProcessBatch" disabled="@(Decisions.Count == 0 || IsProcessing)" class="inline-flex items-center gap-2 px-4 py-2 bg-[#1a1a1a] text-white text-xs font-bold rounded-lg shadow-sm hover:bg-[#333] transition disabled:opacity-50">
                        Process Selected Items (@Decisions.Count)
                    </button>
                </div>

                <div class="space-y-4">
                    @foreach (var group in GroupedApprovals)
                    {
                        var firstItem = group.Value.First();
                        bool isExpanded = ExpandedGroups.Contains(group.Key);

                        <div class="bg-white rounded-xl shadow-sm border border-[#e5e3dc] overflow-hidden">
                            <!-- Accordion Header -->
                            <div class="flex items-center justify-between p-5 border-b border-[#f0ede5] bg-[#faf9f5]">
                                <div class="cursor-pointer flex-1" @onclick="() => ToggleGroup(group.Key)">
                                    <div class="flex items-center gap-3 mb-1.5">
                                        <span class="text-[0.65rem] font-bold px-2 py-0.5 rounded-full uppercase tracking-wider @(firstItem.type == "IN" ? "bg-[#e0f2fe] text-[#1a6b8a] border border-[#bae6fd]" : "bg-purple-50 text-purple-700 border border-purple-200")">
                                            @(firstItem.type == "IN" ? "STOCK IN" : "STOCK OUT")
                                        </span>
                                        <span class="text-sm font-bold text-[#1a1a1a]">
                                            @firstItem.created_at.ToString("dd MMM yyyy, HH:mm")
                                        </span>
                                    </div>
                                    <div class="text-xs text-[#8a8880] font-medium">
                                        Submitted by: <span class="text-[#1a1a1a]">@(firstItem.Requester?.name ?? "Unknown")</span>
                                        @if (firstItem.type == "OUT" && !string.IsNullOrEmpty(firstItem.event_name))
                                        {
                                            <span class="mx-1">•</span> <span>Event: <span class="text-[#1a1a1a]">@firstItem.event_name</span></span>
                                        }
                                    </div>
                                </div>
                                
                                <div class="flex items-center gap-3">
                                    @if (UserRole == "manager" || UserRole == "admin" || UserRole == "superadmin")
                                    {
                                        <button type="button" @onclick="() => ApproveAllGroup(group.Value)" disabled="@IsProcessing" class="px-3 py-1.5 text-xs font-bold text-white bg-[#e8a000] rounded-md hover:bg-[#d49300] transition shadow-sm disabled:opacity-50">
                                            Approve All
                                        </button>
                                    }
                                    <div class="text-[#8a8880] cursor-pointer" @onclick="() => ToggleGroup(group.Key)">
                                        <svg class="w-5 h-5 transform transition-transform duration-200 @(isExpanded ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                                    </div>
                                </div>
                            </div>

                            @if (isExpanded)
                            {
                                @if (firstItem.type == "OUT")
                                {
                                    <div class="p-4 bg-white border-b border-[#f0ede5]">
                                        <h4 class="text-[0.65rem] font-bold uppercase tracking-wider text-[#8a8880] mb-3">Form Details</h4>
                                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                                            <div>
                                                <div class="text-[0.65rem] text-[#8a8880] font-bold uppercase tracking-wider mb-1">Applicant</div>
                                                <div class="text-sm font-bold text-[#1a1a1a]">@(firstItem.applicant_name ?? "-")</div>
                                                <div class="text-xs text-[#8a8880]">NRP: @(firstItem.applicant_nrp ?? "-")</div>
                                            </div>
                                            <div>
                                                <div class="text-[0.65rem] text-[#8a8880] font-bold uppercase tracking-wider mb-1">Event / Program</div>
                                                <div class="text-sm font-bold text-[#1a1a1a]">@(firstItem.event_name ?? "-")</div>
                                                <div class="text-xs text-[#8a8880]">@(firstItem.event_date?.ToString("MMM dd, yyyy") ?? "-")</div>
                                            </div>
                                            <div>
                                                <div class="text-[0.65rem] text-[#8a8880] font-bold uppercase tracking-wider mb-1">Division</div>
                                                <div class="text-sm font-bold text-[#1a1a1a]">@(firstItem.Division?.name ?? "-")</div>
                                            </div>
                                            <div>
                                                <div class="text-[0.65rem] text-[#8a8880] font-bold uppercase tracking-wider mb-1">Documentation</div>
                                                <div class="text-sm font-bold text-[#e8a000]">
                                                    @if (!string.IsNullOrEmpty(firstItem.documentation_link))
                                                    {
                                                        <a href="@firstItem.documentation_link" target="_blank" class="hover:underline flex items-center gap-1">
                                                            Link
                                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <span>-</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }

                                <div class="bg-[#faf9f5] p-4">
                                    <h4 class="text-[0.65rem] font-bold uppercase tracking-wider text-[#8a8880] mb-3">Items Requested</h4>
                                    <div class="overflow-x-auto">
                                        <table class="w-full text-left">
                                            <thead>
                                                <tr class="border-b border-[#e5e3dc]">
                                                    <th class="pb-2 text-[0.65rem] font-bold text-[#8a8880] uppercase tracking-wider">Product</th>
                                                    <th class="pb-2 text-[0.65rem] font-bold text-[#8a8880] uppercase tracking-wider text-center">Qty</th>
                                                    <th class="pb-2 text-[0.65rem] font-bold text-[#8a8880] uppercase tracking-wider">Type</th>
                                                    <th class="pb-2 text-[0.65rem] font-bold text-[#8a8880] uppercase tracking-wider text-right">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody class="divide-y divide-[#f0ede5]">
                                                @foreach (var item in group.Value)
                                                {
                                                    <tr class="bg-white">
                                                        <td class="py-3 px-3">
                                                            <div class="flex items-center gap-3">
                                                                @if (!string.IsNullOrEmpty(item.Product?.image))
                                                                {
                                                                    <img src="/storage/@item.Product.image" class="w-8 h-8 rounded object-cover border border-[#e5e3dc]">
                                                                }
                                                                <div>
                                                                    <div class="text-sm font-bold text-[#1a1a1a]">@(item.Product?.name)</div>
                                                                    <div class="text-[10px] text-[#8a8880]">@(item.Product?.sku)</div>
                                                                    @if (item.type == "OUT" && item.Product?.current_stock < item.quantity)
                                                                    {
                                                                        <div class="text-[10px] text-[#d94040] font-bold mt-0.5">⚠️ Insufficient Stock: Only @(item.Product?.current_stock) available</div>
                                                                    }
                                                                </div>
                                                            </div>
                                                        </td>
                                                        <td class="py-3 px-3 text-center">
                                                            <div class="text-sm font-bold text-[#1a1a1a]">@item.quantity</div>
                                                        </td>
                                                        <td class="py-3 px-3">
                                                            @if (item.request_type == "BORROW")
                                                            {
                                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-[#eef9f0] text-[#1a7a30] border border-[#b8e8c0]">BORROW</span>
                                                                @if (item.borrow_duration_days > 0)
                                                                {
                                                                    <div class="text-[10px] text-[#8a8880] mt-1">Duration: @item.borrow_duration_days days</div>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-[#e0f2fe] text-[#1a6b8a] border border-[#bae6fd]">GIVEAWAY</span>
                                                            }
                                                        </td>
                                                        <td class="py-3 px-3 text-right">
                                                            @if (UserRole == "manager" || UserRole == "admin" || UserRole == "superadmin")
                                                            {
                                                                <div class="flex flex-col items-end gap-2">
                                                                    <div class="flex items-center gap-1 bg-[#f5f4f0] p-1 rounded-lg border border-[#e5e3dc]">
                                                                        <button type="button" 
                                                                            @onclick='() => SetDecision(item.id, "APPROVE")'
                                                                            class="px-3 py-1.5 text-xs font-bold rounded transition-all @(Decisions.GetValueOrDefault(item.id) == "APPROVE" ? "bg-[#1a7a30] text-white shadow-sm" : "text-[#8a8880] hover:text-[#1a1a1a] hover:bg-white")">
                                                                            Approve
                                                                        </button>
                                                                        <button type="button" 
                                                                            @onclick='() => SetDecision(item.id, "REVISION")'
                                                                            class="px-3 py-1.5 text-xs font-bold rounded transition-all @(Decisions.GetValueOrDefault(item.id) == "REVISION" ? "bg-[#4338ca] text-white shadow-sm" : "text-[#8a8880] hover:text-[#1a1a1a] hover:bg-white")">
                                                                            Revision
                                                                        </button>
                                                                        <button type="button" 
                                                                            @onclick='() => SetDecision(item.id, "REJECT")'
                                                                            class="px-3 py-1.5 text-xs font-bold rounded transition-all @(Decisions.GetValueOrDefault(item.id) == "REJECT" ? "bg-[#d94040] text-white shadow-sm" : "text-[#8a8880] hover:text-[#1a1a1a] hover:bg-white")">
                                                                            Reject
                                                                        </button>
                                                                    </div>
                                                                    
                                                                    @if (Decisions.GetValueOrDefault(item.id) == "REJECT" || Decisions.GetValueOrDefault(item.id) == "REVISION")
                                                                    {
                                                                        <div class="w-full max-w-[250px]">
                                                                            <input type="text" 
                                                                                @bind="Reasons[item.id]" 
                                                                                placeholder="@(Decisions.GetValueOrDefault(item.id) == "REVISION" ? "Catatan revisi *" : "Reason for rejection *")" 
                                                                                class="w-full px-2 py-1.5 text-xs border rounded focus:ring-0 text-[#1a1a1a] @(Decisions.GetValueOrDefault(item.id) == "REVISION" ? "border-[#c7d2fe] bg-[#e0e7ff] focus:border-[#4338ca] placeholder:text-[#4338ca]/60" : "border-[#f8c0c0] bg-[#fef0f0] focus:border-[#d94040] placeholder:text-[#d94040]/60")">
                                                                        </div>
                                                                    }
                                                                </div>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @if ((UserRole == "admin" || UserRole == "superadmin") && PendingReturns != null && PendingReturns.Count > 0)
        {
            <div class="mb-8 border-t border-[#e5e3dc] pt-8">
                <div class="flex justify-between items-center mb-4">
                    <h3 class="text-lg font-bold text-[#1a1a1a] flex items-center gap-2">
                        Pending Return Approvals
                        <span class="bg-[#d94040] text-white text-[0.65rem] px-2 py-0.5 rounded-full">@PendingReturns.Count</span>
                    </h3>
                    <button type="button" @onclick="ProcessBatchReturns" disabled="@(ReturnDecisions.Count == 0 || IsProcessing)" class="inline-flex items-center gap-2 px-4 py-2 bg-[#1a1a1a] text-white text-xs font-bold rounded-lg shadow-sm hover:bg-[#333] transition disabled:opacity-50">
                        Process Selected Returns (@ReturnDecisions.Count)
                    </button>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    @foreach (var ret in PendingReturns)
                    {
                        <div class="bg-white rounded-xl shadow-sm border border-[#e5e3dc] p-5">
                            <div class="flex items-start justify-between mb-4">
                                <div class="flex items-center gap-3">
                                    @if (!string.IsNullOrEmpty(ret.Product?.image))
                                    {
                                        <img src="/storage/@ret.Product.image" class="w-10 h-10 rounded-lg object-cover border border-[#e5e3dc]">
                                    }
                                    <div>
                                        <h4 class="text-sm font-bold text-[#1a1a1a]">@(ret.Product?.name)</h4>
                                        <div class="text-[0.65rem] font-bold uppercase tracking-wider text-[#8a8880] mt-0.5">Ret. Qty: <span class="text-[#1a1a1a] text-xs">@(ret.pending_return_quantity)</span></div>
                                    </div>
                                </div>
                                <div class="text-right">
                                    <div class="text-[10px] font-bold px-2 py-0.5 rounded bg-gray-100 text-gray-700 inline-block mb-1">
                                        Condition: <span class="@(ret.return_status == "baik" ? "text-green-600" : "text-red-600")">@(ret.return_status?.ToUpper() ?? "")</span>
                                    </div>
                                    <div class="text-[0.65rem] text-[#8a8880]">By @(ret.Requester?.name)</div>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(ret.return_photo))
                            {
                                <div class="mb-4">
                                    <p class="text-[0.65rem] font-bold uppercase tracking-wider text-[#8a8880] mb-1.5">Photo Proof</p>
                                    <a href="/storage/@ret.return_photo" target="_blank" class="block w-20 h-20 rounded-lg border border-[#e5e3dc] overflow-hidden hover:ring-2 ring-[#e8a000] transition">
                                        <img src="/storage/@ret.return_photo" class="w-full h-full object-cover">
                                    </a>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(ret.return_reason))
                            {
                                <div class="mb-4 bg-[#fef0f0] p-3 rounded-lg border border-[#f8c0c0]">
                                    <p class="text-[0.65rem] font-bold uppercase tracking-wider text-[#d94040] mb-1">Damage/Loss Reason</p>
                                    <p class="text-xs text-[#1a1a1a]">"@ret.return_reason"</p>
                                </div>
                            }

                            <div class="flex items-center gap-2 pt-3 border-t border-[#f0ede5]">
                                <button type="button" 
                                    @onclick='() => SetReturnDecision(ret.id, "APPROVE")'
                                    class="flex-1 py-2 text-xs font-bold rounded-lg transition @(ReturnDecisions.GetValueOrDefault(ret.id) == "APPROVE" ? "bg-[#1a7a30] text-white shadow-sm" : "bg-[#eef9f0] text-[#1a7a30] border border-[#b8e8c0] hover:bg-[#b8e8c0]")">
                                    Approve
                                </button>
                                <button type="button" 
                                    @onclick='() => SetReturnDecision(ret.id, "REJECT")'
                                    class="flex-1 py-2 text-xs font-bold rounded-lg transition @(ReturnDecisions.GetValueOrDefault(ret.id) == "REJECT" ? "bg-[#d94040] text-white shadow-sm" : "bg-[#fef0f0] text-[#d94040] border border-[#f8c0c0] hover:bg-[#f8c0c0]")">
                                    Reject
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        @if ((UserRole == "admin" || UserRole == "superadmin") && PendingProfileRequests != null && PendingProfileRequests.Count > 0)
        {
            <div class="mb-8 border-t border-[#e5e3dc] pt-8">
                <h3 class="text-lg font-bold text-[#1a1a1a] mb-4 flex items-center gap-2">
                    Pending Profile Change Requests
                    <span class="bg-[#e8a000] text-white text-[0.65rem] px-2 py-0.5 rounded-full">@PendingProfileRequests.Count</span>
                </h3>

                <div class="bg-white rounded-xl shadow-sm border border-[#e5e3dc] overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left">
                            <thead>
                                <tr class="bg-[#faf9f5] border-b border-[#e5e3dc]">
                                    <th class="py-3 px-4 text-[0.65rem] font-bold text-[#8a8880] uppercase tracking-wider">Requested By</th>
                                    <th class="py-3 px-4 text-[0.65rem] font-bold text-[#8a8880] uppercase tracking-wider">New Data</th>
                                    <th class="py-3 px-4 text-[0.65rem] font-bold text-[#8a8880] uppercase tracking-wider">Date</th>
                                    <th class="py-3 px-4 text-[0.65rem] font-bold text-[#8a8880] uppercase tracking-wider text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-[#f0ede5]">
                                @foreach (var pr in PendingProfileRequests)
                                {
                                    <tr class="hover:bg-[#faf9f5]">
                                        <td class="py-3 px-4">
                                            <div class="text-sm font-bold text-[#1a1a1a]">@(pr.User?.name ?? "Unknown")</div>
                                            <div class="text-xs text-[#8a8880]">@(pr.User?.email)</div>
                                            <div class="text-[10px] text-[#8a8880]">Current NRP: @(pr.User?.nrp ?? "-")</div>
                                        </td>
                                        <td class="py-3 px-4">
                                            <div class="text-sm text-[#1a1a1a]"><strong>Name:</strong> @(pr.name)</div>
                                            <div class="text-sm text-[#1a1a1a]"><strong>Email:</strong> @(pr.email)</div>
                                            <div class="text-sm text-[#1a1a1a]"><strong>NRP:</strong> @(string.IsNullOrEmpty(pr.nrp) ? "-" : pr.nrp)</div>
                                            <div class="text-sm text-[#1a1a1a]"><strong>Division:</strong> @(pr.Division?.name ?? "-")</div>
                                        </td>
                                        <td class="py-3 px-4">
                                            <div class="text-xs text-[#8a8880]">@(pr.created_at?.ToString("dd MMM yyyy, HH:mm"))</div>
                                        </td>
                                        <td class="py-3 px-4 text-right">
                                            <div class="flex items-center justify-end gap-2">
                                                <button type="button" @onclick="() => ApproveProfileRequest(pr.id)" class="px-3 py-1.5 bg-[#1a7a30] text-white text-xs font-bold rounded shadow-sm hover:bg-[#145d24] transition">Approve</button>
                                                <button type="button" @onclick="() => RejectProfileRequest(pr.id)" class="px-3 py-1.5 bg-white border border-[#d94040] text-[#d94040] text-xs font-bold rounded shadow-sm hover:bg-[#fef0f0] transition">Reject</button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private Dictionary<string, List<Transaction>>? GroupedApprovals;
    private List<Transaction>? PendingReturns;
    private List<ProfileRequest>? PendingProfileRequests;
    
    private string? SuccessMessage;
    private string? ErrorMessage;
    private bool IsProcessing = false;

    private int CurrentUserId = 0;
    private string? UserRole;

    private HashSet<string> ExpandedGroups = new();
    
    private Dictionary<int, string> Decisions = new();
    private Dictionary<int, string> Reasons = new();
    
    private Dictionary<int, string> ReturnDecisions = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            if (int.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out int id))
                CurrentUserId = id;
            UserRole = user.FindFirst(ClaimTypes.Role)?.Value;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        var data = await ApprovalService.GetApprovalsAsync(CurrentUserId, UserRole);
        GroupedApprovals = data.GroupedApprovals;
        PendingReturns = data.PendingReturns;
        PendingProfileRequests = data.PendingProfileRequests;
        
        ExpandedGroups.Clear();
        if (GroupedApprovals.Any())
        {
            ExpandedGroups.Add(GroupedApprovals.First().Key);
        }
        
        Decisions.Clear();
        Reasons.Clear();
        ReturnDecisions.Clear();
    }

    private void ToggleGroup(string groupId)
    {
        if (ExpandedGroups.Contains(groupId))
            ExpandedGroups.Remove(groupId);
        else
            ExpandedGroups.Add(groupId);
    }

    private void SetDecision(int id, string decision)
    {
        Decisions[id] = decision;
        if (decision == "APPROVE" && Reasons.ContainsKey(id))
        {
            Reasons.Remove(id);
        }
    }
    
    private void SetReturnDecision(int id, string decision)
    {
        ReturnDecisions[id] = decision;
    }

    private async Task ApproveAllGroup(List<Transaction> items)
    {
        IsProcessing = true;
        ErrorMessage = null;
        SuccessMessage = null;

        int successCount = 0;
        foreach (var item in items)
        {
            var err = await ApprovalService.ApproveAsync(item.id, CurrentUserId, UserRole);
            if (err != null) ErrorMessage += $"Item {item.id}: {err} | ";
            else successCount++;
        }

        if (successCount > 0) SuccessMessage = $"{successCount} items approved.";
        
        await LoadData();
        IsProcessing = false;
    }

    private async Task ProcessBatch()
    {
        IsProcessing = true;
        ErrorMessage = null;
        SuccessMessage = null;

        int successCount = 0;
        foreach (var kvp in Decisions)
        {
            var id = kvp.Key;
            var action = kvp.Value;
            var reason = Reasons.GetValueOrDefault(id, "");

            if ((action == "REJECT" || action == "REVISION") && string.IsNullOrWhiteSpace(reason))
            {
                ErrorMessage = "Please provide a reason for all rejected or revised items.";
                IsProcessing = false;
                return;
            }

            string? err = null;
            if (action == "APPROVE") err = await ApprovalService.ApproveAsync(id, CurrentUserId, UserRole);
            else if (action == "REJECT") err = await ApprovalService.RejectAsync(id, reason, CurrentUserId, UserRole);
            else if (action == "REVISION") err = await ApprovalService.RequestRevisionAsync(id, reason, CurrentUserId, UserRole);

            if (err != null) ErrorMessage += $"Item {id}: {err} | ";
            else successCount++;
        }

        if (successCount > 0) SuccessMessage = $"{successCount} items processed.";
        
        await LoadData();
        IsProcessing = false;
    }
    
