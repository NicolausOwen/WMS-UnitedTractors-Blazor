                <button type="button" @onclick="CloseApprovalHandoverModal" class="w-8 h-8 rounded-lg bg-gray-100 flex items-center justify-center text-[#8a8880] hover:text-[#1a1a1a] transition">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
            
            <div class="p-5 space-y-5 overflow-y-auto">
                @if (ApprovalHandoverItems.Count > 0)
                {
                    var firstPending = ApprovalHandoverItems.First();
                    <div class="rounded-xl border border-[#e5e3dc] bg-[#faf9f5] p-4">
                        <div class="text-[0.65rem] font-bold uppercase tracking-[0.16em] text-[#8a8880] mb-3">Ringkasan Event</div>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
                            <div>
                                <div class="text-[#8a8880] font-semibold">Pemohon</div>
                                <div class="text-[#1a1a1a] font-extrabold">@(firstPending.applicant_name ?? firstPending.Requester?.name ?? "-")</div>
                            </div>
                            <div>
                                <div class="text-[#8a8880] font-semibold">Event</div>
                                <div class="text-[#1a1a1a] font-extrabold">@(firstPending.event_name ?? "-")</div>
                            </div>
                            <div>
                                <div class="text-[#8a8880] font-semibold">Jumlah Item</div>
                                <div class="text-[#1a1a1a] font-extrabold">@ApprovalHandoverItems.Count item</div>
