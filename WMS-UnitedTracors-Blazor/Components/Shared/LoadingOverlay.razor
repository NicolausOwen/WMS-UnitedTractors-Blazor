@if (IsVisible)
{
    <div class="fixed inset-0 flex flex-col items-center justify-center bg-black/40 backdrop-blur-sm transition-all duration-300" style="z-index: 999999 !important;">
        <div class="bg-white p-6 rounded-2xl shadow-2xl flex flex-col items-center max-w-xs w-full text-center border border-[#e5e3dc] mx-4">
            <div class="w-12 h-12 border-4 border-[#e8a000] border-t-transparent rounded-full animate-spin mb-4"></div>
            <h4 class="font-bold text-[#1a1a1a] text-base mb-1">@Message</h4>
            @if (!string.IsNullOrEmpty(SubMessage))
            {
                <p class="text-xs text-[#8a8880]">@SubMessage</p>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsVisible { get; set; } = false;

    [Parameter]
    public string Message { get; set; } = "Memuat data...";

    [Parameter]
    public string? SubMessage { get; set; } = "Mohon tunggu sebentar...";
}
