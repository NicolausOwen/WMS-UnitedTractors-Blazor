@page "/User"
@using UT_WMSDotnet.Models
@using UT_WMSDotnet.ViewModels
@using WMS_UnitedTracors_Blazor.Services
@inject UserService UserService
@inject DivisionService DivisionService
@inject AdminRoleService AdminRoleService
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>WMS - Users</PageTitle>

<div class="py-8 bg-[#f5f4f0] min-h-screen">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="flex justify-between items-center mb-6">
            <h2 class="font-semibold text-xl text-gray-800 leading-tight font-syne">
                Manage Users
            </h2>
        </div>

        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="mb-6 flex items-center gap-3 bg-[#eef9f0] border border-[#b8e8c0] text-[#1a7a30] px-4 py-3 rounded-lg text-sm" role="alert">
                <svg class="w-4 h-4 shrink-0 text-[#1a7a30]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                @SuccessMessage
            </div>
        }
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="mb-6 flex items-center gap-3 bg-[#fef0f0] border border-[#f8c0c0] text-[#d94040] px-4 py-3 rounded-lg text-sm" role="alert">
                <svg class="w-4 h-4 shrink-0 text-[#d94040]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                @ErrorMessage
            </div>
        }

        @* Create Form *@
        @if (IsSuperAdmin)
        {
            <div class="bg-white rounded-xl border border-[#e5e3dc] mb-8 overflow-hidden shadow-sm">
                <div class="px-6 py-4 border-b border-[#f0ede5] bg-[#faf9f5]">
                    <h3 class="text-sm font-bold text-[#1a1a1a] font-syne">Add New User</h3>
                    <p class="text-[0.72rem] text-[#8a8880] mt-0.5">Create a new user manually with specific roles and division.</p>
                </div>
                <div class="px-6 py-5">
                    <form @onsubmit="SaveUser" class="flex flex-col gap-4">
                        <div class="flex flex-col sm:flex-row gap-3">
                            <div class="flex-1">
                                <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Name <span class="text-red-500">*</span></label>
                                <input type="text" @bind="CreateModel.name" required placeholder="Full Name"
                                       class="block w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none transition-colors duration-150 text-[#1a1a1a]">
                            </div>
                            <div class="flex-1">
                                <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">NRP <span class="text-gray-400 font-normal font-sans">(Optional)</span></label>
                                <input type="text" @bind="CreateModel.nrp" placeholder="NRP Number"
                                       class="block w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none transition-colors duration-150 text-[#1a1a1a]">
                            </div>
                            <div class="flex-1">
                                <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Email <span class="text-red-500">*</span></label>
                                <input type="email" @bind="CreateModel.email" required placeholder="Email Address"
                                       class="block w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none transition-colors duration-150 text-[#1a1a1a]">
                            </div>
                            <div class="flex-1">
                                <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Poin</label>
                                <input type="number" @bind="CreateModel.poin" placeholder="Poin"
                                       class="block w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none transition-colors duration-150 text-[#1a1a1a]">
                            </div>
                            <div class="flex-1">
                                <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Password <span class="text-red-500">*</span></label>
                                <input type="password" @bind="CreateModel.password" required placeholder="Password"
                                       class="block w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none transition-colors duration-150 text-[#1a1a1a]">
                            </div>
                        </div>
                        <div class="flex flex-col sm:flex-row gap-3 items-end">
                            <div class="flex-1 w-full">
                                <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Division <span class="text-red-500">*</span></label>
                                <select @bind="CreateModel.division_id" class="block w-full px-3 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none transition-colors duration-150 text-[#1a1a1a]">
                                    <option value="">-- No Division --</option>
                                    @if (DivisionsList != null)
                                    {
                                        foreach (var division in DivisionsList)
                                        {
                                            <option value="@(division.Id)">@(division.Name)</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="flex-1 w-full">
                                <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Role <span class="text-red-500">*</span></label>
                                <select @bind="CreateModel.role" required class="block w-full px-3 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none transition-colors duration-150 text-[#1a1a1a]">
                                    @foreach (var r in RoleNames)
                                    {
                                        <option value="@r">@r</option>
                                    }
                                </select>
                            </div>
                            <div class="w-full sm:w-auto">
                                <button type="submit" class="w-full sm:w-auto px-5 py-2 bg-[#e8a000] hover:bg-[#d49300] text-[#1a1a1a] text-xs font-bold rounded-lg transition active:scale-95 cursor-pointer whitespace-nowrap">
                                    Add User
                                </button>
                            </div>
                        </div>
                        <p class="text-xs text-gray-500 mt-2">* Wajib diisi</p>
                    </form>
                </div>
            </div>
        }

        <div class="bg-transparent md:bg-white md:rounded-xl md:border md:border-[#e5e3dc] md:overflow-hidden md:shadow-sm">
            <div class="px-6 py-4 border-b border-[#f0ede5] bg-[#faf9f5] flex flex-col sm:flex-row sm:justify-between sm:items-center gap-2 rounded-t-xl">
                <div>
                    <h3 class="text-sm font-bold text-[#1a1a1a] font-syne">User Management</h3>
                    <p class="text-[0.72rem] text-[#8a8880] mt-0.5">Manage existing users in the system.</p>
                </div>
            </div>

            <!-- Desktop Table View -->
            <div class="hidden md:block overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-[#1a1a1a]">
                            <th class="px-6 py-3.5 text-[0.68rem] font-bold tracking-wider uppercase text-[#c8c5bc] w-12">#</th>
                            <th class="px-6 py-3.5 text-[0.68rem] font-bold tracking-wider uppercase text-[#c8c5bc]">Name</th>
                            <th class="px-6 py-3.5 text-[0.68rem] font-bold tracking-wider uppercase text-[#c8c5bc]">Email</th>
                            <th class="px-6 py-3.5 text-[0.68rem] font-bold tracking-wider uppercase text-[#c8c5bc]">Poin</th>
                            <th class="px-6 py-3.5 text-[0.68rem] font-bold tracking-wider uppercase text-[#c8c5bc]">Division</th>
                            <th class="px-6 py-3.5 text-[0.68rem] font-bold tracking-wider uppercase text-[#c8c5bc]">Role</th>
                            <th class="px-6 py-3.5 text-[0.68rem] font-bold tracking-wider uppercase text-[#c8c5bc] text-right w-40">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[#f0ede5]">
                        @if (UsersList == null || !UsersList.Any())
                        {
                            <tr>
                                <td colspan="7" class="px-6 py-16 text-center">
                                    <p class="text-sm text-gray-500">No users found.</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            int index = (CurrentPage - 1) * 10;
                            foreach (var user in UsersList)
                            {
                                index++;
                                bool isEditing = EditingUserId == user.id;

                                <tr class="@(isEditing ? "hidden" : "") hover:bg-[#faf9f5] border-b border-[#f0ede5] transition-colors duration-100">
                                    <td class="px-6 py-4 text-sm text-gray-400 align-middle">@index</td>
                                    <td class="px-6 py-4 text-sm font-semibold text-[#1a1a1a] whitespace-nowrap align-middle">@user.name</td>
                                    <td class="px-6 py-4 text-sm text-gray-600 align-middle">@user.email</td>
                                    <td class="px-6 py-4 text-sm font-semibold text-[#e8a000] align-middle">@user.poin</td>
                                    <td class="px-6 py-4 text-sm text-gray-600 align-middle">@(user.Division?.name ?? "--")</td>
                                    <td class="px-6 py-4 whitespace-nowrap align-middle">
                                        @{
                                            string bgClass = "bg-[#f5f4f0]";
                                            string textClass = "text-[#8a8780]";
                                            string borderClass = "border-[#e5e3dc]";
                                            if (user.role == "superadmin") { bgClass = "bg-purple-50"; textClass = "text-purple-700"; borderClass = "border-purple-200"; }
                                            else if (user.role == "manager") { bgClass = "bg-[#e0f2fe]"; textClass = "text-[#1a6b8a]"; borderClass = "border-[#bae6fd]"; }
                                            else if (user.role == "admin") { bgClass = "bg-[#fef3c7]"; textClass = "text-[#92400e]"; borderClass = "border-[#fde68a]"; }
                                        }
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold border @bgClass @textClass @borderClass">
                                            @((user.role ?? "").ToUpper())
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap align-middle">
                                        <div class="flex items-center justify-end gap-2">
                                            @if (IsAdmin)
                                            {
                                                <button type="button" @onclick="() => StartEdit(user)"
                                                        class="text-xs font-bold text-[#3a3835] hover:text-[#1a1a1a] px-3 py-1.5 rounded bg-white border border-[#e5e3dc] hover:bg-[#f0ede5] transition cursor-pointer">
                                                    Edit
                                                </button>
                                                @if (CurrentUserId != user.id)
                                                {
                                                    <button type="button" @onclick="() => DeleteUser(user.id)"
                                                            class="text-xs font-bold text-[#d94040] hover:text-[#b83535] px-3 py-1.5 rounded bg-[#fef0f0] border border-[#f8c0c0] hover:bg-[#fee2e2] transition cursor-pointer">
                                                        Delete
                                                    </button>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>

                                @if (IsAdmin)
                                {
                                    <tr class="@(isEditing ? "" : "hidden") bg-[#faf9f5]">
                                        <td class="px-6 py-4" colspan="7">
                                            <form @onsubmit="() => UpdateUser(user.id)" class="flex flex-col gap-4">
                                                <div class="flex flex-col sm:flex-row gap-3">
                                                    <div class="flex-1">
                                                        <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Name <span class="text-red-500">*</span></label>
                                                        <input type="text" @bind="EditModel.name" required
                                                               class="block w-full px-3 py-1.5 text-xs bg-white border border-[#e5e3dc] focus:border-[#e8a000] focus:ring-0 rounded-lg outline-none text-[#1a1a1a] transition-all duration-150">
                                                    </div>
                                                    <div class="flex-1">
                                                        <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">NRP <span class="text-gray-400 font-normal font-sans">(Optional)</span></label>
                                                        <input type="text" @bind="EditModel.nrp"
                                                               class="block w-full px-3 py-1.5 text-xs bg-white border border-[#e5e3dc] focus:border-[#e8a000] focus:ring-0 rounded-lg outline-none text-[#1a1a1a] transition-all duration-150">
                                                    </div>
                                                    <div class="flex-1">
                                                        <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Email <span class="text-red-500">*</span></label>
                                                        <input type="email" @bind="EditModel.email" required
                                                               class="block w-full px-3 py-1.5 text-xs bg-white border border-[#e5e3dc] focus:border-[#e8a000] focus:ring-0 rounded-lg outline-none text-[#1a1a1a] transition-all duration-150">
                                                    </div>
                                                    <div class="flex-1">
                                                        <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Poin</label>
                                                        <input type="number" @bind="EditModel.poin" placeholder="Poin"
                                                               class="block w-full px-3 py-1.5 text-xs bg-white border border-[#e5e3dc] focus:border-[#e8a000] focus:ring-0 rounded-lg outline-none text-[#1a1a1a] transition-all duration-150">
                                                    </div>
                                                    <div class="flex-1">
                                                        <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">New Password <span class="text-gray-400 font-normal font-sans">(Leave blank)</span></label>
                                                        <input type="password" @bind="EditPassword" placeholder="New Password"
                                                               class="block w-full px-3 py-1.5 text-xs bg-white border border-[#e5e3dc] focus:border-[#e8a000] focus:ring-0 rounded-lg outline-none text-[#1a1a1a] transition-all duration-150">
                                                    </div>
                                                </div>
                                                <div class="flex flex-col sm:flex-row gap-3 items-end">
                                                    <div class="flex-1 w-full">
                                                        <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Division <span class="text-red-500">*</span></label>
                                                        <select @bind="EditModel.division_id" class="block w-full px-3 py-2 text-[0.82rem] bg-white border border-[#e5e3dc] focus:border-[#e8a000] focus:ring-0 rounded-lg outline-none text-[#1a1a1a] transition-all duration-150">
                                                            <option value="">-- No Division --</option>
                                                            @if (DivisionsList != null)
                                                            {
                                                                foreach (var division in DivisionsList)
                                                                {
                                                                    <option value="@(division.Id)">@(division.Name)</option>
                                                                }
                                                            }
                                                        </select>
                                                    </div>
                                                    <div class="flex-1 w-full">
                                                        <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Role <span class="text-red-500">*</span></label>
                                                        <select @bind="EditModel.role" required class="block w-full px-3 py-2 text-[0.82rem] bg-white border border-[#e5e3dc] focus:border-[#e8a000] focus:ring-0 rounded-lg outline-none text-[#1a1a1a] transition-all duration-150">
                                                            @if (!string.IsNullOrEmpty(EditModel.role) && !RoleNames.Contains(EditModel.role))
                                                            {
                                                                <option value="@EditModel.role">@EditModel.role (legacy)</option>
                                                            }
                                                            @foreach (var r in RoleNames)
                                                            {
                                                                <option value="@r">@r</option>
                                                            }
                                                        </select>
                                                    </div>
                                                    <div class="flex gap-2 w-full sm:w-auto">
                                                        <button type="submit" class="flex-1 sm:flex-none px-4 py-2 bg-[#e8a000] hover:bg-[#d49300] text-[#1a1a1a] text-xs font-bold rounded-lg transition cursor-pointer">Save Changes</button>
                                                        <button type="button" @onclick="CancelEdit" class="flex-1 sm:flex-none px-4 py-2 bg-white border border-[#e5e3dc] hover:bg-[#f0ede5] text-[#3a3835] text-xs font-bold rounded-lg transition cursor-pointer">Cancel</button>
                                                    </div>
                                                </div>
                                                <p class="text-xs text-gray-500 mt-2">* Wajib diisi</p>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mobile Card View -->
            <div class="block md:hidden space-y-3">
                @if (UsersList == null || !UsersList.Any())
                {
                    <div class="px-6 py-16 text-center bg-white rounded-xl border border-[#e5e3dc] shadow-sm">
                        <p class="text-sm text-gray-500">No users found.</p>
                    </div>
                }
                else
                {
                    int index = (CurrentPage - 1) * 10;
                    foreach (var user in UsersList)
                    {
                        index++;
                        bool isEditing = EditingUserId == user.id;
                        
                        @if (!isEditing)
                        {
                            <div class="p-5 bg-white border border-[#e5e3dc] rounded-xl shadow-sm hover:shadow transition-shadow space-y-3">
                                <div class="flex justify-between items-start">
                                    <div>
                                        <span class="text-xs text-gray-400 font-bold">#@index</span>
                                        <h4 class="text-sm font-semibold text-[#1a1a1a] mt-0.5">@user.name</h4>
                                        <p class="text-xs text-gray-500">@user.email</p>
                                    </div>
                                    @{
                                        string bgClass = "bg-[#f5f4f0]";
                                        string textClass = "text-[#8a8780]";
                                        string borderClass = "border-[#e5e3dc]";
                                        if (user.role == "superadmin") { bgClass = "bg-purple-50"; textClass = "text-purple-700"; borderClass = "border-purple-200"; }
                                        else if (user.role == "manager") { bgClass = "bg-[#e0f2fe]"; textClass = "text-[#1a6b8a]"; borderClass = "border-[#bae6fd]"; }
                                        else if (user.role == "admin") { bgClass = "bg-[#fef3c7]"; textClass = "text-[#92400e]"; borderClass = "border-[#fde68a]"; }
                                    }
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold border @bgClass @textClass @borderClass">
                                        @((user.role ?? "").ToUpper())
                                    </span>
                                </div>
                                <div class="grid grid-cols-2 gap-2 pt-2 border-t border-[#f0ede5] text-xs">
                                    <div>
                                        <span class="text-gray-400 font-medium">Poin:</span>
                                        <span class="font-bold text-[#e8a000] ml-1">@user.poin</span>
                                    </div>
                                    <div>
                                        <span class="text-gray-400 font-medium">Division:</span>
                                        <span class="font-semibold text-gray-700 ml-1">@(user.Division?.name ?? "--")</span>
                                    </div>
                                </div>
                                
                                @if (IsAdmin)
                                {
                                    <div class="flex items-center gap-2 pt-3 border-t border-[#f0ede5] justify-end">
                                        <button type="button" @onclick="() => StartEdit(user)"
                                                class="flex-1 text-center text-xs font-bold text-[#3a3835] hover:text-[#1a1a1a] py-2 rounded bg-white border border-[#e5e3dc] hover:bg-[#f0ede5] transition cursor-pointer">
                                            Edit
                                        </button>
                                        @if (CurrentUserId != user.id)
                                        {
                                            <button type="button" @onclick="() => DeleteUser(user.id)"
                                                    class="flex-1 text-center text-xs font-bold text-[#d94040] hover:text-[#b83535] py-2 rounded bg-[#fef0f0] border border-[#f8c0c0] hover:bg-[#fee2e2] transition cursor-pointer">
                                                Delete
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="p-5 bg-[#faf9f5] border border-[#e5e3dc] rounded-xl shadow-sm">
                                <form @onsubmit="() => UpdateUser(user.id)" class="space-y-4">
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                        <div>
                                            <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1">Name <span class="text-red-500">*</span></label>
                                            <input type="text" @bind="EditModel.name" required
                                                   class="block w-full px-3 py-2 text-xs bg-white border border-[#e5e3dc] focus:border-[#e8a000] focus:ring-0 rounded-lg outline-none text-[#1a1a1a] transition-all duration-150">
                                        </div>
                                        <div>
                                            <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1">NRP <span class="text-gray-400 font-normal font-sans">(Optional)</span></label>
                                            <input type="text" @bind="EditModel.nrp"
                                                   class="block w-full px-3 py-2 text-xs bg-white border border-[#e5e3dc] focus:border-[#e8a000] focus:ring-0 rounded-lg outline-none text-[#1a1a1a] transition-all duration-150">
                                        </div>
                                        <div>
                                            <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1">Email <span class="text-red-500">*</span></label>
                                            <input type="email" @bind="EditModel.email" required
                                                   class="block w-full px-3 py-2 text-xs bg-white border border-[#e5e3dc] focus:border-[#e8a000] focus:ring-0 rounded-lg outline-none text-[#1a1a1a] transition-all duration-150">
                                        </div>
                                        <div>
                                            <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1">Poin</label>
                                            <input type="number" @bind="EditModel.poin" placeholder="Poin"
                                                   class="block w-full px-3 py-2 text-xs bg-white border border-[#e5e3dc] focus:border-[#e8a000] focus:ring-0 rounded-lg outline-none text-[#1a1a1a] transition-all duration-150">
                                        </div>
                                        <div>
                                            <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1">New Password <span class="text-gray-400 font-normal font-sans">(Leave blank)</span></label>
                                            <input type="password" @bind="EditPassword" placeholder="New Password"
                                                   class="block w-full px-3 py-2 text-xs bg-white border border-[#e5e3dc] focus:border-[#e8a000] focus:ring-0 rounded-lg outline-none text-[#1a1a1a] transition-all duration-150">
                                        </div>
                                        <div>
                                            <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1">Division <span class="text-red-500">*</span></label>
                                            <select @bind="EditModel.division_id" class="block w-full px-3 py-2 text-[0.82rem] bg-white border border-[#e5e3dc] focus:border-[#e8a000] focus:ring-0 rounded-lg outline-none text-[#1a1a1a] transition-all duration-150">
                                                <option value="">-- No Division --</option>
                                                @if (DivisionsList != null)
                                                {
                                                    foreach (var division in DivisionsList)
                                                    {
                                                        <option value="@(division.Id)">@(division.Name)</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                        <div class="sm:col-span-2">
                                            <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1">Role <span class="text-red-500">*</span></label>
                                            <select @bind="EditModel.role" required class="block w-full px-3 py-2 text-[0.82rem] bg-white border border-[#e5e3dc] focus:border-[#e8a000] focus:ring-0 rounded-lg outline-none text-[#1a1a1a] transition-all duration-150">
                                                <option value="staff">Staff</option>
                                                <option value="manager">Manager</option>
                                                <option value="admin">Admin</option>
                                                <option value="superadmin">Superadmin</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="flex gap-2 pt-2 justify-end">
                                        <button type="submit" class="px-4 py-2 bg-[#e8a000] hover:bg-[#d49300] text-[#1a1a1a] text-xs font-bold rounded-lg transition cursor-pointer">Save Changes</button>
                                        <button type="button" @onclick="CancelEdit" class="px-4 py-2 bg-white border border-[#e5e3dc] hover:bg-[#f0ede5] text-[#3a3835] text-xs font-bold rounded-lg transition cursor-pointer">Cancel</button>
                                    </div>
                                    <p class="text-xs text-gray-500 mt-2">* Wajib diisi</p>
                                </form>
                            </div>
                        }
                    }
                }
            </div>
            
            @if (TotalPages > 1)
            {
                <div class="mt-4 px-6 py-4 border border-[#e5e3dc] rounded-xl flex justify-between items-center bg-white shadow-sm">
                    <span class="text-xs text-[#8a8880]">Halaman @CurrentPage dari @TotalPages</span>
                    <div class="flex gap-2">
                        <button disabled="@(CurrentPage == 1)" @onclick="() => LoadData(CurrentPage - 1)" class="px-3 py-1 bg-white border border-[#e5e3dc] rounded text-sm disabled:opacity-50 hover:bg-gray-50">Prev</button>
                        <button disabled="@(CurrentPage == TotalPages)" @onclick="() => LoadData(CurrentPage + 1)" class="px-3 py-1 bg-white border border-[#e5e3dc] rounded text-sm disabled:opacity-50 hover:bg-gray-50">Next</button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<User>? UsersList;
    private List<DivisionDto>? DivisionsList;
    private int CurrentPage = 1;
    private int TotalPages = 1;
    
    private UserCreateViewModel CreateModel = new() { role = "User" };
    private UserUpdateViewModel EditModel = new();
    private List<string> RoleNames = new();
    private string? EditPassword;
    private int? EditingUserId;
    
    private string? ErrorMessage;
    private string? SuccessMessage;
    private bool IsAdmin = false;
    private bool IsSuperAdmin = false;
    private int CurrentUserId = 0;
    private string? UserRole;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            if (int.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out int id))
                CurrentUserId = id;
            UserRole = user.FindFirst(ClaimTypes.Role)?.Value;
            IsAdmin = user.HasPermission(WMS_UnitedTracors_Blazor.Helpers.Permissions.UsersManage);
            IsSuperAdmin = user.HasPermission(WMS_UnitedTracors_Blazor.Helpers.Permissions.RolesManage);
        }

        var divsResult = await DivisionService.GetDivisionsAsync(1, 100);
        DivisionsList = divsResult.Divisions;
        RoleNames = await AdminRoleService.GetActiveRoleNamesAsync();
        if (RoleNames.Count > 0 && !RoleNames.Contains(CreateModel.role))
            CreateModel.role = RoleNames.Contains("User") ? "User" : RoleNames[0];
        await LoadData(1);
    }

    private async Task LoadData(int page)
    {
        CurrentPage = page;
        var result = await UserService.GetUsersAsync("", CurrentPage, 10);
        UsersList = result.Users;
        TotalPages = result.TotalPages;
    }

    private async Task SaveUser()
    {
        if (string.IsNullOrWhiteSpace(CreateModel.name) || string.IsNullOrWhiteSpace(CreateModel.email) || string.IsNullOrWhiteSpace(CreateModel.password))
        {
            ErrorMessage = "Nama, Email, dan Password wajib diisi.";
            return;
        }

        ErrorMessage = null;
        SuccessMessage = null;

        string? error = null; try { error = await UserService.CreateUserAsync(CreateModel); } catch (Exception ex) { error = $"CRASH: {ex.Message} {ex.InnerException?.Message}"; }

        if (error != null)
        {
            ErrorMessage = error;
        }
        else
        {
            SuccessMessage = "User berhasil ditambahkan.";
            CreateModel = new UserCreateViewModel { role = RoleNames.Count > 0 ? RoleNames[0] : "User" };
            await LoadData(CurrentPage);
        }
    }

    private void StartEdit(User user)
    {
        EditingUserId = user.id;
        EditModel = new UserUpdateViewModel
        {
            name = user.name ?? "",
            email = user.email ?? "",
            nrp = user.nrp,
            poin = user.poin,
            role = user.role ?? (RoleNames.Count > 0 ? RoleNames[0] : "User"),
            division_id = user.division_id
        };
        EditPassword = null;
        ErrorMessage = null;
        SuccessMessage = null;
    }

    private void CancelEdit()
    {
        EditingUserId = null;
    }

    private async Task UpdateUser(int id)
    {
        if (string.IsNullOrWhiteSpace(EditModel.name) || string.IsNullOrWhiteSpace(EditModel.email))
        {
            ErrorMessage = "Nama dan Email wajib diisi.";
            return;
        }

        ErrorMessage = null;
        SuccessMessage = null;

        // If password is provided, we should update it. In the UserUpdateViewModel, we might need a password field.
        // Wait, the UserUpdateViewModel I defined didn't have password. But let's check what UserService does.
        // Wait, UserService.UpdateUserAsync might need custom logic for password.
        // I will just pass the EditModel and if I need to update the password I will just leave it up to the existing API.
        // Let's assume UserUpdateViewModel has a password field? If not, the old code didn't update it directly via this endpoint anyway, or maybe it did. Let's just leave EditPassword unhandled for now if it doesn't compile, or add it.

        EditModel.password = EditPassword;
        string? error = null; try { error = await UserService.UpdateUserAsync(id, EditModel, CurrentUserId, UserRole); } catch (Exception ex) { error = $"CRASH: {ex.Message} {ex.InnerException?.Message}"; }

        if (error != null)
        {
            ErrorMessage = error;
        }
        else
        {
            SuccessMessage = "User berhasil diupdate.";
            EditingUserId = null;
            await LoadData(CurrentPage);
        }
    }

    private async Task DeleteUser(int id)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Apakah Anda yakin ingin menghapus user ini?");
        if (!confirmed) return;

        ErrorMessage = null;
        SuccessMessage = null;
        try
        {
            var error = await UserService.DeleteUserAsync(id, CurrentUserId);
            if (error != null)
            {
                ErrorMessage = error;
            }
            else
            {
                SuccessMessage = "User berhasil dihapus.";
                await LoadData(CurrentPage);
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Gagal menghapus user: " + ex.Message;
        }
    }
}



