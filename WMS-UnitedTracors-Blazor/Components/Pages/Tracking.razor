    private async Task LoadData()
    {
        var allUsages = await TrackingService.GetTrackingDataAsync(
            DivisionId, ProductSearch, ReturnStatus, DateFrom, DateTo, CurrentUserId, UserRole);

        // Client side grouping logic similar to laravel
        var tempGrouped = new Dictionary<string, List<Transaction>>();
        foreach (var item in allUsages)
        {
            var key = TrackingService.CreateTrackingGroupId(item);
            if (!tempGrouped.ContainsKey(key))
            {
                tempGrouped[key] = new List<Transaction>();
            }
            tempGrouped[key].Add(item);
        }

        var finalGrouped = new Dictionary<string, List<Transaction>>();
        
        foreach (var kvp in tempGrouped)
        {
            var groupItems = kvp.Value;
            var firstItem = groupItems.First();
            
            // Skip fully returned borrow events
            if (firstItem.request_type == "BORROW" && firstItem.status == "APPROVED")
            {
                var totalQty = groupItems.Sum(x => x.quantity);
                var totalRet = groupItems.Sum(x => x.returned_quantity);
                if (totalRet >= totalQty) continue;
            }

            bool matchesCriteria = true;

            if (!string.IsNullOrEmpty(ProductSearch))
            {
                var s = ProductSearch.ToLower();
                matchesCriteria = groupItems.Any(i => 
                    (i.Product?.name?.ToLower().Contains(s) ?? false) || 
                    (i.Product?.sku?.ToLower().Contains(s) ?? false));
            }

            if (matchesCriteria && !string.IsNullOrEmpty(ReturnStatus) && groupItems.Any(i => i.request_type == "BORROW"))
            {
                if (ReturnStatus == "pending")
                {
                    matchesCriteria = groupItems.Any(i => i.request_type == "BORROW" && i.returned_quantity < i.quantity);
                }
                else if (ReturnStatus == "returned")
                {
                    matchesCriteria = groupItems.Any(i => i.request_type == "BORROW" && i.returned_quantity >= i.quantity);
                }
            }

            if (matchesCriteria)
            {
                finalGrouped[kvp.Key] = groupItems;
            }
        }

        GroupedUsages = finalGrouped;

        // Default state: semua grup collapse, biarkan user expand manual.
        ExpandedGroupIds.Clear();
        ShowAllProductsGroupIds.Clear();
    }

