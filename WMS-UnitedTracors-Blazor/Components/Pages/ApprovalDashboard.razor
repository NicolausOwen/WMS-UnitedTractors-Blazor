    private Dictionary<string, List<Transaction>>? GroupedApprovals;
    private List<Transaction>? PendingReturns;
    private List<ProfileRequest>? PendingProfileRequests;
    private Dictionary<string, List<Transaction>>? GroupedHandovers;
    
    private string? SuccessMessage;
    private string? ErrorMessage;
    private bool IsProcessing = false;

    private int CurrentUserId = 0;
    private string? UserRole;
    private string ActiveTab = "new";

    private HashSet<string> ExpandedGroups = new();
    
    private Dictionary<int, string> Decisions = new();
    private Dictionary<int, string> Reasons = new();
    private Dictionary<int, string> ReturnDecisions = new();
    private Dictionary<int, string> ReturnReasons = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            if (int.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out int id))
                CurrentUserId = id;
            UserRole = user.FindFirst(ClaimTypes.Role)?.Value;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        var data = await ApprovalService.GetApprovalsAsync(CurrentUserId, UserRole);
        GroupedApprovals = data.GroupedApprovals;
        PendingReturns = data.PendingReturns;
        PendingProfileRequests = data.PendingProfileRequests;
        GroupedHandovers = data.GroupedHandovers;
        
        ExpandedGroups.Clear();
        if (GroupedApprovals != null && GroupedApprovals.Any())
        {
            ExpandedGroups.Add(GroupedApprovals.First().Key);
        }
        
        Decisions.Clear();
        Reasons.Clear();
        ReturnDecisions.Clear();
        ReturnReasons.Clear();
    }

    private void ToggleGroup(string groupId)
    {
        if (ExpandedGroups.Contains(groupId))
            ExpandedGroups.Remove(groupId);
        else
            ExpandedGroups.Add(groupId);
    }

    private void SetDecision(int id, string decision)
    {
        Decisions[id] = decision;
        if (!Reasons.ContainsKey(id)) Reasons[id] = "";
    }
    
    private bool ShowRejectModal = false;
    private int RejectItemId = 0;
    private string RejectReason = "";
    private bool IsRejectingReturn = false;
    private bool RejectionError = false;

    private void OpenRejectModal(int id, bool isReturn = false)
    {
        RejectItemId = id;
        IsRejectingReturn = isReturn;
        RejectReason = "";
        RejectionError = false;
        ShowRejectModal = true;
    }

    private void CloseRejectModal()
    {
        ShowRejectModal = false;
        RejectItemId = 0;
        IsRejectingReturn = false;
        RejectionError = false;
    }

    private void SubmitReject(string decision)
    {
        if (string.IsNullOrWhiteSpace(RejectReason))
        {
            RejectionError = true;
            return;
        }

        if (RejectItemId > 0)
        {
            if (IsRejectingReturn)
            {
                ReturnDecisions[RejectItemId] = "REJECT";
                ReturnReasons[RejectItemId] = RejectReason;
            }
            else
            {
                Decisions[RejectItemId] = decision;
                Reasons[RejectItemId] = RejectReason;
            }
        }
        CloseRejectModal();
    }

    private void ClearDecision(int id, bool isReturn = false)
    {
        if (isReturn)
        {
            if (ReturnDecisions.ContainsKey(id)) ReturnDecisions.Remove(id);
            if (ReturnReasons.ContainsKey(id)) ReturnReasons.Remove(id);
        }
        else
        {
            if (Decisions.ContainsKey(id)) Decisions.Remove(id);
            if (Reasons.ContainsKey(id)) Reasons.Remove(id);
        }
    }

    private void SetReturnDecision(int id, string decision)
    {
        if (decision == "REJECT")
        {
            OpenRejectModal(id, true);
        }
        else
        {
            ReturnDecisions[id] = decision;
            // Wajib: input "Notes" mengikat ke ReturnReasons[id] saat dirender,
            // jadi key harus ada agar tidak melempar KeyNotFoundException.
            if (!ReturnReasons.ContainsKey(id)) ReturnReasons[id] = "";
        }
    }

    private bool ShowBatchConfirmModal = false;
    private void OpenBatchConfirmModal()
    {
        if (Decisions.Count == 0) return;
        ShowBatchConfirmModal = true;
    }

    private bool ShowHandoverRejectModal = false;
    private string HandoverRejectGroupId = "";
    private string HandoverRejectReason = "";
    private bool HandoverRejectionError = false;

    private void OpenHandoverRejectModal(string groupId)
    {
        HandoverRejectGroupId = groupId;
        HandoverRejectReason = "";
        HandoverRejectionError = false;
        ShowHandoverRejectModal = true;
    }

    private void CloseHandoverRejectModal()
    {
        ShowHandoverRejectModal = false;
        HandoverRejectGroupId = "";
        HandoverRejectionError = false;
    }

    private async Task ConfirmHandoverReject()
    {
        if (string.IsNullOrWhiteSpace(HandoverRejectReason))
        {
            HandoverRejectionError = true;
            return;
        }

        if (IsProcessing) return;
        IsProcessing = true;
        try
        {
            var err = await ApprovalService.RejectHandoverBatchAsync(HandoverRejectGroupId, HandoverRejectReason, CurrentUserId, UserRole);
            if (err == null)
            {
                SuccessMessage = "Handover rejected successfully.";
                CloseHandoverRejectModal();
                await LoadData();
            }
            else ErrorMessage = err;
        }
        catch (Exception ex)
        {
            ErrorMessage = "Terjadi kesalahan saat menolak serah terima: " + ex.Message;
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private async Task ApproveAllGroup(List<Transaction> items)
    {
        if (IsProcessing) return;
        IsProcessing = true;
        ErrorMessage = null;
        SuccessMessage = null;

        try
        {
            int successCount = 0;
            foreach (var item in items)
            {
                var err = await ApprovalService.ApproveAsync(item.id, null, CurrentUserId, UserRole);
                if (err != null) ErrorMessage += $"Item {item.id}: {err} | ";
                else successCount++;
            }

            if (successCount > 0) SuccessMessage = $"{successCount} items approved.";
            await LoadData();
        }
        catch (Exception ex)
        {
            ErrorMessage = "Terjadi kesalahan saat menyetujui: " + ex.Message;
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private async Task ProcessBatch()
    {
        if (IsProcessing) return;
        IsProcessing = true;
        ErrorMessage = null;
        SuccessMessage = null;

        try
        {
            int successCount = 0;
            foreach (var kvp in Decisions.ToList())
            {
                var id = kvp.Key;
                var action = kvp.Value;
                var reason = Reasons.GetValueOrDefault(id, "");

                if ((action == "REJECT" || action == "REVISE") && string.IsNullOrWhiteSpace(reason))
                {
                    ErrorMessage = "Please provide a reason for all rejected or revised items.";
                    return;
                }

                string? err = null;
                if (action == "APPROVE") err = await ApprovalService.ApproveAsync(id, reason, CurrentUserId, UserRole);
                else if (action == "REJECT") err = await ApprovalService.RejectAsync(id, reason, CurrentUserId, UserRole);
                else if (action == "REVISE") err = await ApprovalService.RequestRevisionAsync(id, reason, CurrentUserId, UserRole);

                if (err != null) ErrorMessage += $"Item {id}: {err} | ";
                else successCount++;
            }

            if (successCount > 0) SuccessMessage = $"{successCount} items processed.";
            await LoadData();
            ShowBatchConfirmModal = false;
        }
        catch (Exception ex)
        {
            ErrorMessage = "Terjadi kesalahan saat memproses permintaan: " + ex.Message;
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private async Task ProcessBatchReturns()
    {
        if (IsProcessing) return; // cegah klik ganda (mencegah operasi paralel di DbContext yang sama)
        IsProcessing = true;
        ErrorMessage = null;
        SuccessMessage = null;

        try
        {
            int successCount = 0;
            foreach (var kvp in ReturnDecisions.ToList())
            {
                var id = kvp.Key;
                var action = kvp.Value;
                var reason = ReturnReasons.GetValueOrDefault(id, "");

                string? err = null;
                if (action == "APPROVE") err = await ApprovalService.ApproveReturnAsync(id, CurrentUserId, UserRole);
                else if (action == "REJECT") err = await ApprovalService.RejectReturnAsync(id, reason, CurrentUserId, UserRole);

                if (err != null) ErrorMessage += $"Return {id}: {err} | ";
                else successCount++;
            }

            if (successCount > 0) SuccessMessage = $"{successCount} return requests processed.";
            await LoadData();
        }
        catch (Exception ex)
        {
            ErrorMessage = "Terjadi kesalahan saat memproses pengembalian: " + ex.Message;
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private async Task ApproveHandoverBatch(string groupId)
    {
        if (IsProcessing) return;
        IsProcessing = true;
        ErrorMessage = null;
        SuccessMessage = null;
        try
        {
            var err = await ApprovalService.ApproveHandoverBatchAsync(groupId, CurrentUserId, UserRole);
            if (err == null) SuccessMessage = "Handover approved successfully.";
            else ErrorMessage = err;
            await LoadData();
        }
        catch (Exception ex)
        {
            ErrorMessage = "Terjadi kesalahan saat memproses serah terima: " + ex.Message;
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private async Task RejectHandoverBatch(string groupId)
    {
        if (string.IsNullOrWhiteSpace(HandoverRejectReason))
        {
            ErrorMessage = "Alasan penolakan wajib diisi.";
            return;
        }
        if (IsProcessing) return;
        IsProcessing = true;
        try
        {
            var err = await ApprovalService.RejectHandoverBatchAsync(groupId, HandoverRejectReason, CurrentUserId, UserRole);
            if (err == null)
            {
                SuccessMessage = "Handover rejected successfully.";
                HandoverRejectGroupId = "";
            }
            else ErrorMessage = err;

            await LoadData();
        }
        catch (Exception ex)
        {
            ErrorMessage = "Terjadi kesalahan saat menolak serah terima: " + ex.Message;
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private async Task ApproveProfileRequest(int id)
    {
        if (IsProcessing) return;
        IsProcessing = true;
        ErrorMessage = null;
        SuccessMessage = null;
        try
        {
            string? err = await ApprovalService.ApproveProfileRequestAsync(id, CurrentUserId, UserRole);
            if (err != null) ErrorMessage = err; else SuccessMessage = "Profile request approved.";
            await LoadData();
        }
        catch (Exception ex)
        {
            ErrorMessage = "Terjadi kesalahan: " + ex.Message;
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private async Task RejectProfileRequest(int id)
    {
        if (IsProcessing) return;
        IsProcessing = true;
        ErrorMessage = null;
        SuccessMessage = null;
        try
        {
            string? err = await ApprovalService.RejectProfileRequestAsync(id, CurrentUserId, UserRole);
            if (err != null) ErrorMessage = err; else SuccessMessage = "Profile request rejected.";
            await LoadData();
        }
        catch (Exception ex)
        {
            ErrorMessage = "Terjadi kesalahan: " + ex.Message;
        }
        finally
        {
            IsProcessing = false;
        }
    }
}