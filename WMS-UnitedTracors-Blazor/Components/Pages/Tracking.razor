    private async Task SubmitHandoverToAdmin(List<Transaction> borrowItems)
    {
        if (IsSubmitting) return;
        var ids = borrowItems.Where(i => i.status == "WAITING_HANDOVER").Select(i => i.id).ToList();
        if (!ids.Any()) return;

        IsSubmitting = true;
        ErrorMessage = null;
        SuccessMessage = null;
        try
        {
            var err = await TransactionService.SubmitHandoverAsync(ids);
            if (err == null)
            {
                SuccessMessage = borrowItems.FirstOrDefault()?.request_type == "GIVEAWAY"
                    ? "Serah terima giveaway selesai. Sistem sekarang menunggu dokumentasi user."
                    : "Bukti serah terima dikirim. Menunggu verifikasi admin.";
                await LoadData();
            }
            else
            {
                ErrorMessage = err;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Terjadi kesalahan saat submit serah terima: " + ex.Message;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

