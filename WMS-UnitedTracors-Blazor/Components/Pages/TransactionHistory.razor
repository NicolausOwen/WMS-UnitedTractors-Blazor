@page "/Transactions/History"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using UT_WMSDotnet.Models
@using WMS_UnitedTracors_Blazor.Services
@inject TransactionService TransactionService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Transaction History</PageTitle>

<div class="px-4 md:px-10 py-6 pb-24 font-sans bg-[#f5f4f0] min-h-screen">
    <div class="flex justify-between items-center mb-6">
        <h2 class="font-semibold text-xl text-gray-800 leading-tight">
            Transaction History
        </h2>
    </div>

    <div class="bg-white rounded-xl border border-gray-200">
        <div class="px-6 py-5 border-b border-gray-100 flex gap-4">
            <select @bind="FilterType" class="px-3 py-2 border rounded-lg text-sm bg-white">
                <option value="">All Types</option>
                <option value="OUT">Pengeluaran (OUT)</option>
                <option value="IN">Pemasukan (IN)</option>
            </select>
            
            <input type="date" @bind="StartDate" class="px-3 py-2 border rounded-lg text-sm" />
            <input type="date" @bind="EndDate" class="px-3 py-2 border rounded-lg text-sm" />
            
            <button @onclick="() => LoadData(1)" class="px-4 py-2 bg-gray-900 text-white rounded-lg text-sm">Filter</button>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="border-b border-gray-100">
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider">Product</th>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider">Requester</th>
                        <th class="px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                    @if (Transactions == null)
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-8 text-center text-gray-500">Loading...</td>
                        </tr>
                    }
                    else if (!Transactions.Any())
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-8 text-center text-gray-500">No transactions found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var t in Transactions)
                        {
                            <tr class="hover:bg-gray-50/50">
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                    @t.created_at.ToString("dd MMM yyyy HH:mm")
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-sm font-medium text-gray-900">@(t.Product?.name ?? "--")</div>
                                    <div class="text-xs text-gray-500">Qty: @t.quantity</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    @if (t.type == "OUT")
                                    {
                                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">OUT</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">IN</span>
                                    }
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                    @(t.Requester?.name ?? "--")
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    @if (t.status == "APPROVED")
                                    {
                                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">APPROVED</span>
                                    }
                                    else if (t.status == "REJECTED")
                                    {
                                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">REJECTED</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">PENDING</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (TotalPages > 1)
        {
            <div class="px-6 py-4 border-t border-gray-100 flex items-center justify-between">
                <span class="text-sm text-gray-500">Showing page @CurrentPage of @TotalPages</span>
                <div class="flex gap-2">
                    <button disabled="@(CurrentPage == 1)" @onclick="() => LoadData(CurrentPage - 1)" class="px-3 py-1 border rounded hover:bg-gray-50 disabled:opacity-50">Previous</button>
                    <button disabled="@(CurrentPage == TotalPages)" @onclick="() => LoadData(CurrentPage + 1)" class="px-3 py-1 border rounded hover:bg-gray-50 disabled:opacity-50">Next</button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<Transaction>? Transactions;
    
    private int CurrentPage = 1;
    private int PageSize = 10;
    private int TotalPages = 1;
    private int TotalItems = 0;

    private string? FilterType;
    private DateTime? StartDate;
    private DateTime? EndDate;

    private int CurrentUserId = 0;
    private string? UserRole;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            var idClaim = user.FindFirst(ClaimTypes.NameIdentifier);
            if (idClaim != null && int.TryParse(idClaim.Value, out int id))
            {
                CurrentUserId = id;
            }
            UserRole = user.FindFirst(ClaimTypes.Role)?.Value;
        }

        await LoadData(1);
    }

    private async Task LoadData(int page)
    {
        CurrentPage = page;
        var result = await TransactionService.GetHistoryAsync(CurrentUserId, UserRole, FilterType, StartDate, EndDate, CurrentPage, PageSize);
        
        Transactions = result.Transactions;
        TotalItems = result.TotalItems;
        TotalPages = result.TotalPages;
    }
}
