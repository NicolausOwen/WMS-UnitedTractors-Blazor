@page "/Reports"
@using System.Text.Json
@using UT_WMSDotnet.Models
@using UT_WMSDotnet.ViewModels
@using WMS_UnitedTracors_Blazor.Services
@inject ReportService ReportService
@inject DivisionService DivisionService
@inject IJSRuntime JSRuntime
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>WMS - Laporan Stok</PageTitle>

<div class="py-12 bg-[#f5f4f0] min-h-screen font-sans">
    <div class="max-w-7xl mx-auto sm:px-6 lg:px-8">
        <div class="mb-6">
            <h1 class="text-[1.6rem] font-bold text-[#1a1a1a] leading-none tracking-tight">Laporan <span class="text-[#e8a000]">Stok</span></h1>
            <div class="text-[0.72rem] font-medium text-[#a09e99] mt-1">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</div>
        </div>

        <div class="bg-white rounded-xl border border-[#e5e3dc] mb-6 overflow-hidden shadow-sm">
            
            @* Collapsible Header *@
            <div @onclick="ToggleFilters" 
                 role="button"
                 tabindex="0"
                 class="px-5 py-3.5 bg-[#faf9f5] flex items-center justify-between cursor-pointer select-none hover:bg-[#f3f2eb] transition duration-150 group outline-none focus:bg-[#f3f2eb] @(ShowFilters ? "border-b border-[#e5e3dc]" : "")">
                <div class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-[#8a8880] group-hover:text-gray-900 transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 0 1-.659 1.591l-5.432 5.432a2.25 2.25 0 0 0-.659 1.591v2.927a2.25 2.25 0 0 1-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 0 0-.659-1.591L3.659 7.409A2.25 2.25 0 0 1 3 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0 1 12 3Z"/>
                    </svg>
                    <span class="text-[0.68rem] font-extrabold text-[#5a5855] group-hover:text-gray-900 tracking-wider uppercase transition">Filter Laporan</span>
                    @if (HasActiveFilters)
                    {
                        <span class="px-2 py-0.5 rounded text-[9px] font-extrabold bg-[#fff8e6] text-[#b37a00] border border-[#ffe099] uppercase tracking-wider">
                            Aktif
                        </span>
                    }
                </div>
                <div class="text-[#8a8880] group-hover:text-gray-700 transition">
                    <svg class="w-4 h-4 transition-transform duration-200 @(!ShowFilters ? "rotate-180" : "")" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
                    </svg>
                </div>
            </div>

            @* Collapsible Content *@
            @if (ShowFilters)
            {
                <div class="bg-white">
                    <div class="px-5 py-4">
                        <div class="flex flex-col lg:flex-row flex-wrap gap-3 items-end">
                            <div class="flex-1 min-w-[180px] w-full">
                                <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Start Date</label>
                                <input type="date" @bind="StartDate" class="block w-full px-3 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none transition-colors duration-150 text-[#1a1a1a]">
                            </div>
                            <div class="flex-1 min-w-[180px] w-full">
                                <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">End Date</label>
                                <input type="date" @bind="EndDate" class="block w-full px-3 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none transition-colors duration-150 text-[#1a1a1a]">
                            </div>
                            <div class="min-w-[150px] w-full lg:w-auto">
                                <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Filter Type</label>
                                <select @bind="FilterType" class="block w-full px-3 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none transition-colors duration-150 text-[#1a1a1a]">
                                    <option value="">All Types</option>
                                    <option value="IN">STOCK IN</option>
                                    <option value="OUT">STOCK OUT</option>
                                </select>
                            </div>
                            <div class="flex gap-2 w-full lg:w-auto justify-end">
                                <button type="button" @onclick="ApplyFilter" class="px-5 py-2 bg-[#e8a000] text-[#1a1a1a] text-xs font-bold rounded-lg transition active:scale-95 cursor-pointer whitespace-nowrap">
                                    Apply
                                </button>
                                <button type="button" @onclick="ResetFilter" class="px-5 py-2 bg-white border border-[#e5e3dc] text-[#3a3835] text-xs font-bold rounded-lg cursor-pointer">
                                    Reset
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="px-5 pb-4">
                        <div class="flex flex-col sm:flex-row flex-wrap gap-2 justify-end">
                            <a href="/api/pdf/peminjaman?start=@StartDate.ToString("yyyy-MM-dd")&end=@EndDate.ToString("yyyy-MM-dd")" target="_blank" class="w-full sm:w-auto px-4 py-2.5 bg-[#e8a000] hover:bg-[#d49300] text-[#1a1a1a] text-xs font-bold rounded-lg transition inline-flex items-center justify-center gap-1.5 shadow-sm">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                PDF Peminjaman
                            </a>
                            <a href="/api/pdf/request?start=@StartDate.ToString("yyyy-MM-dd")&end=@EndDate.ToString("yyyy-MM-dd")" target="_blank" class="w-full sm:w-auto px-4 py-2.5 bg-[#e8a000] hover:bg-[#d49300] text-[#1a1a1a] text-xs font-bold rounded-lg transition inline-flex items-center justify-center gap-1.5 shadow-sm">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                PDF Request
                            </a>
                            <a href="/api/pdf/adjust?start=@StartDate.ToString("yyyy-MM-dd")&end=@EndDate.ToString("yyyy-MM-dd")" target="_blank" class="w-full sm:w-auto px-4 py-2.5 bg-[#e8a000] hover:bg-[#d49300] text-[#1a1a1a] text-xs font-bold rounded-lg transition inline-flex items-center justify-center gap-1.5 shadow-sm">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                PDF Adjust
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (Summary != null && ExecSummary != null)
        {
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                <!-- Peminjaman -->
                <a href="/Reports/Peminjaman" class="block bg-white border border-[#e5e3dc] rounded-lg shadow-sm hover:shadow-md transition p-6 group">
                    <div class="flex items-center justify-between mb-4">
                        <div class="w-12 h-12 rounded-lg bg-blue-100 flex items-center justify-center">
                            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
                        </div>
                        <span class="text-xs font-semibold text-blue-600 bg-blue-50 px-2 py-1 rounded-full group-hover:bg-blue-100 transition">View Details &rarr;</span>
                    </div>
                    <h3 class="text-lg font-bold text-gray-900 mb-1">Peminjaman Barang</h3>
                    <p class="text-sm text-gray-500 mb-4">Barang dipinjam <span class="font-semibold text-gray-700">(BORROW)</span></p>
                    <div class="grid grid-cols-2 gap-4 pt-4 border-t border-gray-100">
                        <div>
                            <div class="text-2xl font-bold text-gray-900">@Summary["peminjaman"].Count</div>
                            <div class="text-xs text-gray-500">Total Transaksi</div>
                        </div>
                        <div>
                            <div class="text-2xl font-bold text-gray-900">@Summary["peminjaman"].TotalQty</div>
                            <div class="text-xs text-gray-500">Total Qty</div>
                        </div>
                        <div>
                            <div class="text-lg font-bold text-emerald-600">@Summary["peminjaman"].Approved</div>
                            <div class="text-xs text-gray-500">Approved</div>
                        </div>
                        <div>
                            <div class="text-lg font-bold text-amber-600">@Summary["peminjaman"].Pending</div>
                            <div class="text-xs text-gray-500">Pending</div>
                        </div>
                    </div>
                </a>

                <!-- Request Barang -->
                <a href="/Reports/RequestBarang" class="block bg-white border border-[#e5e3dc] rounded-lg shadow-sm hover:shadow-md transition p-6 group">
                    <div class="flex items-center justify-between mb-4">
                        <div class="w-12 h-12 rounded-lg bg-purple-100 flex items-center justify-center">
                            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                        </div>
                        <span class="text-xs font-semibold text-purple-600 bg-purple-50 px-2 py-1 rounded-full group-hover:bg-purple-100 transition">View Details &rarr;</span>
                    </div>
                    <h3 class="text-lg font-bold text-gray-900 mb-1">Request Barang</h3>
                    <p class="text-sm text-gray-500 mb-4">Barang giveaway <span class="font-semibold text-gray-700">(GIVEAWAY)</span></p>
                    <div class="grid grid-cols-2 gap-4 pt-4 border-t border-gray-100">
                        <div>
                            <div class="text-2xl font-bold text-gray-900">@Summary["request_barang"].Count</div>
                            <div class="text-xs text-gray-500">Total Transaksi</div>
                        </div>
                        <div>
                            <div class="text-2xl font-bold text-gray-900">@Summary["request_barang"].TotalQty</div>
                            <div class="text-xs text-gray-500">Total Qty</div>
                        </div>
                        <div>
                            <div class="text-lg font-bold text-emerald-600">@Summary["request_barang"].Approved</div>
                            <div class="text-xs text-gray-500">Approved</div>
                        </div>
                        <div>
                            <div class="text-lg font-bold text-amber-600">@Summary["request_barang"].Pending</div>
                            <div class="text-xs text-gray-500">Pending</div>
                        </div>
                    </div>
                </a>

                <!-- Update Barang -->
                <a href="/Reports/AdjustBarang" class="block bg-white border border-[#e5e3dc] rounded-lg shadow-sm hover:shadow-md transition p-6 group">
                    <div class="flex items-center justify-between mb-4">
                        <div class="w-12 h-12 rounded-lg bg-emerald-100 flex items-center justify-center">
                            <svg class="w-6 h-6 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        </div>
                        <span class="text-xs font-semibold text-emerald-600 bg-emerald-50 px-2 py-1 rounded-full group-hover:bg-emerald-100 transition">View Details &rarr;</span>
                    </div>
                    <h3 class="text-lg font-bold text-gray-900 mb-1">Update Barang</h3>
                    <p class="text-sm text-gray-500 mb-4">Stock masuk <span class="font-semibold text-gray-700">(STOCK IN)</span></p>
                    <div class="grid grid-cols-2 gap-4 pt-4 border-t border-gray-100">
                        <div>
                            <div class="text-2xl font-bold text-gray-900">@Summary["adjust_barang"].Count</div>
                            <div class="text-xs text-gray-500">Total Transaksi</div>
                        </div>
                        <div>
                            <div class="text-2xl font-bold text-gray-900">@Summary["adjust_barang"].TotalQty</div>
                            <div class="text-xs text-gray-500">Total Qty</div>
                        </div>
                        <div>
                            <div class="text-lg font-bold text-emerald-600">@Summary["adjust_barang"].Approved</div>
                            <div class="text-xs text-gray-500">Approved</div>
                        </div>
                        <div>
                            <div class="text-lg font-bold text-amber-600">@Summary["adjust_barang"].Pending</div>
                            <div class="text-xs text-gray-500">Pending</div>
                        </div>
                    </div>
                </a>
            </div>

            <!-- Executive Summary -->
            <div class="grid grid-cols-1 lg:grid-cols-4 gap-6 mb-8">
                <div class="lg:col-span-1 flex flex-col gap-4">
                    <div class="grid grid-cols-2 gap-4">
                        <div class="bg-white border border-[#e5e3dc] rounded-lg shadow-sm p-5">
                            <p class="text-[0.65rem] font-bold tracking-wider uppercase text-gray-500 mb-1">Total Dipinjam</p>
                            <p class="text-2xl font-bold text-gray-900">@ExecSummary.TotalBorrowed</p>
                        </div>
                        <div class="bg-white border border-[#e5e3dc] rounded-lg shadow-sm p-5">
                            <p class="text-[0.65rem] font-bold tracking-wider uppercase text-gray-500 mb-1">Sudah Kembali</p>
                            <p class="text-2xl font-bold text-gray-900">@ExecSummary.TotalReturned</p>
                        </div>
                        <div class="bg-white border border-[#e5e3dc] rounded-lg shadow-sm p-5">
                            <p class="text-[0.65rem] font-bold tracking-wider uppercase text-gray-500 mb-1">Masih Dipinjam</p>
                            <p class="text-2xl font-bold text-gray-900">@ExecSummary.MasihDipinjam</p>
                        </div>
                        <div class="bg-white border border-[#e5e3dc] rounded-lg shadow-sm p-5">
                            <p class="text-[0.65rem] font-bold tracking-wider uppercase text-gray-500 mb-1">Barang Keluar</p>
                            <p class="text-2xl font-bold text-gray-900">@ExecSummary.TotalItemsOut</p>
                        </div>
                    </div>
                    <div class="bg-white border border-[#e5e3dc] rounded-lg shadow-sm p-5">
                        <p class="text-[0.65rem] font-bold tracking-wider uppercase text-gray-500 mb-1">Pending Return</p>
                        <p class="text-2xl font-bold text-gray-900">@ExecSummary.PendingReturns</p>
                    </div>
                </div>
                <div class="lg:col-span-3 bg-white border border-[#e5e3dc] rounded-lg shadow-sm p-5">
                    <p class="text-[0.65rem] font-bold tracking-wider uppercase text-gray-500 mb-3">Status Peminjaman</p>
                    <div style="position:relative;height:250px;" class="flex items-center justify-center">
                        <canvas id="chartExecutiveSummary"></canvas>
                    </div>
                </div>
            </div>

            <!-- Charts -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
                <div class="bg-white border border-[#e5e3dc] rounded-lg shadow-sm p-5">
                    <p class="text-[0.65rem] font-bold tracking-wider uppercase text-gray-500 mb-3">Peminjaman Barang (12 Bulan)</p>
                    <div style="position:relative;height:250px;">
                        <canvas id="chartPeminjaman"></canvas>
                    </div>
                </div>
                <div class="bg-white border border-[#e5e3dc] rounded-lg shadow-sm p-5">
                    <p class="text-[0.65rem] font-bold tracking-wider uppercase text-gray-500 mb-3">Barang Keluar (12 Bulan)</p>
                    <div style="position:relative;height:250px;">
                        <canvas id="chartBarangKeluar"></canvas>
                    </div>
                </div>
            </div>

            <!-- Recent Transactions -->
            <div class="bg-white/95 border border-gray-200 rounded-[1.5rem] shadow-xl overflow-hidden">
                <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
                    <h3 class="font-bold text-gray-900">Recent Transactions</h3>
                    <a href="/Transactions/History" class="text-sm font-semibold text-[var(--color-ut-yellow)] hover:underline">View All</a>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left whitespace-nowrap">
                        <thead class="text-gray-500 text-[0.65rem] uppercase tracking-wider border-b border-gray-100 bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 font-semibold">Date</th>
                                <th class="px-4 py-3 font-semibold">Product</th>
                                <th class="px-4 py-3 font-semibold">Type</th>
                                <th class="px-4 py-3 font-semibold">Qty</th>
                                <th class="px-4 py-3 font-semibold">Division</th>
                                <th class="px-4 py-3 font-semibold">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            @if (ExecSummary.RecentTransactions != null && ExecSummary.RecentTransactions.Any())
                            {
                                @foreach (var item in ExecSummary.RecentTransactions)
                                {
                                    <tr class="hover:bg-gray-50 transition">
                                        <td class="px-6 py-3 text-sm text-gray-600">@item.created_at.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="px-4 py-3">
                                            <div class="text-sm font-semibold text-gray-900">@(item.Product?.name)</div>
                                            <code class="text-xs text-gray-500">@(item.Product?.sku)</code>
                                        </td>
                                        <td class="px-4 py-3">
                                            @if (item.type == "IN")
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 border border-[#b8e8c0] rounded-md text-[0.65rem] font-bold bg-[#eef9f0] text-[#1a7a30]">STOCK IN</span>
                                            }
                                            else if (item.request_type == "BORROW")
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 border border-[#bae6fd] rounded-md text-[0.65rem] font-bold bg-[#e0f2fe] text-[#1a6b8a]">BORROW</span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 border border-[#e5e3dc] rounded-md text-[0.65rem] font-bold bg-[#f5f4f0] text-[#8a8780]">GIVEAWAY</span>
                                            }
                                        </td>
                                        <td class="px-4 py-3 text-sm font-bold text-gray-900">@item.quantity</td>
                                        <td class="px-4 py-3 text-sm text-gray-700">@(item.Division?.name ?? "-")</td>
                                        <td class="px-4 py-3">
                                            @if (item.status == "PENDING")
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 border border-[#fde68a] rounded-md text-[0.65rem] font-bold bg-[#fef3c7] text-[#92400e]">WAITING</span>
                                            }
                                            else if (item.status == "APPROVED")
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 border border-[#b8e8c0] rounded-md text-[0.65rem] font-bold bg-[#eef9f0] text-[#1a7a30]">APPROVED</span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 border border-[#f8c0c0] rounded-md text-[0.65rem] font-bold bg-[#fef0f0] text-[#d94040]">REJECTED</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="px-6 py-8 text-center text-gray-500">No transactions found</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>

<script>
    window.renderReportCharts = function (data) {
        if (typeof Chart === 'undefined') return;

        // Ensure previous charts are destroyed
        if (window.chartP) window.chartP.destroy();
        if (window.chartB) window.chartB.destroy();
        if (window.chartES) window.chartES.destroy();

        const chartPeminjaman = document.getElementById('chartPeminjaman');
        const chartBarangKeluar = document.getElementById('chartBarangKeluar');
        const chartES = document.getElementById('chartExecutiveSummary');

        if (chartPeminjaman) {
            window.chartP = new Chart(chartPeminjaman, {
                type: 'bar',
                data: {
                    labels: data.labels,
                    datasets: [{
                        label: 'Peminjaman',
                        data: data.peminjaman,
                        backgroundColor: '#e8a000',
                        borderRadius: 4,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, ticks: { precision: 0 } }
                    }
                }
            });
        }

        if (chartBarangKeluar) {
            window.chartB = new Chart(chartBarangKeluar, {
                type: 'bar',
                data: {
                    labels: data.labels,
                    datasets: [{
                        label: 'Barang Keluar',
                        data: data.barangKeluar,
                        backgroundColor: '#1a1a1a',
                        borderRadius: 4,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, ticks: { precision: 0 } }
                    }
                }
            });
        }

        if (chartES) {
            window.chartES = new Chart(chartES, {
                type: 'doughnut',
                data: {
                    labels: ['Dipinjam', 'Sudah Kembali', 'Masih Dipinjam'],
                    datasets: [{
                        data: [data.totalBorrowed, data.totalReturned, data.masihDipinjam],
                        backgroundColor: ['#e8a000', '#1a7a30', '#d94040'],
                        borderWidth: 0,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '65%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                padding: 16,
                                usePointStyle: true,
                                font: { size: 11, weight: '600' },
                                color: '#3a3835'
                            }
                        }
                    }
                }
            });
        }
    }
</script>

@code {
    private Dictionary<string, ReportSummaryDto>? Summary;
    private ExecutiveSummaryDto? ExecSummary;

    private bool ShowFilters = false;
    private string? FilterType = "";

    private bool HasActiveFilters => StartDate != DateTime.Now.AddMonths(-1).Date || EndDate != DateTime.Now.Date || !string.IsNullOrEmpty(FilterType);

    private void ToggleFilters()
    {
        ShowFilters = !ShowFilters;
    }

    private DateTime StartDate = DateTime.Now.AddMonths(-1).Date;
    private DateTime EndDate = DateTime.Now.Date;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!authState.User.HasPermission(WMS_UnitedTracors_Blazor.Helpers.Permissions.ReportsView)
            && !authState.User.HasPermission(WMS_UnitedTracors_Blazor.Helpers.Permissions.ProductsManage))
        {
            Navigation.NavigateTo("/");
            return;
        }
        await LoadData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ExecSummary != null)
        {
            await JSRuntime.InvokeVoidAsync("renderReportCharts", new
            {
                labels = ExecSummary.ChartLabels,
                peminjaman = ExecSummary.ChartPeminjaman,
                barangKeluar = ExecSummary.ChartBarangKeluar,
                totalBorrowed = ExecSummary.TotalBorrowed,
                totalReturned = ExecSummary.TotalReturned,
                masihDipinjam = ExecSummary.MasihDipinjam
            });
        }
    }

    private async Task ApplyFilter()
    {
        await LoadData();
    }

    private async Task ResetFilter()
    {
        StartDate = DateTime.Now.AddMonths(-1).Date;
        EndDate = DateTime.Now.Date;
        await LoadData();
    }

    private async Task LoadData()
    {
        Summary = await ReportService.GetSummaryAsync(StartDate, EndDate);
        ExecSummary = await ReportService.GetExecutiveSummaryAsync(StartDate, EndDate);
    }
}
