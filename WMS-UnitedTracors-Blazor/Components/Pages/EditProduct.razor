@page "/editproduct/{Id:int}"
@page "/Product/Edit/{Id:int}"
@page "/Product-Edit/{Id:int}"
@using UT_WMSDotnet.ViewModels
@using WMS_UnitedTracors_Blazor.Services
@using UT_WMSDotnet.Models
@inject ProductService ProductService
@inject CategoryService CategoryService
@inject LocationService LocationService
@inject UnitService UnitService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>WMS - Edit Product</PageTitle>

<header class="bg-transparent">
    <div class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
        <div class="mb-1">
            <h1 class="text-[1.6rem] font-bold text-[#1a1a1a] leading-none tracking-tight">Edit <span class="text-[#e8a000]">Produk</span></h1>
            <div class="text-[0.72rem] font-medium text-[#a09e99] mt-1">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</div>
        </div>
    </div>
</header>

<div class="py-8">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
        @if (IsLoading)
        {
            <div class="p-6 text-center text-gray-500 flex flex-col items-center">
                <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-[#e8a000] mb-4"></div>
                Loading product details...
            </div>
        }
        else if (ProductNotFound)
        {
            <div class="p-10 text-center flex flex-col items-center bg-white rounded-xl border border-gray-200 shadow-sm">
                <svg class="w-12 h-12 text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <h3 class="text-lg font-medium text-gray-900">Product Not Found</h3>
                <p class="text-sm text-gray-500 mt-1 mb-6">The product you are trying to edit does not exist or has been removed.</p>
                <button @onclick="NavigateBack" class="btn-ut btn-ut-primary">Return to List</button>
            </div>
        }
        else
        {
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm">
                <div class="px-6 py-5 border-b border-gray-100 flex items-center gap-4">
                    <button @onclick="NavigateBack" class="p-2 bg-white border border-gray-200 rounded-lg text-gray-600 hover:text-gray-900 hover:bg-gray-50 transition shrink-0">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
                    </button>
                    <div>
                        <h3 class="text-sm font-semibold text-gray-900">Edit Product</h3>
                        <p class="text-xs text-gray-500 mt-0.5">Update the product information below.</p>
                    </div>
                </div>
                <div class="px-6 py-6">
                    <EditForm Model="Model" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />
                        
                        @if (!string.IsNullOrEmpty(ErrorMessage))
                        {
                            <div class="mb-6 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm" role="alert">
                                @ErrorMessage
                            </div>
                        }

                        <div class="space-y-5">
                            @* SKU *@
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1.5">SKU / Barcode ID</label>
                                <InputText @bind-Value="Model.sku" required class="block w-full py-2 px-3 text-sm bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-[#e8a000] focus:border-[#e8a000] outline-none transition" />
                                <ValidationMessage For="@(() => Model.sku)" class="text-red-600 text-xs mt-1 block" />
                            </div>

                            @* Barcode Type *@
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1.5">Barcode Type</label>
                                <InputSelect @bind-Value="Model.barcode_type" required class="block w-full py-2 px-3 text-sm bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-[#e8a000] focus:border-[#e8a000] outline-none transition">
                                    <option value="TYPE_CODE_128">Code 128 (Recommended)</option>
                                    <option value="TYPE_CODE_39">Code 39</option>
                                    <option value="TYPE_EAN_13">EAN-13</option>
                                    <option value="TYPE_UPC_A">UPC-A</option>
                                </InputSelect>
                                <ValidationMessage For="@(() => Model.barcode_type)" class="text-red-600 text-xs mt-1 block" />
                            </div>

                            @* Product Name & Point Value *@
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                <div class="md:col-span-2">
                                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Product Name</label>
                                    <InputText @bind-Value="Model.name" required class="block w-full py-2 px-3 text-sm bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-[#e8a000] focus:border-[#e8a000] outline-none transition" />
                                    <ValidationMessage For="@(() => Model.name)" class="text-red-600 text-xs mt-1 block" />
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Point Value</label>
                                    <InputNumber @bind-Value="Model.value" min="0" placeholder="0" class="block w-full py-2 px-3 text-sm bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-[#e8a000] focus:border-[#e8a000] outline-none transition" />
                                    <ValidationMessage For="@(() => Model.value)" class="text-red-600 text-xs mt-1 block" />
                                </div>
                            </div>

                            @* Unit *@
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1.5">Unit</label>
                                @if (ShowNewUnitInput)
                                {
                                    <div class="relative mt-1">
                                        <InputText @bind-Value="Model.unit" placeholder="Type new unit..." class="block w-full py-2 px-3 text-sm bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-[#e8a000] focus:border-[#e8a000] outline-none transition pr-10" />
                                        <button type="button" @onclick="CancelNewUnit" class="absolute inset-y-0 right-0 flex items-center px-3 text-gray-400 hover:text-gray-600 transition" title="Cancel and select existing">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <InputSelect Value="SelectedUnitOption" ValueExpression="() => SelectedUnitOption" ValueChanged="(string val) => HandleUnitSelect(val)" required class="block w-full py-2 px-3 text-sm bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-[#e8a000] focus:border-[#e8a000] outline-none transition">
                                        <option value="">Select unit</option>
                                        @if (Units != null)
                                        {
                                            @foreach(var u in Units)
                                            {
                                                <option value="@u.Name">@u.Name</option>
                                            }
                                        }
                                        <option value="NEW_UNIT_OPTION" class="font-bold text-gray-900 bg-gray-100">+ Type New Unit...</option>
                                    </InputSelect>
                                }
                                <ValidationMessage For="@(() => Model.unit)" class="text-red-600 text-xs mt-1 block" />
                            </div>

                            @* Category & Transaction Type *@
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Category</label>
                                    <InputSelect @bind-Value="Model.category_id" required class="block w-full py-2 px-3 text-sm bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-[#e8a000] focus:border-[#e8a000] outline-none transition">
                                        <option value="0">Select category (required)</option>
                                        @if (Categories != null)
                                        {
                                            @foreach(var cat in Categories)
                                            {
                                                <option value="@cat.Id">@cat.Name</option>
                                            }
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="@(() => Model.category_id)" class="text-red-600 text-xs mt-1 block" />
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Transaction Type</label>
                                    <InputSelect @bind-Value="Model.transaction_type" class="block w-full py-2 px-3 text-sm bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-[#e8a000] focus:border-[#e8a000] outline-none transition">
                                        <option value="">Default (Borrow & Request)</option>
                                        <option value="BORROW">Peminjaman (Borrow Only)</option>
                                        <option value="REQUEST">Permintaan (Request Only)</option>
                                    </InputSelect>
                                    <ValidationMessage For="@(() => Model.transaction_type)" class="text-red-600 text-xs mt-1 block" />
                                </div>
                            </div>

                            @* Description *@
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1.5">Product Description</label>
                                <InputTextArea @bind-Value="Model.description" rows="4" placeholder="Tuliskan kondisi, spesifikasi, atau catatan penting barang..." class="block w-full rounded-3xl border border-[#e5e3dc] bg-[#faf9f5] px-4 py-3 text-sm text-[#1a1a1a] focus:border-[#e8a000] focus:bg-white focus:outline-none focus:ring-4 focus:ring-[#fef3c7] transition duration-200"></InputTextArea>
                                <ValidationMessage For="@(() => Model.description)" class="text-red-600 text-xs mt-1 block" />
                                <p class="text-xs text-gray-400 mt-2">Deskripsi ini membantu tim approval dan gudang memahami kondisi / catatan barang.</p>
                            </div>

                            @* Is Returnable *@
                            <div>
                                <label class="flex items-center gap-2 cursor-pointer w-max">
                                    <InputCheckbox @bind-Value="Model.is_returnable" class="rounded border-gray-300 text-gray-900 focus:ring-gray-900 w-4 h-4 transition outline-none" />
                                    <span class="text-sm font-medium text-gray-700">Item is Returnable <span class="text-xs text-gray-500 font-normal">(Uncheck this for Merchandise/Giveaways)</span></span>
                                </label>
                            </div>

                            @* Location & Position Image *@
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Location</label>
                                    <InputSelect @bind-Value="Model.location_id" class="block w-full py-2 px-3 text-sm bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-[#e8a000] focus:border-[#e8a000] outline-none transition">
                                        <option value="">Select location (optional)</option>
                                        @if (Locations != null)
                                        {
                                            @foreach(var loc in Locations)
                                            {
                                                <option value="@loc.Id">@loc.Name</option>
                                            }
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="@(() => Model.location_id)" class="text-red-600 text-xs mt-1 block" />
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Position Image</label>
                                    <div class="flex items-center gap-3">
                                    @if (product != null && !string.IsNullOrEmpty(product.position_image) && !Model.remove_position_image)
                                    {
                                        <div class="relative w-10 h-10 rounded border border-gray-200 overflow-hidden bg-gray-50 shrink-0">
                                            <img src="@ImageHelper.Resolve(product.position_image)" class="w-full h-full object-cover" alt="Position" />
                                            <button type="button" @onclick="() => Model.remove_position_image = true" class="absolute top-0.5 right-0.5 w-4 h-4 bg-gray-900/70 text-white rounded-full flex items-center justify-center hover:bg-gray-900 transition">
                                                <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                                            </button>
                                        </div>
                                    }
                                        @if (positionPreviewUrl != null)
                                        {
                                            <div class="w-10 h-10 rounded border border-gray-200 overflow-hidden bg-gray-50 shrink-0">
                                                <img src="@positionPreviewUrl" class="w-full h-full object-cover" alt="Preview">
                                            </div>
                                        }
                                        <div class="flex-1">
                                            <InputFile OnChange="HandlePositionImageSelected" accept="image/jpg,image/jpeg,image/png,image/webp" class="block w-full text-sm text-gray-500 file:mr-2 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-medium file:bg-gray-100 file:text-gray-700 hover:file:bg-gray-200 transition cursor-pointer" />
                                        </div>
                                    </div>
                                    <ValidationMessage For="@(() => Model.position_image)" class="text-red-600 text-xs mt-1 block" />
                                </div>
                            </div>

                            @* Product Images *@
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1.5">Product Images</label>
                                <div class="space-y-4">
                                    @if (existingImages.Any())
                                    {
                                        <div class="flex flex-wrap gap-3">
                                            @foreach (var img in existingImages)
                                            {
                                                <div class="relative w-20 h-20 rounded-lg border border-gray-200 overflow-hidden bg-gray-50 shrink-0">
                                                    <img src="@ImageHelper.Resolve(img)" class="w-full h-full object-cover" alt="Product Image">
                                                    <button type="button" @onclick="() => RemoveExistingImage(img)" class="absolute top-0.5 right-0.5 w-5 h-5 bg-gray-900/70 text-white rounded-full flex items-center justify-center text-xs hover:bg-gray-900 transition">
                                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    }

                                    <div class="flex items-center gap-3">
                                        @if (imagePreviews.Any())
                                        {
                                            <div class="flex flex-wrap gap-2">
                                                @foreach (var prev in imagePreviews)
                                                {
                                                    <div class="w-20 h-20 rounded-lg border border-gray-200 overflow-hidden bg-gray-50 shrink-0">
                                                        <img src="@prev" class="w-full h-full object-cover" alt="New Preview">
                                                    </div>
                                                }
                                            </div>
                                        }
                                        <div class="flex-1">
                                            <InputFile OnChange="HandleImageSelected" multiple accept="image/jpg,image/jpeg,image/png,image/webp" class="block w-full text-sm text-gray-500 file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-gray-100 file:text-gray-700 hover:file:bg-gray-200 transition cursor-pointer" />
                                            <p class="text-xs text-gray-400 mt-1">Upload one or multiple new product images. JPG, PNG or WebP. Max 10MB each.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @* Stock Info *@
                            <div class="p-4 bg-gray-50 border border-gray-200 rounded-lg">
                                <p class="text-xs font-medium text-gray-500 mb-2">Stock Information</p>
                                <div class="grid grid-cols-2 gap-4 text-sm">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Initial Stock:</label>
                                        <InputNumber @bind-Value="Model.initial_stock" required min="0" class="block w-full py-2 px-3 text-sm bg-white border border-gray-200 rounded-lg focus:ring-2 focus:ring-[#e8a000] focus:border-[#e8a000] outline-none transition" />
                                        <ValidationMessage For="@(() => Model.initial_stock)" class="text-red-600 text-xs mt-1 block" />
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Current Stock:</label>
                                        <InputNumber @bind-Value="Model.current_stock" required min="0" class="block w-full py-2 px-3 text-sm bg-white border border-gray-200 rounded-lg focus:ring-2 focus:ring-[#e8a000] focus:border-[#e8a000] outline-none transition" />
                                        <ValidationMessage For="@(() => Model.current_stock)" class="text-red-600 text-xs mt-1 block" />
                                    </div>
                                </div>
                            </div>

                            @* Product Variants *@
                            <div class="pt-4 border-t border-gray-100">
                                <div class="flex justify-between items-center mb-4">
                                    <div>
                                        <h4 class="text-sm font-semibold text-gray-900">Product Variants</h4>
                                        <p class="text-xs text-gray-500 mt-0.5">Edit sizes, colors, and specific stock/images for this product.</p>
                                    </div>
                                    <button type="button" @onclick="AddVariant" class="px-3 py-1.5 bg-gray-100 text-gray-700 rounded-lg text-xs font-medium hover:bg-gray-200 transition">
                                        + Add Variant
                                    </button>
                                </div>
                                
                                <div class="space-y-3">
                                    @for (int i = 0; i < Model.variants.Count; i++)
                                    {
                                        var index = i;
                                        var variant = Model.variants[index];
                                        <div class="flex items-end gap-3 p-3 bg-gray-50 border border-gray-200 rounded-lg">
                                            <div class="flex-1">
                                                <label class="block text-xs font-medium text-gray-700 mb-1">Color</label>
                                                <InputText @bind-Value="variant.color" placeholder="e.g. Red" class="block w-full py-1.5 px-2 text-sm bg-white border border-gray-200 rounded-md focus:ring-[#e8a000] focus:border-[#e8a000] outline-none" />
                                            </div>
                                            <div class="flex-1">
                                                <label class="block text-xs font-medium text-gray-700 mb-1">Size</label>
                                                <InputText @bind-Value="variant.size" placeholder="e.g. L" class="block w-full py-1.5 px-2 text-sm bg-white border border-gray-200 rounded-md focus:ring-[#e8a000] focus:border-[#e8a000] outline-none" />
                                            </div>
                                            <div class="w-24">
                                                <label class="block text-xs font-medium text-gray-700 mb-1">Stock</label>
                                                <InputNumber @bind-Value="variant.stock" min="0" class="block w-full py-1.5 px-2 text-sm bg-white border border-gray-200 rounded-md focus:ring-[#e8a000] focus:border-[#e8a000] outline-none" />
                                            </div>
                                            <div class="flex-1">
                                                <label class="block text-xs font-medium text-gray-700 mb-1">Variant Image</label>
                                                <div class="flex items-center gap-2 mb-1.5">
                                                    @if (!string.IsNullOrEmpty(variant.image_preview_url))
                                                    {
                                                        <div class="w-10 h-10 rounded border border-gray-200 overflow-hidden shrink-0 bg-white shadow-sm">
                                                            <img src="@variant.image_preview_url" class="w-full h-full object-cover">
                                                        </div>
                                                    }
                                                    else if (!string.IsNullOrEmpty(variant.existing_image))
                                                    {
                                                        <div class="w-10 h-10 rounded border border-gray-200 overflow-hidden shrink-0 bg-white shadow-sm">
                                                            <img src="@ImageHelper.Resolve(variant.existing_image)" class="w-full h-full object-cover">
                                                        </div>
                                                    }
                                                </div>
                                                <InputFile OnChange="@(e => HandleVariantImageSelected(e, variant))" accept="image/*" class="block w-full text-xs text-gray-500 file:mr-2 file:py-1 file:px-2 file:rounded file:border-0 file:bg-gray-200" />
                                            </div>
                                            <div>
                                                <button type="button" @onclick="() => RemoveVariant(variant)" class="px-2 py-1.5 text-red-600 hover:bg-red-50 rounded-md transition" title="Remove">
                                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                            
                            <div class="flex justify-end items-center gap-3 border-t border-gray-100 pt-5 mt-6">
                                <button type="button" @onclick="NavigateBack" class="px-4 py-2 bg-white text-gray-700 border border-gray-300 rounded-lg font-medium text-sm hover:bg-gray-50 transition">Cancel</button>
                                <button type="submit" disabled="@IsSubmitting" class="px-4 py-2 bg-gray-900 text-white rounded-lg font-medium text-sm hover:bg-gray-800 transition disabled:opacity-70 flex items-center gap-2 justify-center min-w-[130px]">
                                    @if (IsSubmitting)
                                    {
                                        <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-white"></div>
                                        <span>Processing...</span>
                                    }
                                    else
                                    {
                                        <span>Update Product</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </EditForm>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private ProductUpdateViewModel Model = new();
    private List<WMS_UnitedTracors_Blazor.Services.CategoryDto>? Categories;
    private List<WMS_UnitedTracors_Blazor.Services.LocationDto>? Locations;
    private List<WMS_UnitedTracors_Blazor.Services.UnitDto>? Units;
    private Product? product;
    
    private string? ErrorMessage;
    private bool IsSubmitting;
    private bool IsLoading = true;
    private bool ProductNotFound = false;

    private IReadOnlyList<Microsoft.AspNetCore.Components.Forms.IBrowserFile>? selectedImages;
    private List<string> imagePreviews = new();
    private List<string> existingImages = new();
    private Microsoft.AspNetCore.Components.Forms.IBrowserFile? selectedPositionImage;
    private string? positionPreviewUrl;

    private bool ShowNewUnitInput = false;
    private string SelectedUnitOption = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity == null || !user.Identity.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        var role = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
        if (role != "admin" && role != "superadmin")
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        var catResult = await CategoryService.GetCategoriesAsync(1, 100);
        var locResult = await LocationService.GetLocationsAsync(1, 100);
        var unitResult = await UnitService.GetUnitsAsync(1, 100);
        
        product = await ProductService.GetProductByIdAsync(Id);

        Categories = catResult.Categories;
        Locations = locResult.Locations;
        Units = unitResult.Units;

        if (product == null)
        {
            ProductNotFound = true;
        }
        else
        {
            Model.sku = product.sku;
            Model.barcode_type = product.barcode_type ?? "TYPE_CODE_128";
            Model.name = product.name;
            Model.unit = product.Unit?.name ?? "";
            SelectedUnitOption = Model.unit;
            Model.value = product.value;
            Model.category_id = product.category_id ?? 0;
            Model.location_id = product.location_id;
            Model.current_stock = product.current_stock;
            Model.initial_stock = product.initial_stock;
            Model.is_returnable = product.is_returnable == 1;
            Model.description = product.description ?? "";
            Model.transaction_type = product.transaction_type ?? "";

            Model.variants = product.ProductVariants?.Select(v => new ProductVariantViewModel
            {
                id = v.id,
                sku = v.sku,
                color = v.color,
                size = v.size,
                stock = v.stock,
                existing_image = v.image
            }).ToList() ?? new List<ProductVariantViewModel>();
            
            if (!string.IsNullOrEmpty(product.images))
            {
                try { existingImages = System.Text.Json.JsonSerializer.Deserialize<List<string>>(product.images) ?? new List<string>(); }
                catch { existingImages = new List<string>(); }
            }
            else if (!string.IsNullOrEmpty(product.image))
            {
                existingImages.Add(product.image);
            }
        }
        
        IsLoading = false;
    }

    private void HandleUnitSelect(string val)
    {
        if (val == "NEW_UNIT_OPTION")
        {
            ShowNewUnitInput = true;
            Model.unit = "";
        }
        else
        {
            SelectedUnitOption = val;
            Model.unit = val;
            ShowNewUnitInput = false;
        }
    }

    private void CancelNewUnit()
    {
        ShowNewUnitInput = false;
        Model.unit = product?.Unit?.name ?? "";
        SelectedUnitOption = Model.unit;
    }

    private async Task HandleSubmit()
    {
        if (Model.category_id == 0)
        {
            ErrorMessage = "Please select a category.";
            return;
        }
        if (string.IsNullOrWhiteSpace(Model.unit))
        {
            ErrorMessage = "Please specify a unit.";
            return;
        }

        IsSubmitting = true;
        ErrorMessage = null;
        StateHasChanged();

        if (selectedImages != null && selectedImages.Any())
        {
            Model.new_images.Clear();
            foreach (var imgFile in selectedImages)
            {
                var format = "image/jpeg";
                var compressedImage = await imgFile.RequestImageFileAsync(format, 1024, 1024);
                var ms = new System.IO.MemoryStream();
                await compressedImage.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).CopyToAsync(ms);
                ms.Position = 0;
                Model.new_images.Add(new Microsoft.AspNetCore.Http.FormFile(ms, 0, compressedImage.Size, "new_images", imgFile.Name)
                {
                    Headers = new Microsoft.AspNetCore.Http.HeaderDictionary(),
                    ContentType = format
                });
            }
        }

        if (selectedPositionImage != null)
        {
            var format = "image/jpeg";
            var compressedImage = await selectedPositionImage.RequestImageFileAsync(format, 1024, 1024);
            var ms = new System.IO.MemoryStream();
            await compressedImage.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).CopyToAsync(ms);
            ms.Position = 0;
            Model.position_image = new Microsoft.AspNetCore.Http.FormFile(ms, 0, compressedImage.Size, "position_image", selectedPositionImage.Name)
            {
                Headers = new Microsoft.AspNetCore.Http.HeaderDictionary(),
                ContentType = format
            };
        }

        var result = await ProductService.UpdateProductAsync(Id, Model);
        
        IsSubmitting = false;

        if (result == null)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Perubahan produk berhasil disimpan!");
            NavigationManager.NavigateTo("/Product?success=updated");
        }
        else
        {
            ErrorMessage = result;
        }
    }

    private async Task HandleImageSelected(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        selectedImages = e.GetMultipleFiles(10);
        imagePreviews.Clear();
        foreach (var file in selectedImages)
        {
            var format = "image/jpeg";
            var resizedImageFile = await file.RequestImageFileAsync(format, 400, 400);
            using var ms = new System.IO.MemoryStream();
            await resizedImageFile.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).CopyToAsync(ms);
            imagePreviews.Add($"data:{format};base64,{Convert.ToBase64String(ms.ToArray())}");
        }
    }

    private void RemoveExistingImage(string imagePath)
    {
        existingImages.Remove(imagePath);
        Model.removed_images.Add(imagePath);
    }

    private async Task HandlePositionImageSelected(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        selectedPositionImage = e.File;
        var format = "image/jpeg";
        var resizedImageFile = await e.File.RequestImageFileAsync(format, 400, 400);
        using var ms = new System.IO.MemoryStream();
        await resizedImageFile.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).CopyToAsync(ms);
        positionPreviewUrl = $"data:{format};base64,{Convert.ToBase64String(ms.ToArray())}";
    }

    private void AddVariant()
    {
        Model.variants.Add(new ProductVariantViewModel());
    }

    private void RemoveVariant(ProductVariantViewModel variant)
    {
        Model.variants.Remove(variant);
    }

    private async Task HandleVariantImageSelected(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e, ProductVariantViewModel variant)
    {
        var format = "image/jpeg";
        var resizedForUpload = await e.File.RequestImageFileAsync(format, 1024, 1024);
        variant.image = resizedForUpload;
        
        var resizedForPreview = await e.File.RequestImageFileAsync(format, 100, 100);
        using var ms = new System.IO.MemoryStream();
        await resizedForPreview.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).CopyToAsync(ms);
        variant.image_preview_url = $"data:{format};base64,{Convert.ToBase64String(ms.ToArray())}";
    }

    private void NavigateBack()
    {
        NavigationManager.NavigateTo("/Product");
    }
}
