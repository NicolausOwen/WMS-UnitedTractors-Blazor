                                    {
                                        <div class="bg-white p-4 rounded-xl border border-[#e5e3dc] shadow-sm pt-4">
                                            <span class="block text-[10px] font-bold text-[#8a8780] uppercase tracking-wider mb-1">Notes</span>
                                            <p class="text-xs text-[#5a5855]">@firstItem.notes</p>
                                        </div>
                                    }

                                    <!-- Table of Items (Tracking.razor style) -->
                                    <div class="overflow-x-auto rounded-xl border border-[#e5e3dc] shadow-sm bg-white">
                                        <table class="w-full text-left border-collapse whitespace-nowrap">
                                            <thead>
                                                <tr class="bg-[#f5f4f0] border-b border-[#e5e3dc]">
                                                    <th class="px-4 py-2.5 text-[0.65rem] font-bold tracking-wider uppercase text-[#8a8780]">Product Details</th>
                                                    <th class="px-4 py-2.5 text-[0.65rem] font-bold tracking-wider uppercase text-[#8a8780]">Qty / Stok</th>
                                                    <th class="px-4 py-2.5 text-[0.65rem] font-bold tracking-wider uppercase text-[#8a8780]">Credit</th>
                                                    <th class="px-4 py-2.5 text-[0.65rem] font-bold tracking-wider uppercase text-[#8a8780]">Type</th>
                                                    <th class="px-4 py-2.5 text-[0.65rem] font-bold tracking-wider uppercase text-[#8a8780]">Reviewed By</th>
                                                    <th class="px-4 py-2.5 text-[0.65rem] font-bold tracking-wider uppercase text-[#8a8780]">Processed At</th>
                                                    <th class="px-4 py-2.5 text-[0.65rem] font-bold tracking-wider uppercase text-[#8a8780] text-right">Status / Aksi</th>
                                                </tr>
                                            </thead>
                                            <tbody class="divide-y divide-[#e5e3dc]">
                                                @foreach (var item in items)
                                                {
                                                    <tr class="hover:bg-[#faf9f5] transition-colors">
                                                        <td class="px-4 py-3 align-middle">
                                                            <div class="flex items-center gap-3">
                                                                <div class="w-9 h-9 rounded border border-[#e5e3dc] overflow-hidden flex-shrink-0 bg-white flex items-center justify-center">
                                                                    <img src="@ImageHelper.ResolveProduct(item.Product, "/img/logo.svg")" class="w-full h-full object-cover">
                                                                </div>
                                                                <div>
                                                                    <div class="text-xs font-bold text-[#1a1a1a]">@(item.Product?.name)</div>
                                                                    <code class="text-[9px] text-gray-500 bg-white border border-[#e5e3dc] px-1.5 py-0.5 rounded">@(item.Product?.sku)</code>
                                                                </div>
                                                            </div>
                                                        </td>
                                                        <td class="px-4 py-3 align-middle">
                                                            <div class="text-xs font-bold text-[#1a1a1a]">
                                                                @item.quantity
                                                                <span class="text-[10px] font-normal text-gray-500">Pcs</span>
                                                            </div>
                                                            <div class="text-[9px] text-gray-400">Stock: @(item.Product?.current_stock)</div>
                                                        </td>
                                                        <td class="px-4 py-3 align-middle">
                                                            @if (item.request_type == "GIVEAWAY" && item.Product?.value > 0)
                                                            {
                                                                <div class="text-xs font-bold text-[#1a1a1a] flex items-center gap-1">
                                                                    <svg class="w-3.5 h-3.5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                                                    @(((double)((item.quantity ?? 0) * item.Product!.value)).ToString("N0"))
                                                                </div>
                                                                <div class="text-[9px] text-gray-400">@(((double)item.Product!.value).ToString("N0")) per unit</div>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-gray-400 text-xs font-medium">-</span>
                                                            }
                                                        </td>
                                                        <td class="px-4 py-3 align-middle">
                                                            @if (item.request_type == "BORROW") {
                                                                <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold bg-[#eef9f0] text-[#1a7a30] border border-[#b8e8c0]">BORROW</span>
                                                            } else if (item.request_type == "GIVEAWAY") {
                                                                <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold bg-[#e0f2fe] text-[#1a6b8a] border border-[#bae6fd]">GIVEAWAY</span>
                                                            } else {
                                                                <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold bg-white text-gray-600 border border-gray-200">STOCK IN</span>
                                                            }
                                                        </td>
                                                        <td class="px-4 py-3 align-middle">
                                                            @if (item.Approver != null) {
                                                                <div class="text-xs font-bold text-[#1a1a1a]">@item.Approver.name</div>
                                                                <div class="text-[9px] text-gray-500">@item.Approver.role</div>
                                                            } else {
                                                                <span class="text-gray-400 text-xs">-</span>
                                                            }
                                                        </td>
                                                        <td class="px-4 py-3 align-middle">
                                                            @if (item.status != "PENDING" && item.status != "PENDING_STAFF_INVENTORY" && item.status != "PENDING_ADMIN" && item.status != "PENDING_MANAGER") {
                                                                <div class="text-xs text-gray-600 font-medium">@(item.updated_at.ToString("dd MMM yyyy"))</div>
                                                                <div class="text-[9px] text-gray-400">@(item.updated_at.ToString("HH:mm"))</div>
                                                            } else {
                                                                <span class="text-gray-400 text-xs">-</span>
                                                            }
                                                        </td>
                                                        <td class="px-4 py-3 align-middle text-right">
                                                            @if (item.status == "PENDING" || item.status == "PENDING_STAFF_INVENTORY" || item.status == "PENDING_ADMIN" || item.status == "PENDING_MANAGER") {
                                                                <span class="inline-flex items-center px-1.5 py-0.5 border border-[#fde68a] rounded text-[9px] font-bold bg-[#fef3c7] text-[#92400e]">WAITING</span>
                                                            } else if (item.status == "APPROVED" || item.status == "COMPLETED") {
                                                                <span class="inline-flex items-center px-1.5 py-0.5 border border-[#b8e8c0] rounded text-[9px] font-bold bg-[#eef9f0] text-[#1a7a30]">APPROVED</span>
                                                            } else if (item.status == "REVISION" || item.status == "REVISION_BY_STAFF_INVENTORY" || item.status == "REVISION_BY_ADMIN" || item.status == "REVISION_BY_MANAGER") {
                                                                <div class="flex flex-col gap-1.5 items-end">
                                                                    <span class="inline-flex items-center px-1.5 py-0.5 border border-[#bae6fd] rounded text-[9px] font-bold bg-[#e0f2fe] text-[#1a6b8a]">REVISION</span>
                                                                    <button @onclick="() => OpenRevisionModal(item)" class="text-[9px] font-bold bg-[#e8a000] text-[#1a1a1a] px-2 py-1 rounded shadow-sm hover:bg-[#d49300] active:scale-95 transition">Revise Now</button>
                                                                </div>
                                                            } else if (item.status == "REJECTED") {
                                                                <span class="inline-flex items-center px-1.5 py-0.5 border border-[#f8c0c0] rounded text-[9px] font-bold bg-[#fef0f0] text-[#d94040]">REJECTED</span>
                                                            } else if (item.status == "WAITING_HANDOVER" || item.status == "WAITING_ADMIN_HANDOVER" || item.status == "WAITING_HANDOVER_CONFIRM") {
                                                                <span class="inline-flex items-center px-1.5 py-0.5 border border-[#bae6fd] rounded text-[9px] font-bold bg-[#e0f2fe] text-[#1a6b8a]">HANDOVER</span>
                                                            } else {
                                                                <span class="inline-flex items-center px-1.5 py-0.5 border border-[#e5e3dc] rounded text-[9px] font-bold bg-[#f5f4f0] text-[#8a8780]">@item.status</span>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (TotalPages > 1)
            {
                <div class="mt-8 flex items-center justify-between bg-white px-6 py-4 rounded-xl border border-[#e5e3dc] shadow-sm">
                    <span class="text-xs font-bold text-[#8a8880]">Halaman <span class="text-[#1a1a1a]">@CurrentPage</span> dari @TotalPages</span>
                    <div class="flex gap-2">
                        <button disabled="@(CurrentPage == 1)" @onclick="() => LoadData(CurrentPage - 1)" class="w-10 h-10 flex items-center justify-center rounded-lg border border-[#e5e3dc] hover:bg-[#faf9f5] transition disabled:opacity-30">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                        </button>
                        <button disabled="@(CurrentPage == TotalPages)" @onclick="() => LoadData(CurrentPage + 1)" class="w-10 h-10 flex items-center justify-center rounded-lg border border-[#e5e3dc] hover:bg-[#faf9f5] transition disabled:opacity-30">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                        </button>
                    </div>
                </div>
            }
        }
    </div>
</div>

<Modal Show="@(ShowRevisionModal && RevisionItem != null)" Title="Revisi Permintaan" Size="xl" OnClose="CloseRevisionModal">
  <ChildContent>
    @if (RevisionItem != null)
    {
                <div class="p-4 bg-[#fffbeb] border border-[#fde68a] text-[#92400e] text-xs rounded-xl flex items-start gap-3">
                    <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                    <div>
                        <div class="font-bold">Alasan Revisi dari Admin:</div>
                        <div class="mt-1 italic">"@RevisionItem.rejection_reason"</div>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Nama Pemohon</label>
                        <input type="text" @bind="RevisionModel.applicant_name" class="w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] border border-[#e5e3dc] rounded-lg outline-none focus:border-[#e8a000]" />
                    </div>
                    <div>
                        <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">NRP</label>
                        <input type="text" @bind="RevisionModel.applicant_nrp" class="w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] border border-[#e5e3dc] rounded-lg outline-none focus:border-[#e8a000]" />
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Kuantitas</label>
                        <input type="number" @bind="RevisionModel.quantity" class="w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] border border-[#e5e3dc] rounded-lg outline-none focus:border-[#e8a000]" />
                    </div>
