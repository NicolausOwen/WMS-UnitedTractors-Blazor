@page "/Product"
@using UT_WMSDotnet.Models
@using WMS_UnitedTracors_Blazor.Services
@inject ProductService ProductService
@inject CategoryService CategoryService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>Products</PageTitle>

<header class="bg-transparent">
    <div class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center">
            <div class="mb-1">
                <h1 class="text-[1.6rem] font-bold text-[#1a1a1a] leading-none tracking-tight">Data <span class="text-[#e8a000]">Produk</span></h1>
                <div class="text-[0.72rem] font-medium text-[#a09e99] mt-1">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</div>
            </div>
            @if (IsAdmin)
            {
                <a href="/createproduct" class="inline-flex items-center gap-2 px-4 py-2 bg-gray-900 text-white text-sm font-medium rounded-lg hover:bg-gray-800 transition">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
                    Add Product
                </a>
            }
        </div>
    </div>
</header>

<div class="py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="mb-6 flex items-center gap-3 bg-[#eef9f0] border border-[#b8e8c0] text-[#1a7a30] px-4 py-3 rounded-lg text-sm" role="alert">
                <svg class="w-4 h-4 shrink-0 text-[#1a7a30]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                @SuccessMessage
            </div>
        }
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="mb-6 flex items-center gap-3 bg-[#fef0f0] border border-[#f8c0c0] text-[#d94040] px-4 py-3 rounded-lg text-sm" role="alert">
                <svg class="w-4 h-4 shrink-0 text-[#d94040]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                @ErrorMessage
            </div>
        }

        @if (Categories != null && Categories.Any())
        {
            <div class="flex items-center gap-2 mb-6 overflow-x-auto pb-1" style="scrollbar-width: none; -ms-overflow-style: none;">
                <button @onclick="() => FilterByCategory(null)"
                        class="px-3.5 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap border transition @(!SelectedCategoryId.HasValue ? "bg-gray-900 text-white border-gray-900" : "bg-white text-gray-600 border-gray-200 hover:border-gray-300 hover:text-gray-900")">
                    All
                </button>
                @foreach (var cat in Categories)
                {
                    <button @onclick="() => FilterByCategory(cat.Id)"
                            class="px-3.5 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap border transition @(SelectedCategoryId == cat.Id ? "bg-gray-900 text-white border-gray-900" : "bg-white text-gray-600 border-gray-200 hover:border-gray-300 hover:text-gray-900")">
                        @cat.Name
                    </button>
                }
            </div>
        }

        <div class="bg-white rounded-xl border border-gray-200">
            <div class="px-6 py-5 border-b border-gray-100">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                    <div>
                        <h3 class="text-base font-semibold text-gray-900">Product List</h3>
                        <p class="text-sm text-gray-500 mt-0.5">Manage your warehouse inventory</p>
                    </div>
                    <div class="relative w-full sm:w-64">
                        <input type="text" value="@SearchQuery" @oninput="OnSearchInput" placeholder="Search products or SKU..." 
                            class="w-full pl-9 pr-4 py-2 text-sm bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-gray-900 focus:border-gray-900 transition placeholder:text-gray-400">
                        <svg class="w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                    </div>
                </div>
            </div>

            <!-- Desktop Table View -->
            <div class="hidden md:block overflow-x-auto">
                <table class="w-full text-left">
                    <thead>
                        <tr class="bg-[#1a1a1a]">
                            <th class="px-6 py-3 text-[0.68rem] font-semibold tracking-wider uppercase text-[#c8c5bc] hover:bg-gray-800 hover:text-white transition">Product</th>
                            <th class="px-6 py-3 text-[0.68rem] font-semibold tracking-wider uppercase text-[#c8c5bc] hover:bg-gray-800 hover:text-white transition">SKU / Barcode</th>
                            <th class="px-6 py-3 text-[0.68rem] font-semibold tracking-wider uppercase text-[#c8c5bc] hover:bg-gray-800 hover:text-white transition">Category</th>
                            <th class="px-6 py-3 text-[0.68rem] font-semibold tracking-wider uppercase text-[#c8c5bc] hover:bg-gray-800 hover:text-white transition">Location</th>
                            <th class="px-6 py-3 text-[0.68rem] font-semibold tracking-wider uppercase text-[#c8c5bc] hover:bg-gray-800 hover:text-white transition">Stock</th>
                            <th class="px-6 py-3 text-[0.68rem] font-semibold tracking-wider uppercase text-[#c8c5bc] hover:bg-gray-800 hover:text-white transition">Points</th>
                            <th class="px-6 py-3 text-[0.68rem] font-semibold tracking-wider uppercase text-[#c8c5bc] hover:bg-gray-800 hover:text-white transition">Status</th>
                            <th class="px-6 py-3 text-[0.68rem] font-semibold tracking-wider uppercase text-[#c8c5bc] hover:bg-gray-800 hover:text-white transition">Updated</th>
                            @if (IsAdmin)
                            {
                                <th class="px-6 py-3 text-[0.68rem] font-semibold tracking-wider uppercase text-[#c8c5bc] w-32"></th>
                            }
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50">
                        @if (Products == null)
                        {
                            <tr>
                                <td colspan="@(IsAdmin ? 9 : 8)" class="px-6 py-16 text-center">
                                    <div class="animate-pulse flex flex-col items-center">
                                        <div class="h-4 bg-gray-200 rounded w-1/4 mb-4"></div>
                                        <div class="h-3 bg-gray-200 rounded w-1/3"></div>
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (!Products.Any())
                        {
                            <tr>
                                <td colspan="@(IsAdmin ? 9 : 8)" class="px-6 py-16 text-center">
                                    <p class="text-sm text-gray-500">No products found.</p>
                                    <p class="text-xs text-gray-400 mt-1">Add a product to get started.</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var product in Products)
                            {
                                <tr class="hover:bg-gray-50/50 transition">
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="flex items-center gap-3">
                                            @if (!string.IsNullOrEmpty(product.image) || !string.IsNullOrEmpty(product.images))
                                            {
                                                List<string> allImages = new List<string>();
                                                if (!string.IsNullOrEmpty(product.images)) {
                                                    try { allImages = System.Text.Json.JsonSerializer.Deserialize<List<string>>(product.images) ?? new List<string>(); } catch {}
                                                }
                                                if (!allImages.Any() && !string.IsNullOrEmpty(product.image)) {
                                                    allImages.Add(product.image);
                                                }
                                                var firstImg = ImageHelper.Resolve(product.image ?? allImages.FirstOrDefault());
                                                <div class="shrink-0 cursor-pointer" @onclick="() => OpenImageModal(firstImg, product.name, allImages)">
                                                    <img src="@firstImg" alt="@product.name" class="w-12 h-12 rounded-lg object-cover border border-gray-100 hover:ring-2 ring-gray-900 transition">
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="w-10 h-10 rounded-lg bg-gray-100 flex items-center justify-center shrink-0">
                                                    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                                                </div>
                                            }
                                            <div>
                                                <div class="text-sm font-medium text-gray-900">@product.name</div>
                                                <div class="text-xs text-gray-400">@(product.Unit?.name ?? "--")</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-3 py-2.5">
                                        @{
                                            var barcodeImg = GetBarcodeImage(product.sku, product.barcode_type);
                                        }
                                        @if (!string.IsNullOrEmpty(barcodeImg))
                                        {
                                            <div class="inline-block bg-white p-1 border border-gray-100 rounded cursor-pointer hover:ring-2 ring-gray-900 transition" @onclick="() => OpenImageModal(barcodeImg, product.sku)">
                                                <img src="@barcodeImg" alt="@product.sku" class="h-8 object-contain" />
                                            </div>
                                            <div class="mt-1 text-[10px] text-gray-500 font-mono text-center max-w-[120px]">@product.sku</div>
                                        }
                                        else
                                        {
                                            <code class="text-xs font-medium text-gray-700 bg-gray-100 px-2 py-1 rounded">@product.sku</code>
                                            <div class="mt-2 text-[10px] text-gray-400">
                                                @product.barcode_type
                                            </div>
                                        }
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        @if (product.Category != null)
                                        {
                                            <span class="text-xs font-medium text-gray-700 bg-gray-100 px-2 py-1 rounded">@product.Category.name</span>
                                        }
                                        else
                                        {
                                            <span class="text-xs text-gray-400">--</span>
                                        }
                                    </td>
                                    <td class="px-3 py-2.5 whitespace-nowrap">
                                        @if (product.Location != null)
                                        {
                                            <div class="text-xs text-gray-900 font-medium">@product.Location.name</div>
                                        }
                                        else
                                        {
                                            <div class="text-xs text-gray-400">--</div>
                                        }
                                        @if (!string.IsNullOrEmpty(product.position_image))
                                        {
                                            <div class="mt-1.5 flex items-center gap-1.5">
                                                <div class="block w-10 h-10 rounded border border-gray-200 overflow-hidden shrink-0 hover:ring-2 ring-gray-900 transition cursor-pointer" @onclick='() => OpenImageModal(ImageHelper.Resolve(product.position_image), "Position View: " + (product.Location?.name ?? ""))'>
                                                    <img src="@ImageHelper.Resolve(product.position_image)" alt="Position" class="w-full h-full object-cover">
                                                </div>
                                                <span class="text-[10px] text-gray-400">Position View</span>
                                            </div>
                                        }
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="text-sm font-semibold @(product.current_stock > 0 ? "text-gray-900" : "text-[#d94040]")">@product.current_stock</div>
                                        @if (product.initial_stock > 0)
                                        {
                                            <div class="text-[11px] text-gray-400 mt-0.5">Init: @product.initial_stock</div>
                                        }
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="inline-flex items-center gap-1 text-[#e8a000] font-semibold text-xs bg-[rgba(232,160,0,0.1)] px-2 py-1 rounded">
                                            @product.value Pts
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        @if (product.current_stock > 0)
                                        {
                                            <span class="inline-flex items-center gap-1.5 text-xs font-medium text-[#1a7a30]">
                                                <span class="w-1.5 h-1.5 rounded-full bg-[#1a7a30]"></span>
                                                In Stock
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1.5 text-xs font-medium text-[#d94040]">
                                                <span class="w-1.5 h-1.5 rounded-full bg-[#d94040]"></span>
                                                Out of Stock
                                            </span>
                                        }
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="text-xs text-gray-500">@product.updated_at.ToString("dd MMM yyyy")</div>
                                        <div class="text-[11px] text-gray-400">@product.updated_at.ToString("HH:mm")</div>
                                    </td>
                                    @if (IsAdmin)
                                    {
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            <div class="flex flex-wrap items-center justify-end gap-2">
                                                <a href="/editproduct/@product.id" class="inline-flex justify-center w-16 text-xs font-bold text-[#3a3835] hover:text-[#1a1a1a] px-3 py-1.5 rounded bg-white border border-[#e5e3dc] hover:bg-[#f0ede5] transition cursor-pointer">
                                                    Edit
                                                </a>
                                                <button @onclick="() => DeleteProduct(product.id)" class="inline-flex justify-center w-16 text-xs font-bold text-[#d94040] hover:text-[#b83535] px-3 py-1.5 rounded bg-[#fef0f0] border border-[#f8c0c0] hover:bg-[#fee2e2] transition cursor-pointer">
                                                    Delete
                                                </button>
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mobile List View -->
            <div class="block md:hidden divide-y divide-gray-100">
                @if (Products == null)
                {
                    <div class="p-6 text-center text-gray-500">
                        <div class="animate-spin rounded-full h-6 w-6 border-b-2 border-gray-950 mx-auto mb-2"></div>
                        Loading products...
                    </div>
                }
                else if (!Products.Any())
                {
                    <div class="p-8 text-center text-gray-500">
                        <p class="text-sm font-semibold">No products found.</p>
                        <p class="text-xs text-gray-400 mt-1">Add a product to get started.</p>
                    </div>
                }
                else
                {
                    @foreach (var product in Products)
                    {
                        <div class="p-4 flex flex-col gap-3 hover:bg-gray-50/50 transition">
                            <div class="flex items-start justify-between gap-3">
                                <div class="flex items-center gap-3 min-w-0">
                                    @if (!string.IsNullOrEmpty(product.image) || !string.IsNullOrEmpty(product.images))
                                    {
                                        List<string> allImages = new List<string>();
                                        if (!string.IsNullOrEmpty(product.images)) {
                                            try { allImages = System.Text.Json.JsonSerializer.Deserialize<List<string>>(product.images) ?? new List<string>(); } catch {}
                                        }
                                        if (!allImages.Any() && !string.IsNullOrEmpty(product.image)) {
                                            allImages.Add(product.image);
                                        }
                                        var firstImg = ImageHelper.Resolve(product.image ?? allImages.FirstOrDefault());
                                        <div class="shrink-0 cursor-pointer" @onclick="() => OpenImageModal(firstImg, product.name, allImages)">
                                            <img src="@firstImg" alt="@product.name" class="w-12 h-12 rounded-lg object-cover border border-gray-100 hover:ring-2 ring-gray-900 transition">
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="w-12 h-12 rounded-lg bg-gray-100 flex items-center justify-center shrink-0">
                                            <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                                        </div>
                                    }
                                    <div class="min-w-0 text-left">
                                        <h4 class="text-sm font-bold text-gray-900 truncate">@product.name</h4>
                                        <span class="text-[11px] text-gray-500">Unit: @(product.Unit?.name ?? "--")</span>
                                    </div>
                                </div>
                                <div class="text-right shrink-0">
                                    <span class="inline-flex items-center gap-1 text-[#e8a000] font-bold text-xs bg-[rgba(232,160,0,0.1)] px-2.5 py-0.5 rounded-full border border-[rgba(232,160,0,0.2)]">
                                        @product.value Pts
                                    </span>
                                </div>
                            </div>

                            <div class="grid grid-cols-2 gap-x-4 gap-y-2 text-xs border-t border-b border-gray-100/70 py-2.5 bg-gray-50/50 px-3 rounded-lg text-left">
                                <div>
                                    <span class="text-[10px] text-gray-400 font-semibold uppercase tracking-wider block mb-0.5">SKU / Barcode</span>
                                    @{
                                        var barcodeImgMob = GetBarcodeImage(product.sku, product.barcode_type);
                                    }
                                    @if (!string.IsNullOrEmpty(barcodeImgMob))
                                    {
                                        <div class="inline-block bg-white p-1 border border-gray-100 rounded cursor-pointer hover:ring-2 ring-gray-900 transition" @onclick="() => OpenImageModal(barcodeImgMob, product.sku)">
                                            <img src="@barcodeImgMob" alt="@product.sku" class="h-6 object-contain" />
                                        </div>
                                        <div class="mt-0.5 text-[9px] text-gray-500 font-mono">@product.sku</div>
                                    }
                                    else
                                    {
                                        <code class="text-xs font-bold text-gray-700 bg-gray-200/60 px-1.5 py-0.5 rounded">@product.sku</code>
                                    }
                                </div>
                                <div>
                                    <span class="text-[10px] text-gray-400 font-semibold uppercase tracking-wider block mb-0.5">Category</span>
                                    <span class="font-bold text-gray-700 bg-gray-200/60 px-1.5 py-0.5 rounded">@(product.Category?.name ?? "--")</span>
                                </div>
                                <div>
                                    <span class="text-[10px] text-gray-400 font-semibold uppercase tracking-wider block mb-0.5">Location</span>
                                    <span class="font-bold text-gray-700">@(product.Location?.name ?? "--")</span>
                                </div>
                                <div>
                                    <span class="text-[10px] text-gray-400 font-semibold uppercase tracking-wider block mb-0.5">Stock</span>
                                    <span class="font-bold @(product.current_stock > 0 ? "text-[#1a7a30]" : "text-[#d94040]")">@product.current_stock</span>
                                    @if (product.initial_stock > 0)
                                    {
                                        <span class="text-gray-400 text-[10px] ml-1">(Init: @product.initial_stock)</span>
                                    }
                                </div>
                            </div>

                            <div class="flex items-center justify-between gap-3 text-xs mt-1">
                                <div class="text-left">
                                    @if (product.current_stock > 0)
                                    {
                                        <span class="inline-flex items-center gap-1.5 text-xs font-bold text-[#1a7a30]">
                                            <span class="w-1.5 h-1.5 rounded-full bg-[#1a7a30]"></span>
                                            In Stock
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 text-xs font-bold text-[#d94040]">
                                            <span class="w-1.5 h-1.5 rounded-full bg-[#d94040]"></span>
                                            Out of Stock
                                        </span>
                                    }
                                </div>
                                <div class="flex items-center gap-2">
                                    @if (IsAdmin)
                                    {
                                        <a href="/editproduct/@product.id" class="text-xs font-bold text-gray-600 hover:text-gray-900 px-3 py-1.5 rounded-lg bg-white border border-gray-200 hover:bg-gray-100 transition shadow-sm">
                                            Edit
                                        </a>
                                        <button @onclick="() => DeleteProduct(product.id)" class="text-xs font-bold text-red-600 hover:text-red-700 px-3 py-1.5 rounded-lg bg-[#fef0f0] border border-[#f8c0c0] hover:bg-[#fee2e2] transition shadow-sm">
                                            Delete
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
            
            @if (TotalPages > 1)
            {
                <div class="px-6 py-4 border-t border-gray-100 flex items-center justify-between">
                    <span class="text-sm text-gray-500">Showing page @CurrentPage of @TotalPages</span>
                    <div class="flex gap-2">
                        <button disabled="@(CurrentPage == 1)" @onclick="() => LoadProducts(CurrentPage - 1)" class="px-3 py-1 border rounded hover:bg-gray-50 disabled:opacity-50">Previous</button>
                        <button disabled="@(CurrentPage == TotalPages)" @onclick="() => LoadProducts(CurrentPage + 1)" class="px-3 py-1 border rounded hover:bg-gray-50 disabled:opacity-50">Next</button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@if (ShowImageModal)
{
    <div class="fixed inset-0 z-[300] flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm transition-opacity duration-300" @onclick="CloseImageModal">
        <div class="relative w-full max-w-4xl max-h-[90vh] bg-white rounded-xl shadow-2xl p-2 flex flex-col" @onclick:stopPropagation>
            <div class="flex justify-between items-center px-4 py-2 border-b border-gray-100 mb-2 shrink-0">
                <h3 class="font-bold text-gray-900 truncate pr-4">@ModalImageTitle</h3>
                <button @onclick="CloseImageModal" class="text-gray-500 hover:text-gray-900 transition bg-gray-100 hover:bg-gray-200 rounded-lg p-1.5 shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
            <div class="flex-1 overflow-auto flex flex-col items-center justify-center p-4 bg-gray-50/50 rounded-b-lg min-h-[300px]">
                <img src="@ModalImageUrl" alt="@ModalImageTitle" class="max-w-full max-h-[70vh] object-contain rounded-lg shadow-sm transition-all">
                @if (ModalAdditionalImages.Count > 1)
                {
                    <div class="mt-4 flex gap-2 overflow-x-auto max-w-full pb-2 px-2">
                        @foreach (var img in ModalAdditionalImages)
                        {
                            var resolvedImg = img.StartsWith("data:") ? img : ImageHelper.Resolve(img);
                            <div class="w-16 h-16 shrink-0 cursor-pointer rounded-lg border-2 overflow-hidden transition-all @(ModalImageUrl == resolvedImg ? "border-[#e8a000] opacity-100" : "border-transparent opacity-60 hover:opacity-100")"
                                 @onclick="() => ModalImageUrl = resolvedImg">
                                <img src="@resolvedImg" class="w-full h-full object-cover" />
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private List<Product>? Products;
    private List<CategoryDto>? Categories;
    
    private int CurrentPage = 1;
    private int PageSize = 10;
    private int TotalPages = 1;
    private int TotalItems = 0;
    
    private int? SelectedCategoryId;
    private string? SearchQuery;
    private string? SuccessMessage;
    private string? ErrorMessage;
    private bool IsAdmin = false;

    private bool ShowImageModal = false;
    private string? ModalImageUrl;
    private string? ModalImageTitle;

    private List<string> ModalAdditionalImages = new();

    private void OpenImageModal(string imageUrl, string title, List<string>? additionalImages = null)
    {
        ModalImageUrl = imageUrl;
        ModalImageTitle = title;
        ModalAdditionalImages = additionalImages ?? new List<string>();
        if (!ModalAdditionalImages.Contains(imageUrl) && !string.IsNullOrEmpty(imageUrl) && !imageUrl.StartsWith("data:"))
        {
            // Note: We avoid inserting data: URIs to the additional list to prevent huge base64 strings in loop, 
            // but if it's a normal URL we ensure the main image is in the carousel.
            ModalAdditionalImages.Insert(0, imageUrl);
        }
        ShowImageModal = true;
    }

    private void CloseImageModal()
    {
        ShowImageModal = false;
        ModalImageUrl = null;
        ModalImageTitle = null;
        ModalAdditionalImages.Clear();
    }

    private string GetBarcodeImage(string? sku, string? type)
    {
        if (string.IsNullOrEmpty(sku)) return string.Empty;
        try
        {
            var barcodeType = NetBarcode.Type.Code128;
            if (type == "TYPE_CODE_39") barcodeType = NetBarcode.Type.Code39;
            else if (type == "TYPE_EAN_13") barcodeType = NetBarcode.Type.EAN13;
            
            var barcode = new NetBarcode.Barcode(sku, barcodeType);
            return $"data:image/png;base64,{barcode.GetBase64Image()}";
        }
        catch
        {
            try 
            {
                var barcode = new NetBarcode.Barcode(sku, NetBarcode.Type.Code128);
                return $"data:image/png;base64,{barcode.GetBase64Image()}";
            } 
            catch 
            {
                return string.Empty;
            }
        }
    }

    [Parameter]
    [SupplyParameterFromQuery(Name = "success")]
    public string? SuccessParam { get; set; }

    private System.Timers.Timer? _searchTimer;

    protected override async Task OnInitializedAsync()
    {
        _searchTimer = new System.Timers.Timer(400);
        _searchTimer.Elapsed += async (s, e) =>
        {
            await InvokeAsync(async () =>
            {
                await LoadProducts(1);
                StateHasChanged();
            });
        };
        _searchTimer.AutoReset = false;

        if (SuccessParam == "created")
        {
            SuccessMessage = "Product added successfully.";
            ClearSuccessMessageAfterDelay();
        }
        else if (SuccessParam == "updated")
        {
            SuccessMessage = "Product updated successfully.";
            ClearSuccessMessageAfterDelay();
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userRole = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
        IsAdmin = userRole == "admin" || userRole == "superadmin";

        var catResult = await CategoryService.GetCategoriesAsync(1, 100);
        Categories = catResult.Categories;
        await LoadProducts(1);
    }

    private bool _isFetching = false;
    private bool _needsFetch = false;

    private async Task LoadProducts(int page)
    {
        CurrentPage = page;
        _needsFetch = true;
        
        if (_isFetching) return;
        _isFetching = true;

        try
        {
            while (_needsFetch)
            {
                _needsFetch = false;
                var result = await ProductService.GetProductsAsync(SelectedCategoryId, SearchQuery, CurrentPage, PageSize);
                Products = result.Products;
                TotalItems = result.TotalItems;
                TotalPages = result.TotalPages;
            }
        }
        finally
        {
            _isFetching = false;
        }
    }

    private async Task FilterByCategory(int? categoryId)
    {
        SelectedCategoryId = categoryId;
        await LoadProducts(1);
    }

    private void ClearSuccessMessageAfterDelay()
    {
        _ = Task.Delay(4000).ContinueWith(_ =>
        {
            SuccessMessage = null;
            InvokeAsync(StateHasChanged);
        });
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        SearchQuery = e.Value?.ToString() ?? "";
        _searchTimer?.Stop();
        _searchTimer?.Start();
    }

    public void Dispose()
    {
        _searchTimer?.Dispose();
    }

    private async Task DeleteProduct(int id)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Apakah Anda yakin ingin menghapus produk ini?");
        if (confirmed)
        {
            ErrorMessage = null;
            SuccessMessage = null;
            var success = await ProductService.DeleteProductAsync(id);
            if (success)
            {
                SuccessMessage = "Product deleted successfully.";
                await LoadProducts(CurrentPage);
                _ = Task.Delay(3000).ContinueWith(_ =>
                {
                    SuccessMessage = null;
                    InvokeAsync(StateHasChanged);
                });
            }
            else
            {
                ErrorMessage = "Gagal menghapus produk.";
            }
        }
    }
}
