@page "/MasterData/RoleAdmin/{Id:guid}"
@using UT_WMSDotnet.ViewModels
@using WMS_UnitedTracors_Blazor.Services
@inject AdminRoleService AdminRoleService
@inject NavigationManager Navigation
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>WMS - Role Admin Details</PageTitle>

<div class="py-8 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        @* Back Link / Breadcrumbs *@
        <div class="mb-4">
            <button type="button" @onclick="GoBack" class="inline-flex items-center gap-1 text-xs font-bold text-gray-500 hover:text-gray-800 transition bg-transparent border-none cursor-pointer">
                <svg class="w-4 h-4 stroke-current fill-none stroke-[2]" viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                Back to Role List
            </button>
        </div>

        @if (Role == null)
        {
            <div class="bg-white rounded-xl border border-[#e5e3dc] p-12 text-center shadow-sm">
                @if (IsLoading)
                {
                    <p class="text-gray-500 text-sm">Loading role details...</p>
                }
                else
                {
                    <h3 class="text-lg font-bold text-[#d94040]">Role Not Found</h3>
                    <p class="text-xs text-gray-500 mt-2">The requested Role Admin ID does not exist or has been deleted.</p>
                }
            </div>
        }
        else
        {
            <div class="space-y-6">
                
                @* Top Section: Role Configuration Info *@
                <div class="bg-white rounded-xl border border-[#e5e3dc] shadow-sm overflow-hidden flex flex-col">
                    <div class="px-6 py-4 border-b border-[#f0ede5] bg-[#faf9f5]">
                        <h3 class="text-sm font-bold text-[#1a1a1a] font-syne">Role Configuration</h3>
                        <p class="text-[0.72rem] text-[#8a8880] mt-0.5">Specifications of this role configuration.</p>
                    </div>
                    <div class="p-6 space-y-4 text-xs">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <span class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-0.5">Role Name</span>
                                <span class="font-bold text-sm text-gray-900">@Role.RoleName</span>
                            </div>
                            <div>
                                <span class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-0.5">Description</span>
                                <p class="text-gray-700 leading-relaxed">@(Role.Description ?? "No description provided.")</p>
                            </div>
                        </div>

                        <div class="flex justify-between items-center py-2 border-y border-[#f0ede5]">
                            <div>
                                <span class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-0.5">Status</span>
                                @if (Role.IsActive)
                                {
                                    <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full font-bold bg-[#eef9f0] border border-[#b8e8c0] text-[#1a7a30] text-[10px]">
                                        <span class="w-1.5 h-1.5 rounded-full bg-[#1a7a30]"></span> Active
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full font-bold bg-[#fef0f0] border border-[#f8c0c0] text-[#d94040] text-[10px]">
                                        <span class="w-1.5 h-1.5 rounded-full bg-[#d94040]"></span> Inactive
                                    </span>
                                }
                            </div>
                            <div class="text-right">
                                <span class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-0.5">Total Users</span>
                                <span class="font-bold text-gray-900 text-sm">@Role.TotalUser</span>
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <span class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880]">Created Date</span>
                                <span class="text-gray-600 font-medium">@Role.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span>
                                <span class="block text-[10px] text-gray-400">by @(Role.CreatedBy ?? "System")</span>
                            </div>
                            <div>
                                <span class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880]">Updated Date</span>
                                <span class="text-gray-600 font-medium">@Role.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span>
                                <span class="block text-[10px] text-gray-400">by @(Role.UpdatedBy ?? "System")</span>
                            </div>
                        </div>
                    </div>
                </div>

                @* Permissions Card (Full Width) *@
                <div class="bg-white rounded-xl border border-[#e5e3dc] shadow-sm overflow-hidden">
                    <div class="px-6 py-4 border-b border-[#f0ede5] bg-[#faf9f5] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
                        <div>
                            <h3 class="text-sm font-bold text-[#1a1a1a] font-syne">Permissions Matrix (Role-Based Access)</h3>
                            <p class="text-[0.72rem] text-[#8a8880] mt-0.5">Atur hak akses untuk role ini. Perubahan izin di sini akan langsung berlaku secara masal untuk semua user dengan role <strong>@Role.RoleName</strong>.</p>
                        </div>
                        <div class="flex items-center gap-2 shrink-0">
                            <button type="button" @onclick="SelectAllPermissions" class="px-3 py-1.5 bg-[#f5f4f0] hover:bg-[#eae8e0] text-[#1a1a1a] text-xs font-semibold rounded-lg border border-[#e5e3dc] transition cursor-pointer">
                                Select All
                            </button>
                            <button type="button" @onclick="DeselectAllPermissions" class="px-3 py-1.5 bg-[#f5f4f0] hover:bg-[#eae8e0] text-[#1a1a1a] text-xs font-semibold rounded-lg border border-[#e5e3dc] transition cursor-pointer">
                                Clear All
                            </button>
                            <button type="button" @onclick="SavePermissions" class="px-4 py-2 bg-[#e8a000] hover:bg-[#d49300] text-[#1a1a1a] text-xs font-bold rounded-lg transition active:scale-95 cursor-pointer shrink-0 shadow-sm">
                                Save Permissions
                            </button>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(PermSavedMessage))
                    {
                        <div class="mx-6 mt-4 flex items-center gap-2 bg-[#eef9f0] border border-[#b8e8c0] text-[#1a7a30] px-4 py-2.5 rounded-lg text-xs font-semibold">
                            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                            @PermSavedMessage
                        </div>
                    }
                    <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-8">
                        @foreach (var group in WMS_UnitedTracors_Blazor.Helpers.Permissions.Catalog.GroupBy(d => d.Group))
                        {
                            var groupName = group.Key;
                            <div class="bg-[#faf9f5] p-4 rounded-xl border border-[#f0ede5]">
                                <div class="flex justify-between items-center mb-3 pb-2 border-b border-[#e5e3dc]">
                                    <h4 class="text-[0.68rem] font-bold uppercase tracking-wider text-[#1a1a1a]">@groupName</h4>
                                    <div class="flex items-center gap-2 text-[10px]">
                                        <button type="button" @onclick="() => ToggleGroup(groupName, true)" class="text-[#e8a000] hover:underline font-bold">Select Group</button>
                                        <span class="text-gray-300">|</span>
                                        <button type="button" @onclick="() => ToggleGroup(groupName, false)" class="text-gray-500 hover:underline font-medium">Clear</button>
                                    </div>
                                </div>
                                <div class="space-y-2.5">
                                    @foreach (var def in group.OrderBy(d => d.Order))
                                    {
                                        <label class="flex items-center gap-2.5 cursor-pointer text-xs text-gray-700 hover:text-gray-900 select-none">
                                            <input type="checkbox" checked="@SelectedPermissions.Contains(def.Key)" @onchange="@(e => TogglePerm(def.Key, e.Value))" class="rounded border-gray-300 text-[#e8a000] focus:ring-[#e8a000]" />
                                            <span>@def.Label</span>
                                        </label>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
                
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private AdminRoleDto? Role;
    private HashSet<string> SelectedPermissions = new();
    private string? PermSavedMessage;

    private bool IsLoading = true;
    private string CurrentUsername = "System";

    private void TogglePerm(string key, object? value)
    {
        PermSavedMessage = null;
        if (value is bool b && b) SelectedPermissions.Add(key);
        else SelectedPermissions.Remove(key);
    }

    private void SelectAllPermissions()
    {
        PermSavedMessage = null;
        foreach (var def in WMS_UnitedTracors_Blazor.Helpers.Permissions.Catalog)
        {
            SelectedPermissions.Add(def.Key);
        }
    }

    private void DeselectAllPermissions()
    {
        PermSavedMessage = null;
        SelectedPermissions.Clear();
    }

    private void ToggleGroup(string groupName, bool select)
    {
        PermSavedMessage = null;
        var groupItems = WMS_UnitedTracors_Blazor.Helpers.Permissions.Catalog.Where(d => d.Group == groupName);
        foreach (var item in groupItems)
        {
            if (select) SelectedPermissions.Add(item.Key);
            else SelectedPermissions.Remove(item.Key);
        }
    }

    private async Task SavePermissions()
    {
        var err = await AdminRoleService.UpdateRolePermissionsAsync(Id, SelectedPermissions.ToList(), CurrentUsername);
        PermSavedMessage = err ?? "Permissions berhasil disimpan. User perlu login ulang agar perubahan berlaku.";
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (!user.HasPermission(WMS_UnitedTracors_Blazor.Helpers.Permissions.RolesManage))
        {
            Navigation.NavigateTo("/");
            return;
        }

        CurrentUsername = user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "System";
        await LoadRoleData();
    }

    private async Task LoadRoleData()
    {
        IsLoading = true;
        Role = await AdminRoleService.GetAdminRoleByIdAsync(Id);
        
        if (Role != null)
        {
            SelectedPermissions = new HashSet<string>(await AdminRoleService.GetRolePermissionsAsync(Id));
        }
        IsLoading = false;
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/MasterData/RoleAdmin");
    }
}
