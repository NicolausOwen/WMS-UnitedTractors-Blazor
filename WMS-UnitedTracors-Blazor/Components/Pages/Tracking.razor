    private async Task HandleDocumentationFileSelected(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        ModalError = null;
        var files = e.GetMultipleFiles(5).ToList();
        DocumentationFiles = new();
        
        var tasks = new List<Task>();
        foreach (var file in files)
        {
            var err = ValidateUpload(file);
            if (err != null)
            {
                ModalError = err;
                DocumentationFiles = new();
                return;
            }
            
            tasks.Add(Task.Run(async () => {
                try
                {
                    using var ms = new System.IO.MemoryStream();
                    await file.OpenReadStream(TransactionService.MaxUploadBytes).CopyToAsync(ms);
                    var memFile = new WMS_UnitedTracors_Blazor.Helpers.MemoryBrowserFile(file.Name, file.ContentType, ms.ToArray());
                    lock (DocumentationFiles)
                    {
                        DocumentationFiles.Add(memFile);
                    }
                }
                catch { }
            }));
        }
        
        await Task.WhenAll(tasks);
    }

