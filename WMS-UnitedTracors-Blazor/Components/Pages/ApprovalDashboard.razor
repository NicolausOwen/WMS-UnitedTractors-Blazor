@if (ShowApprovalHandoverModal)
{
    <div class="fixed inset-0 z-[200] flex items-end justify-center sm:items-center p-0 sm:p-4 bg-black/50 backdrop-blur-sm animate-fadeIn" @onclick="CloseApprovalHandoverModal">
        <div class="bg-white rounded-t-3xl sm:rounded-2xl w-full sm:max-w-2xl shadow-2xl overflow-hidden border border-[#e5e3dc] flex flex-col max-h-[85vh] sm:max-h-[90vh] pb-[calc(20px+env(safe-area-inset-bottom))] sm:pb-0" @onclick:stopPropagation="true">
            <!-- Drag handle (Mobile) -->
