@code {
    // Reusable konfirmasi "apakah yakin" untuk aksi submit final.
    private bool ShowConfirm = false;
    private string ConfirmTitle = "";
    private string ConfirmMessage = "";
    private string ConfirmButtonText = "Ya, Lanjutkan";
    private Func<Task>? ConfirmCallback;

    // Dispute Modal State
    private bool ShowDisputeModal = false;
    private List<Transaction> DisputeTargetItems = new();
    private string DisputeReasonText = "";
    private string? DisputeModalError = null;

    private void OpenDisputeModal(List<Transaction> items)
    {
        DisputeTargetItems = items;
        DisputeReasonText = "";
        DisputeModalError = null;
        ShowDisputeModal = true;
    }

    private void CloseDisputeModal()
    {
        ShowDisputeModal = false;
        DisputeTargetItems = new();
        DisputeReasonText = "";
        DisputeModalError = null;
    }

    private async Task SubmitDispute()
    {
        if (string.IsNullOrWhiteSpace(DisputeReasonText))
        {
            DisputeModalError = "Alasan wajib diisi.";
            return;
        }

        if (IsSubmitting) return;
        var groupId = DisputeTargetItems.FirstOrDefault(i => i.status == "WAITING_HANDOVER_CONFIRM" || i.status == "APPROVED")?.group_id;
        if (string.IsNullOrEmpty(groupId)) return;

        IsSubmitting = true;
        DisputeModalError = null;
        try
        {
            var err = await TransactionService.ConfirmHandoverReceiptByUserAsync(groupId, CurrentUserId, false, DisputeReasonText);
            if (err == null)
            {
                SuccessMessage = "Keberatan berhasil dilaporkan. Transaksi dikembalikan ke Staff Inventoris.";
                CloseDisputeModal();
                await LoadData();
            }
            else
            {
                DisputeModalError = err;
            }
        }
        catch (Exception ex)
        {
            DisputeModalError = "Terjadi kesalahan saat mengirim laporan: " + ex.Message;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private void AskConfirm(string title, string message, Func<Task> callback, string buttonText = "Ya, Lanjutkan")
    {
        ConfirmTitle = title;
        ConfirmMessage = message;
        ConfirmButtonText = buttonText;
        ConfirmCallback = callback;
        ShowConfirm = true;
    }

    private void CancelConfirm()
    {
        ShowConfirm = false;
        ConfirmCallback = null;
    }

    private async Task RunConfirm()
    {
        var cb = ConfirmCallback;
        ShowConfirm = false;
        ConfirmCallback = null;
        if (cb != null) await cb();
    }

    private List<Division> Divisions = new();
    private Dictionary<string, List<Transaction>> GroupedUsages = new();
    private HashSet<string> ExpandedGroupIds = new();
    private HashSet<string> ShowAllProductsGroupIds = new();
    private string ActiveTrackingTab = "borrow";

    private string? ProductSearch;
    private int? DivisionId;
    private string? ReturnStatus;
    private DateTime? DateFrom;
    private DateTime? DateTo;
    private bool ShowDateFilter = false;
    
    private string? ErrorMessage;
    private string? SuccessMessage;
    
    private int CurrentUserId;
    private string? UserRole; private System.Security.Claims.ClaimsPrincipal userPrincipal = new System.Security.Claims.ClaimsPrincipal();
    private bool IsStaffOrUser => string.Equals(UserRole, "staff", StringComparison.OrdinalIgnoreCase) || string.Equals(UserRole, "user", StringComparison.OrdinalIgnoreCase);

    private bool IsReturnModalOpen = false;
    private bool IsForceReturn = false;
    private bool IsHandoverModalOpen = false;
    private bool IsDocumentationModalOpen = false;
    private List<int> HandoverTransactionIds = new();
    private string? HandoverNotes;
    private string HandoverRequestType = "BORROW";
    private string? HandoverRecipientName;
    private DateTime? HandoverTimestampInput;
    private Microsoft.AspNetCore.Components.Forms.IBrowserFile? HandoverFile;
    private List<int> DocumentationTransactionIds = new();
    private string? DocumentationNotes;
    private List<Microsoft.AspNetCore.Components.Forms.IBrowserFile> DocumentationFiles = new();

    private bool IsSubmitting = false;
    private Transaction? ReturnTransaction;
    private UT_WMSDotnet.ViewModels.ReturnItemViewModel ReturnModel = new();
    private Microsoft.AspNetCore.Components.Forms.IBrowserFile? SelectedFile;

    // Upload validation (shared by Return & Handover modals)
    private const long MaxUploadBytes = 4 * 1024 * 1024; // 4 MB
    private static readonly string[] AllowedUploadTypes = new[]
    {
        "image/jpg", "image/jpeg", "image/png", "image/webp", "application/pdf"
    };
    private string? ModalError;

    private string? ValidateUpload(Microsoft.AspNetCore.Components.Forms.IBrowserFile file)
    {
        if (!AllowedUploadTypes.Contains(file.ContentType))
            return "Format file tidak didukung. Gunakan JPG, PNG, WEBP, atau PDF.";
        if (file.Size > MaxUploadBytes)
            return $"Ukuran file terlalu besar ({file.Size / 1024.0 / 1024.0:0.#} MB). Maksimal 4 MB.";
        return null;
    }

    private int BorrowGroupCount => GroupedUsages.Count(g => g.Value.FirstOrDefault()?.request_type == "BORROW");
    private int GiveawayGroupCount => GroupedUsages.Count(g => g.Value.FirstOrDefault()?.request_type == "GIVEAWAY");

    private IEnumerable<KeyValuePair<string, List<Transaction>>> GetVisibleTrackingGroups()
    {
        return GroupedUsages.Where(g =>
            string.Equals(g.Value.FirstOrDefault()?.request_type, ActiveTrackingTab == "borrow" ? "BORROW" : "GIVEAWAY", StringComparison.OrdinalIgnoreCase));
    }

    private void SetActiveTrackingTab(string tab)
    {
        ActiveTrackingTab = tab == "giveaway" ? "giveaway" : "borrow";
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            var idClaim = user.FindFirst(ClaimTypes.NameIdentifier);
            if (idClaim != null && int.TryParse(idClaim.Value, out int id))
            {
                CurrentUserId = id;
            }
            UserRole = user.FindFirst(ClaimTypes.Role)?.Value; userPrincipal = user;

            if (string.Equals(UserRole, "manager", StringComparison.OrdinalIgnoreCase))
            {
                ActiveTrackingTab = "giveaway";
            }
        }

        Divisions = await DivisionService.GetAllDivisionsAsync();
        
        DashboardState.OnDashboardUpdated += DashboardUpdated;
        
        await LoadData();
    }

    private async void DashboardUpdated()
    {
        await InvokeAsync(async () =>
        {
            await LoadData();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        DashboardState.OnDashboardUpdated -= DashboardUpdated;
    }

    private async Task LoadData()
    {
        var allUsages = await TrackingService.GetTrackingDataAsync(
            DivisionId, ProductSearch, ReturnStatus, DateFrom, DateTo, CurrentUserId, UserRole);

        // Client side grouping logic similar to laravel
        var tempGrouped = new Dictionary<string, List<Transaction>>();
        foreach (var item in allUsages)
        {
            var key = TrackingService.CreateTrackingGroupId(item);
            if (!tempGrouped.ContainsKey(key))
            {
                tempGrouped[key] = new List<Transaction>();
            }
            tempGrouped[key].Add(item);
        }

        var finalGrouped = new Dictionary<string, List<Transaction>>();
        
        foreach (var kvp in tempGrouped)
        {
            var groupItems = kvp.Value;
            var firstItem = groupItems.First();
            
            // Skip fully returned borrow events
            if (firstItem.request_type == "BORROW" && firstItem.status == "APPROVED")
            {
                var totalQty = groupItems.Sum(x => x.quantity);
                var totalRet = groupItems.Sum(x => x.returned_quantity);
                if (totalRet >= totalQty) continue;
            }

            bool matchesCriteria = true;

            if (!string.IsNullOrEmpty(ProductSearch))
            {
                var s = ProductSearch.ToLower();
                matchesCriteria = groupItems.Any(i => 
                    (i.Product?.name?.ToLower().Contains(s) ?? false) || 
                    (i.Product?.sku?.ToLower().Contains(s) ?? false));
            }

            if (matchesCriteria && !string.IsNullOrEmpty(ReturnStatus) && groupItems.Any(i => i.request_type == "BORROW"))
            {
                if (ReturnStatus == "pending")
                {
                    matchesCriteria = groupItems.Any(i => i.request_type == "BORROW" && i.returned_quantity < i.quantity);
                }
                else if (ReturnStatus == "returned")
                {
                    matchesCriteria = groupItems.Any(i => i.request_type == "BORROW" && i.returned_quantity >= i.quantity);
                }
            }

            if (matchesCriteria)
            {
                finalGrouped[kvp.Key] = groupItems;
            }
        }

        GroupedUsages = finalGrouped;

        // Default state: semua grup collapse, biarkan user expand manual.
        ExpandedGroupIds.Clear();
        ShowAllProductsGroupIds.Clear();
    }

    private async Task ToggleGroup(string groupId)
    {
        if (ExpandedGroupIds.Contains(groupId))
        {
            ExpandedGroupIds.Remove(groupId);
        }
        else
        {
            ExpandedGroupIds.Add(groupId);
            await JSRuntime.InvokeVoidAsync("scrollActiveStepIntoView");
        }
    }

    private void ToggleShowAllProducts(string groupId)
    {
        if (ShowAllProductsGroupIds.Contains(groupId))
        {
            ShowAllProductsGroupIds.Remove(groupId);
        }
        else
        {
            ShowAllProductsGroupIds.Add(groupId);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
