@page "/User"
@using UT_WMSDotnet.Models
@using UT_WMSDotnet.ViewModels
@using WMS_UnitedTracors_Blazor.Services
@inject UserService UserService
@inject DivisionService DivisionService
@inject CategoryService CategoryService
@inject AdminRoleService AdminRoleService
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>WMS - Manage Users</PageTitle>

<WMS_UnitedTracors_Blazor.Components.Shared.LoadingOverlay IsVisible="IsSubmitting" Message="@LoadingMessage" SubMessage="Mohon tunggu sebentar..." />

<div class="py-8 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="flex justify-between items-center mb-6">
            <div>
                <h2 class="font-semibold text-xl text-gray-800 leading-tight font-syne">
                    Manage Users
                </h2>
                <p class="text-xs text-gray-500 mt-0.5">Kelola akun pengguna, divisi, role, dan akses kategori.</p>
            </div>
            @if (IsSuperAdmin)
            {
                <button type="button" @onclick="NavigateToCreate" class="px-4 py-2 bg-[#e8a000] hover:bg-[#d49300] text-[#1a1a1a] text-xs font-bold rounded-lg transition active:scale-95 cursor-pointer flex items-center gap-1.5 shadow-sm">
                    <svg class="w-4 h-4 stroke-current fill-none stroke-[2]" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Add User
                </button>
            }
        </div>

        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="mb-6 flex items-center gap-3 bg-[#eef9f0] border border-[#b8e8c0] text-[#1a7a30] px-4 py-3 rounded-lg text-sm" role="alert">
                <svg class="w-4 h-4 shrink-0 text-[#1a7a30]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                @SuccessMessage
            </div>
        }
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="mb-6 flex items-center gap-3 bg-[#fef0f0] border border-[#f8c0c0] text-[#d94040] px-4 py-3 rounded-lg text-sm" role="alert">
                <svg class="w-4 h-4 shrink-0 text-[#d94040]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                @ErrorMessage
            </div>
        }

        <div class="bg-transparent md:bg-white md:rounded-xl md:border md:border-[#e5e3dc] md:overflow-hidden md:shadow-sm">
            <div class="px-5 py-3.5 border-b border-[#f0ede5] bg-[#faf9f5] flex flex-col sm:flex-row sm:justify-between sm:items-center gap-2 rounded-t-xl">
                <div>
                    <h3 class="text-sm font-bold text-[#1a1a1a] font-syne">User Directory</h3>
                    <p class="text-[0.72rem] text-[#8a8880] mt-0.5">List of registered user accounts in WMS.</p>
                </div>
            </div>

            <!-- Desktop Table View -->
            <div class="hidden md:block">
                <table class="w-full text-left border-collapse table-auto">
                    <thead>
                        <tr class="bg-[#1a1a1a]">
                            <th class="px-3.5 py-3 text-[0.68rem] font-bold tracking-wider uppercase text-[#c8c5bc] w-10 text-center">#</th>
                            <th class="px-3.5 py-3 text-[0.68rem] font-bold tracking-wider uppercase text-[#c8c5bc]">Name</th>
                            <th class="px-3.5 py-3 text-[0.68rem] font-bold tracking-wider uppercase text-[#c8c5bc]">NRP</th>
                            <th class="px-3.5 py-3 text-[0.68rem] font-bold tracking-wider uppercase text-[#c8c5bc]">Email</th>
                            <th class="px-3.5 py-3 text-[0.68rem] font-bold tracking-wider uppercase text-[#c8c5bc] text-center w-16">Poin</th>
                            <th class="px-3.5 py-3 text-[0.68rem] font-bold tracking-wider uppercase text-[#c8c5bc]">Division</th>
                            <th class="px-3.5 py-3 text-[0.68rem] font-bold tracking-wider uppercase text-[#c8c5bc]">Role</th>
                            <th class="px-3.5 py-3 text-[0.68rem] font-bold tracking-wider uppercase text-[#c8c5bc]">Category Scope</th>
                            <th class="px-3.5 py-3 text-[0.68rem] font-bold tracking-wider uppercase text-[#c8c5bc] text-right w-28">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[#f0ede5]">
                        @if (UsersList == null || !UsersList.Any())
                        {
                            <tr>
                                <td colspan="9" class="px-5 py-12 text-center">
                                    <p class="text-sm text-gray-500">No users found.</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            int index = (CurrentPage - 1) * 10;
                            foreach (var user in UsersList)
                            {
                                index++;
                                <tr class="hover:bg-[#faf9f5] border-b border-[#f0ede5] transition-colors duration-100">
                                    <td class="px-3.5 py-2.5 text-xs text-gray-400 align-middle text-center">@index</td>
                                    <td class="px-3.5 py-2.5 text-xs font-semibold text-[#1a1a1a] align-middle">@user.name</td>
                                    <td class="px-3.5 py-2.5 text-xs text-gray-600 align-middle font-mono">@(string.IsNullOrEmpty(user.nrp) ? "-" : user.nrp)</td>
                                    <td class="px-3.5 py-2.5 text-xs text-gray-600 align-middle">@user.email</td>
                                    <td class="px-3.5 py-2.5 text-xs font-semibold text-[#e8a000] align-middle text-center">@user.poin</td>
                                    <td class="px-3.5 py-2.5 text-xs text-gray-600 align-middle">@(user.Division?.name ?? "--")</td>
                                    <td class="px-3.5 py-2.5 whitespace-nowrap align-middle">
                                        @{
                                            string bgClass = "bg-[#f5f4f0]";
                                            string textClass = "text-[#8a8780]";
                                            string borderClass = "border-[#e5e3dc]";
                                            if (user.role == "superadmin" || string.Equals(user.role, "Super Admin", StringComparison.OrdinalIgnoreCase)) { bgClass = "bg-purple-50"; textClass = "text-purple-700"; borderClass = "border-purple-200"; }
                                            else if (user.role == "manager") { bgClass = "bg-[#e0f2fe]"; textClass = "text-[#1a6b8a]"; borderClass = "border-[#bae6fd]"; }
                                            else if (user.role == "admin") { bgClass = "bg-[#fef3c7]"; textClass = "text-[#92400e]"; borderClass = "border-[#fde68a]"; }
                                        }
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold border @bgClass @textClass @borderClass">
                                            @((user.role ?? "").ToUpper())
                                        </span>
                                    </td>
                                    <td class="px-3.5 py-2.5 align-middle">
                                        <div class="flex flex-wrap gap-1 items-center">
                                            @if (UserCategoryMap.TryGetValue(user.id, out var catNames) && catNames.Any())
                                            {
                                                foreach (var name in catNames)
                                                {
                                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-[#eef9f0] border border-[#b8e8c0] text-[#1a7a30] whitespace-nowrap">
                                                        @name
                                                    </span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-[#eef9f0] border border-[#b8e8c0] text-[#1a7a30] whitespace-nowrap">
                                                    All Categories (Global)
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td class="px-3.5 py-2.5 whitespace-nowrap align-middle">
                                        <div class="flex items-center justify-end gap-1.5">
                                            @if (IsAdmin)
                                            {
                                                <button type="button" @onclick="() => NavigateToEdit(user.id)"
                                                        class="text-[10px] font-bold text-[#3a3835] hover:text-[#1a1a1a] px-2.5 py-1 rounded bg-white border border-[#e5e3dc] hover:bg-[#f0ede5] transition cursor-pointer">
                                                    Edit
                                                </button>
                                                @if (CurrentUserId != user.id)
                                                {
                                                    <button type="button" @onclick="() => DeleteUser(user.id)"
                                                            class="text-[10px] font-bold text-[#d94040] hover:text-[#b83535] px-2.5 py-1 rounded bg-[#fef0f0] border border-[#f8c0c0] hover:bg-[#fee2e2] transition cursor-pointer">
                                                        Delete
                                                    </button>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mobile Card View -->
            <div class="block md:hidden space-y-3">
                @if (UsersList == null || !UsersList.Any())
                {
                    <div class="px-6 py-16 text-center bg-white rounded-xl border border-[#e5e3dc] shadow-sm">
                        <p class="text-sm text-gray-500">No users found.</p>
                    </div>
                }
                else
                {
                    int index = (CurrentPage - 1) * 10;
                    foreach (var user in UsersList)
                    {
                        index++;
                        <div class="p-5 bg-white border border-[#e5e3dc] rounded-xl shadow-sm hover:shadow transition-shadow space-y-3">
                            <div class="flex justify-between items-start">
                                <div>
                                    <span class="text-xs text-gray-400 font-bold">#@index</span>
                                    <h4 class="text-sm font-semibold text-[#1a1a1a] mt-0.5">@user.name</h4>
                                    <p class="text-xs text-gray-500">@user.email</p>
                                    @if (!string.IsNullOrEmpty(user.nrp))
                                    {
                                        <p class="text-[0.7rem] text-gray-400 font-mono mt-0.5">NRP: @user.nrp</p>
                                    }
                                </div>
                                @{
                                    string bgClass = "bg-[#f5f4f0]";
                                    string textClass = "text-[#8a8780]";
                                    string borderClass = "border-[#e5e3dc]";
                                    if (user.role == "superadmin" || string.Equals(user.role, "Super Admin", StringComparison.OrdinalIgnoreCase)) { bgClass = "bg-purple-50"; textClass = "text-purple-700"; borderClass = "border-purple-200"; }
                                    else if (user.role == "manager") { bgClass = "bg-[#e0f2fe]"; textClass = "text-[#1a6b8a]"; borderClass = "border-[#bae6fd]"; }
                                    else if (user.role == "admin") { bgClass = "bg-[#fef3c7]"; textClass = "text-[#92400e]"; borderClass = "border-[#fde68a]"; }
                                }
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold border @bgClass @textClass @borderClass">
                                    @((user.role ?? "").ToUpper())
                                </span>
                            </div>
                            <div class="grid grid-cols-2 gap-2 pt-2 border-t border-[#f0ede5] text-xs">
                                <div>
                                    <span class="text-gray-400 font-medium">Poin:</span>
                                    <span class="font-bold text-[#e8a000] ml-1">@user.poin</span>
                                </div>
                                <div>
                                    <span class="text-gray-400 font-medium">Division:</span>
                                    <span class="font-semibold text-gray-700 ml-1">@(user.Division?.name ?? "--")</span>
                                </div>
                            </div>
                            <div class="pt-2 border-t border-[#f0ede5] text-xs">
                                <span class="text-gray-400 font-medium block mb-1">Category Scope:</span>
                                <div class="flex flex-wrap gap-1">
                                    @if (UserCategoryMap.TryGetValue(user.id, out var catNames) && catNames.Any())
                                    {
                                        foreach (var name in catNames)
                                        {
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-[#eef9f0] border border-[#b8e8c0] text-[#1a7a30] whitespace-nowrap">
                                                @name
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-[#eef9f0] border border-[#b8e8c0] text-[#1a7a30] whitespace-nowrap">
                                            All Categories (Global)
                                        </span>
                                    }
                                </div>
                            </div>
                            
                            @if (IsAdmin)
                            {
                                <div class="flex items-center gap-2 pt-3 border-t border-[#f0ede5] justify-end">
                                    <button type="button" @onclick="() => NavigateToEdit(user.id)"
                                            class="flex-1 text-center text-xs font-bold text-[#3a3835] hover:text-[#1a1a1a] py-2 rounded bg-white border border-[#e5e3dc] hover:bg-[#f0ede5] transition cursor-pointer">
                                        Edit
                                    </button>
                                    @if (CurrentUserId != user.id)
                                    {
                                        <button type="button" @onclick="() => DeleteUser(user.id)"
                                                class="flex-1 text-center text-xs font-bold text-[#d94040] hover:text-[#b83535] py-2 rounded bg-[#fef0f0] border border-[#f8c0c0] hover:bg-[#fee2e2] transition cursor-pointer">
                                            Delete
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            </div>
            
            @if (TotalPages > 1)
            {
                <div class="mt-4 px-5 py-3.5 border border-[#e5e3dc] rounded-xl flex justify-between items-center bg-white shadow-sm">
                    <span class="text-xs text-[#8a8880]">Halaman @CurrentPage dari @TotalPages</span>
                    <div class="flex gap-2">
                        <button disabled="@(CurrentPage == 1)" @onclick="() => LoadData(CurrentPage - 1)" class="px-3 py-1 bg-white border border-[#e5e3dc] rounded text-sm disabled:opacity-50 hover:bg-gray-50">Prev</button>
                        <button disabled="@(CurrentPage == TotalPages)" @onclick="() => LoadData(CurrentPage + 1)" class="px-3 py-1 bg-white border border-[#e5e3dc] rounded text-sm disabled:opacity-50 hover:bg-gray-50">Next</button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<User>? UsersList;
    private Dictionary<int, List<string>> UserCategoryMap = new();
    
    private int CurrentPage = 1;
    private int TotalPages = 1;
    
    private string? ErrorMessage;
    private string? SuccessMessage;
    private bool IsAdmin = false;
    private bool IsSuperAdmin = false;
    private int CurrentUserId = 0;
    private bool IsSubmitting = false;
    private string LoadingMessage = "Memuat data...";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            if (int.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out int id))
                CurrentUserId = id;
            IsAdmin = user.HasPermission(WMS_UnitedTracors_Blazor.Helpers.Permissions.UsersManage);
            IsSuperAdmin = user.HasPermission(WMS_UnitedTracors_Blazor.Helpers.Permissions.RolesManage);
        }

        await LoadData(1);
    }

    private async Task LoadData(int page)
    {
        IsSubmitting = true;
        LoadingMessage = "Memuat data pengguna...";
        StateHasChanged();
        try
        {
            CurrentPage = page;
            var result = await UserService.GetUsersAsync("", CurrentPage, 10);
            UsersList = result.Users;
            TotalPages = result.TotalPages;

            if (UsersList != null && UsersList.Any())
            {
                UserCategoryMap = await AdminRoleService.GetUserCategoryNamesMapAsync(UsersList.Select(u => u.id).ToList());
            }
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private void NavigateToCreate()
    {
        Navigation.NavigateTo("/User/Create");
    }

    private void NavigateToEdit(int id)
    {
        Navigation.NavigateTo($"/User/Edit/{id}");
    }

    private async Task DeleteUser(int id)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Apakah Anda yakin ingin menghapus user ini?");
        if (!confirmed) return;

        ErrorMessage = null;
        SuccessMessage = null;
        IsSubmitting = true;
        LoadingMessage = "Menghapus akun pengguna...";
        StateHasChanged();

        try
        {
            var error = await UserService.DeleteUserAsync(id, CurrentUserId);
            if (error != null)
            {
                ErrorMessage = error;
            }
            else
            {
                SuccessMessage = "User berhasil dihapus.";
                await LoadData(CurrentPage);
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Gagal menghapus user: " + ex.Message;
        }
        finally
        {
            IsSubmitting = false;
        }
    }
}
