@inherits LayoutComponentBase

<div class="min-h-screen flex flex-col items-center justify-center p-4 bg-[#faf9f5]" style="font-family: 'DM Sans', sans-serif;">
    <div class="w-full sm:max-w-lg">
        <div class="flex justify-center mb-6">
            <a href="/">
                <img src="img/logo.svg" alt="United Tractors" style="height: 36px; margin-bottom: 0;">
            </a>
        </div>

        <div class="auth-card px-8 py-8 bg-white border border-[#e5e3dc] rounded-2xl shadow-[0_4px_20px_rgba(0,0,0,0.03)]">
            @Body
        </div>

        <div class="mt-6 text-center">
            <p style="font-size: 0.7rem; color: #a09e99; letter-spacing: 0.05em; text-transform: uppercase; font-weight: 600;">
                © 2026 United Tractors Corporate University (corpu)
            </p>
        </div>
    </div>
</div>

<style>
    .auth-card {
        background: #ffffff;
        border: 1px solid #e5e3dc;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    }

    .ut-input {
        width: 100%;
        padding: 0.6rem 1rem;
        font-size: 0.875rem;
        background: #f5f4f0;
        border: 1.5px solid #e5e3dc;
        border-radius: 10px;
        outline: none;
        transition: all 0.2s;
        color: #1a1a1a;
    }
    .ut-input:focus {
        background: #fff;
        border-color: #e8a000;
        box-shadow: 0 0 0 3px rgba(232, 160, 0, 0.1);
    }

    .ut-label {
        display: block;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #8a8880;
        margin-bottom: 0.5rem;
    }
</style>
