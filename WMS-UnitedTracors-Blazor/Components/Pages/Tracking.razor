@page "/Tracking"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using UT_WMSDotnet.Models
@using WMS_UnitedTracors_Blazor.Services
@inject TrackingService TrackingService
@inject TransactionService TransactionService
@inject CartService CartService
@inject DivisionService DivisionService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Tracking Penggunaan</PageTitle>

<div class="py-8 bg-[#f5f4f0] min-h-screen font-sans">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="mb-6">
            <h1 class="text-[1.6rem] font-bold text-[#1a1a1a] leading-none tracking-tight">Tracking <span class="text-[#e8a000]">Penggunaan</span></h1>
            <div class="text-[0.72rem] font-medium text-[#a09e99] mt-1">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</div>
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="mb-6 bg-[#fef0f0] border border-[#f8c0c0] text-[#d94040] px-5 py-4 rounded-xl flex items-center gap-3">
                <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <p class="text-sm font-semibold">@ErrorMessage</p>
            </div>
        }

        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="mb-6 bg-[#eef9f0] border border-[#b8e8c0] text-[#1a7a30] px-5 py-4 rounded-xl flex items-center gap-3">
                <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <p class="text-sm font-semibold">@SuccessMessage</p>
            </div>
        }

        @* Filters *@
        <div class="bg-white rounded-xl border border-[#e5e3dc] mb-6 overflow-hidden shadow-sm">
            <div class="px-5 py-4">
                <div class="flex flex-col lg:flex-row flex-wrap gap-3 items-end">
                    <div class="flex-1 min-w-[180px] w-full">
                        <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Search Product</label>
                        <div class="relative">
                            <input type="text" @bind="ProductSearch" placeholder="Name or SKU..."
                                class="block w-full pl-9 pr-3 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none transition-colors duration-150 text-[#1a1a1a]">
                            <svg class="w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                        </div>
                    </div>
                    <div class="min-w-[150px] w-full lg:w-auto">
                        <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Division</label>
                        <select @bind="DivisionId" class="block w-full px-3 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none transition-colors duration-150 text-[#1a1a1a]">
                            <option value="">All Divisions</option>
                            @foreach(var div in Divisions)
                            {
                                <option value="@div.id">@div.name</option>
                            }
                        </select>
                    </div>
                    <div class="min-w-[150px] w-full lg:w-auto">
                        <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Return Status</label>
                        <select @bind="ReturnStatus" class="block w-full px-3 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none transition-colors duration-150 text-[#1a1a1a]">
                            <option value="">All Types</option>
                            <option value="pending">Borrowed (Pending Return)</option>
                            <option value="returned">Borrowed (Returned)</option>
                        </select>
                    </div>
                    <div class="min-w-[140px] w-full lg:w-auto">
                        <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">From</label>
                        <input type="date" @bind="DateFrom" class="block w-full px-3 py-1.5 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none transition-colors duration-150 text-[#1a1a1a]">
                    </div>
                    <div class="min-w-[140px] w-full lg:w-auto">
                        <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">To</label>
                        <input type="date" @bind="DateTo" class="block w-full px-3 py-1.5 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none transition-colors duration-150 text-[#1a1a1a]">
                    </div>
                    <div class="flex gap-2 w-full lg:w-auto justify-end">
                        <button type="button" @onclick="LoadData" class="px-5 py-2 bg-[#e8a000] hover:bg-[#d49300] text-[#1a1a1a] text-xs font-bold rounded-lg transition active:scale-95 cursor-pointer whitespace-nowrap">
                            Apply
                        </button>
                        <button type="button" @onclick="ResetFilters" class="px-5 py-2 bg-white border border-[#e5e3dc] hover:bg-[#f0ede5] text-[#3a3835] text-xs font-bold rounded-lg transition cursor-pointer">
                            Reset
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @if(GroupedUsages == null)
        {
            <div class="text-center py-8 text-[#8a8880]">Loading...</div>
        }
        else if(!GroupedUsages.Any())
        {
            <div class="text-center py-8 text-[#8a8880]">Tidak ada data tracking yang ditemukan.</div>
        }
        else
        {
            <div class="space-y-4">
                @foreach(var group in GroupedUsages)
                {
                    var groupId = group.Key;
                    var groupItems = group.Value;
                    var firstItem = groupItems.First();
                    var borrowItemsOnly = groupItems.Where(i => i.request_type == "BORROW").ToList();
                    var giveawayItemsOnly = groupItems.Where(i => i.request_type == "GIVEAWAY").ToList();
                    var hasBorrow = borrowItemsOnly.Any();
                    var totalItems = hasBorrow ? borrowItemsOnly.Sum(i => i.quantity) : groupItems.Sum(i => i.quantity);
                    var totalReturned = hasBorrow ? borrowItemsOnly.Sum(i => i.returned_quantity) : groupItems.Sum(i => i.returned_quantity);
                    var allReturned = totalItems > 0 && totalReturned >= totalItems;
                    var isGiveaway = !hasBorrow;
                    var status = firstItem.status;

                    var isHandoverPending = hasBorrow && borrowItemsOnly.Any(i => i.status == "WAITING_HANDOVER" || i.status == "WAITING_ADMIN_HANDOVER");
                    var isWaitingAdminHandover = hasBorrow && borrowItemsOnly.Any(i => i.status == "WAITING_ADMIN_HANDOVER");
                    var handoverDone = hasBorrow && borrowItemsOnly.Any(i => i.status == "APPROVED" && !string.IsNullOrEmpty(i.handover_photo));
                    // Tombol upload hanya saat menunggu bukti dari user (WAITING_HANDOVER), bukan saat menunggu verifikasi admin.
                    var canHandover = hasBorrow && borrowItemsOnly.Any(i => i.status == "WAITING_HANDOVER")
                                      && (UserRole == "admin" || UserRole == "superadmin" || firstItem.requester_id == CurrentUserId);
                    // Draft serah terima: status masih WAITING_HANDOVER tapi foto sudah diunggah (belum disubmit ke admin).
                    var hasHandoverDraftPhoto = hasBorrow && borrowItemsOnly.Any(i => i.status == "WAITING_HANDOVER" && !string.IsNullOrEmpty(i.handover_photo));
                    var canGiveawayHandover = isGiveaway && status == "WAITING_HANDOVER" && (UserRole == "admin" || UserRole == "superadmin");
                    var hasGiveawayHandoverDraftPhoto = isGiveaway && giveawayItemsOnly.Any(i => i.status == "WAITING_HANDOVER" && !string.IsNullOrEmpty(i.handover_photo));
                    var canUploadDocumentation = isGiveaway && (status == "WAITING_DOCUMENTATION" || status == "DOCUMENTATION_OVERDUE") && (firstItem.requester_id == CurrentUserId || UserRole == "superadmin");

                    var isExpanded = ExpandedGroupIds.Contains(groupId);

                    <div class="bg-white rounded-xl border border-[#e5e3dc] overflow-hidden shadow-sm transition-all duration-200">
                        @* Header Accordion *@
                        <div @onclick="() => ToggleGroup(groupId)" class="px-5 py-4 cursor-pointer hover:bg-[#faf9f5] transition flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                            <div class="flex items-center gap-4 flex-1 min-w-0">
                                <div class="w-10 h-10 rounded-full bg-[#f5f4f0] border border-[#e5e3dc] flex items-center justify-center shrink-0">
                                    @if(isGiveaway) {
                                        <svg class="w-5 h-5 text-[#e8a000]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                                    } else {
                                        <svg class="w-5 h-5 text-[#e8a000]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                    }
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-2 mb-1">
                                        <h3 class="font-syne font-bold text-[#1a1a1a] truncate">@(string.IsNullOrEmpty(firstItem.event_name) ? (isGiveaway ? "Request Barang" : "Peminjaman Barang") : firstItem.event_name)</h3>
                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#f5f4f0] text-[#8a8780] border border-[#e5e3dc]">@groupItems.Count Items</span>
                                        @if(isGiveaway) {
                                            @if(status == "COMPLETED" || status == "APPROVED") {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#eef9f0] text-[#1a7a30] border border-[#b8e8c0]">Selesai</span>
                                            } else if(status == "REJECTED") {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#fef0f0] text-[#d94040] border border-[#f8c0c0]">Ditolak</span>
                                            } else if(status == "REVISION" || status == "REVISION_BY_STAFF_INVENTORY" || status == "REVISION_BY_ADMIN" || status == "REVISION_BY_MANAGER") {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#fffbeb] text-[#d97706] border border-[#fde68a]">Butuh Revisi</span>
                                            } else if(status == "PENDING_STAFF_INVENTORY") {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#fff8e6] text-[#b37a00] border border-[#ffe099]">Menunggu Staff Inventoris</span>
                                            } else if(status == "PENDING_ADMIN") {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#fff8e6] text-[#b37a00] border border-[#ffe099]">Menunggu Admin</span>
                                            } else if(status == "PENDING_MANAGER") {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#fff8e6] text-[#b37a00] border border-[#ffe099]">Menunggu Manager</span>
                                            } else if(status == "WAITING_HANDOVER") {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#e0f2fe] text-[#1a6b8a] border border-[#bae6fd]">Menunggu Serah Terima</span>
                                            } else if(status == "WAITING_DOCUMENTATION") {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#e8f5e9] text-[#2e7d32] border border-[#c8e6c9]">Menunggu Dokumentasi User</span>
                                            } else if(status == "DOCUMENTATION_OVERDUE") {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#fef0f0] text-[#d94040] border border-[#f8c0c0]">Dokumentasi Overdue</span>
                                            } else {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#fff8e6] text-[#b37a00] border border-[#ffe099]">Sedang Diproses</span>
                                            }
                                        } else {
                                            @if(status == "REJECTED") {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#fef0f0] text-[#d94040] border border-[#f8c0c0]">Ditolak</span>
                                            } else if(status == "REVISION" || status == "REVISION_BY_ADMIN") {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#fffbeb] text-[#d97706] border border-[#fde68a]">Butuh Revisi</span>
                                            } else if(status == "WAITING_HANDOVER") {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#fff8e6] text-[#b37a00] border border-[#ffe099]">Menunggu Bukti Serah Terima</span>
                                            } else if(status == "WAITING_ADMIN_HANDOVER") {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#e0f2fe] text-[#1a6b8a] border border-[#bae6fd]">Menunggu Verifikasi Admin</span>
                                            } else if(allReturned) {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#eef9f0] text-[#1a7a30] border border-[#b8e8c0]">Selesai</span>
                                            } else {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#fff8e6] text-[#b37a00] border border-[#ffe099]">Sedang Dipinjam</span>
                                            }
                                        }
                                    </div>
                                    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-gray-500">
                                        <div class="flex items-center gap-1.5">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                                            @(firstItem.applicant_name ?? firstItem.Requester?.name)
                                        </div>
                                        <div class="flex items-center gap-1.5">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                            @(isGiveaway ? "Request" : "Pinjam"): @firstItem.created_at.ToString("dd MMM yyyy")
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @* Breadcrumbs / Stepper UI (Group Level) *@
                            <div class="w-full lg:w-auto mt-4 lg:mt-0 flex items-center lg:justify-end flex-1 lg:pr-8 overflow-x-auto" style="scrollbar-width: none;">
                                <nav class="flex" aria-label="Breadcrumb">
                                    <ol role="list" class="flex items-center space-x-2">
                                        @{ var steps = GetGroupSteps(groupItems); }
                                        @for (int i = 0; i < steps.Count; i++)
                                        {
                                            var step = steps[i];
                                            <li>
                                                <div class="flex items-center">
                                                    @if (i > 0) {
                                                        <svg class="h-3.5 w-3.5 text-[#d1cec7] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                                                    }
                                                    <div class="flex items-center gap-1.5 @(i > 0 ? "ml-2" : "")">
                                                        @if (step.Status == "DONE") {
                                                            <div class="w-3.5 h-3.5 rounded-full bg-[#1a7a30] flex items-center justify-center shrink-0">
                                                                <svg class="w-2 h-2 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                                                            </div>
                                                            <span class="text-[10px] font-bold text-[#1a7a30] whitespace-nowrap">@step.Name</span>
                                                        } else if (step.Status == "ACTIVE") {
                                                            <div class="w-2 h-2 rounded-full bg-[#3b82f6] shadow-sm shrink-0 ring-[2px] ring-blue-100"></div>
                                                            <span class="text-[10px] font-bold text-[#3b82f6] whitespace-nowrap">@step.Name</span>
                                                        } else if (step.Status == "WARNING") {
                                                            <div class="w-2 h-2 rounded-full bg-[#d94040] shadow-sm shrink-0 ring-[2px] ring-red-100"></div>
                                                            <span class="text-[10px] font-bold text-[#d94040] whitespace-nowrap">@step.Name</span>
                                                        } else {
                                                            <div class="w-1.5 h-1.5 rounded-full bg-[#e5e3dc] shrink-0"></div>
                                                            <span class="text-[10px] font-medium text-[#a09e99] whitespace-nowrap">@step.Name</span>
                                                        }
                                                    </div>
                                                </div>
                                            </li>
                                        }
                                    </ol>
                                </nav>
                            </div>

                            <div class="flex items-center justify-end gap-3 shrink-0">
                                @if (canHandover && !hasHandoverDraftPhoto)
                                {
                                    <button type="button" @onclick="() => OpenHandoverModal(borrowItemsOnly)" @onclick:stopPropagation="true" class="inline-flex items-center gap-2 px-4 py-2.5 bg-[#e8a000] hover:bg-[#d49300] text-[#1a1a1a] text-sm font-bold rounded-lg shadow-sm transition active:scale-95 cursor-pointer whitespace-nowrap">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
                                        Upload Bukti Serah Terima
                                    </button>
                                }
                                @if (canGiveawayHandover && !hasGiveawayHandoverDraftPhoto)
                                {
                                    <button type="button" @onclick="() => OpenHandoverModal(giveawayItemsOnly)" @onclick:stopPropagation="true" class="inline-flex items-center gap-2 px-4 py-2.5 bg-[#e8a000] hover:bg-[#d49300] text-[#1a1a1a] text-sm font-bold rounded-lg shadow-sm transition active:scale-95 cursor-pointer whitespace-nowrap">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
                                        Upload Bukti Serah Terima
                                    </button>
                                }
                                @if (canUploadDocumentation)
                                {
                                    <button type="button" @onclick="() => OpenDocumentationModal(giveawayItemsOnly)" @onclick:stopPropagation="true" class="inline-flex items-center gap-2 px-4 py-2.5 bg-[#1a7a30] hover:bg-[#166528] text-white text-sm font-bold rounded-lg shadow-sm transition active:scale-95 cursor-pointer whitespace-nowrap">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 16v-8m0 0-3 3m3-3 3 3M5 20h14"/></svg>
                                        Upload Dokumentasi
                                    </button>
                                }
                                @if (groupItems.Any(i => i.returned_quantity > 0 || (i.pending_return_quantity > 0 && i.is_return_draft == 0)))
                                {
                                    <a href="/api/pdf/receipt-return/@firstItem.group_id" target="_blank" @onclick:stopPropagation="true" class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1.5 bg-white border border-[#b8e8c0] text-[#1a7a30] hover:bg-[#eef9f0] rounded text-xs font-semibold transition">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                        PDF Bukti Pengembalian
                                    </a>
                                }
                                <div class="w-8 h-8 rounded-full flex items-center justify-center text-gray-400 hover:text-gray-600 hover:bg-[#f0ede5] transition">
                                    <svg class="w-5 h-5 transition-transform duration-200 @(isExpanded ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                                </div>
                            </div>
                        </div>

                        @if(isExpanded)
                        {
                            <div class="border-t border-[#e5e3dc] bg-[#faf9f5]">
                                <!-- PDF Bookkeeping Download Checklist -->
                                <div class="p-4 bg-white border-b border-[#e5e3dc] flex flex-wrap gap-2.5 items-center">
                                    <span class="text-[0.65rem] font-bold uppercase tracking-wider text-[#8a8780] mr-2 block w-full sm:w-auto">Dokumen Pembukuan (PDF):</span>
                                    
                                    <!-- 1. Bukti Pengajuan -->
                                    @if(groupItems.Any(i => i.status == "WAITING_HANDOVER" || i.status == "WAITING_ADMIN_HANDOVER" || i.status == "APPROVED"))
                                    {
                                    <a href="/api/pdf/receipt-request/@firstItem.group_id" target="_blank" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-gray-50 hover:bg-gray-100 border border-gray-200 text-gray-700 rounded-lg text-xs font-semibold transition shadow-sm">
                                        <svg class="w-3.5 h-3.5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                        1. Bukti Pengajuan
                                    </a>
                                    }
                                    else
                                    {
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-gray-100/50 border border-gray-200/50 text-gray-400 rounded-lg text-xs font-semibold cursor-not-allowed" title="Menunggu persetujuan Admin/Manager">
                                        <svg class="w-3.5 h-3.5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                        1. Bukti Pengajuan
                                    </span>
                                    }

                                    <!-- 2. Bukti Penyerahan -->
                                    @if(groupItems.Any(i => i.status == "WAITING_ADMIN_HANDOVER" || i.status == "APPROVED"))
                                    {
                                    <a href="/api/pdf/receipt-handover/@firstItem.group_id" target="_blank" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-purple-50 hover:bg-purple-100 border border-purple-200 text-purple-700 rounded-lg text-xs font-semibold transition shadow-sm">
                                        <svg class="w-3.5 h-3.5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                        2. Bukti Penyerahan
                                    </a>
                                    }
                                    else
                                    {
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-gray-100/50 border border-gray-200/50 text-gray-400 rounded-lg text-xs font-semibold cursor-not-allowed" title="Menunggu upload bukti serah terima">
                                        <svg class="w-3.5 h-3.5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                        2. Bukti Penyerahan
                                    </span>
                                    }

                                    <!-- 3. Bukti Pengembalian -->
                                    @if(hasBorrow)
                                    {
                                        @if(groupItems.Any(i => i.returned_quantity > 0 || (i.pending_return_quantity > 0 && i.is_return_draft == 0)))
                                        {
                                        <a href="/api/pdf/receipt-return/@firstItem.group_id" target="_blank" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 text-emerald-700 rounded-lg text-xs font-semibold transition shadow-sm">
                                            <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                            3. Bukti Pengembalian
                                        </a>
                                        }
                                        else
                                        {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-gray-100/50 border border-gray-200/50 text-gray-400 rounded-lg text-xs font-semibold cursor-not-allowed" title="Menunggu pengembalian barang">
                                            <svg class="w-3.5 h-3.5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                            3. Bukti Pengembalian
                                        </span>
                                        }
                                    }
                                </div>
                                
                                @if(status == "WAITING_HANDOVER" && !string.IsNullOrEmpty(firstItem.rejection_reason))
                                {
                                    <div class="p-4 bg-[#fef0f0] border-b border-[#f8c0c0] flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                                        <div class="flex items-start gap-3">
                                            <div class="p-2 bg-[#fde2e2] text-[#d94040] rounded-lg shrink-0 mt-0.5 animate-pulse">
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                                            </div>
                                            <div>
                                                <h4 class="text-sm font-extrabold text-[#d94040]">Bukti Serah Terima Ditolak Admin</h4>
                                                <p class="text-xs text-[#d94040] font-medium mt-0.5">Alasan: <span class="italic">"@firstItem.rejection_reason"</span></p>
                                            </div>
                                        </div>
                                        <button type="button" @onclick='() => OpenHandoverModal(borrowItemsOnly)' class="inline-flex items-center gap-1.5 px-4 py-2 bg-[#d94040] hover:bg-[#b83535] text-white text-xs font-bold rounded-lg transition shadow-sm">
                                            Upload Ulang Bukti
                                        </button>
                                    </div>
                                }
                                
                                @if(!string.IsNullOrEmpty(firstItem.handover_photo))
                                {
                                    var handoverPhotoSrc = ImageHelper.Resolve(firstItem.handover_photo);
                                    <div class="p-4 @(status == "WAITING_HANDOVER" ? "bg-[#fffbeb]" : "bg-white") border-b border-[#e5e3dc] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                                        <div class="flex items-start gap-4">
                                            @if (firstItem.handover_photo.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <a href="@handoverPhotoSrc" target="_blank" class="block w-20 h-20 rounded border border-gray-200 overflow-hidden bg-red-50 flex items-center justify-center flex-shrink-0 hover:opacity-95 transition cursor-pointer" title="Klik untuk membuka dokumen">
                                                    <svg class="w-8 h-8 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                                                </a>
                                            }
                                            else
                                            {
                                                <a href="@handoverPhotoSrc" data-image-popup class="block w-20 h-20 rounded border border-gray-200 overflow-hidden bg-gray-50 flex-shrink-0 hover:opacity-95 transition cursor-pointer" title="Klik untuk memperbesar foto bukti">
                                                    <img src="@handoverPhotoSrc" alt="Bukti Serah Terima" class="w-full h-full object-cover">
                                                </a>
                                            }
                                            <div>
                                                <div class="flex items-center gap-2 mb-1">
                                                    <h4 class="text-xs font-bold text-gray-900 tracking-wider uppercase">Bukti Serah Terima</h4>
                                                    @if (status == "WAITING_HANDOVER")
                                                    {
                                                        <span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-[#ede9fe] text-[#6d28d9] border border-[#c4b5fd]">DRAFT — Belum Dikirim</span>
                                                    }
                                                    else if (status == "WAITING_ADMIN_HANDOVER")
                                                    {
                                                        <span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-[#e0f2fe] text-[#1a6b8a] border border-[#bae6fd]">Menunggu Verifikasi Admin</span>
                                                    }
                                                    else if (status == "WAITING_DOCUMENTATION" || status == "DOCUMENTATION_OVERDUE")
                                                    {
                                                        <span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-[#e8f5e9] text-[#2e7d32] border border-[#c8e6c9]">Serah Terima Selesai</span>
                                                    }
                                                </div>
                                                <p class="text-xs text-gray-600 leading-relaxed max-w-xl italic">"@firstItem.handover_notes"</p>
                                                <p class="text-[11px] text-gray-500 mt-1">Penerima: @(firstItem.handover_recipient_name ?? firstItem.applicant_name ?? "-") | Waktu: @(firstItem.handover_timestamp?.ToString("dd MMM yyyy HH:mm") ?? "-")</p>
                                            </div>
                                        </div>
                                        @if ((canHandover || canGiveawayHandover) && status == "WAITING_HANDOVER")
                                        {
                                            <div class="flex gap-2 shrink-0 w-full sm:w-auto">
                                                <button type="button" @onclick="() => OpenHandoverModal(isGiveaway ? giveawayItemsOnly : borrowItemsOnly)" class="px-3 py-2 bg-white border border-[#e5e3dc] text-[#3a3835] hover:border-[#1a1a1a] text-xs font-bold rounded-lg transition">Ganti Foto</button>
                                                <button type="button" @onclick='() => AskConfirm("Submit Bukti Serah Terima", isGiveaway ? "Selesaikan serah terima giveaway ini? Stok akan dipotong dan sistem akan menunggu dokumentasi dari user." : "Kirim bukti serah terima ke admin untuk diverifikasi? Setelah dikirim Anda tidak bisa menggantinya lagi kecuali ditolak admin.", () => SubmitHandoverToAdmin(isGiveaway ? giveawayItemsOnly : borrowItemsOnly), isGiveaway ? "Ya, Selesaikan" : "Ya, Submit")' disabled="@IsSubmitting" class="px-4 py-2 bg-[#1a7a30] hover:bg-[#166528] text-white text-xs font-bold rounded-lg shadow-sm transition disabled:opacity-50">@(isGiveaway ? "Selesaikan Serah Terima" : "Submit ke Admin")</button>
                                            </div>
                                        }
                                    </div>
                                }

                                @if (isGiveaway && !string.IsNullOrEmpty(firstItem.documentation_photo))
                                {
                                    var documentationPhotoSrc = ImageHelper.Resolve(firstItem.documentation_photo);
                                    <div class="p-4 bg-white border-b border-[#e5e3dc] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                                        <div class="flex items-start gap-4">
                                            @if (firstItem.documentation_photo.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <a href="@documentationPhotoSrc" target="_blank" class="block w-20 h-20 rounded border border-gray-200 overflow-hidden bg-red-50 flex items-center justify-center flex-shrink-0 hover:opacity-95 transition cursor-pointer">
                                                    <svg class="w-8 h-8 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                                                </a>
                                            }
                                            else
                                            {
                                                <a href="@documentationPhotoSrc" data-image-popup class="block w-20 h-20 rounded border border-gray-200 overflow-hidden bg-gray-50 flex-shrink-0 hover:opacity-95 transition cursor-pointer">
                                                    <img src="@documentationPhotoSrc" alt="Dokumentasi User" class="w-full h-full object-cover">
                                                </a>
                                            }
                                            <div>
                                                <h4 class="text-xs font-bold text-gray-900 tracking-wider uppercase">Dokumentasi User</h4>
                                                <p class="text-xs text-gray-600 leading-relaxed max-w-xl italic">"@(firstItem.documentation_notes ?? "-")"</p>
                                                <p class="text-[11px] text-gray-500 mt-1">Diupload: @(firstItem.documentation_uploaded_at?.ToString("dd MMM yyyy HH:mm") ?? "-")</p>
                                            </div>
                                        </div>
                                    </div>
                                }

                                <div class="overflow-x-auto">
                                    <table class="w-full text-left border-collapse">
                                        <thead>
                                            <tr class="bg-[#f5f4f0] border-b border-[#e5e3dc]">
                                                <th class="px-5 py-3 text-[0.65rem] font-bold tracking-wider uppercase text-[#8a8780]">Product</th>
                                                <th class="px-5 py-3 text-[0.65rem] font-bold tracking-wider uppercase text-[#8a8780]">Kuantitas (Qty)</th>
                                                <th class="px-5 py-3 text-[0.65rem] font-bold tracking-wider uppercase text-[#8a8780]">Status Detail</th>
                                                <th class="px-5 py-3 text-[0.65rem] font-bold tracking-wider uppercase text-[#8a8780]">Catatan</th>
                                                <th class="px-5 py-3 text-[0.65rem] font-bold tracking-wider uppercase text-[#8a8780] text-right">Aksi</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-[#e5e3dc]">
                                            @foreach(var usage in groupItems)
                                            {
                                                <tr class="bg-white hover:bg-[#faf9f5] transition-colors">
                                                    <td class="px-5 py-3.5 align-middle">
                                                        <div class="text-sm font-semibold text-[#1a1a1a]">
                                                            @(usage.Product?.name ?? "-")
                                                            @if(usage.ProductVariant != null) {
                                                                var variantTexts = new List<string>();
                                                                if (!string.IsNullOrEmpty(usage.ProductVariant.color)) variantTexts.Add(usage.ProductVariant.color);
                                                                if (!string.IsNullOrEmpty(usage.ProductVariant.size)) variantTexts.Add(usage.ProductVariant.size);
                                                                if (variantTexts.Any()) {
                                                                    <span class="text-xs text-gray-500 font-normal ml-1">(@string.Join(", ", variantTexts))</span>
                                                                }
                                                            }
                                                        </div>
                                                        <div class="flex items-center gap-2 mt-0.5">
                                                            <code class="text-[10px] text-gray-500 font-mono">@(usage.Product?.sku ?? "-")</code>
                                                        </div>
                                                    </td>
                                                    <td class="px-5 py-3.5 align-middle">
                                                        <span class="text-sm font-bold text-[#1a1a1a]">@usage.quantity</span>
                                                        <span class="text-xs text-gray-500">@(usage.Product?.Unit?.name ?? "unit")</span>
                                                    </td>
                                                    <td class="px-5 py-3.5 align-middle">
                                                        @if(usage.status == "PENDING" || usage.status == "PENDING_ADMIN") {
                                                            <span class="inline-flex items-center px-2 py-0.5 border border-[#fde68a] rounded text-[10px] font-bold bg-[#fef3c7] text-[#92400e]">
                                                                Menunggu Admin
                                                            </span>
                                                        } else if (usage.status == "PENDING_STAFF_INVENTORY") {
                                                            <span class="inline-flex items-center px-2 py-0.5 border border-[#fde68a] rounded text-[10px] font-bold bg-[#fef3c7] text-[#92400e]">
                                                                Menunggu Staff Inventoris
                                                            </span>
                                                        } else if (usage.status == "PENDING_MANAGER") {
                                                            <span class="inline-flex items-center px-2 py-0.5 border border-[#c4b5fd] rounded text-[10px] font-bold bg-[#ede9fe] text-[#6d28d9]">
                                                                Menunggu Manager
                                                            </span>
                                                        } else if (usage.status == "WAITING_HANDOVER") {
                                                            <span class="inline-flex items-center px-2 py-0.5 border border-[#fde68a] rounded text-[10px] font-bold bg-[#fef3c7] text-[#92400e]">
                                                                Menunggu Bukti Serah Terima
                                                            </span>
                                                        } else if (usage.status == "WAITING_ADMIN_HANDOVER") {
                                                            <span class="inline-flex items-center px-2 py-0.5 border border-[#bae6fd] rounded text-[10px] font-bold bg-[#e0f2fe] text-[#1a6b8a]">
                                                                Menunggu Verifikasi Admin
                                                            </span>
                                                        } else if (usage.status == "WAITING_DOCUMENTATION") {
                                                            <span class="inline-flex items-center px-2 py-0.5 border border-[#c8e6c9] rounded text-[10px] font-bold bg-[#e8f5e9] text-[#2e7d32]">
                                                                Menunggu Dokumentasi User
                                                            </span>
                                                        } else if (usage.status == "DOCUMENTATION_OVERDUE") {
                                                            <span class="inline-flex items-center px-2 py-0.5 border border-[#f8c0c0] rounded text-[10px] font-bold bg-[#fef0f0] text-[#d94040]">
                                                                Dokumentasi Overdue
                                                            </span>
                                                        } else if (usage.status == "APPROVED" || usage.status == "COMPLETED") {
                                                            @if (usage.request_type == "BORROW") {
                                                                @if (usage.returned_quantity >= usage.quantity) {
                                                                    <span class="inline-flex items-center px-2 py-0.5 border border-[#b8e8c0] rounded text-[10px] font-bold bg-[#eef9f0] text-[#1a7a30]">
                                                                        Sudah Kembali (@usage.returned_quantity/@usage.quantity)
                                                                    </span>
                                                                } else if (usage.pending_return_quantity > 0 && usage.is_return_draft == 1) {
                                                                    <span class="inline-flex items-center px-2 py-0.5 border border-[#c4b5fd] rounded text-[10px] font-bold bg-[#ede9fe] text-[#6d28d9]">
                                                                        DRAFT (@usage.pending_return_quantity @(usage.Product?.Unit?.name ?? "unit"))
                                                                    </span>
                                                                    @if (!string.IsNullOrEmpty(usage.return_rejection_reason)) {
                                                                        <div class="text-[10px] text-[#d94040] mt-1.5 italic font-semibold">Ditolak admin: "@usage.return_rejection_reason" — silakan unggah ulang lalu submit.</div>
                                                                    }
                                                                } else if (usage.pending_return_quantity > 0 && usage.is_return_draft == 0) {
                                                                    <span class="inline-flex items-center px-2 py-0.5 border border-[#bae6fd] rounded text-[10px] font-bold bg-[#e0f2fe] text-[#1a6b8a]">
                                                                        Menunggu ACC (@usage.pending_return_quantity)
                                                                    </span>
                                                                } else {
                                                                    <span class="inline-flex items-center px-2 py-0.5 border border-[#fde68a] rounded text-[10px] font-bold bg-[#fef3c7] text-[#92400e]">
                                                                        Belum Kembali (@usage.returned_quantity/@usage.quantity)
                                                                    </span>
                                                                }
                                                                
                                                                @if(usage.returned_quantity > 0 && usage.returned_quantity < usage.quantity) {
                                                                    <span class="inline-flex items-center px-2 py-0.5 border border-[#b8e8c0] rounded text-[10px] font-bold bg-[#eef9f0] text-[#1a7a30] mt-1">
                                                                        Kembali Sebagian (@usage.returned_quantity)
                                                                    </span>
                                                                }

                                                                @if ((usage.pending_return_quantity ?? 0) > 0 && !string.IsNullOrEmpty(usage.return_photo) && usage.return_photo != "forced-by-admin")
                                                                {
                                                                    var returnPhotoSrc = ImageHelper.Resolve(usage.return_photo);
                                                                    <div class="mt-2">
                                                                        @if (usage.return_photo.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                                                                        {
                                                                            <a href="@returnPhotoSrc" target="_blank" class="inline-flex items-center gap-1 text-[10px] font-bold text-[#1a6b8a] hover:underline">
                                                                                <svg class="w-3.5 h-3.5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                                                                                Lihat PDF Bukti
                                                                            </a>
                                                                        }
                                                                        else
                                                                        {
                                                                            <a href="@returnPhotoSrc" data-image-popup class="inline-block w-14 h-14 rounded border border-[#e5e3dc] overflow-hidden hover:opacity-90 transition cursor-pointer" title="Klik untuk memperbesar bukti">
                                                                                <img src="@returnPhotoSrc" alt="Bukti Pengembalian" class="w-full h-full object-cover" />
                                                                            </a>
                                                                        }
                                                                    </div>
                                                                }
                                                            } else {
                                                                <span class="inline-flex items-center px-2 py-0.5 border border-[#b8e8c0] rounded text-[10px] font-bold bg-[#eef9f0] text-[#1a7a30]">
                                                                    Selesai / Diterima
                                                                </span>
                                                            }
                                                        } else if (usage.status == "REJECTED") {
                                                            <span class="inline-flex items-center px-2 py-0.5 border border-[#f8c0c0] rounded text-[10px] font-bold bg-[#fef0f0] text-[#d94040]">
                                                                Ditolak
                                                            </span>
                                                            @if(!string.IsNullOrEmpty(usage.rejection_reason)) {
                                                                <div class="text-[10px] text-red-600 mt-1.5 italic font-semibold">"@usage.rejection_reason"</div>
                                                            }
                                                        } else if (usage.status == "REVISION" || usage.status == "REVISION_BY_STAFF_INVENTORY" || usage.status == "REVISION_BY_ADMIN" || usage.status == "REVISION_BY_MANAGER") {
                                                            <span class="inline-flex items-center px-2 py-0.5 border border-[#fde68a] rounded text-[10px] font-bold bg-[#fffbeb] text-[#d97706]">
                                                                Butuh Revisi
                                                            </span>
                                                            @if(!string.IsNullOrEmpty(usage.rejection_reason)) {
                                                                <div class="text-[10px] text-amber-700 mt-1.5 italic font-semibold">"@usage.rejection_reason"</div>
                                                            }
                                                        }
                                                    </td>
                                                    <td class="px-5 py-3.5 align-middle text-xs text-gray-500 space-y-1">
                                                        @if (!string.IsNullOrEmpty(usage.notes)) { <div><span class="font-bold text-gray-400">User:</span> @usage.notes</div> }
                                                        @if (!string.IsNullOrEmpty(usage.staff_inventory_notes)) { <div><span class="font-bold text-[#e8a000]">Staff Inv:</span> @usage.staff_inventory_notes</div> }
                                                        @if (!string.IsNullOrEmpty(usage.admin_notes)) { <div><span class="font-bold text-[#e8a000]">Admin:</span> @usage.admin_notes</div> }
                                                        @if (!string.IsNullOrEmpty(usage.manager_notes)) { <div><span class="font-bold text-[#e8a000]">Manager:</span> @usage.manager_notes</div> }
                                                        @if (string.IsNullOrEmpty(usage.notes) && string.IsNullOrEmpty(usage.staff_inventory_notes) && string.IsNullOrEmpty(usage.admin_notes) && string.IsNullOrEmpty(usage.manager_notes)) { <span>-</span> }
                                                    </td>
                                                    <td class="px-5 py-3.5 align-middle text-right">
                                                        @{
                                                            var canReturn = usage.status == "APPROVED" && usage.request_type == "BORROW"
                                                                            && usage.returned_quantity < usage.quantity
                                                                            && (usage.pending_return_quantity ?? 0) == 0;
                                                            var isReturnDraft = usage.status == "APPROVED" && usage.request_type == "BORROW"
                                                                                && (usage.pending_return_quantity ?? 0) > 0 && usage.is_return_draft == 1;
                                                            var canManageDraft = isReturnDraft && (UserRole == "admin" || UserRole == "superadmin" || usage.requester_id == CurrentUserId);
                                                            var canRevise = usage.status == "REVISION" || usage.status == "REVISION_BY_STAFF_INVENTORY" || usage.status == "REVISION_BY_ADMIN" || usage.status == "REVISION_BY_MANAGER";
                                                            var hasAction = canReturn || canManageDraft || canRevise;
                                                        }
                                                        @if (canReturn)
                                                        {
                                                            <div class="flex items-center justify-end gap-2 flex-wrap">
                                                                <button type="button" @onclick="() => OpenReturnModal(usage, false)" class="text-[10px] px-2 py-1 bg-white border border-[#e5e3dc] rounded hover:border-[#1a1a1a] transition font-bold whitespace-nowrap">
                                                                    Return Item
                                                                </button>
                                                                @if (UserRole == "admin" || UserRole == "superadmin")
                                                                {
                                                                    <button type="button" @onclick="() => OpenReturnModal(usage, true)" class="text-[10px] px-2 py-1 bg-[#1a1a1a] text-white rounded hover:bg-[#333] transition font-bold whitespace-nowrap">
                                                                        Force Return
                                                                    </button>
                                                                }
                                                            </div>
                                                        }
                                                        else if (canManageDraft)
                                                        {
                                                            <div class="flex items-center justify-end gap-2 flex-wrap">
                                                                <button type="button" @onclick='() => AskConfirm("Ajukan Pengembalian", "Ajukan pengembalian ini ke admin untuk disetujui? Setelah diajukan, draft tidak bisa diubah.", () => SubmitReturnDraftItem(usage.id), "Ya, Ajukan")' disabled="@IsSubmitting" class="text-[10px] px-2 py-1 bg-[#1a7a30] hover:bg-[#166528] text-white rounded transition font-bold whitespace-nowrap disabled:opacity-50">
                                                                    Submit
                                                                </button>
                                                                <button type="button" @onclick="() => OpenReturnModal(usage, false)" class="text-[10px] px-2 py-1 bg-white border border-[#e5e3dc] rounded hover:border-[#1a1a1a] transition font-bold whitespace-nowrap">
                                                                    Ganti Foto
                                                                </button>
                                                                <button type="button" @onclick='() => AskConfirm("Batalkan Draft?", "Draft pengembalian beserta fotonya akan dihapus. Lanjutkan?", () => CancelReturnDraftItem(usage.id), "Ya, Batalkan")' disabled="@IsSubmitting" class="text-[10px] px-2 py-1 bg-white border border-[#f8c0c0] text-[#d94040] rounded hover:bg-[#fef0f0] transition font-bold whitespace-nowrap disabled:opacity-50">
                                                                    Batal
                                                                </button>
                                                            </div>
                                                        }
                                                        else if (canRevise)
                                                        {
                                                            <button type="button" @onclick='() => AskConfirm("Revisi Permintaan?", "Item akan dipindahkan ke keranjang untuk diperbaiki dan permintaan lama dihapus. Lanjutkan?", () => ReviseToCart(usage), "Ya, Revisi")' class="px-3 py-1 bg-[#e8a000] hover:bg-[#d49300] text-[#1a1a1a] text-[10px] font-bold rounded shadow-sm transition whitespace-nowrap">
                                                                Revisi
                                                            </button>
                                                        }
                                                        @if (!hasAction)
                                                        {
                                                            <span class="text-xs text-gray-300">-</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

