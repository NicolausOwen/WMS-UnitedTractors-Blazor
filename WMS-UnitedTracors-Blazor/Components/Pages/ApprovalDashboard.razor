                <div class="px-5 py-4 bg-[#faf9f5] border-t border-[#e5e3dc] flex flex-col sm:flex-row-reverse gap-2.5">
                    <button type="button" @onclick='() => SubmitReject("REJECT")' class="w-full sm:w-auto inline-flex justify-center rounded-xl bg-[#d94040] hover:bg-[#bf3535] px-4 py-2.5 text-xs font-extrabold text-white shadow-sm transition h-11 items-center">Tolak Item</button>
                    @if (!IsRejectingReturn)
                    {
                        <button type="button" @onclick='() => SubmitReject("REVISE")' class="w-full sm:w-auto inline-flex justify-center rounded-xl bg-[#e8a000] hover:bg-[#d49300] px-4 py-2.5 text-xs font-extrabold text-[#1a1a1a] shadow-sm transition h-11 items-center border border-[#d49300]">Minta Revisi</button>
                    }
                    <button type="button" @onclick="CloseRejectModal" class="w-full sm:w-auto inline-flex justify-center rounded-xl bg-white border border-[#e5e3dc] hover:bg-[#f0ede5] px-4 py-2.5 text-xs font-bold text-[#3a3835] transition h-11 items-center">Batal</button>
                </div>
            </div>
        </div>
    </div>
}

@if (ShowConfirm)
{
    <div class="fixed inset-0 z-[200] flex items-end justify-center sm:items-center p-0 sm:p-4 bg-black/50 backdrop-blur-sm animate-fadeIn" @onclick="CancelConfirm">
        <div class="bg-white rounded-t-3xl sm:rounded-2xl w-full sm:max-w-md shadow-2xl overflow-hidden pb-[calc(20px+env(safe-area-inset-bottom))] sm:pb-0 border border-gray-150" @onclick:stopPropagation="true">
            <!-- Drag handle (Mobile) -->
            <div class="w-12 h-1.5 bg-gray-300 rounded-full mx-auto my-3 sm:hidden shrink-0"></div>
            
            <div class="p-5 flex items-start gap-4">
                <div class="w-10 h-10 rounded-full bg-amber-50 flex items-center justify-center shrink-0 border border-amber-200">
                    <svg class="w-5.5 h-5.5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                </div>
                <div class="min-w-0">
                    <h3 class="text-base font-extrabold text-[#1a1a1a]">@ConfirmTitle</h3>
                    <p class="text-xs sm:text-sm text-[#5a5855] font-medium mt-1">@ConfirmMessage</p>
                </div>
            </div>
            
            <div class="px-5 py-4 bg-[#faf9f5] border-t border-[#e5e3dc] flex flex-col sm:flex-row justify-end gap-2.5">
                <button type="button" @onclick="RunConfirm" disabled="@IsProcessing" class="w-full sm:w-auto px-5 py-2.5 bg-[#1a1a1a] hover:bg-[#333] text-white text-xs font-extrabold rounded-xl transition shadow-sm select-none h-11 flex items-center justify-center">
                    @ConfirmButtonText
                </button>
                <button type="button" @onclick="CancelConfirm" class="w-full sm:w-auto px-5 py-2.5 bg-white border border-[#e5e3dc] hover:bg-[#f0ede5] text-gray-700 text-xs font-bold rounded-xl transition select-none h-11 flex items-center justify-center">
                    Batal
                </button>
            </div>
        </div>
    </div>
}

@code {
    // Reusable konfirmasi "apakah yakin" untuk aksi final.
    private bool ShowConfirm = false;
    private string ConfirmTitle = "";
    private string ConfirmMessage = "";
    private string ConfirmButtonText = "Ya, Lanjutkan";
    private Func<Task>? ConfirmCallback;

    private void AskConfirm(string title, string message, Func<Task> callback, string buttonText = "Ya, Lanjutkan")
    {
        ConfirmTitle = title;
        ConfirmMessage = message;
        ConfirmButtonText = buttonText;
        ConfirmCallback = callback;
        ShowConfirm = true;
    }

    private void CancelConfirm()
    {
        ShowConfirm = false;
        ConfirmCallback = null;
    }

    private async Task RunConfirm()
{
        var cb = ConfirmCallback;
        ShowConfirm = false;
        ConfirmCallback = null;
        if (cb != null) await cb();
    }    private RenderFragment RenderGroup(KeyValuePair<string, List<Transaction>> group) => __builder => {
