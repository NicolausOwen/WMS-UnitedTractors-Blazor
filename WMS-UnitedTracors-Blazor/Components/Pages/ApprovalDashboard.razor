                        </div>
                        <div class="mt-4 flex flex-wrap gap-1.5">
                            @foreach (var item in ApprovalHandoverItems)
                            {
                                <div class="px-2.5 py-1.5 rounded-lg border border-[#e5e3dc] bg-white text-[11px] font-semibold text-[#1a1a1a]">
                                    @(item.Product?.name ?? item.Product?.sku ?? $"Item #{item.id}") - @item.quantity @(item.Product?.Unit?.name ?? "unit")
                                </div>
                            }
                        </div>
                    </div>
                }

                <div>
                    <label class="block text-[0.72rem] font-bold tracking-[0.14em] uppercase text-[#8a8880] mb-2">Unggah File Foto / PDF</label>
                    <InputFile OnChange="HandleApprovalHandoverFileSelected" multiple accept="image/jpg,image/jpeg,image/png,image/webp,application/pdf" class="block w-full text-xs text-gray-500 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-extrabold file:bg-[#f5f4f0] file:text-[#1a1a1a] hover:file:bg-[#e5e3dc] transition cursor-pointer border border-[#e5e3dc] rounded-xl bg-white" />
                    <p class="text-[10px] text-gray-500 mt-1.5">Format: JPG, PNG, WEBP, PDF. Maksimal 5 file, maks 4MB per file.</p>
                    @if (ApprovalHandoverFiles.Any())
                    {
                        <div class="mt-3 flex flex-wrap gap-2">
                            @foreach (var file in ApprovalHandoverFiles)
                            {
                                <div class="px-3 py-2 rounded-xl border border-[#e5e3dc] bg-[#faf9f5] text-[11px] font-semibold text-[#1a1a1a] flex items-center gap-1.5">
                                    <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                    <span class="truncate max-w-[150px]">@file.Name</span>
                                    <span class="text-[#8a8880]">(@((file.Size / 1024.0 / 1024.0).ToString("0.#")) MB)</span>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-[0.72rem] font-bold tracking-[0.14em] uppercase text-[#8a8880] mb-2">Nama Penerima</label>
                        <input type="text" @bind="ApprovalHandoverRecipientName" class="w-full p-3 text-sm bg-white border border-[#e5e3dc] rounded-xl focus:border-[#e8a000] focus:ring-1 focus:ring-[#e8a000] outline-none transition-shadow" />
                    </div>
                    <div>
                        <label class="block text-[0.72rem] font-bold tracking-[0.14em] uppercase text-[#8a8880] mb-2">Waktu Serah Terima</label>
                        <input type="datetime-local" @bind="ApprovalHandoverTimestampInput" class="w-full p-3 text-sm bg-white border border-[#e5e3dc] rounded-xl focus:border-[#e8a000] focus:ring-1 focus:ring-[#e8a000] outline-none transition-shadow" />
                    </div>
                </div>

                <div>
                    <label class="block text-[0.72rem] font-bold tracking-[0.14em] uppercase text-[#8a8880] mb-2">Catatan Tambahan</label>
                    <textarea @bind="ApprovalHandoverNotes" rows="3" class="w-full p-3 text-sm bg-white border border-[#e5e3dc] rounded-xl focus:border-[#e8a000] focus:ring-1 focus:ring-[#e8a000] outline-none transition-shadow" placeholder="Catatan lokasi atau detail penyerahan..."></textarea>
                </div>

                @if (!string.IsNullOrWhiteSpace(HandoverDraftError))
                {
                    <div class="rounded-xl border border-[#f8c0c0] bg-[#fef0f0] px-4 py-3 text-sm font-semibold text-[#d94040]">@HandoverDraftError</div>
                }
            </div>
            
            <div class="px-5 py-4 border-t border-[#e5e3dc] bg-[#faf9f5] flex flex-col sm:flex-row-reverse gap-2.5 shrink-0">
                <button type="button" @onclick="SubmitApprovalHandoverDraft" disabled="@IsProcessing" class="w-full sm:w-auto px-5 py-3 bg-[#e8a000] hover:bg-[#d49300] text-[#1a1a1a] text-sm font-extrabold rounded-xl transition disabled:opacity-50 select-none">
                    Simpan Draft
                </button>
                <button type="button" @onclick="CloseApprovalHandoverModal" class="w-full sm:w-auto px-5 py-3 bg-white border border-[#e5e3dc] hover:bg-[#f0ede5] text-[#3a3835] text-sm font-bold rounded-xl transition select-none">
                    Batal
                </button>
            </div>
        </div>
    </div>
}

