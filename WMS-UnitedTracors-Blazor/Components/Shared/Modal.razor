@* Reusable, responsive modal.
   - Mobile: bottom-sheet (full width, rounded top), Desktop: centered card.
   - Body scrolls internally (max-h), header & footer stay sticky -> tombol selalu kelihatan.
   Usage:
     <Modal Show="IsOpen" Title="Judul" Size="lg" OnClose="Close">
         ...body...
         <Footer>...buttons...</Footer>
     </Modal>
*@
@if (Show)
{
    <div class="fixed inset-0 overflow-y-auto bg-black/50 backdrop-blur-sm" style="z-index:@ZIndex" @onclick="HandleBackdrop">
        <div class="flex min-h-full items-end justify-center p-0 sm:items-center sm:p-4">
            <div class="bg-white w-full @MaxWidthClass rounded-t-2xl sm:rounded-2xl shadow-2xl flex flex-col max-h-[92vh] sm:max-h-[88vh] overflow-hidden"
                 @onclick:stopPropagation="true">

                @if (Header != null || !string.IsNullOrEmpty(Title))
                {
                    <div class="px-5 sm:px-6 py-4 border-b border-[#e5e3dc] bg-[#faf9f5] flex items-center justify-between gap-3 shrink-0">
                        <div class="min-w-0">
                            @if (Header != null) { @Header }
                            else { <h3 class="text-base sm:text-lg font-bold text-[#1a1a1a] truncate">@Title</h3> }
                        </div>
                        @if (ShowClose)
                        {
                            <button type="button" @onclick="Close" class="text-gray-400 hover:text-gray-600 transition shrink-0 -mr-1">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                            </button>
                        }
                    </div>
                }

                <div class="px-5 sm:px-6 py-5 space-y-4 overflow-y-auto flex-1 min-h-0">
                    @ChildContent
                </div>

                @if (Footer != null)
                {
                    <div class="px-5 sm:px-6 py-4 border-t border-[#e5e3dc] bg-[#faf9f5] flex flex-col-reverse sm:flex-row sm:items-center sm:justify-end gap-2 shrink-0">
                        @Footer
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? Header { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    /// <summary>sm | md | lg | xl | 2xl</summary>
    [Parameter] public string Size { get; set; } = "lg";
    [Parameter] public bool ShowClose { get; set; } = true;
    [Parameter] public bool CloseOnBackdrop { get; set; } = true;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public int ZIndex { get; set; } = 100;

    private string MaxWidthClass => Size switch
    {
        "sm" => "sm:max-w-sm",
        "md" => "sm:max-w-md",
        "lg" => "sm:max-w-lg",
        "xl" => "sm:max-w-xl",
        "2xl" => "sm:max-w-2xl",
        _ => "sm:max-w-lg"
    };

    private async Task Close() => await OnClose.InvokeAsync();
    private async Task HandleBackdrop()
    {
        if (CloseOnBackdrop) await OnClose.InvokeAsync();
    }
}
