                    <div class="bg-white px-6 pt-6 pb-4">
                        <div class="flex items-center justify-between mb-5">
                            <h3 class="font-syne text-[1.05rem] font-bold text-[#1a1a1a]">Request Items</h3>
                            <button type="button" @onclick="CloseCartModal" class="text-[#a09e99] bg-transparent border-0 cursor-pointer p-1 hover:text-gray-700 transition">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
