    private async Task SubmitDispute()
    {
        if (string.IsNullOrWhiteSpace(DisputeReasonText))
        {
            DisputeModalError = "Alasan wajib diisi.";
            return;
        }

        if (IsSubmitting) return;
        var groupId = DisputeTargetItems.FirstOrDefault(i => i.status == "WAITING_HANDOVER_CONFIRM" || i.status == "APPROVED")?.group_id;
        if (string.IsNullOrEmpty(groupId)) return;

        IsSubmitting = true;
        DisputeModalError = null;
        try
        {
            var err = await TransactionService.ConfirmHandoverReceiptByUserAsync(groupId, CurrentUserId, false, DisputeReasonText);
            if (err == null)
            {
                SuccessMessage = "Keberatan berhasil dilaporkan. Transaksi dikembalikan ke Staff Inventoris.";
                CloseDisputeModal();
                await LoadData();
            }
            else
            {
                DisputeModalError = err;
            }
        }
        catch (Exception ex)
        {
            DisputeModalError = "Terjadi kesalahan saat mengirim laporan: " + ex.Message;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

