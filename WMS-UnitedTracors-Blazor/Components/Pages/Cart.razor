@page "/Borrow"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using UT_WMSDotnet.Models
@using UT_WMSDotnet.ViewModels
@using WMS_UnitedTracors_Blazor.Services
@inject CartService CartService
@inject TransactionService TransactionService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Request Items</PageTitle>

<div class="max-w-3xl mx-auto px-4 py-8">
    <div class="bg-white border border-gray-200 rounded-xl shadow-lg overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
            <h2 class="text-xl font-bold">Request Items</h2>
            <button @onclick='() => Navigation.NavigateTo("/")' class="text-gray-500 hover:text-gray-900">&larr; Back to Dashboard</button>
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="m-6 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm font-semibold">
                @ErrorMessage
            </div>
        }

        <div class="p-6 bg-gray-50">
            <h3 class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-3">Items in Cart</h3>
            @if (!CartService.Items.Any())
            {
                <div class="text-center py-8 text-gray-500">
                    Your cart is empty. <br />
                    <button @onclick='() => Navigation.NavigateTo("/")' class="mt-4 text-yellow-600 font-bold hover:underline">Browse Catalog</button>
                </div>
            }
            else
            {
                <div class="space-y-3 mb-6">
                    @foreach (var item in CartService.Items)
                    {
                        <div class="flex items-start gap-4 p-4 bg-white border border-gray-200 rounded-lg">
                            <div class="flex-1">
                                <h4 class="font-bold text-sm">@item.Name</h4>
                                <div class="text-xs text-gray-500">SKU: @item.Sku | Type: @item.RequestType</div>
                                
                                @if (item.RequestType == "BORROW")
                                {
                                    <div class="mt-2 flex gap-2">
                                        <div class="w-1/2">
                                            <label class="block text-[0.65rem] font-bold text-gray-500">Borrow Start</label>
                                            <input type="date" @bind="item.BorrowStartDate" class="w-full border rounded p-1 text-xs" />
                                        </div>
                                        <div class="w-1/2">
                                            <label class="block text-[0.65rem] font-bold text-gray-500">Expected Return</label>
                                            <input type="date" @bind="item.ExpectedReturnDate" class="w-full border rounded p-1 text-xs" />
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="w-24">
                                <label class="block text-[0.65rem] font-bold text-gray-500 text-center">Qty</label>
                                <input type="number" @bind="item.Quantity" min="1" max="@item.MaxStock" class="w-full border rounded p-1 text-center font-bold" />
                                <div class="text-[0.65rem] text-center text-gray-500 mt-1">@item.UnitName</div>
                            </div>
                            <button @onclick="() => CartService.RemoveItem(item)" class="text-red-500 hover:bg-red-50 p-2 rounded">
                                🗑️
                            </button>
                        </div>
                    }
                </div>

                <div class="border-t border-gray-200 pt-6">
                    <div class="grid grid-cols-2 gap-4 mb-4">
                        <div>
                            <label class="block text-xs font-bold text-gray-500 mb-1">Event Name</label>
                            <input type="text" @bind="EventName" placeholder="Event Name" class="w-full border rounded p-2 text-sm" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-500 mb-1">Event Date</label>
                            <input type="date" @bind="EventDate" class="w-full border rounded p-2 text-sm" />
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <label class="block text-xs font-bold text-gray-500 mb-1">Documentation Link (GDrive)</label>
                        <input type="url" @bind="DocumentationLink" placeholder="https://drive.google.com/..." class="w-full border rounded p-2 text-sm" />
                    </div>

                    <div class="mb-4">
                        <label class="block text-xs font-bold text-gray-500 mb-1">Notes</label>
                        <textarea @bind="Notes" rows="2" class="w-full border rounded p-2 text-sm resize-none"></textarea>
                    </div>
                </div>
            }
        </div>

        @if (CartService.Items.Any())
        {
            <div class="px-6 py-4 bg-white border-t border-gray-100 flex justify-between items-center">
                <div>
                    <span class="text-xs font-bold text-gray-500">Total Credit Required</span>
                    <div class="text-xl font-bold text-yellow-600">@CartService.GetTotalCredit() pts</div>
                    <div class="text-xs text-green-700 font-bold mt-1">Your Points: @UserPoints pts</div>
                </div>
                <button @onclick="SubmitRequest" disabled="@IsSubmitting" class="px-6 py-3 bg-yellow-500 hover:bg-yellow-600 text-black font-bold rounded-lg transition disabled:opacity-50">
                    @(IsSubmitting ? "Submitting..." : "Submit Request")
                </button>
            </div>
        }
    </div>
</div>

@code {
    private string? ErrorMessage;
    private bool IsSubmitting = false;
    
    private string EventName = "";
    private DateTime? EventDate = DateTime.Today;
    private string DocumentationLink = "";
    private string Notes = "";

    private int CurrentUserId = 0;
    private string ApplicantName = "";
    private string ApplicantNrp = "";
    private int DivisionId = 0;
    private int UserPoints = 0;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            if (int.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out int id))
                CurrentUserId = id;
                
            ApplicantName = user.FindFirst(ClaimTypes.Name)?.Value ?? "";
            ApplicantNrp = user.FindFirst("nrp")?.Value ?? "";
            
            if (int.TryParse(user.FindFirst("division_id")?.Value, out int divId))
                DivisionId = divId;
                
            if (int.TryParse(user.FindFirst("poin")?.Value, out int poin))
                UserPoints = poin;
        }
    }

    private async Task SubmitRequest()
    {
        ErrorMessage = null;
        IsSubmitting = true;

        try
        {
            if (!CartService.Items.Any())
            {
                ErrorMessage = "Cart is empty.";
                return;
            }

            var request = new TransactionRequestViewModel
            {
                type = "OUT",
                applicant_name = ApplicantName,
                applicant_nrp = ApplicantNrp,
                division_id = DivisionId,
                event_name = EventName,
                event_date = EventDate,
                documentation_link = DocumentationLink,
                notes = Notes,
                items = CartService.Items.Select(i => new TransactionItemViewModel
                {
                    sku = i.Sku,
                    quantity = i.Quantity,
                    request_type = i.RequestType,
                    borrow_start_date = i.BorrowStartDate,
                    expected_return_date = i.ExpectedReturnDate,
                    product_variant_id = i.ProductVariantId
                }).ToList()
            };

            var error = await TransactionService.StoreTransactionAsync(request, CurrentUserId);
            if (error != null)
            {
                ErrorMessage = error;
            }
            else
            {
                CartService.ClearCart();
                Navigation.NavigateTo("/Transactions/History");
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "An error occurred: " + ex.Message;
        }
        finally
        {
            IsSubmitting = false;
        }
    }
}
