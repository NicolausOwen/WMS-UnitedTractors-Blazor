@page "/approval-detail/{GroupId}"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using UT_WMSDotnet.Models
@using WMS_UnitedTracors_Blazor.Helpers
@using WMS_UnitedTracors_Blazor.Services
@inject ApprovalService ApprovalService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Detail Persetujuan - United Tractors</PageTitle>

<div class="w-full min-h-screen px-4 md:px-10 py-6 pb-24 md:pb-12 font-sans bg-[#f5f4f0]">
    <div class="max-w-5xl mx-auto">
        <!-- Back Button -->
        <button @onclick="GoBack" class="mb-4 flex items-center gap-2 text-gray-500 hover:text-[#1a1a1a] transition font-bold text-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
            Kembali ke Approval
        </button>

        @if (IsLoading)
        {
            <div class="bg-white p-12 rounded-xl border border-[#e5e3dc] text-center shadow-sm text-gray-500">Loading request details...</div>
        }
        else if (GroupItems == null || !GroupItems.Any())
        {
            <div class="bg-white p-12 rounded-xl border border-[#e5e3dc] text-center shadow-sm text-gray-500">Request tidak ditemukan.</div>
        }
        else
        {
            var firstItem = GroupItems.First();
            var isGiveaway = firstItem.request_type == "GIVEAWAY";
            var badgeClass = isGiveaway ? "bg-[#eef9f0] border border-[#d8eadb] text-[#1a7a30]" : "bg-[#eef6fd] border border-[#d9e6f3] text-[#1a6b8a]";
            var buttonBgClass = isGiveaway ? "bg-[#1a7a30] hover:bg-[#16692a] border-[#1a7a30] text-white font-extrabold" : "bg-[#1a6b8a] hover:bg-[#165a74] border-[#1a6b8a] text-white font-extrabold";

            <div class="bg-white border border-[#e5e3dc] rounded-2xl p-5 sm:p-6 shadow-sm flex flex-col gap-6">
                <!-- Details Header -->
                <div class="flex flex-col lg:flex-row lg:items-center justify-between pb-4 border-b border-[#f0ede5] gap-4">
                    <div class="min-w-0">
                        <div class="flex items-center gap-2 flex-wrap">
                            <h2 class="font-extrabold text-lg sm:text-xl text-[#1a1a1a]">@(firstItem.event_name ?? "-")</h2>
                            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black shrink-0 @badgeClass">@GroupItems.Count Item</span>
                        </div>
                        <div class="text-xs text-[#8a8880] font-semibold mt-1">
                            Dibuat pada @firstItem.created_at.ToString("dd MMM yyyy HH:mm") WIB
                        </div>
                    </div>
                </div>

                <!-- Info Grid (applicant info details) minimalist grid on mobile, horizontal scroll on desktop -->
                <div class="grid grid-cols-2 gap-2 sm:flex sm:flex-row sm:overflow-x-auto sm:gap-3 sm:pb-2 sm:mb-2 w-full sm:snap-x sm:snap-mandatory hide-scrollbars">
                    <!-- Pemohon -->
                    <div class="bg-gray-50 border border-gray-200 rounded-lg sm:rounded-2xl p-2.5 sm:p-4 flex flex-col justify-center sm:shrink-0 sm:w-[160px] md:w-[180px] sm:snap-start">
                        <span class="text-[8px] sm:text-[10px] text-gray-400 font-bold uppercase tracking-wider mb-0.5">Pemohon</span>
                        <span class="text-[10px] sm:text-sm font-extrabold text-[#1a1a1a] leading-tight">@(firstItem.applicant_name ?? firstItem.Requester?.name ?? "-")</span>
                        <span class="text-[8px] sm:text-[10px] text-gray-500 font-semibold mt-0.5 leading-tight">NRP: @(firstItem.applicant_nrp ?? "-")</span>
                    </div>
                    
                    <!-- Event -->
                    <div class="bg-gray-50 border border-gray-200 rounded-lg sm:rounded-2xl p-2.5 sm:p-4 flex flex-col justify-center sm:shrink-0 sm:w-[160px] md:w-[180px] sm:snap-start">
                        <span class="text-[8px] sm:text-[10px] text-gray-400 font-bold uppercase tracking-wider mb-0.5">Event / Progr.</span>
                        <span class="text-[10px] sm:text-sm font-extrabold text-[#1a1a1a] leading-tight">@(firstItem.event_name ?? "-")</span>
                        <span class="text-[8px] sm:text-[10px] text-gray-500 font-semibold mt-0.5 leading-tight">@(firstItem.event_date?.ToString("dd MMM yyyy") ?? "-")</span>
                    </div>
                    
                    <!-- Division -->
                    <div class="bg-gray-50 border border-gray-200 rounded-lg sm:rounded-2xl p-2.5 sm:p-4 flex flex-col justify-center sm:shrink-0 sm:w-[160px] md:w-[180px] sm:snap-start">
                        <span class="text-[8px] sm:text-[10px] text-gray-400 font-bold uppercase tracking-wider mb-0.5">Divisi</span>
                        <span class="text-[10px] sm:text-sm font-extrabold text-[#1a1a1a] leading-tight">@(firstItem.Division?.name ?? "-")</span>
                    </div>

                    @if (firstItem.request_type == "BORROW")
                    {
                        <!-- Rentang Peminjaman -->
                        <div class="bg-gray-50 border border-gray-200 rounded-lg sm:rounded-2xl p-2.5 sm:p-4 flex flex-col justify-center sm:shrink-0 sm:w-[160px] md:w-[180px] sm:snap-start">
                            <span class="text-[8px] sm:text-[10px] text-gray-400 font-bold uppercase tracking-wider mb-0.5">Rentang Pinjam</span>
                            <span class="text-[10px] sm:text-sm font-extrabold text-[#1a1a1a] leading-tight">
                                @(firstItem.borrow_start_date?.ToString("dd MMM") ?? "-") - @(firstItem.expected_return_date?.ToString("dd MMM yyyy") ?? "-")
                            </span>
                        </div>
                    }
                </div>

                <!-- Timeline & Flow section -->
                <div class="border border-[#e5e3dc] rounded-2xl p-5 bg-white">
                    <h4 class="font-extrabold text-sm text-[#1a1a1a] mb-4">Timeline & Approval Flow</h4>
                    <div class="relative flex flex-col space-y-6 my-2 pl-2">
                        <!-- Vertical connecting line -->
                        <div class="absolute top-2 bottom-2 bg-gray-300 z-0" style="width: 2px; left: 15px;"></div>

                        @{ var steps = GetGroupSteps(GroupItems); }
                        @for (int i = 0; i < steps.Count; i++)
                        {
                            var step = steps[i];
                            <div class="flex items-start gap-4 relative z-10">
                                <!-- Circle indicator wrapper -->
                                <div class="w-4 h-4 flex items-center justify-center shrink-0 mt-0.5 bg-white border rounded-full z-10
                                    @(step.Status == "DONE" ? "border-emerald-600" :
                                      step.Status == "ACTIVE" ? "border-blue-600 animate-pulse" :
                                      step.Status == "WARNING" ? "border-rose-600" :
                                      "border-gray-300")">
                                    @if (step.Status == "DONE") {
                                        <div class="w-full h-full rounded-full bg-[#1a7a30] flex items-center justify-center shrink-0">
                                            <svg class="w-2.5 h-2.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                                        </div>
                                    } else if (step.Status == "ACTIVE") {
                                        <span class="relative flex h-2 w-2 items-center justify-center">
                                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
                                            <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-600"></span>
                                        </span>
                                    } else if (step.Status == "WARNING") {
                                        <div class="w-full h-full rounded-full bg-[#d94040] flex items-center justify-center shrink-0">
                                            <svg class="w-2.5 h-2.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                                        </div>
                                    } else {
                                        <div class="w-1.5 h-1.5 rounded-full bg-gray-300"></div>
                                    }
                                </div>
                                <!-- Text Info -->
                                <div class="flex flex-col min-w-0">
                                    <span class="text-xs font-bold @(step.Status == "DONE" ? "text-[#1a7a30]" : step.Status == "ACTIVE" ? "text-blue-600" : step.Status == "WARNING" ? "text-[#d94040]" : "text-gray-500")">@step.Name</span>
                                    <span class="text-[10px] text-gray-400 leading-tight mt-0.5">
                                        @if (step.Status == "DONE" && step.CompletedAt.HasValue) {
                                            <span>Selesai: @step.CompletedAt.Value.ToString("dd MMM HH:mm")</span>
                                        } else if (step.Status == "DONE") {
                                            <span>Selesai dilakukan</span>
                                        } else if (step.Status == "ACTIVE") {
                                            <span>Sedang diproses</span>
                                        } else if (step.Status == "WARNING") {
                                            <span>Butuh perhatian / ditolak</span>
                                        } else {
                                            <span>Menunggu giliran</span>
                                        }
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Items List -->
                <div>
                    <div class="flex items-center justify-between mb-3 border-b border-[#f0ede5] pb-2">
                        <h4 class="font-extrabold text-sm text-[#1a1a1a] uppercase tracking-wider">ITEM DIMINTA (@GroupItems.Count)</h4>
                        
                        <!-- Select All Filter -->
                        <label class="flex items-center gap-2 cursor-pointer hover:bg-gray-50 px-2 py-1 rounded-lg transition">
                            <input type="checkbox" checked="@(SelectedItems.Count == GroupItems.Count && GroupItems.Count > 0)" 
                                   @onchange="ToggleSelectAll" class="w-4 h-4 text-[#1a6b8a] border-gray-300 rounded focus:ring-[#1a6b8a]" />
                            <span class="text-xs font-bold text-gray-700">Pilih Semua</span>
                        </label>
                    </div>

                    <!-- Table Header/List -->
                    <div class="border border-[#e5e3dc] rounded-2xl overflow-hidden divide-y divide-[#f0ede5] shadow-xs">
                        @foreach (var item in GroupItems)
                        {
                            var isSelected = SelectedItems.Contains(item.id);
                            var isShortage = (item.Product?.current_stock ?? 0) < item.quantity;
                            var rowBgClass = isSelected ? "bg-amber-50/30" : "bg-white";
                            
                            <div class="p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:bg-[#faf9f5]/50 transition-colors @rowBgClass">
                                <div class="flex items-center gap-3 min-w-0">
                                    <!-- Checkbox -->
                                    <input type="checkbox" checked="@isSelected" 
                                           @onchange='(e) => ToggleSelection(item.id, e.Value)'
                                           class="w-4.5 h-4.5 text-[#e8a000] border-gray-300 rounded focus:ring-[#e8a000] shrink-0" />
                                    
                                    <!-- Thumbnail -->
                                    <div class="w-12 h-12 rounded-xl border border-gray-200 overflow-hidden shrink-0 bg-white flex items-center justify-center">
                                        @if (string.IsNullOrEmpty(item.Product?.image))
                                        {
                                            <div class="w-full h-full bg-gray-50 flex items-center justify-center text-gray-400">
                                                <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                                            </div>
                                        }
                                        else
                                        {
                                            <img src="@ImageHelper.ResolveProduct(item.Product)" class="w-full h-full object-cover" />
                                        }
                                    </div>
                                    <div class="min-w-0">
                                        <h5 class="font-extrabold text-sm text-[#1a1a1a] truncate">@(item.Product?.name ?? "Unknown Product")</h5>
                                        <div class="text-[10px] text-gray-500 font-semibold mt-0.5 flex flex-wrap items-center gap-1.5">
                                            <span>Req: <span class="text-[#e8a000] font-black">@item.quantity</span> pcs</span>
                                            <span class="text-gray-300">•</span>
                                            <span>Stock: <span class="@(isShortage ? "text-red-600 font-black" : "text-emerald-600")">@(item.Product?.current_stock ?? 0)</span></span>
                                            @if (item.ProductVariant != null && (!string.IsNullOrEmpty(item.ProductVariant.color) || !string.IsNullOrEmpty(item.ProductVariant.size)))
                                            {
                                                <span class="text-gray-300">•</span>
                                                @if (!string.IsNullOrEmpty(item.ProductVariant.color))
                                                {
                                                    <span class="bg-[#f5f4f0] px-1 py-0.5 rounded text-[8px] border border-[#e5e3dc] leading-none font-bold text-[#5a5855]">Warna: @item.ProductVariant.color</span>
                                                }
                                                @if (!string.IsNullOrEmpty(item.ProductVariant.size))
                                                {
                                                    <span class="bg-[#f5f4f0] px-1 py-0.5 rounded text-[8px] border border-[#e5e3dc] leading-none font-bold text-[#5a5855]">Ukuran: @item.ProductVariant.size</span>
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="flex items-center gap-2 shrink-0">
                                    <button type="button" @onclick='() => PromptSingleAction(item.id, "REVISE")' disabled="@IsProcessing"
                                            class="px-3 py-1.5 border border-amber-200 hover:bg-amber-50 text-amber-600 text-xs font-extrabold rounded-lg transition disabled:opacity-50 flex items-center gap-1.5">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                        <span>Revisi</span>
                                    </button>
                                    <button type="button" @onclick='() => PromptSingleAction(item.id, "REJECT")' disabled="@IsProcessing"
                                            class="px-3 py-1.5 border border-red-200 hover:bg-red-50 text-red-600 text-xs font-extrabold rounded-lg transition disabled:opacity-50 flex items-center gap-1.5">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                                        <span>Tolak</span>
                                    </button>
                                    <button type="button" @onclick='() => PromptSingleAction(item.id, "APPROVE")' disabled="@IsProcessing"
                                            class="px-3 py-1.5 bg-[#1a7a30] hover:bg-[#16692a] text-white text-xs font-extrabold rounded-lg transition disabled:opacity-50 flex items-center gap-1.5">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                                        <span>Setujui</span>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Bottom Batch Actions -->
                    <div class="mt-4 p-4 bg-gray-50 border border-gray-200 rounded-2xl flex items-center justify-between shadow-sm">
                        <span class="text-xs font-bold text-gray-600">@SelectedItems.Count item terpilih</span>
                        <div class="flex items-center gap-2">
                            <button type="button" @onclick='() => PromptBatchAction("REVISE")' disabled="@(IsProcessing || SelectedItems.Count == 0)"
                                    class="px-4 py-2 border text-xs font-extrabold rounded-xl transition disabled:opacity-50 @(SelectedItems.Count > 0 ? "border-amber-200 text-amber-600 hover:bg-amber-50 cursor-pointer" : "border-gray-200 text-gray-400 bg-gray-100 cursor-not-allowed")">
                                Revisi Terpilih
                            </button>
                            <button type="button" @onclick='() => PromptBatchAction("REJECT")' disabled="@(IsProcessing || SelectedItems.Count == 0)"
                                    class="px-4 py-2 border text-xs font-extrabold rounded-xl transition disabled:opacity-50 @(SelectedItems.Count > 0 ? "border-red-200 text-red-600 hover:bg-red-50 cursor-pointer" : "border-gray-200 text-gray-400 bg-gray-100 cursor-not-allowed")">
                                Tolak Terpilih
                            </button>
                            <button type="button" @onclick='() => PromptBatchAction("APPROVE")' disabled="@(IsProcessing || SelectedItems.Count == 0)"
                                    class="px-4 py-2 text-xs font-extrabold rounded-xl transition disabled:opacity-50 @(SelectedItems.Count > 0 ? "bg-[#1a7a30] text-white hover:bg-[#16692a] shadow-sm cursor-pointer" : "bg-gray-200 text-gray-400 cursor-not-allowed")">
                                Setujui Terpilih
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Confirm Modal -->
    @if (ShowConfirmModal)
    {
        <div class="fixed inset-0 z-[200] flex items-end justify-center sm:items-center p-0 sm:p-4 bg-black/50 backdrop-blur-sm animate-fadeIn" @onclick="CloseConfirmModal">
            <div class="bg-white rounded-t-3xl sm:rounded-2xl w-full sm:max-w-md shadow-2xl overflow-hidden pb-[calc(20px+env(safe-area-inset-bottom))] sm:pb-0 border border-gray-150 animate-fade-in-up" @onclick:stopPropagation="true">
                <!-- Drag handle (Mobile) -->
                <div class="w-12 h-1.5 bg-gray-300 rounded-full mx-auto my-3 sm:hidden shrink-0"></div>
                
                <div class="p-5 flex items-start gap-4">
                    <div class="w-10 h-10 rounded-full @(ConfirmActionType == "APPROVE" ? "bg-emerald-50 border-emerald-200 text-[#1a7a30]" : ConfirmActionType == "REVISE" ? "bg-amber-50 border-amber-200 text-amber-600" : "bg-red-50 border-red-200 text-red-600") flex items-center justify-center shrink-0 border">
                        @if (ConfirmActionType == "APPROVE") {
                            <svg class="w-5.5 h-5.5 text-current" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                        } else if (ConfirmActionType == "REVISE") {
                            <svg class="w-5.5 h-5.5 text-current" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                        } else {
                            <svg class="w-5.5 h-5.5 text-current" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>
                        }
                    </div>
                    <div class="min-w-0">
                        <h3 class="text-base font-extrabold text-[#1a1a1a]">Konfirmasi Keputusan</h3>
                        <p class="text-xs text-gray-500 font-semibold mt-1">
                            Apakah Anda yakin ingin @(ConfirmActionType == "APPROVE" ? "menyetujui" : ConfirmActionType == "REVISE" ? "merevisi" : "menolak") @(ConfirmScope == "BATCH" ? $"{SelectedItems.Count} item terpilih" : "item ini")? Tindakan ini tidak dapat dibatalkan.
                        </p>
                    </div>
                </div>
                
                <div class="px-5 pb-4">
                    <label class="block text-xs font-bold text-gray-700 mb-1">Catatan @(ConfirmActionType == "REVISE" || ConfirmActionType == "REJECT" ? "(Wajib)" : "(Opsional)")</label>
                    <textarea @bind="ActionNotes" @bind:event="oninput" rows="3" class="w-full text-sm rounded-xl border border-gray-300 px-3 py-2 focus:ring-[#1a6b8a] focus:border-[#1a6b8a]" placeholder="Masukkan catatan..."></textarea>
                    @if (!string.IsNullOrEmpty(ModalErrorMessage))
                    {
                        <p class="text-xs text-red-500 mt-1 font-bold">@ModalErrorMessage</p>
                    }
                </div>
                
                <div class="p-4 bg-[#faf9f5] border-t border-[#e5e3dc] flex gap-3">
                    @{
                        bool isNotesRequired = ConfirmActionType == "REVISE" || ConfirmActionType == "REJECT";
                        bool isSubmitReady = !isNotesRequired || !string.IsNullOrWhiteSpace(ActionNotes);
                    }
                    <button type="button" @onclick="CloseConfirmModal" class="flex-1 px-4 py-2.5 bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 text-sm font-extrabold rounded-xl transition">
                        Batal
                    </button>
                    <button type="button" @onclick="ConfirmAction" disabled="@(IsProcessing || !isSubmitReady)" class="flex-1 px-4 py-2.5 @(isSubmitReady ? "bg-[#1a7a30] hover:bg-[#16692a] text-white" : "bg-gray-300 text-gray-500 cursor-not-allowed") text-sm font-extrabold rounded-xl transition disabled:opacity-50">
                        @(IsProcessing ? "Memproses..." : "Ya, Lanjutkan")
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string GroupId { get; set; } = "";

    private List<Transaction> GroupItems = new();
    private bool IsLoading = true;
    private bool IsProcessing = false;
    private HashSet<int> SelectedItems = new();
    
    // Modal State
    private bool ShowConfirmModal = false;
    private string ConfirmActionType = "";
    private string ConfirmScope = ""; // "SINGLE" or "BATCH"
    private int ConfirmItemId = 0;
    private string ActionNotes = "";
    private string ModalErrorMessage = "";
    
    private ClaimsPrincipal? userPrincipal;
    private int CurrentUserId = 0;
    private string UserRole = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        userPrincipal = authState.User;
        if (userPrincipal.Identity?.IsAuthenticated == true)
        {
            var userIdClaim = userPrincipal.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (int.TryParse(userIdClaim, out int id))
            {
                CurrentUserId = id;
            }
            UserRole = userPrincipal.FindFirst(ClaimTypes.Role)?.Value ?? "";
        }
        
        await LoadGroupData();
    }
    
    private async Task LoadGroupData()
    {
        IsLoading = true;
        try
        {
            var result = await ApprovalService.GetApprovalsAsync(CurrentUserId, UserRole);
            var allApprovals = result.GroupedApprovals;
            GroupItems = allApprovals != null && allApprovals.ContainsKey(GroupId) ? allApprovals[GroupId] : new List<Transaction>();
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/Approval");
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        if ((bool?)e.Value == true)
        {
            foreach (var item in GroupItems) SelectedItems.Add(item.id);
        }
        else
        {
            SelectedItems.Clear();
        }
    }

    private void ToggleSelection(int id, object? checkedValue)
    {
        if (checkedValue is bool isChecked && isChecked)
        {
            SelectedItems.Add(id);
        }
        else
        {
            SelectedItems.Remove(id);
        }
    }

    private void PromptSingleAction(int id, string action)
    {
        ConfirmActionType = action;
        ConfirmScope = "SINGLE";
        ConfirmItemId = id;
        ActionNotes = "";
        ModalErrorMessage = "";
        ShowConfirmModal = true;
    }

    private void PromptBatchAction(string action)
    {
        ConfirmActionType = action;
        ConfirmScope = "BATCH";
        ActionNotes = "";
        ModalErrorMessage = "";
        ShowConfirmModal = true;
    }

    private void CloseConfirmModal()
    {
        ShowConfirmModal = false;
    }

    private async Task ConfirmAction()
    {
        ModalErrorMessage = "";
        if ((ConfirmActionType == "REVISE" || ConfirmActionType == "REJECT") && string.IsNullOrWhiteSpace(ActionNotes))
        {
            ModalErrorMessage = "Catatan wajib diisi.";
            return;
        }

        if (ConfirmScope == "SINGLE")
        {
            await ProcessSingleAction(ConfirmItemId, ConfirmActionType);
        }
        else if (ConfirmScope == "BATCH")
        {
            await ProcessBatchAction(ConfirmActionType);
        }
        CloseConfirmModal();
    }

    private async Task ProcessSingleAction(int id, string action)
    {
        IsProcessing = true;
        try
        {
            if (action == "APPROVE")
                await ApprovalService.ApproveAsync(id, ActionNotes, CurrentUserId, UserRole);
            else if (action == "REJECT")
                await ApprovalService.RejectAsync(id, ActionNotes, CurrentUserId, UserRole);
            else if (action == "REVISE")
                await ApprovalService.RequestRevisionAsync(id, ActionNotes, CurrentUserId, UserRole);
            
            GroupItems.RemoveAll(x => x.id == id);
            SelectedItems.Remove(id);

            if (!GroupItems.Any())
                Navigation.NavigateTo("/Approval");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private async Task ProcessBatchAction(string action)
    {
        if (!SelectedItems.Any()) return;
        
        IsProcessing = true;
        try
        {
            var itemsToProcess = SelectedItems.ToList();
            var processedItems = new List<(Transaction item, string action, string? reason)>();

            foreach (var id in itemsToProcess)
            {
                var item = GroupItems.FirstOrDefault(x => x.id == id);
                if (action == "APPROVE")
                    await ApprovalService.ApproveAsync(id, ActionNotes, CurrentUserId, UserRole, false);
                else if (action == "REJECT")
                    await ApprovalService.RejectAsync(id, ActionNotes, CurrentUserId, UserRole, false);
                else if (action == "REVISE")
                    await ApprovalService.RequestRevisionAsync(id, ActionNotes, CurrentUserId, UserRole, false);
                
                if (item != null)
                {
                    processedItems.Add((item, action, ActionNotes));
                }
                GroupItems.RemoveAll(x => x.id == id);
            }
            
            if (processedItems.Any())
            {
                await ApprovalService.NotifyBatchResultAsync(processedItems);
            }
            
            SelectedItems.Clear();
            if (!GroupItems.Any())
                Navigation.NavigateTo("/Approval");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            IsProcessing = false;
        }
    }
    
    // Timeline Helper
    public class TrackingStep
    {
        public string Name { get; set; } = "";
        public string Status { get; set; } = "";
        public DateTime? CompletedAt { get; set; }
    }

    private List<TrackingStep> GetGroupSteps(List<Transaction> groupItems)
    {
        var firstItem = groupItems.FirstOrDefault();
        var steps = new List<TrackingStep>();
        if (firstItem == null) return steps;

        steps.Add(new TrackingStep { Name = "Pengajuan", Status = "DONE", CompletedAt = firstItem.created_at });

        if (firstItem.request_type == "GIVEAWAY")
        {
            if (firstItem.status == "PENDING_STAFF_INVENTORY") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "ACTIVE" });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Approval Manager", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Dokumentasi User", Status = "PENDING" });
            } else if (firstItem.status == "PENDING_ADMIN") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = "ACTIVE" });
                steps.Add(new TrackingStep { Name = "Approval Manager", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Dokumentasi User", Status = "PENDING" });
            } else if (firstItem.status == "PENDING_MANAGER") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Manager", Status = "ACTIVE" });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Dokumentasi User", Status = "PENDING" });
            } else if (firstItem.status == "REVISION" || firstItem.status == "REVISION_BY_STAFF_INVENTORY" || firstItem.status == "REVISION_BY_ADMIN" || firstItem.status == "REVISION_BY_MANAGER") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = firstItem.status == "REVISION_BY_STAFF_INVENTORY" ? "WARNING" : "DONE", CompletedAt = firstItem.status == "REVISION_BY_STAFF_INVENTORY" ? firstItem.updated_at : (firstItem.status == "PENDING_STAFF_INVENTORY" ? null : firstItem.updated_at) });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = firstItem.status == "REVISION_BY_ADMIN" ? "WARNING" : "PENDING", CompletedAt = firstItem.status == "REVISION_BY_ADMIN" ? firstItem.updated_at : null });
                steps.Add(new TrackingStep { Name = "Approval Manager", Status = firstItem.status == "REVISION_BY_MANAGER" ? "WARNING" : "PENDING", CompletedAt = firstItem.status == "REVISION_BY_MANAGER" ? firstItem.updated_at : null });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Dokumentasi User", Status = "PENDING" });
            } else if (firstItem.status == "WAITING_HANDOVER") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Manager", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "ACTIVE" });
                steps.Add(new TrackingStep { Name = "Dokumentasi User", Status = "PENDING" });
            } else if (firstItem.status == "WAITING_DOCUMENTATION") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Manager", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "DONE", CompletedAt = firstItem.handover_timestamp ?? firstItem.handover_approved_at ?? firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Dokumentasi User", Status = "ACTIVE" });
            } else if (firstItem.status == "DOCUMENTATION_OVERDUE") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Manager", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "DONE", CompletedAt = firstItem.handover_timestamp ?? firstItem.handover_approved_at ?? firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Dokumentasi User", Status = "WARNING" });
            } else if (firstItem.status == "COMPLETED" || firstItem.status == "APPROVED") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Manager", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "DONE", CompletedAt = firstItem.handover_timestamp ?? firstItem.handover_approved_at ?? firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Dokumentasi User", Status = "DONE", CompletedAt = firstItem.documentation_uploaded_at ?? firstItem.updated_at });
            } else if (firstItem.status == "REJECTED") {
                var approverRole = firstItem.Approver?.role?.ToLowerInvariant() ?? "";
                bool isManager = approverRole.Contains("manager") || !string.IsNullOrEmpty(firstItem.manager_notes);
                bool isAdmin = approverRole.Contains("admin") || !string.IsNullOrEmpty(firstItem.admin_notes);
                
                if (isManager)
                {
                    steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DONE", CompletedAt = firstItem.updated_at });
                    steps.Add(new TrackingStep { Name = "Approval Admin", Status = "DONE", CompletedAt = firstItem.updated_at });
                    steps.Add(new TrackingStep { Name = "Approval Manager", Status = "WARNING", CompletedAt = firstItem.updated_at });
                }
                else if (isAdmin)
                {
                    steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DONE", CompletedAt = firstItem.updated_at });
                    steps.Add(new TrackingStep { Name = "Approval Admin", Status = "WARNING", CompletedAt = firstItem.updated_at });
                    steps.Add(new TrackingStep { Name = "Approval Manager", Status = "PENDING" });
                }
                else
                {
                    steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "WARNING", CompletedAt = firstItem.updated_at });
                    steps.Add(new TrackingStep { Name = "Approval Admin", Status = "PENDING" });
                    steps.Add(new TrackingStep { Name = "Approval Manager", Status = "PENDING" });
                }
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Dokumentasi User", Status = "PENDING" });
            }
        }
        else // BORROW
        {
            int totalQty = groupItems.Sum(i => i.quantity ?? 0);
            int totalReturned = groupItems.Sum(i => i.returned_quantity ?? 0);

            if (firstItem.status == "PENDING_STAFF_INVENTORY") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "ACTIVE" });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Pengembalian", Status = "PENDING" });
            } else if (firstItem.status == "REVISION_BY_STAFF_INVENTORY") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "WARNING", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Pengembalian", Status = "PENDING" });
            } else if (firstItem.status == "PENDING_ADMIN" || firstItem.status == "PENDING") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = "ACTIVE" });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Pengembalian", Status = "PENDING" });
            } else if (firstItem.status == "REVISION_BY_ADMIN" || firstItem.status == "REVISION") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = "WARNING", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Pengembalian", Status = "PENDING" });
            } else if (firstItem.status == "WAITING_HANDOVER" || firstItem.status == "WAITING_ADMIN_HANDOVER") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "ACTIVE" });
                steps.Add(new TrackingStep { Name = "Pengembalian", Status = "PENDING" });
            } else if (firstItem.status == "APPROVED") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "DONE", CompletedAt = firstItem.handover_timestamp ?? firstItem.handover_approved_at ?? firstItem.updated_at });

                if (totalReturned >= totalQty && totalQty > 0) {
                    steps.Add(new TrackingStep { Name = "Pengembalian", Status = "DONE", CompletedAt = firstItem.returned_at ?? firstItem.updated_at });
                } else {
                    steps.Add(new TrackingStep { Name = "Pengembalian", Status = "ACTIVE" });
                }
            } else if (firstItem.status == "REJECTED") {
                var approverRole = firstItem.Approver?.role?.ToLowerInvariant() ?? "";
                bool isAdmin = approverRole.Contains("admin") || !string.IsNullOrEmpty(firstItem.admin_notes);
                
                if (isAdmin)
                {
                    steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DONE", CompletedAt = firstItem.updated_at });
                    steps.Add(new TrackingStep { Name = "Approval Admin", Status = "WARNING", CompletedAt = firstItem.updated_at });
                }
                else
                {
                    steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "WARNING", CompletedAt = firstItem.updated_at });
                    steps.Add(new TrackingStep { Name = "Approval Admin", Status = "PENDING" });
                }
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Pengembalian", Status = "PENDING" });
            }
        }
        return steps;
    }
}
