    private Dictionary<string, List<Transaction>>? GroupedApprovals;
    private List<Transaction>? PendingReturns;
    private List<ProfileRequest>? PendingProfileRequests;
    private Dictionary<string, List<Transaction>>? GroupedHandovers;
    
    private string? SuccessMessage;
    private string? ErrorMessage;
    private bool IsProcessing = false;

    private int CurrentUserId = 0;
    private string? UserRole;
    private string ActiveTab = "new";

    private HashSet<string> ExpandedGroups = new();
    
    private Dictionary<int, string> Decisions = new();
    private Dictionary<int, string> Reasons = new();
    private Dictionary<int, int?> RevisedQuantities = new();
    private Dictionary<int, DateTime?> RevisedPickupDates = new();
    private Dictionary<int, string> ReturnDecisions = new();
    private Dictionary<int, string> ReturnReasons = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            if (int.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out int id))
                CurrentUserId = id;
            UserRole = user.FindFirst(ClaimTypes.Role)?.Value;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        var data = await ApprovalService.GetApprovalsAsync(CurrentUserId, UserRole);
        GroupedApprovals = data.GroupedApprovals;
        PendingReturns = data.PendingReturns;
        PendingProfileRequests = data.PendingProfileRequests;
        GroupedHandovers = data.GroupedHandovers;
        
        ExpandedGroups.Clear();
        
        Decisions.Clear();
        Reasons.Clear();
        RevisedQuantities.Clear();
        RevisedPickupDates.Clear();
        ReturnDecisions.Clear();
        ReturnReasons.Clear();
    }

    private void ToggleGroup(string groupId)
    {
        if (ExpandedGroups.Contains(groupId))
            ExpandedGroups.Remove(groupId);
        else
            ExpandedGroups.Add(groupId);
    }

    private void SetDecision(int id, string decision)
    {
        Decisions[id] = decision;
        if (!Reasons.ContainsKey(id)) Reasons[id] = "";
    }
    
    private bool ShowRejectModal = false;
    private int RejectItemId = 0;
    private string RejectReason = "";
    private int? RejectRevisedQuantity;
    private DateTime? RejectRevisedPickupDate;
    private bool IsRejectingReturn = false;
    private bool RejectionError = false;

    private Transaction? GetApprovalItemById(int id)
    {
        return GroupedApprovals?
            .SelectMany(g => g.Value)
            .FirstOrDefault(t => t.id == id);
    }

    private static string GetDecisionLabel(string? decision) => decision switch
    {
        "APPROVE" => "Akan disetujui",
        "REJECT" => "Akan ditolak",
        "REVISE" => "Akan diminta revisi",
        _ => "-"
    };

    private void OpenRejectModal(int id, bool isReturn = false)
    {
        RejectItemId = id;
        IsRejectingReturn = isReturn;
        RejectReason = "";
        var item = GroupedApprovals?
            .SelectMany(g => g.Value)
            .FirstOrDefault(t => t.id == id);
        RejectRevisedQuantity = item?.quantity;
        RejectRevisedPickupDate = item?.pickup_date;
        RejectionError = false;
        ShowRejectModal = true;
    }

    private void CloseRejectModal()
    {
        ShowRejectModal = false;
        RejectItemId = 0;
        IsRejectingReturn = false;
        RejectRevisedQuantity = null;
        RejectRevisedPickupDate = null;
        RejectionError = false;
    }

    private async Task SubmitReject(string decision)
    {
        if (string.IsNullOrWhiteSpace(RejectReason))
        {
            RejectionError = true;
            return;
        }

        // Pengembalian: tolak langsung (alur instan, sama seperti serah terima).
        if (IsRejectingReturn)
        {
            var id = RejectItemId;
            var reason = RejectReason;
            CloseRejectModal();

            if (id <= 0 || IsProcessing) return;
            IsProcessing = true;
            ErrorMessage = null;
            SuccessMessage = null;
            try
            {
                var err = await ApprovalService.RejectReturnAsync(id, reason, CurrentUserId, UserRole);
                if (err == null) SuccessMessage = "Pengembalian ditolak.";
                else ErrorMessage = err;
                await LoadData();
            }
            catch (Exception ex)
            {
                ErrorMessage = "Terjadi kesalahan saat menolak pengembalian: " + ex.Message;
            }
            finally
            {
                IsProcessing = false;
            }
            return;
        }

        // Permintaan baru (New Requests): tetap pakai pola batch.
        if (RejectItemId > 0)
        {
            Decisions[RejectItemId] = decision;
            Reasons[RejectItemId] = RejectReason;
            if (decision == "REVISE")
            {
                RevisedQuantities[RejectItemId] = RejectRevisedQuantity;
                RevisedPickupDates[RejectItemId] = RejectRevisedPickupDate;
            }
        }
        CloseRejectModal();
    }

    private async Task ApproveReturn(int id)
    {
        if (IsProcessing) return;
        IsProcessing = true;
        ErrorMessage = null;
        SuccessMessage = null;
        try
        {
            var err = await ApprovalService.ApproveReturnAsync(id, CurrentUserId, UserRole);
            if (err == null) SuccessMessage = "Pengembalian disetujui.";
            else ErrorMessage = err;
            await LoadData();
        }
        catch (Exception ex)
        {
            ErrorMessage = "Terjadi kesalahan saat menyetujui pengembalian: " + ex.Message;
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private void ClearDecision(int id, bool isReturn = false)
    {
        if (isReturn)
        {
            if (ReturnDecisions.ContainsKey(id)) ReturnDecisions.Remove(id);
            if (ReturnReasons.ContainsKey(id)) ReturnReasons.Remove(id);
        }
        else
        {
            if (Decisions.ContainsKey(id)) Decisions.Remove(id);
            if (Reasons.ContainsKey(id)) Reasons.Remove(id);
            if (RevisedQuantities.ContainsKey(id)) RevisedQuantities.Remove(id);
            if (RevisedPickupDates.ContainsKey(id)) RevisedPickupDates.Remove(id);
        }
    }

    private void SetReturnDecision(int id, string decision)
    {
        if (decision == "REJECT")
        {
            OpenRejectModal(id, true);
        }
        else
        {
            ReturnDecisions[id] = decision;
            // Wajib: input "Notes" mengikat ke ReturnReasons[id] saat dirender,
            // jadi key harus ada agar tidak melempar KeyNotFoundException.
            if (!ReturnReasons.ContainsKey(id)) ReturnReasons[id] = "";
        }
    }

