@page "/login"
@layout Layout.AuthLayout
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Components.Web

<PageTitle>UT WMS - Login</PageTitle>

<!-- Header -->
<div style="text-align:center; margin-bottom:1.5rem;">
    <h2 style="font-family:'Syne','DM Sans',sans-serif; font-size:1.35rem; font-weight:700; color:#1a1a1a; margin:0;">
        Welcome Back
    </h2>
    <p style="font-size:0.85rem; color:#8a8880; margin:0.5rem 0 0;">
        United Tractors Inventory System
    </p>
</div>

<!-- Error messages -->
@if (IsError)
{
    <div class="auth-error">Email atau password salah.</div>
}
@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="auth-error">@errorMessage</div>
}

<form method="POST" action="/api/auth/login">
    <AntiforgeryToken />

    <!-- Email -->
    <div style="margin-bottom:1rem;">
        <label for="email" class="auth-label">Email</label>
        <input id="email"
               class="auth-input"
               type="email"
               name="email"
               required
               autofocus
               autocomplete="username"
               placeholder="you@company.com" />
    </div>

    <!-- Password -->
    <div style="margin-bottom:1rem;">
        <label for="password" class="auth-label">Password</label>
        <input id="password"
               class="auth-input"
               type="password"
               name="password"
               required
               autocomplete="current-password"
               placeholder="••••••••" />
    </div>

    <!-- Remember me -->
    <div class="auth-checkbox-row">
        <input id="remember_me" type="checkbox" name="remember_me" value="true">
        <label for="remember_me">Keep me signed in</label>
    </div>

    <!-- Actions -->
    <button type="submit" class="auth-btn-primary">Log in</button>

    <div class="auth-divider"><span>Or</span></div>

    <a href="/auth/microsoft" class="auth-btn-outline">
        <svg width="16" height="16" viewBox="0 0 21 21" xmlns="http://www.w3.org/2000/svg">
            <path d="M10 0H0v10h10V0z" fill="#f25022"/>
            <path d="M21 0H11v10h10V0z" fill="#7fba00"/>
            <path d="M10 11H0v10h10V11z" fill="#00a4ef"/>
            <path d="M21 11H11v10h10V11z" fill="#ffb900"/>
        </svg>
        Log in with Microsoft
    </a>
</form>

@code {
    [SupplyParameterFromQuery]
    private string? error { get; set; }

    [SupplyParameterFromQuery]
    private string? errorMessage { get; set; }

    private bool IsError => error == "1";
}
