@page "/Reports"
@using UT_WMSDotnet.Models
@using UT_WMSDotnet.ViewModels
@using WMS_UnitedTracors_Blazor.Services
@inject ReportService ReportService
@inject DivisionService DivisionService
@rendermode InteractiveServer

<PageTitle>Laporan / Reports</PageTitle>

<div class="px-4 md:px-10 py-6 pb-24 font-sans bg-[#f5f4f0] min-h-screen">
    <div class="flex justify-between items-center mb-6">
        <h2 class="font-semibold text-xl text-gray-800 leading-tight">Laporan</h2>
    </div>

    @if (Summary != null)
    {
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="bg-white rounded-xl shadow-sm border border-[#e5e3dc] p-6 border-l-4 border-l-yellow-500">
                <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Peminjaman</h3>
                <div class="text-3xl font-bold text-gray-900 mb-4">@Summary["peminjaman"].Count <span class="text-sm font-normal text-gray-500">transaksi</span></div>
                <div class="flex justify-between text-xs font-bold text-gray-500">
                    <span>Approved: <span class="text-green-600">@Summary["peminjaman"].Approved</span></span>
                    <span>Total Qty: <span class="text-gray-900">@Summary["peminjaman"].TotalQty</span></span>
                </div>
            </div>
            <div class="bg-white rounded-xl shadow-sm border border-[#e5e3dc] p-6 border-l-4 border-l-blue-500">
                <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Request Barang</h3>
                <div class="text-3xl font-bold text-gray-900 mb-4">@Summary["request_barang"].Count <span class="text-sm font-normal text-gray-500">transaksi</span></div>
                <div class="flex justify-between text-xs font-bold text-gray-500">
                    <span>Approved: <span class="text-green-600">@Summary["request_barang"].Approved</span></span>
                    <span>Total Qty: <span class="text-gray-900">@Summary["request_barang"].TotalQty</span></span>
                </div>
            </div>
            <div class="bg-white rounded-xl shadow-sm border border-[#e5e3dc] p-6 border-l-4 border-l-purple-500">
                <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Adjust Barang</h3>
                <div class="text-3xl font-bold text-gray-900 mb-4">@Summary["adjust_barang"].Count <span class="text-sm font-normal text-gray-500">transaksi</span></div>
                <div class="flex justify-between text-xs font-bold text-gray-500">
                    <span>Approved: <span class="text-green-600">@Summary["adjust_barang"].Approved</span></span>
                    <span>Total Qty: <span class="text-gray-900">@Summary["adjust_barang"].TotalQty</span></span>
                </div>
            </div>
        </div>
    }

    <div class="bg-white rounded-xl shadow-sm border border-[#e5e3dc] overflow-hidden mb-6">
        <div class="px-6 py-4 border-b border-[#f0ede5] bg-[#faf9f5]">
            <h3 class="font-bold text-[#1a1a1a] mb-4">Filter Laporan</h3>
            <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
                <div>
                    <label class="block text-xs font-bold text-gray-500 mb-1">Tipe Laporan</label>
                    <select @bind="SelectedReportType" class="w-full border border-gray-300 rounded-lg p-2 text-sm focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500">
                        <option value="peminjaman">Peminjaman (Borrow)</option>
                        <option value="request_barang">Request Barang (Giveaway)</option>
                        <option value="adjust_barang">Adjust Barang (Stock In)</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-500 mb-1">Mulai Tanggal</label>
                    <input type="date" @bind="StartDate" class="w-full border border-gray-300 rounded-lg p-2 text-sm focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-500 mb-1">Sampai Tanggal</label>
                    <input type="date" @bind="EndDate" class="w-full border border-gray-300 rounded-lg p-2 text-sm focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-500 mb-1">Divisi (Khusus Keluar)</label>
                    <select @bind="DivisionId" class="w-full border border-gray-300 rounded-lg p-2 text-sm focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500">
                        <option value="">Semua Divisi...</option>
                        @if (Divisions != null)
                        {
                            @foreach (var div in Divisions)
                            {
                                <option value="@div.Id">@div.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="flex items-end">
                    <button @onclick="() => LoadData(1)" class="w-full px-4 py-2 bg-gray-900 text-white rounded-lg text-sm font-bold shadow-sm hover:bg-gray-800 transition">Terapkan Filter</button>
                </div>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-[#e5e3dc] overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="bg-[#faf9f5] border-b border-[#e5e3dc]">
                        <th class="py-3 px-6 text-xs font-bold text-[#8a8880] uppercase tracking-wider">Tanggal</th>
                        <th class="py-3 px-6 text-xs font-bold text-[#8a8880] uppercase tracking-wider">Transaksi</th>
                        <th class="py-3 px-6 text-xs font-bold text-[#8a8880] uppercase tracking-wider">Produk</th>
                        <th class="py-3 px-6 text-xs font-bold text-[#8a8880] uppercase tracking-wider text-center">Qty</th>
                        <th class="py-3 px-6 text-xs font-bold text-[#8a8880] uppercase tracking-wider">Pemohon</th>
                        <th class="py-3 px-6 text-xs font-bold text-[#8a8880] uppercase tracking-wider">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[#f0ede5]">
                    @if (Transactions == null)
                    {
                        <tr><td colspan="6" class="p-6 text-center text-gray-500">Loading...</td></tr>
                    }
                    else if (!Transactions.Any())
                    {
                        <tr><td colspan="6" class="p-6 text-center text-gray-500">Tidak ada data untuk filter ini.</td></tr>
                    }
                    else
                    {
                        @foreach (var t in Transactions)
                        {
                            <tr class="hover:bg-[#faf9f5]">
                                <td class="py-3 px-6">
                                    <div class="text-sm font-bold text-[#1a1a1a]">@t.created_at.ToString("dd MMM yyyy")</div>
                                    <div class="text-xs text-[#8a8880]">@t.created_at.ToString("HH:mm")</div>
                                </td>
                                <td class="py-3 px-6">
                                    <div class="text-[10px] font-bold text-[#8a8880] uppercase tracking-wider mb-1">
                                        @(t.type == "IN" ? "STOCK IN" : "STOCK OUT")
                                    </div>
                                    @if (!string.IsNullOrEmpty(t.event_name))
                                    {
                                        <div class="text-sm font-bold text-[#1a1a1a]">@t.event_name</div>
                                    }
                                </td>
                                <td class="py-3 px-6">
                                    <div class="text-sm font-bold text-[#1a1a1a]">@(t.Product?.name ?? "-")</div>
                                    <div class="text-xs text-[#8a8880]">@(t.Product?.sku ?? "-")</div>
                                </td>
                                <td class="py-3 px-6 text-sm text-center font-bold text-[#1a1a1a]">
                                    @t.quantity
                                </td>
                                <td class="py-3 px-6">
                                    <div class="text-sm font-bold text-[#1a1a1a]">@(t.Requester?.name ?? "-")</div>
                                    <div class="text-xs text-[#8a8880]">@(t.Division?.name ?? "-")</div>
                                </td>
                                <td class="py-3 px-6">
                                    @if (t.status == "APPROVED")
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-[#eef9f0] text-[#1a7a30] border border-[#b8e8c0]">APPROVED</span>
                                    }
                                    else if (t.status == "PENDING")
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-[#fff8e6] text-[#b37a00] border border-[#ffe099]">PENDING</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-[#fef0f0] text-[#d94040] border border-[#f8c0c0]">@t.status</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (TotalPages > 1)
        {
            <div class="px-6 py-4 border-t border-[#f0ede5] flex justify-between items-center bg-[#faf9f5]">
                <span class="text-xs text-[#8a8880]">Halaman @CurrentPage dari @TotalPages</span>
                <div class="flex gap-2">
                    <button disabled="@(CurrentPage == 1)" @onclick="() => LoadData(CurrentPage - 1)" class="px-3 py-1 bg-white border border-[#e5e3dc] rounded text-sm disabled:opacity-50 hover:bg-gray-50">Prev</button>
                    <button disabled="@(CurrentPage == TotalPages)" @onclick="() => LoadData(CurrentPage + 1)" class="px-3 py-1 bg-white border border-[#e5e3dc] rounded text-sm disabled:opacity-50 hover:bg-gray-50">Next</button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private Dictionary<string, ReportSummaryDto>? Summary;
    private List<Transaction>? Transactions;
    private List<DivisionDto>? Divisions;

    private int CurrentPage = 1;
    private int TotalPages = 1;

    // Filters
    private string SelectedReportType = "peminjaman";
    private DateTime StartDate = DateTime.Now.AddMonths(-1).Date;
    private DateTime EndDate = DateTime.Now.Date;
    private int? DivisionId = null;

    protected override async Task OnInitializedAsync()
    {
        var divResult = await DivisionService.GetDivisionsAsync(1, 100);
        Divisions = divResult.Divisions;
        await LoadSummary();
        await LoadData(1);
    }

    private async Task LoadSummary()
    {
        Summary = await ReportService.GetSummaryAsync(StartDate, EndDate);
    }

    private async Task LoadData(int page)
    {
        CurrentPage = page;
        
        string type = "OUT";
        string? requestType = null;

        if (SelectedReportType == "peminjaman")
        {
            type = "OUT";
            requestType = "BORROW";
        }
        else if (SelectedReportType == "request_barang")
        {
            type = "OUT";
            requestType = "GIVEAWAY";
        }
        else if (SelectedReportType == "adjust_barang")
        {
            type = "IN";
            requestType = null;
        }

        var result = await ReportService.GetReportDataAsync(type, requestType, StartDate, EndDate, DivisionId, null, CurrentPage, 20);
        Transactions = result.Transactions;
        TotalPages = result.TotalPages;
        
        await LoadSummary();
    }
}
