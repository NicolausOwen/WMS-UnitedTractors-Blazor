@page "/MasterData/DamagedGoods"
@using UT_WMSDotnet.Models
@using WMS_UnitedTracors_Blazor.Services
@inject TransactionService TransactionService
@inject IJSRuntime JSRuntime
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Barang Rusak & Hilang</PageTitle>

<div class="ut-page-header">
    <div class="ut-header-content">
        <h1 class="ut-title">Barang Rusak & Hilang</h1>
        <p class="ut-subtitle">Daftar pengembalian barang dengan kondisi rusak atau hilang.</p>
    </div>
</div>

<!-- Filters -->
<div class="ut-filters bg-[#1a1a1a] p-4 rounded-xl border border-[#2a2a2a] mb-6 flex flex-col md:flex-row gap-4 items-end">
    <div class="flex-1 w-full">
        <label class="block text-xs font-bold text-[#8a8780] uppercase tracking-wider mb-2">Pencarian</label>
        <div class="relative">
            <input type="text" @bind="searchTerm" @bind:event="oninput" @onkeyup="HandleSearch" placeholder="Cari nama barang, peminjam, alasan..." 
                   class="w-full pl-9 pr-4 py-2 bg-[#222222] border border-[#333] rounded-lg text-white text-sm focus:border-[#e8a000] focus:ring-1 focus:ring-[#e8a000] outline-none transition-all">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-[#8a8780]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
        </div>
    </div>
</div>

@if (isLoading)
{
    <div class="flex justify-center items-center p-8">
        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-[#e8a000]"></div>
    </div>
}
else if (damagedGoods == null || damagedGoods.Count == 0)
{
    <div class="ut-empty-state text-center py-12 bg-[#1a1a1a] rounded-xl border border-[#2a2a2a]">
        <svg class="w-16 h-16 mx-auto text-[#333] mb-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
            <line x1="12" y1="22.08" x2="12" y2="12"></line>
        </svg>
        <h3 class="text-white font-medium mb-1">Tidak ada data</h3>
        <p class="text-[#8a8780] text-sm">Belum ada pengembalian barang rusak atau hilang.</p>
    </div>
}
else
{
    <div class="ut-table-container bg-[#1a1a1a] rounded-xl border border-[#2a2a2a] overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-[#222222] border-b border-[#333]">
                        <th class="p-4 text-xs font-bold text-[#8a8780] uppercase tracking-wider">Barang</th>
                        <th class="p-4 text-xs font-bold text-[#8a8780] uppercase tracking-wider">Peminjam</th>
                        <th class="p-4 text-xs font-bold text-[#8a8780] uppercase tracking-wider text-center">Qty</th>
                        <th class="p-4 text-xs font-bold text-[#8a8780] uppercase tracking-wider text-center">Status</th>
                        <th class="p-4 text-xs font-bold text-[#8a8780] uppercase tracking-wider">Alasan</th>
                        <th class="p-4 text-xs font-bold text-[#8a8780] uppercase tracking-wider">Tgl Kembali</th>
                        <th class="p-4 text-xs font-bold text-[#8a8780] uppercase tracking-wider text-center">Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[#2a2a2a]">
                    @foreach (var item in damagedGoods)
                    {
                        var status = item.return_status == "rusak" || item.return_status == "hilang" ? item.return_status : item.return_condition;
                        var isLost = status?.ToLower() == "hilang";

                        <tr class="hover:bg-[#222222] transition-colors">
                            <td class="p-4">
                                <div class="font-medium text-white text-sm">@(item.Product?.name ?? "-")</div>
                            </td>
                            <td class="p-4">
                                <div class="text-sm text-gray-300">@(item.applicant_name ?? "-")</div>
                                <div class="text-xs text-[#8a8780]">@(item.applicant_nrp ?? "-")</div>
                            </td>
                            <td class="p-4 text-center">
                                <span class="text-sm text-white font-medium">@(item.returned_quantity > 0 ? item.returned_quantity : item.pending_return_quantity)</span>
                            </td>
                            <td class="p-4 text-center">
                                <span class="px-2 py-1 text-xs font-bold rounded-md @(isLost ? "bg-red-500/10 text-red-500" : "bg-orange-500/10 text-orange-500") uppercase">
                                    @status
                                </span>
                            </td>
                            <td class="p-4">
                                <div class="text-sm text-gray-300 max-w-xs truncate" title="@item.return_reason">
                                    @(string.IsNullOrEmpty(item.return_reason) ? "-" : item.return_reason)
                                </div>
                            </td>
                            <td class="p-4">
                                <div class="text-sm text-gray-300">
                                    @(item.returned_at?.ToString("dd MMM yyyy") ?? "-")
                                </div>
                            </td>
                            <td class="p-4 text-center">
                                @if (!string.IsNullOrEmpty(item.return_photo))
                                {
                                    <button @onclick="() => ShowPhoto(item.return_photo)" class="p-1.5 text-[#8a8780] hover:text-[#e8a000] transition-colors" title="Lihat Foto">
                                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                            <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                            <polyline points="21 15 16 10 5 21"></polyline>
                                        </svg>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            <div class="px-4 py-3 border-t border-[#333] flex items-center justify-between bg-[#1a1a1a]">
                <div class="text-xs text-[#8a8780]">
                    Menampilkan Halaman @currentPage dari @totalPages
                </div>
                <div class="flex gap-1">
                    <button class="px-3 py-1 text-xs font-medium rounded-md @(currentPage == 1 ? "text-gray-500 bg-[#222222] cursor-not-allowed" : "text-white bg-[#333] hover:bg-[#444]")" 
                            @onclick="PrevPage" disabled="@(currentPage == 1)">
                        Prev
                    </button>
                    <button class="px-3 py-1 text-xs font-medium rounded-md @(currentPage == totalPages ? "text-gray-500 bg-[#222222] cursor-not-allowed" : "text-white bg-[#333] hover:bg-[#444]")" 
                            @onclick="NextPage" disabled="@(currentPage == totalPages)">
                        Next
                    </button>
                </div>
            </div>
        }
    </div>
}

@if (showPhotoModal)
{
    <div class="fixed inset-0 z-[999] bg-black/80 flex items-center justify-center p-4 backdrop-blur-sm" @onclick="ClosePhotoModal">
        <div class="bg-[#1a1a1a] rounded-xl border border-[#333] shadow-2xl max-w-2xl w-full overflow-hidden" @onclick:stopPropagation>
            <div class="flex items-center justify-between p-4 border-b border-[#333]">
                <h3 class="text-white font-bold">Foto Pengembalian</h3>
                <button @onclick="ClosePhotoModal" class="text-gray-400 hover:text-white">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
            <div class="p-4 flex justify-center">
                <img src="/@selectedPhotoUrl" alt="Foto Pengembalian" class="max-w-full max-h-[70vh] rounded-lg object-contain" />
            </div>
        </div>
    </div>
}

@code {
    private List<Transaction> damagedGoods = new();
    private bool isLoading = true;
    private string searchTerm = "";
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages = 1;

    private bool showPhotoModal = false;
    private string selectedPhotoUrl = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        
        var result = await TransactionService.GetDamagedGoodsAsync(searchTerm, currentPage, pageSize);
        damagedGoods = result.items;
        totalPages = result.totalPages;
        
        isLoading = false;
    }

    private async Task HandleSearch(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            currentPage = 1;
            await LoadData();
        }
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            await LoadData();
        }
    }

    private async Task PrevPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadData();
        }
    }

    private void ShowPhoto(string url)
    {
        selectedPhotoUrl = url;
        showPhotoModal = true;
    }

    private void ClosePhotoModal()
    {
        showPhotoModal = false;
        selectedPhotoUrl = "";
    }
}
