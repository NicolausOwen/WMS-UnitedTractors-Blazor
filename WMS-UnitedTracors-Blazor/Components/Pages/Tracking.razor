    private async Task SubmitReturn()
    {
        if (ReturnModel.return_quantity <= 0)
        {
            ModalError = "Jumlah pengembalian tidak valid.";
            return;
        }

        if (!IsForceReturn)
        {
            if (SelectedFile == null)
            {
                ModalError = "Foto/PDF bukti pengembalian wajib diunggah.";
                return;
            }

            var validationError = ValidateUpload(SelectedFile);
            if (validationError != null)
            {
                ModalError = validationError;
                return;
            }
        }

        IsSubmitting = true;
        ErrorMessage = null;
        SuccessMessage = null;

        try
        {
            string? err;
            if (IsForceReturn)
            {
                err = await TransactionService.ForceReturnTransactionAsync(
                    ReturnModel.transaction_id, 
                    ReturnModel.return_quantity, 
                    ReturnModel.return_status ?? "baik", 
                    ReturnModel.return_reason, 
                    CurrentUserId);
            }
            else
            {
                ReturnModel.return_photo_browser = SelectedFile;
                // Simpan sebagai DRAFT dulu — bisa diganti/re-upload sebelum di-submit.
                err = await TransactionService.ReturnItemAsync(ReturnModel, asDraft: true);
            }

            if (err == null)
            {
                SuccessMessage = IsForceReturn
                    ? "Pengembalian (force) berhasil diproses."
                    : "Draft pengembalian tersimpan. Periksa lalu klik 'Submit' untuk diajukan ke admin.";
                CloseReturnModal();
                await LoadData();
            }
            else
            {
                ErrorMessage = err;
            }
        }
        finally
        {
            IsSubmitting = false;
        }
    }

