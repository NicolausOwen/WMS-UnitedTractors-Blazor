        {
            HandoverRejectionError = true;
            return;
        }

        if (IsProcessing) return;
        IsProcessing = true;
        try
        {
            string? err;
            if (HandoverRejectTransactionId.HasValue)
            {
                err = await ApprovalService.RejectHandoverItemAsync(HandoverRejectTransactionId.Value, HandoverRejectReason, CurrentUserId, UserRole);
            }
            else
            {
                err = await ApprovalService.RejectHandoverBatchAsync(HandoverRejectGroupId, HandoverRejectReason, CurrentUserId, UserRole);
            }
            if (err == null)
