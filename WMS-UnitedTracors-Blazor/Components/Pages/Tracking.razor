    private static bool IsRevisionStatus(string? status) =>
        status == WorkflowStatuses.Revision ||
        status == WorkflowStatuses.RevisionByStaffInventory ||
        status == WorkflowStatuses.RevisionByAdmin ||
        status == WorkflowStatuses.RevisionByManager;

    private static string GetRevisionActorLabel(Transaction transaction) =>
        transaction.status switch
        {
            WorkflowStatuses.RevisionByStaffInventory => "Staff Inventori",
            WorkflowStatuses.RevisionByManager => "Manager",
            WorkflowStatuses.RevisionByAdmin => "Admin",
            WorkflowStatuses.Revision => transaction.last_revision_stage switch
            {
                "STAFF_INVENTORY" => "Staff Inventori",
                "MANAGER" => "Manager",
                "ADMIN" => "Admin",
                _ => "Admin"
            },
            _ => "Approver"
        };

    private static bool ShouldHideRevisionNoteInNotesColumn(Transaction transaction, string? note, string revisionStatus)
    {
        if (!IsRevisionStatus(transaction.status) || transaction.status != revisionStatus)
            return false;

        return !string.IsNullOrWhiteSpace(note) &&
               string.Equals(note?.Trim(), transaction.rejection_reason?.Trim(), StringComparison.OrdinalIgnoreCase);
    }

    private static bool HasVisibleInternalNotes(Transaction transaction)
    {
        var hasStaffNote = !string.IsNullOrEmpty(transaction.staff_inventory_notes) &&
            !ShouldHideRevisionNoteInNotesColumn(transaction, transaction.staff_inventory_notes, WorkflowStatuses.RevisionByStaffInventory);
        var hasAdminNote = !string.IsNullOrEmpty(transaction.admin_notes) &&
            !ShouldHideRevisionNoteInNotesColumn(transaction, transaction.admin_notes, WorkflowStatuses.RevisionByAdmin);
        var hasManagerNote = !string.IsNullOrEmpty(transaction.manager_notes) &&
            !ShouldHideRevisionNoteInNotesColumn(transaction, transaction.manager_notes, WorkflowStatuses.RevisionByManager);

        return hasStaffNote || hasAdminNote || hasManagerNote;
    }

    private static int GetStatusPriority(string? status)
    {
        if (string.IsNullOrEmpty(status)) return 0;
        return status switch
        {
            "REVISION_BY_STAFF_INVENTORY" => 1,
            "PENDING_STAFF_INVENTORY" => 2,
            "REVISION_BY_ADMIN" => 3,
            "PENDING_ADMIN" => 4,
            "REVISION_BY_MANAGER" => 5,
            "REVISION" => 5,
            "PENDING_MANAGER" => 6,
            "WAITING_HANDOVER" => 7,
            "WAITING_ADMIN_HANDOVER" => 7,
            "WAITING_HANDOVER_CONFIRM" => 7,
            "WAITING_DOCUMENTATION" => 8,
            "DOCUMENTATION_OVERDUE" => 8,
            "APPROVED" => 8,
            "RETURN_DRAFT" => 8,
            "WAITING_RETURN_CONFIRM" => 8,
            "COMPLETED" => 9,
            "REJECTED" => 99,
            _ => 2
        };
    }

    private static Transaction GetEffectiveGroupItem(List<Transaction> groupItems)
    {
        if (!groupItems.Any()) return new Transaction();
        var activeItems = groupItems.Where(i => i.status != "REJECTED").ToList();
        if (!activeItems.Any()) activeItems = groupItems;

        return activeItems.OrderBy(i => GetStatusPriority(i.status)).First();
    }

    private List<TrackingStep> GetGroupSteps(List<Transaction> groupItems)
    {
        var firstItem = GetEffectiveGroupItem(groupItems);
        var steps = new List<TrackingStep>();
        steps.Add(new TrackingStep { Name = "Pengajuan", Status = "DONE", CompletedAt = firstItem.created_at });

        if (firstItem.request_type == "GIVEAWAY")
        {
            if (firstItem.status == "PENDING_STAFF_INVENTORY") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "ACTIVE" });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Approval Manager", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Dokumentasi User", Status = "PENDING" });
            } else if (firstItem.status == "PENDING_ADMIN") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = "ACTIVE" });
                steps.Add(new TrackingStep { Name = "Approval Manager", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Dokumentasi User", Status = "PENDING" });
            } else if (firstItem.status == "PENDING_MANAGER") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Manager", Status = "ACTIVE" });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Dokumentasi User", Status = "PENDING" });
            } else if (firstItem.status == "REVISION" || firstItem.status == "REVISION_BY_STAFF_INVENTORY" || firstItem.status == "REVISION_BY_ADMIN" || firstItem.status == "REVISION_BY_MANAGER") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = firstItem.status == "REVISION_BY_STAFF_INVENTORY" ? "WARNING" : "DONE", CompletedAt = firstItem.status == "REVISION_BY_STAFF_INVENTORY" ? firstItem.updated_at : (firstItem.status == "PENDING_STAFF_INVENTORY" ? null : firstItem.updated_at) });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = firstItem.status == "REVISION_BY_ADMIN" ? "WARNING" : "PENDING", CompletedAt = firstItem.status == "REVISION_BY_ADMIN" ? firstItem.updated_at : null });
                steps.Add(new TrackingStep { Name = "Approval Manager", Status = firstItem.status == "REVISION_BY_MANAGER" ? "WARNING" : "PENDING", CompletedAt = firstItem.status == "REVISION_BY_MANAGER" ? firstItem.updated_at : null });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Dokumentasi User", Status = "PENDING" });
            } else if (firstItem.status == "WAITING_HANDOVER" || firstItem.status == "WAITING_ADMIN_HANDOVER" || firstItem.status == "WAITING_HANDOVER_CONFIRM") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Manager", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "ACTIVE" });
                steps.Add(new TrackingStep { Name = "Dokumentasi User", Status = "PENDING" });
            } else if (firstItem.status == "WAITING_DOCUMENTATION") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Manager", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "DONE", CompletedAt = firstItem.handover_timestamp ?? firstItem.handover_approved_at ?? firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Dokumentasi User", Status = "ACTIVE" });
            } else if (firstItem.status == "DOCUMENTATION_OVERDUE") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Manager", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "DONE", CompletedAt = firstItem.handover_timestamp ?? firstItem.handover_approved_at ?? firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Dokumentasi User", Status = "WARNING" });
            } else if (firstItem.status == "COMPLETED" || firstItem.status == "APPROVED") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Manager", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "DONE", CompletedAt = firstItem.handover_timestamp ?? firstItem.handover_approved_at ?? firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Dokumentasi User", Status = "DONE", CompletedAt = firstItem.documentation_uploaded_at ?? firstItem.updated_at });
            } else if (firstItem.status == "REJECTED") {
                bool isStaffInv = !string.IsNullOrEmpty(firstItem.staff_inventory_notes) ||
                                 (firstItem.staff_inventory_approver_id.HasValue && !firstItem.admin_approver_id.HasValue && !firstItem.manager_approver_id.HasValue) ||
                                 (firstItem.Approver?.role?.Contains("staff") == true && string.IsNullOrEmpty(firstItem.admin_notes) && string.IsNullOrEmpty(firstItem.manager_notes));
                bool isManager = !string.IsNullOrEmpty(firstItem.manager_notes) || firstItem.manager_approver_id.HasValue || (firstItem.Approver?.role?.Contains("manager") == true && firstItem.StaffInventoryApprover != null && firstItem.AdminApprover != null);
                bool isAdmin = !isStaffInv && !isManager;
                
                if (isManager)
                {
                    steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DONE", CompletedAt = firstItem.updated_at });
                    steps.Add(new TrackingStep { Name = "Approval Admin", Status = "DONE", CompletedAt = firstItem.updated_at });
                    steps.Add(new TrackingStep { Name = "Approval Manager", Status = "DANGER", CompletedAt = firstItem.updated_at });
                }
                else if (isAdmin)
                {
                    steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DONE", CompletedAt = firstItem.updated_at });
                    steps.Add(new TrackingStep { Name = "Approval Admin", Status = "DANGER", CompletedAt = firstItem.updated_at });
                    steps.Add(new TrackingStep { Name = "Approval Manager", Status = "PENDING" });
                }
                else
                {
                    steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DANGER", CompletedAt = firstItem.updated_at });
                    steps.Add(new TrackingStep { Name = "Approval Admin", Status = "PENDING" });
                    steps.Add(new TrackingStep { Name = "Approval Manager", Status = "PENDING" });
                }
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Dokumentasi User", Status = "PENDING" });
            }
        }
        else // BORROW
        {
            int totalQty = groupItems.Sum(i => i.quantity ?? 0);
            int totalReturned = groupItems.Sum(i => i.returned_quantity ?? 0);

            if (firstItem.status == "PENDING_STAFF_INVENTORY") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "ACTIVE" });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Masa Peminjaman", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Pengembalian", Status = "PENDING" });
            } else if (firstItem.status == "REVISION_BY_STAFF_INVENTORY") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "WARNING", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Masa Peminjaman", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Pengembalian", Status = "PENDING" });
            } else if (firstItem.status == "PENDING_ADMIN" || firstItem.status == "PENDING") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = "ACTIVE" });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Masa Peminjaman", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Pengembalian", Status = "PENDING" });
            } else if (firstItem.status == "REVISION_BY_ADMIN" || firstItem.status == "REVISION") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = "WARNING", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Masa Peminjaman", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Pengembalian", Status = "PENDING" });
            } else if (firstItem.status == "WAITING_HANDOVER" || firstItem.status == "WAITING_ADMIN_HANDOVER" || firstItem.status == "WAITING_HANDOVER_CONFIRM") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "ACTIVE" });
                steps.Add(new TrackingStep { Name = "Masa Peminjaman", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Pengembalian", Status = "PENDING" });
            } else if (firstItem.status == "APPROVED") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "DONE", CompletedAt = firstItem.handover_timestamp ?? firstItem.handover_approved_at ?? firstItem.updated_at });

                int fullyReturnedItems = groupItems.Count(i => (i.returned_quantity ?? 0) >= (i.quantity ?? 1) && (i.quantity ?? 0) > 0);
                int partiallyReturnedItems = groupItems.Count(i => (i.returned_quantity ?? 0) > 0 && (i.returned_quantity ?? 0) < (i.quantity ?? 1));
                int totalItems = groupItems.Count;
                bool allFullyReturned = totalReturned >= totalQty && totalQty > 0;
                bool anyReturned = totalReturned > 0;
                bool anyPendingReturn = groupItems.Any(i => (i.pending_return_quantity ?? 0) > 0);

                if (allFullyReturned) {
                    steps.Add(new TrackingStep { Name = "Masa Peminjaman", Status = "DONE", CompletedAt = firstItem.returned_at ?? firstItem.updated_at });
                    steps.Add(new TrackingStep {
                        Name = "Pengembalian",
                        Status = "DONE",
                        CompletedAt = firstItem.returned_at ?? firstItem.updated_at,
                        SubLabel = $"Semua {totalReturned}/{totalQty} unit dikembalikan"
                    });
                } else if (anyReturned) {
                    string returnLabel;
                    if (partiallyReturnedItems > 0 && fullyReturnedItems > 0) {
                        returnLabel = $"{fullyReturnedItems} produk selesai, {partiallyReturnedItems} sebagian ({totalReturned}/{totalQty} unit)";
                    } else if (partiallyReturnedItems > 0) {
                        returnLabel = $"Sebagian dikembalikan ({totalReturned}/{totalQty} unit)";
                    } else {
                        returnLabel = $"{fullyReturnedItems}/{totalItems} produk dikembalikan ({totalReturned}/{totalQty} unit)";
                    }
                    steps.Add(new TrackingStep { Name = "Masa Peminjaman", Status = "ACTIVE" });
                    steps.Add(new TrackingStep {
                        Name = "Pengembalian",
                        Status = "ACTIVE",
                        SubLabel = returnLabel
                    });
                } else if (anyPendingReturn) {
                    steps.Add(new TrackingStep { Name = "Masa Peminjaman", Status = "ACTIVE" });
                    steps.Add(new TrackingStep {
                        Name = "Pengembalian",
                        Status = "ACTIVE",
                        SubLabel = "Menunggu konfirmasi pengembalian"
                    });
                } else {
                    steps.Add(new TrackingStep { Name = "Masa Peminjaman", Status = "ACTIVE" });
                    steps.Add(new TrackingStep { Name = "Pengembalian", Status = "PENDING" });
                }
            } else if (firstItem.status == "REJECTED") {
                bool isStaffInv = !string.IsNullOrEmpty(firstItem.staff_inventory_notes) ||
                                 (firstItem.staff_inventory_approver_id.HasValue && !firstItem.admin_approver_id.HasValue && !firstItem.manager_approver_id.HasValue) ||
                                 (firstItem.Approver?.role?.Contains("staff") == true && string.IsNullOrEmpty(firstItem.admin_notes) && string.IsNullOrEmpty(firstItem.manager_notes));
                bool isManager = !string.IsNullOrEmpty(firstItem.manager_notes) || firstItem.manager_approver_id.HasValue || (firstItem.Approver?.role?.Contains("manager") == true && firstItem.StaffInventoryApprover != null && firstItem.AdminApprover != null);
                bool isAdmin = !isStaffInv && !isManager;
                
                if (isAdmin)
                {
                    steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DONE", CompletedAt = firstItem.updated_at });
                    steps.Add(new TrackingStep { Name = "Approval Admin", Status = "DANGER", CompletedAt = firstItem.updated_at });
                }
                else
                {
                    steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DANGER", CompletedAt = firstItem.updated_at });
                    steps.Add(new TrackingStep { Name = "Approval Admin", Status = "PENDING" });
                }
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Masa Peminjaman", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Pengembalian", Status = "PENDING" });
            }
        }

        foreach (var step in steps)
        {
            if (step.Status == "DONE" || step.Status == "WARNING" || step.Status == "DANGER")
            {
                if (step.Name == "Approval Staff Inv")
                    step.ApproverName = firstItem.StaffInventoryApprover?.name ?? (step.Status == "DANGER" ? firstItem.Approver?.name : (firstItem.Approver?.role?.Contains("staff") == true ? firstItem.Approver?.name : null));
                else if (step.Name == "Approval Admin")
                    step.ApproverName = firstItem.AdminApprover?.name ?? (step.Status == "DANGER" ? firstItem.Approver?.name : (firstItem.Approver?.role?.Contains("admin") == true ? firstItem.Approver?.name : null));
                else if (step.Name == "Approval Manager")
                    step.ApproverName = firstItem.ManagerApprover?.name ?? (step.Status == "DANGER" ? firstItem.Approver?.name : (firstItem.Approver?.role?.Contains("manager") == true ? firstItem.Approver?.name : null));
            }
        }

        return steps;
    }
    
    private async Task SubmitHandoverToAdmin(Transaction item)
    {
        if (IsSubmitting) return;
        IsSubmitting = true;
        ErrorMessage = null;
        SuccessMessage = null;
        try
        {
            var err = await TransactionService.SubmitHandoverAsync(new List<int> { item.id });
            if (err == null)
            {
                SuccessMessage = item.request_type == "GIVEAWAY"
                    ? "Serah terima giveaway selesai. Sistem menunggu dokumentasi user."
                    : "Bukti serah terima dikirim ke admin untuk diverifikasi.";
                await LoadData();
            }
            else ErrorMessage = err;
        }
        catch (Exception ex)
        {
            ErrorMessage = "Terjadi kesalahan saat submit serah terima: " + ex.Message;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task ApproveHandoverItem(int transactionId)
    {
        if (IsSubmitting) return;
        IsSubmitting = true;
        ErrorMessage = null;
        SuccessMessage = null;
        try
        {
            var err = await ApprovalService.ApproveHandoverItemAsync(transactionId, CurrentUserId, UserRole);
            if (err == null) SuccessMessage = "Handover approved successfully.";
            else ErrorMessage = err;
            await LoadData();
        }
        catch (Exception ex)
        {
            ErrorMessage = "Terjadi kesalahan saat memproses serah terima: " + ex.Message;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task OpenHandoverItemRejectModal(int id)
    {
        var reason = await JSRuntime.InvokeAsync<string>("prompt", "Masukkan alasan penolakan bukti serah terima:");
        if (string.IsNullOrWhiteSpace(reason)) return;

        IsSubmitting = true;
        ErrorMessage = null;
        SuccessMessage = null;
        try
        {
            var err = await ApprovalService.RejectHandoverItemAsync(id, reason, CurrentUserId, UserRole);
            if (err == null)
            {
                SuccessMessage = "Handover rejected successfully.";
                await LoadData();
            }
            else ErrorMessage = err;
        }
        catch (Exception ex)
        {
            ErrorMessage = "Gagal menolak serah terima: " + ex.Message;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

}
