@inherits LayoutComponentBase

<!-- Google Fonts: DM Sans + Syne + IBM Plex Mono -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=Syne:wght@600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

<div id="auth-root" class="fixed inset-0 z-[9999] overflow-y-auto">
    <div class="h-screen flex flex-col items-center justify-center p-4">
        <div class="w-full sm:max-w-lg">
            <!-- Logo -->
            <div class="flex justify-center mb-6">
                <a href="/">
                    <img src="img/corpu.png" alt="United Tractors" class="ut-logo">
                </a>
            </div>

            <!-- Card -->
            <div class="auth-card px-8 py-8">
                @Body
            </div>

            <!-- Footer -->
            <div class="mt-6 text-center">
                <p class="auth-footer-text">
                    &copy; 2026 United Tractors Corporate University (corpu)
                </p>
            </div>
        </div>
    </div>
</div>

<style>
    /* ── Auth Layout Styles (matching old_laravel guest.blade.php exactly) ── */
    #auth-root {
        font-family: 'DM Sans', sans-serif !important;
        background-color: #faf9f5;
        color: #1a1a1a;
        margin-left: 0 !important; /* Reset sidebar margin */
    }
    #auth-root,
    #auth-root * {
        font-family: 'DM Sans', sans-serif !important;
    }

    .auth-card {
        background: #ffffff;
        border: 1px solid #e5e3dc;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    }

    .ut-input {
        width: 100%;
        padding: 0.6rem 1rem;
        font-size: 0.875rem;
        background: #f5f4f0;
        border: 1.5px solid #e5e3dc;
        border-radius: 10px;
        outline: none;
        transition: all 0.2s;
        color: #1a1a1a;
    }
    .ut-input:focus {
        background: #fff;
        border-color: #e8a000;
        box-shadow: 0 0 0 3px rgba(232, 160, 0, 0.1);
    }

    .ut-label {
        display: block;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #8a8880;
        margin-bottom: 0.5rem;
    }

    .btn-ut-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.6rem 1.5rem;
        background: #e8a000;
        color: #1a1a1a;
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        border-radius: 10px;
        border: none;
        transition: all 0.2s;
        cursor: pointer;
        width: 100%;
    }
    .btn-ut-primary:hover {
        background: #d49300;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(232, 160, 0, 0.2);
    }
    .btn-ut-primary:active {
        transform: translateY(0);
    }

    .auth-link {
        font-size: 0.85rem;
        color: #8a8880;
        text-decoration: none;
        transition: color 0.2s;
    }
    .auth-link:hover {
        color: #e8a000;
    }

    .ut-logo {
        height: 36px;
        width: auto;
    }

    .auth-header {
        text-align: center;
        margin-bottom: 1.5rem;
    }
    .auth-title {
        font-family: 'Syne', sans-serif !important;
        font-size: 1.35rem;
        font-weight: 700;
        color: #1a1a1a;
    }
    .auth-subtitle {
        font-size: 0.875rem;
        color: #8a8880;
        margin-top: 0.5rem;
    }

    .auth-footer-text {
        font-size: 0.7rem;
        color: #a09e99;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        font-weight: 600;
    }
