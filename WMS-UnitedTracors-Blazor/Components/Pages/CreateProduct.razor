@page "/createproduct"
@page "/Product/Create"
@page "/Product-Create"
@using UT_WMSDotnet.ViewModels
@using WMS_UnitedTracors_Blazor.Services
@using UT_WMSDotnet.Models
@inject ProductService ProductService
@inject CategoryService CategoryService
@inject LocationService LocationService
@inject UnitService UnitService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>WMS - Add Product</PageTitle>

<WMS_UnitedTracors_Blazor.Components.Shared.LoadingOverlay IsVisible="IsSubmitting" Message="Menyimpan Produk..." SubMessage="Mohon tunggu sebentar..." />

<header class="bg-transparent">
    <div class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
        <div class="mb-1">
            <h1 class="text-[1.6rem] font-bold text-[#1a1a1a] leading-none tracking-tight">Tambah <span class="text-[#e8a000]">Produk</span></h1>
            <div class="text-[0.72rem] font-medium text-[#a09e99] mt-1">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</div>
        </div>
    </div>
</header>

<div class="py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm">
            <div class="px-6 py-5 border-b border-gray-100 flex items-center gap-4">
                <button @onclick="NavigateBack" class="p-2 bg-white border border-gray-200 rounded-lg text-gray-600 hover:text-gray-900 hover:bg-gray-50 transition shrink-0">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
                </button>
                <div>
                    <h3 class="text-sm font-semibold text-gray-900">Product Details</h3>
                    <p class="text-xs text-gray-500 mt-0.5">Fill in the information below to add a new product. <span class="text-red-500 font-semibold">* Wajib diisi</span></p>
                </div>
            </div>
            <div class="px-6 py-6">
                @if (Categories == null || Locations == null)
                {
                    <div class="p-6 text-center text-gray-500 flex flex-col items-center">
                        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-[#e8a000] mb-4"></div>
                        Loading form...
                    </div>
                }
                else
                {
                    <EditForm Model="Model" OnValidSubmit="HandleSubmit" FormName="CreateProductForm">
                        <AntiforgeryToken />
                        <DataAnnotationsValidator />
                        
                        @if (!string.IsNullOrEmpty(ErrorMessage))
                        {
                            <div class="mb-6 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm" role="alert">
                                @ErrorMessage
                            </div>
                        }

                        <div class="space-y-5">
                            @* SKU *@
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1.5">SKU / Barcode ID</label>
                                <div class="flex gap-2">
                                    <InputText id="skuInput" @bind-Value="Model.sku" class="block w-full py-2 px-3 text-sm bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-[#e8a000] focus:border-[#e8a000] outline-none transition placeholder:text-gray-400" placeholder="UT-YYMMDD-XXXX (Kosongkan untuk otomatis)" />
                                    <button type="button" id="startButton" class="px-4 py-2 bg-gray-900 text-white rounded-lg font-medium text-sm hover:bg-gray-800 transition whitespace-nowrap">
                                        Scan
                                    </button>
                                    <button type="button" id="resetButton" class="hidden px-4 py-2 bg-gray-200 text-gray-800 rounded-lg font-medium text-sm hover:bg-gray-300 transition whitespace-nowrap">
                                        Stop
                                    </button>
                                </div>
                                <p class="text-xs text-gray-400 mt-1">Kosongkan untuk membuat SKU otomatis (Format: UT-YYMMDD-0001) atau scan/ketik SKU custom.</p>
                                <div id="scannerContainer" class="hidden mt-3 relative bg-black w-full rounded-lg overflow-hidden" style="padding-top: 60%;">
                                    <video id="video" autoplay muted playsinline class="absolute top-0 left-0 w-full h-full object-cover"></video>
                                    <div class="absolute inset-0 border-2 border-white/30 m-4 rounded pointer-events-none"></div>
                                </div>
                                <ValidationMessage For="@(() => Model.sku)" class="text-red-600 text-xs mt-1 block" />
                            </div>

                            @* Barcode Type *@
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1.5">Barcode Type <span class="text-red-500">*</span></label>
                                <InputSelect @bind-Value="Model.barcode_type" required class="block w-full py-2 px-3 text-sm bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-[#e8a000] focus:border-[#e8a000] outline-none transition">
                                    <option value="TYPE_CODE_128">Code 128 (Recommended)</option>
                                    <option value="TYPE_CODE_39">Code 39</option>
                                    <option value="TYPE_EAN_13">EAN-13</option>
                                    <option value="TYPE_UPC_A">UPC-A</option>
                                </InputSelect>
                                <ValidationMessage For="@(() => Model.barcode_type)" class="text-red-600 text-xs mt-1 block" />
                            </div>

                            @* Product Name & Point Value *@
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                <div class="md:col-span-2">
                                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Product Name <span class="text-red-500">*</span></label>
                                    <InputText @bind-Value="Model.name" required class="block w-full py-2 px-3 text-sm bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-[#e8a000] focus:border-[#e8a000] outline-none transition" />
                                    <ValidationMessage For="@(() => Model.name)" class="text-red-600 text-xs mt-1 block" />
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Point Value <span class="text-red-500">*</span></label>
                                    <InputNumber @bind-Value="Model.value" min="0" placeholder="0" class="block w-full py-2 px-3 text-sm bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-[#e8a000] focus:border-[#e8a000] outline-none transition" />
                                    <ValidationMessage For="@(() => Model.value)" class="text-red-600 text-xs mt-1 block" />
                                </div>
                            </div>

                            @* Unit *@
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1.5">Unit <span class="text-red-500">*</span></label>
                                @if (ShowNewUnitInput)
                                {
                                    <div class="relative mt-1">
                                        <InputText @bind-Value="Model.unit" placeholder="Type new unit..." class="block w-full py-2 px-3 text-sm bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-[#e8a000] focus:border-[#e8a000] outline-none transition pr-10" />
                                        <button type="button" @onclick="CancelNewUnit" class="absolute inset-y-0 right-0 flex items-center px-3 text-gray-400 hover:text-gray-600 transition" title="Cancel and select existing">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <InputSelect Value="SelectedUnitOption" ValueExpression="() => SelectedUnitOption" ValueChanged="(string val) => HandleUnitSelect(val)" required class="block w-full py-2 px-3 text-sm bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-[#e8a000] focus:border-[#e8a000] outline-none transition">
                                        <option value="">Select unit</option>
                                        @if (Units != null)
                                        {
                                            @foreach(var u in Units)
                                            {
                                                <option value="@u.Name">@u.Name</option>
                                            }
                                        }
                                        <option value="NEW_UNIT_OPTION" class="font-bold text-gray-900 bg-gray-100">+ Type New Unit...</option>
                                    </InputSelect>
                                }
                                <ValidationMessage For="@(() => Model.unit)" class="text-red-600 text-xs mt-1 block" />
                            </div>

                            @* Category & Transaction Type *@
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Category <span class="text-red-500">*</span></label>
                                    <InputSelect @bind-Value="Model.category_id" required class="block w-full py-2 px-3 text-sm bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-[#e8a000] focus:border-[#e8a000] outline-none transition">
                                        <option value="0">Select category (required)</option>
                                        @foreach (var cat in Categories)
                                        {
                                            <option value="@cat.Id">@cat.Name</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="@(() => Model.category_id)" class="text-red-600 text-xs mt-1 block" />
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Transaction Type</label>
                                    <InputSelect @bind-Value="Model.transaction_type" class="block w-full py-2 px-3 text-sm bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-[#e8a000] focus:border-[#e8a000] outline-none transition">
                                        <option value="">Default (Borrow & Request)</option>
                                        <option value="BORROW">Peminjaman (Borrow Only)</option>
                                        <option value="REQUEST">Permintaan (Request Only)</option>
                                    </InputSelect>
                                    <ValidationMessage For="@(() => Model.transaction_type)" class="text-red-600 text-xs mt-1 block" />
                                </div>
                            </div>

                            @* Description *@
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1.5">Product Description</label>
                                <InputTextArea @bind-Value="Model.description" rows="4" placeholder="Tuliskan kondisi, spesifikasi, atau catatan penting barang..." class="block w-full rounded-2xl border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-900 focus:border-[#e8a000] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#e8a000] transition duration-200"></InputTextArea>
                                <ValidationMessage For="@(() => Model.description)" class="text-red-600 text-xs mt-1 block" />
                                <p class="text-xs text-gray-400 mt-2">Deskripsi ini membantu tim approval dan gudang memahami kondisi / catatan barang.</p>
                            </div>

                            @* Is Returnable *@
                            <div>
                                <label class="flex items-center gap-2 cursor-pointer w-max">
                                    <InputCheckbox @bind-Value="Model.is_returnable" class="rounded border-gray-300 text-[#e8a000] focus:ring-[#e8a000] w-4 h-4 transition outline-none" />
                                    <span class="text-sm font-medium text-gray-700">Item is Returnable <span class="text-xs text-gray-500 font-normal">(Hilangkan centang untuk Merchandise/Giveaway)</span></span>
                                </label>
                            </div>

                            @* Location & Position Image *@
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Location</label>
                                    <InputSelect @bind-Value="Model.location_id" class="block w-full py-2 px-3 text-sm bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-[#e8a000] focus:border-[#e8a000] outline-none transition">
                                        <option value="">Select location (optional)</option>
                                        @foreach (var loc in Locations)
                                        {
                                            <option value="@loc.Id">@loc.Name</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="@(() => Model.location_id)" class="text-red-600 text-xs mt-1 block" />
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Position Image</label>
                                    <InputFile OnChange="HandlePositionImageSelected" accept="image/jpg,image/jpeg,image/png,image/webp" class="block w-full text-sm text-gray-500 file:mr-2 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-medium file:bg-gray-100 file:text-gray-700 hover:file:bg-gray-200 transition cursor-pointer" />
                                </div>
                            </div>

                            @* Product Images *@
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1.5">Product Images</label>
                                <InputFile OnChange="HandleImageSelected" multiple accept="image/jpg,image/jpeg,image/png,image/webp" class="block w-full text-sm text-gray-500 file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-gray-100 file:text-gray-700 hover:file:bg-gray-200 transition cursor-pointer" />
                                <p class="text-xs text-gray-400 mt-1">Upload one or multiple product images. JPG, PNG or WebP. Max 10MB each.</p>
                                @if (imagePreviews.Any())
                                {
                                    <div class="mt-3 flex flex-wrap gap-2">
                                        @foreach (var prev in imagePreviews)
                                        {
                                            <div class="w-16 h-16 rounded border border-gray-200 overflow-hidden">
                                                <img src="@prev" class="w-full h-full object-cover" />
                                            </div>
                                        }
                                    </div>
                                }
                            </div>

                            @* Stock Info *@
                            <div class="p-4 bg-gray-50 border border-gray-200 rounded-lg">
                                <p class="text-xs font-medium text-gray-500 mb-2">Stock Information</p>
                                <div class="grid grid-cols-2 gap-4 text-sm">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Initial Stock <span class="text-red-500">*</span></label>
                                        <InputNumber @bind-Value="Model.initial_stock" required min="0" class="block w-full py-2 px-3 text-sm bg-white border border-gray-200 rounded-lg focus:ring-2 focus:ring-[#e8a000] focus:border-[#e8a000] outline-none transition" />
                                        <ValidationMessage For="@(() => Model.initial_stock)" class="text-red-600 text-xs mt-1 block" />
                                    </div>
                                </div>
                            </div>

                            @* Product Variants (Standardized Color Variant Group) *@
                            <div class="pt-4 border-t border-gray-100">
                                <div class="flex justify-between items-center mb-4">
                                    <div>
                                        <h4 class="text-sm font-semibold text-gray-900">Product Variants</h4>
                                        <p class="text-xs text-gray-500 mt-0.5">Tambahkan varian warna, ukuran, dan stok khusus untuk produk ini.</p>
                                    </div>
                                    <button type="button" @onclick="AddColorGroup" class="px-4 py-2 bg-[#e8a000] text-white rounded-lg text-sm font-medium hover:bg-[#d69300] transition shadow-sm cursor-pointer">
                                        + Add Color Variant
                                    </button>
                                </div>
                                
                                <div class="space-y-4">
                                    @foreach (var group in VariantGroups)
                                    {
                                        <div class="p-5 bg-white border border-gray-200 rounded-xl shadow-sm relative">
                                            <div class="flex justify-between items-center mb-4 pb-3 border-b border-gray-100">
                                                <h5 class="text-sm font-bold text-gray-700 uppercase tracking-wider">VARIAN WARNA</h5>
                                                <button type="button" @onclick="() => RemoveColorGroup(group)" class="text-red-500 text-sm font-medium hover:text-red-700 transition cursor-pointer">Hapus Warna</button>
                                            </div>
                                            
                                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                                <!-- Left Column: Color Name and Image -->
                                                <div class="space-y-4">
                                                    <div>
                                                        <label class="block text-sm text-gray-700 mb-1">Nama Warna</label>
                                                        <InputText @bind-Value="group.ColorName" placeholder="Contoh: Hijau / Merah" class="block w-full py-2 px-3 text-sm bg-gray-50 border border-gray-200 rounded-lg focus:ring-2 focus:ring-[#e8a000] focus:border-[#e8a000] outline-none transition bg-white" />
                                                    </div>
                                                    <div>
                                                        <label class="block text-sm text-gray-700 mb-1">Foto Varian Warna</label>
                                                        <div class="flex flex-col gap-3">
                                                            @if (!string.IsNullOrEmpty(group.ImagePreviewUrl))
                                                            {
                                                                <div class="w-20 h-20 rounded-lg border border-gray-200 overflow-hidden shrink-0 bg-white">
                                                                    <img src="@group.ImagePreviewUrl" class="w-full h-full object-cover">
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <div class="w-20 h-20 rounded-lg border border-gray-200 overflow-hidden shrink-0 bg-gray-50 flex items-center justify-center text-gray-300">
                                                                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                                                </div>
                                                            }
                                                            <InputFile OnChange="@(e => HandleGroupImageSelected(e, group))" accept="image/*" class="block w-full text-sm text-gray-500 file:mr-2 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-medium file:bg-gray-100 file:text-gray-700 hover:file:bg-gray-200 transition cursor-pointer" />
                                                        </div>
                                                    </div>
                                                </div>
                                                
                                                <!-- Right Column: Sizes & Stock -->
                                                <div class="min-w-0">
                                                    <label class="block text-sm text-gray-700 mb-3">Ukuran & Stok <span class="text-red-500">*</span></label>
                                                    <div class="space-y-2">
                                                        @foreach (var size in group.Sizes)
                                                        {
                                                            <div class="flex items-center gap-2 sm:gap-3">
                                                                <InputText @bind-Value="size.Size" placeholder="Size (e.g. L, XL, 42)" class="block flex-1 min-w-0 py-2 px-3 text-sm bg-white border border-gray-200 rounded-lg focus:ring-2 focus:ring-[#e8a000] focus:border-[#e8a000] outline-none transition" />
                                                                <InputNumber @bind-Value="size.Stock" min="0" placeholder="Stock" class="block w-24 min-w-0 py-2 px-3 text-sm bg-white border border-gray-200 rounded-lg focus:ring-2 focus:ring-[#e8a000] focus:border-[#e8a000] outline-none transition" />
                                                                <button type="button" @onclick="() => RemoveSize(group, size)" class="text-red-500 hover:text-red-700 transition px-2 shrink-0 cursor-pointer">
                                                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                                                                </button>
                                                            </div>
                                                        }
                                                    </div>
                                                    <button type="button" @onclick="() => AddSize(group)" class="mt-3 text-xs font-semibold text-[#e8a000] hover:text-[#d69300] transition flex items-center gap-1 cursor-pointer">
                                                        + Tambah Ukuran
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="flex justify-end items-center gap-3 border-t border-gray-100 pt-5 mt-6">
                            <button type="button" @onclick="NavigateBack" class="px-4 py-2 bg-white text-gray-700 border border-gray-300 rounded-lg font-medium text-sm hover:bg-gray-50 transition cursor-pointer">
                                Cancel
                            </button>
                            <button type="submit" disabled="@IsSubmitting" class="px-5 py-2.5 bg-[#e8a000] text-white rounded-lg font-medium text-sm hover:bg-[#d69300] transition disabled:opacity-70 flex items-center gap-2 justify-center min-w-[140px] cursor-pointer shadow-sm">
                                <span>Save Product</span>
                            </button>
                        </div>
                    </EditForm>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private ProductCreateViewModel Model = new() { barcode_type = "TYPE_CODE_128" };
    private List<WMS_UnitedTracors_Blazor.Services.CategoryDto>? Categories;
    private List<WMS_UnitedTracors_Blazor.Services.LocationDto>? Locations;
    private List<WMS_UnitedTracors_Blazor.Services.UnitDto>? Units;
    
    private string SelectedUnitOption = "";
    private bool ShowNewUnitInput = false;

    private string? ErrorMessage;
    private bool IsSubmitting;

    private IReadOnlyList<Microsoft.AspNetCore.Components.Forms.IBrowserFile>? selectedImages;
    private List<string> imagePreviews = new();
    private Microsoft.AspNetCore.Components.Forms.IBrowserFile? selectedPositionImage;

    private List<VariantGroupUI> VariantGroups = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity == null || !user.Identity.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        if (!user.HasPermission(WMS_UnitedTracors_Blazor.Helpers.Permissions.ProductsManage))
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        var catResult = await CategoryService.GetCategoriesAsync(1, 100);
        Categories = catResult.Categories;
        
        var locResult = await LocationService.GetLocationsAsync(1, 100);
        Locations = locResult.Locations;

        var unitResult = await UnitService.GetUnitsAsync(1, 100);
        Units = unitResult.Units;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("initProductScanner");
        }
    }

    private void HandleUnitSelect(string val)
    {
        if (val == "NEW_UNIT_OPTION")
        {
            ShowNewUnitInput = true;
            Model.unit = "";
        }
        else
        {
            SelectedUnitOption = val;
            Model.unit = val;
            ShowNewUnitInput = false;
        }
    }

    private void CancelNewUnit()
    {
        ShowNewUnitInput = false;
        Model.unit = "";
        SelectedUnitOption = "";
    }

    private async Task HandleImageSelected(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        selectedImages = e.GetMultipleFiles(10);
        imagePreviews.Clear();
        var tasks = new List<Task>();
        foreach (var file in selectedImages)
        {
            tasks.Add(LoadImagePreviewAsync(file));
        }
        await Task.WhenAll(tasks);
    }

    private async Task LoadImagePreviewAsync(Microsoft.AspNetCore.Components.Forms.IBrowserFile file)
    {
        try
        {
            var format = "image/jpeg";
            var resizedImageFile = await file.RequestImageFileAsync(format, 400, 400);
            using var ms = new System.IO.MemoryStream();
            await resizedImageFile.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).CopyToAsync(ms);
            imagePreviews.Add($"data:{format};base64,{Convert.ToBase64String(ms.ToArray())}");
        }
        catch { }
    }

    private void HandlePositionImageSelected(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        selectedPositionImage = e.File;
    }

    private void AddColorGroup()
    {
        var group = new VariantGroupUI();
        group.Sizes.Add(new VariantSizeUI());
        VariantGroups.Add(group);
    }

    private void RemoveColorGroup(VariantGroupUI group)
    {
        VariantGroups.Remove(group);
    }

    private void AddSize(VariantGroupUI group)
    {
        group.Sizes.Add(new VariantSizeUI());
    }

    private void RemoveSize(VariantGroupUI group, VariantSizeUI size)
    {
        group.Sizes.Remove(size);
    }

    private async Task HandleGroupImageSelected(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e, VariantGroupUI group)
    {
        var format = "image/jpeg";
        var resizedForUpload = await e.File.RequestImageFileAsync(format, 1024, 1024);
        group.ImageFile = resizedForUpload;
        
        var resizedForPreview = await e.File.RequestImageFileAsync(format, 100, 100);
        using var ms = new System.IO.MemoryStream();
        await resizedForPreview.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).CopyToAsync(ms);
        group.ImagePreviewUrl = $"data:{format};base64,{Convert.ToBase64String(ms.ToArray())}";
    }

    private async Task HandleSubmit()
    {
        if (Model.category_id == 0)
        {
            ErrorMessage = "Mohon pilih kategori produk.";
            return;
        }
        if (string.IsNullOrWhiteSpace(Model.unit))
        {
            ErrorMessage = "Mohon tentukan satuan/unit produk.";
            return;
        }

        IsSubmitting = true;
        ErrorMessage = null;
        StateHasChanged();

        if (selectedImages != null && selectedImages.Any())
        {
            Model.images.Clear();
            foreach (var imgFile in selectedImages)
            {
                var format = "image/jpeg";
                var compressedImage = await imgFile.RequestImageFileAsync(format, 1024, 1024);
                var ms = new System.IO.MemoryStream();
                await compressedImage.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).CopyToAsync(ms);
                ms.Position = 0;
                Model.images.Add(new Microsoft.AspNetCore.Http.FormFile(ms, 0, compressedImage.Size, "images", imgFile.Name)
                {
                    Headers = new Microsoft.AspNetCore.Http.HeaderDictionary(),
                    ContentType = format
                });
            }
        }

        if (selectedPositionImage != null)
        {
            var format = "image/jpeg";
            var compressedImage = await selectedPositionImage.RequestImageFileAsync(format, 1024, 1024);
            var ms = new System.IO.MemoryStream();
            await compressedImage.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).CopyToAsync(ms);
            ms.Position = 0;
            Model.position_image = new Microsoft.AspNetCore.Http.FormFile(ms, 0, compressedImage.Size, "position_image", selectedPositionImage.Name)
            {
                Headers = new Microsoft.AspNetCore.Http.HeaderDictionary(),
                ContentType = format
            };
        }

        // Standardized variant mapping
        Model.variants.Clear();
        foreach (var group in VariantGroups)
        {
            foreach (var size in group.Sizes)
            {
                Model.variants.Add(new ProductVariantViewModel
                {
                    color = group.ColorName,
                    size = size.Size,
                    stock = size.Stock,
                    image = group.ImageFile,
                    image_preview_url = group.ImagePreviewUrl
                });
            }
        }

        var result = await ProductService.CreateProductAsync(Model);
        
        IsSubmitting = false;

        if (result == null)
        {
            NavigationManager.NavigateTo("/Product?success=created");
        }
        else
        {
            ErrorMessage = result;
        }
    }

    private async Task NavigateBack()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("history.back");
        }
        catch
        {
            NavigationManager.NavigateTo("/Product");
        }
    }

    public class VariantGroupUI
    {
        public string ColorName { get; set; } = "";
        public Microsoft.AspNetCore.Components.Forms.IBrowserFile? ImageFile { get; set; }
        public string? ImagePreviewUrl { get; set; }
        public List<VariantSizeUI> Sizes { get; set; } = new();
    }

    public class VariantSizeUI
    {
        public string Size { get; set; } = "";
        public int Stock { get; set; }
    }
}
