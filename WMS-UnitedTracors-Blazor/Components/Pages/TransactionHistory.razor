@page "/TransactionHistory"
@page "/Transactions/History"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using UT_WMSDotnet.Models
@using WMS_UnitedTracors_Blazor.Services
@inject TransactionService TransactionService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Transaction History</PageTitle>

<div class="py-12 bg-[#f5f4f0] min-h-screen">
    <div class="max-w-7xl mx-auto sm:px-6 lg:px-8">
        
        <h2 class="font-semibold text-xl text-gray-800 leading-tight mb-6">
            Stock History
        </h2>

        <div class="bg-white overflow-hidden shadow-sm sm:rounded-lg border border-gray-100 mb-6">
            <div class="p-6 text-gray-900">
                <div class="flex flex-wrap items-end gap-4">
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1">Start Date</label>
                        <input type="date" @bind="StartDate" class="rounded-md border-gray-300 shadow-sm focus:border-[#e8a000] focus:ring-[#e8a000] sm:text-sm">
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1">End Date</label>
                        <input type="date" @bind="EndDate" class="rounded-md border-gray-300 shadow-sm focus:border-[#e8a000] focus:ring-[#e8a000] sm:text-sm">
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1">Filter Type</label>
                        <select @bind="FilterType" class="rounded-md border-gray-300 shadow-sm focus:border-[#e8a000] focus:ring-[#e8a000] sm:text-sm">
                            <option value="">All Types</option>
                            <option value="IN">STOCK IN</option>
                            <option value="OUT">STOCK OUT</option>
                        </select>
                    </div>
                    <div>
                        <button type="button" @onclick="() => LoadData(1)" class="px-4 py-2.5 bg-[#1a1a1a] text-white text-sm font-semibold rounded-md shadow-sm hover:bg-gray-800 transition">Apply Filters</button>
                        <button type="button" @onclick="ResetFilters" class="ml-2 px-4 py-2.5 bg-white border border-gray-300 text-gray-700 text-sm font-semibold rounded-md shadow-sm hover:bg-gray-50 transition">Reset</button>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="mb-4 flex items-center gap-3 bg-[#eef9f0] border border-[#b8e8c0] text-[#1a7a30] px-4 py-3 rounded-lg text-sm font-semibold">
                <svg class="w-4 h-4 shrink-0 text-[#1a7a30]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                @SuccessMessage
            </div>
        }
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="mb-4 flex items-center gap-3 bg-[#fef0f0] border border-[#f8c0c0] text-[#d94040] px-4 py-3 rounded-lg text-sm font-semibold">
                <svg class="w-4 h-4 shrink-0 text-[#d94040]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                @ErrorMessage
            </div>
        }

        @if (Transactions == null || !Transactions.Any())
        {
            <div class="bg-white p-12 rounded-lg border border-gray-200 text-center shadow-sm">
                <svg class="w-12 h-12 text-gray-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
                <p class="text-sm font-medium text-gray-500">No transaction history found.</p>
                <p class="text-xs text-gray-400 mt-1">Try adjusting your filters or date range.</p>
            </div>
        }
        else
        {
            <div class="space-y-4">
                @foreach (var group in GroupedTransactions)
                {
                    var items = group.Value;
                    var firstItem = items.First();
                    bool isExpanded = ExpandedGroups.Contains(group.Key);
                    
                    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                        <!-- Accordion Header -->
                        <div @onclick="() => ToggleGroup(group.Key)" class="flex items-center justify-between p-5 cursor-pointer hover:bg-gray-50 transition select-none">
                            <div>
                                <div class="flex items-center gap-3 mb-1">
                                    <span class="text-xs font-bold px-2 py-0.5 rounded-full @(firstItem.type == "IN" ? "bg-blue-100 text-blue-700" : "bg-purple-100 text-purple-700")">
                                        @(firstItem.type == "IN" ? "STOCK IN" : "STOCK OUT")
                                    </span>
                                    <span class="text-sm font-bold text-gray-900">
                                        @(firstItem.created_at.ToString("dd MMM yyyy, HH:mm"))
                                    </span>
                                </div>
                                <div class="text-xs text-gray-500 font-medium">
                                    Submitted by: <span class="text-gray-700">@(firstItem.Requester?.name)</span>
                                    @if (firstItem.type == "OUT" && !string.IsNullOrEmpty(firstItem.event_name)) {
                                        <span class="mx-1">•</span> <span>Event: <span class="text-gray-700">@firstItem.event_name</span></span>
                                    }
                                </div>
                            </div>
                            <div class="text-gray-400">
                                <svg class="w-5 h-5 transform transition-transform duration-200 @(isExpanded ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                            </div>
                        </div>

                        <!-- Accordion Content -->
                        @if (isExpanded)
                        {
                            <div class="border-t border-gray-200">
                                @if (firstItem.type == "OUT") {
                                <div class="p-4 bg-white border-b border-gray-100">
                                    <h4 class="text-[0.65rem] font-bold uppercase tracking-wider text-gray-400 mb-3">Form Details</h4>
                                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                                        <div>
                                            <div class="text-[0.65rem] text-gray-500 font-bold uppercase tracking-wider mb-1">Applicant</div>
                                            <div class="text-sm font-medium text-gray-900">@(firstItem.applicant_name ?? "-")</div>
                                            <div class="text-xs text-gray-500">NRP: @(firstItem.applicant_nrp ?? "-")</div>
                                        </div>
                                        <div>
                                            <div class="text-[0.65rem] text-gray-500 font-bold uppercase tracking-wider mb-1">Event / Program</div>
                                            <div class="text-sm font-medium text-gray-900">@(firstItem.event_name ?? "-")</div>
                                            <div class="text-xs text-gray-500">@(firstItem.event_date?.ToString("MMM dd, yyyy") ?? "-")</div>
                                        </div>
                                        <div>
                                            <div class="text-[0.65rem] text-gray-500 font-bold uppercase tracking-wider mb-1">Division</div>
                                            <div class="text-sm font-medium text-gray-900">@(firstItem.Division?.name ?? "-")</div>
                                        </div>
                                        <div>
                                            <div class="text-[0.65rem] text-gray-500 font-bold uppercase tracking-wider mb-1">Documentation</div>
                                            <div class="text-sm font-medium text-[#e8a000]">
                                                @if (!string.IsNullOrEmpty(firstItem.documentation_link)) {
                                                    <a href="@firstItem.documentation_link" target="_blank" class="hover:underline flex items-center gap-1">
                                                        Link
                                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                                                    </a>
                                                } else {
                                                    <span>-</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                }

                                <!-- Item List -->
                                <div class="bg-gray-50 p-4">
                                    <h4 class="text-[0.65rem] font-bold uppercase tracking-wider text-gray-400 mb-3">Items Requested</h4>
                                    <div class="overflow-x-auto">
                                        <table class="w-full text-left">
                                            <thead>
                                                <tr class="border-b border-gray-200">
                                                    <th class="pb-2 text-[0.65rem] font-bold text-gray-500 uppercase tracking-wider">Product</th>
                                                    <th class="pb-2 text-[0.65rem] font-bold text-gray-500 uppercase tracking-wider text-center">Qty</th>
                                                    <th class="pb-2 text-[0.65rem] font-bold text-gray-500 uppercase tracking-wider">Status</th>
                                                    <th class="pb-2 text-[0.65rem] font-bold text-gray-500 uppercase tracking-wider">Return Status</th>
                                                    <th class="pb-2 text-[0.65rem] font-bold text-gray-500 uppercase tracking-wider text-right">Notes</th>
                                                </tr>
                                            </thead>
                                            <tbody class="divide-y divide-gray-100">
                                                @foreach (var item in items) {
                                                <tr class="bg-white">
                                                    <td class="py-3 px-3">
                                                        <div class="flex items-center gap-3">
                                                            @if (!string.IsNullOrEmpty(item.Product?.image)) {
                                                                <img src="@(item.Product.image.StartsWith("images/") ? $"/{item.Product.image}" : $"/storage/{item.Product.image}")" class="w-8 h-8 rounded object-cover border border-gray-200" />
                                                            }
                                                            <div>
                                                                <div class="text-sm font-semibold text-gray-900">@(item.Product?.name)</div>
                                                                <div class="text-[10px] text-gray-500">@(item.Product?.sku)</div>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td class="py-3 px-3 text-center">
                                                        <div class="text-sm font-bold text-gray-900">@(item.quantity)</div>
                                                    </td>
                                                    <td class="py-3 px-3">
                                                        @if (item.status == "PENDING") {
                                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-[#fef3c7] text-[#92400e] border border-[#fde68a]">PENDING</span>
                                                        } else if (item.status == "APPROVED") {
                                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-[#eef9f0] text-[#1a7a30] border border-[#b8e8c0]">APPROVED</span>
                                                            <div class="text-[10px] text-gray-500 mt-1">By @(item.Approver?.name)</div>
                                                        } else if (item.status == "REVISION") {
                                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-[#e0e7ff] text-[#4338ca] border border-[#c7d2fe]">REVISION</span>
                                                            @if (!string.IsNullOrEmpty(item.rejection_reason)) {
                                                                <div class="text-[10px] text-[#4338ca] mt-1 italic">"@item.rejection_reason"</div>
                                                            }
                                                        } else {
                                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-[#fef0f0] text-[#d94040] border border-[#f8c0c0]">REJECTED</span>
                                                            @if (!string.IsNullOrEmpty(item.rejection_reason)) {
                                                                <div class="text-[10px] text-red-500 mt-1 italic">"@item.rejection_reason"</div>
                                                            }
                                                        }
                                                    </td>
                                                    <td class="py-3 px-3">
                                                        @if (item.type == "OUT" && item.status == "APPROVED") {
                                                            if (item.request_type == "GIVEAWAY") {
                                                                <span class="text-xs font-semibold text-[#8a8880] italic">Given Away (No return)</span>
                                                            } else {
                                                                int remaining = (item.quantity ?? 0) - (item.returned_quantity ?? 0);
                                                                if (remaining <= 0) {
                                                                    <span class="inline-flex items-center gap-1 text-xs font-bold text-[#1a7a30]">
                                                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                                                        Returned Fully
                                                                    </span>
                                                                } else {
                                                                    <span class="text-xs font-semibold text-gray-600">
                                                                        Returned: @(item.returned_quantity)/@(item.quantity)
                                                                    </span>
                                                                    if (item.is_return_draft != 0 && item.pending_return_quantity > 0) {
                                                                        <div class="text-[10px] font-bold text-orange-600 mt-1">Pending approval: @item.pending_return_quantity</div>
                                                                    }
                                                                }
                                                            }
                                                        } else {
                                                            <span class="text-gray-300 text-xs">-</span>
                                                        }
                                                    </td>
                                                    <td class="py-3 px-3 text-right text-xs text-gray-500">
                                                        @(item.notes ?? "-")
                                                    </td>
                                                </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (TotalPages > 1)
            {
                <div class="mt-4 shadow-sm border border-[#e5e3dc] rounded-xl overflow-hidden bg-white flex items-center justify-between px-6 py-4">
                    <span class="text-sm text-gray-500 font-medium">Showing page @CurrentPage of @TotalPages</span>
                    <div class="flex gap-2">
                        <button disabled="@(CurrentPage == 1)" @onclick="() => LoadData(CurrentPage - 1)" class="px-3 py-1.5 border border-[#e5e3dc] rounded-md text-sm font-semibold hover:bg-gray-50 disabled:opacity-50 transition">Previous</button>
                        <button disabled="@(CurrentPage == TotalPages)" @onclick="() => LoadData(CurrentPage + 1)" class="px-3 py-1.5 border border-[#e5e3dc] rounded-md text-sm font-semibold hover:bg-gray-50 disabled:opacity-50 transition">Next</button>
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    private List<Transaction>? Transactions;
    private Dictionary<string, List<Transaction>> GroupedTransactions = new();
    private HashSet<string> ExpandedGroups = new();
    
    private int CurrentPage = 1;
    private int PageSize = 10;
    private int TotalPages = 1;
    private int TotalItems = 0;

    private string? FilterType;
    private DateTime? StartDate;
    private DateTime? EndDate;

    private int CurrentUserId = 0;
    private string? UserRole;
    
    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            var idClaim = user.FindFirst(ClaimTypes.NameIdentifier);
            if (idClaim != null && int.TryParse(idClaim.Value, out int id))
            {
                CurrentUserId = id;
            }
            UserRole = user.FindFirst(ClaimTypes.Role)?.Value;
        }

        await LoadData(1);
    }

    private async Task LoadData(int page)
    {
        CurrentPage = page;
        var result = await TransactionService.GetHistoryAsync(CurrentUserId, UserRole, FilterType, StartDate, EndDate, CurrentPage, PageSize);
        
        Transactions = result.Transactions;
        TotalItems = result.TotalItems;
        TotalPages = result.TotalPages;

        if (Transactions != null)
        {
            GroupedTransactions = Transactions
                .GroupBy(t => t.type == "OUT" ? TransactionService.CreateGroupId(t.created_at, t.requester_id, t.applicant_name ?? string.Empty) : t.id.ToString())
                .ToDictionary(g => g.Key, g => g.ToList());
        }
    }

    private void ToggleGroup(string groupId)
    {
        if (ExpandedGroups.Contains(groupId))
        {
            ExpandedGroups.Remove(groupId);
        }
        else
        {
            ExpandedGroups.Add(groupId);
        }
    }
    
    private async Task ResetFilters()
    {
        FilterType = null;
        StartDate = null;
        EndDate = null;
        await LoadData(1);
    }
}
