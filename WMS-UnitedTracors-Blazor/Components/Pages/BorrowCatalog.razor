@page "/Catalog/Borrow"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using UT_WMSDotnet.Models
@using WMS_UnitedTracors_Blazor.Services
@implements IDisposable
@inject ProductService ProductService
@inject DashboardStateService DashboardState
@inject CartService CartService
@inject TransactionService TransactionService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<style>
    @@media (max-width: 545px) {
        .custom-mobile-header {
            flex-direction: column-reverse !important;
            align-items: stretch !important;
        }
        .custom-mobile-search-container {
            width: 100% !important;
        }
        .custom-mobile-search-input {
            width: 100% !important;
        }
    }
</style>

<PageTitle>WMS - Borrow Catalog</PageTitle>

<WMS_UnitedTracors_Blazor.Components.Shared.LoadingOverlay IsVisible="IsLoadingData" Message="Memuat Katalog Barang..." SubMessage="Mohon tunggu sebentar..." />

<div class="w-full min-h-screen px-4 md:px-10 py-6 pb-28 md:pb-12 font-sans">

    <div class="mb-6">
        <h1 class="text-2xl font-bold text-[#1a1a1a]">Borrow Catalog</h1>
        <p class="text-sm text-[#8a8880] mt-1">Items available for borrowing and return</p>
    </div>

    <div class="sticky top-[60px] md:top-0 bg-[#f5f4f0] py-3 -mx-4 px-4 md:-mx-10 md:px-10 border-b border-[#e5e3dc] flex flex-row items-center justify-between gap-3 mb-6 transition-all duration-200 custom-mobile-header" style="z-index: 40;">
        <div class="flex items-center gap-2 overflow-x-auto pb-1 sm:pb-0 flex-1 min-w-0 [&::-webkit-scrollbar]:hidden"
             style="scrollbar-width: none;">
            <button @onclick="() => FilterByCategory(null)"
                    class="px-3.5 py-1 bg-white border border-[#e5e3dc] hover:border-[#1a1a1a] text-xs font-semibold text-[#5a5855] hover:text-[#1a1a1a] rounded-full transition cursor-pointer shrink-0 @(!SelectedCategoryId.HasValue ? "!bg-[#1a1a1a] !border-[#1a1a1a] !text-white" : "")">
                Semua
            </button>
            @if (Categories != null && Categories.Any())
            {
                @foreach (var cat in Categories)
                {
                    <button @onclick="() => FilterByCategory(cat.id)"
                            class="px-3.5 py-1 bg-white border border-[#e5e3dc] hover:border-[#1a1a1a] text-xs font-semibold text-[#5a5855] hover:text-[#1a1a1a] rounded-full transition cursor-pointer shrink-0 @(SelectedCategoryId == cat.id ? "!bg-[#1a1a1a] !border-[#1a1a1a] !text-white" : "")">
                        @cat.name
                    </button>
                }
            }
        </div>
        <div class="flex items-center gap-2 custom-mobile-search-container">
            <!-- Header Cart Button (Desktop Only) -->
            <button type="button" @onclick="CartService.ShowCart" class="hidden md:flex items-center justify-center w-[38px] h-[38px] rounded-full bg-[#e8a000] hover:bg-[#d49300] border border-[#d49300]/20 text-[#1a1a1a] transition-all shadow-sm cursor-pointer relative shrink-0" title="Keranjang" aria-label="Buka Keranjang">
                <svg class="w-5 h-5 text-[#1a1a1a]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
                </svg>
                @if (CartService.Items != null && CartService.Items.Any())
                {
                    <span class="absolute -top-1 -right-1 inline-flex items-center justify-center min-w-[1.25rem] h-[1.25rem] px-1 bg-[#d94040] text-white text-[0.62rem] font-bold rounded-full shadow-sm border border-white">
                        @CartService.Items.Sum(i => i.Quantity)
                    </span>
                }
            </button>
            <div class="w-44 sm:w-60 md:w-72 shrink-0 relative custom-mobile-search-input">
                <input type="text" value="@SearchQuery" @oninput="OnSearchInput" placeholder="Cari nama barang atau SKU..."
                       class="w-full pl-10 pr-4 py-2 bg-[#f9f8f6] border border-[#e5e3dc] rounded-full text-sm font-semibold text-[#5a5855] focus:outline-none focus:ring-2 focus:ring-[#3b82f6] focus:bg-white transition-all shadow-sm" />
                <svg class="w-4 h-4 text-[#8a8880] absolute left-3.5 top-1/2 -translate-y-1/2" fill="none"
                     stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
            </div>
        </div>
    </div>

    <div class="bg-white border border-[#e5e3dc] rounded-xl overflow-hidden shadow-sm">

        @if (Products == null)
        {
            <div class="px-6 py-16 text-center text-[#8a8880]">Loading...</div>
        }
        else if (!Products.Any())
        {
            <div class="px-6 py-16 text-center">
                <p class="text-sm text-[#8a8880]">Tidak ada barang pinjaman yang ditemukan.</p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 md:gap-4 p-3 md:p-4">
                @foreach (var product in Products)
                {
                    <div @onclick="() => OpenProductModal(product)"
                         class="bg-white border border-[#e5e3dc] rounded-xl overflow-hidden shadow-sm hover:shadow-lg hover:-translate-y-1 hover:border-[#3b82f6] transition-all duration-300 flex flex-col group cursor-pointer">
                        <div
                            class="aspect-square relative bg-[#f5f4f0] flex items-center justify-center overflow-hidden border-b border-[#f0ede5]">
                            <img src="@GetProductImage(product)" alt="@product.name"
                                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                 onerror="this.onerror=null;this.src='https://placehold.co/600x400?text=No+Picture';">
                            @if (product.current_stock <= 0)
                            {
                                <div class="absolute top-2 left-2">
                                    <span
                                    class="px-2 py-0.5 bg-[#fef0f0] border border-[#f8c0c0] text-[#d94040] text-[0.6rem] font-bold rounded shadow-sm tracking-wider uppercase">Habis</span>
                                </div>
                            }
                        </div>
                        <div class="p-2.5 md:p-3.5 flex flex-col flex-grow">
                            <div class="flex items-center justify-between gap-1 mb-1.5">
                                <span
                                    class="text-[0.65rem] font-bold text-[#8a8880] truncate group-hover:text-blue-500 transition-colors">
                                    @(product.Category?.name ?? "--")
                                </span>
                                <code
                                class="text-[0.55rem] text-[#8a8880] bg-[#f0ede5] px-1.5 py-0.5 rounded">@product.sku</code>
                            </div>
                            <h4 class="text-sm md:text-base font-normal text-[#1a1a1a] leading-snug line-clamp-3 md:line-clamp-4 mb-2 md:mb-3 flex-grow group-hover:text-blue-600 transition-colors"
                                title="@product.name">
                                @product.name
                            </h4>
                            <div class="mt-auto border-t border-transparent pt-1 flex justify-end">
                                <span
                                    class="font-bold @(product.current_stock <= 0 ? "text-[#d94040]" : "text-[#1a7a30]") text-sm">
                                    @product.current_stock <span
                                    class="font-normal text-[0.65rem] text-[#8a8880]">@(product.Unit?.name ?? "unit")</span>
                                </span>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (TotalPages > 1)
            {
                <div class="px-6 py-4 border-t border-[#f0ede5] bg-[#faf9f6] flex flex-col sm:flex-row items-center justify-between gap-4">
                    <div class="text-xs text-[#8a8880] font-medium text-center sm:text-left">
                        Menampilkan <span class="font-bold text-[#1a1a1a]">@((CurrentPage - 1) * PageSize + 1)</span> - <span class="font-bold text-[#1a1a1a]">@(Math.Min(CurrentPage * PageSize, TotalItems))</span> dari <span class="font-bold text-[#1a1a1a]">@TotalItems</span> barang
                    </div>
                    <div class="flex items-center gap-1 bg-white p-1.5 rounded-xl border border-[#e5e3dc] shadow-sm">
                        <button type="button" @onclick="() => LoadProducts(1)" disabled="@(CurrentPage == 1)" title="Halaman Pertama"
                                class="w-8 h-8 flex items-center justify-center rounded-lg text-[#5a5855] hover:bg-[#f5f4f0] disabled:opacity-30 disabled:hover:bg-transparent transition-all cursor-pointer">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7" />
                            </svg>
                        </button>
                        <button type="button" @onclick="() => LoadProducts(CurrentPage - 1)" disabled="@(CurrentPage == 1)" title="Halaman Sebelumnya"
                                class="w-8 h-8 flex items-center justify-center rounded-lg text-[#5a5855] hover:bg-[#f5f4f0] disabled:opacity-30 disabled:hover:bg-transparent transition-all cursor-pointer">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                            </svg>
                        </button>
                        @foreach (var pageNum in GetPageNumbers())
                        {
                            if (pageNum.HasValue)
                            {
                                int p = pageNum.Value;
                                <button type="button" @onclick="() => LoadProducts(p)"
                                        class="w-8 h-8 flex items-center justify-center rounded-lg text-xs font-bold transition-all cursor-pointer @(CurrentPage == p ? "bg-[#1a1a1a] text-white shadow-sm" : "text-[#5a5855] hover:bg-[#f5f4f0]")">
                                    @p
                                </button>
                            }
                            else
                            {
                                <span class="w-8 h-8 flex items-center justify-center text-xs font-bold text-[#8a8880] select-none">...</span>
                            }
                        }
                        <button type="button" @onclick="() => LoadProducts(CurrentPage + 1)" disabled="@(CurrentPage == TotalPages)" title="Halaman Selanjutnya"
                                class="w-8 h-8 flex items-center justify-center rounded-lg text-[#5a5855] hover:bg-[#f5f4f0] disabled:opacity-30 disabled:hover:bg-transparent transition-all cursor-pointer">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                        </button>
                        <button type="button" @onclick="() => LoadProducts(TotalPages)" disabled="@(CurrentPage == TotalPages)" title="Halaman Terakhir"
                                class="w-8 h-8 flex items-center justify-center rounded-lg text-[#5a5855] hover:bg-[#f5f4f0] disabled:opacity-30 disabled:hover:bg-transparent transition-all cursor-pointer">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7m-8-14l7 7-7 7" />
                            </svg>
                        </button>
                    </div>
                </div>
            }
        }
    </div>
</div>

@* Product Detail Modal *@
@if (ShowProductModal && SelectedProduct != null)
{
    <div class="fixed inset-0 z-[300] flex" role="dialog" aria-modal="true">
        <div class="fixed inset-0 backdrop-blur-sm bg-[#1a1a1a]/65" @onclick="CloseProductModal"></div>
        <div class="fixed inset-0 z-10 overflow-y-auto flex items-center justify-center p-3 md:p-4"
             @onclick="CloseProductModal">
            <div class="relative transform rounded-2xl md:rounded-xl bg-white text-left shadow-2xl w-full max-w-5xl border-t md:border border-[#e5e3dc] flex flex-col max-h-[95vh] md:max-h-[85vh]"
                 @onclick:stopPropagation="true">
                <div
                    class="px-4 md:px-5 py-3 md:py-4 border-b border-[#f0ede5] flex items-center justify-between bg-white z-10 shrink-0 rounded-t-2xl md:rounded-t-xl">
                    <h3 class="font-bold text-[#1a1a1a] text-sm">Detail Produk</h3>
                    <div class="flex items-center gap-2">
                        <button type="button" @onclick="() => HistoryModalRef?.Open(SelectedProduct!)"
                                class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-[#f5f4f0] hover:bg-[#e8e5df] border border-[#e5e3dc] text-[#5a5855] text-[11px] font-semibold rounded-lg transition">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                            Riwayat Peminjam
                        </button>
                        <button type="button" @onclick="CloseProductModal"
                                class="text-[#a09e99] hover:text-[#1a1a1a] transition p-1 bg-[#f5f4f0] rounded-full">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>
                    </div>
                </div>
                <div class="px-4 md:px-5 py-4 pb-6 md:pb-4 overflow-y-auto md:overflow-visible flex-1 min-h-0 md:min-h-auto">
                    @if (!string.IsNullOrEmpty(ModalError))
                    {
                        <div
                            class="mb-4 flex items-center gap-2 bg-[#fef0f0] border border-[#f8c0c0] text-[#d94040] px-4 py-3 rounded-lg text-sm font-semibold">
                            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                            </svg>
                            @ModalError
                        </div>
                    }
                    <div class="grid grid-cols-1 lg:grid-cols-[0.85fr_1.15fr] gap-3 md:gap-5">
                        <div class="space-y-2 md:space-y-4">
                            <div class="relative w-full aspect-square bg-[#f5f4f0] rounded-xl overflow-hidden border border-[#e5e3dc] cursor-crosshair"
                                 onmousemove="const r=this.getBoundingClientRect();const x=(event.clientX-r.left)/r.width*100;const y=(event.clientY-r.top)/r.height*100;const i=this.querySelector('img');i.style.transformOrigin=`${x}% ${y}%`;i.style.transform='scale(2)';"
                                 onmouseleave="const i=this.querySelector('img');i.style.transformOrigin='center';i.style.transform='scale(1)';">
                                <img src="@GetImageUrl(SelectedMainImage)"
                                     class="w-full h-full object-cover transition-transform duration-200"
                                     onerror="this.onerror=null;this.src='https://placehold.co/600x400?text=No+Picture';">
                            </div>
                            @if (ModalImages.Count > 1)
                            {
                                <div class="flex gap-2 overflow-x-auto pb-2">
                                    @foreach (var img in ModalImages)
                                    {
                                        <button type="button" @onclick="() => SelectedMainImage = img"
                                                class="relative w-12 h-12 md:w-16 md:h-16 rounded-lg overflow-hidden shrink-0 border-2 transition-colors @(SelectedMainImage == img ? "border-[#3b82f6]" : "border-transparent opacity-70 hover:opacity-100")">
                                            <img src="@GetImageUrl(img)" class="w-full h-full object-cover" />
                                        </button>
                                    }
                                </div>
                            }
                            </div>

                            <div class="flex flex-col gap-3 md:gap-4">
                                <div>
                                    <h4 class="text-base font-normal text-[#1a1a1a] leading-tight mb-1">@SelectedProduct.name</h4>
                                    <code class="text-[0.65rem] font-medium text-[#8a8880] bg-[#f0ede5] px-1.5 py-0.5 rounded">@SelectedProduct.sku</code>
                                    
                                    @if (!string.IsNullOrEmpty(SelectedProduct.description))
                                    {
                                        <div class="mt-3 bg-[#f9f8f6] border border-[#e5e3dc] rounded-xl p-3.5">
                                            <h5 class="text-xs font-bold text-[#1a1a1a] mb-1">Deskripsi Produk</h5>
                                            <p class="text-xs text-[#5a5855] leading-relaxed whitespace-pre-wrap">@SelectedProduct.description</p>
                                        </div>
                                    }
                                </div>

                                <div class="h-px bg-[#f0ede5]"></div>

                                @if (SelectedProduct.ProductVariants != null && SelectedProduct.ProductVariants.Any())
                                {
                                    var colors = SelectedProduct.ProductVariants.Select(v => v.color).Where(c =>
                            !string.IsNullOrEmpty(c)).Distinct().ToList();
                                    var sizes = SelectedProduct.ProductVariants.Select(v => v.size).Where(s =>
                            !string.IsNullOrEmpty(s)).Distinct().ToList();

                                    <div class="border-b border-[#f0ede5] pb-4 flex flex-row gap-6">
                                        @if (colors.Any())
                                        {
                                            <div class="flex-1">
                                                <label class="block text-xs font-semibold text-[#5a5855] mb-2">Jenis / Tipe</label>
                                                <div class="flex flex-wrap gap-2">
                                                    @foreach (var c in colors)
                                                    {
                                                        bool avail = SelectedProduct.ProductVariants.Any(v => v.color == c &&
                                        (string.IsNullOrEmpty(SelectedVariantSize) || v.size == SelectedVariantSize));
                                                        <button type="button" @onclick="() => SelectColor(c!)"
                                                                class="px-3 py-1.5 border rounded-lg text-xs font-semibold transition-all @(SelectedVariantColor == c ? "bg-[#3b82f6] border-[#3b82f6] text-white" : avail ? "bg-white border-[#e5e3dc] text-[#5a5855] hover:border-[#1a1a1a]" : "bg-gray-100 border-[#e5e3dc] text-gray-400 opacity-50")">@c</button>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        @if (sizes.Any())
                                        {
                                            <div class="flex-1">
                                                <label class="block text-xs font-semibold text-[#5a5855] mb-2">Ukuran</label>
                                                <div class="flex flex-wrap gap-2">
                                                    @foreach (var s in sizes)
                                                    {
                                                        bool avail = SelectedProduct.ProductVariants.Any(v => v.size == s &&
                                        (string.IsNullOrEmpty(SelectedVariantColor) || v.color == SelectedVariantColor));
                                                        <button type="button" @onclick="() => SelectSize(s!)"
                                                                class="px-3 py-1.5 border rounded-lg text-xs font-semibold transition-all @(SelectedVariantSize == s ? "bg-[#3b82f6] border-[#3b82f6] text-white" : avail ? "bg-white border-[#e5e3dc] text-[#5a5855] hover:border-[#1a1a1a]" : "bg-gray-100 border-[#e5e3dc] text-gray-400 opacity-50")">@s</button>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }

                                <div>
                                    <label class="block text-xs font-semibold text-[#5a5855] mb-1">Jumlah <span
                                        class="text-red-500">*</span></label>
                                        <div
                                            class="flex items-center border border-[#e5e3dc] rounded-md overflow-hidden bg-white w-24 md:w-28">
                                            <button type="button" @onclick="() => { if(SelectedQuantity > 1) SelectedQuantity--; }"
                                                    class="w-7 h-7 md:w-8 md:h-8 flex items-center justify-center text-[#5a5855] hover:bg-[#f5f4f0] transition">-</button>
                                            <input type="number" @bind="SelectedQuantity" @bind:event="oninput" min="1"
                                                   max="@GetMaxStock()"
                                                   class="flex-1 text-center py-1 text-xs md:text-sm outline-none bg-transparent [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none">
                                            <button type="button"
                                                    @onclick="() => { if(SelectedQuantity < GetMaxStock()) SelectedQuantity++; }"
                                                    class="w-7 h-7 md:w-8 md:h-8 flex items-center justify-center text-[#5a5855] hover:bg-[#f5f4f0] transition">+</button>
                                        </div>
                                        <p class="text-[0.65rem] text-[#8a8880] mt-1">Sisa @GetMaxStock()
                                            @(SelectedProduct.Unit?.name ?? "unit")</p>
                                        </div>

                                        <div class="rounded-xl border border-[#e5e3dc] bg-[#f9f8f6] p-1.5 md:p-2 shadow-sm mt-2 md:mt-auto">
                                            <div class="flex items-center justify-between gap-2 md:gap-3">
                                                <div>
                                                    <span
                                                    class="text-[0.6rem] text-[#8a8880] font-semibold uppercase tracking-wider">Kredit</span>
                                                    <div class="text-base md:text-lg font-extrabold text-[#1a1a1a] leading-none mt-0.5">- <span
                                                        class="text-[0.6rem] font-normal text-[#8a8880]">pts</span></div>
                                                    </div>
                                                    <button type="button" @onclick="AddToCart" disabled="@(GetMaxStock() <= 0)"
                                                            class="px-3 py-1.5 md:px-4 md:py-2 bg-[#3b82f6] hover:bg-[#2563eb] active:scale-[0.98] text-white text-[11px] md:text-xs font-bold rounded-lg transition shadow-sm disabled:bg-gray-300 disabled:text-gray-500 disabled:cursor-not-allowed">
                                                        @(GetMaxStock() <= 0 ? "Stok Habis" : "+ Keranjang")
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

<ProductHistoryModal @ref="HistoryModalRef" />

@code {
    private List<Product>? Products;
    private List<Category>? Categories;
    private int? SelectedCategoryId;
    private string SearchQuery = "";
    private System.Threading.CancellationTokenSource? _searchCts;
    private int CurrentPage = 1;
    private int TotalPages = 0;
    private int TotalItems = 0;
    private const int PageSize = 15;
    private bool IsLoadingData = false;

    private bool ShowProductModal = false;
    private Product? SelectedProduct;
    private int SelectedQuantity = 1;
    private string SelectedMainImage = "";
    private List<string> ModalImages = new();
    private int? SelectedVariantId;
    private string? SelectedVariantColor;
    private string? SelectedVariantSize;
    private string? ModalError;
    
    private ProductHistoryModal? HistoryModalRef;

    protected override async Task OnInitializedAsync()
    {
        CartService.OnChange += StateHasChanged;
        DashboardState.OnDashboardUpdated += DashboardUpdated;
        await LoadProducts(1);
        Categories = await ProductService.GetCategoriesForCatalogAsync(1);
    }

    private async void DashboardUpdated()
    {
        await InvokeAsync(async () =>
        {
            await LoadProducts(CurrentPage);
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        CartService.OnChange -= StateHasChanged;
        DashboardState.OnDashboardUpdated -= DashboardUpdated;
    }

    private async Task LoadProducts(int page)
    {
        IsLoadingData = true;
        StateHasChanged();
        try
        {
            CurrentPage = page;
            var (products, totalItems, totalPages) = await ProductService.GetCatalogProductsAsync(1, SelectedCategoryId, SearchQuery, page, PageSize);
            Products = products;
            TotalItems = totalItems;
            TotalPages = totalPages;
        }
        finally
        {
            IsLoadingData = false;
        }
    }

    private List<int?> GetPageNumbers()
    {
        var pages = new List<int?>();
        if (TotalPages <= 7)
        {
            for (int i = 1; i <= TotalPages; i++) pages.Add(i);
            return pages;
        }

        pages.Add(1);
        int start = Math.Max(2, CurrentPage - 1);
        int end = Math.Min(TotalPages - 1, CurrentPage + 1);

        if (start > 2) pages.Add(null);

        for (int i = start; i <= end; i++) pages.Add(i);

        if (end < TotalPages - 1) pages.Add(null);

        pages.Add(TotalPages);
        return pages;
    }

    private async Task FilterByCategory(int? catId)
    {
        SelectedCategoryId = catId;
        await LoadProducts(1);
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        SearchQuery = e.Value?.ToString() ?? "";
        _searchCts?.Cancel();
        _searchCts = new System.Threading.CancellationTokenSource();
        var token = _searchCts.Token;
        try
        {
            await Task.Delay(300, token);
            if (!token.IsCancellationRequested)
                await LoadProducts(1);
        }
        catch (TaskCanceledException) { }
    }

    private void OpenProductModal(Product product)
    {
        ModalError = null;
        SelectedProduct = product;
        SelectedQuantity = 1;
        ModalImages.Clear();

        if (!string.IsNullOrEmpty(product.image))
            ModalImages.Add(NormalizeImage(product.image));

        if (!string.IsNullOrEmpty(product.images))
        {
            try
            {
                var extra = System.Text.Json.JsonSerializer.Deserialize<List<string>>(product.images);
                if (extra != null) ModalImages.AddRange(extra.Select(NormalizeImage));
            }
            catch { }
        }
        ModalImages = ModalImages.Where(i => !string.IsNullOrEmpty(i)).Distinct().ToList();
        SelectedMainImage = ModalImages.FirstOrDefault() ?? "";

        SelectedVariantColor = null;
        SelectedVariantSize = null;
        SelectedVariantId = null;

        if (product.ProductVariants != null && product.ProductVariants.Any())
        {
            var first = product.ProductVariants.First();
            SelectedVariantColor = first.color;
            SelectedVariantSize = first.size;
            SelectedVariantId = first.id;
            if (!string.IsNullOrEmpty(first.image))
                SelectedMainImage = NormalizeImage(first.image);
        }
        ShowProductModal = true;
    }

    private void CloseProductModal()
    {
        ShowProductModal = false;
        SelectedProduct = null;
    }

    private void SelectColor(string color)
    {
        SelectedVariantColor = color;
        if (SelectedProduct?.ProductVariants != null &&
            !SelectedProduct.ProductVariants.Any(v => v.color == color && v.size == SelectedVariantSize))
        {
            SelectedVariantSize = SelectedProduct.ProductVariants.FirstOrDefault(v => v.color == color)?.size;
        }
        UpdateVariant();
    }

    private void SelectSize(string size)
    {
        SelectedVariantSize = size;
        if (SelectedProduct?.ProductVariants != null &&
            !SelectedProduct.ProductVariants.Any(v => v.size == size && v.color == SelectedVariantColor))
        {
            SelectedVariantColor = SelectedProduct.ProductVariants.FirstOrDefault(v => v.size == size)?.color;
        }
        UpdateVariant();
    }

    private void UpdateVariant()
    {
        if (SelectedProduct?.ProductVariants == null) return;
        var v = SelectedProduct.ProductVariants.FirstOrDefault(v =>
            v.color == SelectedVariantColor && v.size == SelectedVariantSize)
            ?? SelectedProduct.ProductVariants.FirstOrDefault(v => v.color == SelectedVariantColor)
            ?? SelectedProduct.ProductVariants.First();
        SelectedVariantColor = v.color;
        SelectedVariantSize = v.size;
        SelectedVariantId = v.id;
        if (!string.IsNullOrEmpty(v.image)) SelectedMainImage = NormalizeImage(v.image);
        SelectedQuantity = 1;
    }

    private int GetMaxStock()
    {
        if (SelectedVariantId.HasValue && SelectedProduct?.ProductVariants != null)
        {
            var v = SelectedProduct.ProductVariants.FirstOrDefault(v => v.id == SelectedVariantId.Value);
            if (v != null) return v.stock;
        }
        return SelectedProduct?.current_stock ?? 0;
    }

    private void AddToCart()
    {
        if (SelectedProduct == null || SelectedQuantity <= 0) return;
        int maxStock = GetMaxStock();
        if (SelectedQuantity > maxStock) { ModalError = "Stok tidak mencukupi."; return; }

        CartService.AddToCart(new CartItem
        {
            Sku = SelectedProduct.sku ?? "",
            Name = SelectedProduct.name ?? "",
            Quantity = SelectedQuantity,
            RequestType = "BORROW",
            BaseCredit = 0,
            MaxStock = maxStock,
            UnitName = SelectedProduct.Unit?.name ?? "unit",
            ProductVariantId = SelectedVariantId,
            VariantColor = SelectedVariantColor,
            VariantSize = SelectedVariantSize
        });

        var name = SelectedProduct.name;
        CloseProductModal();
        CartService.ShowToast($"\"{name}\" ditambahkan ke keranjang.");
    }

    private string GetProductImage(Product p)
    {
        if (!string.IsNullOrEmpty(p.image)) return GetImageUrl(p.image);
        if (!string.IsNullOrEmpty(p.images))
        {
            try
            {
                var list = System.Text.Json.JsonSerializer.Deserialize<List<string>>(p.images);
                if (list?.Any() == true) return GetImageUrl(list[0]);
            }
            catch { }
        }
        return "https://placehold.co/600x400?text=No+Picture";
    }

    private string NormalizeImage(string? img)
    {
        if (string.IsNullOrWhiteSpace(img)) return "";
        var s = img.Trim();
        if (s.StartsWith("/")) s = s[1..];
        return s;
    }

    private string GetImageUrl(string? img)
    {
        var n = NormalizeImage(img);
        if (string.IsNullOrEmpty(n)) return "";
        if (n.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || n.StartsWith("https://",
StringComparison.OrdinalIgnoreCase)) return n;
        if (n.StartsWith("images/", StringComparison.OrdinalIgnoreCase) || n.StartsWith("storage/",
StringComparison.OrdinalIgnoreCase)) return "/" + n;
        return $"/storage/{n}";
    }
}
