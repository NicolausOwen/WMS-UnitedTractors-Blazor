    private async Task SubmitHandover()
    {
        if (HandoverFile == null)
        {
            ModalError = "Foto bukti serah terima wajib diunggah.";
            return;
        }

        var validationError = ValidateUpload(HandoverFile);
        if (validationError != null)
        {
            ModalError = validationError;
            return;
        }

        IsSubmitting = true;
        ErrorMessage = null;
        SuccessMessage = null;

        try
        {
            var handoverTimestamp = HandoverTimestampInput;

            var err = await TransactionService.ConfirmHandoverAsync(
                HandoverTransactionIds,
                HandoverFile,
                HandoverNotes,
                null,
                recipientName: HandoverRecipientName,
                handoverTimestamp: handoverTimestamp);
            if (err == null)
            {
                SuccessMessage = HandoverRequestType == "GIVEAWAY"
                    ? "Draft serah terima giveaway tersimpan. Lanjutkan untuk menyelesaikan serah terima."
                    : "Draft bukti serah terima tersimpan. Periksa lalu klik 'Submit ke Admin' untuk mengirim.";
                CloseHandoverModal();
                await LoadData();
            }
            else
            {
                ErrorMessage = err;
            }
        }
        finally
        {
            IsSubmitting = false;
        }
    }

