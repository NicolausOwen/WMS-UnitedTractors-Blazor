@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject WMS_UnitedTracors_Blazor.Services.UserService UserService
@implements IDisposable
@using System.Security.Claims

@{
    var navInitials = navUserName.Length >= 2 ? navUserName.Substring(0, 2).ToUpper() : navUserName.ToUpper();
    var navUcfirstRole = string.IsNullOrEmpty(navRole) ? "" : char.ToUpper(navRole[0]) + navRole.Substring(1);
}

<!-- DESKTOP SIDEBAR -->
<aside class="ut-sidebar hidden md:flex fixed top-0 left-0 h-screen bg-[#1a1a1a] border-r border-[#2a2a2a] flex-col z-[100] overflow-hidden">
    <!-- Header -->
    <div class="relative flex items-center px-3.5 h-[56px] border-b border-[#2a2a2a] shrink-0 overflow-visible z-[2] ut-sidebar-header">
        <NavLink href="" class="flex items-center gap-[10px] no-underline flex-1 min-w-0 overflow-hidden" Match="NavLinkMatch.All">
            <img src="img/corpu_logo.png" alt="Inventory CORPU" class="w-8 h-8 rounded-lg shrink-0 object-contain p-1">
            <div class="ut-sidebar-logo-text flex flex-col leading-[1.15] overflow-hidden whitespace-nowrap">
                <span class="text-[0.8rem] font-bold text-white tracking-[0.01em] whitespace-nowrap overflow-hidden text-ellipsis">Inventory CORPU</span>
                <span class="text-[0.6rem] text-[#8a8780] font-medium tracking-[0.05em] uppercase whitespace-nowrap">Inventory System</span>
            </div>
        </NavLink>

        <button class="ut-toggle-btn fixed top-[14px] w-7 h-7 rounded-full bg-[#1a1a1a] border border-[#2a2a2a] hover:border-[#e8a000] text-[#8a8780] hover:text-[#1a1a1a] hover:bg-[#e8a000] flex items-center justify-center cursor-pointer shadow-[2px_0_8px_rgba(0,0,0,0.35)] z-[101] shrink-0 transition-all duration-150" onclick="utToggleSidebar()" title="Toggle Sidebar" aria-label="Toggle Sidebar">
            <svg class="w-[13px] h-[13px] stroke-current fill-none stroke-[2.5] stroke-linecap-round stroke-linejoin-round transition-transform duration-250" viewBox="0 0 24 24">
                <path d="M15 19l-7-7 7-7"/>
            </svg>
        </button>
    </div>

    <!-- Navigation -->
    <div class="flex-1 overflow-y-auto overflow-x-hidden py-2 scrollbar-thin scrollbar-thumb-[#2a2a2a] scrollbar-track-transparent">

        <!-- Main -->
        <div class="ut-nav-section py-1.5 md:py-1">
            <div class="ut-section-label text-[0.58rem] font-bold text-[#8a8780] tracking-[0.1em] uppercase px-4 py-1.5 whitespace-nowrap overflow-hidden">Main</div>

            <NavLink href="" class="ut-nav-link flex items-center gap-2.5 px-4 py-2.5 text-[#8a8780] hover:text-white hover:bg-[#222222] hover:border-l-[rgba(232,160,0,0.4)] no-underline text-[0.8rem] font-medium border-l-[2.5px] border-l-transparent relative whitespace-nowrap cursor-pointer" Match="NavLinkMatch.All" activeClass="active text-[#e8a000] bg-[rgba(232,160,0,0.08)] border-l-[#e8a000] font-semibold" data-label="Home Page">
                <svg class="w-[17px] h-[17px] stroke-current fill-none stroke-[1.8] stroke-linecap-round stroke-linejoin-round flex-shrink-0" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                <span class="ut-link-text">Home</span>
            </NavLink>



            <NavLink href="Tracking" class="ut-nav-link flex items-center gap-2.5 px-4 py-2.5 text-[#8a8780] hover:text-white hover:bg-[#222222] hover:border-l-[rgba(232,160,0,0.4)] no-underline text-[0.8rem] font-medium border-l-[2.5px] border-l-transparent relative whitespace-nowrap cursor-pointer" activeClass="active text-[#e8a000] bg-[rgba(232,160,0,0.08)] border-l-[#e8a000] font-semibold" data-label="Tracking">
                <svg class="w-[17px] h-[17px] stroke-current fill-none stroke-[1.8] stroke-linecap-round stroke-linejoin-round flex-shrink-0" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg>
                <span class="ut-link-text">Tracking</span>
            </NavLink>

            @if (userPrincipal.HasAnyPermission(WMS_UnitedTracors_Blazor.Helpers.Permissions.ApprovalStage1, WMS_UnitedTracors_Blazor.Helpers.Permissions.ApprovalStage2, WMS_UnitedTracors_Blazor.Helpers.Permissions.ApprovalManager, WMS_UnitedTracors_Blazor.Helpers.Permissions.ApprovalHandover, WMS_UnitedTracors_Blazor.Helpers.Permissions.ApprovalReturn))
            {
                <NavLink href="Approval" class="ut-nav-link flex items-center gap-2.5 px-4 py-2.5 text-[#8a8780] hover:text-white hover:bg-[#222222] hover:border-l-[rgba(232,160,0,0.4)] no-underline text-[0.8rem] font-medium border-l-[2.5px] border-l-transparent relative whitespace-nowrap cursor-pointer" activeClass="active text-[#e8a000] bg-[rgba(232,160,0,0.08)] border-l-[#e8a000] font-semibold" data-label="Approvals">
                    <svg class="w-[17px] h-[17px] stroke-current fill-none stroke-[1.8] stroke-linecap-round stroke-linejoin-round flex-shrink-0" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>
                    <span class="ut-link-text">Approvals</span>
                </NavLink>
            }

            <NavLink href="TransactionHistory" class="ut-nav-link flex items-center gap-2.5 px-4 py-2.5 text-[#8a8780] hover:text-white hover:bg-[#222222] hover:border-l-[rgba(232,160,0,0.4)] no-underline text-[0.8rem] font-medium border-l-[2.5px] border-l-transparent relative whitespace-nowrap cursor-pointer" activeClass="active text-[#e8a000] bg-[rgba(232,160,0,0.08)] border-l-[#e8a000] font-semibold" data-label="History">
                <svg class="w-[17px] h-[17px] stroke-current fill-none stroke-[1.8] stroke-linecap-round stroke-linejoin-round flex-shrink-0" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                <span class="ut-link-text">History</span>
            </NavLink>

            @if (userPrincipal.HasPermission(WMS_UnitedTracors_Blazor.Helpers.Permissions.ReportsView) || userPrincipal.HasPermission(WMS_UnitedTracors_Blazor.Helpers.Permissions.ProductsManage))
            {
                <NavLink href="Reports" class="ut-nav-link flex items-center gap-2.5 px-4 py-2.5 text-[#8a8780] hover:text-white hover:bg-[#222222] hover:border-l-[rgba(232,160,0,0.4)] no-underline text-[0.8rem] font-medium border-l-[2.5px] border-l-transparent relative whitespace-nowrap cursor-pointer" activeClass="active text-[#e8a000] bg-[rgba(232,160,0,0.08)] border-l-[#e8a000] font-semibold" data-label="Reports">
                    <svg class="w-[17px] h-[17px] stroke-current fill-none stroke-[1.8] stroke-linecap-round stroke-linejoin-round flex-shrink-0" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                    <span class="ut-link-text">Reports</span>
                </NavLink>
            }
        </div>

        <!-- Request Catalog (all users) -->
        <div class="ut-nav-section py-1.5 md:py-1">
            <div class="ut-section-label text-[0.58rem] font-bold text-[#8a8780] tracking-[0.1em] uppercase px-4 py-1.5 whitespace-nowrap overflow-hidden">Request</div>

            <NavLink href="Catalog/Borrow" class="ut-nav-link flex items-center gap-2.5 px-4 py-2.5 text-[#8a8780] hover:text-white hover:bg-[#222222] hover:border-l-[rgba(232,160,0,0.4)] no-underline text-[0.8rem] font-medium border-l-[2.5px] border-l-transparent relative whitespace-nowrap cursor-pointer" activeClass="active text-[#e8a000] bg-[rgba(232,160,0,0.08)] border-l-[#e8a000] font-semibold" data-label="Katalog Pinjam">
                <svg class="w-[17px] h-[17px] stroke-current fill-none stroke-[1.8] stroke-linecap-round stroke-linejoin-round flex-shrink-0" viewBox="0 0 24 24"><path d="M20 7H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                <span class="ut-link-text">Borrow Catalog</span>
            </NavLink>

            <NavLink href="Catalog/Giveaway" class="ut-nav-link flex items-center gap-2.5 px-4 py-2.5 text-[#8a8780] hover:text-white hover:bg-[#222222] hover:border-l-[rgba(232,160,0,0.4)] no-underline text-[0.8rem] font-medium border-l-[2.5px] border-l-transparent relative whitespace-nowrap cursor-pointer" activeClass="active text-[#e8a000] bg-[rgba(232,160,0,0.08)] border-l-[#e8a000] font-semibold" data-label="Katalog Ambil">
                <svg class="w-[17px] h-[17px] stroke-current fill-none stroke-[1.8] stroke-linecap-round stroke-linejoin-round flex-shrink-0" viewBox="0 0 24 24"><path d="M20 12V22H4V12"/><path d="M22 7H2v5h20V7z"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
                <span class="ut-link-text">Giveaway Catalog</span>
            </NavLink>
        </div>

        <!-- Catalog -->
        @if (userPrincipal.HasPermission(WMS_UnitedTracors_Blazor.Helpers.Permissions.ReportsView) || userPrincipal.HasPermission(WMS_UnitedTracors_Blazor.Helpers.Permissions.ProductsManage))
        {
            <div class="ut-nav-section py-1.5 md:py-1">
                <div class="ut-section-label text-[0.58rem] font-bold text-[#8a8780] tracking-[0.1em] uppercase px-4 py-1.5 whitespace-nowrap overflow-hidden">Catalog</div>

                <NavLink href="Product" class="ut-nav-link flex items-center gap-2.5 px-4 py-2.5 text-[#8a8780] hover:text-white hover:bg-[#222222] hover:border-l-[rgba(232,160,0,0.4)] no-underline text-[0.8rem] font-medium border-l-[2.5px] border-l-transparent relative whitespace-nowrap cursor-pointer" activeClass="active text-[#e8a000] bg-[rgba(232,160,0,0.08)] border-l-[#e8a000] font-semibold" data-label="Products">
                    <svg class="w-[17px] h-[17px] stroke-current fill-none stroke-[1.8] stroke-linecap-round stroke-linejoin-round flex-shrink-0" viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73L13 2.27a2 2 0 0 0-2 0L4 6.27A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                    <span class="ut-link-text">Products</span>
                </NavLink>

                @if (userPrincipal.HasPermission(WMS_UnitedTracors_Blazor.Helpers.Permissions.MasterDataManage))
                {
                    <NavLink href="Category" class="ut-nav-link flex items-center gap-2.5 px-4 py-2.5 text-[#8a8780] hover:text-white hover:bg-[#222222] hover:border-l-[rgba(232,160,0,0.4)] no-underline text-[0.8rem] font-medium border-l-[2.5px] border-l-transparent relative whitespace-nowrap cursor-pointer" activeClass="active text-[#e8a000] bg-[rgba(232,160,0,0.08)] border-l-[#e8a000] font-semibold" data-label="Categories">
                        <svg class="w-[17px] h-[17px] stroke-current fill-none stroke-[1.8] stroke-linecap-round stroke-linejoin-round flex-shrink-0" viewBox="0 0 24 24"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                        <span class="ut-link-text">Categories</span>
                    </NavLink>

                    <NavLink href="Location" class="ut-nav-link flex items-center gap-2.5 px-4 py-2.5 text-[#8a8780] hover:text-white hover:bg-[#222222] hover:border-l-[rgba(232,160,0,0.4)] no-underline text-[0.8rem] font-medium border-l-[2.5px] border-l-transparent relative whitespace-nowrap cursor-pointer" activeClass="active text-[#e8a000] bg-[rgba(232,160,0,0.08)] border-l-[#e8a000] font-semibold" data-label="Location">
                        <svg class="w-[17px] h-[17px] stroke-current fill-none stroke-[1.8] stroke-linecap-round stroke-linejoin-round flex-shrink-0" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 1 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        <span class="ut-link-text">Location</span>
                    </NavLink>
                }
            </div>
        }

        <!-- Admin -->
        @if (userPrincipal.HasPermission(WMS_UnitedTracors_Blazor.Helpers.Permissions.MasterDataManage) || 
             userPrincipal.HasPermission(WMS_UnitedTracors_Blazor.Helpers.Permissions.DamagedGoodsView))
        {
            <div class="ut-nav-section py-1.5 md:py-1">
                <div class="ut-section-label text-[0.58rem] font-bold text-[#8a8780] tracking-[0.1em] uppercase px-4 py-1.5 whitespace-nowrap overflow-hidden">Admin</div>

                @if (userPrincipal.HasPermission(WMS_UnitedTracors_Blazor.Helpers.Permissions.MasterDataManage))
                {
                    <NavLink href="Unit" class="ut-nav-link flex items-center gap-2.5 px-4 py-2.5 text-[#8a8780] hover:text-white hover:bg-[#222222] hover:border-l-[rgba(232,160,0,0.4)] no-underline text-[0.8rem] font-medium border-l-[2.5px] border-l-transparent relative whitespace-nowrap cursor-pointer" activeClass="active text-[#e8a000] bg-[rgba(232,160,0,0.08)] border-l-[#e8a000] font-semibold" data-label="Units">
                        <svg class="w-[17px] h-[17px] stroke-current fill-none stroke-[1.8] stroke-linecap-round stroke-linejoin-round flex-shrink-0" viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                        <span class="ut-link-text">Units</span>
                    </NavLink>

                    <NavLink href="Division" class="ut-nav-link flex items-center gap-2.5 px-4 py-2.5 text-[#8a8780] hover:text-white hover:bg-[#222222] hover:border-l-[rgba(232,160,0,0.4)] no-underline text-[0.8rem] font-medium border-l-[2.5px] border-l-transparent relative whitespace-nowrap cursor-pointer" activeClass="active text-[#e8a000] bg-[rgba(232,160,0,0.08)] border-l-[#e8a000] font-semibold" data-label="Divisions">
                        <svg class="w-[17px] h-[17px] stroke-current fill-none stroke-[1.8] stroke-linecap-round stroke-linejoin-round flex-shrink-0" viewBox="0 0 24 24"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
                        <span class="ut-link-text">Divisions</span>
                    </NavLink>

                    <NavLink href="User" class="ut-nav-link flex items-center gap-2.5 px-4 py-2.5 text-[#8a8780] hover:text-white hover:bg-[#222222] hover:border-l-[rgba(232,160,0,0.4)] no-underline text-[0.8rem] font-medium border-l-[2.5px] border-l-transparent relative whitespace-nowrap cursor-pointer" activeClass="active text-[#e8a000] bg-[rgba(232,160,0,0.08)] border-l-[#e8a000] font-semibold" data-label="Users">
                        <svg class="w-[17px] h-[17px] stroke-current fill-none stroke-[1.8] stroke-linecap-round stroke-linejoin-round flex-shrink-0" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        <span class="ut-link-text">Users</span>
                    </NavLink>
                }

                @if (userPrincipal.HasPermission(WMS_UnitedTracors_Blazor.Helpers.Permissions.DamagedGoodsView))
                {
                    <NavLink href="MasterData/DamagedGoods" class="ut-nav-link flex items-center gap-2.5 px-4 py-2.5 text-[#8a8780] hover:text-white hover:bg-[#222222] hover:border-l-[rgba(232,160,0,0.4)] no-underline text-[0.8rem] font-medium border-l-[2.5px] border-l-transparent relative whitespace-nowrap cursor-pointer" activeClass="active text-[#e8a000] bg-[rgba(232,160,0,0.08)] border-l-[#e8a000] font-semibold" data-label="Barang Rusak">
                        <svg class="w-[17px] h-[17px] stroke-current fill-none stroke-[1.8] stroke-linecap-round stroke-linejoin-round flex-shrink-0" viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                        <span class="ut-link-text">Barang Rusak</span>
                    </NavLink>
                }
            </div>
        }

        <!-- Master Data (Super Admin Only) -->
        @if (userPrincipal.HasPermission(WMS_UnitedTracors_Blazor.Helpers.Permissions.RolesManage))
        {
            <div class="ut-nav-section py-1.5 md:py-1">
                <div class="ut-section-label text-[0.58rem] font-bold text-[#8a8780] tracking-[0.1em] uppercase px-4 py-1.5 whitespace-nowrap overflow-hidden">Master Data</div>

                <NavLink href="MasterData/RoleAdmin" class="ut-nav-link flex items-center gap-2.5 px-4 py-2.5 text-[#8a8780] hover:text-white hover:bg-[#222222] hover:border-l-[rgba(232,160,0,0.4)] no-underline text-[0.8rem] font-medium border-l-[2.5px] border-l-transparent relative whitespace-nowrap cursor-pointer" activeClass="active text-[#e8a000] bg-[rgba(232,160,0,0.08)] border-l-[#e8a000] font-semibold" data-label="Role Admin">
                    <svg class="w-[17px] h-[17px] stroke-current fill-none stroke-[1.8] stroke-linecap-round stroke-linejoin-round flex-shrink-0" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    <span class="ut-link-text">Role Admin</span>
                </NavLink>
            </div>
        }

    </div>

    <!-- Footer: Profile & Logout -->
    <div class="ut-sidebar-footer border-t border-[#2a2a2a] px-4 py-3.5 shrink-0 overflow-visible">
        <NavLink href="Profile" class="ut-sidebar-user flex items-center gap-[9px] no-underline rounded-lg p-1 -m-1 hover:bg-[#222222] transition-colors duration-150 overflow-visible" title="My Profile">
            <div class="ut-sidebar-avatar w-8 h-8 rounded-full bg-[#e8a000] flex items-center justify-center text-[0.7rem] font-bold text-[#1a1a1a] shrink-0 transition-shadow duration-150">@navInitials</div>
            <div class="ut-sidebar-user-info flex-1 min-w-0 overflow-hidden whitespace-nowrap">
                <div class="text-[0.76rem] font-semibold text-white overflow-hidden text-ellipsis">@navUserName</div>
                <div class="text-[0.62rem] text-[#8a8780] mt-0.5 flex items-center gap-1.5">
                    <span>@navUcfirstRole</span>
                </div>
            </div>
        </NavLink>
        
        <!-- Sisa Kredit -->
        <div class="ut-credit-info flex items-center justify-between mt-3 px-1 pb-2">
            <span class="text-[0.65rem] text-[#8a8780] font-medium tracking-wide">Sisa Kredit</span>
            <span class="text-[0.7rem] font-bold text-[#e8a000]">@navPoin <span class="text-[0.55rem] font-normal text-[#8a8780]">pts</span></span>
        </div>

        <div class="ut-footer-links flex flex-col overflow-hidden max-h-10 mt-1 border-t border-[#2a2a2a] pt-1">
            <form method="POST" action="/Logout" style="width:100%">
                <AntiforgeryToken />
                <button type="submit" class="ut-footer-link flex items-center gap-2 py-1.5 px-1 text-[0.72rem] text-[#8a8780] hover:text-white no-underline font-medium transition-colors bg-none border-none cursor-pointer w-full text-left font-sans whitespace-nowrap hover:text-[#e05252]">
                    <svg class="w-3.5 h-3.5 stroke-current fill-none stroke-[1.8] flex-shrink-0" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                    Log Out
                </button>
            </form>
        </div>
    </div>

</aside>

<!-- MOBILE TOP BAR + DRAWER -->
<div class="ut-mobile-nav block md:hidden sticky top-0 z-[200]">
    <div class="relative z-[210] bg-[#1a1a1a] flex items-center justify-between px-4 h-[60px] border-b border-[#2a2a2a]">
        <NavLink href="" class="flex items-center gap-2 no-underline flex-1 min-w-0 mr-3">
            <img src="img/corpu_logo.png" alt="Inventory CORPU" class="w-7 h-7 rounded-md object-contain p-[3px] shrink-0">
            <span class="text-[0.88rem] font-bold text-white truncate block">Inventory CORPU</span>
        </NavLink>
        <div class="flex items-center gap-2">
            <WMS_UnitedTracors_Blazor.Components.Shared.CartWidget />
            <button class="ut-topbar-btn w-[34px] h-[34px] rounded-lg border border-[#2a2a2a] hover:border-[#c98d00] bg-none text-[#8a8780] hover:text-[#e8a000] hover:bg-[rgba(232,160,0,0.08)] flex items-center justify-center cursor-pointer transition-colors duration-150" id="utMenuBtn" onclick="utToggleDrawer()" aria-label="Toggle menu">
                <svg id="utIconMenu" class="w-5 h-5 stroke-current fill-none stroke-[2]" viewBox="0 0 24 24">
                    <line x1="3" y1="6" x2="21" y2="6"/>
                    <line x1="3" y1="12" x2="21" y2="12"/>
                    <line x1="3" y1="18" x2="21" y2="18"/>
                </svg>
                <svg id="utIconClose" class="w-5 h-5 stroke-current fill-none stroke-[2]" viewBox="0 0 24 24" style="display:none;">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>
    </div>

    <!-- Drawer: Overlay -->
    <div class="ut-drawer fixed inset-x-0 bottom-0 bg-black/50 z-[190] backdrop-blur-[2px]" id="utDrawer" onclick="utCloseOnOverlay(event)" style="top: 60px;">
        <div class="ut-drawer-panel w-[80vw] max-w-[280px] h-full bg-[#1a1a1a] border-r border-[#2a2a2a] overflow-y-auto flex flex-col">

