@if (ShowRejectModal)
{
    <div class="fixed inset-0 z-[215]" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <div class="fixed inset-0 bg-black/50 backdrop-blur-sm transition-opacity"></div>
        <div class="fixed inset-0 z-10 overflow-y-auto transition-all">
            <div class="flex min-h-full items-end justify-center p-3 sm:p-4 text-center sm:items-center">
                <div class="relative my-0 sm:my-8 w-full max-w-[calc(100vw-1.5rem)] sm:max-w-2xl transform overflow-hidden rounded-2xl bg-white text-left shadow-2xl transition-all border border-[#e5e3dc]">
                    <div class="bg-[#faf9f5] px-4 py-4 sm:px-5 border-b border-[#e5e3dc]">
                        <div class="flex items-start gap-3 sm:gap-4">
                            <div class="flex h-11 w-11 sm:h-12 sm:w-12 flex-shrink-0 items-center justify-center rounded-full bg-[#fef0f0]">
                                <svg class="h-6 w-6 text-[#d94040]" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                                </svg>
                            </div>
                            <div class="w-full">
                                <h3 class="text-xl sm:text-2xl font-bold text-[#1a1a1a] leading-tight" id="modal-title">@(IsRejectingReturn ? "Tolak Pengembalian" : "Reject / Revisi Item")</h3>
                                <p class="mt-1 text-sm leading-6 text-[#6b665e]">@(IsRejectingReturn ? "Berikan alasan penolakan pengembalian ini. Barang akan kembali ke status pinjam agar bisa diajukan ulang." : "Masukkan catatan yang akan terlihat oleh pemohon, lalu pilih apakah item ditolak penuh atau diminta revisi.")</p>
                            </div>
                        </div>
                    </div>
                    <div class="px-4 py-4 sm:px-5 sm:py-5 bg-white">
                        @if (!IsRejectingReturn && RejectItemId > 0)
                        {
                            var rejectItem = GetApprovalItemById(RejectItemId);
                            if (rejectItem != null)
                            {
                                <div class="mb-5 rounded-2xl border border-[#e5e3dc] bg-[#faf9f5] p-4">
                                    <div class="text-[0.65rem] font-bold uppercase tracking-[0.16em] text-[#8a8880] mb-2">Item yang Diproses</div>
                                    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                                        <div class="min-w-0">
                                            <div class="text-base sm:text-lg font-bold text-[#1a1a1a] break-words">@rejectItem.Product?.name</div>
                                            <div class="mt-1 text-xs text-[#6b665e]">SKU: @(rejectItem.Product?.sku ?? "-")</div>
                                        </div>
                                        <div class="w-full sm:w-auto sm:shrink-0 rounded-xl border border-[#f3d37a] bg-[#fffbeb] px-3 py-2 text-left sm:text-right">
                                            <div class="text-[0.65rem] font-bold uppercase tracking-[0.14em] text-[#b77900]">Qty Diajukan</div>
                                            <div class="text-lg font-bold text-[#1a1a1a]">@rejectItem.quantity @(rejectItem.Product?.Unit?.name ?? "unit")</div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }

                        <div>
                            <label class="block text-[0.72rem] font-bold tracking-[0.14em] uppercase text-[#8a8880] mb-2">Catatan Reject / Revisi</label>
                            <textarea @bind="RejectReason" @bind:event="oninput" @onkeypress="() => RejectionError = false" class="w-full rounded-xl border bg-white px-4 py-3 text-sm text-[#1a1a1a] shadow-sm @(RejectionError ? "border-[#d94040] focus:border-[#d94040] focus:ring-[#d94040]" : "border-[#e5e3dc] focus:border-[#e8a000] focus:ring-[#e8a000]")" rows="4" placeholder="Jelaskan alasan penolakan atau revisi qty secara spesifik..."></textarea>
                            @if (RejectionError)
                            {
                                <p class="mt-2 text-xs font-semibold text-[#d94040]">Catatan wajib diisi sebelum item diproses.</p>
                            }
                        </div>

                        @if (!IsRejectingReturn)
                        {
                            <div class="mt-5 rounded-2xl border border-[#e5e3dc] bg-[#faf9f5] p-4">
                                <label class="block text-[0.72rem] font-bold tracking-[0.14em] uppercase text-[#8a8880] mb-2">Qty Revisi</label>
                                <input type="number" min="1" @bind="RejectRevisedQuantity" class="w-full rounded-xl border border-[#e5e3dc] bg-white px-4 py-3 text-base font-semibold text-[#1a1a1a] shadow-sm focus:border-[#e8a000] focus:ring-[#e8a000]" />
                                <p class="mt-2 text-xs text-[#6b665e]">Isi jumlah baru jika item tidak ditolak penuh. Contoh: dari 10 unit menjadi 4 unit.</p>
                            </div>

                            @if (GetApprovalItemById(RejectItemId)?.request_type == "GIVEAWAY")
                            {
                                <div class="mt-4 rounded-2xl border border-[#e5e3dc] bg-[#faf9f5] p-4">
                                    <label class="block text-[0.72rem] font-bold tracking-[0.14em] uppercase text-[#8a8880] mb-2">Tanggal Pengambilan Revisi</label>
                                    <InputDate @bind-Value="RejectRevisedPickupDate" class="w-full rounded-xl border border-[#e5e3dc] bg-white px-4 py-3 text-base font-semibold text-[#1a1a1a] shadow-sm focus:border-[#e8a000] focus:ring-[#e8a000]" />
                                    <p class="mt-2 text-xs text-[#6b665e]">Khusus giveaway, staff inventoris bisa mengubah tanggal pengambilan saat mengajukan revisi item.</p>
                                </div>
                            }
                        }

                    </div>
                    <div class="px-4 py-4 sm:px-5 bg-[#faf9f5] border-t border-[#e5e3dc] flex flex-col sm:flex-row-reverse gap-3">
                        <button type="button" @onclick='() => SubmitReject("REJECT")' class="inline-flex w-full justify-center rounded-xl bg-[#d94040] px-4 py-3 text-sm font-bold text-white shadow-sm hover:bg-[#bf3535] sm:w-auto sm:min-w-[140px] transition">Tolak Item</button>
                        @if (!IsRejectingReturn)
                        {
                            <button type="button" @onclick='() => SubmitReject("REVISE")' class="inline-flex w-full justify-center rounded-xl bg-[#e8a000] px-4 py-3 text-sm font-bold text-[#1a1a1a] shadow-sm hover:bg-[#d49300] sm:w-auto sm:min-w-[140px] transition">Ajukan Revisi</button>
                        }
