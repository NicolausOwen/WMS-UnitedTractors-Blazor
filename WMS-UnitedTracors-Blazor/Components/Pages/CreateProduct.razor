@page "/createproduct"
@page "/Product/Create"
@page "/Product-Create"
@using UT_WMSDotnet.ViewModels
@using WMS_UnitedTracors_Blazor.Services
@using UT_WMSDotnet.Models
@inject ProductService ProductService
@inject CategoryService CategoryService
@inject LocationService LocationService
@inject NavigationManager NavigationManager
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Add Product</PageTitle>

<header class="bg-transparent">
    <div class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
        <div class="mb-1">
            <h1 class="text-[1.6rem] font-bold text-[#1a1a1a] leading-none tracking-tight">Tambah <span class="text-[#e8a000]">Produk</span></h1>
            <div class="text-[0.72rem] font-medium text-[#a09e99] mt-1">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</div>
        </div>
    </div>
</header>

<div class="py-8">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm">
            <div class="px-6 py-5 border-b border-gray-100 flex items-center gap-4">
                <button @onclick="NavigateBack" class="p-2 bg-white border border-gray-200 rounded-lg text-gray-600 hover:text-gray-900 hover:bg-gray-50 transition shrink-0">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
                </button>
                <div>
                    <h3 class="text-sm font-semibold text-gray-900">Product Details</h3>
                    <p class="text-xs text-gray-500 mt-0.5">Fill in the information below to add a new product.</p>
                </div>
            </div>
            <div class="px-6 py-6">
    @if (Categories == null || Locations == null)
    {
        <div class="p-6 text-center text-gray-500 flex flex-col items-center">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-gray-900 mb-4"></div>
            Loading form...
        </div>
    }
    else
    {
        <EditForm Model="Model" OnValidSubmit="HandleSubmit" class="p-6">
            <DataAnnotationsValidator />
            
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="mb-6 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm" role="alert">
                    @ErrorMessage
                </div>
            }

            <div class="space-y-5">
                @* SKU *@
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">SKU / Barcode ID</label>
                    <InputText @bind-Value="Model.sku" class="block w-full py-2 px-3 text-sm bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-[#e8a000] focus:border-[#e8a000] outline-none transition" placeholder="Leave empty to auto-generate" />
                    <ValidationMessage For="@(() => Model.sku)" class="text-red-600 text-xs mt-1 block" />
                </div>

                @* Barcode Type *@
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Barcode Type</label>
                    <InputSelect @bind-Value="Model.barcode_type" required class="block w-full py-2 px-3 text-sm bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-[#e8a000] focus:border-[#e8a000] outline-none transition">
                        <option value="TYPE_CODE_128">Code 128 (Recommended)</option>
                        <option value="TYPE_CODE_39">Code 39</option>
                        <option value="TYPE_EAN_13">EAN-13</option>
                        <option value="TYPE_UPC_A">UPC-A</option>
                    </InputSelect>
                    <ValidationMessage For="@(() => Model.barcode_type)" class="text-red-600 text-xs mt-1 block" />
                </div>

                @* Product Name & Point Value *@
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="md:col-span-2">
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Product Name</label>
                        <InputText @bind-Value="Model.name" required class="block w-full py-2 px-3 text-sm bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-[#e8a000] focus:border-[#e8a000] outline-none transition" />
                        <ValidationMessage For="@(() => Model.name)" class="text-red-600 text-xs mt-1 block" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Point Value</label>
                        <InputNumber @bind-Value="Model.value" min="0" placeholder="0" class="block w-full py-2 px-3 text-sm bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-[#e8a000] focus:border-[#e8a000] outline-none transition" />
                        <ValidationMessage For="@(() => Model.value)" class="text-red-600 text-xs mt-1 block" />
                    </div>
                </div>

                @* Unit *@
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Unit</label>
                    <InputText @bind-Value="Model.unit" required class="block w-full py-2 px-3 text-sm bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-[#e8a000] focus:border-[#e8a000] outline-none transition" placeholder="e.g. PCS, BOX, LTR" />
                    <ValidationMessage For="@(() => Model.unit)" class="text-red-600 text-xs mt-1 block" />
                </div>

                @* Category & Transaction Type *@
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Category</label>
                        <InputSelect @bind-Value="Model.category_id" required class="block w-full py-2 px-3 text-sm bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-[#e8a000] focus:border-[#e8a000] outline-none transition">
                            <option value="0">Select category (required)</option>
                            @foreach (var cat in Categories)
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => Model.category_id)" class="text-red-600 text-xs mt-1 block" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Transaction Type</label>
                        <InputSelect @bind-Value="Model.transaction_type" class="block w-full py-2 px-3 text-sm bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-[#e8a000] focus:border-[#e8a000] outline-none transition">
                            <option value="">Default (Borrow & Request)</option>
                            <option value="BORROW">Peminjaman (Borrow Only)</option>
                            <option value="REQUEST">Permintaan (Request Only)</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => Model.transaction_type)" class="text-red-600 text-xs mt-1 block" />
                    </div>
                </div>

                @* Description *@
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Product Description</label>
                    <InputTextArea @bind-Value="Model.description" rows="4" placeholder="Tuliskan kondisi, spesifikasi, atau catatan penting barang..." class="block w-full rounded-3xl border border-[#e5e3dc] bg-[#faf9f5] px-4 py-3 text-sm text-[#1a1a1a] focus:border-[#e8a000] focus:bg-white focus:outline-none focus:ring-4 focus:ring-[#fef3c7] transition duration-200"></InputTextArea>
                    <ValidationMessage For="@(() => Model.description)" class="text-red-600 text-xs mt-1 block" />
                    <p class="text-xs text-gray-400 mt-2">Deskripsi ini membantu tim approval dan gudang memahami kondisi / catatan barang.</p>
                </div>

                @* Is Returnable *@
                <div>
                    <label class="flex items-center gap-2 cursor-pointer w-max">
                        <InputCheckbox @bind-Value="Model.is_returnable" class="rounded border-gray-300 text-gray-900 focus:ring-gray-900 w-4 h-4 transition outline-none" />
                        <span class="text-sm font-medium text-gray-700">Item is Returnable <span class="text-xs text-gray-500 font-normal">(Uncheck this for Merchandise/Giveaways)</span></span>
                    </label>
                </div>

                @* Location & Position Image *@
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Location</label>
                        <InputSelect @bind-Value="Model.location_id" class="block w-full py-2 px-3 text-sm bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-[#e8a000] focus:border-[#e8a000] outline-none transition">
                            <option value="">Select location (optional)</option>
                            @foreach (var loc in Locations)
                            {
                                <option value="@loc.Id">@loc.Name</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => Model.location_id)" class="text-red-600 text-xs mt-1 block" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Position Image</label>
                        <InputFile OnChange="HandlePositionImageSelected" accept="image/jpg,image/jpeg,image/png,image/webp" class="block w-full text-sm text-gray-500 file:mr-2 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-medium file:bg-gray-100 file:text-gray-700 hover:file:bg-gray-200 transition cursor-pointer" />
                    </div>
                </div>

                @* Product Image *@
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Product Image</label>
                    <InputFile OnChange="HandleImageSelected" accept="image/jpg,image/jpeg,image/png,image/webp" class="block w-full text-sm text-gray-500 file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-gray-100 file:text-gray-700 hover:file:bg-gray-200 transition cursor-pointer" />
                    <p class="text-xs text-gray-400 mt-1">Upload main product image here. JPG, PNG or WebP. Max 2MB.</p>
                </div>

                @* Stock Info *@
                <div class="p-4 bg-gray-50 border border-gray-200 rounded-lg">
                    <p class="text-xs font-medium text-gray-500 mb-2">Stock Information</p>
                    <div class="grid grid-cols-2 gap-4 text-sm">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1.5">Initial Stock:</label>
                            <InputNumber @bind-Value="Model.initial_stock" required min="0" class="block w-full py-2 px-3 text-sm bg-white border border-gray-200 rounded-lg focus:ring-2 focus:ring-[#e8a000] focus:border-[#e8a000] outline-none transition" />
                            <ValidationMessage For="@(() => Model.initial_stock)" class="text-red-600 text-xs mt-1 block" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex justify-end items-center gap-3 border-t border-gray-100 pt-5 mt-6">
                <button type="button" @onclick="NavigateBack" class="px-4 py-2 bg-white text-gray-700 border border-gray-300 rounded-lg font-medium text-sm hover:bg-gray-50 transition">
                    Cancel
                </button>
                <button type="submit" disabled="@IsSubmitting" class="px-4 py-2 bg-gray-900 text-white rounded-lg font-medium text-sm hover:bg-gray-800 transition disabled:opacity-70 flex items-center gap-2 justify-center min-w-[120px]">
                    @if (IsSubmitting)
                    {
                        <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-white"></div>
                        <span>Processing...</span>
                    }
                    else
                    {
                        <span>Save Product</span>
                    }
                </button>
            </div>
        </EditForm>
    }
            </div>
        </div>
    </div>
</div>

@code {
    private ProductCreateViewModel Model = new() { barcode_type = "TYPE_CODE_128" };
    private List<WMS_UnitedTracors_Blazor.Services.CategoryDto>? Categories;
    private List<WMS_UnitedTracors_Blazor.Services.LocationDto>? Locations;
    
    private string? ErrorMessage;
    private bool IsSubmitting;

    private Microsoft.AspNetCore.Components.Forms.IBrowserFile? selectedImage;
    private Microsoft.AspNetCore.Components.Forms.IBrowserFile? selectedPositionImage;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity == null || !user.Identity.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        var role = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
        if (role != "admin" && role != "superadmin")
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        var catResult = await CategoryService.GetCategoriesAsync(1, 100);
        Categories = catResult.Categories;
        
        var locResult = await LocationService.GetLocationsAsync(1, 100);
        Locations = locResult.Locations;
    }

    private void HandleImageSelected(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        selectedImage = e.File;
    }

    private void HandlePositionImageSelected(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        selectedPositionImage = e.File;
    }

    private async Task HandleSubmit()
    {
        if (Model.category_id == 0)
        {
            ErrorMessage = "Please select a category.";
            return;
        }

        IsSubmitting = true;
        ErrorMessage = null;
        StateHasChanged();

        if (selectedImage != null)
        {
            var ms = new System.IO.MemoryStream();
            await selectedImage.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(ms);
            ms.Position = 0;
            Model.image = new Microsoft.AspNetCore.Http.FormFile(ms, 0, selectedImage.Size, "image", selectedImage.Name)
            {
                Headers = new Microsoft.AspNetCore.Http.HeaderDictionary(),
                ContentType = selectedImage.ContentType
            };
        }

        if (selectedPositionImage != null)
        {
            var ms = new System.IO.MemoryStream();
            await selectedPositionImage.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(ms);
            ms.Position = 0;
            Model.position_image = new Microsoft.AspNetCore.Http.FormFile(ms, 0, selectedPositionImage.Size, "position_image", selectedPositionImage.Name)
            {
                Headers = new Microsoft.AspNetCore.Http.HeaderDictionary(),
                ContentType = selectedPositionImage.ContentType
            };
        }

        var result = await ProductService.CreateProductAsync(Model);
        
        IsSubmitting = false;

        if (result == null)
        {
            NavigationManager.NavigateTo("/Product");
        }
        else
        {
            ErrorMessage = result;
        }
    }

    private void NavigateBack()
    {
        NavigationManager.NavigateTo("/Product");
    }
}
