@page "/Tracking"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using UT_WMSDotnet.Models
@using WMS_UnitedTracors_Blazor.Services
@inject TrackingService TrackingService
@inject TransactionService TransactionService
@inject CartService CartService
@inject DivisionService DivisionService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ApprovalService ApprovalService
@inject IJSRuntime JSRuntime
@inject DashboardStateService DashboardState
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>WMS - Tracking Penggunaan</PageTitle>

<WMS_UnitedTracors_Blazor.Components.Shared.LoadingOverlay IsVisible="IsSubmitting" Message="Memproses Data Transaksi..." SubMessage="Mohon tunggu sebentar..." />

<div class="py-8 min-h-screen font-sans">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="mb-6">
            <h1 class="text-[1.6rem] font-bold text-[#1a1a1a] leading-none tracking-tight">Tracking <span class="text-[#e8a000]">Penggunaan</span></h1>
            <div class="text-[0.72rem] font-medium text-[#a09e99] mt-1">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</div>
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="mb-6 bg-[#fef0f0] border border-[#f8c0c0] text-[#d94040] px-5 py-4 rounded-xl flex items-center gap-3">
                <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <p class="text-sm font-semibold">@ErrorMessage</p>
            </div>
        }

        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="mb-6 bg-[#eef9f0] border border-[#b8e8c0] text-[#1a7a30] px-5 py-4 rounded-xl flex items-center gap-3">
                <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <p class="text-sm font-semibold">@SuccessMessage</p>
            </div>
        }

        @* Filters *@
        <div class="relative bg-white rounded-xl border border-[#e5e3dc] mb-4 overflow-hidden shadow-sm">
            <div class="px-4 py-3">
                <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-end">
                    <div class="flex-1 min-w-[180px] w-full">
                        <div class="relative">
                            <input type="text" @bind="ProductSearch" placeholder="Search product or SKU" aria-label="Search product or SKU"
                                class="block w-full pl-9 pr-3 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none transition-colors duration-150 text-[#1a1a1a]">
                            <svg class="w-4 h-4 text-[#8a8880] absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                        </div>
                    </div>
                    @if (UserRole != null && !IsStaffOrUser)
                    {
                        <div class="min-w-[150px] w-full lg:w-auto">
                            <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Division</label>
                            <select @bind="DivisionId" class="block w-full px-3 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none transition-colors duration-150 text-[#1a1a1a]">
                                <option value="">All Divisions</option>
                                @foreach(var div in Divisions)
                                {
                                    <option value="@div.id">@div.name</option>
                                }
                            </select>
                        </div>
                        @if (ActiveTrackingTab == "borrow")
                        {
                            <div class="min-w-[150px] w-full lg:w-auto">
                                <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Return Status</label>
                                <select @bind="ReturnStatus" class="block w-full px-3 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none transition-colors duration-150 text-[#1a1a1a]">
                                    <option value="">All Types</option>
                                    <option value="pending">Borrowed (Pending Return)</option>
                                    <option value="returned">Borrowed (Returned)</option>
                                </select>
                            </div>
                        }
                    }
                    <div class="min-w-[140px] w-full lg:w-auto @(ShowDateFilter ? "block" : "hidden lg:block")">
                        <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">From</label>
                        <input type="date" @bind="DateFrom" class="block w-full px-3 py-1.5 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none transition-colors duration-150 text-[#1a1a1a]">
                    </div>
                    <div class="min-w-[140px] w-full lg:w-auto @(ShowDateFilter ? "block" : "hidden lg:block")">
                        <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">To</label>
                        <input type="date" @bind="DateTo" class="block w-full px-3 py-1.5 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none transition-colors duration-150 text-[#1a1a1a]">
                    </div>
                    <div class="flex gap-2 w-full lg:w-auto justify-end @(ShowDateFilter ? "flex" : "hidden lg:flex")">
                        <button type="button" @onclick="LoadData" class="px-5 py-2 bg-[#e8a000] hover:bg-[#d49300] text-[#1a1a1a] text-xs font-bold rounded-lg transition active:scale-95 cursor-pointer whitespace-nowrap">
                            Apply
                        </button>
                        <button type="button" @onclick="ResetFilters" class="px-5 py-2 bg-white border border-[#e5e3dc] hover:bg-[#f0ede5] text-[#3a3835] text-xs font-bold rounded-lg transition cursor-pointer">
                            Reset
                        </button>
                    </div>
                </div>
                <div class="sm:hidden flex justify-center mt-3">
                    <button type="button" @onclick="() => ShowDateFilter = !ShowDateFilter" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white text-[#1a1a1a] hover:bg-[#faf9f5] transition">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
                        <span class="text-[0.75rem] font-semibold">Filter</span>
                    </button>
                </div>
            </div>
        </div>

        <div class="mb-4 bg-white rounded-xl border border-[#e5e3dc] overflow-hidden shadow-sm">
            <div class="px-5 py-4">
                <div class="grid grid-cols-2 gap-2">
                    <button type="button" @onclick='() => SetActiveTrackingTab("borrow")' class="w-full px-2.5 py-1.5 text-xs font-semibold rounded-lg transition-all whitespace-nowrap @(ActiveTrackingTab == "borrow" ? "bg-[#1a1a1a] text-white" : "text-[#8a8880] hover:text-[#1a1a1a] hover:bg-[#faf9f5]")" aria-pressed="@(ActiveTrackingTab == "borrow")">
                        Borrowing
                        <span class="ml-2 inline-flex px-1 py-0.5 rounded-full text-[10px] @(ActiveTrackingTab == "borrow" ? "bg-[#e8a000] text-[#1a1a1a]" : "bg-[#e7f1fb] text-[#1a6b8a]")">@BorrowGroupCount</span>
                    </button>
                    <button type="button" @onclick='() => SetActiveTrackingTab("giveaway")' class="w-full px-2.5 py-1.5 text-xs font-semibold rounded-lg transition-all whitespace-nowrap @(ActiveTrackingTab == "giveaway" ? "bg-[#1a1a1a] text-white" : "text-[#8a8880] hover:text-[#1a1a1a] hover:bg-[#faf9f5]")" aria-pressed="@(ActiveTrackingTab == "giveaway")">
                        Giveaway
                        <span class="ml-2 inline-flex px-1 py-0.5 rounded-full text-[10px] @(ActiveTrackingTab == "giveaway" ? "bg-[#e8a000] text-[#1a1a1a]" : "bg-[#eef9f0] text-[#1a7a30]")">@GiveawayGroupCount</span>
                    </button>
                </div>
            </div>
        </div>

        @if(GroupedUsages == null)
        {
            <div class="text-center py-8 text-[#8a8880]">Loading...</div>
        }
        else if(!GroupedUsages.Any())
        {
            <div class="text-center py-8 text-[#8a8880]">Tidak ada data tracking yang ditemukan.</div>
        }
        else
        {
            var visibleGroups = GetVisibleTrackingGroups().ToList();

            @if (!visibleGroups.Any())
            {
                <div class="bg-white rounded-xl border border-[#e5e3dc] shadow-sm px-6 py-12 text-center">
                    <div class="mx-auto w-14 h-14 rounded-full @(ActiveTrackingTab == "borrow" ? "bg-[#eef6fd] text-[#1a6b8a]" : "bg-[#eef9f0] text-[#1a7a30]") flex items-center justify-center mb-4">
                        @if (ActiveTrackingTab == "borrow")
                        {
                            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                        }
                        else
                        {
                            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                        }
                    </div>
                    <h3 class="text-base font-bold text-[#1a1a1a]">
                        @(ActiveTrackingTab == "borrow" ? "Tidak ada data borrowing" : "Tidak ada data giveaway")
                    </h3>
                    <p class="mt-1 text-sm text-[#8a8880]">
                        @(ActiveTrackingTab == "borrow"
                            ? "Belum ada peminjaman yang cocok dengan filter aktif atau seluruh item sudah selesai dikembalikan."
                            : "Belum ada request giveaway yang cocok dengan filter aktif saat ini.")
                    </p>
                </div>
            }
            else
            {
            <div class="space-y-4">
                @foreach(var group in visibleGroups)
                {
                    var groupId = group.Key;
                    var groupItems = group.Value;
                    var firstItem = groupItems.First();
                    var borrowItemsOnly = groupItems.Where(i => i.request_type == "BORROW").ToList();
                    var giveawayItemsOnly = groupItems.Where(i => i.request_type == "GIVEAWAY").ToList();
                    var hasBorrow = borrowItemsOnly.Any();
                    var totalItems = hasBorrow ? borrowItemsOnly.Sum(i => i.quantity) : groupItems.Sum(i => i.quantity);
                    var totalReturned = hasBorrow ? borrowItemsOnly.Sum(i => i.returned_quantity) : groupItems.Sum(i => i.returned_quantity);
                    var allReturned = totalItems > 0 && totalReturned >= totalItems;
                    var isGiveaway = !hasBorrow;
                    var status = firstItem.status;

                    var isHandoverPending = hasBorrow && borrowItemsOnly.Any(i => i.status == "WAITING_HANDOVER" || i.status == "WAITING_ADMIN_HANDOVER" || i.status == "WAITING_HANDOVER_CONFIRM");
                    var isWaitingAdminHandover = hasBorrow && borrowItemsOnly.Any(i => i.status == "WAITING_ADMIN_HANDOVER");
                    var handoverDone = hasBorrow && borrowItemsOnly.Any(i => i.status == "APPROVED" && !string.IsNullOrEmpty(i.handover_photo));
                    // Tombol upload hanya saat menunggu bukti dari user (WAITING_HANDOVER), bukan saat menunggu verifikasi admin.
                    var canHandover = false; // Hanya SI yang bisa mengunggah bukti serah terima melalui Dashboard Approval
                    var isWaitingUserConfirm = hasBorrow && borrowItemsOnly.Any(i =>
                        (i.status == "WAITING_HANDOVER_CONFIRM" ||
                         (i.status == "APPROVED" && i.handover_timestamp.HasValue && (WibHelper.Now - i.handover_timestamp.Value).TotalHours < 24)) &&
                        (i.handover_uploaded_by == "SI" || string.IsNullOrEmpty(i.handover_uploaded_by)));
                    // Draft serah terima: status masih WAITING_HANDOVER tapi foto sudah diunggah (belum disubmit ke admin).
                    var hasHandoverDraftPhoto = hasBorrow && borrowItemsOnly.Any(i => i.status == "WAITING_HANDOVER" && !string.IsNullOrEmpty(i.handover_photo));
                    var canGiveawayHandover = false;
                    var hasGiveawayHandoverDraftPhoto = isGiveaway && giveawayItemsOnly.Any(i => i.status == "WAITING_HANDOVER" && !string.IsNullOrEmpty(i.handover_photo));
                    var canUploadDocumentation = isGiveaway && (status == "WAITING_DOCUMENTATION" || status == "DOCUMENTATION_OVERDUE") && (firstItem.requester_id == CurrentUserId || userPrincipal.HasPermission(WMS_UnitedTracors_Blazor.Helpers.Permissions.ProductsManage));
                    var borrowStartDate = hasBorrow
                        ? borrowItemsOnly.Where(i => i.borrow_start_date.HasValue).Select(i => i.borrow_start_date).OrderBy(i => i).FirstOrDefault()
                        : null;
                    var expectedReturnDate = hasBorrow
                        ? borrowItemsOnly.Where(i => i.expected_return_date.HasValue).Select(i => i.expected_return_date).OrderByDescending(i => i).FirstOrDefault()
                        : null;
                    var pickupDate = isGiveaway
                        ? giveawayItemsOnly.Where(i => i.pickup_date.HasValue).Select(i => i.pickup_date).OrderBy(i => i).FirstOrDefault()
                        : null;
                    var isBorrowOverdue = hasBorrow && expectedReturnDate.HasValue && expectedReturnDate.Value.Date < DateTime.Today && !allReturned;

                    var isExpanded = ExpandedGroupIds.Contains(groupId);

                    <div class="bg-white rounded-xl border overflow-hidden shadow-sm transition-all duration-200 @(isGiveaway ? "border-[#d8eadb]" : "border-[#d9e6f3]")">
                        @* Header Accordion (Sederhana & Bersih) *@
                        <div @onclick="() => ToggleGroup(groupId)" class="px-5 py-4 cursor-pointer transition flex flex-row items-center justify-between gap-4 @(isGiveaway ? "hover:bg-[#f6fbf7]" : "hover:bg-[#f8fbff]")">
                            <div class="flex items-center gap-4 flex-1 min-w-0">
                                <div class="w-10 h-10 rounded-full @(isGiveaway ? "bg-[#eef9f0] border-[#d8eadb]" : "bg-[#eef6fd] border-[#d9e6f3]") border flex items-center justify-center shrink-0">
                                    @if(isGiveaway) {
                                        <svg class="w-5 h-5 text-[#1a7a30]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                                    } else {
                                        <svg class="w-5 h-5 text-[#1a6b8a]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                    }
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="flex flex-col sm:flex-row sm:items-center gap-2 mb-1">
                                        <h3 class="font-syne font-bold text-[#1a1a1a] text-sm sm:text-base truncate">@(string.IsNullOrEmpty(firstItem.event_name) ? (isGiveaway ? "Request Barang" : "Peminjaman Barang") : firstItem.event_name)</h3>
                                        <div class="flex flex-wrap items-center gap-1.5 shrink-0">
                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#f5f4f0] text-[#8a8780] border border-[#e5e3dc]">@groupItems.Count Items</span>
                                            @if(isGiveaway) {
                                                @if(status == "COMPLETED" || status == "APPROVED") {
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#eef9f0] text-[#1a7a30] border border-[#b8e8c0]">Selesai</span>
                                                } else if(status == "REJECTED") {
                                                    @if (!string.IsNullOrEmpty(firstItem.last_revision_stage) || IsRevisionStatus(status)) {
                                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#fffbeb] text-[#d97706] border border-[#fde68a]">Butuh Revisi</span>
                                                    } else {
                                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#fef0f0] text-[#d94040] border border-[#f8c0c0]">Ditolak</span>
                                                    }
                                                } else if(status == "REVISION" || status == "REVISION_BY_STAFF_INVENTORY" || status == "REVISION_BY_ADMIN" || status == "REVISION_BY_MANAGER") {
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#fffbeb] text-[#d97706] border border-[#fde68a]">Butuh Revisi</span>
                                                } else if(status == "PENDING_STAFF_INVENTORY") {
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#fff8e6] text-[#b37a00] border border-[#ffe099]">Menunggu Staff Inventoris</span>
                                                } else if(status == "PENDING_ADMIN") {
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#fff8e6] text-[#b37a00] border border-[#ffe099]">Menunggu Admin</span>
                                                } else if(status == "PENDING_MANAGER") {
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#fff8e6] text-[#b37a00] border border-[#ffe099]">Menunggu Manager</span>
                                                } else if(status == "WAITING_HANDOVER") {
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#e0f2fe] text-[#1a6b8a] border border-[#bae6fd]">Menunggu Serah Terima</span>
                                                } else if(status == "WAITING_DOCUMENTATION") {
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#e8f5e9] text-[#2e7d32] border border-[#c8e6c9]">Menunggu Dokumentasi User</span>
                                                } else if(status == "DOCUMENTATION_OVERDUE") {
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#fef0f0] text-[#d94040] border border-[#f8c0c0]">Dokumentasi Overdue</span>
                                                } else {
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#fff8e6] text-[#b37a00] border border-[#ffe099]">Sedang Diproses</span>
                                                }
                                            } else {
                                                @if(status == "REJECTED") {
                                                    @if (!string.IsNullOrEmpty(firstItem.last_revision_stage) || IsRevisionStatus(status)) {
                                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#fffbeb] text-[#d97706] border border-[#fde68a]">Butuh Revisi</span>
                                                    } else {
                                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#fef0f0] text-[#d94040] border border-[#f8c0c0]">Ditolak</span>
                                                    }
                                                } else if(status == "REVISION" || status == "REVISION_BY_STAFF_INVENTORY" || status == "REVISION_BY_ADMIN") {
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#fffbeb] text-[#d97706] border border-[#fde68a]">Butuh Revisi</span>
                                                } else if(status == "PENDING_STAFF_INVENTORY") {
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#fff8e6] text-[#b37a00] border border-[#ffe099]">Menunggu Staff Inventoris</span>
                                                } else if(status == "PENDING_ADMIN" || status == "PENDING") {
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#fff8e6] text-[#b37a00] border border-[#ffe099]">Menunggu Admin</span>
                                                } else if(status == "WAITING_HANDOVER") {
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#fff8e6] text-[#b37a00] border border-[#ffe099]">Menunggu Bukti Serah Terima</span>
                                                } else if(status == "WAITING_HANDOVER_CONFIRM") {
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#e0f2fe] text-[#0369a1] border border-[#bae6fd]">Berita Acara Serah Terima</span>
                                                } else if(status == "WAITING_ADMIN_HANDOVER") {
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#e0f2fe] text-[#1a6b8a] border border-[#bae6fd]">Menunggu Verifikasi Admin</span>
                                                } else if(allReturned) {
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#eef9f0] text-[#1a7a30] border border-[#b8e8c0]">Selesai</span>
                                                } else {
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#fff8e6] text-[#b37a00] border border-[#ffe099]">Sedang Dipinjam</span>
                                                }
                                            }
                                        </div>
                                    </div>
                                    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-gray-500">
                                        <div class="flex items-center gap-1.5">
                                            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                                            @(firstItem.applicant_name ?? firstItem.Requester?.name)
                                        </div>
                                        <div class="flex items-center gap-1.5">
                                            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                            Tanggal Event: @(firstItem.event_date?.ToString("dd MMM yyyy") ?? "-")
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="flex items-center gap-3 shrink-0">
                                <div class="w-8 h-8 rounded-full flex items-center justify-center text-gray-400 hover:text-[#1a1a1a] hover:bg-[#f0ede5] transition">
                                    <svg class="w-5 h-5 transition-transform duration-200 @(isExpanded ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                                </div>
                            </div>
                        </div>

                        @if(isExpanded)
                        {
                            <div class="border-t border-[#e5e3dc] bg-[#faf9f5] p-5">
                                <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
                                    
                                    <!-- Kolom 1: Vertical Timeline (1/4 Lebar pada Desktop) -->
                                    <div class="lg:col-span-1 bg-white p-5 rounded-2xl border border-[#e5e3dc] shadow-sm flex flex-col h-fit">
                                        <h4 class="text-xs font-bold text-[#1a1a1a] uppercase tracking-wider mb-5 pb-2 border-b border-[#f0ede5] flex items-center gap-2">
                                            <svg class="w-4 h-4 text-[#e8a000]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                                            Status Pelacakan
                                        </h4>
                                        
                                        <div class="relative flex flex-col space-y-6 my-2 pl-2">
                                            <!-- Vertical connecting line -->
                                            <div class="absolute top-2 bottom-2 bg-gray-300 z-0" style="width: 2px; left: 15px;"></div>

                                            @{ var steps = GetGroupSteps(groupItems); }
                                            @for (int i = 0; i < steps.Count; i++)
                                            {
                                                var step = steps[i];
                                                <div class="flex items-start gap-4 relative z-10">
                                                    <!-- Circle indicator wrapper -->
                                                    <div class="w-4 h-4 flex items-center justify-center shrink-0 mt-0.5 bg-white border rounded-full z-10
                                                        @(step.Status == "DONE" ? "border-emerald-600" :
                                                          step.Status == "ACTIVE" ? "border-blue-600 animate-pulse" :
                                                          step.Status == "WARNING" ? "border-rose-600" :
                                                          "border-gray-300")">
                                                        @if (step.Status == "DONE") {
                                                            <div class="w-full h-full rounded-full bg-[#1a7a30] flex items-center justify-center shrink-0">
                                                                <svg class="w-2.5 h-2.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                                                            </div>
                                                        } else if (step.Status == "ACTIVE") {
                                                            <span class="relative flex h-2 w-2 items-center justify-center">
                                                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
                                                                <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-600"></span>
                                                            </span>
                                                        } else if (step.Status == "WARNING") {
                                                            <div class="w-full h-full rounded-full bg-[#d94040] flex items-center justify-center shrink-0">
                                                                <svg class="w-2.5 h-2.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                                                            </div>
                                                        } else {
                                                            <div class="w-1.5 h-1.5 rounded-full bg-gray-300"></div>
                                                        }
                                                    </div>
                                                    <!-- Text Info -->
                                                    <div class="flex flex-col min-w-0">
                                                        <span class="text-xs font-bold @(step.Status == "DONE" ? "text-[#1a7a30]" : step.Status == "ACTIVE" ? "text-blue-600" : step.Status == "WARNING" ? "text-[#d94040]" : "text-gray-500")">@step.Name</span>
                                                        <span class="text-[10px] text-gray-400 leading-tight">
                                                            @if (step.Status == "DONE") {
                                                                <span>Selesai dilakukan</span>
                                                            } else if (step.Status == "ACTIVE") {
                                                                <span>Sedang diproses</span>
                                                            } else if (step.Status == "WARNING") {
                                                                <span>Butuh perhatian / revisi</span>
                                                            } else {
                                                                <span>Menunggu antrean</span>
                                                            }
                                                        </span>
                                                        @if (!string.IsNullOrEmpty(step.SubLabel)) {
                                                            <span class="text-[9px] font-semibold mt-0.5 @(step.Status == "DONE" ? "text-emerald-600" : step.Status == "ACTIVE" ? "text-blue-500" : "text-gray-400")">
                                                                @step.SubLabel
                                                            </span>
                                                        }
                                                        @if (step.CompletedAt.HasValue) {
                                                            <span class="text-[9px] text-gray-400 mt-0.5 flex items-center gap-1">
                                                                <svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0"/></svg>
                                                                @step.CompletedAt.Value.ToString("dd MMM yyyy HH:mm")
                                                            </span>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- Kolom 2: Detail, Aksi, & Daftar Produk (3/4 Lebar pada Desktop) -->
                                    <div class="lg:col-span-3 space-y-4">
                                        
                                        <!-- PDF Bookkeeping Download Checklist (Dipindahkan & Dipercantik) -->
                                        @{
                                            var requestReceiptReady = isGiveaway
                                                ? giveawayItemsOnly.Any(i =>
                                                    i.status == WorkflowStatuses.PendingAdmin ||
                                                    i.status == WorkflowStatuses.PendingManager ||
                                                    i.status == WorkflowStatuses.WaitingHandover ||
                                                    i.status == WorkflowStatuses.WaitingAdminHandover ||
                                                    i.status == WorkflowStatuses.WaitingDocumentation ||
                                                    i.status == WorkflowStatuses.DocumentationOverdue ||
                                                    i.status == WorkflowStatuses.Completed ||
                                                    i.status == WorkflowStatuses.Approved ||
                                                    i.status == WorkflowStatuses.RevisionByAdmin ||
                                                    i.status == WorkflowStatuses.RevisionByManager)
                                                : borrowItemsOnly.Any(i =>
                                                    i.status == WorkflowStatuses.PendingAdmin ||
                                                    i.status == WorkflowStatuses.Pending ||
                                                    i.status == WorkflowStatuses.WaitingHandover ||
                                                    i.status == WorkflowStatuses.WaitingAdminHandover ||
                                                    i.status == WorkflowStatuses.Approved ||
                                                    i.status == WorkflowStatuses.RevisionByAdmin ||
                                                    i.status == WorkflowStatuses.RevisionByStaffInventory ||
                                                    i.status == WorkflowStatuses.WaitingHandoverConfirm);

                                            var handoverReceiptReady = groupItems.Any(i => TransactionService.HasStoredFiles(i.handover_photo));
                                            var documentationReceiptReady = isGiveaway && giveawayItemsOnly.Any(i => TransactionService.HasStoredFiles(i.documentation_photo));
                                            var returnReceiptReady = !isGiveaway && borrowItemsOnly.Any(i => i.returned_quantity > 0 || (i.pending_return_quantity > 0 && i.is_return_draft == 0));
                                        }

                                        <div class="bg-white p-4 rounded-xl border border-[#e5e3dc] shadow-sm flex flex-wrap gap-2.5 items-center">
                                            <span class="text-[0.65rem] font-bold uppercase tracking-wider text-[#8a8780] mr-2 block w-full sm:w-auto">Dokumen Pembukuan (PDF):</span>

                                            @if (requestReceiptReady)
                                            {
                                                <a href="/api/pdf/receipt-request/@firstItem.group_id" target="_blank" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-gray-50 hover:bg-gray-100 border border-gray-200 text-gray-700 rounded-lg text-xs font-semibold transition shadow-sm">
                                                    <svg class="w-3.5 h-3.5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                                    1. Bukti Pengajuan
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-gray-100/50 border border-gray-200/50 text-gray-400 rounded-lg text-xs font-semibold cursor-not-allowed" title="Bisa diakses setelah permohonan disetujui/diproses.">
                                                    <svg class="w-3.5 h-3.5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                                    1. Bukti Pengajuan
                                                </span>
                                            }

                                            @if (handoverReceiptReady)
                                            {
                                                <a href="/api/pdf/receipt-handover/@firstItem.group_id" target="_blank" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-purple-50 hover:bg-purple-100 border border-purple-200 text-purple-700 rounded-lg text-xs font-semibold transition shadow-sm">
                                                    <svg class="w-3.5 h-3.5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                                    2. Bukti Penyerahan
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-gray-100/50 border border-gray-200/50 text-gray-400 rounded-lg text-xs font-semibold cursor-not-allowed" title="Bisa diakses setelah bukti penyerahan diunggah.">
                                                    <svg class="w-3.5 h-3.5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                                    2. Bukti Penyerahan
                                                </span>
                                            }

                                            @if (isGiveaway)
                                            {
                                                @if (documentationReceiptReady)
                                                {
                                                    <a href="/api/pdf/receipt-documentation/@firstItem.group_id" target="_blank" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 text-emerald-700 rounded-lg text-xs font-semibold transition shadow-sm">
                                                        <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                                        3. Bukti Dokumentasi
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-gray-100/50 border border-gray-200/50 text-gray-400 rounded-lg text-xs font-semibold cursor-not-allowed" title="Bisa diakses setelah user mengunggah dokumentasi.">
                                                        <svg class="w-3.5 h-3.5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                                        3. Bukti Dokumentasi
                                                    </span>
                                                }
                                            }
                                            else
                                            {
                                                @if (returnReceiptReady)
                                                {
                                                    <a href="/api/pdf/receipt-return/@firstItem.group_id" target="_blank" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 text-emerald-700 rounded-lg text-xs font-semibold transition shadow-sm">
                                                        <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                                        3. Bukti Pengembalian
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-gray-100/50 border border-gray-200/50 text-gray-400 rounded-lg text-xs font-semibold cursor-not-allowed" title="Bisa diakses setelah barang dikembalikan.">
                                                        <svg class="w-3.5 h-3.5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                                        3. Bukti Pengembalian
                                                    </span>
                                                }
                                            }
                                        </div>

                                        <!-- Informasi Detail & Tombol Aksi Utama -->
                                        <div class="bg-white p-5 rounded-2xl border border-[#e5e3dc] shadow-sm space-y-4">
                                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                                @if (isGiveaway)
                                                {
                                                    <div class="bg-[#fafbfb] p-3 rounded-xl border border-[#e5e3dc]/50">
                                                        <span class="block text-[10px] font-bold text-[#8a8880] uppercase tracking-wider">Rencana Pengambilan</span>
                                                        <span class="text-xs font-bold text-[#1a1a1a] flex items-center gap-1.5 mt-1.5">
                                                            <svg class="w-4 h-4 text-[#e8a000]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                                            @(pickupDate?.ToString("dd MMM yyyy") ?? "-")
                                                        </span>
                                                    </div>
                                                    <div class="bg-[#fafbfb] p-3 rounded-xl border border-[#e5e3dc]/50">
                                                        <span class="block text-[10px] font-bold text-[#8a8880] uppercase tracking-wider">Tanggal Event</span>
                                                        <span class="text-xs font-bold text-[#1a7a30] flex items-center gap-1.5 mt-1.5">
                                                            <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                                            @(firstItem.event_date?.ToString("dd MMM yyyy") ?? "-")
                                                        </span>
                                                    </div>
                                                    <div class="bg-[#fafbfb] p-3 rounded-xl border border-[#e5e3dc]/50">
                                                        <span class="block text-[10px] font-bold text-[#8a8880] uppercase tracking-wider">Total Credit</span>
                                                        <span class="text-xs font-bold text-[#e8a000] flex items-center gap-1.5 mt-1.5">
                                                            <svg class="w-4 h-4 text-[#e8a000]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                                            </svg>
                                                            @(groupItems.Sum(i => (i.quantity ?? 0) * (i.Product?.value ?? 0)).ToString("N0")) pts
                                                        </span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="bg-[#fafbfc] p-3 rounded-xl border border-[#e5e3dc]/50">
                                                        <span class="block text-[10px] font-bold text-[#8a8880] uppercase tracking-wider">Masa Pinjam</span>
                                                        <span class="text-xs font-bold text-[#1a6b8a] flex items-center gap-1.5 mt-1.5">
                                                            <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                                            @(borrowStartDate?.ToString("dd MMM yyyy") ?? "-") - @(expectedReturnDate?.ToString("dd MMM yyyy") ?? "-")
                                                        </span>
                                                    </div>
                                                    <div class="bg-[#fafbfc] p-3 rounded-xl border border-[#e5e3dc]/50">
                                                        <span class="block text-[10px] font-bold text-[#8a8880] uppercase tracking-wider">Progress Return</span>
                                                        <span class="text-xs font-bold text-[#1a1a1a] flex items-center gap-1.5 mt-1.5">
                                                            <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                                            @(borrowItemsOnly.Count(i => (i.returned_quantity ?? 0) >= (i.quantity ?? 0)))/@(borrowItemsOnly.Count) Item Kembali
                                                        </span>
                                                    </div>
                                                    <div class="bg-[#fafbfc] p-3 rounded-xl border border-[#e5e3dc]/50">
                                                        <span class="block text-[10px] font-bold text-[#8a8880] uppercase tracking-wider">Batas Waktu</span>
                                                        <span class="text-xs font-bold flex items-center gap-1.5 mt-1.5 @(isBorrowOverdue ? "text-[#d94040]" : "text-amber-700")">
                                                            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                                            @(isBorrowOverdue ? "Lewat Jatuh Tempo!" : expectedReturnDate.HasValue ? $"Jatuh tempo {expectedReturnDate.Value:dd MMM yyyy}" : "Aktif")
                                                        </span>
                                                    </div>
                                                }
                                            </div>

                                             @if (isWaitingUserConfirm)
                                             {
                                                 // Calculate remaining time until dispute window expires (24 hours from handover_timestamp or updated_at)
                                                 var firstWaitingItem = borrowItemsOnly.FirstOrDefault(i => i.status == WorkflowStatuses.WaitingHandoverConfirm || i.status == WorkflowStatuses.Approved);
                                                 var baseTime = firstWaitingItem?.handover_timestamp ?? firstWaitingItem?.updated_at ?? WibHelper.Now;
                                                 var autoConfirmTime = baseTime.AddHours(24);
                                                 var localAutoConfirmTime = autoConfirmTime; // already in WIB
                                                 var timeLeft = autoConfirmTime - WibHelper.Now; // both in WIB
                                                 var timeLeftStr = timeLeft.TotalSeconds > 0
                                                     ? $"{(int)timeLeft.TotalHours} jam {timeLeft.Minutes} menit"
                                                     : "segera";
                                                 var isActuallyApproved = firstWaitingItem?.status == WorkflowStatuses.Approved;

                                                 <div class="flex flex-col sm:flex-row sm:items-center gap-3.5 bg-[#eef6fd] border border-[#bae6fd] p-4 rounded-xl w-full shadow-sm">
                                                     <div class="flex items-start gap-2.5 text-[#1a6b8a] flex-1">
                                                         <svg class="shrink-0 mt-0.5" style="width: 20px; height: 20px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                                         <div>
                                                             <div class="text-xs font-extrabold uppercase tracking-wide">
                                                                 @(isActuallyApproved ? "Peminjaman Aktif" : "Penerimaan Barang Sedang Berlangsung")
                                                             </div>
                                                             <div class="text-[11px] font-semibold mt-1 leading-relaxed text-[#2c5282]">
                                                                 @if (isActuallyApproved)
                                                                 {
                                                                     <span>Barang telah diserahterimakan dan masa peminjaman Anda saat ini sudah aktif. Jika Anda merasa belum menerima barang ini secara fisik, Anda dapat mengajukan keberatan dalam waktu <strong>@timeLeftStr</strong> (sebelum @localAutoConfirmTime.ToString("dd MMM yyyy, HH:mm") WIB).</span>
                                                                 }
                                                                 else
                                                                 {
                                                                     <span>Staff Inventoris telah menyerahkan barang. Jika benar sudah menerima, Anda tidak perlu melakukan aksi apa pun. Sistem akan menyetujui otomatis dalam <strong>@timeLeftStr</strong> (pada @localAutoConfirmTime.ToString("dd MMM yyyy, HH:mm") WIB).</span>
                                                                 }
                                                             </div>
                                                         </div>
                                                     </div>
                                                     <div class="shrink-0 self-end sm:self-center mt-2 sm:mt-0">
                                                         <button type="button"
                                                             @onclick="() => OpenDisputeModal(borrowItemsOnly)"
                                                             disabled="@IsSubmitting"
                                                             class="inline-flex items-center gap-1.5 px-4 py-2.5 bg-red-600 hover:bg-red-700 text-white text-[11px] font-extrabold rounded-xl transition active:scale-95 shadow-sm whitespace-nowrap">
                                                             <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                                                             Saya Belum Menerima Barang
                                                         </button>
                                                     </div>
                                                 </div>
                                             }
                                            @if (canHandover || canGiveawayHandover || canUploadDocumentation || groupItems.Any(i => i.returned_quantity > 0 || (i.pending_return_quantity > 0 && i.is_return_draft == 0)))
                                            {
                                                <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-[#f0ede5]">
                                                    <span class="text-xs font-bold text-[#8a8880]">Aksi Grup:</span>
                                                    <div class="flex flex-wrap gap-2">
                                                        @if (canHandover)
                                                        {
                                                            @if (!hasHandoverDraftPhoto)
                                                            {
                                                                <button type="button" @onclick="() => OpenHandoverModal(borrowItemsOnly)" class="inline-flex items-center gap-1.5 px-4 py-2 bg-[#e8a000] hover:bg-[#d49300] text-[#1a1a1a] text-xs font-bold rounded-lg transition active:scale-95 shadow-sm whitespace-nowrap">
                                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
                                                                    Upload Bukti Serah Terima
                                                                </button>
                                                            }
                                                            else
                                                            {
                                                                <button type="button" @onclick="() => OpenHandoverModal(borrowItemsOnly)" class="inline-flex items-center gap-1.5 px-3 py-2 bg-white border border-[#e5e3dc] text-[#3a3835] hover:border-[#1a1a1a] text-xs font-bold rounded-lg transition">
                                                                    Ganti Foto
                                                                </button>
                                                                <button type="button" @onclick='() => AskConfirm("Submit Bukti Serah Terima", "Kirim bukti serah terima ke admin?", () => SubmitHandoverToAdmin(borrowItemsOnly), "Ya, Submit")' disabled="@IsSubmitting" class="inline-flex items-center gap-1.5 px-4 py-2 bg-[#1a7a30] hover:bg-[#166528] text-white text-xs font-bold rounded-lg shadow-sm transition disabled:opacity-50">
                                                                    Submit ke Admin
                                                                </button>
                                                            }
                                                        }
                                                        @if (canGiveawayHandover)
                                                        {
                                                            @if (!hasGiveawayHandoverDraftPhoto)
                                                            {
                                                                <button type="button" @onclick="() => OpenHandoverModal(giveawayItemsOnly)" class="inline-flex items-center gap-1.5 px-4 py-2 bg-[#e8a000] hover:bg-[#d49300] text-[#1a1a1a] text-xs font-bold rounded-lg transition active:scale-95 shadow-sm whitespace-nowrap">
                                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
                                                                    Upload Bukti Serah Terima
                                                                </button>
                                                            }
                                                            else
                                                            {
                                                                <button type="button" @onclick="() => OpenHandoverModal(giveawayItemsOnly)" class="inline-flex items-center gap-1.5 px-3 py-2 bg-white border border-[#e5e3dc] text-[#3a3835] hover:border-[#1a1a1a] text-xs font-bold rounded-lg transition">
                                                                    Ganti Foto
                                                                </button>
                                                                <button type="button" @onclick='() => AskConfirm("Submit Bukti Serah Terima", "Selesaikan serah terima giveaway ini?", () => SubmitHandoverToAdmin(giveawayItemsOnly), "Ya, Selesaikan")' disabled="@IsSubmitting" class="inline-flex items-center gap-1.5 px-4 py-2 bg-[#1a7a30] hover:bg-[#166528] text-white text-xs font-bold rounded-lg shadow-sm transition disabled:opacity-50">
                                                                    Selesaikan Serah Terima
                                                                </button>
                                                            }
                                                        }
                                                        @if (canUploadDocumentation)
                                                        {
                                                            <button type="button" @onclick="() => OpenDocumentationModal(giveawayItemsOnly)" class="inline-flex items-center gap-1.5 px-4 py-2 bg-[#1a7a30] hover:bg-[#166528] text-white text-xs font-bold rounded-lg transition active:scale-95 shadow-sm whitespace-nowrap">
                                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 16v-8m0 0-3 3m3-3 3 3M5 20h14"/></svg>
                                                                Upload Dokumentasi
                                                            </button>
                                                        }
                                                        @if (groupItems.Any(i => i.returned_quantity > 0 || (i.pending_return_quantity > 0 && i.is_return_draft == 0)))
                                                        {
                                                            <a href="/api/pdf/receipt-return/@firstItem.group_id" target="_blank" class="inline-flex items-center gap-1.5 px-3 py-2 bg-white border border-[#b8e8c0] text-[#1a7a30] hover:bg-[#eef9f0] rounded-lg text-xs font-bold transition shadow-sm">
                                                                <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                                                PDF Bukti Pengembalian
                                                            </a>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>

                                        <!-- Alerts & Warning Messages (Revisi / Rejection) -->
                                        @if (status == "REVISION" || status == "REVISION_BY_STAFF_INVENTORY" || status == "REVISION_BY_ADMIN" || status == "REVISION_BY_MANAGER")
                                        {
                                            <div class="p-4 bg-[#fffbeb] rounded-xl border border-[#fde68a] flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 shadow-sm">
                                                <div class="flex items-start gap-3">
                                                    <div class="p-2 bg-[#fef3c7] text-[#d97706] rounded-lg shrink-0 mt-0.5 animate-pulse">
                                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                                                    </div>
                                                    <div>
                                                        <h4 class="text-sm font-extrabold text-[#d97706]">Permintaan Membutuhkan Revisi</h4>
                                                        @if (!string.IsNullOrEmpty(firstItem.rejection_reason))
                                                        {
                                                            <p class="text-xs text-[#92400e] font-medium mt-0.5">Catatan/Alasan Staff: <span class="italic font-bold">"@firstItem.rejection_reason"</span></p>
                                                        }
                                                        <p class="text-[11px] text-[#b45309] mt-1">Silakan klik tombol "Revisi" pada tabel item di bawah untuk memasukkan kembali pengajuan ke keranjang dan memperbaikinya.</p>
                                                    </div>
                                                </div>
                                                <div class="flex gap-2 shrink-0 w-full sm:w-auto">
                                                    <!-- Removed Revise All button -->
                                                </div>
                                            </div>
                                        }

                                        @if(status == "WAITING_HANDOVER" && !string.IsNullOrEmpty(firstItem.rejection_reason))
                                        {
                                            <div class="p-4 bg-[#fef0f0] rounded-xl border border-[#f8c0c0] flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 shadow-sm animate-pulse">
                                                <div class="flex items-start gap-3">
                                                    <div class="p-2 bg-[#fde2e2] text-[#d94040] rounded-lg shrink-0 mt-0.5">
                                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                                                    </div>
                                                    <div>
                                                        <h4 class="text-sm font-extrabold text-[#d94040]">Bukti Serah Terima Ditolak Admin</h4>
                                                        <p class="text-xs text-[#d94040] font-medium mt-0.5">Alasan: <span class="italic">"@firstItem.rejection_reason"</span></p>
                                                    </div>
                                                </div>
                                                <button type="button" @onclick='() => OpenHandoverModal(borrowItemsOnly)' class="inline-flex items-center gap-1.5 px-4 py-2 bg-[#d94040] hover:bg-[#b83535] text-white text-xs font-bold rounded-lg transition shadow-sm">
                                                    Upload Ulang Bukti
                                                </button>
                                            </div>
                                        }



                                        <!-- Preview Dokumentasi User -->
                                        @if (isGiveaway && TransactionService.ParseStoredFiles(firstItem.documentation_photo).Any())
                                        {
                                            var documentationFiles = TransactionService.ParseStoredFiles(firstItem.documentation_photo);
                                            <div class="p-4 bg-white rounded-xl border border-[#e5e3dc] shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                                                <div class="flex items-start gap-4">
                                                    <div class="flex flex-wrap gap-3">
                                                        @foreach (var documentationFile in documentationFiles.Take(4))
                                                        {
                                                            var documentationPhotoSrc = ImageHelper.Resolve(documentationFile);
                                                            if (documentationFile.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                                                            {
                                                                <a href="@documentationPhotoSrc" target="_blank" class="block w-20 h-20 rounded border border-gray-200 overflow-hidden bg-red-50 flex items-center justify-center flex-shrink-0 hover:opacity-95 transition cursor-pointer">
                                                                    <svg class="w-8 h-8 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                                                                </a>
                                                            }
                                                            else
                                                            {
                                                                <a href="@documentationPhotoSrc" data-image-popup class="block w-20 h-20 rounded border border-gray-200 overflow-hidden bg-gray-50 flex-shrink-0 hover:opacity-95 transition cursor-pointer">
                                                                    <img src="@documentationPhotoSrc" alt="Dokumentasi User" class="w-full h-full object-cover">
                                                                </a>
                                                            }
                                                        }
                                                    </div>
                                                    <div>
                                                        <h4 class="text-xs font-bold text-gray-900 tracking-wider uppercase">Dokumentasi User</h4>
                                                        <p class="text-[11px] text-gray-500 mt-1">Total file: @documentationFiles.Count</p>
                                                        <p class="text-xs text-gray-600 leading-relaxed max-w-xl italic">"@(firstItem.documentation_notes ?? "-")"</p>
                                                        <p class="text-[11px] text-gray-500 mt-1">Diupload: @(firstItem.documentation_uploaded_at?.ToString("dd MMM yyyy HH:mm") ?? "-")</p>
                                                    </div>
                                                </div>
                                            </div>
                                        }

                                        <!-- Daftar Produk (Hybrid View) -->
                                        <div>
                                            @{
                                                var showAllProducts = ShowAllProductsGroupIds.Contains(groupId);
                                                var productsToRender = showAllProducts ? groupItems : groupItems.Take(3).ToList();
                                            }
                                            <!-- Desktop View (Tabel Minimalis Kompak) -->
                                            <div class="hidden md:block overflow-hidden rounded-xl border border-[#e5e3dc] shadow-sm bg-white">
                                                <table class="w-full text-left border-collapse">
                                                    <thead>
                                                        <tr class="bg-[#f5f4f0] border-b border-[#e5e3dc]">
                                                            <th class="px-4 py-2.5 text-[0.65rem] font-bold tracking-wider uppercase text-[#8a8780]">Product</th>
                                                            <th class="px-4 py-2.5 text-[0.65rem] font-bold tracking-wider uppercase text-[#8a8780] w-20">Qty</th>
                                                            <th class="px-4 py-2.5 text-[0.65rem] font-bold tracking-wider uppercase text-[#8a8780] w-44">Status Detail</th>
                                                            <th class="px-4 py-2.5 text-[0.65rem] font-bold tracking-wider uppercase text-[#8a8780] w-36">Approved By</th>
                                                            <th class="px-4 py-2.5 text-[0.65rem] font-bold tracking-wider uppercase text-[#8a8780] w-40">Bukti Serah Terima</th>
                                                            <th class="px-4 py-2.5 text-[0.65rem] font-bold tracking-wider uppercase text-[#8a8780]">Catatan</th>
                                                            <th class="px-4 py-2.5 text-[0.65rem] font-bold tracking-wider uppercase text-[#8a8780] text-right w-36">Aksi</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody class="divide-y divide-[#e5e3dc]">
                                                        @foreach(var usage in productsToRender)
                                                        {
                                                            <tr class="hover:bg-[#faf9f5] transition-colors">
                                                                <td class="px-4 py-3 align-middle">
                                                                    <div class="flex items-center gap-3">
                                                                        @if (usage.Product != null && !string.IsNullOrEmpty(usage.Product.image))
                                                                        {
                                                                            <div class="w-9 h-9 rounded border border-[#e5e3dc] overflow-hidden shrink-0 bg-white">
                                                                                <img src="@ImageHelper.Resolve(usage.Product.image)" class="w-full h-full object-cover" />
                                                                            </div>
                                                                        }
                                                                        else if (usage.ProductVariant != null && !string.IsNullOrEmpty(usage.ProductVariant.image))
                                                                        {
                                                                            <div class="w-9 h-9 rounded border border-[#e5e3dc] overflow-hidden shrink-0 bg-white">
                                                                                <img src="@ImageHelper.Resolve(usage.ProductVariant.image)" class="w-full h-full object-cover" />
                                                                            </div>
                                                                        }
                                                                        <div>
                                                                            <div class="text-xs font-semibold text-[#1a1a1a]">
                                                                                @(usage.Product?.name ?? "-")
                                                                                @if(usage.ProductVariant != null) {
                                                                                    var variantTexts = new List<string>();
                                                                                    if (!string.IsNullOrEmpty(usage.ProductVariant.color)) variantTexts.Add(usage.ProductVariant.color);
                                                                                    if (!string.IsNullOrEmpty(usage.ProductVariant.size)) variantTexts.Add(usage.ProductVariant.size);
                                                                                    if (variantTexts.Any()) {
                                                                                        <span class="text-[11px] text-gray-500 font-normal ml-1">(@string.Join(", ", variantTexts))</span>
                                                                                    }
                                                                                }
                                                                            </div>
                                                                            <div class="flex items-center gap-2 mt-0.5 flex-wrap">
                                                                                <code class="text-[9px] text-gray-500 font-mono">@(usage.Product?.sku ?? "-")</code>
                                                                                <span class="inline-flex items-center gap-1 bg-amber-50 text-amber-700 px-1 py-0.5 rounded border border-amber-200 text-[9px] font-semibold">
                                                                                    Credit/Item: @(usage.Product?.value.ToString("N0") ?? "0") pts
                                                                                </span>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </td>
                                                                <td class="px-4 py-3 align-middle text-xs">
                                                                    <span class="font-bold text-[#1a1a1a]">@usage.quantity</span>
                                                                    <span class="text-gray-500 text-[11px]">@(usage.Product?.Unit?.name ?? "unit")</span>
                                                                    @if (usage.original_quantity.HasValue && usage.original_quantity.Value != usage.quantity)
                                                                    {
                                                                        <div class="mt-1">
                                                                            <span class="inline-flex items-center gap-1 bg-rose-50 text-rose-700 px-1 py-0.5 rounded border border-rose-100 text-[9px] font-semibold">
                                                                                Revisi qty: @usage.original_quantity.Value -> @usage.quantity
                                                                            </span>
                                                                        </div>
                                                                    }
                                                                </td>
                                                                <td class="px-4 py-3 align-middle">
                                                                    @if(usage.status == "PENDING" || usage.status == "PENDING_ADMIN") {
                                                                        <span class="inline-flex items-center px-1.5 py-0.5 border border-[#fde68a] rounded text-[9px] font-bold bg-[#fef3c7] text-[#92400e]">Menunggu Admin</span>
                                                                    } else if (usage.status == "PENDING_STAFF_INVENTORY") {
                                                                        <span class="inline-flex items-center px-1.5 py-0.5 border border-[#fde68a] rounded text-[9px] font-bold bg-[#fef3c7] text-[#92400e]">Menunggu Staff Inventoris</span>
                                                                    } else if (usage.status == "PENDING_MANAGER") {
                                                                        <span class="inline-flex items-center px-1.5 py-0.5 border border-[#c4b5fd] rounded text-[9px] font-bold bg-[#ede9fe] text-[#6d28d9]">Menunggu Manager</span>
                                                                    } else if (usage.status == "WAITING_HANDOVER") {
                                                                        if (TransactionService.HasStoredFiles(usage.handover_photo))
                                                                        {
                                                                            <span class="inline-flex items-center px-1.5 py-0.5 border border-[#c4b5fd] rounded text-[9px] font-bold bg-[#ede9fe] text-[#6d28d9]">DRAFT - Belum Dikirim</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="inline-flex items-center px-1.5 py-0.5 border border-[#fde68a] rounded text-[9px] font-bold bg-[#fef3c7] text-[#92400e]">Menunggu Bukti Serah Terima</span>
                                                                        }
                                                                    } else if (usage.status == "WAITING_ADMIN_HANDOVER") {
                                                                        <span class="inline-flex items-center px-1.5 py-0.5 border border-[#bae6fd] rounded text-[9px] font-bold bg-[#e0f2fe] text-[#1a6b8a]">Menunggu Verifikasi Admin</span>
                                                                    } else if (usage.status == "WAITING_HANDOVER_CONFIRM") {
                                                                        <span class="inline-flex items-center px-1.5 py-0.5 border border-[#bae6fd] rounded text-[9px] font-bold bg-[#e0f2fe] text-[#1a6b8a]">Menunggu Konfirmasi User</span>
                                                                    } else if (usage.status == "WAITING_DOCUMENTATION") {
                                                                        <span class="inline-flex items-center px-1.5 py-0.5 border border-[#c8e6c9] rounded text-[9px] font-bold bg-[#e8f5e9] text-[#2e7d32]">Menunggu Dokumentasi User</span>
                                                                    } else if (usage.status == "DOCUMENTATION_OVERDUE") {
                                                                        <span class="inline-flex items-center px-1.5 py-0.5 border border-[#f8c0c0] rounded text-[9px] font-bold bg-[#fef0f0] text-[#d94040]">Dokumentasi Overdue</span>
                                                                    } else if (usage.status == "APPROVED" || usage.status == "COMPLETED") {
                                                                        @if (usage.request_type == "BORROW") {
                                                                            @if (usage.returned_quantity >= usage.quantity) {
                                                                                <span class="inline-flex items-center px-1.5 py-0.5 border border-[#b8e8c0] rounded text-[9px] font-bold bg-[#eef9f0] text-[#1a7a30]">Sudah Kembali (@usage.returned_quantity/@usage.quantity)</span>
                                                                            } else if (usage.pending_return_quantity > 0 && usage.is_return_draft == 1) {
                                                                                <span class="inline-flex items-center px-1.5 py-0.5 border border-[#c4b5fd] rounded text-[9px] font-bold bg-[#ede9fe] text-[#6d28d9]">DRAFT (@usage.pending_return_quantity @(usage.Product?.Unit?.name ?? "unit"))</span>
                                                                            } else if (usage.pending_return_quantity > 0 && usage.is_return_draft == 0) {
                                                                                <span class="inline-flex items-center px-1.5 py-0.5 border border-[#bae6fd] rounded text-[9px] font-bold bg-[#e0f2fe] text-[#1a6b8a]">Menunggu ACC (@usage.pending_return_quantity)</span>
                                                                            } else {
                                                                                <span class="inline-flex items-center px-1.5 py-0.5 border border-[#fde68a] rounded text-[9px] font-bold bg-[#fef3c7] text-[#92400e]">Belum Kembali (@usage.returned_quantity/@usage.quantity)</span>
                                                                            }
                                                                        } else {
                                                                            <span class="inline-flex items-center px-1.5 py-0.5 border border-[#b8e8c0] rounded text-[9px] font-bold bg-[#eef9f0] text-[#1a7a30]">Selesai / Diterima</span>
                                                                        }
                                                                    } else if (usage.status == "REJECTED") {
                                                                        @if (!string.IsNullOrEmpty(usage.last_revision_stage) || IsRevisionStatus(usage.status))
                                                                        {
                                                                            <div class="space-y-1">
                                                                                <span class="inline-flex items-center px-1.5 py-0.5 border border-[#fde68a] rounded text-[9px] font-bold bg-[#fffbeb] text-[#d97706]">Butuh Revisi</span>
                                                                                <div class="text-[10px] font-semibold text-[#b45309]">Oleh @GetRevisionActorLabel(usage)</div>
                                                                            </div>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="inline-flex items-center px-1.5 py-0.5 border border-[#f8c0c0] rounded text-[9px] font-bold bg-[#fef0f0] text-[#d94040]">Ditolak</span>
                                                                            @if (!string.IsNullOrEmpty(usage.rejection_reason))
                                                                            {
                                                                                <div class="text-[10px] text-[#d94040] mt-1 italic font-semibold">"@usage.rejection_reason"</div>
                                                                            }
                                                                        }
                                                                    } else if (usage.status == "REVISION" || usage.status == "REVISION_BY_STAFF_INVENTORY" || usage.status == "REVISION_BY_ADMIN" || usage.status == "REVISION_BY_MANAGER") {
                                                                        <div class="space-y-1">
                                                                            <span class="inline-flex items-center px-1.5 py-0.5 border border-[#fde68a] rounded text-[9px] font-bold bg-[#fffbeb] text-[#d97706]">Butuh Revisi</span>
                                                                            <div class="text-[10px] font-semibold text-[#b45309]">Oleh @GetRevisionActorLabel(usage)</div>
                                                                        </div>
                                                                    }
                                                                </td>
                                                                <td class="px-4 py-3 align-middle text-xs">
                                                                     <div class="space-y-1">
                                                                         @if (usage.status != "PENDING_STAFF_INVENTORY" && usage.status != "REJECTED_BY_STAFF_INVENTORY")
                                                                         {
                                                                             <div class="text-[11px] leading-tight flex items-center gap-1">
                                                                                 <span class="font-bold text-[#e8a000] text-[10px] uppercase">Staff Inv:</span> 
                                                                                 <span class="text-[#1a1a1a] font-semibold">@(usage.StaffInventoryApprover != null ? usage.StaffInventoryApprover.name : (usage.Approver?.role?.Contains("staff") == true ? usage.Approver.name : "Disetujui"))</span>
                                                                             </div>
                                                                         }
                                                                         @if (usage.status == "PENDING_MANAGER" || usage.status == "WAITING_HANDOVER" || usage.status == "WAITING_ADMIN_HANDOVER" || usage.status == "WAITING_DOCUMENTATION" || usage.status == "APPROVED" || usage.status == "COMPLETED")
                                                                         {
                                                                             <div class="text-[11px] leading-tight flex items-center gap-1">
                                                                                 <span class="font-bold text-[#e8a000] text-[10px] uppercase">Admin:</span> 
                                                                                 <span class="text-[#1a1a1a] font-semibold">@(usage.AdminApprover != null ? usage.AdminApprover.name : (usage.Approver?.role?.Contains("admin") == true ? usage.Approver.name : "Disetujui"))</span>
                                                                             </div>
                                                                         }
                                                                         @if (usage.request_type == "GIVEAWAY" && (usage.status == "WAITING_HANDOVER" || usage.status == "WAITING_ADMIN_HANDOVER" || usage.status == "WAITING_DOCUMENTATION" || usage.status == "APPROVED" || usage.status == "COMPLETED"))
                                                                         {
                                                                             <div class="text-[11px] leading-tight flex items-center gap-1">
                                                                                 <span class="font-bold text-[#e8a000] text-[10px] uppercase">Manager:</span> 
                                                                                 <span class="text-[#1a1a1a] font-semibold">@(usage.ManagerApprover != null ? usage.ManagerApprover.name : (usage.Approver?.role?.Contains("manager") == true ? usage.Approver.name : "Disetujui"))</span>
                                                                             </div>
                                                                         }
                                                                         @if (usage.status == "PENDING_STAFF_INVENTORY" || usage.status == "PENDING_ADMIN" || usage.status == "PENDING")
                                                                         {
                                                                             <span class="text-gray-400 text-[10px] italic">Menunggu Approval</span>
                                                                         }
                                                                         @if (usage.Approver != null && usage.status != "PENDING_STAFF_INVENTORY" && usage.status != "PENDING_ADMIN" && usage.status != "PENDING")
                                                                         {
                                                                             <div class="text-[9px] text-gray-400 font-medium">Penyetuju Akhir: @usage.Approver.name</div>
                                                                         }
                                                                     </div>
                                                                </td>
                                                                <td class="px-4 py-3 align-middle">
                                                                    @{
                                                                        var handoverFiles = TransactionService.ParseStoredFiles(usage.handover_photo);
                                                                    }
                                                                    @if (handoverFiles.Any())
                                                                    {
                                                                        <div class="flex flex-col gap-1">
                                                                            <div class="flex items-center gap-1.5 flex-wrap">
                                                                                @foreach (var file in handoverFiles.Take(3))
                                                                                {
                                                                                    var fileSrc = ImageHelper.Resolve(file);
                                                                                    <div class="w-8 h-8 rounded border border-[#e5e3dc] overflow-hidden bg-white shrink-0 shadow-sm hover:scale-105 transition duration-150">
                                                                                        @if (file.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                                                                                        {
                                                                                            <a href="@fileSrc" target="_blank" class="w-full h-full flex items-center justify-center bg-red-50 text-red-500">
                                                                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                                                                                            </a>
                                                                                        }
                                                                                        else
                                                                                        {
                                                                                            <a href="@fileSrc" target="_blank" data-image-popup class="w-full h-full block">
                                                                                                <img src="@fileSrc" class="w-full h-full object-cover" />
                                                                                            </a>
                                                                                        }
                                                                                    </div>
                                                                                }
                                                                                @if (handoverFiles.Count > 3)
                                                                                {
                                                                                    <span class="text-[9px] font-bold text-gray-400">+@(handoverFiles.Count - 3)</span>
                                                                                }
                                                                            </div>
                                                                            @if (!string.IsNullOrEmpty(usage.handover_notes))
                                                                            {
                                                                                <span class="text-[9px] text-gray-500 italic max-w-[130px] truncate block" title="@usage.handover_notes">"@usage.handover_notes"</span>
                                                                            }
                                                                            <span class="text-[9px] text-gray-400 block font-semibold truncate max-w-[130px]" title="@usage.handover_recipient_name">Recv: @(usage.handover_recipient_name ?? "-")</span>
                                                                        </div>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="text-[10px] text-gray-400 italic">Belum ada</span>
                                                                    }
                                                                </td>
                                                                <td class="px-4 py-3 align-middle text-[11px] text-gray-500 space-y-0.5">
                                                                    @if (!string.IsNullOrEmpty(usage.notes)) { <div><span class="font-bold text-gray-400">User:</span> @usage.notes</div> }
                                                                    @if (!string.IsNullOrEmpty(usage.staff_inventory_notes) && !ShouldHideRevisionNoteInNotesColumn(usage, usage.staff_inventory_notes, WorkflowStatuses.RevisionByStaffInventory)) { <div><span class="font-bold text-[#e8a000]">Staff Inv:</span> @usage.staff_inventory_notes</div> }
                                                                    @if (!string.IsNullOrEmpty(usage.admin_notes) && !ShouldHideRevisionNoteInNotesColumn(usage, usage.admin_notes, WorkflowStatuses.RevisionByAdmin)) { <div><span class="font-bold text-[#e8a000]">Admin:</span> @usage.admin_notes</div> }
                                                                    @if (!string.IsNullOrEmpty(usage.manager_notes) && !ShouldHideRevisionNoteInNotesColumn(usage, usage.manager_notes, WorkflowStatuses.RevisionByManager)) { <div><span class="font-bold text-[#e8a000]">Manager:</span> @usage.manager_notes</div> }
                                                                    @if (string.IsNullOrEmpty(usage.notes) && !HasVisibleInternalNotes(usage)) { <span class="text-gray-300">-</span> }
                                                                </td>
                                                                <td class="px-4 py-3 align-middle text-right">
                                                                    @{
                                                                        var canReturn = (usage.status == "APPROVED" || usage.status == "WAITING_HANDOVER_CONFIRM") && usage.request_type == "BORROW" && usage.returned_quantity < usage.quantity && (usage.pending_return_quantity ?? 0) == 0;
                                                                        var isReturnDraft = usage.status == "APPROVED" && usage.request_type == "BORROW" && (usage.pending_return_quantity ?? 0) > 0 && usage.is_return_draft == 1;
                                                                        var canManageDraft = isReturnDraft && (usage.requester_id == CurrentUserId || userPrincipal.HasPermission(WMS_UnitedTracors_Blazor.Helpers.Permissions.ApprovalHandover));
                                                                        var canRevise = usage.status == "REVISION" || usage.status == "REVISION_BY_STAFF_INVENTORY" || usage.status == "REVISION_BY_ADMIN" || usage.status == "REVISION_BY_MANAGER";
                                                                        var hasAction = canReturn || canManageDraft || canRevise;
                                                                    }
                                                                    @if (canReturn)
                                                                    {
                                                                        <div class="flex items-center justify-end gap-1.5 flex-wrap">
                                                                            <button type="button" @onclick="() => OpenReturnModal(usage, false)" class="text-[9px] px-2 py-0.5 bg-white border border-[#e5e3dc] rounded hover:border-[#1a1a1a] transition font-bold whitespace-nowrap">Return Item</button>
                                                                            @if (userPrincipal.HasPermission(WMS_UnitedTracors_Blazor.Helpers.Permissions.ApprovalHandover))
                                                                            {
                                                                                <button type="button" @onclick="() => OpenReturnModal(usage, true)" class="text-[9px] px-2 py-0.5 bg-[#1a1a1a] text-white rounded hover:bg-[#333] transition font-bold whitespace-nowrap">Force Return</button>
                                                                            }
                                                                        </div>
                                                                    }
                                                                    else if (canManageDraft)
                                                                    {
                                                                        <div class="flex items-center justify-end gap-1 flex-wrap">
                                                                            <button type="button" @onclick='() => AskConfirm("Ajukan Pengembalian", "Ajukan pengembalian ini ke admin untuk disetujui?", () => SubmitReturnDraftItem(usage.id), "Ya, Ajukan")' disabled="@IsSubmitting" class="text-[9px] px-2 py-0.5 bg-[#1a7a30] hover:bg-[#166528] text-white rounded transition font-bold whitespace-nowrap disabled:opacity-50">Submit</button>
                                                                            <button type="button" @onclick="() => OpenReturnModal(usage, false)" class="text-[9px] px-2 py-0.5 bg-white border border-[#e5e3dc] rounded hover:border-[#1a1a1a] transition font-bold whitespace-nowrap">Ganti Foto</button>
                                                                            <button type="button" @onclick='() => AskConfirm("Batalkan Draft?", "Batal pengembalian?", () => CancelReturnDraftItem(usage.id), "Ya, Batalkan")' disabled="@IsSubmitting" class="text-[9px] px-2 py-0.5 bg-white border border-[#f8c0c0] text-[#d94040] rounded hover:bg-[#fef0f0] transition font-bold whitespace-nowrap disabled:opacity-50">Batal</button>
                                                                        </div>
                                                                    }
                                                                    else if (canRevise)
                                                                    {
                                                                        <button type="button" @onclick="() => OpenRevisionModal(usage)" class="px-2.5 py-0.5 bg-[#e8a000] hover:bg-[#d49300] text-[#1a1a1a] text-[9px] font-bold rounded shadow-sm transition whitespace-nowrap">Revisi</button>
                                                                    }
                                                                    @if (!hasAction)
                                                                    {
                                                                        <span class="text-xs text-gray-300">-</span>
                                                                    }
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                                @if (groupItems.Count > 3)
                                                {
                                                    <div class="border-t border-[#e5e3dc] bg-gray-50/50 p-2.5 text-center">
                                                        <button type="button" @onclick="() => ToggleShowAllProducts(groupId)" class="text-xs font-bold text-[#e8a000] hover:text-[#d49300] transition active:scale-95 cursor-pointer">
                                                            @(showAllProducts ? "See Less" : $"See More ({groupItems.Count - 3} more items...)")
                                                        </button>
                                                    </div>
                                                }
                                            </div>

                                            <!-- Mobile View (Daftar Kartu Produk Responsif) -->
                                            <div class="block md:hidden space-y-3">
                                                @foreach(var usage in productsToRender)
                                                {
                                                    <div class="bg-white rounded-xl border border-[#e5e3dc] p-4 shadow-sm space-y-3">
                                                        <!-- Name, SKU, Qty -->
                                                        <div class="flex justify-between items-start gap-2">
                                                            <div>
                                                                <h5 class="text-xs font-bold text-[#1a1a1a]">@(usage.Product?.name ?? "-")</h5>
                                                                @if(usage.ProductVariant != null) {
                                                                    var variantTexts = new List<string>();
                                                                    if (!string.IsNullOrEmpty(usage.ProductVariant.color)) variantTexts.Add(usage.ProductVariant.color);
                                                                    if (!string.IsNullOrEmpty(usage.ProductVariant.size)) variantTexts.Add(usage.ProductVariant.size);
                                                                    if (variantTexts.Any()) {
                                                                        <span class="text-[10px] text-gray-500 font-normal">(@string.Join(", ", variantTexts))</span>
                                                                    }
                                                                }
                                                                <code class="block text-[9px] text-gray-500 font-mono mt-0.5">@(usage.Product?.sku ?? "-")</code>
                                                                <span class="inline-flex items-center gap-1 bg-amber-50 text-amber-700 px-1 py-0.5 rounded border border-amber-200 text-[9px] font-semibold mt-1">
                                                                    Credit/Item: @(usage.Product?.value.ToString("N0") ?? "0") pts
                                                                </span>
                                                            </div>
                                                            <div class="text-right shrink-0">
                                                                <span class="text-xs font-extrabold text-[#1a1a1a]">@usage.quantity</span>
                                                                <span class="text-[10px] text-gray-500 block">@(usage.Product?.Unit?.name ?? "unit")</span>
                                                            </div>
                                                        </div>

                                                        <!-- Dates for mobile -->
                                                        <div class="text-[11px] text-gray-600">
                                                            @if (usage.request_type == "GIVEAWAY")
                                                            {
                                                                <span><span class="font-bold">Pengambilan:</span> @(usage.pickup_date?.ToString("dd MMM yyyy") ?? "-")</span>
                                                                @if (usage.original_pickup_date.HasValue && usage.original_pickup_date.Value.Date != usage.pickup_date?.Date)
                                                                {
                                                                    <span class="block mt-1 text-[10px] font-semibold text-rose-600">
                                                                        Revisi: @usage.original_pickup_date.Value.ToString("dd MMM yyyy") -> @(usage.pickup_date?.ToString("dd MMM yyyy") ?? "-")
                                                                    </span>
                                                                }
                                                            }
                                                        </div>

                                                        <!-- Status Detail Badge for mobile -->
                                                        <div class="flex items-center justify-between gap-2 border-t border-[#f0ede5] pt-2">
                                                            <span class="text-[10px] text-gray-500 font-semibold">Status Detail:</span>
                                                            <div>
                                                                @if(usage.status == "PENDING" || usage.status == "PENDING_ADMIN") {
                                                                    <span class="inline-flex items-center px-1.5 py-0.5 border border-[#fde68a] rounded text-[9px] font-bold bg-[#fef3c7] text-[#92400e]">Menunggu Admin</span>
                                                                } else if (usage.status == "PENDING_STAFF_INVENTORY") {
                                                                    <span class="inline-flex items-center px-1.5 py-0.5 border border-[#fde68a] rounded text-[9px] font-bold bg-[#fef3c7] text-[#92400e]">Menunggu Staff Inventoris</span>
                                                                } else if (usage.status == "PENDING_MANAGER") {
                                                                    <span class="inline-flex items-center px-1.5 py-0.5 border border-[#c4b5fd] rounded text-[9px] font-bold bg-[#ede9fe] text-[#6d28d9]">Menunggu Manager</span>
                                                                } else if (usage.status == "WAITING_HANDOVER") {
                                                                    if (TransactionService.HasStoredFiles(usage.handover_photo))
                                                                    {
                                                                        <span class="inline-flex items-center px-1.5 py-0.5 border border-[#c4b5fd] rounded text-[9px] font-bold bg-[#ede9fe] text-[#6d28d9]">DRAFT - Belum Dikirim</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="inline-flex items-center px-1.5 py-0.5 border border-[#fde68a] rounded text-[9px] font-bold bg-[#fef3c7] text-[#92400e]">Menunggu Bukti Serah Terima</span>
                                                                    }
                                                                } else if (usage.status == "WAITING_ADMIN_HANDOVER") {
                                                                    <span class="inline-flex items-center px-1.5 py-0.5 border border-[#bae6fd] rounded text-[9px] font-bold bg-[#e0f2fe] text-[#1a6b8a]">Menunggu Verifikasi Admin</span>
                                                                } else if (usage.status == "WAITING_HANDOVER_CONFIRM") {
                                                                    <span class="inline-flex items-center px-1.5 py-0.5 border border-[#bae6fd] rounded text-[9px] font-bold bg-[#e0f2fe] text-[#1a6b8a]">Menunggu Konfirmasi User</span>
                                                                } else if (usage.status == "WAITING_DOCUMENTATION") {
                                                                    <span class="inline-flex items-center px-1.5 py-0.5 border border-[#c8e6c9] rounded text-[9px] font-bold bg-[#e8f5e9] text-[#2e7d32]">Menunggu Dokumentasi User</span>
                                                                } else if (usage.status == "DOCUMENTATION_OVERDUE") {
                                                                    <span class="inline-flex items-center px-1.5 py-0.5 border border-[#f8c0c0] rounded text-[9px] font-bold bg-[#fef0f0] text-[#d94040]">Dokumentasi Overdue</span>
                                                                } else if (usage.status == "APPROVED" || usage.status == "COMPLETED") {
                                                                    @if (usage.request_type == "BORROW") {
                                                                        @if (usage.returned_quantity >= usage.quantity) {
                                                                            <span class="inline-flex items-center px-1.5 py-0.5 border border-[#b8e8c0] rounded text-[9px] font-bold bg-[#eef9f0] text-[#1a7a30]">Sudah Kembali (@usage.returned_quantity/@usage.quantity)</span>
                                                                        } else if (usage.pending_return_quantity > 0 && usage.is_return_draft == 1) {
                                                                            <span class="inline-flex items-center px-1.5 py-0.5 border border-[#c4b5fd] rounded text-[9px] font-bold bg-[#ede9fe] text-[#6d28d9]">DRAFT (@usage.pending_return_quantity)</span>
                                                                        } else if (usage.pending_return_quantity > 0 && usage.is_return_draft == 0) {
                                                                            <span class="inline-flex items-center px-1.5 py-0.5 border border-[#bae6fd] rounded text-[9px] font-bold bg-[#e0f2fe] text-[#1a6b8a]">Menunggu ACC (@usage.pending_return_quantity)</span>
                                                                        } else {
                                                                            <span class="inline-flex items-center px-1.5 py-0.5 border border-[#fde68a] rounded text-[9px] font-bold bg-[#fef3c7] text-[#92400e]">Belum Kembali (@usage.returned_quantity/@usage.quantity)</span>
                                                                        }
                                                                    } else {
                                                                        <span class="inline-flex items-center px-1.5 py-0.5 border border-[#b8e8c0] rounded text-[9px] font-bold bg-[#eef9f0] text-[#1a7a30]">Selesai / Diterima</span>
                                                                    }
                                                                } else if (usage.status == "REJECTED") {
                                                                    <span class="inline-flex items-center px-1.5 py-0.5 border border-[#f8c0c0] rounded text-[9px] font-bold bg-[#fef0f0] text-[#d94040]">Ditolak</span>
                                                                } else if (usage.status == "REVISION" || usage.status == "REVISION_BY_STAFF_INVENTORY" || usage.status == "REVISION_BY_ADMIN" || usage.status == "REVISION_BY_MANAGER") {
                                                                    <span class="inline-flex items-center px-1.5 py-0.5 border border-[#fde68a] rounded text-[9px] font-bold bg-[#fffbeb] text-[#d97706]">Butuh Revisi</span>
                                                                    <div class="text-[10px] font-semibold text-[#b45309] mt-1">Oleh @GetRevisionActorLabel(usage)</div>
                                                                }
                                                            </div>
                                                        </div>

                                                        <!-- Notes for mobile -->
                                                        @if (!string.IsNullOrEmpty(usage.notes) || HasVisibleInternalNotes(usage))
                                                        {
                                                            <div class="bg-[#faf9f5] p-2.5 rounded-lg text-[10px] space-y-1 border border-[#e5e3dc]/50">
                                                                @if (!string.IsNullOrEmpty(usage.notes)) { <div><span class="font-bold text-gray-400">User:</span> @usage.notes</div> }
                                                                @if (!string.IsNullOrEmpty(usage.staff_inventory_notes) && !ShouldHideRevisionNoteInNotesColumn(usage, usage.staff_inventory_notes, WorkflowStatuses.RevisionByStaffInventory)) { <div><span class="font-bold text-[#e8a000]">Staff Inv:</span> @usage.staff_inventory_notes</div> }
                                                                @if (!string.IsNullOrEmpty(usage.admin_notes) && !ShouldHideRevisionNoteInNotesColumn(usage, usage.admin_notes, WorkflowStatuses.RevisionByAdmin)) { <div><span class="font-bold text-[#e8a000]">Admin:</span> @usage.admin_notes</div> }
                                                                @if (!string.IsNullOrEmpty(usage.manager_notes) && !ShouldHideRevisionNoteInNotesColumn(usage, usage.manager_notes, WorkflowStatuses.RevisionByManager)) { <div><span class="font-bold text-[#e8a000]">Manager:</span> @usage.manager_notes</div> }
                                                            </div>
                                                        }

                                                        <!-- Handover Proof for mobile -->
                                                         @{
                                                             var handoverFilesMobile = TransactionService.ParseStoredFiles(usage.handover_photo);
                                                         }
                                                         @if (handoverFilesMobile.Any())
                                                         {
                                                             <div class="border-t border-[#f0ede5] pt-2 space-y-1 mb-2.5">
                                                                 <span class="text-[10px] text-gray-500 font-semibold block">Bukti Serah Terima:</span>
                                                                 <div class="flex flex-wrap gap-1.5">
                                                                     @foreach (var file in handoverFilesMobile)
                                                                     {
                                                                         var fileSrc = ImageHelper.Resolve(file);
                                                                         <div class="w-9 h-9 rounded border border-[#e5e3dc] overflow-hidden bg-white shrink-0 shadow-sm hover:scale-105 transition duration-150">
                                                                             @if (file.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                                                                             { 
                                                                                 <a href="@fileSrc" target="_blank" class="w-full h-full flex items-center justify-center bg-red-50 text-red-500">
                                                                                     <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                                                                                 </a>
                                                                             }
                                                                             else
                                                                             {
                                                                                 <a href="@fileSrc" target="_blank" data-image-popup class="w-full h-full block">
                                                                                     <img src="@fileSrc" class="w-full h-full object-cover" />
                                                                                 </a>
                                                                             }
                                                                         </div>
                                                                     }
                                                                 </div>
                                                                 @if (!string.IsNullOrEmpty(usage.handover_notes))
                                                                 {
                                                                     <div class="text-[10px] text-gray-500 italic">"@usage.handover_notes"</div>
                                                                 }
                                                                 <div class="text-[9px] text-gray-400 font-semibold">Penerima: @(usage.handover_recipient_name ?? "-")</div>
                                                             </div>
                                                         }

                                                         <!-- Action Buttons for mobile -->
                                                        @{
                                                            var canReturnMobile = (usage.status == "APPROVED" || usage.status == "WAITING_HANDOVER_CONFIRM") && usage.request_type == "BORROW" && usage.returned_quantity < usage.quantity && (usage.pending_return_quantity ?? 0) == 0;
                                                            var isReturnDraftMobile = usage.status == "APPROVED" && usage.request_type == "BORROW" && (usage.pending_return_quantity ?? 0) > 0 && usage.is_return_draft == 1;
                                                            var canManageDraftMobile = isReturnDraftMobile && (usage.requester_id == CurrentUserId || userPrincipal.HasPermission(WMS_UnitedTracors_Blazor.Helpers.Permissions.ApprovalHandover));
                                                            var canReviseMobile = usage.status == "REVISION" || usage.status == "REVISION_BY_STAFF_INVENTORY" || usage.status == "REVISION_BY_ADMIN" || usage.status == "REVISION_BY_MANAGER";
                                                            var hasActionMobile = canReturnMobile || canManageDraftMobile || canReviseMobile;
                                                        }
                                                        @if (hasActionMobile)
                                                        {
                                                            <div class="border-t border-[#f0ede5] pt-2 flex justify-end gap-1.5">
                                                                @if (canReturnMobile)
                                                                {
                                                                    <button type="button" @onclick="() => OpenReturnModal(usage, false)" class="text-[9px] px-2 py-1 bg-white border border-[#e5e3dc] rounded hover:border-[#1a1a1a] transition font-bold whitespace-nowrap">Return Item</button>
                                                                    @if (userPrincipal.HasPermission(WMS_UnitedTracors_Blazor.Helpers.Permissions.ApprovalHandover))
                                                                    {
                                                                        <button type="button" @onclick="() => OpenReturnModal(usage, true)" class="text-[9px] px-2 py-1 bg-[#1a1a1a] text-white rounded hover:bg-[#333] transition font-bold whitespace-nowrap">Force Return</button>
                                                                    }
                                                                }
                                                                else if (canManageDraftMobile)
                                                                {
                                                                    <button type="button" @onclick='() => AskConfirm("Ajukan Pengembalian", "Ajukan pengembalian ini ke admin untuk disetujui?", () => SubmitReturnDraftItem(usage.id), "Ya, Ajukan")' disabled="@IsSubmitting" class="text-[9px] px-2 py-1 bg-[#1a7a30] hover:bg-[#166528] text-white rounded transition font-bold whitespace-nowrap disabled:opacity-50">Submit</button>
                                                                    <button type="button" @onclick="() => OpenReturnModal(usage, false)" class="text-[9px] px-2 py-1 bg-white border border-[#e5e3dc] rounded hover:border-[#1a1a1a] transition font-bold whitespace-nowrap">Ganti Foto</button>
                                                                    <button type="button" @onclick='() => AskConfirm("Batalkan Draft?", "Batal pengembalian?", () => CancelReturnDraftItem(usage.id), "Ya, Batalkan")' disabled="@IsSubmitting" class="text-[9px] px-2 py-1 bg-white border border-[#f8c0c0] text-[#d94040] rounded hover:bg-[#fef0f0] transition font-bold whitespace-nowrap disabled:opacity-50">Batal</button>
                                                                }
                                                                else if (canReviseMobile)
                                                                {
                                                                    <button type="button" @onclick="() => OpenRevisionModal(usage)" class="px-2.5 py-1 bg-[#e8a000] hover:bg-[#d49300] text-[#1a1a1a] text-[9px] font-bold rounded shadow-sm transition whitespace-nowrap">Revisi</button>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                                @if (groupItems.Count > 3)
                                                {
                                                    <div class="text-center pt-1">
                                                        <button type="button" @onclick="() => ToggleShowAllProducts(groupId)" class="w-full py-2 bg-white border border-[#e5e3dc] rounded-xl text-xs font-bold text-[#e8a000] hover:text-[#d49300] transition cursor-pointer">
                                                            @(showAllProducts ? "See Less" : $"See More ({groupItems.Count - 3} more items...)")
                                                        </button>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
            }
        }
    </div>
</div>

<Modal Show="IsHandoverModalOpen" Title="Upload Bukti Serah Terima" Size="lg" OnClose="CloseHandoverModal">
  <ChildContent>
    <div class="p-4 bg-blue-50 text-blue-700 text-xs rounded-lg border border-blue-100 flex items-start gap-3">
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <p>@(HandoverRequestType == "GIVEAWAY" ? "Bukti serah terima giveaway akan disimpan sebagai draft. Setelah yakin benar, lanjutkan untuk menyelesaikan serah terima dan mengaktifkan tahap dokumentasi user." : "Foto akan disimpan sebagai draft — Anda masih bisa menggantinya berkali-kali. Setelah yakin benar, klik Submit ke Admin untuk mengirim verifikasi.")</p>
    </div>

    <div>
        <label class="block text-xs font-bold text-[#8a8880] uppercase tracking-wider mb-2">Foto/PDF Bukti Serah Terima <span class="text-red-500">*</span></label>
        <InputFile OnChange="HandleHandoverFileSelected" accept="image/jpg,image/jpeg,image/png,image/webp,application/pdf" class="block w-full text-sm text-gray-500 file:mr-4 file:py-2.5 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-bold file:bg-[#f5f4f0] file:text-[#1a1a1a] hover:file:bg-[#e5e3dc] transition cursor-pointer border border-[#e5e3dc] rounded-lg" required />
        <p class="text-[10px] text-gray-500 mt-1">Format: JPG, PNG, WEBP, PDF. Maks 4MB.</p>
        @if (HandoverFile != null && HandoverFile.ContentType == "application/pdf")
        {
