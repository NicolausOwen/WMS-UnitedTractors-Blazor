@page "/Profile"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using UT_WMSDotnet.Models
@using UT_WMSDotnet.ViewModels
@using WMS_UnitedTracors_Blazor.Services
@inject ProfileService ProfileService
@inject DivisionService DivisionService
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Profile</PageTitle>

<div class="px-4 md:px-10 py-6 pb-24 font-sans bg-[#f5f4f0] min-h-screen">
    <div class="flex justify-between items-center mb-6">
        <h2 class="font-semibold text-xl text-gray-800 leading-tight">My Profile</h2>
    </div>

    @if (!string.IsNullOrEmpty(SuccessMessage))
    {
        <div class="mb-4 bg-green-50 text-green-700 px-4 py-3 rounded-lg text-sm border border-green-200">@SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="mb-4 bg-red-50 text-red-700 px-4 py-3 rounded-lg text-sm border border-red-200">@ErrorMessage</div>
    }

    @if (User == null)
    {
        <div class="p-6 text-center text-gray-500">Loading...</div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Profile Info -->
            <div class="bg-white rounded-xl shadow-sm border border-[#e5e3dc] p-6">
                <h3 class="text-lg font-bold text-[#1a1a1a] mb-4 border-b pb-2">Informasi Profil</h3>
                <div class="space-y-4 text-sm">
                    <div>
                        <span class="block text-xs font-bold text-gray-500">Nama Lengkap</span>
                        <div class="font-semibold">@User.name</div>
                    </div>
                    <div>
                        <span class="block text-xs font-bold text-gray-500">Email</span>
                        <div>@User.email</div>
                    </div>
                    <div>
                        <span class="block text-xs font-bold text-gray-500">NRP</span>
                        <div>@(string.IsNullOrEmpty(User.nrp) ? "-" : User.nrp)</div>
                    </div>
                    <div>
                        <span class="block text-xs font-bold text-gray-500">Divisi</span>
                        <div>@(User.Division?.name ?? "-")</div>
                    </div>
                    <div>
                        <span class="block text-xs font-bold text-gray-500">Role</span>
                        <div class="uppercase">@User.role</div>
                    </div>
                    <div>
                        <span class="block text-xs font-bold text-gray-500">Poin Kredit</span>
                        <div class="font-bold text-yellow-600">@User.poin</div>
                    </div>
                </div>

                <div class="mt-6 border-t pt-4">
                    <button @onclick="OpenEditModal" class="px-4 py-2 bg-yellow-500 text-black font-bold rounded-lg hover:bg-yellow-600 transition text-sm">
                        Ajukan Perubahan Data
                    </button>
                </div>
            </div>

            <!-- Change Password -->
            <div class="bg-white rounded-xl shadow-sm border border-[#e5e3dc] p-6">
                <h3 class="text-lg font-bold text-[#1a1a1a] mb-4 border-b pb-2">Ubah Password</h3>
                <div class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-500 mb-1">Password Lama</label>
                        <input type="password" @bind="PasswordModel.old_password" class="w-full border rounded p-2 text-sm" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-500 mb-1">Password Baru</label>
                        <input type="password" @bind="PasswordModel.new_password" class="w-full border rounded p-2 text-sm" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-500 mb-1">Konfirmasi Password Baru</label>
                        <input type="password" @bind="PasswordModel.confirm_password" class="w-full border rounded p-2 text-sm" />
                    </div>
                    <div class="pt-2">
                        <button @onclick="ChangePassword" disabled="@IsChangingPassword" class="px-4 py-2 bg-gray-900 text-white font-bold rounded-lg hover:bg-gray-800 transition text-sm disabled:opacity-50">
                            @(IsChangingPassword ? "Loading..." : "Update Password")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (ShowEditModal)
{
    <div class="fixed inset-0 z-[70] flex min-h-full items-center justify-center p-4 text-center">
        <div class="fixed inset-0 backdrop-blur-sm bg-black/60 transition-opacity" @onclick="CloseEditModal"></div>
        <div class="relative transform overflow-hidden rounded-xl bg-white text-left shadow-2xl transition-all w-full max-w-lg border border-[#e5e3dc] z-10">
            <div class="px-6 py-4 border-b border-[#f0ede5] flex items-center justify-between">
                <h3 class="font-bold text-[#1a1a1a] text-lg">Ajukan Perubahan Data</h3>
                <button type="button" @onclick="CloseEditModal" class="text-[#a09e99] hover:text-[#1a1a1a] transition font-bold text-xl">&times;</button>
            </div>
            <div class="p-6">
                <p class="text-sm text-gray-500 mb-4">Perubahan profil akan ditinjau oleh Admin sebelum diaktifkan.</p>
                <div class="space-y-4 mb-6">
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-1">Nama Lengkap</label>
                        <input type="text" @bind="ProfileModel.name" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm" />
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-1">Email</label>
                        <input type="email" @bind="ProfileModel.email" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm" />
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-1">NRP</label>
                        <input type="text" @bind="ProfileModel.nrp" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm" />
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-1">Divisi</label>
                        <select @bind="ProfileModel.division_id" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm">
                            <option value="">Pilih Divisi...</option>
                            @if (Divisions != null)
                            {
                                @foreach (var div in Divisions)
                                {
                                    <option value="@div.Id">@div.Name</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="flex justify-end gap-3">
                    <button type="button" @onclick="CloseEditModal" class="px-5 py-2.5 bg-gray-100 text-gray-700 font-bold rounded-lg hover:bg-gray-200 transition">Batal</button>
                    <button type="button" @onclick="SubmitProfileRequest" disabled="@IsSubmittingProfile" class="px-5 py-2.5 bg-yellow-500 text-black font-bold rounded-lg hover:bg-yellow-600 transition disabled:opacity-50">
                        @(IsSubmittingProfile ? "Menyimpan..." : "Ajukan Perubahan")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private User? User;
    private List<DivisionDto>? Divisions;

    private int CurrentUserId = 0;

    private string? SuccessMessage;
    private string? ErrorMessage;

    private bool ShowEditModal = false;
    private bool IsSubmittingProfile = false;
    private bool IsChangingPassword = false;

    private ProfileViewModel ProfileModel = new();
    private ChangePasswordViewModel PasswordModel = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity != null && authState.User.Identity.IsAuthenticated)
        {
            if (int.TryParse(authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out int id))
            {
                CurrentUserId = id;
                await LoadData();
            }
        }
    }

    private async Task LoadData()
    {
        User = await ProfileService.GetUserProfileAsync(CurrentUserId);
        var divResult = await DivisionService.GetDivisionsAsync(1, 100);
        Divisions = divResult.Divisions;
    }

    private void OpenEditModal()
    {
        if (User != null)
        {
            ProfileModel = new ProfileViewModel
            {
                name = User.name ?? "",
                email = User.email ?? "",
                nrp = User.nrp,
                division_id = User.division_id ?? 0
            };
            ShowEditModal = true;
            ErrorMessage = null;
            SuccessMessage = null;
        }
    }

    private void CloseEditModal()
    {
        ShowEditModal = false;
    }

    private async Task SubmitProfileRequest()
    {
        IsSubmittingProfile = true;
        ErrorMessage = null;
        SuccessMessage = null;

        var err = await ProfileService.SubmitProfileRequestAsync(CurrentUserId, ProfileModel);
        if (err != null)
        {
            ErrorMessage = err;
        }
        else
        {
            SuccessMessage = "Pengajuan perubahan profil berhasil dikirim dan menunggu persetujuan Admin.";
            CloseEditModal();
        }

        IsSubmittingProfile = false;
    }

    private async Task ChangePassword()
    {
        ErrorMessage = null;
        SuccessMessage = null;

        if (string.IsNullOrWhiteSpace(PasswordModel.old_password) || string.IsNullOrWhiteSpace(PasswordModel.new_password))
        {
            ErrorMessage = "Password wajib diisi.";
            return;
        }

        if (PasswordModel.new_password != PasswordModel.confirm_password)
        {
            ErrorMessage = "Konfirmasi password baru tidak cocok.";
            return;
        }

        IsChangingPassword = true;
        var err = await ProfileService.ChangePasswordAsync(CurrentUserId, PasswordModel);
        if (err != null)
        {
            ErrorMessage = err;
        }
        else
        {
            SuccessMessage = "Password berhasil diubah.";
            PasswordModel = new ChangePasswordViewModel();
        }
        IsChangingPassword = false;
    }
}
