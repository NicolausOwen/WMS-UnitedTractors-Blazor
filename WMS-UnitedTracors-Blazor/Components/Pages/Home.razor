@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using UT_WMSDotnet.Models
@using WMS_UnitedTracors_Blazor.Services
@implements IDisposable
@inject DashboardService DashboardService
@inject CartService CartService
@inject TransactionService TransactionService
@inject UserService UserService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>Dashboard</PageTitle>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="mb-6 flex items-center gap-3 bg-[#fef0f0] border border-[#f8c0c0] text-[#d94040] px-4 py-3 rounded-lg text-sm font-semibold mx-4 md:mx-10 mt-6">
        <svg class="w-4 h-4 shrink-0 text-[#d94040]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
        @ErrorMessage
    </div>
}

<div class="w-full min-h-screen bg-[#f5f4f0] px-4 md:px-10 py-6 pb-24 md:pb-12 font-sans">
    
    @* Metric Cards / Continue Activity *@
    <!-- @if (UserRole == "superadmin" || UserRole == "manager" || UserRole == "admin")
    {
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 mb-6 sm:mb-8">
            <div class="bg-white border border-[#e5e3dc] hover:border-[#e8a000] border-l-4 border-l-[#e8a000] rounded-r-[10px] rounded-l-[4px] p-4 sm:p-5 sm:px-6 shadow-sm hover:shadow-md transition-all duration-300 hover:-translate-y-[1px]">
                <p class="text-[0.6rem] sm:text-[0.65rem] font-bold tracking-[0.12em] uppercase text-[#8a8880] mb-1.5">Total Items</p>
                <p class="font-sans text-2xl sm:text-4xl font-bold text-[#1a1a1a] leading-none">@WidgetTotalItems</p>
            </div>
            <div class="bg-white border border-[#e5e3dc] hover:border-[#1a7a30] border-l-4 border-l-[#1a7a30] rounded-r-[10px] rounded-l-[4px] p-4 sm:p-5 sm:px-6 shadow-sm hover:shadow-md transition-all duration-300 hover:-translate-y-[1px]">
                <p class="text-[0.6rem] sm:text-[0.65rem] font-bold tracking-[0.12em] uppercase text-[#8a8880] mb-1.5">Total Stock</p>
                <p class="font-sans text-2xl sm:text-4xl font-bold text-[#1a1a1a] leading-none">@TotalStock</p>
            </div>
            <div class="bg-white border border-[#e5e3dc] hover:border-[#e8a000] border-l-4 border-l-[#e8a000] rounded-r-[10px] rounded-l-[4px] p-4 sm:p-5 sm:px-6 shadow-sm hover:shadow-md transition-all duration-300 hover:-translate-y-[1px]">
                <p class="text-[0.6rem] sm:text-[0.65rem] font-bold tracking-[0.12em] uppercase text-[#8a8880] mb-1.5">Pending Approval</p>
                <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-2">
                    <p class="font-sans text-2xl sm:text-4xl font-bold text-[#1a1a1a] leading-none">@PendingApprovals</p>
                    @if (PendingApprovals > 0) {
                        <span class="inline-flex items-center w-max px-[0.45rem] py-[0.1rem] bg-[#fef3c7] border border-[#fde68a] text-[#92400e] text-[0.55rem] sm:text-[0.62rem] font-bold rounded-[4px] tracking-[0.04em] mt-1 sm:mt-0">Needs review</span>
                    }
                </div>
            </div>
            <div class="bg-white border border-[#e5e3dc] hover:border-[#d94040] border-l-4 border-l-[#d94040] rounded-r-[10px] rounded-l-[4px] p-4 sm:p-5 sm:px-6 shadow-sm hover:shadow-md transition-all duration-300 hover:-translate-y-[1px] flex items-start justify-between">
                <div>
                    <p class="text-[0.6rem] sm:text-[0.65rem] font-bold tracking-[0.12em] uppercase text-[#8a8880] mb-1.5">Overdue Return</p>
                    <p class="font-sans text-2xl sm:text-4xl font-bold text-[#d94040] leading-none">@OverdueReturnCount</p>
                </div>
                @if(OverdueReturnCount > 0) {
                    <span class="inline-flex h-6.5 w-6.5 sm:h-9 sm:w-9 items-center justify-center rounded-lg bg-[#fef0f0] text-[#d94040] font-extrabold text-xs sm:text-base border border-[#f8c0c0] shrink-0 leading-none">!</span>
                }
            </div>
        </div>
    } -->

    @* Kegiatan Lanjutan (Action Items) Widget *@
        <div class="mb-6 sm:mb-8 bg-white border border-[#e5e3dc] rounded-[18px] p-5 sm:p-6 shadow-sm">
            <div class="flex items-center justify-between cursor-pointer select-none" @onclick="() => ActionItemsExpanded = !ActionItemsExpanded">
                <div class="flex items-center gap-2.5">
                    <h3 class="text-base font-bold text-[#1a1a1a] tracking-tight">Kegiatan Lanjutan</h3>
                    @if (ActionItems.Count > 0)
                    {
                        <span class="relative flex h-2 w-2">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
                        </span>
                        <span class="inline-flex items-center px-2 py-0.5 bg-[#d94040] text-white text-[0.62rem] font-bold rounded-full uppercase tracking-wider shrink-0 animate-pulse">
                            @ActionItems.Count Pending
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center px-2 py-0.5 bg-[#f0ede5] text-[#5a5855] text-[0.62rem] font-bold rounded-full uppercase tracking-wider shrink-0">
                            0 Pending
                        </span>
                    }
                </div>
                <div class="text-gray-400 p-1 hover:text-gray-600 transition shrink-0">
                    <svg class="w-5 h-5 transform transition-transform duration-200 @(!ActionItemsExpanded ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </div>
            </div>

            @if (ActionItemsExpanded)
            {
                <div class="mt-4 pt-4 border-t border-[#f0ede5]">
                    @if (ActionItems.Count > 0)
                    {
                        <div class="space-y-3 max-h-[350px] overflow-y-auto pr-1 custom-scrollbar">
                            @foreach (var item in ActionItems)
                            {
                                <div class="flex flex-col sm:flex-row sm:items-center justify-between p-4 bg-[#faf9f5] border border-[#e5e3dc] rounded-xl hover:border-[#e8a000] hover:bg-white hover:shadow-md transition-all duration-300 gap-4">
                                    <div class="flex items-start gap-3 sm:gap-3.5 min-w-0 flex-1 w-full">
                                        @* Icon *@
                                        <div class="p-2.5 rounded-xl shrink-0 mt-0.5
                                            @(item.Type == "handover" ? "bg-[#fef3c7] text-[#d97706]" :
                                              item.Type == "revision" ? "bg-[#fef0f0] text-[#d94040]" :
                                              item.Type == "return" ? "bg-[#f0f9ff] text-[#0284c7]" :
                                              "bg-[#eef9f0] text-[#1a7a30]")">
                                            @if (item.Type == "handover")
                                            {
                                                <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5"/></svg>
                                            }
                                            else if (item.Type == "revision")
                                            {
                                                <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                                            }
                                            else if (item.Type == "return")
                                            {
                                                <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3"/></svg>
                                            }
                                            else
                                            {
                                                <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
                                            }
                                        </div>

                                        @* Details *@
                                        <div class="min-w-0 flex-1">
                                            <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
                                                <h4 class="text-xs sm:text-sm font-extrabold text-[#1a1a1a] leading-tight">@item.Title</h4>
                                                <span class="px-1.5 py-0.5 sm:px-2 rounded text-[0.55rem] sm:text-[0.62rem] font-bold shrink-0 @item.BadgeClass">
                                                    @item.Badge
                                                </span>
                                            </div>
                                            <p class="text-[0.68rem] sm:text-xs text-[#5a5855] font-semibold mt-1 leading-snug break-words">
                                                @item.Description
                                            </p>
                                            <div class="text-[0.65rem] text-[#8a8880] font-medium mt-1">
                                                Diajukan pada: @item.Date.ToString("dd MMMM yyyy, HH:mm")
                                            </div>
                                        </div>
                                    </div>

                                    @* CTA Button *@
                                    <div class="shrink-0 w-full sm:w-auto">
                                        <a href="@item.BtnUrl" class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 px-3 py-1.5 sm:px-4 sm:py-2 bg-[#e8a000] hover:bg-[#d49300] active:scale-[0.98] text-[#1a1a1a] text-[0.68rem] sm:text-xs font-bold uppercase tracking-wider rounded-lg transition shadow-sm">
                                            <span>@item.BtnText</span>
                                            <svg class="w-3 h-3 text-[#1a1a1a]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="flex flex-col items-center justify-center text-center py-6">
                            <div class="p-3 bg-[#eef9f0] border border-[#b8e8c0] text-[#1a7a30] rounded-full mb-3 shrink-0">
                                <svg class="w-6 h-6 text-[#1a7a30]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                            </div>
                            <h4 class="text-sm font-extrabold text-[#1a1a1a]">Luar Biasa!</h4>
                            <p class="text-xs text-[#8a8880] mt-1 font-medium">Semua tugas selesai. Tidak ada tindakan yang diperlukan saat ini.</p>
                        </div>
                    }
                </div>
            }
        </div>
    
    @* Quick Actions *@
    <div class="flex flex-wrap items-center gap-3 mb-8">
        @if (UserRole == "superadmin" || UserRole == "staff") {
        <a href="Tracking" class="inline-flex items-center gap-2 px-[1.1rem] py-[0.6rem] bg-[#1a1a1a] hover:bg-[#333333] active:scale-[0.98] text-white text-[0.75rem] font-bold tracking-[0.06em] uppercase rounded-lg transition">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/></svg>
            Return Item
        </a>
        }
        @if (UserRole == "superadmin" || UserRole == "manager" || UserRole == "admin") {
        <a href="Approval" class="inline-flex items-center gap-2 px-[1.1rem] py-[0.6rem] bg-[#1a1a1a] hover:bg-[#333333] active:scale-[0.98] text-white text-[0.75rem] font-bold tracking-[0.06em] uppercase rounded-lg transition">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
            Review Approvals
        </a>
        }
    </div>

    @if (UserRole == "superadmin" || UserRole == "admin" || UserRole == "manager")
    {
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-6 mb-8">
            @* 1. Transaction Status Donut *@
            <section class="min-w-0 rounded-[18px] border border-[#e5e3dc] bg-white p-5 shadow-sm flex flex-col min-h-[260px] widget-card">
                <p class="text-[0.7rem] font-bold uppercase tracking-[0.18em] text-[#8a8880] mb-3">Transaction Status</p>
                <div class="relative w-full flex-1 flex items-center justify-center min-h-[150px]">
                    <canvas id="donutChartStatus"></canvas>
                </div>
                <div class="flex flex-wrap gap-x-4 gap-y-1.5 mt-3 pt-3 border-t border-[#f0ede5] text-[0.68rem]">
                    <div class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-[#1a7a30] shrink-0"></span><span class="text-[#5a5855] font-semibold">Approved: <span id="valApproved">@DonutApproved</span></span></div>
                    <div class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-[#d94040] shrink-0"></span><span class="text-[#5a5855] font-semibold">Rejected: <span id="valRejected">@DonutRejected</span></span></div>
                    <div class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-[#e8a000] shrink-0"></span><span class="text-[#5a5855] font-semibold">Pending: <span id="valPending">@DonutPending</span></span></div>
                </div>
            </section>

            @* 2. Item Status Donut (Merch / Borrow Slide Toggle) *@
            <section class="min-w-0 rounded-[18px] border border-[#e5e3dc] bg-white p-5 shadow-sm flex flex-col min-h-[260px] widget-card">
                <div class="flex items-center justify-between mb-3">
                    <p class="text-[0.7rem] font-bold uppercase tracking-[0.18em] text-[#8a8880]">Item Status</p>
                    <div class="relative flex bg-[#f0ede5] rounded-full p-0.5" id="itemStatusToggle">
                        <button type="button" onclick="switchItemStatus('merch')" id="btnMerch" class="item-status-tab relative z-10 px-3.5 py-1 text-[0.62rem] font-bold rounded-full transition-all duration-300 text-[#1a1a1a] bg-white shadow-sm" data-tab="merch">Merch</button>
                        <button type="button" onclick="switchItemStatus('borrow')" id="btnBorrow" class="item-status-tab relative z-10 px-3.5 py-1 text-[0.62rem] font-bold rounded-full transition-all duration-300 text-[#8a8880] bg-transparent" data-tab="borrow">Borrow</button>
                    </div>
                </div>

                @* Merch View *@
                <div id="itemStatusMerch" class="flex-1 flex flex-col">
                    <div class="relative w-full flex-1 flex items-center justify-center min-h-[150px]">
                        <canvas id="donutChartMerch"></canvas>
                    </div>
                    <div class="flex flex-wrap gap-x-4 gap-y-1.5 mt-3 pt-3 border-t border-[#f0ede5] text-[0.68rem]">
                        <div class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-[#1a7a30] shrink-0"></span><span class="text-[#5a5855] font-semibold">Available: <span id="valMerchAvailable">@MerchAvailable</span></span></div>
                        <div class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-[#e8a000] shrink-0"></span><span class="text-[#5a5855] font-semibold">Low Stock: <span id="valMerchLowStock">@MerchLowStock</span></span></div>
                        <div class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-[#d94040] shrink-0"></span><span class="text-[#5a5855] font-semibold">Out of Stock: <span id="valMerchOutOfStock">@MerchOutOfStock</span></span></div>
                    </div>
                </div>

                @* Borrow View (hidden by default) *@
                <div id="itemStatusBorrow" class="flex-1 flex-col hidden">
                    <div class="relative w-full flex-1 flex items-center justify-center min-h-[150px]">
                        <canvas id="donutChartBorrow"></canvas>
                    </div>
                    <div class="flex flex-wrap gap-x-4 gap-y-1.5 mt-3 pt-3 border-t border-[#f0ede5] text-[0.68rem]">
                        <div class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-[#d94040] shrink-0"></span><span class="text-[#5a5855] font-semibold">Overdue: <span id="valBorrowOverdue">@BorrowOverdue</span></span></div>
                        <div class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-[#1a7a30] shrink-0"></span><span class="text-[#5a5855] font-semibold">Available: <span id="valBorrowAvailable">@BorrowAvailable</span></span></div>
                        <div class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-[#3b82f6] shrink-0"></span><span class="text-[#5a5855] font-semibold">Borrowed: <span id="valBorrowBorrowed">@BorrowBorrowed</span></span></div>
                    </div>
                </div>
            </section>

            @* 3. Low Stock Products List *@
            <section class="min-w-0 rounded-[18px] border border-[#e5e3dc] bg-white p-5 shadow-sm flex flex-col min-h-[260px] widget-card">
                <p class="text-[0.7rem] font-bold uppercase tracking-[0.18em] text-[#8a8880] mb-3">Low Stock</p>
                @if(LowStockProducts != null && LowStockProducts.Any())
                {
                    <div class="relative flex-1">
                        <div class="overflow-y-auto space-y-0 custom-scrollbar pr-1" style="max-height: 225px;" onscroll="checkLowStockScroll(this)">
                            @foreach(var lsp in LowStockProducts)
                            {
                            <div class="flex items-center justify-between py-2.5 border-b border-[#f5f3ee] last:border-b-0 group">
                                <span class="text-[0.78rem] font-semibold text-[#1a1a1a] truncate pr-3 leading-snug group-hover:text-[#e8a000] transition-colors" title="@lsp.name">@lsp.name</span>
                                <div class="flex items-center gap-1.5 shrink-0">
                                    <span class="text-sm font-extrabold @(lsp.current_stock <= 2 ? "text-[#d94040]" : "text-[#e8a000]")">@lsp.current_stock</span>
                                    <span class="text-[0.6rem] text-[#8a8880] font-medium">@(lsp.Unit?.name ?? "unit")</span>
                                </div>
                            </div>
                            }
                        </div>
                        <div id="scrollIndicator" class="absolute bottom-0 left-0 right-0 h-10 bg-gradient-to-t from-white via-white/95 to-transparent pointer-events-none transition-opacity duration-300 flex items-end justify-center pb-0.5">
                            <span class="text-[0.55rem] text-[#8a8880] font-bold tracking-wider uppercase flex items-center gap-0.5 animate-bounce">
                                Scroll for more
                                <svg class="w-2 h-2 text-[#8a8880]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
                            </span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="flex-1 flex flex-col items-center justify-center text-center py-6">
                        <svg class="w-10 h-10 text-[#d1d0cb] mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        <p class="text-xs text-[#8a8880] font-semibold">All items are well stocked</p>
                    </div>
                }
            </section>
        </div>
    }

    <div class="bg-white border border-[#e5e3dc] rounded-xl overflow-hidden shadow-sm">
        @* Header *@
        <div class="px-6 py-4 border-b border-[#f0ede5] flex flex-col gap-4">
            <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
                <div>
                    <h3 class="text-xl font-bold text-[#1a1a1a]">Product Catalog</h3>
                    <p class="text-[1rem] text-[#8a8880] mt-0.5">Daftar barang yang tersedia di gudang</p>
                </div>
                <div class="w-full sm:w-64 shrink-0 relative">
                    <input type="text" 
                            @bind="SearchQuery" 
                            @bind:event="oninput" 
                            placeholder="Cari nama barang atau SKU..." 
                            class="w-full pl-10 pr-4 py-2 bg-[#f9f8f6] border border-[#e5e3dc] rounded-full text-sm font-semibold text-[#5a5855] focus:outline-none focus:ring-2 focus:ring-[#e8a000] focus:bg-white transition-all" />
                    <svg class="w-4 h-4 text-[#8a8880] absolute left-3.5 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                </div>
            </div>

            @* Category Pills *@
            @if (Categories != null && Categories.Any()) {
            <div class="flex items-center gap-2 mt-4 overflow-x-auto pb-1">
                <button @onclick="() => FilterByCategory(null)"
                   class="px-3 py-1 bg-white border border-[#e5e3dc] hover:border-[#1a1a1a] text-xs font-semibold text-[#5a5855] hover:text-[#1a1a1a] rounded-full transition cursor-pointer shrink-0 @(!SelectedCategoryId.HasValue ? "!bg-[#1a1a1a] !border-[#1a1a1a] !text-white hover:!text-white" : "")">
                    All
                </button>
                @foreach(var cat in Categories) {
                    <button @onclick="() => FilterByCategory(cat.id)"
                       class="px-3 py-1 bg-white border border-[#e5e3dc] hover:border-[#1a1a1a] text-xs font-semibold text-[#5a5855] hover:text-[#1a1a1a] rounded-full transition cursor-pointer shrink-0 @(SelectedCategoryId == cat.id ? "!bg-[#1a1a1a] !border-[#1a1a1a] !text-white hover:!text-white" : "")">
                        @cat.name
                    </button>
                }
            </div>
            }
        </div>

        @* Table *@
        @if(CatalogProducts == null) {
             <div class="px-6 py-16 text-center text-[#8a8880]">Loading...</div>
        }
        else if(CatalogProducts.Any()) {
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 p-4" id="catalogGrid">
            @foreach(var product in CatalogProducts) {
                
            <div @onclick="() => OpenProductModal(product)" class="bg-white border border-[#e5e3dc] rounded-xl overflow-hidden shadow-sm hover:shadow-lg hover:-translate-y-1 hover:border-[#e8a000] transition-all duration-300 flex flex-col group product-item cursor-pointer text-left focus:outline-none focus:ring-2 focus:ring-[#e8a000]" tabindex="0" role="button">
                @* Image Container *@
                <div class="aspect-square relative bg-[#f5f4f0] flex items-center justify-center overflow-hidden border-b border-[#f0ede5]">
                    <img src="@GetProductDisplayImage(product)" alt="@product.name" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" onerror="this.onerror=null;this.src='https://placehold.co/600x400?text=No+Picture';">
                    
                    @* Stock Badges Overlay *@
                    <div class="absolute top-2 left-2 flex flex-col gap-1">
                        @if(product.current_stock <= 0) {
                            <span class="px-2 py-0.5 bg-[#fef0f0] border border-[#f8c0c0] text-[#d94040] text-[0.6rem] font-bold rounded shadow-sm tracking-wider uppercase">Habis</span>
                        }
                    </div>
                </div>
                
                @* Product Info *@
                <div class="p-3.5 flex flex-col flex-grow">
                    <div class="flex items-center justify-between gap-1 mb-1.5">
                        <span class="text-[0.65rem] font-bold text-[#8a8880] truncate group-hover:text-[#e8a000] transition-colors">
                            @(product.Category != null ? product.Category.name : "--")
                        </span>
                        <code class="text-[0.55rem] font-medium text-[#8a8880] bg-[#f0ede5] px-1.5 py-0.5 rounded">@product.sku</code>
                    </div>
                    
                    <h4 class="text-base font-extrabold text-[#1a1a1a] leading-snug line-clamp-4 mb-3 flex-grow group-hover:text-[#e8a000] transition-colors" title="@product.name">
                        @product.name
                    </h4>
                    
                    @* Stock Info *@
                    <div class="mt-auto">
                        <div class="flex items-center justify-between text-xs pb-1 border-b border-transparent">
                            <div class="flex flex-col gap-0.5">
                                <span class="text-[#8a8880] text-[0.65rem]">Kredit</span>
                                @if (product.is_returnable == 1 || product.transaction_type == "BORROW")
                                {
                                    <span class="font-bold text-[#8a8880]">-</span>
                                }
                                else
                                {
                                    <span class="font-bold text-[#e8a000]">@product.value <span class="font-normal text-[0.65rem] text-[#8a8880]">pts</span></span>
                                }
                            </div>
                            <div class="flex flex-col gap-0.5 text-right">
                                <span class="text-[#8a8880] text-[0.65rem]">Stok</span>
                                <span class="font-bold @(product.current_stock <= 0 ? "text-[#d94040]" : "text-[#1a7a30]")">
                                    @product.current_stock <span class="font-normal text-[0.65rem] text-[#8a8880]">@(product.Unit != null ? product.Unit.name : "unit")</span>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            }
        </div>
        
        @* Pagination *@
        @if (TotalPages > 1) {
        <div class="px-6 py-4 border-t border-[#f0ede5] flex justify-center">
            <div class="flex items-center gap-1 bg-[#f9f8f6] p-1.5 rounded-lg border border-[#e5e3dc]">
                <button @onclick="() => LoadData(CurrentPage - 1)" disabled="@(CurrentPage == 1)" class="w-8 h-8 flex items-center justify-center rounded text-[#5a5855] hover:bg-white hover:text-[#1a1a1a] hover:shadow-sm disabled:opacity-30 disabled:hover:bg-transparent disabled:hover:shadow-none transition-all">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                </button>
                
                @for(int i = 1; i <= TotalPages; i++) {
                    int pageNumber = i;
                    <button @onclick="() => LoadData(pageNumber)" class="w-8 h-8 flex items-center justify-center rounded text-xs font-bold transition-all @(CurrentPage == pageNumber ? "bg-[#1a1a1a] text-white shadow-sm" : "text-[#5a5855] hover:bg-white hover:text-[#1a1a1a] hover:shadow-sm")">
                        @pageNumber
                    </button>
                }

                <button @onclick="() => LoadData(CurrentPage + 1)" disabled="@(CurrentPage == TotalPages)" class="w-8 h-8 flex items-center justify-center rounded text-[#5a5855] hover:bg-white hover:text-[#1a1a1a] hover:shadow-sm disabled:opacity-30 disabled:hover:bg-transparent disabled:hover:shadow-none transition-all">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </button>
            </div>
        </div>
        }
        
        } else {
        <div class="px-6 py-16 text-center">
            <p class="text-[0.85rem] text-[#8a8880]">No products found.</p>
        </div>
        }
    </div>

    @if (TotalPages > 1)
    {
        <div class="mt-4 shadow-sm border border-[#e5e3dc] rounded-xl overflow-hidden bg-white flex items-center justify-between px-6 py-4">
            <span class="text-sm text-gray-500 font-medium">Showing page @CurrentPage of @TotalPages</span>
            <div class="flex gap-2">
                <button disabled="@(CurrentPage == 1)" @onclick="() => LoadData(CurrentPage - 1)" class="px-3 py-1.5 border border-[#e5e3dc] rounded-md text-sm font-semibold hover:bg-gray-50 disabled:opacity-50 transition">Previous</button>
                <button disabled="@(CurrentPage == TotalPages)" @onclick="() => LoadData(CurrentPage + 1)" class="px-3 py-1.5 border border-[#e5e3dc] rounded-md text-sm font-semibold hover:bg-gray-50 disabled:opacity-50 transition">Next</button>
            </div>
        </div>
    }

    @* Footer *@
    <div class="flex items-center justify-between mt-8 pt-6 border-t border-[#e5e3dc] text-[0.72rem] text-[#8a8880]">
        <span>© 2026 United Tractors Corporate University (corpu)</span>
        <span class="inline-flex items-center gap-1.5 font-semibold text-[#1a7a30]">
            <span class="w-2 h-2 rounded-full bg-[#1a7a30] inline-block"></span>
            System Operational
        </span>
    </div>

</div>

@* Toast konfirmasi tambah ke keranjang *@
@if (!string.IsNullOrEmpty(CartToast))
{
    <div class="fixed bottom-44 sm:bottom-28 right-8 z-50 bg-[#1a7a30] text-white text-sm font-semibold px-4 py-2.5 rounded-xl shadow-2xl flex items-center gap-2 max-w-xs">
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        <span class="truncate">@CartToast</span>
