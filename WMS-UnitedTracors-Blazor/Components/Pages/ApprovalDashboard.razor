                                <button @onclick='() => AskConfirm("Tolak Perubahan Profil", "Tolak permintaan perubahan profil ini?", () => RejectProfileRequest(pr.id), "Ya, Tolak")' 
                                        class="flex-1 bg-white border border-red-200 text-red-600 hover:bg-red-50 text-xs font-extrabold rounded-xl transition active:scale-[0.98] select-none h-full flex items-center justify-center">
                                    Reject
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

