@page "/TransactionHistory"
@page "/Transactions/History"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using UT_WMSDotnet.Models
@using WMS_UnitedTracors_Blazor.Services
@inject TransactionService TransactionService
@inject DivisionService DivisionService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Transaction History</PageTitle>

<div class="py-8 md:py-12 bg-[#f5f4f0] min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <h2 class="font-semibold text-xl text-gray-800 leading-tight mb-6">
            Stock History
        </h2>

        <div class="bg-white overflow-hidden shadow-sm sm:rounded-lg border border-gray-100 mb-6">
            <div class="p-6 text-gray-900">
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:flex lg:items-end gap-4">
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1">Start Date</label>
                        <input type="date" @bind="StartDate" class="w-full rounded-md border-gray-300 shadow-sm focus:border-[#e8a000] focus:ring-[#e8a000] sm:text-sm">
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1">End Date</label>
                        <input type="date" @bind="EndDate" class="w-full rounded-md border-gray-300 shadow-sm focus:border-[#e8a000] focus:ring-[#e8a000] sm:text-sm">
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1">Filter Type</label>
                        <select @bind="FilterType" @bind:after="OnFilterTypeChanged" class="w-full rounded-md border-gray-300 shadow-sm focus:border-[#e8a000] focus:ring-[#e8a000] sm:text-sm">
                            <option value="">All Types</option>
                            <option value="IN">STOCK IN</option>
                            <option value="OUT">STOCK OUT</option>
                        </select>
                    </div>
                    @if (FilterType == "OUT")
                    {
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-1">Request Type</label>
                            <select @bind="FilterRequestType" @bind:after="OnFilterRequestTypeChanged" class="w-full rounded-md border-gray-300 shadow-sm focus:border-[#e8a000] focus:ring-[#e8a000] sm:text-sm">
                                <option value="">All Request Types</option>
                                <option value="GIVEAWAY">Diminta / Giveaway</option>
                                <option value="BORROW">Dipinjam / Borrow</option>
                            </select>
                        </div>
                    }
                    @if (FilterType == "OUT" && FilterRequestType == "BORROW")
                    {
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-1">Return Status</label>
                            <select @bind="FilterIsReturnedStr" class="w-full rounded-md border-gray-300 shadow-sm focus:border-[#e8a000] focus:ring-[#e8a000] sm:text-sm">
                                <option value="">All Statuses</option>
                                <option value="true">Sudah Dikembalikan</option>
                                <option value="false">Belum Dikembalikan</option>
                            </select>
                        </div>
                    }
                    <div class="sm:col-span-2 lg:col-span-1 flex items-end gap-2">
                        <button type="button" @onclick="() => LoadData(1)" class="flex-1 lg:flex-none px-4 py-2.5 bg-[#1a1a1a] text-white text-sm font-semibold rounded-md shadow-sm hover:bg-gray-800 transition">Apply Filters</button>
                        <button type="button" @onclick="ResetFilters" class="flex-1 lg:flex-none px-4 py-2.5 bg-white border border-gray-300 text-gray-700 text-sm font-semibold rounded-md shadow-sm hover:bg-gray-50 transition">Reset</button>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="mb-4 flex items-center gap-3 bg-[#eef9f0] border border-[#b8e8c0] text-[#1a7a30] px-4 py-3 rounded-lg text-sm font-semibold">
                <svg class="w-4 h-4 shrink-0 text-[#1a7a30]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                @SuccessMessage
            </div>
        }
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="mb-4 flex items-center gap-3 bg-[#fef0f0] border border-[#f8c0c0] text-[#d94040] px-4 py-3 rounded-lg text-sm font-semibold">
                <svg class="w-4 h-4 shrink-0 text-[#d94040]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                @ErrorMessage
            </div>
        }

        @if (Transactions == null || !Transactions.Any())
        {
            <div class="bg-white p-12 rounded-lg border border-gray-200 text-center shadow-sm">
                <svg class="w-12 h-12 text-gray-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
                <p class="text-sm font-medium text-gray-500">No transaction history found.</p>
                <p class="text-xs text-gray-400 mt-1">Try adjusting your filters or date range.</p>
            </div>
        }
        else
        {
            <div class="space-y-4">
                @foreach (var group in GroupedTransactions)
                {
                    var items = group.Value;
                    var firstItem = items.First();
                    bool isExpanded = ExpandedGroups.Contains(group.Key);
                    
                    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                        <!-- Accordion Header -->
                        <div @onclick="() => ToggleGroup(group.Key)" class="flex items-center justify-between p-5 cursor-pointer hover:bg-gray-50 transition select-none">
                            <div>
                                <div class="flex items-center gap-3 mb-1">
                                    <span class="text-xs font-bold px-2 py-0.5 rounded-full @(firstItem.type == "IN" ? "bg-blue-100 text-blue-700" : "bg-purple-100 text-purple-700")">
                                        @(firstItem.type == "IN" ? "STOCK IN" : "STOCK OUT")
                                    </span>
                                    <span class="text-sm font-bold text-gray-900">
                                        @(firstItem.created_at.ToString("dd MMM yyyy, HH:mm"))
                                    </span>
                                </div>
                                <div class="text-xs text-gray-500 font-medium">
                                    Submitted by: <span class="text-gray-700">@(firstItem.Requester?.name)</span>
                                    @if (firstItem.type == "OUT" && !string.IsNullOrEmpty(firstItem.event_name)) {
                                        <span class="mx-1">•</span> <span>Event: <span class="text-gray-700">@firstItem.event_name</span></span>
                                    }
                                </div>
                            </div>
                            <div class="text-gray-400">
                                <svg class="w-5 h-5 transform transition-transform duration-200 @(isExpanded ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                            </div>
                        </div>

                        <!-- Accordion Content -->
                        @if (isExpanded)
                        {
                            <div class="border-t border-gray-200">
                                @if (firstItem.type == "OUT") {
                                <div class="p-4 bg-white border-b border-gray-100">
                                    <h4 class="text-[0.65rem] font-bold uppercase tracking-wider text-gray-400 mb-3">Form Details</h4>
                                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                                        <div>
                                            <div class="text-[0.65rem] text-gray-500 font-bold uppercase tracking-wider mb-1">Applicant</div>
                                            <div class="text-sm font-medium text-gray-900">@(firstItem.applicant_name ?? "-")</div>
                                            <div class="text-xs text-gray-500">NRP: @(firstItem.applicant_nrp ?? "-")</div>
                                        </div>
                                        <div>
                                            <div class="text-[0.65rem] text-gray-500 font-bold uppercase tracking-wider mb-1">Event / Program</div>
                                            <div class="text-sm font-medium text-gray-900">@(firstItem.event_name ?? "-")</div>
                                            <div class="text-xs text-gray-500">@(firstItem.event_date?.ToString("MMM dd, yyyy") ?? "-")</div>
                                        </div>
                                        <div>
                                            <div class="text-[0.65rem] text-gray-500 font-bold uppercase tracking-wider mb-1">Division</div>
                                            <div class="text-sm font-medium text-gray-900">@(firstItem.Division?.name ?? "-")</div>
                                        </div>
                                        <div>
                                            <div class="text-[0.65rem] text-gray-500 font-bold uppercase tracking-wider mb-1">Documentation</div>
                                            <div class="text-sm font-medium text-[#e8a000]">
                                                @if (!string.IsNullOrEmpty(firstItem.documentation_link)) {
                                                    <a href="@firstItem.documentation_link" target="_blank" class="hover:underline flex items-center gap-1">
                                                        Link
                                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                                                    </a>
                                                } else {
                                                    <span>-</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                }

                                <!-- Item List -->
                                <div class="bg-gray-50 p-4">
                                    <div class="flex justify-between items-center mb-3">
                                        <h4 class="text-[0.65rem] font-bold uppercase tracking-wider text-gray-400">Items Requested</h4>
                                        <a href="/Receipt/@(firstItem.type == "IN" ? "Return" : "Transaction")/@firstItem.id" target="_blank" class="text-xs font-bold text-[#1a1a1a] bg-white border border-[#e5e3dc] rounded px-3 py-1 hover:bg-gray-100 flex items-center gap-1">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
                                            Cetak Struk / PDF
                                        </a>
                                    </div>
                                    
                                    <!-- Desktop View Table -->
                                    <div class="hidden md:block overflow-x-auto">
                                        <table class="w-full text-left">
                                            <thead>
                                                <tr class="border-b border-gray-200">
                                                    <th class="pb-2 text-[0.65rem] font-bold text-gray-500 uppercase tracking-wider">Product</th>
                                                    <th class="pb-2 text-[0.65rem] font-bold text-gray-500 uppercase tracking-wider text-center">Qty</th>
                                                    <th class="pb-2 text-[0.65rem] font-bold text-gray-500 uppercase tracking-wider">Status</th>
                                                    <th class="pb-2 text-[0.65rem] font-bold text-gray-500 uppercase tracking-wider">Return Status</th>
                                                    <th class="pb-2 text-[0.65rem] font-bold text-gray-500 uppercase tracking-wider text-right">Notes</th>
                                                </tr>
                                            </thead>
                                            <tbody class="divide-y divide-gray-100">
                                                @foreach (var item in items) {
                                                <tr class="bg-white">
                                                    <td class="py-3 px-3">
                                                        <div class="flex items-center gap-3">
                                                            @if (!string.IsNullOrEmpty(item.Product?.image)) {
                                                                <img src="@($"/{item.Product.image}")" class="w-8 h-8 rounded object-cover border border-gray-200" />
                                                            }
                                                            <div>
                                                                <div class="text-sm font-semibold text-gray-900">
                                                                    @(item.Product?.name)
                                                                    @if(item.ProductVariant != null) {
                                                                        var variantTexts = new List<string>();
                                                                        if (!string.IsNullOrEmpty(item.ProductVariant.color)) variantTexts.Add(item.ProductVariant.color);
                                                                        if (!string.IsNullOrEmpty(item.ProductVariant.size)) variantTexts.Add(item.ProductVariant.size);
                                                                        if (variantTexts.Any()) {
                                                                            <span class="text-xs text-gray-500 font-normal ml-1">(@string.Join(", ", variantTexts))</span>
                                                                        }
                                                                    }
                                                                </div>
                                                                <div class="text-[10px] text-gray-500">@(item.Product?.sku)</div>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td class="py-3 px-3 text-center">
                                                                 <div class="text-sm font-bold text-gray-900">@(item.quantity ?? 0)</div>
                                                    </td>
                                                    <td class="py-3 px-3">
                                                        @if (item.status == "PENDING") {
                                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-[#fef3c7] text-[#92400e] border border-[#fde68a]">PENDING</span>
                                                        } else if (item.status == "APPROVED") {
                                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-[#eef9f0] text-[#1a7a30] border border-[#b8e8c0]">APPROVED</span>
                                                            <div class="text-[10px] text-gray-500 mt-1">By @(item.Approver?.name)</div>
                                                        } else if (item.status == "REVISION") {
                                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-[#e0e7ff] text-[#4338ca] border border-[#c7d2fe]">REVISION</span>
                                                            @if (!string.IsNullOrEmpty(item.rejection_reason)) {
                                                                <div class="text-[10px] text-[#4338ca] mt-1 italic">"@item.rejection_reason"</div>
                                                            }
                                                            <div class="mt-2 flex flex-col items-start sm:flex-row gap-1.5 sm:items-end">
                                                                <button type="button" @onclick="() => OpenRevisionModal(item)" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-bold text-white bg-amber-500 active:scale-95 rounded-md shadow-sm cursor-pointer">
                                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                                                    Revise
                                                                </button>
                                                                <button type="button" @onclick="() => CancelRevision(item.id)" class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-semibold text-red-600 bg-red-50 rounded-md border border-red-200 shadow-sm cursor-pointer">
                                                                    Cancel
                                                                </button>
                                                            </div>
                                                        } else {
                                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-[#fef0f0] text-[#d94040] border border-[#f8c0c0]">REJECTED</span>
                                                            @if (!string.IsNullOrEmpty(item.rejection_reason)) {
                                                                <div class="text-[10px] text-red-500 mt-1 italic">"@item.rejection_reason"</div>
                                                            }
                                                        }
                                                    </td>
                                                    <td class="py-3 px-3">
                                                        @if (item.type == "OUT" && item.status == "APPROVED") {
                                                            if (item.request_type == "GIVEAWAY") {
                                                                <span class="text-xs font-semibold text-[#8a8880] italic">Given Away (No return)</span>
                                                            } else {
                                                                 int remaining = (item.quantity ?? 0) - (item.returned_quantity ?? 0);
                                                                if (remaining <= 0) {
                                                                    <span class="inline-flex items-center gap-1 text-xs font-bold text-[#1a7a30]">
                                                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                                                        Returned Fully
                                                                    </span>
                                                                    @if (!string.IsNullOrEmpty(item.return_photo) && item.return_photo != "forced-by-admin") {
                                                                        <div class="mt-1">
                                                                            <a href="@($"/{item.return_photo}")" target="_blank" class="inline-flex items-center gap-1 text-[10px] font-bold text-[#1a6b8a] hover:underline">
                                                                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                                                                View Proof
                                                                            </a>
                                                                        </div>
                                                                    }
                                                                } else {
                                                                    <span class="text-xs font-semibold text-gray-600">
                                                                        Returned: @(item.returned_quantity)/@(item.quantity)
                                                                    </span>
                                                                    if (item.is_return_draft != 0 && item.pending_return_quantity > 0) {
                                                                        <div class="text-[10px] font-bold text-orange-600 mt-1">Pending approval: @item.pending_return_quantity</div>
                                                                    }
                                                                }
                                                            }
                                                        } else {
                                                            <span class="text-gray-300 text-xs">-</span>
                                                        }
                                                    </td>
                                                    <td class="py-3 px-3 text-right text-xs text-gray-500 space-y-1">
                                                        @if (!string.IsNullOrEmpty(item.notes)) { <div><span class="font-bold text-gray-400">User:</span> @item.notes</div> }
                                                        @if (!string.IsNullOrEmpty(item.admin_notes)) { <div><span class="font-bold text-[#e8a000]">Admin:</span> @item.admin_notes</div> }
                                                        @if (!string.IsNullOrEmpty(item.manager_notes)) { <div><span class="font-bold text-[#e8a000]">Manager:</span> @item.manager_notes</div> }
                                                        @if (string.IsNullOrEmpty(item.notes) && string.IsNullOrEmpty(item.admin_notes) && string.IsNullOrEmpty(item.manager_notes)) { <span>-</span> }
                                                    </td>
                                                </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                    <!-- Mobile View Card List -->
                                    <div class="block md:hidden space-y-3">
                                        @foreach (var item in items) {
                                            <div class="bg-white p-4 rounded-lg border border-gray-200 shadow-sm space-y-3">
                                                <div class="flex items-center gap-3">
                                                    @if (!string.IsNullOrEmpty(item.Product?.image)) {
                                                        <img src="@($"/{item.Product.image}")" class="w-10 h-10 rounded object-cover border border-gray-200" />
                                                    }
                                                    <div>
                                                        <div class="text-sm font-semibold text-gray-900">
                                                            @(item.Product?.name)
                                                            @if(item.ProductVariant != null) {
                                                                var variantTexts = new List<string>();
                                                                if (!string.IsNullOrEmpty(item.ProductVariant.color)) variantTexts.Add(item.ProductVariant.color);
                                                                if (!string.IsNullOrEmpty(item.ProductVariant.size)) variantTexts.Add(item.ProductVariant.size);
                                                                if (variantTexts.Any()) {
                                                                    <span class="text-xs text-gray-500 font-normal ml-1">(@string.Join(", ", variantTexts))</span>
                                                                }
                                                            }
                                                        </div>
                                                        <div class="text-[10px] text-gray-500">@(item.Product?.sku)</div>
                                                    </div>
                                                </div>
                                                <div class="grid grid-cols-2 gap-2 pt-2 border-t border-gray-100 text-xs">
                                                    <div>
                                                        <span class="text-gray-400 font-medium">Qty:</span>
                                                                 <span class="font-bold text-gray-900 ml-1">@(item.quantity ?? 0)</span>
                                                    </div>
                                                    <div>
                                                        <span class="text-gray-400 font-medium">Status:</span>
                                                        <span class="ml-1">
                                                            @if (item.status == "PENDING") {
                                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-[#fef3c7] text-[#92400e] border border-[#fde68a]">PENDING</span>
                                                            } else if (item.status == "APPROVED") {
                                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-[#eef9f0] text-[#1a7a30] border border-[#b8e8c0]">APPROVED</span>
                                                            } else if (item.status == "REVISION") {
                                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-[#e0e7ff] text-[#4338ca] border border-[#c7d2fe]">REVISION</span>
                                                                <div class="mt-2 flex gap-1.5 items-end">
                                                                    <button type="button" @onclick="() => OpenRevisionModal(item)" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-bold text-white bg-amber-500 active:scale-95 rounded-md shadow-sm cursor-pointer">
                                                                        Revise
                                                                    </button>
                                                                    <button type="button" @onclick="() => CancelRevision(item.id)" class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-semibold text-red-600 bg-red-50 rounded-md border border-red-200 shadow-sm cursor-pointer">
                                                                        Cancel
                                                                    </button>
                                                                </div>
                                                            } else {
                                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-[#fef0f0] text-[#d94040] border border-[#f8c0c0]">REJECTED</span>
                                                            }
                                                        </span>
                                                    </div>
                                                </div>
                                                <div class="text-xs pt-1">
                                                    <span class="text-gray-400 font-medium">Return Status:</span>
                                                    <span class="ml-1">
                                                        @if (item.type == "OUT" && item.status == "APPROVED") {
                                                            if (item.request_type == "GIVEAWAY") {
                                                                <span class="font-semibold text-[#8a8880] italic">Given Away (No return)</span>
                                                            } else {
                                                                 int remaining = (item.quantity ?? 0) - (item.returned_quantity ?? 0);
                                                                if (remaining <= 0) {
                                                                    <span class="font-bold text-[#1a7a30] block">Returned Fully</span>
                                                                    @if (!string.IsNullOrEmpty(item.return_photo) && item.return_photo != "forced-by-admin") {
                                                                        <a href="@($"/{item.return_photo}")" target="_blank" class="inline-flex items-center gap-1 text-[10px] font-bold text-[#1a6b8a] hover:underline mt-1">
                                                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                                                            View Proof
                                                                        </a>
                                                                    }
                                                                } else {
                                                                    <span class="font-semibold text-gray-600">Returned: @(item.returned_quantity)/@(item.quantity)</span>
                                                                }
                                                            }
                                                        } else {
                                                            <span class="text-gray-400">-</span>
                                                        }
                                                    </span>
                                                </div>
                                                @if (!string.IsNullOrEmpty(item.notes) || !string.IsNullOrEmpty(item.admin_notes) || !string.IsNullOrEmpty(item.manager_notes)) {
                                                    <div class="text-xs pt-1 bg-gray-50 p-2 rounded border border-gray-100 italic text-gray-600 space-y-1">
                                                        @if (!string.IsNullOrEmpty(item.notes)) { <div><span class="font-medium text-gray-400 not-italic">User:</span> @item.notes</div> }
                                                        @if (!string.IsNullOrEmpty(item.admin_notes)) { <div><span class="font-medium text-[#e8a000] not-italic">Admin:</span> @item.admin_notes</div> }
                                                        @if (!string.IsNullOrEmpty(item.manager_notes)) { <div><span class="font-medium text-[#e8a000] not-italic">Manager:</span> @item.manager_notes</div> }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>

                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (TotalPages > 1)
            {
                <div class="mt-4 shadow-sm border border-[#e5e3dc] rounded-xl overflow-hidden bg-white flex items-center justify-between px-6 py-4">
                    <span class="text-sm text-gray-500 font-medium">Showing page @CurrentPage of @TotalPages</span>
                    <div class="flex gap-2">
                        <button disabled="@(CurrentPage == 1)" @onclick="() => LoadData(CurrentPage - 1)" class="px-3 py-1.5 border border-[#e5e3dc] rounded-md text-sm font-semibold hover:bg-gray-50 disabled:opacity-50 transition">Previous</button>
                        <button disabled="@(CurrentPage == TotalPages)" @onclick="() => LoadData(CurrentPage + 1)" class="px-3 py-1.5 border border-[#e5e3dc] rounded-md text-sm font-semibold hover:bg-gray-50 disabled:opacity-50 transition">Next</button>
                    </div>
                </div>
            }
        }
    </div>
</div>

