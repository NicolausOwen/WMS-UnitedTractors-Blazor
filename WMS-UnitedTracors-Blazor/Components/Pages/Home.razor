                        {
                            <div class="mb-4 flex items-center gap-3 bg-[#fef0f0] border border-[#f8c0c0] text-[#d94040] px-4 py-3 rounded-lg text-sm font-semibold">
                                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                                @ErrorMessage
                            </div>
                        }
                        @if(!CartService.Items.Any())
                        {
                            <div class="text-center py-8">
                                <p class="text-sm text-[#8a8880]">Keranjang kosong. Silakan tambahkan barang dari katalog.</p>
                            </div>
                        }
                        else
                        {
                            <div class="mt-4 mb-4 bg-[#faf9f5] p-4 rounded-[10px] border border-[#e5e3dc]">
                                <div class="flex justify-between items-center mb-2">
                                    <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880]">Items to Borrow</label>
                                </div>
                                <div class="space-y-3 max-h-60 overflow-y-auto pr-2">
                                    @foreach(var item in CartService.Items)
                                    {
                                        <div class="bg-white border border-[#e5e3dc] rounded-xl p-3.5 flex flex-col gap-3 shadow-sm hover:border-gray-300 transition-colors">
                                            <div class="flex items-center justify-between gap-3">
                                                <div class="flex-1 min-w-0 text-left">
                                                    <h4 class="text-xs font-bold text-[#1a1a1a] truncate" title="@item.Name">@item.Name</h4>
                                                    <div class="flex items-center gap-1.5 mt-1 text-[10px] text-gray-500 font-semibold">
                                                        <span>Sku: @item.Sku</span>
                                                        <span>•</span>
                                                        <span>Type: <span class="text-[#e8a000]">@item.RequestType</span></span>
                                                    </div>
                                                </div>
                                                <div class="flex items-center gap-2 shrink-0">
                                                    <div class="flex items-center border border-[#e5e3dc] rounded-lg overflow-hidden bg-white h-8">
                                                        <button type="button" @onclick="() => { if(item.Quantity > 1) item.Quantity--; }" class="w-7 h-full flex items-center justify-center text-xs text-[#5a5855] hover:bg-[#f5f4f0] transition font-bold select-none">-</button>
                                                        <input type="number" @bind="item.Quantity" @bind:event="oninput" min="1" max="@item.MaxStock" class="w-10 text-center py-0.5 text-xs outline-none bg-transparent font-bold">
                                                        <button type="button" @onclick="() => { if(item.Quantity < item.MaxStock) item.Quantity++; }" class="w-7 h-full flex items-center justify-center text-xs text-[#5a5855] hover:bg-[#f5f4f0] transition font-bold select-none">+</button>
                                                    </div>
                                                    <button type="button" class="p-1.5 text-[#d94040] hover:bg-[#fef0f0] rounded-lg bg-transparent border border-transparent hover:border-[#f8c0c0] cursor-pointer transition shrink-0" @onclick="() => CartService.RemoveItem(item)" title="Hapus">
                                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                                    </button>
                                                </div>
                                            </div>
                                            @if (item.RequestType == "BORROW")
                                            {
                                                <div class="flex gap-2">
                                                    <input type="date" @bind="item.BorrowStartDate" class="w-full px-2 py-1.5 text-[10px] bg-white border border-[#e5e3dc] rounded outline-none focus:border-[#e8a000]" title="Tanggal Pinjam">
                                                    <input type="date" @bind="item.ExpectedReturnDate" class="w-full px-2 py-1.5 text-[10px] bg-white border border-[#e5e3dc] rounded outline-none focus:border-[#e8a000]" title="Tanggal Kembali">
                                                </div>
                                            }
                                            @if (item.RequestType == "GIVEAWAY")
                                            {
                                                <div>
                                                    <input type="date" @bind="item.PickupDate" class="w-full px-2 py-1.5 text-[10px] bg-white border border-[#e5e3dc] rounded outline-none focus:border-[#e8a000]" title="Tanggal Pengambilan">
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                                <div class="flex justify-between items-center mt-4 border-t border-[#e5e3dc] pt-3">
                                    <span class="text-[0.65rem] font-bold tracking-wider uppercase text-[#8a8880]">Total Kredit Dibutuhkan</span>
                                    <span class="text-[0.8rem] font-bold text-[#e8a000]">@CartService.GetTotalCredit() <span class="font-normal text-[0.65rem] text-[#8a8880]">pts</span></span>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Nama Pemohon</label>
                                    <input type="text" readonly value="@ApplicantName" class="w-full px-3.5 py-2.5 text-xs bg-[#ecebe8] border border-[#e5e3dc] rounded-lg outline-none text-[#5a5855] cursor-not-allowed">
                                </div>
                                <div>
                                    <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">NRP Pemohon</label>
                                    <input type="text" readonly value="@ApplicantNrp" class="w-full px-3.5 py-2.5 text-xs bg-[#ecebe8] border border-[#e5e3dc] rounded-lg outline-none text-[#5a5855] cursor-not-allowed">
                                </div>
                            </div>

                            <div class="mt-4">
                                <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Event / Program</label>
                                <input type="text" @bind="EventName" placeholder="Name of event or program" class="w-full px-3.5 py-2.5 text-xs bg-[#f5f4f0] border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none text-[#1a1a1a]">
                            </div>

                            <div class="mt-4">
                                <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Tanggal Event</label>
                                <input type="date" @bind="EventDate" class="w-full px-3.5 py-2.5 text-xs bg-[#f5f4f0] border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none text-[#1a1a1a]">
                            </div>



                            <div class="mt-4">
                                <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Catatan Tambahan</label>
                                <textarea @bind="Notes" rows="2" placeholder="Optional notes..." class="w-full px-3.5 py-2.5 text-xs bg-[#f5f4f0] border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none text-[#1a1a1a] resize-none"></textarea>
                            </div>
                        }
                    </div>

                    <div class="px-6 py-4 flex flex-row-reverse gap-3 bg-[#faf9f5] border-t border-[#f0ede5]">
                        @if(CartService.Items.Count > 0)
                        {
                            <button type="button" @onclick="SubmitBorrowRequest" class="px-5 py-2.5 bg-[#e8a000] hover:bg-[#d49300] active:scale-[0.98] text-[#1a1a1a] text-xs font-bold tracking-wider rounded-lg transition cursor-pointer">
                                Submit Request
                            </button>
                        }
                                 <button type="button" @onclick="CloseCartModal" class="inline-flex justify-center px-5 py-2.5 bg-white border border-[#e5e3dc] hover:bg-[#f0ede5] text-[#3a3835] text-xs font-bold rounded-lg transition cursor-pointer">
                                     Cancel
                                 </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@* Add to Cart Modal (Olshop Style) Blazor Port *@
@if (ShowProductModal && SelectedProduct != null)
{
    <div id="addToCartModal" class="fixed inset-0 z-[70] flex" role="dialog" aria-modal="true">
        <div class="fixed inset-0 backdrop-blur-sm transition-opacity bg-[#1a1a1a]/65" @onclick="CloseProductModal"></div>
        <div class="fixed inset-0 z-10 overflow-y-auto md:pl-[var(--ut-sidebar-w)] transition-all flex items-end sm:items-center justify-center sm:p-4 text-center" @onclick="CloseProductModal">
            <div class="relative transform overflow-hidden rounded-t-2xl sm:rounded-xl bg-white text-left shadow-2xl transition-all w-full max-w-5xl sm:my-8 border-t sm:border border-[#e5e3dc]" @onclick:stopPropagation="true">
                <div class="px-5 py-4 border-b border-[#f0ede5] flex items-center justify-between sticky top-0 bg-white z-10">
                    <h3 class="font-bold text-[#1a1a1a] text-sm" id="addToCartTitle">Detail Produk</h3>
                    <button type="button" @onclick="CloseProductModal" class="text-[#a09e99] hover:text-[#1a1a1a] transition p-1 bg-[#f5f4f0] rounded-full">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                    </button>
                </div>
                
                <div class="px-5 py-4 pb-20 sm:pb-4">
                    @if(!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div class="mb-4 flex items-center gap-3 bg-[#fef0f0] border border-[#f8c0c0] text-[#d94040] px-4 py-3 rounded-lg text-sm font-semibold">
                            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                            @ErrorMessage
                        </div>
                    }
                    <div class="grid grid-cols-1 lg:grid-cols-[0.85fr_1.15fr] gap-5">
                        <div class="space-y-5">
                            @* Image Carousel *@
                            <div class="relative w-full aspect-square lg:aspect-[4/3] bg-[#f5f4f0] rounded-xl overflow-hidden border border-[#e5e3dc] mb-3 cursor-crosshair"
                                 onmousemove="const r=this.getBoundingClientRect();const x=(event.clientX-r.left)/r.width*100;const y=(event.clientY-r.top)/r.height*100;const i=this.querySelector('img');i.style.transformOrigin=`${x}% ${y}%`;i.style.transform='scale(2)';"
                                 onmouseleave="const i=this.querySelector('img');i.style.transformOrigin='center';i.style.transform='scale(1)';">
                                <img src="@GetImageUrl(SelectedMainImage)" class="w-full h-full object-cover transition-transform duration-200" onerror="this.onerror=null;this.src='https://placehold.co/600x400?text=No+Picture';">
                            </div>
                            
                            @if(ModalImages.Count > 1) {
                                <div class="flex gap-2 overflow-x-auto pb-2" style="scrollbar-width: thin;">
                                    @foreach(var img in ModalImages) {
                                        <button type="button" @onclick="() => SelectImage(img)" class="relative w-16 h-16 rounded-lg overflow-hidden shrink-0 border-2 transition-colors @(SelectedMainImage == img ? "border-[#e8a000]" : "border-transparent opacity-70 hover:opacity-100")">
                                            <img src="@GetImageUrl(img)" class="w-full h-full object-cover" />
                                        </button>
                                    }
                                </div>
                            }
                            
                            @* Description *@
                            @if (!string.IsNullOrEmpty(SelectedProduct.description))
                            {
                            <div class="w-full bg-[#f9f8f6] border border-[#e5e3dc] rounded-xl p-4">
                                <h5 class="text-xs font-bold text-[#1a1a1a] mb-1.5">Deskripsi Produk</h5>
                                <p class="text-xs text-[#5a5855] leading-relaxed whitespace-pre-wrap break-all">@SelectedProduct.description</p>
                            </div>
                            }
                        </div>

                        <div class="flex flex-col justify-between gap-5 min-w-0">
                            <div class="space-y-5">
                                @* Product Info *@
                                <div>
                                    <div class="flex justify-between items-start gap-4 mb-1">
                                        <h4 class="text-base font-bold text-[#1a1a1a] leading-tight">@SelectedProduct.name</h4>
                                        <div class="text-right shrink-0">
                                            <span class="text-xs text-[#8a8880]">Kredit</span>
                                            <div class="font-bold text-[#e8a000] text-lg leading-none">
                                                @if (SelectedProduct.is_returnable == 1 || SelectedProduct.transaction_type == "BORROW")
                                                {
                                                    <span class="text-[#8a8880]">-</span>
                                                }
                                                else
                                                {
                                                    <span>@SelectedProduct.value</span><span class="text-[0.6rem] font-normal text-[#8a8880] ml-0.5">pts</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <code class="text-[0.65rem] font-medium text-[#8a8880] bg-[#f0ede5] px-1.5 py-0.5 rounded">@SelectedProduct.sku</code>
                                </div>

                                <div class="h-px w-full bg-[#f0ede5]"></div>

                                @* Types / Variants *@
                                @if (SelectedProduct.ProductVariants != null && SelectedProduct.ProductVariants.Any())
                                {
                                    var colors = SelectedProduct.ProductVariants.Select(v => v.color).Where(c => !string.IsNullOrEmpty(c)).Distinct().ToList();
                                    var sizes = SelectedProduct.ProductVariants.Select(v => v.size).Where(s => !string.IsNullOrEmpty(s)).Distinct().ToList();

                                    <div class="mb-4 border-b border-[#f0ede5] pb-4 flex flex-row gap-6">
                                        @if (colors.Any())
                                        {
                                            <div class="flex-1">
                                                <label class="block text-xs font-semibold text-[#5a5855] mb-2">Jenis / Tipe</label>
                                                <div class="flex flex-wrap gap-2">
                                                    @foreach(var c in colors)
                                                    {
                                                        bool isAvailable = IsColorAvailable(c!);
                                                        <button type="button" @onclick="() => SelectColor(c!)" class="px-3 py-1.5 border rounded-lg text-xs font-semibold transition-all @(SelectedVariantColor == c ? "bg-[#e8a000] border-[#e8a000] text-[#1a1a1a]" : (isAvailable ? "bg-white border-[#e5e3dc] text-[#5a5855] hover:border-[#1a1a1a]" : "bg-gray-100 border-[#e5e3dc] text-gray-400 opacity-50"))">
                                                            @c
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        @if (sizes.Any())
                                        {
                                            <div class="flex-1">
                                                <label class="block text-xs font-semibold text-[#5a5855] mb-2">Ukuran</label>
                                                <div class="flex flex-wrap gap-2">
                                                    @foreach(var s in sizes)
                                                    {
                                                        bool isAvailable = IsSizeAvailable(s!);
                                                        <button type="button" @onclick="() => SelectSize(s!)" class="px-3 py-1.5 border rounded-lg text-xs font-semibold transition-all @(SelectedVariantSize == s ? "bg-[#e8a000] border-[#e8a000] text-[#1a1a1a]" : (isAvailable ? "bg-white border-[#e5e3dc] text-[#5a5855] hover:border-[#1a1a1a]" : "bg-gray-100 border-[#e5e3dc] text-gray-400 opacity-50"))">
                                                            @s
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }

                                @* Transaction Settings *@
                                <div class="grid grid-cols-2 gap-4">
                                    <div>
                                        <label class="block text-xs font-semibold text-[#5a5855] mb-1">Tipe Transaksi</label>
                                        <select @bind="SelectedRequestType" class="w-full border border-[#e5e3dc] rounded-lg px-3 py-2 text-sm text-[#5a5855] font-semibold bg-white outline-none focus:border-[#e8a000]">
                                            @if (SelectedProduct.is_returnable == 1) {
                                                @* Barang returnable: hanya untuk dipinjam (tanpa poin) *@
                                                <option value="BORROW">Pinjam</option>
                                            } else {
                                                @* Barang non-returnable: hanya bisa diminta/ambil (pakai poin) *@
                                                <option value="GIVEAWAY">Minta / Ambil</option>
                                            }
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-xs font-semibold text-[#5a5855] mb-1">Jumlah</label>
                                        <div class="flex items-center border border-[#e5e3dc] rounded-lg overflow-hidden bg-white">
                                            <button type="button" @onclick="() => { if(SelectedQuantity > 1) SelectedQuantity--; }" class="w-8 h-8 flex items-center justify-center text-[#5a5855] hover:bg-[#f5f4f0] transition">-</button>
                                            <input type="number" @bind="SelectedQuantity" @bind:event="oninput" min="1" max="@GetMaxStock()" class="flex-1 w-full text-center py-1.5 text-sm outline-none bg-transparent">
                                            <button type="button" @onclick="() => { if(SelectedQuantity < GetMaxStock()) SelectedQuantity++; }" class="w-8 h-8 flex items-center justify-center text-[#5a5855] hover:bg-[#f5f4f0] transition">+</button>
                                        </div>
                                        <p class="text-[0.65rem] text-[#8a8880] mt-1">Sisa @GetMaxStock() @(SelectedProduct.Unit?.name ?? "unit")</p>
                                    </div>
                                </div>
                                @if (SelectedRequestType == "BORROW")
                                {
                                    <div class="gap-4 bg-[#f9f8f6] p-3 rounded-lg border border-[#e5e3dc] mt-4 grid grid-cols-2">
                                        <div>
                                            <label class="block text-[0.65rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1">Tgl Pinjam</label>
                                            <input type="date" @bind="SelectedStartDate" class="w-full bg-white border border-[#e5e3dc] rounded-md px-2 py-1.5 text-xs focus:border-[#e8a000] outline-none">
                                        </div>
                                        <div>
                                            <label class="block text-[0.65rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1">Tgl Kembali</label>
                                            <input type="date" @bind="SelectedEndDate" class="w-full bg-white border border-[#e5e3dc] rounded-md px-2 py-1.5 text-xs focus:border-[#e8a000] outline-none">
                                        </div>
                                    </div>
                                }
                                @if (SelectedRequestType == "GIVEAWAY")
                                {
                                    <div class="bg-[#f9f8f6] p-3 rounded-lg border border-[#e5e3dc] mt-4">
                                        <div>
                                            <label class="block text-[0.65rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1">Tanggal Pengambilan</label>
                                            <input type="date" @bind="SelectedPickupDate" class="w-full bg-white border border-[#e5e3dc] rounded-md px-2 py-1.5 text-xs focus:border-[#e8a000] outline-none">
                                        </div>
                                    </div>
                                }

                            </div>

                            <div class="rounded-3xl border border-[#e5e3dc] bg-[#f9f8f6] p-5 shadow-sm">
                                <div class="flex items-center justify-between gap-4">
                                    <div>
                                        <span class="text-[0.65rem] text-[#8a8880] font-semibold uppercase tracking-wider">Total Kredit</span>
                                        <div class="text-2xl font-extrabold text-[#1a1a1a]"><span>@(SelectedRequestType == "GIVEAWAY" ? SelectedProduct.value * SelectedQuantity : 0)</span> <span class="text-[0.65rem] font-normal text-[#8a8880]">pts</span></div>
                                    </div>
                                    <button type="button" @onclick="AddToCart" disabled="@(GetMaxStock() <= 0)" class="px-6 py-3 bg-[#e8a000] hover:bg-[#d49300] active:scale-[0.98] text-[#1a1a1a] text-sm font-bold rounded-2xl transition shadow-sm disabled:opacity-50 disabled:cursor-not-allowed">
                                        + Keranjang
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private int WidgetTotalItems = 0;
    private int PendingApprovals = 0;
    private int TotalStock = 0;
    private int OverdueReturnCount = 0;
    
    private List<DashboardService.ActionItemModel> ActionItems = new();
    private bool ActionItemsExpanded = false;
    
    private List<Category>? Categories;
    private List<Division>? Divisions;
    private List<Product>? CatalogProducts;
    private List<Transaction>? ActiveBorrows;
    private List<Product>? LowStockProducts;
    private int DonutApproved;
    private int DonutRejected;
    private int DonutPending;
    
    private int MerchAvailable;
    private int MerchLowStock;
    private int MerchOutOfStock;
    
    private int BorrowOverdue;
    private int BorrowAvailable;
    private int BorrowBorrowed;
    
    private int CurrentPage = 1;
    private int PageSize = 15;
    private int TotalItems = 0;
    private int TotalPages = 0;
    
    private int? SelectedCategoryId;
    private string? ErrorMessage;
    
    private bool ShowProductModal = false;
    private bool ShowCartModal = false;
    private string? CartToast;
    private Product? SelectedProduct;
    private int SelectedQuantity = 1;
    private string SelectedRequestType = "BORROW";
    
    private DateTime? SelectedStartDate;
    private DateTime? SelectedEndDate;

    private string SelectedMainImage = "";
    private List<string> ModalImages = new();
    private int? SelectedVariantId;
    private string? SelectedVariantColor;
    private string? SelectedVariantSize;
    
    private int CurrentUserId = 0;
    private string? UserRole;
    private string? ApplicantName;
    private string? ApplicantNrp;
    private int? UserDivisionId;
    
    private string? EventName;
    private DateTime? EventDate;
    private string? DocumentationLink;
    private string? Notes;
    private DateTime? SelectedPickupDate;

    protected override async Task OnInitializedAsync()
    {
        CartService.OnChange += StateHasChanged;
        
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            var idClaim = user.FindFirst(ClaimTypes.NameIdentifier);
            if (idClaim != null && int.TryParse(idClaim.Value, out int id))
            {
                CurrentUserId = id;
            }
            UserRole = user.FindFirst(ClaimTypes.Role)?.Value;
            ApplicantName = user.Identity.Name;
            
            // Get user's exact details from db
            if(CurrentUserId > 0)
            {
                var profile = await UserService.GetUserByIdAsync(CurrentUserId);
                if (profile != null)
                {
                    ApplicantNrp = profile.nrp;
                    UserDivisionId = profile.division_id;
                }
            }
        }

        await LoadData(1);
    }

    private bool _shouldRenderCharts = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldRenderCharts && (UserRole == "superadmin" || UserRole == "admin" || UserRole == "manager"))
        {
            _shouldRenderCharts = false;
            await JSRuntime.InvokeVoidAsync("renderDashboardCharts", new {
                donutData = new { approved = DonutApproved, rejected = DonutRejected, pending = DonutPending },
                merchStatus = new { available = MerchAvailable, low_stock = MerchLowStock, out_of_stock = MerchOutOfStock },
                borrowStatus = new { overdue = BorrowOverdue, available = BorrowAvailable, borrowed = BorrowBorrowed }
            });
        }
    }

    private async Task LoadData(int page)
    {
        CurrentPage = page;
        
        var data = await DashboardService.GetDashboardDataAsync(SelectedCategoryId, SearchQuery, CurrentPage, PageSize);
        
        WidgetTotalItems = data.WidgetTotalItems;
        PendingApprovals = data.PendingApprovals;
        TotalStock = data.TotalStock;
        OverdueReturnCount = data.BorrowOverdue;
        Categories = data.Categories;
        Divisions = data.Divisions;
        CatalogProducts = data.CatalogProducts;
        TotalItems = data.TotalItems;
        TotalPages = data.TotalPages;

        LowStockProducts = data.LowStockProducts;
        DonutApproved = data.DonutApproved;
        DonutRejected = data.DonutRejected;
        DonutPending = data.DonutPending;
        MerchAvailable = data.MerchAvailable;
        MerchLowStock = data.MerchLowStock;
        MerchOutOfStock = data.MerchOutOfStock;
        BorrowOverdue = data.BorrowOverdue;
        BorrowAvailable = data.BorrowAvailable;
        BorrowBorrowed = data.BorrowBorrowed;

        if (CurrentUserId > 0)
        {
            ActiveBorrows = await DashboardService.GetActiveBorrowsAsync(CurrentUserId, UserRole);
            ActionItems = await DashboardService.GetUserActionItemsAsync(CurrentUserId);
            if (ActionItems.Count > 0) ActionItemsExpanded = true;
        }

        _shouldRenderCharts = true;
    }

    private async Task FilterByCategory(int? categoryId)
    {
        SelectedCategoryId = categoryId;
        await LoadData(1);
    }
    
    private void OpenProductModal(Product product)
    {
        ErrorMessage = null;
        SelectedProduct = product;
        SelectedQuantity = 1;
        SelectedRequestType = product.is_returnable == 1 ? "BORROW" : "GIVEAWAY";
        SelectedStartDate = null;
        SelectedEndDate = null;
        
        ModalImages.Clear();
        if (!string.IsNullOrEmpty(product.image))
        {
            ModalImages.Add(NormalizeImagePath(product.image));
        }
        if (!string.IsNullOrEmpty(product.images))
        {
            try
            {
                var extraImages = System.Text.Json.JsonSerializer.Deserialize<List<string>>(product.images);
                if (extraImages != null)
                {
                    ModalImages.AddRange(extraImages.Select(NormalizeImagePath));
                }
            }
            catch {}
        }
        
        ModalImages = ModalImages.Where(i => !string.IsNullOrEmpty(i)).Distinct().ToList();
        SelectedMainImage = ModalImages.FirstOrDefault() ?? "https://placehold.co/600x400?text=No+Picture";
        
        if (product.ProductVariants != null && product.ProductVariants.Any())
        {
            var firstVar = product.ProductVariants.First();
            SelectedVariantColor = firstVar.color;
            SelectedVariantSize = firstVar.size;
            SelectedVariantId = firstVar.id;
            if (!string.IsNullOrEmpty(firstVar.image))
            {
                SelectedMainImage = NormalizeImagePath(firstVar.image);
            }
        }
        else
        {
            SelectedVariantColor = null;
            SelectedVariantSize = null;
            SelectedVariantId = null;
        }

        ShowProductModal = true;
    }
    
    private bool IsColorAvailable(string color)
    {
        if (SelectedProduct?.ProductVariants == null) return false;
        if (string.IsNullOrEmpty(SelectedVariantSize)) return true;
        return SelectedProduct.ProductVariants.Any(v => v.color == color && v.size == SelectedVariantSize);
    }

    private bool IsSizeAvailable(string size)
    {
        if (SelectedProduct?.ProductVariants == null) return false;
        if (string.IsNullOrEmpty(SelectedVariantColor)) return true;
        return SelectedProduct.ProductVariants.Any(v => v.size == size && v.color == SelectedVariantColor);
    }

    private void SelectColor(string color)
    {
        if (SelectedProduct?.ProductVariants == null)
        {
            SelectedVariantColor = color;
            return;
        }

        SelectedVariantColor = color;

        if (!SelectedProduct.ProductVariants.Any(v => v.color == color && v.size == SelectedVariantSize))
        {
            SelectedVariantSize = SelectedProduct.ProductVariants.FirstOrDefault(v => v.color == color)?.size;
        }

        UpdateSelectedVariant();
    }

    private void SelectSize(string size)
    {
        if (SelectedProduct?.ProductVariants == null)
        {
            SelectedVariantSize = size;
            return;
        }

        SelectedVariantSize = size;

        if (!SelectedProduct.ProductVariants.Any(v => v.size == size && v.color == SelectedVariantColor))
        {
            SelectedVariantColor = SelectedProduct.ProductVariants.FirstOrDefault(v => v.size == size)?.color;
        }

        UpdateSelectedVariant();
    }

    private void SelectImage(string img)
    {
        var normalizedImage = NormalizeImagePath(img);
        SelectedMainImage = normalizedImage;
        
        if (SelectedProduct?.ProductVariants != null && ModalImages.Count > 1)
        {
            var variantWithImage = SelectedProduct.ProductVariants.FirstOrDefault(v =>
                string.Equals(NormalizeImagePath(v.image), normalizedImage, StringComparison.OrdinalIgnoreCase));

            if (variantWithImage != null)
            {
                SelectedVariantColor = variantWithImage.color;
                SelectedVariantSize = variantWithImage.size;
                SelectedVariantId = variantWithImage.id;
                SelectedQuantity = 1;
                return;
            }

            var colorsList = SelectedProduct.ProductVariants.Select(v => v.color).Where(c => !string.IsNullOrEmpty(c)).Distinct().ToList();
            int imgIndex = ModalImages.IndexOf(normalizedImage);

            if (imgIndex > 0 && imgIndex <= colorsList.Count)
            {
                var matchedColor = colorsList[imgIndex - 1];
                var matchedVariant = SelectedProduct.ProductVariants
                    .FirstOrDefault(v => v.color == matchedColor);
                if (matchedVariant != null)
                {
                    SelectedVariantColor = matchedVariant.color;
                    SelectedVariantSize = matchedVariant.size;
                    SelectedVariantId = matchedVariant.id;
                }
            }
        }
        SelectedQuantity = 1;
    }

    private void UpdateSelectedVariant()
    {
        if (SelectedProduct?.ProductVariants != null)
        {
            var variant = SelectedProduct.ProductVariants.FirstOrDefault(v =>
                !string.IsNullOrEmpty(SelectedVariantColor) && !string.IsNullOrEmpty(SelectedVariantSize) &&
                v.color == SelectedVariantColor && v.size == SelectedVariantSize)
                ?? SelectedProduct.ProductVariants.FirstOrDefault(v =>
                    !string.IsNullOrEmpty(SelectedVariantColor) && v.color == SelectedVariantColor)
                ?? SelectedProduct.ProductVariants.FirstOrDefault(v =>
                    !string.IsNullOrEmpty(SelectedVariantSize) && v.size == SelectedVariantSize)
                ?? SelectedProduct.ProductVariants.FirstOrDefault();

            if (variant != null)
            {
                SelectedVariantColor = variant.color;
                SelectedVariantSize = variant.size;
                SelectedVariantId = variant.id;

                if (!string.IsNullOrEmpty(variant.image))
                {
                    SelectedMainImage = NormalizeImagePath(variant.image);
                }
                else
                {
                    var colorsList = SelectedProduct.ProductVariants.Select(v => v.color).Where(c => !string.IsNullOrEmpty(c)).Distinct().ToList();
                    int colorIndex = colorsList.IndexOf(variant.color ?? "");
                    if (colorIndex >= 0 && colorIndex + 1 < ModalImages.Count)
                    {
                        SelectedMainImage = ModalImages[colorIndex + 1];
                    }
                    else if (colorIndex >= 0 && colorIndex < ModalImages.Count)
                    {
                        SelectedMainImage = ModalImages[colorIndex];
                    }
                }
            }
        }

        SelectedQuantity = 1;
    }
    
    private void CloseProductModal()
    {
        ShowProductModal = false;
        SelectedProduct = null;
    }

    private string NormalizeImagePath(string? image)
    {
        if (string.IsNullOrWhiteSpace(image))
        {
            return string.Empty;
        }

        var normalized = image.Trim();
        if (normalized.StartsWith("/"))
        {
            normalized = normalized[1..];
        }

        return normalized;
    }

    private string GetProductDisplayImage(Product product)
    {
        if (!string.IsNullOrEmpty(product.image))
        {
            return GetImageUrl(product.image);
        }
        
        if (!string.IsNullOrEmpty(product.images))
        {
            try
            {
                var imgList = System.Text.Json.JsonSerializer.Deserialize<List<string>>(product.images);
                if (imgList != null && imgList.Any())
                {
                    return GetImageUrl(imgList.First());
                }
            }
            catch
            {
                // Ignore parse errors
            }
        }
        
        return "https://placehold.co/600x400?text=No+Picture";
    }

    private string GetImageUrl(string? image)
    {
        var normalized = NormalizeImagePath(image);
        if (string.IsNullOrEmpty(normalized))
        {
            return string.Empty;
        }

        if (normalized.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || normalized.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            return normalized;
        }

        if (normalized.StartsWith("images/", StringComparison.OrdinalIgnoreCase) || normalized.StartsWith("storage/", StringComparison.OrdinalIgnoreCase))
        {
            return "/" + normalized;
        }

        return $"/storage/{normalized}";
    }
    
    private int GetMaxStock()
    {
        if (SelectedVariantId.HasValue && SelectedProduct?.ProductVariants != null)
        {
            var variant = SelectedProduct.ProductVariants.FirstOrDefault(v => v.id == SelectedVariantId.Value);
            if (variant != null) return variant.stock;
        }
        return SelectedProduct?.current_stock ?? 0;
    }

    private void AddToCart()
    {
        if (SelectedProduct != null && SelectedQuantity > 0)
        {
            int maxStock = GetMaxStock();
            if (SelectedQuantity > maxStock)
            {
                ErrorMessage = "Stok tidak mencukupi.";
                return;
            }
            
            CartService.AddToCart(new CartItem
            {
                Sku = SelectedProduct.sku ?? "",
                Name = SelectedProduct.name ?? "",
                Quantity = SelectedQuantity,
                RequestType = SelectedRequestType,
                BaseCredit = SelectedProduct.value,
                MaxStock = maxStock,
                UnitName = SelectedProduct.Unit?.name ?? "unit",
                ProductVariantId = SelectedVariantId,
                BorrowStartDate = SelectedRequestType == "BORROW" ? SelectedStartDate : null,
                ExpectedReturnDate = SelectedRequestType == "BORROW" ? SelectedEndDate : null,
                PickupDate = SelectedRequestType == "GIVEAWAY" ? SelectedPickupDate : null
            });
            var addedName = SelectedProduct.name;
            CloseProductModal();
            // Jangan auto-buka keranjang — biarkan user memilih barang lain dulu,
            // lalu buka keranjang secara manual. Tampilkan toast singkat sebagai konfirmasi.
            CartToast = $"\"{addedName}\" ditambahkan ke keranjang.";
            _ = ClearCartToastAfterDelay();
        }
    }

    private async Task ClearCartToastAfterDelay()
    {
        await Task.Delay(2500);
        CartToast = null;
        await InvokeAsync(StateHasChanged);
    }
    
    private void CloseCartModal()
    {
        ShowCartModal = false;
        ErrorMessage = null;
    }

    private async Task SubmitBorrowRequest()
    {
        try
        {
            ErrorMessage = null;

            // Validasi form
            if (CartService.Items.Count == 0)
            {
                ErrorMessage = "Keranjang kosong. Silakan tambahkan barang terlebih dahulu.";
                return;
            }

            if (string.IsNullOrWhiteSpace(ApplicantName))
            {
                ErrorMessage = "Nama Pemohon tidak boleh kosong.";
                return;
            }

            if (string.IsNullOrWhiteSpace(ApplicantNrp))
            {
                ErrorMessage = "NRP Pemohon tidak boleh kosong.";
                return;
            }

            if (string.IsNullOrWhiteSpace(EventName))
            {
                ErrorMessage = "Nama Event/Program wajib diisi.";
                return;
            }

            if (!EventDate.HasValue)
            {
                ErrorMessage = "Tanggal Event wajib diisi.";
                return;
            }


            // Validasi tanggal peminjaman untuk item BORROW
            foreach (var item in CartService.Items.Where(i => i.RequestType == "BORROW"))
            {
                if (!item.BorrowStartDate.HasValue || !item.ExpectedReturnDate.HasValue)
                {
                    ErrorMessage = $"Tanggal pinjam dan tanggal kembali harus diisi untuk item: {item.Name}.";
                    return;
                }

                if (item.ExpectedReturnDate <= item.BorrowStartDate)
                {
                    ErrorMessage = $"Tanggal kembali harus lebih besar dari tanggal pinjam untuk item: {item.Name}.";
                    return;
                }
            }

            // Validasi tanggal pengambilan untuk item GIVEAWAY
            foreach (var item in CartService.Items.Where(i => i.RequestType == "GIVEAWAY"))
            {
                if (!item.PickupDate.HasValue)
                {
                    ErrorMessage = $"Tanggal pengambilan harus diisi untuk item: {item.Name}.";
                    return;
                }

                if (item.PickupDate < DateTime.Today)
                {
                    ErrorMessage = $"Tanggal pengambilan tidak boleh di masa lalu untuk item: {item.Name}.";
                    return;
                }
            }

            // Siapkan request
            var req = new UT_WMSDotnet.ViewModels.TransactionRequestViewModel
            {
                type = "OUT",
                applicant_name = ApplicantName,
                applicant_nrp = ApplicantNrp,
                division_id = UserDivisionId,
                event_name = EventName,
                event_date = EventDate,
                documentation_link = DocumentationLink,
                notes = Notes,
                items = CartService.Items.Select(i => new UT_WMSDotnet.ViewModels.TransactionItemViewModel
                {
                    sku = i.Sku,
                    quantity = i.Quantity,
                    request_type = i.RequestType,
                    product_variant_id = i.ProductVariantId,
                    borrow_start_date = i.BorrowStartDate,
                    expected_return_date = i.ExpectedReturnDate,
                    pickup_date = i.PickupDate
                }).ToList()
            };

            var error = await TransactionService.StoreTransactionAsync(req, CurrentUserId);
            if (error == null)
            {
                CartService.ClearCart();
                ShowCartModal = false;
                EventName = null;
                EventDate = null;
                DocumentationLink = null;
                Notes = null;
                ErrorMessage = null;
                
                await Task.Delay(500);
                Navigation.NavigateTo("/Tracking");
            }
            else
            {
                ErrorMessage = error;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Terjadi kesalahan: " + ex.Message;
        }
    }
    public void Dispose()
    {
        CartService.OnChange -= StateHasChanged;
    }

    private string _searchQuery = "";

    private string SearchQuery
    {
        get => _searchQuery;
        set
        {
            if (_searchQuery != value)
            {
                _searchQuery = value;
                
                // Setiap kali user mengetik/menghapus huruf, jalankan fungsi ini otomatis
                _ = InvokeAsync(async () =>
                {
                    await LoadData(1);
                    StateHasChanged();
                });
            }
        }
    }
}
