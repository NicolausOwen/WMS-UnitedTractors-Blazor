@page "/Approval"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using UT_WMSDotnet.Models
@using WMS_UnitedTracors_Blazor.Services
@inject ApprovalService ApprovalService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Approvals</PageTitle>

<div class="py-8 bg-[#f5f4f0] min-h-screen font-sans">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="mb-6">
            <h1 class="text-[1.6rem] font-bold text-[#1a1a1a] leading-none tracking-tight">Persetujuan <span class="text-[#e8a000]">Admin</span></h1>
            <div class="text-[0.72rem] font-medium text-[#a09e99] mt-1">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</div>
        </div>

        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="mb-6 flex items-center gap-3 bg-[#eef9f0] border border-[#b8e8c0] text-[#1a7a30] px-4 py-3 rounded-lg text-sm font-semibold">
                <svg class="w-4 h-4 shrink-0 text-[#1a7a30]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                @SuccessMessage
            </div>
        }
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="mb-6 flex items-center gap-3 bg-[#fef0f0] border border-[#f8c0c0] text-[#d94040] px-4 py-3 rounded-lg text-sm font-semibold">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                @ErrorMessage
            </div>
        }

        <!-- Tabs -->
        <div class="flex items-center gap-2 mb-6 border-b border-[#e5e3dc] pb-1 overflow-x-auto">
            <button @onclick='() => ActiveTab = "new"' class="px-4 py-2 text-sm font-bold rounded-lg transition-all @(ActiveTab == "new" ? "bg-[#1a1a1a] text-white" : "text-[#8a8880] hover:text-[#1a1a1a] hover:bg-[#faf9f5]")">
                New Requests
                @if (GroupedApprovals?.Count > 0)
                {
                    <span class="ml-1.5 px-1.5 py-0.5 rounded-full text-[10px] @(ActiveTab == "new" ? "bg-[#e8a000] text-[#1a1a1a]" : "bg-[#e5e3dc] text-[#1a1a1a]")">@GroupedApprovals.Count</span>
                }
            </button>
            <button @onclick='() => ActiveTab = "handovers"' class="px-4 py-2 text-sm font-bold rounded-lg transition-all @(ActiveTab == "handovers" ? "bg-[#1a1a1a] text-white" : "text-[#8a8880] hover:text-[#1a1a1a] hover:bg-[#faf9f5]")">
                Serah Terima
                @if (GroupedHandovers?.Count > 0)
                {
                    <span class="ml-1.5 px-1.5 py-0.5 rounded-full text-[10px] @(ActiveTab == "handovers" ? "bg-[#e8a000] text-[#1a1a1a]" : "bg-[#e5e3dc] text-[#1a1a1a]")">@GroupedHandovers.Count</span>
                }
            </button>
            <button @onclick='() => ActiveTab = "returns"' class="px-4 py-2 text-sm font-bold rounded-lg transition-all @(ActiveTab == "returns" ? "bg-[#1a1a1a] text-white" : "text-[#8a8880] hover:text-[#1a1a1a] hover:bg-[#faf9f5]")">
                Returns
                @if (PendingReturns?.Count > 0)
                {
                    <span class="ml-1.5 px-1.5 py-0.5 rounded-full text-[10px] @(ActiveTab == "returns" ? "bg-[#e8a000] text-[#1a1a1a]" : "bg-[#e5e3dc] text-[#1a1a1a]")">@PendingReturns.Count</span>
                }
            </button>
            <button @onclick='() => ActiveTab = "profiles"' class="px-4 py-2 text-sm font-bold rounded-lg transition-all @(ActiveTab == "profiles" ? "bg-[#1a1a1a] text-white" : "text-[#8a8880] hover:text-[#1a1a1a] hover:bg-[#faf9f5]")">
                Profile Updates
                @if (PendingProfileRequests?.Count > 0)
                {
                    <span class="ml-1.5 px-1.5 py-0.5 rounded-full text-[10px] @(ActiveTab == "profiles" ? "bg-[#e8a000] text-[#1a1a1a]" : "bg-[#e5e3dc] text-[#1a1a1a]")">@PendingProfileRequests.Count</span>
                }
            </button>
        </div>

        @if (ActiveTab == "new")
        {
            @if (GroupedApprovals == null)
            {
                <div class="bg-white p-12 rounded-xl border border-[#e5e3dc] text-center shadow-sm text-gray-500">Loading requests...</div>
            }
            else if (GroupedApprovals.Count == 0)
            {
                <div class="bg-white p-12 rounded-xl border border-[#e5e3dc] text-center shadow-sm">
                    <svg class="w-12 h-12 text-[#d1d0cb] mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
                    <p class="text-sm font-bold text-[#8a8880] tracking-wide">No pending requests at the moment.</p>
                </div>
            }
            else
            {
                <div class="flex justify-end mb-4">
                    <button type="button" @onclick="OpenBatchConfirmModal" disabled="@(Decisions.Count == 0 || IsProcessing)" class="inline-flex items-center gap-2 px-4 py-2 bg-[#1a1a1a] text-white text-xs font-bold rounded-lg shadow-sm hover:bg-[#333] transition disabled:opacity-50">
                        Process Selected Items (@Decisions.Count)
                    </button>
                </div>

                var borrowGroups = GroupedApprovals.Where(g => g.Value.FirstOrDefault()?.request_type == "BORROW").ToList();
                var giveawayGroups = GroupedApprovals.Where(g => g.Value.FirstOrDefault()?.request_type == "GIVEAWAY").ToList();

                @if (giveawayGroups.Count > 0)
                {
                    <div class="mb-8">
                        <h3 class="text-sm font-bold text-gray-900 mb-3 uppercase tracking-wider">Giveaway Requests</h3>
                        <div class="space-y-4">
                            @foreach (var group in giveawayGroups)
                            {
                                @RenderGroup(group)
                            }
                        </div>
                    </div>
                }

                @if (borrowGroups.Count > 0)
                {
                    <div class="mb-8">
                        <h3 class="text-sm font-bold text-gray-900 mb-3 uppercase tracking-wider">Borrow Requests</h3>
                        <div class="space-y-4">
                            @foreach (var group in borrowGroups)
                            {
                                @RenderGroup(group)
                            }
                        </div>
                    </div>
                }
            }
        }
        else if (ActiveTab == "handovers")
        {
            @if (GroupedHandovers == null || GroupedHandovers.Count == 0)
            {
                <div class="bg-white p-12 rounded-xl border border-[#e5e3dc] text-center shadow-sm">
                    <p class="text-sm font-bold text-[#8a8880] tracking-wide">No pending handovers.</p>
                </div>
            }
            else
            {
                <div class="space-y-4">
                    @foreach (var group in GroupedHandovers)
                    {
                        var firstItem = group.Value.First();
                        <div class="bg-white rounded-xl border border-[#e5e3dc] shadow-sm overflow-hidden">
                            <div class="px-5 py-4 border-b border-[#f0ede5] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                                <div>
                                    <h4 class="font-bold text-[#1a1a1a]">Event: @(firstItem.event_name ?? "-")</h4>
                                    <div class="text-xs text-gray-500 mt-1">Pemohon: @(firstItem.applicant_name ?? firstItem.Requester?.name) | @(group.Value.Count) Items</div>
                                </div>
                                <div class="flex gap-2">
                                    <button type="button" @onclick="() => ApproveHandoverBatch(group.Key)" disabled="@IsProcessing" class="px-4 py-2 bg-gray-900 text-white text-xs font-bold rounded-lg shadow-sm hover:bg-gray-800 transition">Approve Handover</button>
                                    <button type="button" @onclick="() => OpenHandoverRejectModal(group.Key)" class="px-4 py-2 bg-white border border-red-200 text-red-600 text-xs font-bold rounded-lg hover:bg-red-50 transition">Reject Proof</button>
                                </div>
                            </div>
                            
                            <div class="p-4 bg-gray-50/50 flex flex-col md:flex-row gap-6">
                                <div class="w-32 h-32 rounded-lg border border-[#e5e3dc] overflow-hidden bg-white shrink-0">
                                    @if (!string.IsNullOrEmpty(firstItem.handover_photo))
                                    {
                                        <a href="@($"/{firstItem.handover_photo.TrimStart('/')}")" target="_blank" data-image-popup>
                                            <img src="@($"/{firstItem.handover_photo.TrimStart('/')}")" class="w-full h-full object-cover" />
                                        </a>
                                    }
                                    else { <div class="w-full h-full flex items-center justify-center text-[10px] text-gray-300">No Photo</div> }
                                </div>
                                <div class="flex-1">
                                    <h5 class="text-[10px] font-bold text-[#8a8880] uppercase mb-1">Handover Notes</h5>
                                    <p class="text-xs text-[#5a5855] italic">"@firstItem.handover_notes"</p>
                                    
                                    <div class="mt-4">
                                        <h5 class="text-[10px] font-bold text-[#8a8880] uppercase mb-2">Items List</h5>
                                        <div class="flex flex-wrap gap-2">
                                            @foreach(var item in group.Value)
                                            {
                                                <div class="px-2 py-1 bg-white border border-[#e5e3dc] rounded text-[10px] font-semibold text-[#1a1a1a]">
                                                    @item.Product?.name (@item.quantity)
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
        else if (ActiveTab == "returns")
        {
             @if (PendingReturns == null || PendingReturns.Count == 0)
            {
                <div class="bg-white p-12 rounded-xl border border-[#e5e3dc] text-center shadow-sm">
                    <p class="text-sm font-bold text-[#8a8880] tracking-wide">No pending returns.</p>
                </div>
            }
            else
            {
                <div class="flex justify-end mb-4">
                    <button type="button" @onclick="ProcessBatchReturns" disabled="@(ReturnDecisions.Count == 0 || IsProcessing)" class="inline-flex items-center gap-2 px-6 py-2.5 bg-[#4338ca] text-white text-xs font-bold rounded-xl shadow-lg hover:bg-[#3730a3] transition disabled:opacity-50">
                        Submit Return Decisions (@ReturnDecisions.Count)
                    </button>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    @foreach (var item in PendingReturns)
                    {
                        <div class="bg-white rounded-xl border border-[#e5e3dc] p-4 shadow-sm">
                            <div class="flex items-start gap-4">
                                <div class="w-16 h-16 rounded-lg border border-[#e5e3dc] overflow-hidden bg-white shrink-0">
                                    <img src="@ImageHelper.ResolveProduct(item.Product, "/img/logo.svg")" class="w-full h-full object-cover">
                                </div>
                                <div class="flex-1 min-w-0">
                                    <h4 class="text-sm font-bold text-[#1a1a1a] truncate">@item.Product?.name</h4>
                                    <div class="text-[10px] text-[#8a8880] mt-1">
                                        Borrowed: <span class="font-bold text-[#1a1a1a]">@item.quantity</span> | Pending: <span class="font-bold text-[#e8a000]">@item.pending_return_quantity</span>
                                    </div>
                                    <div class="text-[10px] text-gray-500 mt-0.5">Pemohon: @(item.applicant_name ?? item.Requester?.name)</div>
                                    
                                    <div class="mt-3 flex flex-col gap-2">
                                        <div class="flex items-center gap-2">
                                            @if (ReturnDecisions.GetValueOrDefault(item.id) == "APPROVE")
                                            {
                                                <button type="button" @onclick='() => ClearDecision(item.id, true)' class="flex-1 py-1.5 text-xs font-bold rounded-lg border border-emerald-200 bg-emerald-50 text-emerald-700 hover:bg-emerald-100 transition shadow-sm">Undo Approve</button>
                                            }
                                            else if (ReturnDecisions.GetValueOrDefault(item.id) == "REJECT")
                                            {
                                                <button type="button" @onclick='() => ClearDecision(item.id, true)' class="flex-1 py-1.5 text-xs font-bold rounded-lg border border-red-200 bg-red-50 text-red-700 hover:bg-red-100 transition shadow-sm">Undo Reject</button>
                                            }
                                            else
                                            {
                                                <button type="button" @onclick='() => SetReturnDecision(item.id, "APPROVE")' class="flex-1 py-1.5 text-xs font-bold rounded-lg border border-[#e5e3dc] bg-white text-gray-600 hover:bg-gray-50 transition">Approve</button>
                                                <button type="button" @onclick='() => SetReturnDecision(item.id, "REJECT")' class="flex-1 py-1.5 text-xs font-bold rounded-lg border border-[#e5e3dc] bg-white text-gray-600 hover:bg-gray-50 transition">Reject</button>
                                            }
                                        </div>
                                        @if (ReturnDecisions.ContainsKey(item.id))
                                        {
                                            <div class="mt-1">
                                                <input type="text" @bind="ReturnReasons[item.id]" placeholder="Notes..." class="w-full px-2.5 py-1 text-xs border border-gray-300 rounded-lg bg-white text-gray-700 focus:outline-none focus:ring-1 focus:ring-amber-500 focus:border-amber-500 shadow-sm" />
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
        else if (ActiveTab == "profiles")
        {
            @if (PendingProfileRequests == null || PendingProfileRequests.Count == 0)
            {
                <div class="bg-white p-12 rounded-xl border border-[#e5e3dc] text-center shadow-sm text-gray-500">No profile updates pending.</div>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    @foreach (var pr in PendingProfileRequests)
                    {
                        <div class="bg-white border border-[#e5e3dc] rounded-xl p-5 shadow-sm">
                            <div class="flex items-center gap-3 mb-4">
                                <div class="w-10 h-10 rounded-full bg-[#e8a000] flex items-center justify-center text-xs font-bold text-[#1a1a1a]">@pr.User?.name?.Substring(0, 2).ToUpper()</div>
                                <div>
                                    <h4 class="text-sm font-bold text-[#1a1a1a]">@pr.User?.name</h4>
                                    <p class="text-[10px] text-[#8a8880]">@pr.created_at?.ToString("dd MMM yyyy")</p>
                                </div>
                            </div>
                            <div class="space-y-2 mb-4 p-3 bg-gray-50 rounded-lg">
                                <div class="text-[10px] text-gray-400 uppercase font-bold">Proposed NRP</div>
                                <div class="text-xs font-bold">@pr.nrp</div>
                                <div class="text-[10px] text-gray-400 uppercase font-bold mt-2">Proposed Division</div>
                                <div class="text-xs font-bold">@pr.Division?.name</div>
                            </div>
                            <div class="flex gap-2">
                                <button @onclick="() => ApproveProfileRequest(pr.id)" class="flex-1 py-2 bg-gray-900 text-white text-xs font-bold rounded-lg hover:bg-gray-800 transition">Approve</button>
                                <button @onclick="() => RejectProfileRequest(pr.id)" class="flex-1 py-2 bg-white border border-red-200 text-red-600 text-xs font-bold rounded-lg hover:bg-red-50 transition">Reject</button>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

@if (ShowBatchConfirmModal)
{
    <div class="relative z-50" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <div class="fixed inset-0 backdrop-blur-md bg-black/5 transition-opacity"></div>
        <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
            <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
                <div class="relative transform overflow-hidden rounded-xl bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-lg border border-gray-100">
                    <div class="bg-white px-4 pb-4 pt-5 sm:p-6 sm:pb-4">
                        <div class="sm:flex sm:items-start">
                            <div class="mx-auto flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-amber-50 sm:mx-0 sm:h-10 sm:w-10">
                                <svg class="h-6 w-6 text-amber-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                                </svg>
                            </div>
                            <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left">
                                <h3 class="text-base font-semibold leading-6 text-gray-900">Submit Decisions</h3>
                                <div class="mt-2">
                                    <p class="text-sm text-gray-500">Are you sure you want to submit @Decisions.Count decision(s)? Once submitted, they will be finalized and disappear from this view.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="bg-gray-50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6 gap-2">
                        <button type="button" @onclick="ProcessBatch" class="inline-flex w-full justify-center rounded-md bg-[#e8a000] px-3 py-2 text-sm font-bold text-[#1a1a1a] shadow-sm hover:bg-[#d49300] sm:w-auto transition">Submit Now</button>
                        <button type="button" @onclick="() => ShowBatchConfirmModal = false" class="mt-3 inline-flex w-full justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 sm:mt-0 sm:w-auto transition">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (ShowHandoverRejectModal)
{
    <div class="relative z-50" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <div class="fixed inset-0 backdrop-blur-md bg-black/5 transition-opacity"></div>
        <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
            <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
                <div class="relative transform overflow-hidden rounded-xl bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-lg border border-gray-100">
                    <div class="bg-white px-4 pb-4 pt-5 sm:p-6 sm:pb-4">
                        <div class="sm:flex sm:items-start">
                            <div class="mx-auto flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-red-50 sm:mx-0 sm:h-10 sm:w-10">
                                <svg class="h-6 w-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                                </svg>
                            </div>
                            <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left w-full">
                                <h3 class="text-base font-semibold leading-6 text-gray-900">Reject Handover Proof</h3>
                                <div class="mt-2">
                                    <p class="text-sm text-gray-500 mb-4">Please provide a reason for rejecting this handover proof. The applicant will be asked to re-upload the proof.</p>
                                    <textarea @bind="HandoverRejectReason" @bind:event="oninput" @onkeypress="() => HandoverRejectionError = false" class="w-full rounded-md border shadow-sm sm:text-sm @(HandoverRejectionError ? "border-red-500 focus:ring-red-500" : "border-gray-300 focus:border-red-500 focus:ring-red-500")" rows="3" placeholder="Enter reason here..."></textarea>
                                    @if (HandoverRejectionError)
                                    {
                                        <p class="mt-1 text-xs text-red-600">A reason is required to reject proof.</p>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="bg-gray-50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6 gap-2">
                        <button type="button" @onclick="ConfirmHandoverReject" class="inline-flex w-full justify-center rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500 sm:w-auto transition">Reject Proof</button>
                        <button type="button" @onclick="CloseHandoverRejectModal" class="mt-3 inline-flex w-full justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 sm:mt-0 sm:w-auto transition">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (ShowRejectModal)
{
    <div class="relative z-50" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <div class="fixed inset-0 backdrop-blur-md bg-black/5 transition-opacity"></div>
        <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
            <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
                <div class="relative transform overflow-hidden rounded-xl bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-lg border border-gray-100">
                    <div class="bg-white px-4 pb-4 pt-5 sm:p-6 sm:pb-4">
                        <div class="sm:flex sm:items-start">
                            <div class="mx-auto flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-red-50 sm:mx-0 sm:h-10 sm:w-10">
                                <svg class="h-6 w-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                                </svg>
                            </div>
                            <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left w-full">
                                <h3 class="text-base font-semibold leading-6 text-gray-900" id="modal-title">Reject Request</h3>
                                    <div class="mt-2">
                                        <p class="text-sm text-gray-500 mb-4">Please provide a reason for rejecting this request. This will be recorded and visible to the requester.</p>
                                        <textarea @bind="RejectReason" @bind:event="oninput" @onkeypress="() => RejectionError = false" class="w-full rounded-md border shadow-sm sm:text-sm @(RejectionError ? "border-red-500 focus:ring-red-500" : "border-gray-300 focus:border-red-500 focus:ring-red-500")" rows="3" placeholder="Enter rejection reason here..."></textarea>
                                        @if (RejectionError)
                                        {
                                            <p class="mt-1 text-xs text-red-600">A reason is required to reject this request.</p>
                                        }
                                    </div>
                            </div>
                        </div>
                    </div>
                    <div class="bg-gray-50 px-4 py-3 flex flex-col sm:flex-row-reverse sm:px-6 gap-2">
                        <button type="button" @onclick='() => SubmitReject("REJECT")' class="inline-flex w-full justify-center rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500 sm:w-auto transition">Reject Total</button>
                        @if (!IsRejectingReturn)
                        {
                            <button type="button" @onclick='() => SubmitReject("REVISE")' class="inline-flex w-full justify-center rounded-md bg-amber-500 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-amber-600 sm:w-auto transition">Butuh Revisi</button>
                        }
                        <button type="button" @onclick="CloseRejectModal" class="inline-flex w-full justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 sm:w-auto transition">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

