@page "/editproduct/{Id:int}"
@page "/Product/Edit/{Id:int}"
@page "/Product-Edit/{Id:int}"
@using UT_WMSDotnet.ViewModels
@using WMS_UnitedTracors_Blazor.Services
@using UT_WMSDotnet.Models
@inject ProductService ProductService
@inject CategoryService CategoryService
@inject LocationService LocationService
@inject NavigationManager NavigationManager
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Edit Product</PageTitle>

<div class="flex items-center gap-4 mb-6">
    <button @onclick="NavigateBack" class="p-2 bg-white border border-gray-200 rounded-lg text-gray-600 hover:text-gray-900 hover:bg-gray-50 transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
    </button>
    <h2 class="font-semibold text-xl text-gray-800 leading-tight">
        Edit Product
    </h2>
</div>

<div class="max-w-4xl bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
    @if (IsLoading)
    {
        <div class="p-6 text-center text-gray-500 flex flex-col items-center">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-gray-900 mb-4"></div>
            Loading product details...
        </div>
    }
    else if (ProductNotFound)
    {
        <div class="p-10 text-center flex flex-col items-center">
            <svg class="w-12 h-12 text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <h3 class="text-lg font-medium text-gray-900">Product Not Found</h3>
            <p class="text-sm text-gray-500 mt-1 mb-6">The product you are trying to edit does not exist or has been removed.</p>
            <button @onclick="NavigateBack" class="px-5 py-2 bg-gray-900 text-white rounded-lg hover:bg-gray-800">Return to List</button>
        </div>
    }
    else
    {
        <EditForm Model="Model" OnValidSubmit="HandleSubmit" class="p-6">
            <DataAnnotationsValidator />
            
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="mb-6 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm" role="alert">
                    @ErrorMessage
                </div>
            }

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Name -->
                <div class="col-span-1 md:col-span-2">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Product Name <span class="text-red-500">*</span></label>
                    <InputText @bind-Value="Model.name" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-gray-900" placeholder="Enter product name" />
                    <ValidationMessage For="@(() => Model.name)" class="text-xs text-red-500 mt-1" />
                </div>

                <!-- SKU -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">SKU / Barcode <span class="text-red-500">*</span></label>
                    <InputText @bind-Value="Model.sku" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-gray-900" />
                    <ValidationMessage For="@(() => Model.sku)" class="text-xs text-red-500 mt-1" />
                </div>

                <!-- Barcode Type -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Barcode Type <span class="text-red-500">*</span></label>
                    <InputSelect @bind-Value="Model.barcode_type" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-gray-900 bg-white">
                        <option value="TYPE_CODE_128">CODE_128</option>
                        <option value="TYPE_CODE_39">CODE_39</option>
                        <option value="TYPE_EAN_13">EAN_13</option>
                        <option value="TYPE_UPC_A">UPC_A</option>
                    </InputSelect>
                    <ValidationMessage For="@(() => Model.barcode_type)" class="text-xs text-red-500 mt-1" />
                </div>

                <!-- Category -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Category <span class="text-red-500">*</span></label>
                    <InputSelect @bind-Value="Model.category_id" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-gray-900 bg-white">
                        <option value="0">-- Select Category --</option>
                        @if (Categories != null)
                        {
                            @foreach (var cat in Categories)
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => Model.category_id)" class="text-xs text-red-500 mt-1" />
                </div>

                <!-- Location -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Location</label>
                    <InputSelect @bind-Value="Model.location_id" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-gray-900 bg-white">
                        <option value="">-- Select Location --</option>
                        @if (Locations != null)
                        {
                            @foreach (var loc in Locations)
                            {
                                <option value="@loc.Id">@loc.Name</option>
                            }
                        }
                    </InputSelect>
                </div>

                <!-- Unit -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Unit <span class="text-red-500">*</span></label>
                    <InputText @bind-Value="Model.unit" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-gray-900" placeholder="e.g. PCS, BOX, LTR" />
                    <ValidationMessage For="@(() => Model.unit)" class="text-xs text-red-500 mt-1" />
                </div>

                <!-- Value (Points) -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Value (Points)</label>
                    <InputNumber @bind-Value="Model.value" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-gray-900" />
                    <ValidationMessage For="@(() => Model.value)" class="text-xs text-red-500 mt-1" />
                </div>

                <!-- Current Stock -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Current Stock</label>
                    <InputNumber @bind-Value="Model.current_stock" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-gray-900" />
                    <ValidationMessage For="@(() => Model.current_stock)" class="text-xs text-red-500 mt-1" />
                </div>
                
                <!-- Initial Stock -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Initial Stock</label>
                    <InputNumber @bind-Value="Model.initial_stock" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-gray-900" />
                    <ValidationMessage For="@(() => Model.initial_stock)" class="text-xs text-red-500 mt-1" />
                </div>

                <!-- Image -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Product Image</label>
                    @if (product != null && !string.IsNullOrEmpty(product.image))
                    {
                        <div class="mb-2 flex items-center gap-2">
                            <img src="/storage/@product.image" class="w-16 h-16 object-cover rounded border" />
                            <div class="flex items-center">
                                <InputCheckbox @bind-Value="Model.remove_image" id="remove_image" class="w-4 h-4 text-gray-900 bg-gray-100 border-gray-300 rounded focus:ring-2" />
                                <label for="remove_image" class="ml-2 text-xs font-medium text-red-600">Remove current image</label>
                            </div>
                        </div>
                    }
                    <InputFile OnChange="HandleImageSelected" class="w-full text-xs text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-gray-100 file:text-gray-700 hover:file:bg-gray-200 transition" accept="image/*" />
                </div>

                <!-- Position Image -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Position Layout Image</label>
                    @if (product != null && !string.IsNullOrEmpty(product.position_image))
                    {
                        <div class="mb-2 flex items-center gap-2">
                            <img src="/storage/@product.position_image" class="w-16 h-16 object-cover rounded border" />
                            <div class="flex items-center">
                                <InputCheckbox @bind-Value="Model.remove_position_image" id="remove_position_image" class="w-4 h-4 text-gray-900 bg-gray-100 border-gray-300 rounded focus:ring-2" />
                                <label for="remove_position_image" class="ml-2 text-xs font-medium text-red-600">Remove current layout position image</label>
                            </div>
                        </div>
                    }
                    <InputFile OnChange="HandlePositionImageSelected" class="w-full text-xs text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-gray-100 file:text-gray-700 hover:file:bg-gray-200 transition" accept="image/*" />
                </div>

                <!-- Is Returnable -->
                <div class="flex items-center pt-8">
                    <InputCheckbox @bind-Value="Model.is_returnable" id="is_returnable" class="w-4 h-4 text-gray-900 bg-gray-100 border-gray-300 rounded focus:ring-gray-900 focus:ring-2" />
                    <label for="is_returnable" class="ml-2 text-sm font-medium text-gray-900">Is Returnable Product?</label>
                </div>
            </div>

            <div class="mt-8 pt-6 border-t border-gray-100 flex justify-end gap-3">
                <button type="button" @onclick="NavigateBack" class="px-5 py-2 border border-gray-300 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-50 transition">
                    Cancel
                </button>
                <button type="submit" disabled="@IsSubmitting" class="px-5 py-2 bg-gray-900 text-white text-sm font-medium rounded-lg hover:bg-gray-800 transition disabled:opacity-70 flex items-center gap-2">
                    @if (IsSubmitting)
                    {
                        <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-white"></div>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Update Product</span>
                    }
                </button>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private ProductUpdateViewModel Model = new();
    private List<WMS_UnitedTracors_Blazor.Services.CategoryDto>? Categories;
    private List<WMS_UnitedTracors_Blazor.Services.LocationDto>? Locations;
    private Product? product;
    
    private string? ErrorMessage;
    private bool IsSubmitting;
    private bool IsLoading = true;
    private bool ProductNotFound = false;

    private Microsoft.AspNetCore.Components.Forms.IBrowserFile? selectedImage;
    private Microsoft.AspNetCore.Components.Forms.IBrowserFile? selectedPositionImage;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity == null || !user.Identity.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        var role = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
        if (role != "admin" && role != "superadmin")
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        // Do not start multiple EF operations in parallel with the same scoped DbContext.
        // Await service calls sequentially to avoid "A second operation was started on this context instance" errors.
        var catResult = await CategoryService.GetCategoriesAsync(1, 100);
        var locResult = await LocationService.GetLocationsAsync(1, 100);
        product = await ProductService.GetProductByIdAsync(Id);

        Categories = catResult.Categories;
        Locations = locResult.Locations;

        if (product == null)
        {
            ProductNotFound = true;
        }
        else
        {
            Model.sku = product.sku;
            Model.barcode_type = product.barcode_type ?? "";
            Model.name = product.name;
            Model.unit = product.Unit?.name ?? "";
            Model.value = product.value;
            Model.category_id = product.category_id ?? 0;
            Model.location_id = product.location_id;
            Model.current_stock = product.current_stock;
            Model.initial_stock = product.initial_stock;
            Model.is_returnable = product.is_returnable == 1;
        }
        
        IsLoading = false;
    }

    private async Task HandleSubmit()
    {
        if (Model.category_id == 0)
        {
            ErrorMessage = "Please select a category.";
            return;
        }

        IsSubmitting = true;
        ErrorMessage = null;
        StateHasChanged();

        if (selectedImage != null)
        {
            var ms = new System.IO.MemoryStream();
            await selectedImage.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(ms);
            ms.Position = 0;
            Model.image = new Microsoft.AspNetCore.Http.FormFile(ms, 0, selectedImage.Size, "image", selectedImage.Name)
            {
                Headers = new Microsoft.AspNetCore.Http.HeaderDictionary(),
                ContentType = selectedImage.ContentType
            };
        }

        if (selectedPositionImage != null)
        {
            var ms = new System.IO.MemoryStream();
            await selectedPositionImage.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(ms);
            ms.Position = 0;
            Model.position_image = new Microsoft.AspNetCore.Http.FormFile(ms, 0, selectedPositionImage.Size, "position_image", selectedPositionImage.Name)
            {
                Headers = new Microsoft.AspNetCore.Http.HeaderDictionary(),
                ContentType = selectedPositionImage.ContentType
            };
        }

        var result = await ProductService.UpdateProductAsync(Id, Model);
        
        IsSubmitting = false;

        if (result == null)
        {
            NavigationManager.NavigateTo("/Product");
        }
        else
        {
            ErrorMessage = result;
        }
    }

    private void HandleImageSelected(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        selectedImage = e.File;
    }

    private void HandlePositionImageSelected(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        selectedPositionImage = e.File;
    }

    private void NavigateBack()
    {
        NavigationManager.NavigateTo("/Product");
    }
}
