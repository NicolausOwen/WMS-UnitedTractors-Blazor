@page "/Approval"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using System.Security.Claims
@using UT_WMSDotnet.Models
@using WMS_UnitedTracors_Blazor.Services
@inject ApprovalService ApprovalService
@inject TransactionService TransactionService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>WMS - Persetujuan Admin</PageTitle>

<div class="py-5 sm:py-8 bg-[#f5f4f0] min-h-screen font-sans antialiased text-[#1a1a1a] pb-36 md:pb-24">
    <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8">
        
        <!-- Premium Header Area -->
        <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
                <h1 class="text-2xl sm:text-3xl font-extrabold text-[#1a1a1a] leading-tight tracking-tight flex items-center gap-2">
                    <span>Persetujuan</span> 
                    <span class="px-2.5 py-0.5 text-xs sm:text-sm font-bold bg-[#e8a000]/10 text-[#e8a000] border border-[#e8a000]/20 rounded-lg">Admin</span>
                </h1>
                <div class="text-[0.75rem] font-bold text-[#8a8880] mt-1.5 uppercase tracking-widest flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5 text-[#e8a000]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    @DateTime.Now.ToString("dddd, dd MMMM yyyy")
                </div>
            </div>
        </div>

        <!-- Premium Dashboard Overview Stats -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
            <!-- Permintaan Baru -->
            <button type="button" @onclick='() => ActiveTab = "new"' 
            class="group bg-white p-4 rounded-2xl border-l-4 border border-[#e5e3dc] transition-all duration-200 flex items-center gap-3 text-left w-full focus:outline-none select-none @(ActiveTab == "new" ? "border-l-amber-500 bg-amber-50/30 shadow-sm" : "border-l-transparent hover:border-l-amber-300 hover:bg-amber-50/10")">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 border transition-colors @(ActiveTab == "new" ? "bg-amber-100 border-amber-300 text-amber-600" : "bg-[#f5f4f0] border-gray-200 text-gray-500 group-hover:bg-amber-50 group-hover:text-amber-500 group-hover:border-amber-200")">
                    <svg class="w-5.5 h-5.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                </div>
                <div class="min-w-0 flex-1">
                    <div class="text-[9px] sm:text-[10px] text-[#8a8880] font-black uppercase tracking-wider">Permintaan Baru</div>
                    <div class="text-base sm:text-lg font-black text-gray-900 mt-0.5 flex items-baseline gap-1">
                        <span>@(GroupedApprovals?.Count ?? 0)</span>
                        <span class="text-[10px] sm:text-xs font-bold text-gray-400">Grup</span>
                    </div>
                </div>
            </button>

            <!-- Serah Terima -->
            <button type="button" @onclick='() => ActiveTab = "handovers"'
            class="group bg-white p-4 rounded-2xl border-l-4 border border-[#e5e3dc] transition-all duration-200 flex items-center gap-3 text-left w-full focus:outline-none select-none @(ActiveTab == "handovers" ? "border-l-blue-500 bg-blue-50/30 shadow-sm" : "border-l-transparent hover:border-l-blue-300 hover:bg-blue-50/10")">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 border transition-colors @(ActiveTab == "handovers" ? "bg-blue-100 border-blue-300 text-blue-600" : "bg-[#f5f4f0] border-gray-200 text-gray-500 group-hover:bg-blue-50 group-hover:text-blue-500 group-hover:border-blue-200")">
                    <svg class="w-5.5 h-5.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l-4-4m4 4l4-4"/></svg>
                </div>
                <div class="min-w-0 flex-1">
                    <div class="text-[9px] sm:text-[10px] text-[#8a8880] font-black uppercase tracking-wider">Serah Terima</div>
                    <div class="text-base sm:text-lg font-black text-gray-900 mt-0.5 flex items-baseline gap-1">
                        <span>@(GroupedHandovers?.Count ?? 0)</span>
                        <span class="text-[10px] sm:text-xs font-bold text-gray-400">Grup</span>
                    </div>
                </div>
            </button>

            <!-- Pengembalian -->
            <button type="button" @onclick='() => ActiveTab = "returns"'
            class="group bg-white p-4 rounded-2xl border-l-4 border border-[#e5e3dc] transition-all duration-200 flex items-center gap-3 text-left w-full focus:outline-none select-none @(ActiveTab == "returns" ? "border-l-emerald-500 bg-emerald-50/30 shadow-sm" : "border-l-transparent hover:border-l-emerald-300 hover:bg-emerald-50/10")">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 border transition-colors @(ActiveTab == "returns" ? "bg-emerald-100 border-emerald-300 text-emerald-600" : "bg-[#f5f4f0] border-gray-200 text-gray-500 group-hover:bg-emerald-50 group-hover:text-emerald-500 group-hover:border-emerald-200")">
                    <svg class="w-5.5 h-5.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/></svg>
                </div>
                <div class="min-w-0 flex-1">
                    <div class="text-[9px] sm:text-[10px] text-[#8a8880] font-black uppercase tracking-wider">Pengembalian</div>
                    <div class="text-base sm:text-lg font-black text-gray-900 mt-0.5 flex items-baseline gap-1">
                        <span>@(PendingReturns?.Count ?? 0)</span>
                        <span class="text-[10px] sm:text-xs font-bold text-gray-400">Item</span>
                    </div>
                </div>
            </button>

            <!-- Edit Profil -->
            <button type="button" @onclick='() => ActiveTab = "profiles"'
            class="group bg-white p-4 rounded-2xl border-l-4 border border-[#e5e3dc] transition-all duration-200 flex items-center gap-3 text-left w-full focus:outline-none select-none @(ActiveTab == "profiles" ? "border-l-rose-500 bg-rose-50/30 shadow-sm" : "border-l-transparent hover:border-l-rose-300 hover:bg-rose-50/10")">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 border transition-colors @(ActiveTab == "profiles" ? "bg-rose-100 border-rose-300 text-[#e05252]" : "bg-[#f5f4f0] border-gray-200 text-gray-500 group-hover:bg-rose-50 group-hover:text-rose-500 group-hover:border-rose-200")">
                    <svg class="w-5.5 h-5.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                </div>
                <div class="min-w-0 flex-1">
                    <div class="text-[9px] sm:text-[10px] text-[#8a8880] font-black uppercase tracking-wider">Edit Profil</div>
                    <div class="text-base sm:text-lg font-black text-gray-900 mt-0.5 flex items-baseline gap-1">
                        <span>@(PendingProfileRequests?.Count ?? 0)</span>
                        <span class="text-[10px] sm:text-xs font-bold text-gray-400">Ajuan</span>
                    </div>
                </div>
            </button>
        </div>

        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="mb-6 flex items-center gap-3 bg-[#eef9f0] border border-[#b8e8c0] text-[#1a7a30] px-4 py-3 rounded-xl text-sm font-bold shadow-sm animate-fadeIn">
                <div class="w-6 h-6 rounded-full bg-[#1a7a30]/10 flex items-center justify-center shrink-0">
                    <svg class="w-4 h-4 text-[#1a7a30]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                </div>
                <span>@SuccessMessage</span>
            </div>
        }
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="mb-6 flex items-center gap-3 bg-[#fef0f0] border border-[#f8c0c0] text-[#d94040] px-4 py-3 rounded-xl text-sm font-bold shadow-sm animate-fadeIn">
                <div class="w-6 h-6 rounded-full bg-[#d94040]/10 flex items-center justify-center shrink-0">
                    <svg class="w-4 h-4 text-[#d94040]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                </div>
                <span>@ErrorMessage</span>
            </div>
        }

        <!-- Segmented Tab Controls (Premium Glassmorphic Look) -->
        <div class="bg-[#ebeae4]/70 p-1.5 rounded-xl flex items-center gap-1.5 overflow-x-auto w-full mb-6 border border-[#e2e1da] scrollbar-none shadow-inner">
            <button @onclick='() => ActiveTab = "new"' 
                    class="px-4 py-2.5 text-xs sm:text-sm font-bold rounded-lg transition-all duration-300 flex items-center gap-2 shrink-0 select-none focus:outline-none @(ActiveTab == "new" ? "bg-white text-gray-900 shadow-sm border border-gray-200/50" : "text-[#6b665e] hover:text-gray-950 hover:bg-white/40")">
                <svg class="w-4 h-4 shrink-0 @(ActiveTab == "new" ? "text-amber-500" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01m-.01 4h.01"/></svg>
                <span>Permintaan Baru</span>
                @if (GroupedApprovals?.Count > 0)
                {
                    <span class="ml-0.5 px-2 py-0.5 rounded-md text-[10px] font-black @(ActiveTab == "new" ? "bg-amber-500 text-gray-950" : "bg-gray-200 text-gray-700")">@GroupedApprovals.Count</span>
                }
            </button>
            <button @onclick='() => ActiveTab = "handovers"' 
                    class="px-4 py-2.5 text-xs sm:text-sm font-bold rounded-lg transition-all duration-300 flex items-center gap-2 shrink-0 select-none focus:outline-none @(ActiveTab == "handovers" ? "bg-white text-gray-900 shadow-sm border border-gray-200/50" : "text-[#6b665e] hover:text-gray-950 hover:bg-white/40")">
                <svg class="w-4 h-4 shrink-0 @(ActiveTab == "handovers" ? "text-blue-500" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l-4-4m4 4l-4-4"/></svg>
                <span>Serah Terima</span>
                @if (GroupedHandovers?.Count > 0)
                {
                    <span class="ml-0.5 px-2 py-0.5 rounded-md text-[10px] font-black @(ActiveTab == "handovers" ? "bg-blue-500 text-white" : "bg-gray-200 text-gray-700")">@GroupedHandovers.Count</span>
                }
            </button>
            <button @onclick='() => ActiveTab = "returns"' 
                    class="px-4 py-2.5 text-xs sm:text-sm font-bold rounded-lg transition-all duration-300 flex items-center gap-2 shrink-0 select-none focus:outline-none @(ActiveTab == "returns" ? "bg-white text-gray-900 shadow-sm border border-gray-200/50" : "text-[#6b665e] hover:text-gray-950 hover:bg-white/40")">
                <svg class="w-4 h-4 shrink-0 @(ActiveTab == "returns" ? "text-emerald-500" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/></svg>
                <span>Pengembalian</span>
                @if (PendingReturns?.Count > 0)
                {
                    <span class="ml-0.5 px-2 py-0.5 rounded-md text-[10px] font-black @(ActiveTab == "returns" ? "bg-emerald-500 text-white" : "bg-gray-200 text-gray-700")">@PendingReturns.Count</span>
                }
            </button>
            <button @onclick='() => ActiveTab = "profiles"' 
                    class="px-4 py-2.5 text-xs sm:text-sm font-bold rounded-lg transition-all duration-300 flex items-center gap-2 shrink-0 select-none focus:outline-none @(ActiveTab == "profiles" ? "bg-white text-gray-900 shadow-sm border border-gray-200/50" : "text-[#6b665e] hover:text-gray-950 hover:bg-white/40")">
                <svg class="w-4 h-4 shrink-0 @(ActiveTab == "profiles" ? "text-rose-500" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                <span>Edit Profil</span>
                @if (PendingProfileRequests?.Count > 0)
                {
                    <span class="ml-0.5 px-2 py-0.5 rounded-md text-[10px] font-black @(ActiveTab == "profiles" ? "bg-rose-500 text-white" : "bg-gray-200 text-gray-700")">@PendingProfileRequests.Count</span>
                }
            </button>
        </div>

        @if (ActiveTab == "new")
        {
            @if (GroupedApprovals == null)
            {
                <div class="bg-white p-12 rounded-xl border border-[#e5e3dc] text-center shadow-sm text-gray-500">Loading requests...</div>
            }
            else if (GroupedApprovals.Count == 0)
            {
                <div class="bg-white p-12 rounded-xl border border-[#e5e3dc] text-center shadow-sm">
                    <svg class="w-12 h-12 text-[#d1d0cb] mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
                    <p class="text-sm font-bold text-[#8a8880] tracking-wide">Tidak ada pengajuan persetujuan saat ini.</p>
                </div>
            }
            else
            {
                var borrowGroups = GroupedApprovals.Where(g => g.Value.FirstOrDefault()?.request_type == "BORROW").ToList();
                var giveawayGroups = GroupedApprovals.Where(g => g.Value.FirstOrDefault()?.request_type == "GIVEAWAY").ToList();

                @if (giveawayGroups.Count > 0)
                {
                    <div class="mb-8">
                        <h3 class="text-xs font-black text-[#5a5855] mb-3.5 uppercase tracking-wider flex items-center gap-1.5 font-bold">
                            <span class="w-1.5 h-3 bg-purple-500 rounded-full"></span>
                            <span>Permintaan Ambil Barang (Giveaway)</span>
                        </h3>
                        <div class="space-y-4">
                            @foreach (var group in giveawayGroups)
                            {
                                @RenderGroup(group)
                            }
                        </div>
                    </div>
                }

                @if (borrowGroups.Count > 0)
                {
                    <div class="mb-8">
                        <h3 class="text-xs font-black text-[#5a5855] mb-3.5 uppercase tracking-wider flex items-center gap-1.5 font-bold">
                            <span class="w-1.5 h-3 bg-blue-500 rounded-full"></span>
                            <span>Permintaan Pinjam Barang (Borrow)</span>
                        </h3>
                        <div class="space-y-4">
                            @foreach (var group in borrowGroups)
                            {
                                @RenderGroup(group)
                            }
                        </div>
                    </div>
                }

                @* Batch action bar — fixed di bawah (glassmorphic pill) *@
                <div class="fixed bottom-20 md:bottom-6 left-1/2 -translate-x-1/2 z-30 max-w-md w-[calc(100%-2rem)]">
                    <div class="backdrop-blur-md bg-white/90 border border-[#e2e1da] px-4.5 py-3 rounded-2xl shadow-xl flex items-center justify-between gap-4 animate-slideUp">
                        <div class="min-w-0">
                            <div class="text-[9px] text-[#8a8880] font-black uppercase tracking-wider">Draft Persetujuan</div>
                            <div class="text-sm font-black text-gray-900 mt-0.5 flex items-center gap-1.5">
                                <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
                                <span>@Decisions.Count Item Dipilih</span>
                            </div>
                        </div>
                        <button type="button" @onclick="OpenBatchConfirmModal" disabled="@(Decisions.Count == 0 || IsProcessing)"
                                class="inline-flex items-center gap-1.5 px-5 py-2.5 bg-[#1a1a1a] text-white text-xs font-black rounded-xl shadow-md hover:bg-[#333] transition active:scale-[0.98] disabled:opacity-40 disabled:shadow-none select-none h-11 shrink-0">
                            <svg class="w-4 h-4 shrink-0 text-amber-500 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                            <span>Proses (@Decisions.Count)</span>
                        </button>
                    </div>
                </div>
            }
        }
        else if (ActiveTab == "handovers")
        {
            @if (GroupedHandovers == null || GroupedHandovers.Count == 0)
            {
                <div class="bg-white p-12 rounded-2xl border border-[#e5e3dc] text-center shadow-sm max-w-lg mx-auto mt-6 animate-fadeIn">
                    <svg class="w-12 h-12 text-[#d1d0cb] mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    <p class="text-sm font-bold text-[#8a8880] tracking-wide">Tidak ada serah terima pending saat ini.</p>
                </div>
            }
            else
            {
                <div class="space-y-6">
                    @foreach (var group in GroupedHandovers)
                    {
                        var firstItem = group.Value.First();
                        var isWaitingInput = group.Value.Any(i => i.status == WorkflowStatuses.WaitingHandover);
                        var isWaitingUserConfirm = group.Value.Any(i => i.status == WorkflowStatuses.WaitingHandoverConfirm && i.handover_uploaded_by == "USER");
                        var isWaitingVerification = group.Value.Any(i => i.status == WorkflowStatuses.WaitingAdminHandover);
                        var isGiveawayHandover = group.Value.All(i => i.request_type == "GIVEAWAY");
                        
                        <div class="bg-white rounded-2xl border border-[#e5e3dc] shadow-sm overflow-hidden animate-fadeIn border-l-4 border-l-[#1a6b8a]">
                            <!-- Group Header Card -->
                            <div class="px-5 py-5 border-b border-[#f0ede5] flex flex-col lg:flex-row lg:items-center justify-between bg-gradient-to-r from-gray-50 to-white gap-4">
                                <div class="min-w-0">
                                    <div class="flex items-center gap-2 flex-wrap">
                                        <h4 class="font-extrabold text-[#1a1a1a] text-base sm:text-lg">Event: @(firstItem.event_name ?? "-")</h4>
                                        <span class="px-2 py-0.5 rounded-full bg-gray-100 text-gray-700 text-[10px] font-bold border border-gray-200">@group.Value.Count Item</span>
                                    </div>
                                    <div class="text-xs text-[#6b665e] mt-1.5 font-semibold">
                                        Pemohon: <span class="text-gray-900 font-extrabold">@(firstItem.applicant_name ?? firstItem.Requester?.name)</span>
                                    </div>
                                    <div class="mt-2.5">
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl text-[10px] font-extrabold uppercase tracking-wider border @(isWaitingVerification ? "bg-[#eef9f0] text-[#1a7a30] border-[#b8e8c0]" : isWaitingUserConfirm ? "bg-[#e0f2fe] text-[#1a6b8a] border-[#bae6fd]" : "bg-[#fffbeb] text-[#b77900] border-[#f3d37a]")">
                                            <span class="w-1.5 h-1.5 rounded-full @(isWaitingVerification ? "bg-[#1a7a30]" : isWaitingUserConfirm ? "bg-[#1a6b8a]" : "bg-[#b77900]")"></span>
                                            @(isWaitingVerification ? "Menunggu Verifikasi Admin" : isWaitingUserConfirm ? "Menunggu Konfirmasi SI" : "Menunggu Input Serah Terima")
                                        </span>
                                    </div>
                                </div>
                                
                                <!-- Group Level Buttons -->
                                <div class="flex flex-wrap gap-2.5 shrink-0">
                                    @if (isWaitingInput)
                                    {
                                        <button type="button" @onclick="() => OpenApprovalHandoverModal(group.Value)" 
                                                class="px-4 py-2.5 bg-[#e8a000] hover:bg-[#d49300] text-[#1a1a1a] text-xs font-extrabold rounded-xl shadow-sm transition active:scale-[0.98] select-none h-11 flex items-center gap-1.5">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                            <span>@(TransactionService.HasStoredFiles(firstItem.handover_photo) ? "Ubah Draft" : "Isi Bukti")</span>
                                        </button>
                                        @if (TransactionService.HasStoredFiles(firstItem.handover_photo))
                                        {
                                            <button type="button" @onclick='() => AskConfirm(isGiveawayHandover ? "Selesaikan Serah Terima" : "Submit Serah Terima", isGiveawayHandover ? "Selesaikan serah terima giveaway ini? Stok akan dipotong dan sistem akan menunggu dokumentasi user." : "Kirim bukti serah terima ke admin untuk diverifikasi?", () => SubmitApprovalHandover(group.Value), isGiveawayHandover ? "Ya, Selesaikan" : "Ya, Submit")' 
                                                    disabled="@IsProcessing" class="px-4 py-2.5 bg-[#1a7a30] hover:bg-[#166528] text-white text-xs font-extrabold rounded-xl shadow-sm transition active:scale-[0.98] disabled:opacity-50 select-none h-11 flex items-center gap-1.5">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-5 9l2 2 4-4"/></svg>
                                                <span>@(isGiveawayHandover ? "Selesaikan Serah Terima" : "Kirim ke Verifikasi")</span>
                                            </button>
                                        }
                                    }
                                    @if (isWaitingUserConfirm)
                                    {
                                        <button type="button" @onclick='() => AskConfirm("Konfirmasi Serah Terima", "Konfirmasi penerimaan bukti serah terima ini?", () => ConfirmHandoverBySi(group.Key, true), "Ya, Konfirmasi")' 
                                                disabled="@IsProcessing" class="px-4 py-2.5 bg-[#1a7a30] hover:bg-[#166528] text-white text-xs font-extrabold rounded-xl shadow-sm transition active:scale-[0.98] disabled:opacity-50 select-none h-11 flex items-center justify-center">
                                            Konfirmasi
                                        </button>
                                        <button type="button" @onclick='() => AskConfirm("Tolak Serah Terima", "Tolak bukti serah terima ini?", () => ConfirmHandoverBySi(group.Key, false), "Ya, Tolak")' 
                                                disabled="@IsProcessing" class="px-4 py-2.5 bg-white border border-red-200 text-red-600 hover:bg-red-50 text-xs font-extrabold rounded-xl transition active:scale-[0.98] disabled:opacity-50 select-none h-11 flex items-center justify-center">
                                            Tolak
                                        </button>
                                    }
                                    @if (isWaitingVerification)
                                    {
                                        <button type="button" @onclick='() => AskConfirm("Approve Serah Terima", "Setujui bukti serah terima ini? Barang akan tercatat sebagai sedang dipinjam.", () => ApproveHandoverBatch(group.Key), "Ya, Setujui")' 
                                                disabled="@IsProcessing" class="px-4 py-2.5 bg-gray-900 hover:bg-gray-800 text-white text-xs font-extrabold rounded-xl shadow-sm transition active:scale-[0.98] select-none h-11 flex items-center justify-center">
                                            Approve Handover
                                        </button>
                                        <button type="button" @onclick="() => OpenHandoverRejectModal(group.Key)" 
                                                class="px-4 py-2.5 bg-white border border-red-200 text-red-600 hover:bg-red-50 text-xs font-extrabold rounded-xl transition active:scale-[0.98] select-none h-11 flex items-center justify-center">
                                            Reject Proof
                                        </button>
                                    }
                                </div>
                            </div>
                            
                            <!-- Inner Item Stack -->
                            <div class="divide-y divide-[#f0ede5]">
                                @foreach (var item in group.Value)
                                {
                                    var parsedFiles = TransactionService.ParseStoredFiles(item.handover_photo);
                                    var hasFiles = parsedFiles.Any();
                                    
                                    <div class="p-4 sm:p-5 hover:bg-gray-50/40 transition-colors duration-200">
                                        <!-- Row: Product + Meta -->
                                        <div class="flex items-start gap-3.5 mb-3.5">
                                            <!-- Product Thumbnail -->
                                            <div class="w-11 h-11 sm:w-13 sm:h-13 rounded-xl border border-gray-200 overflow-hidden shrink-0 bg-white shadow-sm flex items-center justify-center relative group cursor-pointer" data-image-popup>
                                                <img src="@ImageHelper.ResolveProduct(item.Product, "/img/logo.svg")" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" alt="@item.Product?.name">
                                            </div>
                                            <!-- Name + Badges -->
                                            <div class="min-w-0 flex-1">
                                                <div class="font-extrabold text-gray-900 text-sm leading-snug">@(item.Product?.name)</div>
                                                <div class="flex flex-wrap items-center gap-1.5 mt-1">
                                                    <code class="text-[9px] text-gray-500 bg-gray-100 border border-gray-200 px-1.5 py-0.5 rounded font-mono">@(item.Product?.sku)</code>
                                                    @if (item.request_type == "BORROW")
                                                    {
                                                        <span class="inline-flex items-center bg-blue-50 text-blue-700 px-2 py-0.5 rounded-md text-[9px] font-extrabold border border-blue-100 uppercase tracking-wide gap-1">
                                                            <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                                            @(item.borrow_start_date?.ToString("dd MMM") ?? "-") — @(item.expected_return_date?.ToString("dd MMM yyyy") ?? "-")
                                                        </span>
                                                    }
                                                    else if (item.request_type == "GIVEAWAY")
                                                    {
                                                        <span class="inline-flex items-center bg-purple-50 text-purple-700 px-2 py-0.5 rounded-md text-[9px] font-extrabold border border-purple-100 uppercase tracking-wide gap-1">
                                                            <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                                                            Ambil: @(item.pickup_date?.ToString("dd MMM yyyy") ?? "-")
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                            <!-- Qty pill -->
                                            <div class="shrink-0 text-right bg-[#faf9f5] border border-gray-200 rounded-xl px-3 py-1.5">
                                                <div class="text-[9px] text-[#8a8880] font-bold uppercase tracking-wider">Jumlah</div>
                                                <div class="text-sm font-extrabold text-gray-900 mt-0.5">@item.quantity <span class="text-[10px] font-bold text-gray-500">@(item.Product?.Unit?.name ?? "unit")</span></div>
                                            </div>
                                        </div>

                                        <!-- Row: Proof files + Status + Actions -->
                                        <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4">
                                            <!-- Proof Files -->
                                            <div class="flex-1 min-w-0">
                                                @if (hasFiles)
                                                {
                                                    <div class="flex items-center gap-2 flex-wrap">
                                                        @foreach (var file in parsedFiles.Take(5))
                                                        {
                                                            <div class="w-10 h-10 rounded-lg border border-[#e5e3dc] overflow-hidden bg-white shrink-0 shadow-sm hover:shadow-md transition hover:scale-105 relative group">
                                                                @if (file.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                                                                {
                                                                    <a href="@($"/{file.TrimStart('/')}")" target="_blank" class="w-full h-full flex items-center justify-center bg-red-50 text-red-500">
                                                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                                                                    </a>
                                                                }
                                                                else
                                                                {
                                                                    <a href="@($"/{file.TrimStart('/')}")" target="_blank" data-image-popup class="w-full h-full block">
                                                                        <img src="@($"/{file.TrimStart('/')}")" class="w-full h-full object-cover" />
                                                                    </a>
                                                                }
                                                            </div>
                                                        }
                                                        @if (!string.IsNullOrEmpty(item.handover_notes))
                                                        {
                                                            <span class="text-[10px] text-[#6b665e] italic truncate max-w-[200px] font-medium" title="@item.handover_notes">"@item.handover_notes"</span>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="flex items-center gap-2 text-[#8a8880]">
                                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                                        <span class="text-[10px] font-bold uppercase tracking-wider">Belum Ada Bukti</span>
                                                    </div>
                                                }
                                            </div>

                                            <!-- Status Badge -->
                                            <div class="shrink-0">
                                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 border rounded-lg text-[9px] font-extrabold uppercase tracking-wide @(GetHandoverStatusClass(item.status))">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-current opacity-80"></span>
                                                    @GetHandoverStatusLabel(item.status)
                                                </span>
                                                @if (item.status == WorkflowStatuses.WaitingHandover && !string.IsNullOrEmpty(item.rejection_reason))
                                                {
                                                    <div class="mt-1.5 px-2.5 py-1.5 bg-red-50 border border-red-200 rounded-lg text-[9px] text-red-700 font-semibold leading-tight max-w-[180px]" title="@item.rejection_reason">
                                                        <div class="font-extrabold text-[#d94040] mb-0.5 uppercase tracking-wider">Alasan Ditolak</div>
                                                        "@item.rejection_reason"
                                                    </div>
                                                }
                                            </div>

                                            <!-- Actions per Item -->
                                            <div class="flex items-center gap-2 shrink-0">
                                                @if (item.status == WorkflowStatuses.WaitingHandover)
                                                {
                                                    <button type="button" @onclick="() => OpenApprovalHandoverModal(new List<Transaction> { item })" 
                                                            class="px-3.5 py-2 bg-[#fffbeb] border border-[#f3d37a] hover:bg-[#fef3c7] text-[#b77900] text-[10px] font-extrabold rounded-xl transition active:scale-[0.97] select-none h-9 flex items-center gap-1.5">
                                                        <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                                                        <span>@(TransactionService.HasStoredFiles(item.handover_photo) ? "Ubah" : "Isi Bukti")</span>
                                                    </button>
                                                    @if (TransactionService.HasStoredFiles(item.handover_photo))
                                                    {
                                                        <button type="button" @onclick='() => AskConfirm(item.request_type == "GIVEAWAY" ? "Selesaikan Serah Terima" : "Submit Serah Terima", item.request_type == "GIVEAWAY" ? "Selesaikan serah terima giveaway ini?" : "Kirim bukti serah terima ke admin?", () => SubmitApprovalHandover(new List<Transaction> { item }), "Ya, Kirim")' 
                                                                disabled="@IsProcessing" class="px-3.5 py-2 bg-[#1a7a30] hover:bg-[#166528] text-white text-[10px] font-extrabold rounded-xl transition active:scale-[0.97] disabled:opacity-50 select-none h-9 flex items-center gap-1.5">
                                                            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                                                            Submit
                                                        </button>
                                                    }
                                                }
                                                else if (item.status == WorkflowStatuses.WaitingAdminHandover)
                                                {
                                                    <button type="button" @onclick='() => AskConfirm("Approve Serah Terima", "Setujui bukti serah terima ini?", () => ApproveHandoverItem(item.id), "Ya, Setujui")' 
                                                            disabled="@IsProcessing" class="px-3.5 py-2 bg-[#1a1a1a] hover:bg-[#333] text-white text-[10px] font-extrabold rounded-xl transition active:scale-[0.97] select-none h-9 flex items-center gap-1.5">
                                                        <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                                                        Approve
                                                    </button>
                                                    <button type="button" @onclick="() => OpenHandoverItemRejectModal(item.id)" 
                                                            class="px-3.5 py-2 bg-white border border-red-200 text-red-600 hover:bg-red-50 text-[10px] font-extrabold rounded-xl transition active:scale-[0.97] select-none h-9 flex items-center gap-1.5">
                                                        <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>
                                                        Reject
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                                </div>
                    }
                </div>
            }
        }
        else if (ActiveTab == "returns")
        {
            @if (PendingReturns == null || PendingReturns.Count == 0)
            {
                <div class="bg-white p-12 rounded-2xl border border-[#e5e3dc] text-center shadow-sm max-w-lg mx-auto mt-6 animate-fadeIn">
                    <svg class="w-12 h-12 text-[#d1d0cb] mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 15l-3-3m0 0l3-3m-3 3h8M3 12a9 9 0 1118 0 9 9 0 01-18 0z"/></svg>
                    <p class="text-sm font-bold text-[#8a8880] tracking-wide">Tidak ada pengembalian pending saat ini.</p>
                </div>
            }
            else
            {
                <div class="space-y-4">
                    @foreach (var item in PendingReturns)
                    {
                        var isGood = string.Equals(item.return_status, "bagus", StringComparison.OrdinalIgnoreCase) || string.Equals(item.return_status, "good", StringComparison.OrdinalIgnoreCase);
                        
                        <div class="bg-white rounded-2xl border border-[#e5e3dc] shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden animate-fadeIn">
                            <!-- Card Header: product + condition badge -->
                            <div class="p-4 sm:p-5">
                                <div class="flex items-start gap-3">
                                    <!-- Small Thumbnail (always fixed size) -->
                                    <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-xl border border-[#e5e3dc] overflow-hidden shrink-0 bg-[#f5f4f0] flex items-center justify-center relative group cursor-pointer">
                                        @if (!string.IsNullOrEmpty(item.return_photo) && item.return_photo != "forced-by-admin")
                                        {
                                            <a href="@ImageHelper.Resolve(item.return_photo)" target="_blank" data-image-popup class="w-full h-full block">
                                                <img src="@ImageHelper.Resolve(item.return_photo)" class="w-full h-full object-cover group-hover:scale-110 transition duration-300" />
                                                <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition duration-200 flex items-center justify-center">
                                                    <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                                                </div>
                                            </a>
                                        }
                                        else
                                        {
                                            <div class="flex flex-col items-center justify-center gap-0.5">
                                                <svg class="w-5 h-5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                                <span class="text-[8px] font-bold text-gray-300 uppercase tracking-wide">Foto</span>
                                            </div>
                                        }
                                    </div>

                                    <!-- Product info -->
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-start justify-between gap-2">
                                            <div class="min-w-0">
                                                <h4 class="text-sm font-extrabold text-gray-900 leading-snug line-clamp-2">@item.Product?.name</h4>
                                                <code class="text-[9px] text-gray-400 font-mono mt-0.5 inline-block">@(item.Product?.sku)</code>
                                            </div>
                                            <!-- Condition Badge -->
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 border rounded-full text-[9px] font-extrabold uppercase tracking-wide shrink-0 @(isGood ? "bg-emerald-50 text-emerald-700 border-emerald-200" : "bg-red-50 text-red-700 border-red-200")">
                                                <span class="w-1.5 h-1.5 rounded-full @(isGood ? "bg-emerald-500" : "bg-red-500")"></span>
                                                @(item.return_status ?? "-")
                                            </span>
                                        </div>
                                        <div class="text-[10px] text-[#8a8880] font-semibold mt-1.5">
                                            Oleh: <span class="text-gray-900 font-extrabold">@(item.applicant_name ?? item.Requester?.name)</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Quantity comparison row -->
                                <div class="mt-3.5 flex items-center gap-2 flex-wrap">
                                    <div class="flex items-center gap-1.5 bg-gray-100 border border-gray-200 rounded-lg px-2.5 py-1.5">
                                        <svg class="w-3 h-3 text-gray-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                                        <span class="text-[10px] font-bold text-gray-600">Dipinjam: <span class="text-gray-900 font-extrabold">@item.quantity @(item.Product?.Unit?.name ?? "unit")</span></span>
                                    </div>
                                    <svg class="w-3.5 h-3.5 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                                    <div class="flex items-center gap-1.5 @(item.pending_return_quantity < item.quantity ? "bg-amber-50 border-amber-200" : "bg-emerald-50 border-emerald-200") border rounded-lg px-2.5 py-1.5">
                                        <svg class="w-3 h-3 @(item.pending_return_quantity < item.quantity ? "text-amber-500" : "text-emerald-500") shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/></svg>
                                        <span class="text-[10px] font-bold @(item.pending_return_quantity < item.quantity ? "text-amber-700" : "text-emerald-700")">Kembali: <span class="font-extrabold">@item.pending_return_quantity @(item.Product?.Unit?.name ?? "unit")</span></span>
                                        @if (item.pending_return_quantity < item.quantity)
                                        {
                                            <span class="text-[8px] font-black text-amber-600 uppercase tracking-wide">⚠ Kurang</span>
                                        }
                                    </div>
                                </div>

                                @if (!string.IsNullOrEmpty(item.return_reason))
                                {
                                    <div class="mt-3 p-3 bg-[#faf9f5] border border-[#ebe9e0] rounded-xl">
                                        <div class="text-[9px] text-[#8a8880] font-black uppercase tracking-wider mb-0.5">Catatan</div>
                                        <p class="text-xs text-[#5a5855] italic font-medium leading-relaxed">"@item.return_reason"</p>
                                    </div>
                                }
                            </div>

                            <!-- Action Buttons -->
                            <div class="px-4 sm:px-5 pb-4 sm:pb-5 flex gap-2.5">
                                <button type="button" @onclick='() => AskConfirm("Approve Pengembalian", "Setujui pengembalian ini? Stok akan dikembalikan ke inventaris.", () => ApproveReturn(item.id), "Ya, Setujui")' 
                                        disabled="@IsProcessing" class="flex-1 px-4 py-2.5 bg-[#1a1a1a] hover:bg-[#333] text-white text-xs font-extrabold rounded-xl transition active:scale-[0.98] shadow-sm disabled:opacity-50 select-none h-10 flex items-center justify-center gap-1.5">
                                    <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                                    <span>Approve</span>
                                </button>
                                <button type="button" @onclick="() => OpenRejectModal(item.id, true)" 
                                        class="flex-1 px-4 py-2.5 bg-white border border-red-200 text-red-600 hover:bg-red-50 text-xs font-extrabold rounded-xl transition active:scale-[0.98] select-none h-10 flex items-center justify-center gap-1.5">
                                    <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>
                                    <span>Tolak</span>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        }
        else if (ActiveTab == "profiles")
        {
            @if (PendingProfileRequests == null || PendingProfileRequests.Count == 0)
            {
                <div class="bg-white p-12 rounded-2xl border border-[#e5e3dc] text-center shadow-sm max-w-lg mx-auto mt-6 animate-fadeIn">
                    <svg class="w-12 h-12 text-[#d1d0cb] mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                    <p class="text-sm font-bold text-[#8a8880] tracking-wide">Tidak ada pengajuan pembaruan profil saat ini.</p>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 animate-fadeIn">
                    @foreach (var pr in PendingProfileRequests)
                    {
                        <div class="bg-white border border-[#e5e3dc] rounded-2xl p-5 shadow-sm hover:shadow-md transition-all duration-300 flex flex-col justify-between">
                            <div>
                                <!-- User Avatar and Header -->
                                <div class="flex items-center gap-3.5 mb-4">
                                    <div class="w-11 h-11 rounded-full bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-sm font-black text-amber-600 shrink-0 uppercase">
                                        @pr.User?.name?.Substring(0, Math.Min(2, pr.User?.name?.Length ?? 0)).ToUpper()
                                    </div>
                                    <div class="min-w-0">
                                        <h4 class="text-sm sm:text-base font-extrabold text-gray-900 truncate">@pr.User?.name</h4>
                                        <p class="text-[10px] text-[#8a8880] font-bold uppercase tracking-wider mt-0.5">@pr.created_at?.ToString("dd MMM yyyy")</p>
                                    </div>
                                </div>
                                
                                <!-- Metadata grid -->
                                <div class="space-y-3 mb-5 p-4 bg-[#faf9f5] border border-gray-150 rounded-xl">
                                    <div>
                                        <div class="text-[9px] text-[#8a8880] uppercase font-bold tracking-wider">Usulan NRP</div>
                                        <div class="text-xs font-extrabold text-gray-900 mt-0.5">@pr.nrp</div>
                                    </div>
                                    <div class="border-t border-gray-200/50 pt-2.5">
                                        <div class="text-[9px] text-[#8a8880] uppercase font-bold tracking-wider">Usulan Divisi</div>
                                        <div class="text-xs font-extrabold text-gray-900 mt-0.5">@pr.Division?.name</div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Action Buttons -->
                            <div class="flex gap-2.5 pt-3 border-t border-[#f0ede5] h-11">
                                <button @onclick='() => AskConfirm("Approve Perubahan Profil", "Setujui perubahan data profil ini? Data user akan diperbarui di database.", () => ApproveProfileRequest(pr.id), "Ya, Setujui")' 
                                        class="flex-1 bg-gray-900 hover:bg-gray-800 text-white text-xs font-extrabold rounded-xl transition active:scale-[0.98] select-none h-full flex items-center justify-center">
