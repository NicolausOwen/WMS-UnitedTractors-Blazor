@page "/TransactionHistory"
@page "/Transactions/History"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using UT_WMSDotnet.Models
@using WMS_UnitedTracors_Blazor.Services
@inject TransactionService TransactionService
@inject DivisionService DivisionService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Transaction History</PageTitle>

<div class="py-8 md:py-12 bg-[#f5f4f0] min-h-screen font-sans">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="mb-6">
            <h1 class="text-[1.6rem] font-bold text-[#1a1a1a] leading-none tracking-tight">Riwayat <span class="text-[#e8a000]">Transaksi</span></h1>
            <div class="text-[0.72rem] font-medium text-[#a09e99] mt-1">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</div>
        </div>

        <div class="bg-white rounded-xl border border-[#e5e3dc] overflow-hidden shadow-sm mb-8">
            <div class="p-6">
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:flex lg:items-end gap-4">
                    <div class="flex-1 min-w-[150px]">
                        <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Start Date</label>
                        <input type="date" @bind="StartDate" class="block w-full px-3 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none transition-colors duration-150 text-[#1a1a1a]">
                    </div>
                    <div class="flex-1 min-w-[150px]">
                        <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">End Date</label>
                        <input type="date" @bind="EndDate" class="block w-full px-3 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none transition-colors duration-150 text-[#1a1a1a]">
                    </div>
                    <div class="min-w-[150px]">
                        <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Filter Type</label>
                        <select @bind="FilterType" @bind:after="OnFilterTypeChanged" class="block w-full px-3 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none transition-colors duration-150 text-[#1a1a1a]">
                            <option value="">All Types</option>
                            <option value="IN">STOCK IN</option>
                            <option value="OUT">STOCK OUT</option>
                        </select>
                    </div>
                    @if (FilterType == "OUT")
                    {
                        <div class="min-w-[150px]">
                            <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Request Type</label>
                            <select @bind="FilterRequestType" @bind:after="OnFilterRequestTypeChanged" class="block w-full px-3 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none transition-colors duration-150 text-[#1a1a1a]">
                                <option value="">All Request Types</option>
                                <option value="GIVEAWAY">Diminta / Giveaway</option>
                                <option value="BORROW">Dipinjam / Borrow</option>
                            </select>
                        </div>
                    }
                    <div class="flex gap-2">
                        <button type="button" @onclick="() => LoadData(1)" class="px-6 py-2 bg-[#1a1a1a] text-white text-sm font-bold rounded-lg hover:bg-[#333] transition">Apply</button>
                        <button type="button" @onclick="ResetFilters" class="px-6 py-2 bg-white border border-[#e5e3dc] text-gray-700 text-sm font-bold rounded-lg hover:bg-gray-50 transition">Reset</button>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="mb-6 flex items-center gap-3 bg-[#eef9f0] border border-[#b8e8c0] text-[#1a7a30] px-4 py-3 rounded-lg text-sm font-semibold">
                <svg class="w-4 h-4 shrink-0 text-[#1a7a30]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                @SuccessMessage
            </div>
        }
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="mb-6 flex items-center gap-3 bg-[#fef0f0] border border-[#f8c0c0] text-[#d94040] px-4 py-3 rounded-lg text-sm font-semibold">
                <svg class="w-4 h-4 shrink-0 text-[#d94040]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                @ErrorMessage
            </div>
        }

        @if (Transactions == null || !Transactions.Any())
        {
            <div class="bg-white p-16 rounded-xl border border-[#e5e3dc] text-center shadow-sm">
                <svg class="w-16 h-16 text-[#d1d0cb] mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
                <p class="text-base font-bold text-[#8a8880] tracking-wide">Tidak ada riwayat transaksi.</p>
                <p class="text-xs text-[#a09e99] mt-1">Coba sesuaikan filter atau rentang tanggal Anda.</p>
            </div>
        }
        else
        {
            <div class="space-y-6">
                @foreach (var group in GroupedTransactions)
                {
                    var items = group.Value;
                    var firstItem = items.First();
                    bool isExpanded = ExpandedGroups.Contains(group.Key);
                    var groupId = group.Key;
                    
                    <div class="bg-white rounded-[1.5rem] shadow-sm border border-[#e5e3dc] overflow-hidden transition-all duration-200">
                        <!-- Header Accordion -->
                        <div @onclick="() => ToggleGroup(groupId)" class="flex flex-col lg:flex-row lg:items-center justify-between p-5 lg:px-8 cursor-pointer hover:bg-[#faf9f5] transition select-none gap-4">
                            <div class="flex items-center gap-4 flex-1 min-w-0">
                                <div class="w-12 h-12 rounded-full @(firstItem.type == "IN" ? "bg-blue-50 border-blue-100 text-blue-600" : "bg-purple-50 border-purple-100 text-purple-600") border flex items-center justify-center shrink-0 shadow-sm">
                                    @if(firstItem.type == "IN") {
                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 4v16m0 0l-4-4m4 4l4-4"/></svg>
                                    } else {
                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 20V4m0 0l-4 4m4-4l4 4"/></svg>
                                    }
                                </div>
                                <div class="min-w-0">
                                    <div class="flex items-center gap-3 mb-1">
                                        <h3 class="font-syne font-bold text-[#1a1a1a] text-base">@(firstItem.type == "IN" ? "Penambahan Stok" : (string.IsNullOrEmpty(firstItem.event_name) ? "Pengeluaran Barang" : firstItem.event_name))</h3>
                                        <span class="px-2 py-0.5 rounded text-[10px] font-extrabold bg-[#f5f4f0] text-[#8a8780] border border-[#e5e3dc] whitespace-nowrap">@items.Count Items</span>
                                    </div>
                                    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-[#8a8880] font-medium">
                                        <div class="flex items-center gap-1.5">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                            @firstItem.created_at.ToString("dd MMM yyyy, HH:mm")
                                        </div>
                                        <div class="flex items-center gap-1.5">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0M12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                                            @(firstItem.Requester?.name ?? "System")
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="flex items-center justify-between lg:justify-end gap-4 shrink-0 border-t lg:border-t-0 pt-3 lg:pt-0 border-gray-100">
                                @if (firstItem.type == "OUT")
                                {
                                    <a href="/api/pdf/receipt/@groupId" target="_blank" @onclick:stopPropagation="true" class="inline-flex items-center gap-1.5 px-4 py-2 bg-white border border-[#e5e3dc] text-gray-700 hover:bg-[#faf9f5] rounded-lg text-xs font-bold transition shadow-sm active:scale-95">
                                        <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
                                        Struk PDF
                                    </a>
                                }
                                <div class="w-8 h-8 rounded-full flex items-center justify-center text-gray-400 hover:text-gray-600 hover:bg-[#f0ede5] transition">
                                    <svg class="w-5 h-5 transform transition-transform duration-200 @(isExpanded ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                                </div>
                            </div>
                        </div>

                        <!-- Body Content -->
                        @if (isExpanded)
                        {
                            <div class="border-t border-[#f0ede5] bg-[#faf9f5]">
                                @if (firstItem.type == "OUT")
                                {
                                    <div class="p-4 bg-white border-b border-[#e5e3dc] grid grid-cols-2 sm:grid-cols-4 gap-6 px-8">
                                        <div>
                                            <div class="text-[0.62rem] text-[#8a8880] font-bold uppercase tracking-wider mb-1">Nama Pemohon</div>
                                            <div class="text-sm font-bold text-[#1a1a1a]">@(firstItem.applicant_name ?? "-")</div>
                                            <div class="text-[10px] text-[#8a8880]">NRP: @(firstItem.applicant_nrp ?? "-")</div>
                                        </div>
                                        <div>
                                            <div class="text-[0.62rem] text-[#8a8880] font-bold uppercase tracking-wider mb-1">Divisi</div>
                                            <div class="text-sm font-bold text-[#1a1a1a]">@(firstItem.Division?.name ?? "-")</div>
                                        </div>
                                        <div>
                                            <div class="text-[0.62rem] text-[#8a8880] font-bold uppercase tracking-wider mb-1">Event / Keperluan</div>
                                            <div class="text-sm font-bold text-[#1a1a1a]">@(firstItem.event_name ?? "-")</div>
                                            <div class="text-[10px] text-[#8a8880]">@(firstItem.event_date?.ToString("dd MMM yyyy") ?? "-")</div>
                                        </div>
                                        <div>
                                            <div class="text-[0.62rem] text-[#8a8880] font-bold uppercase tracking-wider mb-1">Catatan</div>
                                            <div class="text-xs text-[#5a5855] italic truncate" title="@firstItem.notes">@(firstItem.notes ?? "-")</div>
                                        </div>
                                    </div>
                                }

                                <div class="overflow-x-auto">
                                    <table class="w-full text-left whitespace-nowrap">
                                        <thead class="text-gray-500 text-[0.62rem] uppercase tracking-wider border-b border-[#e5e3dc] bg-white/50">
                                            <tr>
                                                <th class="px-6 py-3 font-bold pl-8">Product Details</th>
                                                <th class="px-4 py-3 font-bold">Qty / Stok</th>
                                                <th class="px-4 py-3 font-bold">Type</th>
                                                <th class="px-4 py-3 font-bold">Reviewer</th>
                                                <th class="px-4 py-3 font-bold">Status</th>
                                                <th class="px-4 py-3 font-bold text-right pr-8">Return Info</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-[#f0ede5]">
                                            @foreach (var item in items)
                                            {
                                                <tr class="bg-white hover:bg-gray-50 transition-colors">
                                                    <td class="p-4 pl-8">
                                                        <div class="flex items-center gap-3">
                                                            <div class="w-10 h-10 rounded border border-[#e5e3dc] overflow-hidden shrink-0 bg-white">
                                                                <img src="@ImageHelper.ResolveProduct(item.Product, "/img/logo.svg")" class="w-full h-full object-cover">
                                                            </div>
                                                            <div>
                                                                <div class="text-xs font-bold text-[#1a1a1a]">@(item.Product?.name)</div>
                                                                <code class="text-[9px] text-[#8a8880] bg-[#f5f4f0] px-1.5 py-0.5 rounded">@(item.Product?.sku)</code>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td class="p-4">
                                                        <div class="text-sm font-bold text-[#1a1a1a]">@item.quantity</div>
                                                        <div class="text-[10px] text-[#8a8880]">Stock: @(item.Product?.current_stock)</div>
                                                    </td>
                                                    <td class="p-4">
                                                        @if (item.request_type == "BORROW") {
                                                            <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold bg-[#eef9f0] text-[#1a7a30] border border-[#b8e8c0]">BORROW</span>
                                                        } else if (item.request_type == "GIVEAWAY") {
                                                            <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold bg-[#e0f2fe] text-[#1a6b8a] border border-[#bae6fd]">GIVEAWAY</span>
                                                        } else {
                                                            <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold bg-blue-50 text-blue-600 border border-blue-100">STOCK IN</span>
                                                        }
                                                    </td>
                                                    <td class="p-4">
                                                        @if (item.Approver != null) {
                                                            <div class="text-xs font-bold text-[#1a1a1a]">@item.Approver.name</div>
                                                            <div class="text-[9px] text-[#8a8880]">@item.Approver.role</div>
                                                        } else { <span class="text-gray-300">-</span> }
                                                    </td>
                                                    <td class="p-4">
                                                        @if (item.status == "PENDING" || item.status == "PENDING_STAFF_INVENTORY" || item.status == "PENDING_ADMIN" || item.status == "PENDING_MANAGER") {
                                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-[#fef3c7] text-[#92400e] border border-[#fde68a]">WAITING</span>
                                                        } else if (item.status == "APPROVED" || item.status == "COMPLETED") {
                                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-[#eef9f0] text-[#1a7a30] border border-[#b8e8c0]">APPROVED</span>
                                                        } else if (item.status == "REVISION" || item.status == "REVISION_BY_STAFF_INVENTORY" || item.status == "REVISION_BY_ADMIN" || item.status == "REVISION_BY_MANAGER") {
                                                            <div class="flex flex-col gap-2">
                                                                <span class="w-max inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-[#e0f2fe] text-[#1a6b8a] border border-[#bae6fd]">REVISION</span>
                                                                <button @onclick="() => OpenRevisionModal(item)" class="text-[10px] font-bold bg-[#e8a000] text-[#1a1a1a] px-2.5 py-1 rounded shadow-sm hover:bg-[#d49300]">Revise Now</button>
                                                            </div>
                                                        } else {
                                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-[#fef0f0] text-[#d94040] border border-[#f8c0c0]">REJECTED</span>
                                                        }
                                                    </td>
                                                    <td class="p-4 text-right pr-8">
                                                        @if (item.request_type == "BORROW" && item.status == "APPROVED")
                                                        {
                                                            if (item.returned_quantity >= item.quantity) {
                                                                <span class="text-[10px] font-bold text-emerald-600">Full Returned</span>
                                                            } else {
                                                                <span class="text-[10px] font-bold text-amber-600">Pending Return</span>
                                                                <div class="text-[9px] text-[#8a8880]">@item.returned_quantity / @item.quantity</div>
                                                            }
                                                        }
                                                        else { <span class="text-gray-300">-</span> }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (TotalPages > 1)
            {
                <div class="mt-8 flex items-center justify-between bg-white px-6 py-4 rounded-xl border border-[#e5e3dc] shadow-sm">
                    <span class="text-xs font-bold text-[#8a8880]">Halaman <span class="text-[#1a1a1a]">@CurrentPage</span> dari @TotalPages</span>
                    <div class="flex gap-2">
                        <button disabled="@(CurrentPage == 1)" @onclick="() => LoadData(CurrentPage - 1)" class="w-10 h-10 flex items-center justify-center rounded-lg border border-[#e5e3dc] hover:bg-[#faf9f5] transition disabled:opacity-30">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                        </button>
                        <button disabled="@(CurrentPage == TotalPages)" @onclick="() => LoadData(CurrentPage + 1)" class="w-10 h-10 flex items-center justify-center rounded-lg border border-[#e5e3dc] hover:bg-[#faf9f5] transition disabled:opacity-30">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                        </button>
                    </div>
                </div>
            }
        }
    </div>
</div>

@if (ShowRevisionModal && RevisionItem != null)
{
    <div class="fixed inset-0 z-[200] flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm" @onclick="CloseRevisionModal">
        <div class="bg-white rounded-2xl w-full max-w-xl shadow-2xl overflow-hidden" @onclick:stopPropagation="true">
            <div class="p-6 border-b border-[#e5e3dc] flex justify-between items-center bg-[#faf9f5]">
                <h3 class="font-syne text-lg font-bold text-[#1a1a1a]">Revisi Permintaan</h3>
                <button type="button" @onclick="CloseRevisionModal" class="text-gray-400 hover:text-gray-600 transition">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
            
            <div class="p-6 max-h-[70vh] overflow-y-auto space-y-5">
                <div class="p-4 bg-[#fffbeb] border border-[#fde68a] text-[#92400e] text-xs rounded-xl flex items-start gap-3">
                    <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                    <div>
                        <div class="font-bold">Alasan Revisi dari Admin:</div>
                        <div class="mt-1 italic">"@RevisionItem.rejection_reason"</div>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Nama Pemohon</label>
                        <input type="text" @bind="RevisionModel.applicant_name" class="w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] border border-[#e5e3dc] rounded-lg outline-none focus:border-[#e8a000]" />
                    </div>
                    <div>
                        <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">NRP</label>
                        <input type="text" @bind="RevisionModel.applicant_nrp" class="w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] border border-[#e5e3dc] rounded-lg outline-none focus:border-[#e8a000]" />
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Kuantitas</label>
                        <input type="number" @bind="RevisionModel.quantity" class="w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] border border-[#e5e3dc] rounded-lg outline-none focus:border-[#e8a000]" />
                    </div>
                    <div>
                        <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Division</label>
                        <select @bind="RevisionModel.division_id" class="w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] border border-[#e5e3dc] rounded-lg outline-none focus:border-[#e8a000]">
                            <option value="">Select Division</option>
                            @foreach(var div in Divisions) { <option value="@div.id">@div.name</option> }
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Event / Program</label>
                    <input type="text" @bind="RevisionModel.event_name" class="w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] border border-[#e5e3dc] rounded-lg outline-none focus:border-[#e8a000]" />
                </div>
            </div>

            <div class="p-6 border-t border-[#e5e3dc] bg-white flex justify-end gap-3">
                <button type="button" @onclick="CloseRevisionModal" class="px-5 py-2.5 text-sm font-bold text-gray-600 hover:text-gray-900 bg-white border border-[#e5e3dc] rounded-xl transition">Batal</button>
                <button type="button" @onclick="SubmitRevision" class="px-6 py-2.5 bg-[#e8a000] hover:bg-[#d49300] active:scale-[0.98] text-[#1a1a1a] text-sm font-bold tracking-wider rounded-xl transition shadow-sm">Kirim Perbaikan</button>
            </div>
        </div>
    </div>
}

@code {
    private List<Transaction>? Transactions;
    private Dictionary<string, List<Transaction>> GroupedTransactions = new();
    private HashSet<string> ExpandedGroups = new();
    private List<Division> Divisions = new();
    
    private int CurrentPage = 1;
    private int PageSize = 10;
    private int TotalPages = 1;
    private int TotalItems = 0;
    
    private string? FilterType;
    private string? FilterRequestType;
    private string? FilterIsReturnedStr;
    private DateTime? StartDate;
    private DateTime? EndDate;

    private int CurrentUserId = 0;
    private string? UserRole;
    
    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }

    private bool ShowRevisionModal = false;
    private Transaction? RevisionItem;
    private UT_WMSDotnet.ViewModels.TransactionRequestViewModel RevisionModel = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            if (int.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out int id))
                CurrentUserId = id;
            UserRole = user.FindFirst(ClaimTypes.Role)?.Value;
        }

        Divisions = await DivisionService.GetAllDivisionsAsync();
        await LoadData(1);
    }

    private bool IsLoading = false;

    private async Task LoadData(int page)
    {
        if (IsLoading) return;
        IsLoading = true;
        try 
        {
            CurrentPage = page;
        bool? isReturnedBool = FilterIsReturnedStr == "true" ? true : (FilterIsReturnedStr == "false" ? false : null);
        
        var result = await TransactionService.GetHistoryAsync(
            CurrentUserId, UserRole, FilterType, StartDate, EndDate, CurrentPage, PageSize, FilterRequestType, isReturnedBool);
        
        Transactions = result.Transactions;
        TotalItems = result.TotalItems;
        TotalPages = result.TotalPages;

        if (Transactions != null)
        {
            GroupedTransactions = Transactions
                .GroupBy(t => t.type == "OUT" ? TransactionService.CreateGroupId(t.created_at, t.requester_id, t.applicant_name ?? string.Empty) : t.id.ToString())
                .ToDictionary(g => g.Key, g => g.ToList());
        }
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void ToggleGroup(string groupId)
    {
        if (ExpandedGroups.Contains(groupId))
            ExpandedGroups.Remove(groupId);
        else
            ExpandedGroups.Add(groupId);
    }
    
    private async Task ResetFilters()
    {
        FilterType = null;
        FilterRequestType = null;
        FilterIsReturnedStr = null;
        StartDate = null;
        EndDate = null;
        await LoadData(1);
    }

    private async Task OnFilterTypeChanged()
    {
        if (FilterType != "OUT")
        {
            FilterRequestType = null;
            FilterIsReturnedStr = null;
        }
        await Task.CompletedTask;
    }

    private async Task OnFilterRequestTypeChanged()
    {
        if (FilterRequestType != "BORROW")
        {
            FilterIsReturnedStr = null;
        }
        await Task.CompletedTask;
    }

    private void OpenRevisionModal(Transaction item)
    {
        RevisionItem = item;
        RevisionModel = new UT_WMSDotnet.ViewModels.TransactionRequestViewModel
        {
            applicant_name = item.applicant_name,
            applicant_nrp = item.applicant_nrp,
            event_name = item.event_name,
            event_date = item.event_date,
            quantity = item.quantity,
            request_type = item.request_type,
            division_id = item.division_id,
            documentation_link = item.documentation_link,
            notes = item.notes
        };
        ShowRevisionModal = true;
    }

    private void CloseRevisionModal()
    {
        ShowRevisionModal = false;
        RevisionItem = null;
    }

    private async Task SubmitRevision()
    {
        if (RevisionItem == null) return;
        
        var error = await TransactionService.UpdateRevisionAsync(RevisionItem.id, RevisionModel);
        if (error != null) ErrorMessage = error;
        else
        {
            SuccessMessage = "Revision submitted successfully.";
            await LoadData(CurrentPage);
            CloseRevisionModal();
        }
    }
}
