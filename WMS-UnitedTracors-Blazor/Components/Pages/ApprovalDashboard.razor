    private async Task SubmitApprovalHandoverDraft()
    {
        if (!ApprovalHandoverItems.Any())
        {
            HandoverDraftError = "Tidak ada item serah terima yang bisa diproses.";
            return;
        }

        if (!ApprovalHandoverFiles.Any())
        {
            HandoverDraftError = "Minimal satu file bukti serah terima wajib diunggah.";
            return;
        }

        if (IsProcessing) return;
        IsProcessing = true;
        HandoverDraftError = "";
        ErrorMessage = null;
        SuccessMessage = null;

        try
        {
            var err = await TransactionService.ConfirmHandoverAsync(
                ApprovalHandoverItems.Select(i => i.id).ToList(),
                ApprovalHandoverFiles,
                ApprovalHandoverNotes,
                "SI",
                ApprovalHandoverRecipientName,
                ApprovalHandoverTimestampInput);

            if (err == null)
            {
                SuccessMessage = "Draft serah terima berhasil disimpan dari tab Serah Terima.";
                CloseApprovalHandoverModal();
                await LoadData();
            }
            else
            {
                HandoverDraftError = err;
            }
        }
        catch (Exception ex)
        {
            HandoverDraftError = "Terjadi kesalahan saat menyimpan draft serah terima: " + ex.Message;
        }
        finally
        {
            IsProcessing = false;
        }
    }

