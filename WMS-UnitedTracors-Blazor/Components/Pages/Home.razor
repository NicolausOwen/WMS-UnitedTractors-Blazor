}

@* Floating Cart Button *@
@if(UserRole == "superadmin" || UserRole == "admin" || UserRole == "staff") {
<button type="button" @onclick='() => ShowCartModal = true' class="fixed bottom-24 sm:bottom-8 right-8 z-50 flex items-center justify-center w-[3.5rem] h-[3.5rem] bg-[#e8a000] hover:bg-[#d49300] active:scale-[0.95] rounded-full shadow-2xl transition-transform border-4 border-white" title="View Cart">
    <svg class="w-7 h-7 text-[#1a1a1a]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
    @if(CartService.Items.Any()) {
        <span id="cartBadge" class="absolute -top-1.5 -right-1.5 inline-flex items-center justify-center min-w-[1.4rem] h-[1.4rem] px-1 bg-[#d94040] text-white text-[0.7rem] font-bold rounded-full shadow-sm border-2 border-white">@CartService.Items.Sum(i => i.Quantity)</span>
    }
</button>
}

@if (ShowCartModal)
{
    <div id="borrowModal" class="fixed inset-0 z-[60] flex" role="dialog" aria-modal="true">
        <div class="fixed inset-0 backdrop-blur-sm transition-opacity bg-[#1a1a1a]/65" @onclick="() => ShowCartModal = false"></div>
        <div class="fixed inset-0 z-10 overflow-y-auto" @onclick="() => ShowCartModal = false">
            <div class="flex min-h-full items-center justify-center p-4 text-center sm:p-0">
