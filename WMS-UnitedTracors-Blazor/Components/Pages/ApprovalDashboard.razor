    private async Task ConfirmHandoverReject()
    {
        if (string.IsNullOrWhiteSpace(HandoverRejectReason))
        {
            HandoverRejectionError = true;
            return;
        }

        if (IsProcessing) return;
        IsProcessing = true;
        try
        {
            string? err;
            if (HandoverRejectTransactionId.HasValue)
            {
                err = await ApprovalService.RejectHandoverItemAsync(HandoverRejectTransactionId.Value, HandoverRejectReason, CurrentUserId, UserRole);
            }
            else
            {
                err = await ApprovalService.RejectHandoverBatchAsync(HandoverRejectGroupId, HandoverRejectReason, CurrentUserId, UserRole);
            }
            if (err == null)
            {
                SuccessMessage = "Handover rejected successfully.";
                CloseHandoverRejectModal();
                await LoadData();
            }
            else ErrorMessage = err;
        }
        catch (Exception ex)
        {
            ErrorMessage = "Terjadi kesalahan saat menolak serah terima: " + ex.Message;
        }
        finally
        {
            IsProcessing = false;
        }
    }

