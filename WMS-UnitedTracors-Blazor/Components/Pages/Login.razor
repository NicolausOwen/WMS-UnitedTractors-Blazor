@page "/login"
@layout Layout.AuthLayout
@attribute [AllowAnonymous]

<PageTitle>UT WMS - Login</PageTitle>

<div class="auth-header mb-6">
    <h2 class="auth-title">Welcome Back</h2>
    <p class="auth-subtitle">United Tractors Inventory System</p>
</div>

<!-- Error messages -->
@if (IsError)
{
    <div class="mb-4 p-3 text-xs font-semibold text-[#d94040] bg-[#fef0f0] border border-[#f8c0c0] rounded-lg text-center">
        Email atau password salah.
    </div>
}
@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="mb-4 p-3 text-xs font-semibold text-[#d94040] bg-[#fef0f0] border border-[#f8c0c0] rounded-lg text-center">
        @errorMessage
    </div>
}

<form method="POST" action="/api/auth/login">
    <AntiforgeryToken />

    <!-- Email Address -->
    <div class="mb-4">
        <label for="email" class="ut-label">Email</label>
        <input id="email" class="ut-input" type="email" name="email" required autofocus autocomplete="username" />
    </div>

    <!-- Password -->
    <div class="mb-4">
        <div class="flex items-center justify-between">
            <label for="password" class="ut-label">Password</label>
            <a class="auth-link text-xs mb-2" href="/forgot-password">
                Forgot password?
            </a>
        </div>
        <div class="relative">
            <input id="password" class="ut-input pr-10"
                            type="password"
                            name="password"
                            required autocomplete="current-password" />
            <button type="button" id="togglePassword" class="absolute right-3 top-1/2 -translate-y-1/2 flex items-center cursor-pointer">
                <svg id="eyeIcon" class="h-5 w-5 text-gray-500" fill="none" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
                <svg id="eyeSlashIcon" class="h-5 w-5 text-gray-500 hidden" fill="none" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
                </svg>
            </button>
        </div>
    </div>

    <!-- Remember Me -->
    <div class="block mb-5">
        <label for="remember_me" class="inline-flex items-center cursor-pointer">
            <input id="remember_me" type="checkbox" class="rounded border-[#e5e3dc] text-[#e8a000] shadow-sm focus:ring-[#e8a000] w-4 h-4" name="remember_me" value="true">
            <span class="ms-3 text-sm text-[#8a8880]">Keep me signed in</span>
        </label>
    </div>

    <div class="mt-6 flex flex-col gap-3">
        <button type="submit" class="btn-ut-primary">
            Log in
        </button>

        <a href="/auth/microsoft" class="w-full flex items-center justify-center gap-3 px-4 py-2.5 bg-white border border-gray-300 rounded-[10px] text-sm font-bold text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-200 transition-all duration-200 no-underline">
            <svg class="w-4 h-4" viewBox="0 0 21 21" xmlns="http://www.w3.org/2000/svg">
                <path fill="#f25022" d="M10 0H0v10h10V0z"/>
                <path fill="#7fba00" d="M21 0H11v10h10V0z"/>
                <path fill="#00a4ef" d="M10 11H0v10h10V11z"/>
                <path fill="#ffb900" d="M21 11H11v10h10V11z"/>
            </svg>
            Sign in with Microsoft
        </a>
    </div>
</form>

<script>
    (function() {
        var togglePassword = document.getElementById('togglePassword');
        var password = document.getElementById('password');
        var eyeIcon = document.getElementById('eyeIcon');
        var eyeSlashIcon = document.getElementById('eyeSlashIcon');

        if (togglePassword) {
            togglePassword.addEventListener('click', function (e) {
                e.preventDefault();
                var type = password.getAttribute('type') === 'password' ? 'text' : 'password';
                password.setAttribute('type', type);
                eyeIcon.classList.toggle('hidden');
                eyeSlashIcon.classList.toggle('hidden');
            });
        }
    })();
</script>

@code {
    [SupplyParameterFromQuery]
    private string? error { get; set; }

    [SupplyParameterFromQuery]
    private string? errorMessage { get; set; }

    private bool IsError => error == "1";
}
