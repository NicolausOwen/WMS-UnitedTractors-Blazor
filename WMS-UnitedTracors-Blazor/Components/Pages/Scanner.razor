@page "/scan"
@page "/Scanner"
@using Microsoft.AspNetCore.Components.Authorization
@using UT_WMSDotnet.Models
@using WMS_UnitedTracors_Blazor.Services
@inject NavigationManager NavigationManager
@inject TransactionService TransactionService
@inject DivisionService DivisionService
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>WMS - Scan Barcode</PageTitle>

<div class="w-full min-h-screen px-4 md:px-10 py-6 pb-24 md:pb-12 font-sans">
    @* Tombol Back *@
    <button @onclick="GoBack" class="inline-flex items-center gap-2 px-4 py-2 border border-[#e5e3dc] hover:border-black rounded-lg text-xs font-semibold text-[#1a1a1a] hover:bg-black hover:text-white transition cursor-pointer mb-6 bg-white">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Kembali
    </button>

    @* Page Header *@
    <div class="mb-8">
        <h1 class="text-[1.6rem] font-bold text-[#1a1a1a] leading-none tracking-tight">Scan <span class="text-[#e8a000]">Barcode</span></h1>
        <div class="text-[0.72rem] font-medium text-[#a09e99] mt-1">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</div>
    </div>

    @if (!string.IsNullOrEmpty(SuccessMessage))
    {
        <div class="flex items-center gap-2.5 bg-[#eef9f0] border border-[#b8e8c0] text-[#1a7a30] px-4 py-2.5 rounded-lg text-[0.82rem] mb-6 font-semibold">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            @SuccessMessage
        </div>
    }
    
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="flex items-center gap-2.5 bg-[#fef0f0] border border-[#f8c0c0] text-[#c0392b] px-4 py-2.5 rounded-lg text-[0.82rem] mb-6 font-semibold">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            @ErrorMessage
        </div>
    }

    @* Camera Scanner Card *@
    <div class="bg-white border border-[#eae8e1] rounded-2xl overflow-hidden shadow-[0_1px_3px_rgba(0,0,0,0.08),0_2px_6px_rgba(0,0,0,0.06)] mb-6">
        <div class="px-6 py-4 border-b border-[#f0ede5]">
            <h2 class="text-[0.95rem] font-bold text-[#1a1a1a] tracking-tight">Scan Barcode</h2>
            <p class="text-[0.72rem] text-[#a09e99] mt-0.5">Arahkan kamera ke barcode produk</p>
        </div>

        <div class="p-4">
            <div class="relative bg-[#1a1a1a] w-full max-w-[500px] mx-auto rounded-xl overflow-hidden aspect-[16/9] md:aspect-[16/9]">
                <video id="video" autoplay muted playsinline class="absolute inset-0 w-full h-full object-cover"></video>

                <div class="absolute inset-0 flex flex-col items-center justify-center gap-2 bg-[#1a1a1a] z-10" id="cameraIdle">
                    <svg class="w-12 h-12 stroke-[#8a8780] stroke-[1.5] fill-none" viewBox="0 0 24 24">
                        <path d="M3 9V6a1 1 0 011-1h3M3 15v3a1 1 0 001 1h3M21 9V6a1 1 0 00-1-1h-3M21 15v3a1 1 0 01-1 1h-3M8 12h8"/>
                    </svg>
                    <p class="text-[0.75rem] text-[#8a8780]">Kamera belum aktif</p>
                </div>

                <div class="absolute inset-0 flex items-center justify-center pointer-events-none z-20" id="scanOverlay" style="display:none;">
                    <div class="relative w-[72%] h-[52%]">
                        @* Corners *@
                        <div class="absolute top-0 left-0 w-5 h-5 border-t-[2.5px] border-l-[2.5px] border-[#e8a000] rounded-tl-[3px]"></div>
                        <div class="absolute top-0 right-0 w-5 h-5 border-t-[2.5px] border-r-[2.5px] border-[#e8a000] rounded-tr-[3px]"></div>
                        <div class="absolute bottom-0 left-0 w-5 h-5 border-b-[2.5px] border-l-[2.5px] border-[#e8a000] rounded-bl-[3px]"></div>
                        <div class="absolute bottom-0 right-0 w-5 h-5 border-b-[2.5px] border-r-[2.5px] border-[#e8a000] rounded-br-[3px]"></div>
                        
                        @* Scan Animated Line *@
                        <div class="scan-line border-b border-red-500 absolute w-full top-1/2 shadow-[0_0_8px_red]"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="px-4 pb-4">
            <button id="startButton" class="w-full py-3 text-[0.82rem] font-bold tracking-wide bg-[#e8a000] hover:bg-[#d49300] active:scale-[0.98] text-[#1a1a1a] rounded-lg transition-all duration-150 cursor-pointer">
                <span class="inline-flex items-center gap-2 justify-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.069A1 1 0 0121 8.882V15.118a1 1 0 01-1.447.91L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                    Mulai Kamera
                </span>
            </button>
            <button id="resetButton" class="w-full py-3 text-[0.82rem] font-bold tracking-wide bg-[#1a1a1a] hover:bg-[#333] active:scale-[0.98] text-white rounded-lg transition-all duration-150 cursor-pointer" style="display:none;">
                <span class="inline-flex items-center gap-2 justify-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-6.219-8.56"/></svg>
                    Stop Kamera
                </span>
            </button>
        </div>
    </div>

    @* Transaction Form Card *@
    <div class="bg-white border border-[#eae8e1] rounded-2xl overflow-hidden shadow-[0_1px_3px_rgba(0,0,0,0.08),0_2px_6px_rgba(0,0,0,0.06)]">
        <div class="px-6 py-4 border-b border-[#f0ede5]">
            <div class="flex items-center justify-between">
                <h2 class="text-[0.95rem] font-bold text-[#1a1a1a] tracking-tight">Detail Transaksi</h2>
                <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-[#eef9f0] border border-[#b8e8c0] text-[#1a7a30] text-[0.62rem] font-bold rounded-full ml-2 animate-fade-in" id="scannedBadge" style="display:none;">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                    Barcode terbaca
                </span>
            </div>
        </div>

        <div class="p-5">
            <EditForm Model="Model" OnValidSubmit="HandleSubmit" id="transactionForm">
                @* Type *@
                <div class="mb-4">
                    <label class="block text-[0.6rem] font-bold tracking-wider uppercase text-[#a09e99] mb-1.5">Tipe Transaksi</label>
                    <InputSelect @bind-Value="Model.Type" required class="w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none text-[#1a1a1a] transition-colors duration-150 cursor-pointer">
                        <option value="IN">STOCK IN</option>
                        <option value="OUT">STOCK OUT</option>
                    </InputSelect>
                </div>

                <!-- Dynamic Items Section -->
                <div class="bg-[#faf9f5] border border-[#e5e3dc] rounded-xl p-4 mb-4">
                    <div class="flex items-center gap-1.5 text-[0.6rem] font-bold tracking-wider uppercase text-[#e8a000] mb-3.5 after:content-[''] after:flex-1 after:h-[1px] after:bg-[#e5e3dc]">Items to Process</div>
                    <div id="itemsContainer" class="flex flex-col gap-3">
                        @for (int i = 0; i < Model.Items.Count; i++)
                        {
                            var index = i;
                            <div class="item-row flex gap-2.5 items-start">
                                <div class="flex-1">
                                    <InputText @bind-Value="Model.Items[index].Sku" id="@($"sku-input-{index}")" class="w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none text-[#1a1a1a] transition-colors duration-150 font-mono sku-input" required placeholder="Scan/ketik SKU" />
                                </div>
                                <div class="w-[100px]">
                                    <InputNumber @bind-Value="Model.Items[index].Quantity" class="w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none text-[#1a1a1a] transition-colors duration-150 text-center qty-input" min="1" required placeholder="Qty" />
                                </div>
                                @if (Model.Items.Count > 1)
                                {
                                    <button type="button" class="p-2 text-[#d94040] hover:bg-[#fef0f0] rounded-lg transition-colors cursor-pointer remove-btn" @onclick="() => RemoveItemRow(index)">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                    <button type="button" class="inline-flex items-center gap-1 text-[0.72rem] text-[#e8a000] hover:text-[#c98d00] font-bold bg-transparent border-none cursor-pointer mt-3.5 transition-colors" @onclick="AddItemRow">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                        Tambah Barang Lain
                    </button>
                </div>

                @* Notes *@
                <div class="mb-4">
                    <label class="block text-[0.6rem] font-bold tracking-wider uppercase text-[#a09e99] mb-1.5">Catatan <span class="text-[#b0ada8] font-normal normal-case tracking-normal">(opsional)</span></label>
                    <InputText @bind-Value="Model.Notes" placeholder="Misal: Ref Supplier / Work Order" class="w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none text-[#1a1a1a] transition-colors duration-150" />
                </div>

                @* Usage Fields (STOCK OUT) *@
                @if (Model.Type == "OUT")
                {
                    <div id="usageFields">
                        <div class="bg-[#faf9f5] border border-[#e5e3dc] rounded-xl p-4 mb-4">
                            <div class="flex items-center gap-1.5 text-[0.6rem] font-bold tracking-wider uppercase text-[#e8a000] mb-3.5 after:content-[''] after:flex-1 after:h-[1px] after:bg-[#e5e3dc]">Informasi Peminjaman</div>

                            <div class="mb-4">
                                <label class="block text-[0.6rem] font-bold tracking-wider uppercase text-[#a09e99] mb-1.5">Nama Pemohon <span class="text-[#d94040]">*</span></label>
                                <InputText @bind-Value="Model.ApplicantName" placeholder="Nama lengkap" class="w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none text-[#1a1a1a] transition-colors duration-150" required />
                            </div>

                            <div class="mb-4">
                                <label class="block text-[0.6rem] font-bold tracking-wider uppercase text-[#a09e99] mb-1.5">NRP Pemohon <span class="text-[#d94040]">*</span></label>
                                <InputText @bind-Value="Model.ApplicantNrp" placeholder="Nomor NRP" class="w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none text-[#1a1a1a] transition-colors duration-150 font-mono" required />
                            </div>

                            <div class="mb-4">
                                <label class="block text-[0.6rem] font-bold tracking-wider uppercase text-[#a09e99] mb-1.5">Event / Program <span class="text-[#d94040]">*</span></label>
                                <InputText @bind-Value="Model.EventName" placeholder="Nama event atau program" class="w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none text-[#1a1a1a] transition-colors duration-150" required />
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">
                                <div>
                                    <label class="block text-[0.6rem] font-bold tracking-wider uppercase text-[#a09e99] mb-1.5">Tanggal Event <span class="text-[#d94040]">*</span></label>
                                    <InputDate @bind-Value="Model.EventDate" min="@TodayDateString" class="w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none text-[#1a1a1a] transition-colors duration-150" required />
                                </div>
                                <div>
                                    <label class="block text-[0.6rem] font-bold tracking-wider uppercase text-[#a09e99] mb-1.5">Division <span class="text-[#d94040]">*</span></label>
                                    <InputSelect @bind-Value="Model.DivisionId" class="w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none text-[#1a1a1a] transition-colors duration-150 cursor-pointer" required>
                                        <option value="">Pilih divisi</option>
                                        @if (Divisions != null)
                                        {
                                            foreach (var div in Divisions)
                                            {
                                                <option value="@div.id">@div.name</option>
                                            }
                                        }
                                    </InputSelect>
                                </div>
                            </div>

                            <div class="mb-0">
                                <label class="block text-[0.6rem] font-bold tracking-wider uppercase text-[#a09e99] mb-1.5">Dokumentasi (GDrive Link) <span class="text-[#d94040]">*</span></label>
                                <InputText @bind-Value="Model.DocumentationLink" placeholder="https://drive.google.com/..." class="w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none text-[#1a1a1a] transition-colors duration-150" required />
                            </div>
                        </div>
                    </div>
                }

                <button type="submit" class="w-full py-3.5 bg-[#e8a000] hover:bg-[#d49300] active:scale-[0.98] text-[#1a1a1a] text-sm font-bold tracking-wider rounded-xl transition-all duration-100 cursor-pointer mt-2 disabled:opacity-70" disabled="@IsSubmitting">
                    @if(IsSubmitting) {
                        <span class="animate-spin inline-block w-4 h-4 border-2 border-[#1a1a1a] border-t-transparent rounded-full mr-2 align-middle"></span>
                    }
                    Submit Request
                </button>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private UT_WMSDotnet.ViewModels.ScannerTransactionViewModel Model = new() { Type = "IN", Items = new List<UT_WMSDotnet.ViewModels.ScannerItemViewModel> { new UT_WMSDotnet.ViewModels.ScannerItemViewModel { Quantity = 1 } } };
    private List<Division>? Divisions;
    private string? SuccessMessage;
    private string? ErrorMessage;
    private bool IsSubmitting = false;
    private string TodayDateString => DateTime.Today.ToString("yyyy-MM-dd");

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity == null || !user.Identity.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        
        if (!user.HasPermission(WMS_UnitedTracors_Blazor.Helpers.Permissions.ScannerUse))
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        Divisions = await DivisionService.GetAllDivisionsAsync();
    }

    private DotNetObjectReference<Scanner>? _objRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _objRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("initScannerIndex", _objRef);
        }
    }

    public void Dispose()
    {
        _objRef?.Dispose();
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/");
    }

    private void AddItemRow()
    {
        Model.Items.Add(new UT_WMSDotnet.ViewModels.ScannerItemViewModel { Quantity = 1 });
    }

    private void RemoveItemRow(int index)
    {
        if (Model.Items.Count > 1)
        {
            Model.Items.RemoveAt(index);
        }
    }

    [JSInvokable]
    public void SetScannedSku(string sku)
    {
        var emptyItem = Model.Items.FirstOrDefault(i => string.IsNullOrEmpty(i.Sku));
        if (emptyItem != null)
        {
            emptyItem.Sku = sku;
        }
        else
        {
            Model.Items.Add(new UT_WMSDotnet.ViewModels.ScannerItemViewModel { Sku = sku, Quantity = 1 });
        }
        StateHasChanged();
    }

    private async Task HandleSubmit()
    {
        IsSubmitting = true;
        ErrorMessage = null;
        SuccessMessage = null;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var idClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
        int userId = int.Parse(idClaim?.Value ?? "0");

        try
        {
            await TransactionService.ProcessScannerTransactionAsync(Model, userId);
            SuccessMessage = "Transaksi berhasil diproses!";
            Model = new() { Type = "IN", Items = new List<UT_WMSDotnet.ViewModels.ScannerItemViewModel> { new UT_WMSDotnet.ViewModels.ScannerItemViewModel { Quantity = 1 } } };
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }

        IsSubmitting = false;
    }
}
