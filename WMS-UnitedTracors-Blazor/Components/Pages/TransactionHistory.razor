@page "/TransactionHistory"
@page "/Transactions/History"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using UT_WMSDotnet.Models
@using WMS_UnitedTracors_Blazor.Services
@inject TransactionService TransactionService
@inject DivisionService DivisionService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject DashboardStateService DashboardState
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>WMS - Transaction History</PageTitle>

<div class="py-8 md:py-12 min-h-screen font-sans">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="mb-6">
            <h1 class="text-[1.6rem] font-bold text-[#1a1a1a] leading-none tracking-tight">Riwayat <span class="text-[#e8a000]">Transaksi</span></h1>
            <div class="text-[0.72rem] font-medium text-[#a09e99] mt-1">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</div>
        </div>

        <div class="bg-white rounded-xl border border-[#e5e3dc] overflow-hidden shadow-sm mb-8">
            @* Collapsible Header *@
            <div @onclick="ToggleFilters" 
                 role="button"
                 tabindex="0"
                 class="@(ShowFilters ? "border-b border-[#e5e3dc]" : "") px-5 py-3.5 bg-[#faf9f5] flex items-center justify-between cursor-pointer select-none hover:bg-[#f3f2eb] transition duration-150 group outline-none focus:bg-[#f3f2eb]">
                <div class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-[#8a8880] group-hover:text-gray-700 transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 0 1-.659 1.591l-5.432 5.432a2.25 2.25 0 0 0-.659 1.591v2.927a2.25 2.25 0 0 1-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 0 0-.659-1.591L3.659 7.409A2.25 2.25 0 0 1 3 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0 1 12 3Z"/>
                    </svg>
                    <span class="text-[0.68rem] font-extrabold text-[#5a5855] group-hover:text-gray-900 tracking-wider uppercase transition">Filter Pencarian</span>
                    @if(HasActiveFilters)
                    {
                        <span class="px-2 py-0.5 rounded text-[9px] font-extrabold bg-[#fff8e6] text-[#b37a00] border border-[#ffe099] uppercase tracking-wider">
                            Aktif: @GetActiveFiltersText()
                        </span>
                    }
                </div>
                <div class="text-[#8a8880] group-hover:text-gray-700 transition">
                    <svg class="w-4 h-4 transition-transform duration-200 @(!ShowFilters ? "rotate-180" : "")" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
                    </svg>
                </div>
            </div>

            @* Collapsible Content *@
            @if (ShowFilters)
            {
                <div class="px-6 py-5 bg-white transition-all duration-200 space-y-5">
                    <!-- Section: Quick Filter / Tipe Transaksi -->
                    <div>
                        <span class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-2">Tipe Transaksi (Quick Filter)</span>
                        <div class="flex flex-wrap items-center gap-2">
                            <button type="button" @onclick='() => SetQuickFilter(null, null)' 
                                    class='px-4 py-2 text-xs font-bold rounded-lg transition-all cursor-pointer border flex items-center gap-2 @(FilterType == null && FilterRequestType == null ? "bg-[#e8a000] text-[#1a1a1a] border-[#e8a000]" : "bg-white text-[#5a5855] border-[#e5e3dc] hover:bg-[#faf9f5]")'>
                                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" /></svg>
                                Semua Transaksi
                            </button>
                            <button type="button" @onclick='() => SetQuickFilter("OUT", "GIVEAWAY")' 
                                    class='px-4 py-2 text-xs font-bold rounded-lg transition-all cursor-pointer flex items-center gap-2 border @(FilterType == "OUT" && FilterRequestType == "GIVEAWAY" ? "bg-[#eef9f0] text-[#1a7a30] border-[#b8e8c0]" : "bg-white text-[#5a5855] border-[#e5e3dc] hover:bg-[#faf9f5]")'>
                                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 11.25v8.25a1.5 1.5 0 0 1-1.5 1.5H5.25a1.5 1.5 0 0 1-1.5-1.5v-8.25M12 4.875A2.625 2.625 0 1 0 9.375 7.5H12m0-2.625A2.625 2.625 0 1 1 14.625 7.5H12m0-2.625V7.5m-9 0h18M12 7.5v13.5" /></svg>
                                Giveaway
                            </button>
                            <button type="button" @onclick='() => SetQuickFilter("OUT", "BORROW")' 
                                    class='px-4 py-2 text-xs font-bold rounded-lg transition-all cursor-pointer flex items-center gap-2 border @(FilterType == "OUT" && FilterRequestType == "BORROW" ? "bg-[#eef6fd] text-[#1a6b8a] border-[#d9e6f3]" : "bg-white text-[#5a5855] border-[#e5e3dc] hover:bg-[#faf9f5]")'>
                                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12c0-1.232-.046-2.453-.138-3.662a4.006 4.006 0 0 0-3.7-3.7 48.656 48.656 0 0 0-7.324 0 4.006 4.006 0 0 0-3.7 3.7C4.547 9.547 4.5 10.768 4.5 12s.047 2.453.138 3.662a4.006 4.006 0 0 0 3.7 3.7 48.656 48.656 0 0 0 7.324 0 4.006 4.006 0 0 0 3.7-3.7c.092-1.209.138-2.43.138-3.662Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M9 10.5h6M9 13.5h6" /></svg>
                                Borrow
                            </button>
                            <button type="button" @onclick='() => SetQuickFilter("OUT", null)' 
                                    class='px-4 py-2 text-xs font-bold rounded-lg transition-all cursor-pointer flex items-center gap-2 border @(FilterType == "OUT" && FilterRequestType == null ? "bg-[#fff8e6] text-[#b37a00] border-[#ffe099]" : "bg-white text-[#5a5855] border-[#e5e3dc] hover:bg-[#faf9f5]")'>
                                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" /></svg>
                                Giveaway & Borrow
                            </button>
                            @if (UserRole != null && !IsStaffOrUser)
                            {
                                <button type="button" @onclick='() => SetQuickFilter("IN", null)' 
                                        class='px-4 py-2 text-xs font-bold rounded-lg transition-all cursor-pointer flex items-center gap-2 border @(FilterType == "IN" ? "bg-[#f5f4f0] text-gray-700 border-[#e5e3dc]" : "bg-white text-[#5a5855] border-[#e5e3dc] hover:bg-[#faf9f5]")'>
                                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 3.75H6.912a2.25 2.25 0 0 0-2.15 1.588L2.35 13.177a2.25 2.25 0 0 0-.1.661V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H15M9 3.75h6M9 3.75v3.75m6-3.75v3.75M9 7.5h6" /></svg>
                                    Stock In
                                </button>
                            }
                        </div>
                    </div>

                    <!-- Divider -->
                    <div class="border-t border-[#f0ede5]"></div>

                    <!-- Section: Detail Filters (Dates) -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="flex flex-col">
                            <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Start Date</label>
                            <input type="date" @bind="StartDate" class="block w-full px-3 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none transition-colors duration-150 text-[#1a1a1a]">
                        </div>
                        <div class="flex flex-col">
                            <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">End Date</label>
                            <input type="date" @bind="EndDate" class="block w-full px-3 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none transition-colors duration-150 text-[#1a1a1a]">
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="flex items-center justify-end gap-3 pt-2">
                        <button type="button" @onclick="ResetFilters" class="px-5 py-2.5 bg-white border border-[#e5e3dc] text-[#3a3835] text-xs font-bold rounded-lg cursor-pointer hover:bg-gray-50 transition active:scale-95 shadow-sm flex items-center gap-1.5">
                            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" /></svg>
                            Reset Filters
                        </button>
                        <button type="button" @onclick="() => LoadData(1)" class="px-6 py-2.5 bg-[#e8a000] text-[#1a1a1a] text-xs font-bold rounded-lg transition active:scale-95 cursor-pointer whitespace-nowrap hover:bg-[#d49300] shadow-sm flex items-center gap-1.5">
                            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 0 1-.659 1.591l-5.432 5.432a2.25 2.25 0 0 0-.659 1.591v2.927a2.25 2.25 0 0 1-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 0 0-.659-1.591L3.659 7.409A2.25 2.25 0 0 1 3 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0 1 12 3Z" /></svg>
                            Apply Filters
                        </button>
                    </div>
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="mb-6 flex items-center gap-3 bg-[#eef9f0] border border-[#b8e8c0] text-[#1a7a30] px-4 py-3 rounded-lg text-sm font-semibold">
                <svg class="w-4 h-4 shrink-0 text-[#1a7a30]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                @SuccessMessage
            </div>
        }
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="mb-6 flex items-center gap-3 bg-[#fef0f0] border border-[#f8c0c0] text-[#d94040] px-4 py-3 rounded-lg text-sm font-semibold">
                <svg class="w-4 h-4 shrink-0 text-[#d94040]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                @ErrorMessage
            </div>
        }

        @if (Transactions == null || !Transactions.Any())
        {
            <div class="bg-white p-16 rounded-xl border border-[#e5e3dc] text-center shadow-sm">
                <svg class="w-16 h-16 text-[#d1d0cb] mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
                <p class="text-base font-bold text-[#8a8880] tracking-wide">Tidak ada riwayat transaksi.</p>
                <p class="text-xs text-[#a09e99] mt-1">Coba sesuaikan filter atau rentang tanggal Anda.</p>
            </div>
        }
        else
        {
            <div class="space-y-4">
                @foreach (var group in GroupedTransactions)
                {
                    var items = group.Value;
                    var firstItem = items.First();
                    bool isExpanded = ExpandedGroups.Contains(group.Key);
                    var groupId = group.Key;
                    
                    var isGiveaway = firstItem.type == "OUT" && firstItem.request_type == "GIVEAWAY";
                    var isBorrow = firstItem.type == "OUT" && firstItem.request_type == "BORROW";
                    var isStockIn = firstItem.type == "IN";

                    string borderColor = isGiveaway ? "border-[#d8eadb]" : (isBorrow ? "border-[#d9e6f3]" : "border-[#e5e3dc]");
                    string hoverBg = isGiveaway ? "hover:bg-[#f6fbf7]" : (isBorrow ? "hover:bg-[#f8fbff]" : "hover:bg-[#faf9f5]");
                    string iconBg = isGiveaway ? "bg-[#eef9f0] border-[#d8eadb]" : (isBorrow ? "bg-[#eef6fd] border-[#d9e6f3]" : "bg-[#f5f4f0] border-[#e5e3dc]");

                    <div class="bg-white rounded-xl border overflow-hidden shadow-sm transition-all duration-200 @borderColor">
                        <!-- Header Accordion -->
                        <div @onclick="() => ToggleGroup(groupId)" class="px-5 py-4 cursor-pointer transition flex flex-row items-center justify-between gap-4 @hoverBg">
                            <div class="flex items-center gap-4 flex-1 min-w-0">
                                <div class="w-10 h-10 rounded-full @iconBg border flex items-center justify-center shrink-0">
                                    @if(isGiveaway) {
                                        <svg class="w-5 h-5 text-[#1a7a30]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                                    } else if(isBorrow) {
                                        <svg class="w-5 h-5 text-[#1a6b8a]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                    } else {
                                        <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/></svg>
                                    }
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="flex flex-col sm:flex-row sm:items-center gap-2 mb-1">
                                        <h3 class="font-syne font-bold text-[#1a1a1a] text-sm sm:text-base truncate">
                                            @(firstItem.type == "IN" ? "Stock In" : (string.IsNullOrEmpty(firstItem.event_name) ? (isGiveaway ? "Request Barang" : "Peminjaman Barang") : firstItem.event_name))
                                        </h3>
                                        <div class="flex flex-wrap items-center gap-1.5 shrink-0">
                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#f5f4f0] text-[#8a8780] border border-[#e5e3dc]">@items.Count Items</span>
                                            @if(isGiveaway) {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#eef9f0] text-[#1a7a30] border border-[#b8e8c0]">Giveaway</span>
                                            } else if (isBorrow) {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#eef6fd] text-[#1a6b8a] border border-[#d9e6f3]">Borrow</span>
                                            } else {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-white text-gray-600 border border-gray-200">Stock In</span>
                                            }
                                            
                                            @if(firstItem.status == "PENDING" || firstItem.status == "PENDING_STAFF_INVENTORY" || firstItem.status == "PENDING_ADMIN" || firstItem.status == "PENDING_MANAGER") {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#fff8e6] text-[#b37a00] border border-[#ffe099]">Waiting</span>
                                            } else if(firstItem.status == "APPROVED" || firstItem.status == "COMPLETED") {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#eef9f0] text-[#1a7a30] border border-[#b8e8c0]">Approved</span>
                                            } else if(firstItem.status == "REVISION" || firstItem.status == "REVISION_BY_STAFF_INVENTORY" || firstItem.status == "REVISION_BY_ADMIN" || firstItem.status == "REVISION_BY_MANAGER") {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#fffbeb] text-[#d97706] border border-[#fde68a]">Revision</span>
                                            } else if(firstItem.status == "REJECTED") {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#fef0f0] text-[#d94040] border border-[#f8c0c0]">Rejected</span>
                                            } else if(firstItem.status == "WAITING_HANDOVER" || firstItem.status == "WAITING_ADMIN_HANDOVER" || firstItem.status == "WAITING_HANDOVER_CONFIRM") {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#e0f2fe] text-[#1a6b8a] border border-[#bae6fd]">Handover Process</span>
                                            } else {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#f5f4f0] text-[#8a8780] border border-[#e5e3dc]">@firstItem.status</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-gray-500">
                                        <div class="flex items-center gap-1.5">
                                            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                                            @(firstItem.applicant_name ?? firstItem.Requester?.name ?? "-")
                                        </div>
                                        <div class="flex items-center gap-1.5">
                                            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                            @(firstItem.created_at.ToString("MMM dd, yyyy"))
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="flex items-center gap-3 shrink-0">
                                <div class="w-8 h-8 rounded-full flex items-center justify-center text-gray-400 hover:text-[#1a1a1a] hover:bg-[#f0ede5] transition">
                                    <svg class="w-5 h-5 transition-transform duration-200 @(isExpanded ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                                </div>
                            </div>
                        </div>

                        @if(isExpanded)
                        {
                            <div class="border-t border-[#e5e3dc] bg-[#faf9f5] p-5">
                                <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
                                    
                                    <!-- Kolom 1: Vertical Timeline (1/4 Lebar pada Desktop) -->
                                    <div class="lg:col-span-1 bg-white p-5 rounded-2xl border border-[#e5e3dc] shadow-sm flex flex-col">
                                        <h4 class="text-xs font-bold text-[#1a1a1a] uppercase tracking-wider mb-5 pb-2 border-b border-[#f0ede5] flex items-center gap-2">
                                            <svg class="w-4 h-4 text-[#e8a000]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                                            Status Pelacakan
                                        </h4>
                                        
                                        <div class="relative flex flex-col space-y-6 my-2 pl-2">
                                            <!-- Vertical connecting line -->
                                            <div class="absolute top-2 bottom-2 bg-gray-300 z-0" style="width: 2px; left: 15px;"></div>

                                            @{ var steps = GetGroupSteps(items); }
                                            @for (int i = 0; i < steps.Count; i++)
                                            {
                                                var step = steps[i];
                                                <div class="flex items-start gap-4 relative z-10">
                                                    <!-- Circle indicator wrapper -->
                                                    <div class="w-4 h-4 flex items-center justify-center shrink-0 mt-0.5 bg-white border rounded-full z-10
                                                        @(step.Status == "DONE" ? "border-emerald-600" :
                                                          step.Status == "ACTIVE" ? "border-blue-600 animate-pulse" :
                                                          step.Status == "WARNING" ? "border-rose-600" :
                                                          "border-gray-300")">
                                                        @if (step.Status == "DONE") {
                                                            <div class="w-full h-full rounded-full bg-[#1a7a30] flex items-center justify-center shrink-0">
                                                                <svg class="w-2.5 h-2.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                                                            </div>
                                                        } else if (step.Status == "ACTIVE") {
                                                            <span class="relative flex h-2 w-2 items-center justify-center">
                                                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
                                                                <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-600"></span>
                                                            </span>
                                                        } else if (step.Status == "WARNING") {
                                                            <div class="w-full h-full rounded-full bg-[#d94040] flex items-center justify-center shrink-0">
                                                                <svg class="w-2.5 h-2.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                                                            </div>
                                                        } else {
                                                            <div class="w-1.5 h-1.5 rounded-full bg-gray-300"></div>
                                                        }
                                                    </div>
                                                    <!-- Text Info -->
                                                    <div class="flex flex-col min-w-0">
                                                        <span class="text-xs font-bold @(step.Status == "DONE" ? "text-[#1a7a30]" : step.Status == "ACTIVE" ? "text-blue-600" : step.Status == "WARNING" ? "text-[#d94040]" : "text-gray-500")">@step.Name</span>
                                                        <span class="text-[10px] text-gray-400 leading-tight">
                                                            @if (step.Status == "DONE") {
                                                                <span>@(string.IsNullOrEmpty(step.ApproverName) ? "Selesai dilakukan" : $"Reviewed By {step.ApproverName}")</span>
                                                            } else if (step.Status == "ACTIVE") {
                                                                <span>Sedang diproses</span>
                                                            } else if (step.Status == "WARNING") {
                                                                <span>Butuh perhatian / revisi</span>
                                                            } else {
                                                                <span>Menunggu antrean</span>
                                                            }
                                                        </span>
                                                        @if (step.CompletedAt.HasValue) {
                                                            <span class="text-[9px] text-gray-400 mt-0.5 flex items-center gap-1">
                                                                <svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0"/></svg>
                                                                @step.CompletedAt.Value.ToString("dd MMM yyyy HH:mm") WIB
                                                            </span>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- Kolom 2: Detail, Aksi, & Daftar Produk (3/4 Lebar pada Desktop) -->
                                    <div class="lg:col-span-3 space-y-4">
                                    
                                    <!-- Dokumen Pembukuan (PDF) -->
                                    @if (firstItem.type == "OUT") {
                                        <div class="bg-white p-4 rounded-xl border border-[#e5e3dc] shadow-sm flex flex-wrap gap-2.5 items-center">
                                            <span class="text-[0.65rem] font-bold uppercase tracking-wider text-[#8a8780] mr-2 block w-full sm:w-auto">Dokumen Pembukuan (PDF):</span>

                                            <a href="/api/pdf/receipt-request/@groupId" target="_blank" @onclick:stopPropagation="true" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-gray-50 hover:bg-gray-100 border border-gray-200 text-gray-700 rounded-lg text-xs font-semibold transition shadow-sm">
                                                <svg class="w-3.5 h-3.5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                                1. Bukti Pengajuan
                                            </a>
                                            
                                            @if (firstItem.status == "WAITING_HANDOVER" || firstItem.status == "WAITING_ADMIN_HANDOVER" || firstItem.status == "APPROVED" || firstItem.status == "COMPLETED" || firstItem.status == "REJECTED") {
                                                <a href="/api/pdf/receipt/@groupId" target="_blank" @onclick:stopPropagation="true" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-purple-50 hover:bg-purple-100 border border-purple-200 text-purple-700 rounded-lg text-xs font-semibold transition shadow-sm">
                                                    <svg class="w-3.5 h-3.5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                                    2. Bukti Penyerahan
                                                </a>
                                            } else {
                                                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-gray-100/50 border border-gray-200/50 text-gray-400 rounded-lg text-xs font-semibold cursor-not-allowed">
                                                    <svg class="w-3.5 h-3.5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                                    2. Bukti Penyerahan
                                                </span>
                                            }
                                            
                                            @if (isBorrow) {
                                                if (firstItem.returned_quantity >= firstItem.quantity && firstItem.status == "APPROVED") {
                                                    <a href="/api/pdf/receipt-return/@groupId" target="_blank" @onclick:stopPropagation="true" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 text-emerald-700 rounded-lg text-xs font-semibold transition shadow-sm">
                                                        <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                                        3. Bukti Pengembalian
                                                    </a>
                                                } else {
                                                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-gray-100/50 border border-gray-200/50 text-gray-400 rounded-lg text-xs font-semibold cursor-not-allowed">
                                                        <svg class="w-3.5 h-3.5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                                        3. Bukti Pengembalian
                                                    </span>
                                                }
                                            }
                                        </div>
                                    }

                                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                                        <!-- PEMOHON Card -->
                                        <div class="bg-white p-4 rounded-xl border border-[#e5e3dc] shadow-sm flex items-center gap-3.5">
                                            <div class="w-10 h-10 rounded-full bg-amber-50 flex items-center justify-center shrink-0">
                                                <!-- User icon -->
                                                <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                                                </svg>
                                            </div>
                                            <div class="min-w-0">
                                                <span class="block text-[9px] font-extrabold uppercase tracking-wider text-[#8a8880] mb-0.5">PEMOHON</span>
                                                <span class="block text-xs font-bold text-[#1a1a1a] truncate">@(firstItem.applicant_name ?? firstItem.Requester?.name ?? "-")</span>
                                                <span class="block text-[10px] text-gray-500 truncate">NRP: @(firstItem.applicant_nrp ?? "-")</span>
                                            </div>
                                        </div>

                                        <!-- EVENT / PROGRAM Card -->
                                        <div class="bg-white p-4 rounded-xl border border-[#e5e3dc] shadow-sm flex items-center gap-3.5">
                                            <div class="w-10 h-10 rounded-full bg-emerald-50 flex items-center justify-center shrink-0">
                                                <!-- Calendar icon -->
                                                <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
                                                </svg>
                                            </div>
                                            <div class="min-w-0">
                                                <span class="block text-[9px] font-extrabold uppercase tracking-wider text-[#8a8880] mb-0.5">EVENT / PROGRAM</span>
                                                @if (firstItem.type == "OUT") {
                                                    <span class="block text-xs font-bold text-[#1a1a1a] truncate">@(firstItem.event_name ?? "-")</span>
                                                    <span class="block text-[10px] text-gray-500 truncate">@(firstItem.event_date?.ToString("dd MMM yyyy") ?? "-")</span>
                                                } else {
                                                    <span class="block text-xs font-bold text-gray-400">-</span>
                                                }
                                            </div>
                                        </div>

                                        <!-- DIVISI Card -->
                                        <div class="bg-white p-4 rounded-xl border border-[#e5e3dc] shadow-sm flex items-center gap-3.5">
                                            <div class="w-10 h-10 rounded-full bg-purple-50 flex items-center justify-center shrink-0">
                                                <!-- Building icon -->
                                                <svg class="w-5 h-5 text-purple-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 16.5h1.5m3 0H15M21 21M3 21" />
                                                </svg>
                                            </div>
                                            <div class="min-w-0">
                                                <span class="block text-[9px] font-extrabold uppercase tracking-wider text-[#8a8880] mb-0.5">DIVISI</span>
                                                <span class="block text-xs font-bold text-[#1a1a1a] truncate">@(firstItem.Division?.name ?? "-")</span>
                                            </div>
                                        </div>

                                        <!-- TOTAL CREDIT Card -->
                                        <div class="bg-white p-4 rounded-xl border border-[#e5e3dc] shadow-sm flex items-center gap-3.5">
                                            <div class="w-10 h-10 rounded-full bg-blue-50 flex items-center justify-center shrink-0">
                                                <!-- Wallet icon -->
                                                <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a2.25 2.25 0 0 0-2.25-2.25H15a3 3 0 1 1-6 0H5.25A2.25 2.25 0 0 0 3 12m18 0v6a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 18v-6m18 0V9M3 12V9m18-3a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 6" />
                                                </svg>
                                            </div>
                                            <div class="min-w-0">
                                                <span class="block text-[9px] font-extrabold uppercase tracking-wider text-[#8a8880] mb-0.5">TOTAL KREDIT KELUAR</span>
                                                @if (firstItem.type == "OUT") {
                                                    var totalCredit = items.Where(i => i.request_type == "GIVEAWAY").Sum(i => i.quantity * (i.Product?.value ?? 0));
                                                    if (totalCredit > 0)
                                                    {
                                                        <span class="block text-xs font-bold text-[#e8a000] truncate">
                                                            @(((double)totalCredit).ToString("N0")) <span class="text-[10px] font-normal text-gray-500">pts</span>
                                                        </span>
                                                    } else {
                                                        <span class="block text-xs font-bold text-gray-400">-</span>
                                                    }
                                                } else {
                                                    <span class="block text-xs font-bold text-gray-400">-</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    
                                    @if (!string.IsNullOrEmpty(firstItem.notes))
                                    {
                                        <div class="bg-white p-4 rounded-xl border border-[#e5e3dc] shadow-sm pt-4">
                                            <span class="block text-[10px] font-bold text-[#8a8780] uppercase tracking-wider mb-1">Notes</span>
                                            <p class="text-xs text-[#5a5855]">@firstItem.notes</p>
                                        </div>
                                    }

                                    <!-- Table of Items (Tracking.razor style) -->
                                    <div class="overflow-x-auto rounded-xl border border-[#e5e3dc] shadow-sm bg-white">
                                        <table class="w-full text-left border-collapse whitespace-nowrap">
                                            <thead>
                                                <tr class="bg-[#f5f4f0] border-b border-[#e5e3dc]">
                                                    <th class="px-4 py-2.5 text-[0.65rem] font-bold tracking-wider uppercase text-[#8a8780]">Product Details</th>
                                                    <th class="px-4 py-2.5 text-[0.65rem] font-bold tracking-wider uppercase text-[#8a8780]">Qty / Stok</th>
                                                    <th class="px-4 py-2.5 text-[0.65rem] font-bold tracking-wider uppercase text-[#8a8780]">Credit</th>
                                                    <th class="px-4 py-2.5 text-[0.65rem] font-bold tracking-wider uppercase text-[#8a8780]">Type</th>
                                                    <th class="px-4 py-2.5 text-[0.65rem] font-bold tracking-wider uppercase text-[#8a8780]">Reviewed By</th>
                                                    <th class="px-4 py-2.5 text-[0.65rem] font-bold tracking-wider uppercase text-[#8a8780]">Processed At</th>
                                                    <th class="px-4 py-2.5 text-[0.65rem] font-bold tracking-wider uppercase text-[#8a8780] text-right">Status / Aksi</th>
                                                </tr>
                                            </thead>
                                            <tbody class="divide-y divide-[#e5e3dc]">
                                                @foreach (var item in items)
                                                {
                                                    <tr class="hover:bg-[#faf9f5] transition-colors">
                                                        <td class="px-4 py-3 align-middle">
                                                            <div class="flex items-center gap-3">
                                                                <div class="w-9 h-9 rounded border border-[#e5e3dc] overflow-hidden flex-shrink-0 bg-white flex items-center justify-center">
                                                                    <img src="@ImageHelper.ResolveProduct(item.Product, "/img/logo.svg")" class="w-full h-full object-cover">
                                                                </div>
                                                                <div>
                                                                    <div class="text-xs font-bold text-[#1a1a1a]">@(item.Product?.name)</div>
                                                                    <code class="text-[9px] text-gray-500 bg-white border border-[#e5e3dc] px-1.5 py-0.5 rounded">@(item.Product?.sku)</code>
                                                                </div>
                                                            </div>
                                                        </td>
                                                        <td class="px-4 py-3 align-middle">
                                                            <div class="text-xs font-bold text-[#1a1a1a]">
                                                                @item.quantity
                                                                <span class="text-[10px] font-normal text-gray-500">Pcs</span>
                                                            </div>
                                                            <div class="text-[9px] text-gray-400">Stock: @(item.Product?.current_stock)</div>
                                                        </td>
                                                        <td class="px-4 py-3 align-middle">
                                                            @if (item.request_type == "GIVEAWAY" && item.Product?.value > 0)
                                                            {
                                                                <div class="text-xs font-bold text-[#1a1a1a] flex items-center gap-1">
                                                                    <svg class="w-3.5 h-3.5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                                                    @(((double)((item.quantity ?? 0) * item.Product!.value)).ToString("N0"))
                                                                </div>
                                                                <div class="text-[9px] text-gray-400">@(((double)item.Product!.value).ToString("N0")) per unit</div>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-gray-400 text-xs font-medium">-</span>
                                                            }
                                                        </td>
                                                        <td class="px-4 py-3 align-middle">
                                                            @if (item.request_type == "BORROW") {
                                                                <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold bg-[#eef9f0] text-[#1a7a30] border border-[#b8e8c0]">BORROW</span>
                                                            } else if (item.request_type == "GIVEAWAY") {
                                                                <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold bg-[#e0f2fe] text-[#1a6b8a] border border-[#bae6fd]">GIVEAWAY</span>
                                                            } else {
                                                                <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold bg-white text-gray-600 border border-gray-200">STOCK IN</span>
                                                            }
                                                        </td>
                                                        <td class="px-4 py-3 align-middle">
                                                            @if (item.StaffInventoryApprover != null) {
                                                                <div class="text-[10px] text-gray-600">Staff Inv: <span class="font-bold text-[#1a1a1a]">@item.StaffInventoryApprover.name</span></div>
                                                            }
                                                            @if (item.AdminApprover != null) {
                                                                <div class="text-[10px] text-gray-600">Admin: <span class="font-bold text-[#1a1a1a]">@item.AdminApprover.name</span></div>
                                                            }
                                                            @if (item.ManagerApprover != null) {
                                                                <div class="text-[10px] text-gray-600">Manager: <span class="font-bold text-[#1a1a1a]">@item.ManagerApprover.name</span></div>
                                                            }
                                                            @if (item.StaffInventoryApprover == null && item.AdminApprover == null && item.ManagerApprover == null && item.Approver != null) {
                                                                <div class="text-[10px] text-gray-600">Reviewer: <span class="font-bold text-[#1a1a1a]">@item.Approver.name</span></div>
                                                            }
                                                            @if (item.Approver == null && item.StaffInventoryApprover == null) {
                                                                <span class="text-gray-400 text-xs">-</span>
                                                            }
                                                        </td>
                                                        <td class="px-4 py-3 align-middle">
                                                            @if (item.status != "PENDING" && item.status != "PENDING_STAFF_INVENTORY" && item.status != "PENDING_ADMIN" && item.status != "PENDING_MANAGER") {
                                                                <div class="text-xs text-gray-600 font-medium">@(item.updated_at.ToString("dd MMM yyyy"))</div>
                                                                <div class="text-[9px] text-gray-400">@(item.updated_at.ToString("HH:mm")) WIB</div>
                                                            } else {
                                                                <span class="text-gray-400 text-xs">-</span>
                                                            }
                                                        </td>
                                                        <td class="px-4 py-3 align-middle text-right">
                                                            @if (item.status == "PENDING" || item.status == "PENDING_STAFF_INVENTORY" || item.status == "PENDING_ADMIN" || item.status == "PENDING_MANAGER") {
                                                                <span class="inline-flex items-center px-1.5 py-0.5 border border-[#fde68a] rounded text-[9px] font-bold bg-[#fef3c7] text-[#92400e]">WAITING</span>
                                                            } else if (item.status == "APPROVED" || item.status == "COMPLETED") {
                                                                <span class="inline-flex items-center px-1.5 py-0.5 border border-[#b8e8c0] rounded text-[9px] font-bold bg-[#eef9f0] text-[#1a7a30]">APPROVED</span>
                                                            } else if (item.status == "REVISION" || item.status == "REVISION_BY_STAFF_INVENTORY" || item.status == "REVISION_BY_ADMIN" || item.status == "REVISION_BY_MANAGER") {
                                                                <div class="flex flex-col gap-1.5 items-end">
                                                                    <span class="inline-flex items-center px-1.5 py-0.5 border border-[#bae6fd] rounded text-[9px] font-bold bg-[#e0f2fe] text-[#1a6b8a]">REVISION</span>
                                                                    <button @onclick="() => OpenRevisionModal(item)" class="text-[9px] font-bold bg-[#e8a000] text-[#1a1a1a] px-2 py-1 rounded shadow-sm hover:bg-[#d49300] active:scale-95 transition">Revise Now</button>
                                                                </div>
                                                            } else if (item.status == "REJECTED") {
                                                                <span class="inline-flex items-center px-1.5 py-0.5 border border-[#f8c0c0] rounded text-[9px] font-bold bg-[#fef0f0] text-[#d94040]">REJECTED</span>
                                                            } else if (item.status == "WAITING_HANDOVER" || item.status == "WAITING_ADMIN_HANDOVER" || item.status == "WAITING_HANDOVER_CONFIRM") {
                                                                <span class="inline-flex items-center px-1.5 py-0.5 border border-[#bae6fd] rounded text-[9px] font-bold bg-[#e0f2fe] text-[#1a6b8a]">HANDOVER</span>
                                                            } else {
                                                                <span class="inline-flex items-center px-1.5 py-0.5 border border-[#e5e3dc] rounded text-[9px] font-bold bg-[#f5f4f0] text-[#8a8780]">@item.status</span>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (TotalPages > 1)
            {
                <div class="mt-8 flex items-center justify-between bg-white px-6 py-4 rounded-xl border border-[#e5e3dc] shadow-sm">
                    <span class="text-xs font-bold text-[#8a8880]">Halaman <span class="text-[#1a1a1a]">@CurrentPage</span> dari @TotalPages</span>
                    <div class="flex gap-2">
                        <button disabled="@(CurrentPage == 1)" @onclick="() => LoadData(CurrentPage - 1)" class="w-10 h-10 flex items-center justify-center rounded-lg border border-[#e5e3dc] hover:bg-[#faf9f5] transition disabled:opacity-30">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                        </button>
                        <button disabled="@(CurrentPage == TotalPages)" @onclick="() => LoadData(CurrentPage + 1)" class="w-10 h-10 flex items-center justify-center rounded-lg border border-[#e5e3dc] hover:bg-[#faf9f5] transition disabled:opacity-30">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                        </button>
                    </div>
                </div>
            }
        }
    </div>
</div>

<Modal Show="@(ShowRevisionModal && RevisionItem != null)" Title="Revisi Permintaan" Size="xl" OnClose="CloseRevisionModal">
  <ChildContent>
    @if (RevisionItem != null)
    {
                <div class="p-4 bg-[#fffbeb] border border-[#fde68a] text-[#92400e] text-xs rounded-xl flex items-start gap-3">
                    <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                    <div>
                        <div class="font-bold">Alasan Revisi dari Admin:</div>
                        <div class="mt-1 italic">"@RevisionItem.rejection_reason"</div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(ModalErrorMessage))
                {
                    <div class="p-4 bg-red-50 border border-red-200 text-red-700 text-xs rounded-xl flex items-start gap-3 mt-4">
                        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        <div>
                            <div class="font-bold">Gagal Mengirim Perbaikan</div>
                            <div class="mt-1">@ModalErrorMessage</div>
                        </div>
                    </div>
                }

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Nama Pemohon</label>
                        <input type="text" @bind="RevisionModel.applicant_name" class="w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] border border-[#e5e3dc] rounded-lg outline-none focus:border-[#e8a000]" />
                    </div>
                    <div>
                        <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">NRP</label>
                        <input type="text" @bind="RevisionModel.applicant_nrp" class="w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] border border-[#e5e3dc] rounded-lg outline-none focus:border-[#e8a000]" />
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Kuantitas</label>
                        <input type="number" @bind="RevisionModel.quantity" class="w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] border border-[#e5e3dc] rounded-lg outline-none focus:border-[#e8a000]" />
                    </div>
                    <div>
                        <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Division</label>
                        <select @bind="RevisionModel.division_id" class="w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] border border-[#e5e3dc] rounded-lg outline-none focus:border-[#e8a000]">
                            <option value="">Select Division</option>
                            @foreach(var div in Divisions) { <option value="@div.id">@div.name</option> }
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Event / Program</label>
                    <input type="text" @bind="RevisionModel.event_name" class="w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] border border-[#e5e3dc] rounded-lg outline-none focus:border-[#e8a000]" />
                </div>

                <div>
                    <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Catatan Perbaikan (Opsional)</label>
                    <textarea @bind="RevisionModel.notes" rows="3" class="w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] border border-[#e5e3dc] rounded-lg outline-none focus:border-[#e8a000]" placeholder="Tambahkan catatan..."></textarea>
                </div>
    }
  </ChildContent>
  <Footer>
        <button type="button" @onclick="CloseRevisionModal" class="px-5 py-2.5 text-sm font-bold text-gray-600 hover:text-gray-900 bg-white border border-[#e5e3dc] rounded-xl transition">Batal</button>
        <button type="button" @onclick="SubmitRevision" class="px-6 py-2.5 bg-[#e8a000] hover:bg-[#d49300] active:scale-[0.98] text-[#1a1a1a] text-sm font-bold tracking-wider rounded-xl transition shadow-sm">Kirim Perbaikan</button>
  </Footer>
</Modal>

@code {
    private List<Transaction>? Transactions;
    private Dictionary<string, List<Transaction>> GroupedTransactions = new();
    private HashSet<string> ExpandedGroups = new();
    private List<Division> Divisions = new();
    
    private int CurrentPage = 1;
    private int PageSize = 10;
    private int TotalPages = 1;
    private int TotalItems = 0;
    
    private string? FilterType;
    private string? FilterRequestType;
    private string? FilterIsReturnedStr;
    private DateTime? StartDate;
    private DateTime? EndDate;

    private bool ShowFilters = false;
    private bool HasActiveFilters => StartDate.HasValue || EndDate.HasValue || !string.IsNullOrEmpty(FilterType) || !string.IsNullOrEmpty(FilterRequestType);
    
    private string GetActiveFiltersText()
    {
        var active = new List<string>();
        if (StartDate.HasValue || EndDate.HasValue) active.Add("Tanggal");
        if (!string.IsNullOrEmpty(FilterType)) active.Add("Tipe");
        if (!string.IsNullOrEmpty(FilterRequestType)) active.Add("Kategori");
        return string.Join(", ", active);
    }
    
    private void ToggleFilters()
    {
        ShowFilters = !ShowFilters;
    }

    private int CurrentUserId = 0;
    private string? UserRole;
    private bool IsStaffOrUser => string.Equals(UserRole, "staff", StringComparison.OrdinalIgnoreCase) || string.Equals(UserRole, "user", StringComparison.OrdinalIgnoreCase);
    
    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }
    private string? ModalErrorMessage { get; set; }

    private bool ShowRevisionModal = false;
    private Transaction? RevisionItem;
    private UT_WMSDotnet.ViewModels.TransactionRequestViewModel RevisionModel = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            if (int.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out int id))
                CurrentUserId = id;
            UserRole = user.FindFirst(ClaimTypes.Role)?.Value;
        }

        Divisions = await DivisionService.GetAllDivisionsAsync();
        ShowFilters = HasActiveFilters;
        
        DashboardState.OnDashboardUpdated += DashboardUpdated;
        await LoadData(1);
    }

    private async void DashboardUpdated()
    {
        await InvokeAsync(async () =>
        {
            await LoadData(CurrentPage);
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        DashboardState.OnDashboardUpdated -= DashboardUpdated;
    }

    private bool IsLoading = false;

    private async Task LoadData(int page)
    {
        if (IsLoading) return;
        IsLoading = true;
        try 
        {
            CurrentPage = page;
        bool? isReturnedBool = FilterIsReturnedStr == "true" ? true : (FilterIsReturnedStr == "false" ? false : null);
        
        var result = await TransactionService.GetHistoryAsync(
            CurrentUserId, UserRole, FilterType, StartDate, EndDate, CurrentPage, PageSize, FilterRequestType, isReturnedBool);
        
        Transactions = result.Transactions;
        TotalItems = result.TotalItems;
        TotalPages = result.TotalPages;

        if (Transactions != null)
        {
            GroupedTransactions = Transactions
                .GroupBy(t => t.type == "OUT" ? t.group_id : t.id.ToString())
                .ToDictionary(g => g.Key, g => g.ToList());
        }
        ExpandedGroups.Clear();
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void ToggleGroup(string groupId)
    {
        if (ExpandedGroups.Contains(groupId))
            ExpandedGroups.Remove(groupId);
        else
            ExpandedGroups.Add(groupId);
    }

    private async Task SetQuickFilter(string? type, string? requestType)
    {
        FilterType = type;
        FilterRequestType = requestType;
        await LoadData(1);
    }
    
    private async Task ResetFilters()
    {
        FilterType = null;
        FilterRequestType = null;
        FilterIsReturnedStr = null;
        StartDate = null;
        EndDate = null;
        await LoadData(1);
    }

    private async Task OnFilterTypeChanged()
    {
        if (FilterType != "OUT")
        {
            FilterRequestType = null;
            FilterIsReturnedStr = null;
        }
        await Task.CompletedTask;
    }

    private async Task OnFilterRequestTypeChanged()
    {
        if (FilterRequestType != "BORROW")
        {
            FilterIsReturnedStr = null;
        }
        await Task.CompletedTask;
    }

    private void OpenRevisionModal(Transaction item)
    {
        RevisionItem = item;
        ModalErrorMessage = null;
        RevisionModel = new UT_WMSDotnet.ViewModels.TransactionRequestViewModel
        {
            applicant_name = item.applicant_name,
            applicant_nrp = item.applicant_nrp,
            event_name = item.event_name,
            event_date = item.event_date,
            quantity = item.quantity,
            request_type = item.request_type,
            division_id = item.division_id,
            documentation_link = item.documentation_link,
            notes = item.notes
        };
        ShowRevisionModal = true;
    }

    private void CloseRevisionModal()
    {
        ShowRevisionModal = false;
        RevisionItem = null;
    }

    private async Task SubmitRevision()
    {
        if (RevisionItem == null) return;
        ModalErrorMessage = null;
        
        var error = await TransactionService.UpdateRevisionAsync(RevisionItem.id, RevisionModel);
        if (error != null) 
        {
            ModalErrorMessage = error;
        }
        else
        {
            SuccessMessage = "Revision submitted successfully.";
            await LoadData(CurrentPage);
            CloseRevisionModal();
        }
    }

    public class TrackingStep
    {
        public string Name { get; set; } = "";
        public string Status { get; set; } = "";
        public DateTime? CompletedAt { get; set; }
        public string? ApproverName { get; set; }
    }

    private List<TrackingStep> GetGroupSteps(List<Transaction> groupItems)
    {
        var firstItem = groupItems.First();
        var steps = new List<TrackingStep>();
        steps.Add(new TrackingStep { Name = "Pengajuan", Status = "DONE", CompletedAt = firstItem.created_at });

        if (firstItem.request_type == "GIVEAWAY")
        {
            if (firstItem.status == "PENDING_STAFF_INVENTORY") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "ACTIVE" });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Approval Manager", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Dokumentasi User", Status = "PENDING" });
            } else if (firstItem.status == "PENDING_ADMIN") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = "ACTIVE" });
                steps.Add(new TrackingStep { Name = "Approval Manager", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Dokumentasi User", Status = "PENDING" });
            } else if (firstItem.status == "PENDING_MANAGER") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Manager", Status = "ACTIVE" });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Dokumentasi User", Status = "PENDING" });
            } else if (firstItem.status == "REVISION" || firstItem.status == "REVISION_BY_STAFF_INVENTORY" || firstItem.status == "REVISION_BY_ADMIN" || firstItem.status == "REVISION_BY_MANAGER") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = firstItem.status == "REVISION_BY_STAFF_INVENTORY" ? "WARNING" : "DONE", CompletedAt = firstItem.status == "REVISION_BY_STAFF_INVENTORY" ? firstItem.updated_at : (firstItem.status == "PENDING_STAFF_INVENTORY" ? null : firstItem.updated_at) });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = firstItem.status == "REVISION_BY_ADMIN" ? "WARNING" : "PENDING", CompletedAt = firstItem.status == "REVISION_BY_ADMIN" ? firstItem.updated_at : null });
                steps.Add(new TrackingStep { Name = "Approval Manager", Status = firstItem.status == "REVISION_BY_MANAGER" ? "WARNING" : "PENDING", CompletedAt = firstItem.status == "REVISION_BY_MANAGER" ? firstItem.updated_at : null });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Dokumentasi User", Status = "PENDING" });
            } else if (firstItem.status == "WAITING_HANDOVER") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Manager", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "ACTIVE" });
                steps.Add(new TrackingStep { Name = "Dokumentasi User", Status = "PENDING" });
            } else if (firstItem.status == "WAITING_DOCUMENTATION") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Manager", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "DONE", CompletedAt = firstItem.handover_timestamp ?? firstItem.handover_approved_at ?? firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Dokumentasi User", Status = "ACTIVE" });
            } else if (firstItem.status == "DOCUMENTATION_OVERDUE") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Manager", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "DONE", CompletedAt = firstItem.handover_timestamp ?? firstItem.handover_approved_at ?? firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Dokumentasi User", Status = "WARNING" });
            } else if (firstItem.status == "COMPLETED" || firstItem.status == "APPROVED") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Manager", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "DONE", CompletedAt = firstItem.handover_timestamp ?? firstItem.handover_approved_at ?? firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Dokumentasi User", Status = "DONE", CompletedAt = firstItem.documentation_uploaded_at ?? firstItem.updated_at });
            } else if (firstItem.status == "REJECTED") {
                var approverRole = firstItem.Approver?.role?.ToLowerInvariant() ?? "";
                bool isManager = approverRole.Contains("manager") || !string.IsNullOrEmpty(firstItem.manager_notes);
                bool isAdmin = approverRole.Contains("admin") || !string.IsNullOrEmpty(firstItem.admin_notes);
                
                if (isManager)
                {
                    steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DONE", CompletedAt = firstItem.updated_at });
                    steps.Add(new TrackingStep { Name = "Approval Admin", Status = "DONE", CompletedAt = firstItem.updated_at });
                    steps.Add(new TrackingStep { Name = "Approval Manager", Status = "WARNING", CompletedAt = firstItem.updated_at });
                }
                else if (isAdmin)
                {
                    steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DONE", CompletedAt = firstItem.updated_at });
                    steps.Add(new TrackingStep { Name = "Approval Admin", Status = "WARNING", CompletedAt = firstItem.updated_at });
                    steps.Add(new TrackingStep { Name = "Approval Manager", Status = "PENDING" });
                }
                else
                {
                    steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "WARNING", CompletedAt = firstItem.updated_at });
                    steps.Add(new TrackingStep { Name = "Approval Admin", Status = "PENDING" });
                    steps.Add(new TrackingStep { Name = "Approval Manager", Status = "PENDING" });
                }
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Dokumentasi User", Status = "PENDING" });
            }
        }
        else // BORROW
        {
            int totalQty = groupItems.Sum(i => i.quantity ?? 0);
            int totalReturned = groupItems.Sum(i => i.returned_quantity ?? 0);

            if (firstItem.status == "PENDING_STAFF_INVENTORY") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "ACTIVE" });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Pengembalian", Status = "PENDING" });
            } else if (firstItem.status == "REVISION_BY_STAFF_INVENTORY") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "WARNING", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Pengembalian", Status = "PENDING" });
            } else if (firstItem.status == "PENDING_ADMIN" || firstItem.status == "PENDING") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = "ACTIVE" });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Pengembalian", Status = "PENDING" });
            } else if (firstItem.status == "REVISION_BY_ADMIN" || firstItem.status == "REVISION") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = "WARNING", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Pengembalian", Status = "PENDING" });
            } else if (firstItem.status == "WAITING_HANDOVER" || firstItem.status == "WAITING_ADMIN_HANDOVER") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "ACTIVE" });
                steps.Add(new TrackingStep { Name = "Pengembalian", Status = "PENDING" });
            } else if (firstItem.status == "APPROVED") {
                steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Approval Admin", Status = "DONE", CompletedAt = firstItem.updated_at });
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "DONE", CompletedAt = firstItem.handover_timestamp ?? firstItem.handover_approved_at ?? firstItem.updated_at });

                if (totalReturned >= totalQty && totalQty > 0) {
                    steps.Add(new TrackingStep { Name = "Pengembalian", Status = "DONE", CompletedAt = firstItem.returned_at ?? firstItem.updated_at });
                } else {
                    steps.Add(new TrackingStep { Name = "Pengembalian", Status = "ACTIVE" });
                }
            } else if (firstItem.status == "REJECTED") {
                var approverRole = firstItem.Approver?.role?.ToLowerInvariant() ?? "";
                bool isAdmin = approverRole.Contains("admin") || !string.IsNullOrEmpty(firstItem.admin_notes);
                
                if (isAdmin)
                {
                    steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "DONE", CompletedAt = firstItem.updated_at });
                    steps.Add(new TrackingStep { Name = "Approval Admin", Status = "WARNING", CompletedAt = firstItem.updated_at });
                }
                else
                {
                    steps.Add(new TrackingStep { Name = "Approval Staff Inv", Status = "WARNING", CompletedAt = firstItem.updated_at });
                    steps.Add(new TrackingStep { Name = "Approval Admin", Status = "PENDING" });
                }
                steps.Add(new TrackingStep { Name = "Berita Acara Serah Terima", Status = "PENDING" });
                steps.Add(new TrackingStep { Name = "Pengembalian", Status = "PENDING" });
            }
        }

        foreach (var step in steps)
        {
            if (step.Status == "DONE" || step.Status == "WARNING")
            {
                if (step.Name == "Approval Staff Inv") step.ApproverName = firstItem.StaffInventoryApprover?.name ?? (firstItem.Approver?.role?.Contains("staff") == true ? firstItem.Approver.name : null);
                else if (step.Name == "Approval Admin") step.ApproverName = firstItem.AdminApprover?.name ?? (firstItem.Approver?.role?.Contains("admin") == true ? firstItem.Approver.name : null);
                else if (step.Name == "Approval Manager") step.ApproverName = firstItem.ManagerApprover?.name ?? (firstItem.Approver?.role?.Contains("manager") == true ? firstItem.Approver.name : null);
            }
        }

        return steps;
    }
}
