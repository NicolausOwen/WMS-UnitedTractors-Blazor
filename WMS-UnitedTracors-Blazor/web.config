<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Keamanan: Hilangkan HTTP Server Header untuk menyembunyikan identitas server (IIS/ASP.NET) -->
    <security>
      <requestFiltering removeServerHeader="true">
        <!-- Keamanan: Membatasi ukuran request dan mencegah URL / Query String yang terlalu panjang yang biasa dipakai untuk eksploitasi -->
        <requestLimits maxAllowedContentLength="30000000" maxUrl="2048" maxQueryString="1024" />
        
        <!-- Mencegah akses ke konfigurasi source code / hidden files secara langsung di level IIS -->
        <hiddenSegments>
          <add segment=".git" />
          <add segment=".env" />
          <add segment="appsettings.json" />
          <add segment="appsettings.Development.json" />
        </hiddenSegments>

        <!-- Cegah eksekusi HTTP verbs yang tidak diperlukan / berbahaya -->
        <verbs allowUnlisted="true">
          <add verb="OPTIONS" allowed="false" />
          <add verb="TRACE" allowed="false" />
        </verbs>
      </requestFiltering>

      <!-- Dynamic IP Security: Mitigasi DDoS dasar di IIS -->
      <!-- Memblokir IP yang membuka request bersamaan > 50, atau > 200 request dalam 2 detik -->
      <dynamicIpSecurity enableProxyMode="true">
        <denyByConcurrentRequests enabled="true" maxConcurrentRequests="50" />
        <denyByRequestRate enabled="true" maxRequests="200" requestIntervalInMilliseconds="2000" />
      </dynamicIpSecurity>
    </security>
    
    <!-- Memastikan tidak ada detail error aplikasi internal yang bocor ke end-user di production -->
    <httpErrors errorMode="DetailedLocalOnly" existingResponse="PassThrough" />
  </system.webServer>
</configuration>
