@page "/Scanner"
@using UT_WMSDotnet.Models
@using UT_WMSDotnet.ViewModels
@using WMS_UnitedTracors_Blazor.Services
@using System.Security.Claims
@inject IJSRuntime JSRuntime
@inject DivisionService DivisionService
@inject TransactionService TransactionService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Scan Barcode</PageTitle>

<div class="w-full min-h-screen bg-[#f5f4f0] px-4 md:px-10 py-6 pb-24 md:pb-12 font-sans">
    @* Tombol Back *@
    <button @onclick="GoBack" class="inline-flex items-center gap-2 px-4 py-2 border border-[#e5e3dc] hover:border-black rounded-lg text-xs font-semibold text-[#1a1a1a] hover:bg-black hover:text-white transition cursor-pointer mb-6 bg-white">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Kembali
    </button>

    @* Page Header *@
    <div class="mb-8">
        <h1 class="text-[1.6rem] font-bold text-[#1a1a1a] leading-none tracking-tight">Scan <span class="text-[#e8a000]">Barcode</span></h1>
        <div class="text-[0.72rem] font-medium text-[#a09e99] mt-1">@(DateTime.Now.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("id-ID")))</div>
    </div>

    @if (!string.IsNullOrEmpty(SuccessMessage))
    {
        <div class="flex items-center gap-2.5 bg-[#eef9f0] border border-[#b8e8c0] text-[#1a7a30] px-4 py-2.5 rounded-lg text-[0.82rem] mb-6 font-semibold">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            @SuccessMessage
        </div>
    }
    
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="flex items-center gap-2.5 bg-[#fef0f0] border border-[#f8c0c0] text-[#c0392b] px-4 py-2.5 rounded-lg text-[0.82rem] mb-6 font-semibold">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            @ErrorMessage
        </div>
    }

    @* Camera Scanner Card *@
    <div class="bg-white border border-[#eae8e1] rounded-2xl overflow-hidden shadow-[0_1px_3px_rgba(0,0,0,0.08),0_2px_6px_rgba(0,0,0,0.06)] mb-6">
        <div class="px-6 py-4 border-b border-[#f0ede5]">
            <h2 class="text-[0.95rem] font-bold text-[#1a1a1a] tracking-tight">Scan Barcode</h2>
            <p class="text-[0.72rem] text-[#a09e99] mt-0.5">Arahkan kamera ke barcode produk</p>
        </div>

        <div class="p-4">
            <div class="relative bg-[#1a1a1a] w-full max-w-[500px] mx-auto rounded-xl overflow-hidden aspect-[16/9] md:aspect-[16/9]">
                <video id="scannerVideo" autoplay muted playsinline class="absolute inset-0 w-full h-full object-cover"></video>

                @if (!IsScanning)
                {
                    <div class="absolute inset-0 flex flex-col items-center justify-center gap-2 bg-[#1a1a1a] z-10">
                        <svg class="w-12 h-12 stroke-[#8a8780] stroke-[1.5] fill-none" viewBox="0 0 24 24">
                            <path d="M3 9V6a1 1 0 011-1h3M3 15v3a1 1 0 001 1h3M21 9V6a1 1 0 00-1-1h-3M21 15v3a1 1 0 01-1 1h-3M8 12h8"/>
                        </svg>
                        <p class="text-[0.75rem] text-[#8a8780]">Kamera belum aktif</p>
                    </div>
                }
                else
                {
                    <div class="absolute inset-0 flex items-center justify-center pointer-events-none z-20">
                        <div class="relative w-[72%] h-[52%]">
                            @* Corners *@
                            <div class="absolute top-0 left-0 w-5 h-5 border-t-[2.5px] border-l-[2.5px] border-[#e8a000] rounded-tl-[3px]"></div>
                            <div class="absolute top-0 right-0 w-5 h-5 border-t-[2.5px] border-r-[2.5px] border-[#e8a000] rounded-tr-[3px]"></div>
                            <div class="absolute bottom-0 left-0 w-5 h-5 border-b-[2.5px] border-l-[2.5px] border-[#e8a000] rounded-bl-[3px]"></div>
                            <div class="absolute bottom-0 right-0 w-5 h-5 border-b-[2.5px] border-r-[2.5px] border-[#e8a000] rounded-br-[3px]"></div>
                            
                            @* Scan Animated Line *@
                            <div class="scan-line"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="px-4 pb-4">
            @if (!IsScanning)
            {
                <button type="button" @onclick="StartScanner" class="w-full py-3 text-[0.82rem] font-bold tracking-wide bg-[#e8a000] hover:bg-[#d49300] active:scale-[0.98] text-[#1a1a1a] rounded-lg transition-all duration-150 cursor-pointer">
                    <span class="inline-flex items-center gap-2 justify-center">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.069A1 1 0 0121 8.882V15.118a1 1 0 01-1.447.91L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                        Mulai Kamera
                    </span>
                </button>
            }
            else
            {
                <button type="button" @onclick="StopScanner" class="w-full py-3 text-[0.82rem] font-bold tracking-wide bg-[#1a1a1a] hover:bg-[#333] active:scale-[0.98] text-white rounded-lg transition-all duration-150 cursor-pointer">
                    <span class="inline-flex items-center gap-2 justify-center">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-6.219-8.56"/></svg>
                        Stop Kamera
                    </span>
                </button>
            }
        </div>
    </div>

    @* Transaction Form Card *@
    <div class="bg-white border border-[#eae8e1] rounded-2xl overflow-hidden shadow-[0_1px_3px_rgba(0,0,0,0.08),0_2px_6px_rgba(0,0,0,0.06)]">
        <div class="px-6 py-4 border-b border-[#f0ede5]">
            <div class="flex items-center justify-between">
                <h2 class="text-[0.95rem] font-bold text-[#1a1a1a] tracking-tight">Detail Transaksi</h2>
                @if (IsScannedBadgeVisible)
                {
                    <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-[#eef9f0] border border-[#b8e8c0] text-[#1a7a30] text-[0.62rem] font-bold rounded-full ml-2 animate-fade-in">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                        Barcode terbaca
                    </span>
                }
            </div>
        </div>

        <div class="p-5">
            <form @onsubmit="SubmitTransaction">
                @* Type *@
                <div class="mb-4">
                    <label class="block text-[0.6rem] font-bold tracking-wider uppercase text-[#a09e99] mb-1.5">Tipe Transaksi</label>
                    <select @bind="TransactionType" class="w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none text-[#1a1a1a] transition-colors duration-150 cursor-pointer appearance-none bg-[url('data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%2712%27 height=%2712%27 viewBox=%270 0 24 24%27 fill=%27none%27 stroke=%27%238a8880%27 stroke-width=%272.5%27%3E%3Cpath d=%27M6 9l6 6 6-6%27/%3E%3C/svg%3E')] bg-[length:12px_12px] bg-[right_0.75rem_center] bg-no-repeat">
                        <option value="IN">STOCK IN</option>
                        <option value="OUT">STOCK OUT</option>
                    </select>
                </div>

                <!-- Dynamic Items Section -->
                <div class="bg-[#faf9f5] border border-[#e5e3dc] rounded-xl p-4 mb-4">
                    <div class="flex items-center gap-1.5 text-[0.6rem] font-bold tracking-wider uppercase text-[#e8a000] mb-3.5 after:content-[''] after:flex-1 after:h-[1px] after:bg-[#e5e3dc]">Items to Process</div>
                    <div class="flex flex-col gap-3">
                        @foreach (var item in Items)
                        {
                            <div class="item-row flex gap-2.5 items-start">
                                <div class="flex-1">
                                    <input type="text" @bind="item.Sku" @bind:event="oninput" class="w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none text-[#1a1a1a] transition-colors duration-150 font-mono" required placeholder="Scan/ketik SKU">
                                </div>
                                <div class="w-[100px]">
                                    <input type="number" @bind="item.Quantity" class="w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none text-[#1a1a1a] transition-colors duration-150 text-center" min="1" required placeholder="Qty">
                                </div>
                                @if (Items.Count > 1)
                                {
                                    <button type="button" class="p-2 text-[#d94040] hover:bg-[#fef0f0] rounded-lg transition-colors cursor-pointer" @onclick="() => RemoveItem(item)">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                    <button type="button" class="inline-flex items-center gap-1 text-[0.72rem] text-[#e8a000] hover:text-[#c98d00] font-bold bg-transparent border-none cursor-pointer mt-3.5 transition-colors" @onclick="AddItem">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                        Tambah Barang Lain
                    </button>
                </div>

                @* Notes *@
                <div class="mb-4">
                    <label class="block text-[0.6rem] font-bold tracking-wider uppercase text-[#a09e99] mb-1.5">Catatan <span class="text-[#b0ada8] font-normal normal-case tracking-normal">(opsional)</span></label>
                    <input type="text" @bind="Notes" placeholder="Misal: Ref Supplier / Work Order" class="w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none text-[#1a1a1a] transition-colors duration-150">
                </div>

                @* Usage Fields (STOCK OUT) *@
                @if (TransactionType == "OUT")
                {
                    <div class="bg-[#faf9f5] border border-[#e5e3dc] rounded-xl p-4 mb-4">
                        <div class="flex items-center gap-1.5 text-[0.6rem] font-bold tracking-wider uppercase text-[#e8a000] mb-3.5 after:content-[''] after:flex-1 after:h-[1px] after:bg-[#e5e3dc]">Informasi Peminjaman</div>

                        <div class="mb-4">
                            <label class="block text-[0.6rem] font-bold tracking-wider uppercase text-[#a09e99] mb-1.5">Nama Pemohon <span class="text-[#d94040]">*</span></label>
                            <input type="text" @bind="ApplicantName" required placeholder="Nama lengkap" class="w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none text-[#1a1a1a] transition-colors duration-150">
                        </div>

                        <div class="mb-4">
                            <label class="block text-[0.6rem] font-bold tracking-wider uppercase text-[#a09e99] mb-1.5">NRP Pemohon <span class="text-[#d94040]">*</span></label>
                            <input type="text" @bind="ApplicantNrp" required placeholder="Nomor NRP" class="w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none text-[#1a1a1a] transition-colors duration-150 font-mono">
                        </div>

                        <div class="mb-4">
                            <label class="block text-[0.6rem] font-bold tracking-wider uppercase text-[#a09e99] mb-1.5">Event / Program <span class="text-[#d94040]">*</span></label>
                            <input type="text" @bind="EventName" required placeholder="Nama event atau program" class="w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none text-[#1a1a1a] transition-colors duration-150">
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">
                            <div>
                                <label class="block text-[0.6rem] font-bold tracking-wider uppercase text-[#a09e99] mb-1.5">Tanggal Event <span class="text-[#d94040]">*</span></label>
                                <input type="date" @bind="EventDate" required class="w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none text-[#1a1a1a] transition-colors duration-150">
                            </div>
                            <div>
                                <label class="block text-[0.6rem] font-bold tracking-wider uppercase text-[#a09e99] mb-1.5">Division <span class="text-[#d94040]">*</span></label>
                                <select @bind="DivisionId" required class="w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none text-[#1a1a1a] transition-colors duration-150 cursor-pointer appearance-none bg-[url('data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%2712%27 height=%2712%27 viewBox=%270 0 24 24%27 fill=%27none%27 stroke=%27%238a8880%27 stroke-width=%272.5%27%3E%3Cpath d=%27M6 9l6 6 6-6%27/%3E%3C/svg%3E')] bg-[length:12px_12px] bg-[right_0.75rem_center] bg-no-repeat">
                                    <option value="">Pilih divisi</option>
                                    @if (Divisions != null)
                                    {
                                        @foreach (var division in Divisions)
                                        {
                                            <option value="@division.Id">@division.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="mb-0">
                            <label class="block text-[0.6rem] font-bold tracking-wider uppercase text-[#a09e99] mb-1.5">Dokumentasi (GDrive Link) <span class="text-[#d94040]">*</span></label>
                            <input type="url" @bind="DocumentationLink" required placeholder="https://drive.google.com/..." class="w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none text-[#1a1a1a] transition-colors duration-150">
                        </div>
                    </div>
                }

                <button type="submit" disabled="@IsSubmitting" class="w-full py-3.5 bg-[#e8a000] hover:bg-[#d49300] active:scale-[0.98] text-[#1a1a1a] text-sm font-bold tracking-wider rounded-xl transition-all duration-100 cursor-pointer mt-2 disabled:opacity-50">
                    Submit Request
                </button>
            </form>
        </div>
    </div>
</div>

<style>
    .scan-line {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 2px;
        background: #e8a000;
        box-shadow: 0 0 4px #e8a000;
        animation: scan 2.5s infinite linear;
    }
    @@keyframes scan {
        0%, 100% { top: 0%; opacity: 0; }
        10% { opacity: 1; }
        90% { opacity: 1; }
        95% { top: 100%; opacity: 0; }
    }
    .animate-fade-in {
        animation: fadeIn 0.3s ease-in-out;
    }
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(-5px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

@code {
    private bool IsScanning = false;
    private bool IsScannedBadgeVisible = false;
    private string TransactionType = "IN";
    private string? Notes;

    // Out fields
    private string? ApplicantName;
    private string? ApplicantNrp;
    private string? EventName;
    private DateTime EventDate = DateTime.Today;
    private int? DivisionId;
    private string? DocumentationLink;

    private List<ScanItem> Items = new() { new ScanItem { Quantity = 1 } };
    private List<DivisionDto>? Divisions;

    private string? SuccessMessage;
    private string? ErrorMessage;
    private bool IsSubmitting = false;

    private int CurrentUserId = 0;
    private DotNetObjectReference<Scanner>? objRef;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity != null && authState.User.Identity.IsAuthenticated)
        {
            if (int.TryParse(authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out int id))
            {
                CurrentUserId = id;
            }
        }
        var divRes = await DivisionService.GetDivisionsAsync(1, 100);
        Divisions = divRes.Divisions;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            objRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("scanner.init", objRef);
        }
    }

    private async Task StartScanner()
    {
        IsScanning = true;
        IsScannedBadgeVisible = false;
        await JSRuntime.InvokeVoidAsync("scanner.start", "scannerVideo");
    }

    private async Task StopScanner()
    {
        IsScanning = false;
        await JSRuntime.InvokeVoidAsync("scanner.stop");
    }

    [JSInvokable]
    public void OnBarcodeScanned(string barcode)
    {
        InvokeAsync(async () =>
        {
            IsScannedBadgeVisible = true;
            IsScanning = false;

            // Fill empty row or create new
            var emptyRow = Items.FirstOrDefault(i => string.IsNullOrWhiteSpace(i.Sku));
            if (emptyRow != null)
            {
                emptyRow.Sku = barcode;
            }
            else
            {
                Items.Add(new ScanItem { Sku = barcode, Quantity = 1 });
            }

            StateHasChanged();

            // Hide badge after 3s
            await Task.Delay(3000);
            IsScannedBadgeVisible = false;
            StateHasChanged();
        });
    }

    [JSInvokable]
    public void OnCameraError(string error)
    {
        InvokeAsync(() =>
        {
            IsScanning = false;
            ErrorMessage = "Kamera error: " + error;
            StateHasChanged();
        });
    }

    private void AddItem()
    {
        Items.Add(new ScanItem { Quantity = 1 });
    }

    private void RemoveItem(ScanItem item)
    {
        if (Items.Count > 1)
        {
            Items.Remove(item);
        }
    }

    private async Task SubmitTransaction()
    {
        SuccessMessage = null;
        ErrorMessage = null;
        IsSubmitting = true;

        if (Items.Any(i => string.IsNullOrWhiteSpace(i.Sku)))
        {
            ErrorMessage = "SKU tidak boleh kosong.";
            IsSubmitting = false;
            return;
        }

        try
        {
            var vm = new TransactionRequestViewModel
            {
                type = TransactionType,
                notes = Notes,
                items = Items.Select(i => new TransactionItemViewModel { sku = i.Sku, quantity = i.Quantity }).ToList()
            };

            if (TransactionType == "OUT")
            {
                if (string.IsNullOrWhiteSpace(ApplicantName) || string.IsNullOrWhiteSpace(ApplicantNrp) ||
                    string.IsNullOrWhiteSpace(EventName) || DivisionId == null || string.IsNullOrWhiteSpace(DocumentationLink))
                {
                    ErrorMessage = "Mohon lengkapi informasi peminjaman.";
                    IsSubmitting = false;
                    return;
                }

                vm.applicant_name = ApplicantName;
                vm.applicant_nrp = ApplicantNrp;
                vm.event_name = EventName;
                vm.event_date = EventDate;
                vm.division_id = DivisionId.Value;
                vm.documentation_link = DocumentationLink;
                vm.request_type = "BORROW";
            }

            var err = await TransactionService.StoreTransactionAsync(vm, CurrentUserId);
            if (err != null)
            {
                ErrorMessage = err;
            }
            else
            {
                SuccessMessage = "Transaksi berhasil dibuat!";
                // Reset form
                Items = new() { new ScanItem { Quantity = 1 } };
                Notes = null;
                ApplicantName = null;
                ApplicantNrp = null;
                EventName = null;
                DivisionId = null;
                DocumentationLink = null;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Terjadi kesalahan: " + ex.Message;
        }
        
        IsSubmitting = false;
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/");
    }

    public void Dispose()
    {
        objRef?.Dispose();
    }

    private class ScanItem
    {
        public string? Sku { get; set; }
        public int Quantity { get; set; } = 1;
    }
}
