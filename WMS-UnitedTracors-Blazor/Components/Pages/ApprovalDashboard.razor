    private async Task ApproveAllGroup(List<Transaction> items)
    {
        if (IsProcessing) return;
        IsProcessing = true;
        ErrorMessage = null;
        SuccessMessage = null;

        try
        {
            int successCount = 0;
            foreach (var item in items)
            {
                var err = await ApprovalService.ApproveAsync(item.id, null, CurrentUserId, UserRole);
                if (err != null) ErrorMessage += $"Item {item.id}: {err} | ";
                else successCount++;
            }

            if (successCount > 0) SuccessMessage = $"{successCount} items approved.";
            await LoadData();
        }
        catch (Exception ex)
        {
            ErrorMessage = "Terjadi kesalahan saat menyetujui: " + ex.Message;
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private async Task ProcessBatch()
    {
        if (IsProcessing) return;
        IsProcessing = true;
        ErrorMessage = null;
        SuccessMessage = null;

        try
        {
            int successCount = 0;
            List<KeyValuePair<int, string>> itemsToProcess;
            
            if (string.IsNullOrEmpty(GroupToProcess))
            {
                itemsToProcess = Decisions.ToList();
            }
            else
            {
                var groupItems = GroupedApprovals?.GetValueOrDefault(GroupToProcess);
                if (groupItems == null) return;
                itemsToProcess = Decisions.Where(d => groupItems.Any(i => i.id == d.Key)).ToList();
            }

            foreach (var kvp in itemsToProcess)
            {
                var id = kvp.Key;
                var action = kvp.Value;
                var reason = Reasons.GetValueOrDefault(id, "");

                if ((action == "REJECT" || action == "REVISE") && string.IsNullOrWhiteSpace(reason))
                {
                    ErrorMessage = "Please provide a reason for all rejected or revised items.";
                    return;
                }

                string? err = null;
                if (action == "APPROVE") err = await ApprovalService.ApproveAsync(id, reason, CurrentUserId, UserRole);
                else if (action == "REJECT") err = await ApprovalService.RejectAsync(id, reason, CurrentUserId, UserRole);
                else if (action == "REVISE") err = await ApprovalService.RequestRevisionAsync(id, reason, CurrentUserId, UserRole, RevisedQuantities.GetValueOrDefault(id), RevisedPickupDates.GetValueOrDefault(id));

                if (err != null) ErrorMessage += $"Item {id}: {err} | ";
                else successCount++;
            }

            if (successCount > 0) SuccessMessage = $"{successCount} items processed.";
            await LoadData();
            ShowBatchConfirmModal = false;
        }
        catch (Exception ex)
        {
            ErrorMessage = "Terjadi kesalahan saat memproses permintaan: " + ex.Message;
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private async Task ProcessBatchReturns()
    {
        if (IsProcessing) return; // cegah klik ganda (mencegah operasi paralel di DbContext yang sama)
        IsProcessing = true;
        ErrorMessage = null;
        SuccessMessage = null;

        try
        {
            int successCount = 0;
            foreach (var kvp in ReturnDecisions.ToList())
            {
                var id = kvp.Key;
                var action = kvp.Value;
                var reason = ReturnReasons.GetValueOrDefault(id, "");

                string? err = null;
                if (action == "APPROVE") err = await ApprovalService.ApproveReturnAsync(id, CurrentUserId, UserRole);
                else if (action == "REJECT") err = await ApprovalService.RejectReturnAsync(id, reason, CurrentUserId, UserRole);

                if (err != null) ErrorMessage += $"Return {id}: {err} | ";
                else successCount++;
            }

            if (successCount > 0) SuccessMessage = $"{successCount} return requests processed.";
            await LoadData();
        }
        catch (Exception ex)
        {
            ErrorMessage = "Terjadi kesalahan saat memproses pengembalian: " + ex.Message;
        }
        finally
        {
            IsProcessing = false;
        }
    }

