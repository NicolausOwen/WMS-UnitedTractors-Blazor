@page "/Approval"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using UT_WMSDotnet.Models
@using WMS_UnitedTracors_Blazor.Services
@inject ApprovalService ApprovalService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Approvals</PageTitle>

<div class="py-8 bg-[#f5f4f0] min-h-screen font-sans">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="mb-6">
            <h1 class="text-[1.6rem] font-bold text-[#1a1a1a] leading-none tracking-tight">Persetujuan <span class="text-[#e8a000]">Admin</span></h1>
            <div class="text-[0.72rem] font-medium text-[#a09e99] mt-1">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</div>
        </div>

        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="mb-6 flex items-center gap-3 bg-[#eef9f0] border border-[#b8e8c0] text-[#1a7a30] px-4 py-3 rounded-lg text-sm font-semibold">
                <svg class="w-4 h-4 shrink-0 text-[#1a7a30]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                @SuccessMessage
            </div>
        }
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="mb-6 flex items-center gap-3 bg-[#fef0f0] border border-[#f8c0c0] text-[#d94040] px-4 py-3 rounded-lg text-sm font-semibold">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                @ErrorMessage
            </div>
        }

        <!-- Tabs -->
        <div class="flex items-center gap-2 mb-6 border-b border-[#e5e3dc] pb-1 overflow-x-auto">
            <button @onclick='() => ActiveTab = "new"' class="px-4 py-2 text-sm font-bold rounded-lg transition-all @(ActiveTab == "new" ? "bg-[#1a1a1a] text-white" : "text-[#8a8880] hover:text-[#1a1a1a] hover:bg-[#faf9f5]")">
                New Requests
                @if (GroupedApprovals?.Count > 0)
                {
                    <span class="ml-1.5 px-1.5 py-0.5 rounded-full text-[10px] @(ActiveTab == "new" ? "bg-[#e8a000] text-[#1a1a1a]" : "bg-[#e5e3dc] text-[#1a1a1a]")">@GroupedApprovals.Count</span>
                }
            </button>
            <button @onclick='() => ActiveTab = "handovers"' class="px-4 py-2 text-sm font-bold rounded-lg transition-all @(ActiveTab == "handovers" ? "bg-[#1a1a1a] text-white" : "text-[#8a8880] hover:text-[#1a1a1a] hover:bg-[#faf9f5]")">
                Serah Terima
                @if (GroupedHandovers?.Count > 0)
                {
                    <span class="ml-1.5 px-1.5 py-0.5 rounded-full text-[10px] @(ActiveTab == "handovers" ? "bg-[#e8a000] text-[#1a1a1a]" : "bg-[#e5e3dc] text-[#1a1a1a]")">@GroupedHandovers.Count</span>
                }
            </button>
            <button @onclick='() => ActiveTab = "returns"' class="px-4 py-2 text-sm font-bold rounded-lg transition-all @(ActiveTab == "returns" ? "bg-[#1a1a1a] text-white" : "text-[#8a8880] hover:text-[#1a1a1a] hover:bg-[#faf9f5]")">
                Returns
                @if (PendingReturns?.Count > 0)
                {
                    <span class="ml-1.5 px-1.5 py-0.5 rounded-full text-[10px] @(ActiveTab == "returns" ? "bg-[#e8a000] text-[#1a1a1a]" : "bg-[#e5e3dc] text-[#1a1a1a]")">@PendingReturns.Count</span>
                }
            </button>
            <button @onclick='() => ActiveTab = "profiles"' class="px-4 py-2 text-sm font-bold rounded-lg transition-all @(ActiveTab == "profiles" ? "bg-[#1a1a1a] text-white" : "text-[#8a8880] hover:text-[#1a1a1a] hover:bg-[#faf9f5]")">
                Profile Updates
                @if (PendingProfileRequests?.Count > 0)
                {
                    <span class="ml-1.5 px-1.5 py-0.5 rounded-full text-[10px] @(ActiveTab == "profiles" ? "bg-[#e8a000] text-[#1a1a1a]" : "bg-[#e5e3dc] text-[#1a1a1a]")">@PendingProfileRequests.Count</span>
                }
            </button>
        </div>

        @if (ActiveTab == "new")
        {
            @if (GroupedApprovals == null)
            {
                <div class="bg-white p-12 rounded-xl border border-[#e5e3dc] text-center shadow-sm text-gray-500">Loading requests...</div>
            }
            else if (GroupedApprovals.Count == 0)
            {
                <div class="bg-white p-12 rounded-xl border border-[#e5e3dc] text-center shadow-sm">
                    <svg class="w-12 h-12 text-[#d1d0cb] mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
                    <p class="text-sm font-bold text-[#8a8880] tracking-wide">No pending requests at the moment.</p>
                </div>
            }
            else
            {
                <div class="flex justify-end mb-4">
                    <button type="button" @onclick="ProcessBatch" disabled="@(Decisions.Count == 0 || IsProcessing)" class="inline-flex items-center gap-2 px-4 py-2 bg-[#1a1a1a] text-white text-xs font-bold rounded-lg shadow-sm hover:bg-[#333] transition disabled:opacity-50">
                        Process Selected Items (@Decisions.Count)
                    </button>
                </div>

                <div class="space-y-4">
                    @foreach (var group in GroupedApprovals)
                    {
                        var firstItem = group.Value.First();
                        bool isExpanded = ExpandedGroups.Contains(group.Key);

                        <div class="bg-white rounded-xl border border-[#e5e3dc] overflow-hidden shadow-sm transition-all duration-200">
                            <div class="px-5 py-4 flex flex-col lg:flex-row lg:items-center justify-between gap-4 bg-white">
                                <div class="flex items-center gap-4 flex-1 min-w-0">
                                    <div class="w-10 h-10 rounded-full bg-[#f5f4f0] border border-[#e5e3dc] flex items-center justify-center shrink-0">
                                        <svg class="w-5 h-5 text-[#e8a000]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <h3 class="font-syne font-bold text-[#1a1a1a] truncate">@(firstItem.event_name ?? "Request Barang")</h3>
                                        <div class="flex items-center gap-2 text-xs text-[#8a8880] mt-0.5">
                                            <span class="font-semibold text-gray-700">@(firstItem.applicant_name ?? firstItem.Requester?.name)</span>
                                            <span>•</span>
                                            <span>@firstItem.created_at.ToString("dd MMM yyyy, HH:mm")</span>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="flex items-center gap-3">
                                    @if (UserRole == "manager" || UserRole == "admin" || UserRole == "superadmin")
                                    {
                                        <button type="button" @onclick="() => ApproveAllGroup(group.Value)" disabled="@IsProcessing" class="px-3 py-1.5 text-xs font-bold text-white bg-[#e8a000] rounded-md hover:bg-[#d49300] transition shadow-sm disabled:opacity-50">
                                            Approve All
                                        </button>
                                    }
                                    <div class="text-[#8a8880] cursor-pointer" @onclick="() => ToggleGroup(group.Key)">
                                        <svg class="w-5 h-5 transform transition-transform duration-200 @(isExpanded ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                                    </div>
                                </div>
                            </div>

                            @if (isExpanded)
                            {
                                <div class="bg-[#faf9f5] p-4 border-t border-[#f0ede5]">
                                    @if (firstItem.type == "OUT")
                                    {
                                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-4 bg-white p-3 rounded-lg border border-[#e5e3dc]">
                                            <div>
                                                <div class="text-[0.6rem] text-[#8a8880] font-bold uppercase mb-0.5">Applicant</div>
                                                <div class="text-xs font-bold text-[#1a1a1a]">@(firstItem.applicant_name ?? "-")</div>
                                                <div class="text-[10px] text-[#8a8880]">NRP: @(firstItem.applicant_nrp ?? "-")</div>
                                            </div>
                                            <div>
                                                <div class="text-[0.6rem] text-[#8a8880] font-bold uppercase mb-0.5">Event Date</div>
                                                <div class="text-xs font-bold text-[#1a1a1a]">@(firstItem.event_date?.ToString("dd MMM yyyy") ?? "-")</div>
                                            </div>
                                            <div>
                                                <div class="text-[0.6rem] text-[#8a8880] font-bold uppercase mb-0.5">Division</div>
                                                <div class="text-xs font-bold text-[#1a1a1a]">@(firstItem.Division?.name ?? "-")</div>
                                            </div>
                                            <div>
                                                <div class="text-[0.6rem] text-[#8a8880] font-bold uppercase mb-0.5">Documentation</div>
                                                @if (!string.IsNullOrEmpty(firstItem.documentation_link))
                                                {
                                                    <a href="@firstItem.documentation_link" target="_blank" class="text-xs font-bold text-[#e8a000] hover:underline flex items-center gap-1">
                                                        View Link
                                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                                                    </a>
                                                }
                                                else { <span class="text-xs">-</span> }
                                            </div>
                                        </div>
                                    }

                                    <div class="overflow-x-auto">
                                        <table class="w-full text-left">
                                            <thead>
                                                <tr class="border-b border-[#e5e3dc]">
                                                    <th class="pb-2 text-[0.6rem] font-bold text-[#8a8880] uppercase">Product</th>
                                                    <th class="pb-2 text-[0.6rem] font-bold text-[#8a8880] uppercase text-center">Qty</th>
                                                    <th class="pb-2 text-[0.6rem] font-bold text-[#8a8880] uppercase">Type</th>
                                                    <th class="pb-2 text-[0.6rem] font-bold text-[#8a8880] uppercase text-right">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody class="divide-y divide-[#f0ede5]">
                                                @foreach (var item in group.Value)
                                                {
                                                    <tr class="bg-white">
                                                        <td class="py-3 px-3">
                                                            <div class="flex items-center gap-3">
                                                                <div class="w-8 h-8 rounded border border-[#e5e3dc] overflow-hidden shrink-0">
                                                                    <img src="@ImageHelper.ResolveProduct(item.Product, "/img/logo.svg")" class="w-full h-full object-cover">
                                                                </div>
                                                                <div>
                                                                    <div class="text-xs font-bold text-[#1a1a1a]">@(item.Product?.name)</div>
                                                                    <div class="text-[10px] text-[#8a8880]">SKU: @(item.Product?.sku)</div>
                                                                    @if (item.type == "OUT" && item.Product?.current_stock < item.quantity)
                                                                    {
                                                                        <div class="text-[9px] text-[#d94040] font-bold mt-0.5">⚠️ Limited Stock: @(item.Product?.current_stock)</div>
                                                                    }
                                                                </div>
                                                            </div>
                                                        </td>
                                                        <td class="py-3 px-3 text-center">
                                                            <div class="text-xs font-bold text-[#1a1a1a]">@item.quantity</div>
                                                        </td>
                                                        <td class="py-3 px-3">
                                                            @if (item.request_type == "BORROW") {
                                                                <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold bg-[#eef9f0] text-[#1a7a30] border border-[#b8e8c0]">BORROW</span>
                                                            } else {
                                                                <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold bg-[#e0f2fe] text-[#1a6b8a] border border-[#bae6fd]">GIVEAWAY</span>
                                                            }
                                                        </td>
                                                        <td class="py-3 px-3 text-right">
                                                            <div class="flex flex-col items-end gap-1.5">
                                                                <div class="flex items-center gap-1 bg-[#f5f4f0] p-1 rounded-lg border border-[#e5e3dc]">
                                                                    <button type="button" @onclick='() => SetDecision(item.id, "APPROVE")' class="px-2 py-1 text-[10px] font-bold rounded @(Decisions.GetValueOrDefault(item.id) == "APPROVE" ? "bg-[#1a7a30] text-white" : "text-[#8a8880] hover:text-[#1a1a1a]")">Approve</button>
                                                                    <button type="button" @onclick='() => SetDecision(item.id, "REVISION")' class="px-2 py-1 text-[10px] font-bold rounded @(Decisions.GetValueOrDefault(item.id) == "REVISION" ? "bg-[#4338ca] text-white" : "text-[#8a8880] hover:text-[#1a1a1a]")">Revise</button>
                                                                    <button type="button" @onclick='() => SetDecision(item.id, "REJECT")' class="px-2 py-1 text-[10px] font-bold rounded @(Decisions.GetValueOrDefault(item.id) == "REJECT" ? "bg-[#d94040] text-white" : "text-[#8a8880] hover:text-[#1a1a1a]")">Reject</button>
                                                                </div>
                                                                @if (Decisions.ContainsKey(item.id))
                                                                {
                                                                    <input type="text" @bind="Reasons[item.id]" placeholder="Notes..." class="w-full max-w-[200px] px-2 py-1 text-[10px] border border-[#e5e3dc] rounded-md outline-none focus:border-[#e8a000]" />
                                                                }
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        }
        else if (ActiveTab == "handovers")
        {
            @if (GroupedHandovers == null || GroupedHandovers.Count == 0)
            {
                <div class="bg-white p-12 rounded-xl border border-[#e5e3dc] text-center shadow-sm">
                    <p class="text-sm font-bold text-[#8a8880] tracking-wide">No pending handovers.</p>
                </div>
            }
            else
            {
                <div class="space-y-4">
                    @foreach (var group in GroupedHandovers)
                    {
                        var firstItem = group.Value.First();
                        <div class="bg-white rounded-xl border border-[#e5e3dc] shadow-sm overflow-hidden">
                            <div class="px-5 py-4 border-b border-[#f0ede5] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                                <div>
                                    <h4 class="font-bold text-[#1a1a1a]">Event: @(firstItem.event_name ?? "-")</h4>
                                    <div class="text-xs text-gray-500 mt-1">Pemohon: @(firstItem.applicant_name ?? firstItem.Requester?.name) | @(group.Value.Count) Items</div>
                                </div>
                                <div class="flex gap-2">
                                    <button type="button" @onclick="() => ApproveHandoverBatch(group.Key)" disabled="@IsProcessing" class="px-4 py-2 bg-gray-900 text-white text-xs font-bold rounded-lg shadow-sm hover:bg-gray-800 transition">Approve Handover</button>
                                    <button type="button" @onclick="() => SetHandoverReject(group.Key)" class="px-4 py-2 bg-white border border-red-200 text-red-600 text-xs font-bold rounded-lg hover:bg-red-50 transition">Reject Proof</button>
                                </div>
                            </div>
                            
                            @if (HandoverRejectGroup == group.Key)
                            {
                                <div class="px-5 py-3 bg-red-50 border-b border-red-100 flex gap-2">
                                    <input type="text" @bind="HandoverRejectReason" placeholder="Alasan penolakan..." class="flex-1 px-3 py-1.5 text-xs rounded border border-red-200 outline-none focus:border-red-400" />
                                    <button type="button" @onclick="() => RejectHandoverBatch(group.Key)" class="px-3 py-1.5 bg-red-600 text-white text-xs font-bold rounded hover:bg-red-700">Confirm Reject</button>
                                </div>
                            }

                            <div class="p-4 bg-gray-50/50 flex flex-col md:flex-row gap-6">
                                <div class="w-32 h-32 rounded-lg border border-[#e5e3dc] overflow-hidden bg-white shrink-0">
                                    @if (!string.IsNullOrEmpty(firstItem.handover_photo))
                                    {
                                        <a href="/storage/@firstItem.handover_photo" target="_blank" data-image-popup>
                                            <img src="/storage/@firstItem.handover_photo" class="w-full h-full object-cover" />
                                        </a>
                                    }
                                    else { <div class="w-full h-full flex items-center justify-center text-[10px] text-gray-300">No Photo</div> }
                                </div>
                                <div class="flex-1">
                                    <h5 class="text-[10px] font-bold text-[#8a8880] uppercase mb-1">Handover Notes</h5>
                                    <p class="text-xs text-[#5a5855] italic">"@firstItem.handover_notes"</p>
                                    
                                    <div class="mt-4">
                                        <h5 class="text-[10px] font-bold text-[#8a8880] uppercase mb-2">Items List</h5>
                                        <div class="flex flex-wrap gap-2">
                                            @foreach(var item in group.Value)
                                            {
                                                <div class="px-2 py-1 bg-white border border-[#e5e3dc] rounded text-[10px] font-semibold text-[#1a1a1a]">
                                                    @item.Product?.name (@item.quantity)
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
        else if (ActiveTab == "returns")
        {
             @if (PendingReturns == null || PendingReturns.Count == 0)
            {
                <div class="bg-white p-12 rounded-xl border border-[#e5e3dc] text-center shadow-sm">
                    <p class="text-sm font-bold text-[#8a8880] tracking-wide">No pending returns.</p>
                </div>
            }
            else
            {
                <div class="flex justify-end mb-4">
                    <button type="button" @onclick="ProcessBatchReturns" disabled="@(ReturnDecisions.Count == 0 || IsProcessing)" class="inline-flex items-center gap-2 px-6 py-2.5 bg-[#4338ca] text-white text-xs font-bold rounded-xl shadow-lg hover:bg-[#3730a3] transition disabled:opacity-50">
                        Submit Return Decisions (@ReturnDecisions.Count)
                    </button>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    @foreach (var item in PendingReturns)
                    {
                        <div class="bg-white rounded-xl border border-[#e5e3dc] p-4 shadow-sm">
                            <div class="flex items-start gap-4">
                                <div class="w-16 h-16 rounded-lg border border-[#e5e3dc] overflow-hidden bg-white shrink-0">
                                    <img src="@ImageHelper.ResolveProduct(item.Product, "/img/logo.svg")" class="w-full h-full object-cover">
                                </div>
                                <div class="flex-1 min-w-0">
                                    <h4 class="text-sm font-bold text-[#1a1a1a] truncate">@item.Product?.name</h4>
                                    <div class="text-[10px] text-[#8a8880] mt-1">
                                        Borrowed: <span class="font-bold text-[#1a1a1a]">@item.quantity</span> | Pending: <span class="font-bold text-[#e8a000]">@item.pending_return_quantity</span>
                                    </div>
                                    <div class="text-[10px] text-gray-500 mt-0.5">Pemohon: @(item.applicant_name ?? item.Requester?.name)</div>
                                    
                                    <div class="mt-3 flex items-center gap-2">
                                        <button type="button" @onclick='() => SetReturnDecision(item.id, "APPROVE")' class="flex-1 py-1.5 text-xs font-bold rounded-lg border transition @(ReturnDecisions.GetValueOrDefault(item.id) == "APPROVE" ? "bg-emerald-600 border-emerald-600 text-white shadow-sm" : "bg-white border-[#e5e3dc] text-gray-600 hover:bg-gray-50")">Approve</button>
                                        <button type="button" @onclick='() => SetReturnDecision(item.id, "REJECT")' class="flex-1 py-1.5 text-xs font-bold rounded-lg border transition @(ReturnDecisions.GetValueOrDefault(item.id) == "REJECT" ? "bg-red-600 border-red-600 text-white shadow-sm" : "bg-white border-[#e5e3dc] text-gray-600 hover:bg-gray-50")">Reject</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
        else if (ActiveTab == "profiles")
        {
            @if (PendingProfileRequests == null || PendingProfileRequests.Count == 0)
            {
                <div class="bg-white p-12 rounded-xl border border-[#e5e3dc] text-center shadow-sm text-gray-500">No profile updates pending.</div>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    @foreach (var pr in PendingProfileRequests)
                    {
                        <div class="bg-white border border-[#e5e3dc] rounded-xl p-5 shadow-sm">
                            <div class="flex items-center gap-3 mb-4">
                                <div class="w-10 h-10 rounded-full bg-[#e8a000] flex items-center justify-center text-xs font-bold text-[#1a1a1a]">@pr.User?.name?.Substring(0, 2).ToUpper()</div>
                                <div>
                                    <h4 class="text-sm font-bold text-[#1a1a1a]">@pr.User?.name</h4>
                                    <p class="text-[10px] text-[#8a8880]">@pr.created_at?.ToString("dd MMM yyyy")</p>
                                </div>
                            </div>
                            <div class="space-y-2 mb-4 p-3 bg-gray-50 rounded-lg">
                                <div class="text-[10px] text-gray-400 uppercase font-bold">Proposed NRP</div>
                                <div class="text-xs font-bold">@pr.nrp</div>
                                <div class="text-[10px] text-gray-400 uppercase font-bold mt-2">Proposed Division</div>
                                <div class="text-xs font-bold">@pr.Division?.name</div>
                            </div>
                            <div class="flex gap-2">
                                <button @onclick="() => ApproveProfileRequest(pr.id)" class="flex-1 py-2 bg-gray-900 text-white text-xs font-bold rounded-lg hover:bg-gray-800 transition">Approve</button>
                                <button @onclick="() => RejectProfileRequest(pr.id)" class="flex-1 py-2 bg-white border border-red-200 text-red-600 text-xs font-bold rounded-lg hover:bg-red-50 transition">Reject</button>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

@code {
    private Dictionary<string, List<Transaction>>? GroupedApprovals;
    private List<Transaction>? PendingReturns;
    private List<ProfileRequest>? PendingProfileRequests;
    private Dictionary<string, List<Transaction>>? GroupedHandovers;
    
    private string? SuccessMessage;
    private string? ErrorMessage;
    private bool IsProcessing = false;

    private int CurrentUserId = 0;
    private string? UserRole;
    private string ActiveTab = "new";

    private HashSet<string> ExpandedGroups = new();
    
    private Dictionary<int, string> Decisions = new();
    private Dictionary<int, string> Reasons = new();
    private Dictionary<int, string> ReturnDecisions = new();

    private string HandoverRejectGroup = "";
    private string HandoverRejectReason = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            if (int.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out int id))
                CurrentUserId = id;
            UserRole = user.FindFirst(ClaimTypes.Role)?.Value;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        var data = await ApprovalService.GetApprovalsAsync(CurrentUserId, UserRole);
        GroupedApprovals = data.GroupedApprovals;
        PendingReturns = data.PendingReturns;
        PendingProfileRequests = data.PendingProfileRequests;
        GroupedHandovers = data.GroupedHandovers;
        
        ExpandedGroups.Clear();
        if (GroupedApprovals != null && GroupedApprovals.Any())
        {
            ExpandedGroups.Add(GroupedApprovals.First().Key);
        }
        
        Decisions.Clear();
        Reasons.Clear();
        ReturnDecisions.Clear();
    }

    private void ToggleGroup(string groupId)
    {
        if (ExpandedGroups.Contains(groupId))
            ExpandedGroups.Remove(groupId);
        else
            ExpandedGroups.Add(groupId);
    }

    private void SetDecision(int id, string decision)
    {
        Decisions[id] = decision;
        if (!Reasons.ContainsKey(id)) Reasons[id] = "";
    }
    
    private void SetReturnDecision(int id, string decision)
    {
        ReturnDecisions[id] = decision;
    }

    private void SetHandoverReject(string groupId)
    {
        HandoverRejectGroup = groupId;
        HandoverRejectReason = "";
    }

    private async Task ApproveAllGroup(List<Transaction> items)
    {
        IsProcessing = true;
        ErrorMessage = null;
        SuccessMessage = null;

        int successCount = 0;
        foreach (var item in items)
        {
            var err = await ApprovalService.ApproveAsync(item.id, null, CurrentUserId, UserRole);
            if (err != null) ErrorMessage += $"Item {item.id}: {err} | ";
            else successCount++;
        }

        if (successCount > 0) SuccessMessage = $"{successCount} items approved.";
        await LoadData();
        IsProcessing = false;
    }

    private async Task ProcessBatch()
    {
        IsProcessing = true;
        ErrorMessage = null;
        SuccessMessage = null;

        int successCount = 0;
        foreach (var kvp in Decisions)
        {
            var id = kvp.Key;
            var action = kvp.Value;
            var reason = Reasons.GetValueOrDefault(id, "");

            if ((action == "REJECT" || action == "REVISION") && string.IsNullOrWhiteSpace(reason))
            {
                ErrorMessage = "Please provide a reason for all rejected or revised items.";
                IsProcessing = false;
                return;
            }

            string? err = null;
            if (action == "APPROVE") err = await ApprovalService.ApproveAsync(id, reason, CurrentUserId, UserRole);
            else if (action == "REJECT") err = await ApprovalService.RejectAsync(id, reason, CurrentUserId, UserRole);
            else if (action == "REVISION") err = await ApprovalService.RequestRevisionAsync(id, reason, CurrentUserId, UserRole);

            if (err != null) ErrorMessage += $"Item {id}: {err} | ";
            else successCount++;
        }

        if (successCount > 0) SuccessMessage = $"{successCount} items processed.";
        await LoadData();
        IsProcessing = false;
    }
    
    private async Task ProcessBatchReturns()
    {
        IsProcessing = true;
        ErrorMessage = null;
        SuccessMessage = null;

        int successCount = 0;
        foreach (var kvp in ReturnDecisions)
        {
            var id = kvp.Key;
            var action = kvp.Value;
            
            string? err = null;
            if (action == "APPROVE") err = await ApprovalService.ApproveReturnAsync(id, CurrentUserId, UserRole);
            else if (action == "REJECT") err = await ApprovalService.RejectReturnAsync(id, CurrentUserId, UserRole);
            
            if (err != null) ErrorMessage += $"Return {id}: {err} | ";
            else successCount++;
        }

        if (successCount > 0) SuccessMessage = $"{successCount} return requests processed.";
        await LoadData();
        IsProcessing = false;
    }

    private async Task ApproveHandoverBatch(string groupId)
    {
        IsProcessing = true;
        var err = await ApprovalService.ApproveHandoverBatchAsync(groupId, CurrentUserId, UserRole);
        if (err == null) SuccessMessage = "Handover approved successfully.";
        else ErrorMessage = err;
        await LoadData();
        IsProcessing = false;
    }

    private async Task RejectHandoverBatch(string groupId)
    {
        if (string.IsNullOrWhiteSpace(HandoverRejectReason))
        {
            ErrorMessage = "Alasan penolakan wajib diisi.";
            return;
        }

        IsProcessing = true;
        var err = await ApprovalService.RejectHandoverBatchAsync(groupId, HandoverRejectReason, CurrentUserId, UserRole);
        if (err == null) 
        {
            SuccessMessage = "Handover rejected successfully.";
            HandoverRejectGroup = "";
        }
        else ErrorMessage = err;
        
        await LoadData();
        IsProcessing = false;
    }

    private async Task ApproveProfileRequest(int id)
    {
        IsProcessing = true;
        ErrorMessage = null;
        SuccessMessage = null;
        string? err = await ApprovalService.ApproveProfileRequestAsync(id, CurrentUserId, UserRole);
        if (err != null) ErrorMessage = err; else SuccessMessage = "Profile request approved.";
        await LoadData();
        IsProcessing = false;
    }

    private async Task RejectProfileRequest(int id)
    {
        IsProcessing = true;
        ErrorMessage = null;
        SuccessMessage = null;
        string? err = await ApprovalService.RejectProfileRequestAsync(id, CurrentUserId, UserRole);
        if (err != null) ErrorMessage = err; else SuccessMessage = "Profile request rejected.";
        await LoadData();
        IsProcessing = false;
    }
}