@page "/Reports/Peminjaman"
@using UT_WMSDotnet.Models
@using WMS_UnitedTracors_Blazor.Services
@inject ReportService ReportService
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>Laporan Peminjaman</PageTitle>

<div class="py-12 bg-[#f5f4f0] min-h-screen print:bg-white print:py-0">
    <div class="max-w-7xl mx-auto sm:px-6 lg:px-8">
        
        <div class="flex items-center justify-between mb-6 print:hidden">
            <h2 class="font-semibold text-xl text-gray-800 leading-tight">
                Laporan Peminjaman
            </h2>
            <button @onclick="PrintReport" class="px-4 py-2 bg-[#e8a000] text-[#1a1a1a] text-sm font-bold rounded-md hover:bg-[#c98d00] transition">
                Cetak PDF
            </button>
        </div>

        @* Print Header *@
        <div class="hidden print:block mb-8 text-center border-b pb-4">
            <h1 class="text-2xl font-bold text-black uppercase tracking-wider">Laporan Peminjaman</h1>
            <p class="text-sm text-gray-600 mt-1">Periode: @StartDate.ToString("dd/MM/yyyy") - @EndDate.ToString("dd/MM/yyyy")</p>
            <p class="text-xs text-gray-500">Dicetak pada: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
        </div>

        <div class="bg-white border border-[#e5e3dc] rounded-lg shadow-sm p-6 mb-8 print:border-none print:shadow-none print:p-0">
            <div class="flex flex-wrap items-end gap-4 print:hidden">
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Start Date</label>
                    <input type="date" @bind="StartDate" class="rounded-md border-gray-300 shadow-sm focus:border-[#e8a000] focus:ring-[#e8a000] sm:text-sm">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">End Date</label>
                    <input type="date" @bind="EndDate" class="rounded-md border-gray-300 shadow-sm focus:border-[#e8a000] focus:ring-[#e8a000] sm:text-sm">
                </div>
                <div>
                    <button type="button" @onclick="ApplyFilter" class="px-4 py-2.5 bg-[#1a1a1a] text-white text-sm font-semibold rounded-md shadow-sm hover:bg-gray-800 transition">Apply</button>
                </div>
            </div>

            <div class="mt-6 overflow-x-auto">
                <table class="w-full text-left whitespace-nowrap print:text-xs">
                    <thead class="text-gray-500 text-[0.65rem] uppercase tracking-wider border-b border-gray-100 bg-gray-50 print:bg-white print:border-black print:text-black">
                        <tr>
                            <th class="px-4 py-3 font-semibold print:px-2">Date</th>
                            <th class="px-4 py-3 font-semibold print:px-2">No. Transaksi</th>
                            <th class="px-4 py-3 font-semibold print:px-2">Nama Pemohon</th>
                            <th class="px-4 py-3 font-semibold print:px-2">NRP</th>
                            <th class="px-4 py-3 font-semibold print:px-2">Divisi</th>
                            <th class="px-4 py-3 font-semibold print:px-2">Event</th>
                            <th class="px-4 py-3 font-semibold print:px-2">Item</th>
                            <th class="px-4 py-3 font-semibold print:px-2">Qty</th>
                            <th class="px-4 py-3 font-semibold print:px-2">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 print:divide-black">
                        @if (Transactions != null && Transactions.Any())
                        {
                            @foreach (var item in Transactions)
                            {
                                <tr class="hover:bg-gray-50 transition print:hover:bg-white">
                                    <td class="px-4 py-3 text-sm text-gray-600 print:px-2 print:text-black">@item.created_at.ToString("dd/MM/yyyy")</td>
                                    <td class="px-4 py-3 text-sm text-gray-900 font-mono print:px-2 print:text-black">@item.group_id</td>
                                    <td class="px-4 py-3 text-sm text-gray-900 font-bold print:px-2 print:text-black">@item.applicant_name</td>
                                    <td class="px-4 py-3 text-sm text-gray-600 print:px-2 print:text-black">@item.applicant_nrp</td>
                                    <td class="px-4 py-3 text-sm text-gray-600 print:px-2 print:text-black">@(item.Division?.name ?? "-")</td>
                                    <td class="px-4 py-3 text-sm text-gray-600 print:px-2 print:text-black">@item.event_name</td>
                                    <td class="px-4 py-3 print:px-2">
                                        <div class="text-sm font-semibold text-gray-900 print:text-black">@(item.Product?.name)</div>
                                        <div class="text-xs text-gray-500 print:text-black">@(item.Product?.sku)</div>
                                    </td>
                                    <td class="px-4 py-3 text-sm font-bold text-gray-900 print:px-2 print:text-black">@item.quantity</td>
                                    <td class="px-4 py-3 print:px-2">
                                        @if (item.status == "PENDING")
                                        {
                                            <span class="inline-flex items-center px-2 py-0.5 border border-[#fde68a] rounded-md text-[0.65rem] font-bold bg-[#fef3c7] text-[#92400e] print:border-none print:bg-transparent print:text-black">WAITING</span>
                                        }
                                        else if (item.status == "APPROVED")
                                        {
                                            <span class="inline-flex items-center px-2 py-0.5 border border-[#b8e8c0] rounded-md text-[0.65rem] font-bold bg-[#eef9f0] text-[#1a7a30] print:border-none print:bg-transparent print:text-black">APPROVED</span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center px-2 py-0.5 border border-[#f8c0c0] rounded-md text-[0.65rem] font-bold bg-[#fef0f0] text-[#d94040] print:border-none print:bg-transparent print:text-black">REJECTED</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="px-6 py-8 text-center text-gray-500">No records found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            <div class="mt-4 print:hidden">
                @if (TotalPages > 1)
                {
                    <div class="flex justify-center gap-2">
                        <button @onclick="PrevPage" disabled="@(CurrentPage == 1)" class="px-3 py-1 bg-white border border-gray-300 rounded text-sm disabled:opacity-50">Prev</button>
                        <span class="px-3 py-1 text-sm font-medium">Page @CurrentPage of @TotalPages</span>
                        <button @onclick="NextPage" disabled="@(CurrentPage == TotalPages)" class="px-3 py-1 bg-white border border-gray-300 rounded text-sm disabled:opacity-50">Next</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private DateTime StartDate = DateTime.Now.AddMonths(-1).Date;
    private DateTime EndDate = DateTime.Now.Date;
    
    private List<Transaction>? Transactions;
    private int CurrentPage = 1;
    private int TotalPages = 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        var data = await ReportService.GetReportDataAsync("OUT", "BORROW", StartDate, EndDate, null, null, CurrentPage, 20);
        Transactions = data.Transactions;
        TotalPages = data.TotalPages;
    }

    private async Task ApplyFilter()
    {
        CurrentPage = 1;
        await LoadData();
    }

    private async Task PrevPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
            await LoadData();
        }
    }

    private async Task NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            CurrentPage++;
            await LoadData();
        }
    }

    private async Task PrintReport()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }
}
