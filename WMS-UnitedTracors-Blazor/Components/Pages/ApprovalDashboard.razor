                        <span class="text-[#8a8880] text-xs font-semibold">@firstItem.created_at.ToString("dd MMM yyyy HH:mm")</span>
                        <span class="px-2.5 py-0.5 rounded-full bg-[#e8a000]/10 border border-[#e8a000]/20 text-[10px] text-[#e8a000] font-black shrink-0">@group.Value.Count Item</span>
