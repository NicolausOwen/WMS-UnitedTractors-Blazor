@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using UT_WMSDotnet.Models
@using WMS_UnitedTracors_Blazor.Services
@implements IDisposable
@inject DashboardService DashboardService
@inject CartService CartService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Dashboard</PageTitle>

<div class="w-full min-h-screen bg-[#f5f4f0] px-4 md:px-10 py-6 pb-24 md:pb-12 font-sans">
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="mb-6 flex items-center gap-3 bg-[#fef0f0] border border-[#f8c0c0] text-[#d94040] px-4 py-3 rounded-lg text-sm font-semibold">
            <svg class="w-4 h-4 shrink-0 text-[#d94040]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            @ErrorMessage
        </div>
    }

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
        <div class="bg-white border border-[#e5e3dc] rounded-[10px] p-5 sm:px-6">
            <p class="text-[0.65rem] font-bold tracking-[0.12em] uppercase text-[#8a8880] mb-1.5">Total Items</p>
            <p class="font-sans text-4xl font-bold text-[#1a1a1a] leading-none">@WidgetTotalItems</p>
        </div>
        <div class="bg-white border border-[#e5e3dc] rounded-[10px] p-5 sm:px-6">
            <p class="text-[0.65rem] font-bold tracking-[0.12em] uppercase text-[#8a8880] mb-1.5">Total Stock</p>
            <p class="font-sans text-4xl font-bold text-[#1a1a1a] leading-none">@TotalStock</p>
        </div>
        <div class="bg-white border border-[#e5e3dc] rounded-[10px] p-5 sm:px-6">
            <p class="text-[0.65rem] font-bold tracking-[0.12em] uppercase text-[#8a8880] mb-1.5">Pending Approval</p>
            <div class="flex items-center gap-2">
                <p class="font-sans text-4xl font-bold text-[#1a1a1a] leading-none">@PendingApprovals</p>
                @if (PendingApprovals > 0)
                {
                    <span class="inline-flex items-center px-[0.55rem] py-[0.15rem] bg-[#fef3c7] border border-[#fde68a] text-[#92400e] text-[0.62rem] font-bold rounded-[5px] tracking-[0.04em]">Needs review</span>
                }
            </div>
        </div>
    </div>

    <div class="bg-white border border-[#e5e3dc] rounded-xl overflow-hidden shadow-sm">
        <div class="px-6 py-4 border-b border-[#f0ede5] flex flex-col gap-4">
            <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
                <div>
                    <h3 class="text-xl font-bold text-[#1a1a1a]">Product Catalog</h3>
                    <p class="text-[1rem] text-[#8a8880] mt-0.5">Daftar barang yang tersedia di gudang</p>
                </div>
            </div>

            @if (Categories != null && Categories.Any())
            {
                <div class="flex items-center gap-2 mt-4 overflow-x-auto pb-1">
                    <button @onclick="() => FilterByCategory(null)"
                            class="px-3 py-1 bg-white border border-[#e5e3dc] hover:border-[#1a1a1a] text-xs font-semibold text-[#5a5855] hover:text-[#1a1a1a] rounded-full transition cursor-pointer shrink-0 @(!SelectedCategoryId.HasValue ? "!bg-[#1a1a1a] !border-[#1a1a1a] !text-white hover:!text-white" : "")">
                        All
                    </button>
                    @foreach (var cat in Categories)
                    {
                        <button @onclick="() => FilterByCategory(cat.id)"
                                class="px-3 py-1 bg-white border border-[#e5e3dc] hover:border-[#1a1a1a] text-xs font-semibold text-[#5a5855] hover:text-[#1a1a1a] rounded-full transition cursor-pointer shrink-0 @(SelectedCategoryId == cat.id ? "!bg-[#1a1a1a] !border-[#1a1a1a] !text-white hover:!text-white" : "")">
                            @cat.name
                        </button>
                    }
                </div>
            }
        </div>

        @if (CatalogProducts == null)
        {
            <div class="p-8 text-center text-gray-500">Loading catalog...</div>
        }
        else if (CatalogProducts.Any())
        {
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 p-4">
                @foreach (var product in CatalogProducts)
                {
                    <div @onclick="() => OpenProductModal(product)" class="bg-white border border-[#e5e3dc] rounded-xl overflow-hidden shadow-sm hover:shadow-lg hover:-translate-y-1 hover:border-[#e8a000] transition-all duration-300 flex flex-col group cursor-pointer text-left focus:outline-none focus:ring-2 focus:ring-[#e8a000]" tabindex="0" role="button">
                        <div class="aspect-square relative bg-[#f5f4f0] flex items-center justify-center overflow-hidden border-b border-[#f0ede5]">
                            @if (!string.IsNullOrEmpty(product.image))
                            {
                                <img src="/storage/@product.image" alt="@product.name" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                            }
                            @if (product.current_stock <= 0)
                            {
                                <div class="absolute top-2 left-2 flex flex-col gap-1">
                                    <span class="px-2 py-0.5 bg-[#fef0f0] border border-[#f8c0c0] text-[#d94040] text-[0.6rem] font-bold rounded shadow-sm tracking-wider uppercase">Habis</span>
                                </div>
                            }
                        </div>
                        
                        <div class="p-3.5 flex flex-col flex-grow">
                            <div class="flex items-center justify-between gap-1 mb-1.5">
                                <span class="text-[0.65rem] font-bold text-[#8a8880] truncate group-hover:text-[#e8a000] transition-colors">
                                    @(product.Category?.name ?? "--")
                                </span>
                                <code class="text-[0.55rem] font-medium text-[#8a8880] bg-[#f0ede5] px-1.5 py-0.5 rounded">@product.sku</code>
                            </div>
                            
                            <h4 class="text-base font-extrabold text-[#1a1a1a] leading-snug line-clamp-4 mb-3 flex-grow group-hover:text-[#e8a000] transition-colors" title="@product.name">
                                @product.name
                            </h4>
                            
                            <div class="mt-auto">
                                <div class="flex items-center justify-between text-xs pb-1 border-b border-transparent">
                                    <div class="flex flex-col gap-0.5">
                                        <span class="text-[#8a8880] text-[0.65rem]">Kredit</span>
                                        <span class="font-bold text-[#e8a000]">@product.value <span class="font-normal text-[0.65rem] text-[#8a8880]">pts</span></span>
                                    </div>
                                    <div class="flex flex-col gap-0.5 text-right">
                                        <span class="text-[#8a8880] text-[0.65rem]">Stok</span>
                                        <span class="font-bold @(product.current_stock <= 0 ? "text-[#d94040]" : "text-[#1a7a30]")">
                                            @product.current_stock <span class="font-normal text-[0.65rem] text-[#8a8880]">@(product.Unit?.name ?? "unit")</span>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            
            @if (TotalPages > 1)
            {
                <div class="px-6 py-4 border-t border-gray-100 flex items-center justify-between bg-white">
                    <span class="text-sm text-gray-500">Showing page @CurrentPage of @TotalPages</span>
                    <div class="flex gap-2">
                        <button disabled="@(CurrentPage == 1)" @onclick="() => LoadData(CurrentPage - 1)" class="px-3 py-1 border rounded hover:bg-gray-50 disabled:opacity-50">Previous</button>
                        <button disabled="@(CurrentPage == TotalPages)" @onclick="() => LoadData(CurrentPage + 1)" class="px-3 py-1 border rounded hover:bg-gray-50 disabled:opacity-50">Next</button>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="px-6 py-16 text-center">
                <p class="text-[0.85rem] text-[#8a8880]">No products found.</p>
            </div>
        }
    </div>
</div>

@if (ShowProductModal && SelectedProduct != null)
{
    <div class="fixed inset-0 z-[70] flex min-h-full items-center justify-center p-4 text-center">
        <div class="fixed inset-0 backdrop-blur-sm bg-[#1a1a1a]/65 transition-opacity" @onclick="CloseProductModal"></div>
        <div class="relative transform overflow-hidden rounded-xl bg-white text-left shadow-2xl transition-all w-full max-w-2xl border border-[#e5e3dc] z-10">
            <div class="px-5 py-4 border-b border-[#f0ede5] flex items-center justify-between">
                <h3 class="font-bold text-[#1a1a1a] text-sm">Detail Produk</h3>
                <button type="button" @onclick="CloseProductModal" class="text-[#a09e99] hover:text-[#1a1a1a] transition p-1 bg-[#f5f4f0] rounded-full">
                    X
                </button>
            </div>
            <div class="px-5 py-4 pb-4">
                <div class="flex gap-4 mb-4">
                    <div class="w-1/3 aspect-square bg-gray-100 rounded-lg overflow-hidden flex items-center justify-center">
                        @if (!string.IsNullOrEmpty(SelectedProduct.image))
                        {
                            <img src="/storage/@SelectedProduct.image" class="w-full h-full object-cover" />
                        }
                    </div>
                    <div class="w-2/3">
                        <h4 class="text-lg font-bold">@SelectedProduct.name</h4>
                        <p class="text-xs text-gray-500 mb-2">SKU: @SelectedProduct.sku</p>
                        <p class="text-sm font-semibold text-yellow-600 mb-2">@SelectedProduct.value pts</p>
                        <p class="text-sm">Stok Tersedia: <b>@SelectedProduct.current_stock</b> @(SelectedProduct.Unit?.name ?? "unit")</p>
                        
                        <div class="mt-4">
                            <label class="block text-xs font-semibold mb-1">Tipe Request</label>
                            <select @bind="SelectedRequestType" class="w-full border rounded p-2 text-sm">
                                <option value="BORROW">Pinjam (Borrow)</option>
                                <option value="GIVEAWAY">Minta (Giveaway)</option>
                            </select>
                        </div>
                        
                        <div class="mt-4">
                            <label class="block text-xs font-semibold mb-1">Jumlah</label>
                            <input type="number" @bind="SelectedQuantity" min="1" max="@SelectedProduct.current_stock" class="w-full border rounded p-2 text-sm" />
                        </div>
                    </div>
                </div>
                <div class="border-t pt-4 flex justify-between items-center">
                    <div>
                        <span class="text-xs text-gray-500">Total Kredit</span>
                        <div class="font-bold">@(SelectedRequestType == "GIVEAWAY" ? SelectedProduct.value * SelectedQuantity : 0) pts</div>
                    </div>
                    <button @onclick="AddToCart" class="px-6 py-2 bg-yellow-500 hover:bg-yellow-600 text-black font-bold rounded-lg transition">
                        + Keranjang
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (CartService.Items.Any())
{
    <button @onclick='() => Navigation.NavigateTo("/Borrow")' class="fixed bottom-8 right-8 z-50 flex items-center justify-center w-14 h-14 bg-yellow-500 hover:bg-yellow-600 rounded-full shadow-2xl transition-transform border-4 border-white">
        🛒
        <span class="absolute -top-1.5 -right-1.5 inline-flex items-center justify-center min-w-[1.4rem] h-[1.4rem] px-1 bg-red-500 text-white text-xs font-bold rounded-full shadow-sm border-2 border-white">@CartService.Items.Sum(i => i.Quantity)</span>
    </button>
}

@code {
    private int WidgetTotalItems = 0;
    private int PendingApprovals = 0;
    private int TotalStock = 0;
    
    private List<Category>? Categories;
    private List<Division>? Divisions;
    private List<Product>? CatalogProducts;
    private List<Transaction>? ActiveBorrows;
    
    private int CurrentPage = 1;
    private int PageSize = 12;
    private int TotalPages = 1;
    private int TotalItems = 0;
    
    private int? SelectedCategoryId;
    private string? ErrorMessage;
    
    private bool ShowProductModal = false;
    private Product? SelectedProduct;
    private int SelectedQuantity = 1;
    private string SelectedRequestType = "BORROW";
    
    private int CurrentUserId = 0;
    private string? UserRole;

    protected override async Task OnInitializedAsync()
    {
        CartService.OnChange += StateHasChanged;
        
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            var idClaim = user.FindFirst(ClaimTypes.NameIdentifier);
            if (idClaim != null && int.TryParse(idClaim.Value, out int id))
            {
                CurrentUserId = id;
            }
            UserRole = user.FindFirst(ClaimTypes.Role)?.Value;
        }

        await LoadData(1);
    }

    private async Task LoadData(int page)
    {
        CurrentPage = page;
        
        var data = await DashboardService.GetDashboardDataAsync(SelectedCategoryId, CurrentPage, PageSize);
        
        WidgetTotalItems = data.WidgetTotalItems;
        PendingApprovals = data.PendingApprovals;
        TotalStock = data.TotalStock;
        Categories = data.Categories;
        Divisions = data.Divisions;
        CatalogProducts = data.CatalogProducts;
        TotalItems = data.TotalItems;
        TotalPages = data.TotalPages;

        if (CurrentUserId > 0)
        {
            ActiveBorrows = await DashboardService.GetActiveBorrowsAsync(CurrentUserId, UserRole);
        }
    }

    private async Task FilterByCategory(int? categoryId)
    {
        SelectedCategoryId = categoryId;
        await LoadData(1);
    }
    
    private void OpenProductModal(Product product)
    {
        SelectedProduct = product;
        SelectedQuantity = 1;
        SelectedRequestType = product.is_returnable == 1 ? "BORROW" : "GIVEAWAY";
        ShowProductModal = true;
    }
    
    private void CloseProductModal()
    {
        ShowProductModal = false;
        SelectedProduct = null;
    }
    
    private void AddToCart()
    {
        if (SelectedProduct != null && SelectedQuantity > 0)
        {
            if (SelectedQuantity > SelectedProduct.current_stock)
            {
                ErrorMessage = "Stok tidak mencukupi.";
                return;
            }
            
            CartService.AddToCart(new CartItem
            {
                Sku = SelectedProduct.sku ?? "",
                Name = SelectedProduct.name ?? "",
                Quantity = SelectedQuantity,
                RequestType = SelectedRequestType,
                BaseCredit = SelectedProduct.value,
                MaxStock = SelectedProduct.current_stock,
                UnitName = SelectedProduct.Unit?.name ?? "unit"
            });
            CloseProductModal();
        }
    }
    
    public void Dispose()
    {
        CartService.OnChange -= StateHasChanged;
    }
}
