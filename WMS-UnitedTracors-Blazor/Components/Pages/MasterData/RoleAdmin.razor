@page "/MasterData/RoleAdmin"
@using UT_WMSDotnet.ViewModels
@using WMS_UnitedTracors_Blazor.Services
@inject AdminRoleService AdminRoleService
@inject NavigationManager Navigation
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>Role Admin Management</PageTitle>

<div class="py-8 bg-[#f5f4f0] min-h-screen">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="flex justify-between items-center mb-6">
            <h2 class="font-semibold text-xl text-gray-800 leading-tight font-syne">
                Manage Role Admin
            </h2>
            <button type="button" @onclick="OpenAddModal" class="px-4 py-2 bg-[#e8a000] hover:bg-[#d49300] text-[#1a1a1a] text-xs font-bold rounded-lg transition active:scale-95 cursor-pointer flex items-center gap-1.5 shadow-sm">
                <svg class="w-4 h-4 stroke-current fill-none stroke-[2]" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Add Role
            </button>
        </div>

        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="mb-6 flex items-center gap-3 bg-[#eef9f0] border border-[#b8e8c0] text-[#1a7a30] px-4 py-3 rounded-lg text-sm" role="alert">
                <svg class="w-4 h-4 shrink-0 text-[#1a7a30]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                @SuccessMessage
            </div>
        }
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="mb-6 flex items-center gap-3 bg-[#fef0f0] border border-[#f8c0c0] text-[#d94040] px-4 py-3 rounded-lg text-sm" role="alert">
                <svg class="w-4 h-4 shrink-0 text-[#d94040]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                @ErrorMessage
            </div>
        }

        @* Search and Pagination Controls *@
        <div class="bg-white p-4 rounded-xl border border-[#e5e3dc] shadow-sm mb-6 flex flex-col sm:flex-row justify-between items-center gap-4">
            <div class="relative w-full sm:w-80">
                <input type="text" @bind="SearchQuery" @bind:event="oninput" @onkeyup="OnSearchKeyUp" placeholder="Search roles..."
                       class="block w-full pl-9 pr-4 py-2 text-xs bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none transition-colors duration-150 text-[#1a1a1a]">
                <div class="absolute left-3 top-2.5 text-gray-400">
                    <svg class="w-4 h-4 stroke-current fill-none stroke-[2]" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                </div>
            </div>
            <div class="flex items-center gap-2 text-xs text-gray-500">
                <span>Sorted by <b>@SortColumn</b> (@(SortDescending ? "Desc" : "Asc"))</span>
            </div>
        </div>

        @* Roles Table *@
        <div class="bg-transparent md:bg-white md:rounded-xl md:border md:border-[#e5e3dc] md:overflow-hidden md:shadow-sm">
            <!-- Desktop Table View -->
            <div class="hidden md:block overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-[#1a1a1a]">
                            <th class="px-6 py-3.5 text-[0.68rem] font-bold tracking-wider uppercase text-[#c8c5bc] w-12">#</th>
                            <th class="px-6 py-3.5 text-[0.68rem] font-bold tracking-wider uppercase text-[#c8c5bc] cursor-pointer hover:text-white" @onclick='() => TriggerSort("RoleName")'>
                                Role Name @GetSortIcon("RoleName")
                            </th>
                            <th class="px-6 py-3.5 text-[0.68rem] font-bold tracking-wider uppercase text-[#c8c5bc] cursor-pointer hover:text-white" @onclick='() => TriggerSort("Description")'>
                                Description @GetSortIcon("Description")
                            </th>
                            <th class="px-6 py-3.5 text-[0.68rem] font-bold tracking-wider uppercase text-[#c8c5bc] w-28 text-center">
                                Total User
                            </th>
                            <th class="px-6 py-3.5 text-[0.68rem] font-bold tracking-wider uppercase text-[#c8c5bc] cursor-pointer hover:text-white w-28 text-center" @onclick='() => TriggerSort("IsActive")'>
                                Status @GetSortIcon("IsActive")
                            </th>
                            <th class="px-6 py-3.5 text-[0.68rem] font-bold tracking-wider uppercase text-[#c8c5bc] text-right w-44"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[#f0ede5]">
                        @if (RolesList == null || !RolesList.Any())
                        {
                            <tr>
                                <td colspan="6" class="px-6 py-16 text-center text-sm text-gray-500">
                                    No roles found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            int index = (CurrentPage - 1) * PageSize;
                            foreach (var role in RolesList)
                            {
                                index++;
                                <tr class="hover:bg-[#faf9f5] border-b border-[#f0ede5] transition-colors duration-100">
                                    <td class="px-6 py-4 text-sm text-gray-400 align-middle">@index</td>
                                    <td class="px-6 py-4 text-sm font-semibold text-[#1a1a1a] align-middle">@role.RoleName</td>
                                    <td class="px-6 py-4 text-sm text-gray-600 align-middle">@(role.Description ?? "--")</td>
                                    <td class="px-6 py-4 text-sm font-bold text-center align-middle">
                                        <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-[#f5f4f0] border border-[#e5e3dc] text-gray-700 text-xs">
                                            @role.TotalUser
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 text-center align-middle">
                                        @if (role.IsActive)
                                        {
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-[#eef9f0] border border-[#b8e8c0] text-[#1a7a30]">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-[#fef0f0] border border-[#f8c0c0] text-[#d94040]">
                                                Inactive
                                            </span>
                                        }
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap align-middle">
                                        <div class="flex items-center gap-2 justify-end">
                                            <button type="button" @onclick="() => NavigateToDetail(role.Id)"
                                                    class="text-xs font-bold text-[#e8a000] hover:text-[#d49300] px-3 py-1.5 rounded bg-[#fefaf0] border border-[#fbe8c0] transition cursor-pointer">
                                                View
                                            </button>
                                            <button type="button" @onclick="() => OpenEditModal(role)"
                                                    class="text-xs font-bold text-[#3a3835] hover:text-[#1a1a1a] px-3 py-1.5 rounded bg-white border border-[#e5e3dc] hover:bg-[#f0ede5] transition cursor-pointer">
                                                Edit
                                            </button>
                                            <button type="button" @onclick="() => DeleteRole(role)"
                                                    class="text-xs font-bold text-[#d94040] hover:text-[#b83535] px-3 py-1.5 rounded bg-[#fef0f0] border border-[#f8c0c0] hover:bg-[#fee2e2] transition cursor-pointer">
                                                Delete
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mobile Card View -->
            <div class="block md:hidden space-y-3">
                @if (RolesList == null || !RolesList.Any())
                {
                    <div class="px-6 py-16 text-center bg-white rounded-xl border border-[#e5e3dc] shadow-sm">
                        <p class="text-sm text-gray-500">No roles found.</p>
                    </div>
                }
                else
                {
                    int index = (CurrentPage - 1) * PageSize;
                    foreach (var role in RolesList)
                    {
                        index++;
                        <div class="p-5 bg-white border border-[#e5e3dc] rounded-xl shadow-sm hover:shadow transition-shadow space-y-3">
                            <div class="flex justify-between items-start">
                                <div>
                                    <span class="text-xs text-gray-400 font-bold">#@index</span>
                                    <h4 class="text-sm font-semibold text-[#1a1a1a] mt-0.5">@role.RoleName</h4>
                                </div>
                                @if (role.IsActive)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-[#eef9f0] border border-[#b8e8c0] text-[#1a7a30]">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-[#fef0f0] border border-[#f8c0c0] text-[#d94040]">
                                        Inactive
                                    </span>
                                }
                            </div>
                            <p class="text-xs text-gray-600">@(role.Description ?? "--")</p>
                            <div class="flex items-center justify-between pt-2 border-t border-[#f0ede5] text-xs">
                                <div>
                                    <span class="text-gray-400 font-medium">Total User:</span>
                                    <span class="font-bold text-gray-800 ml-1">@role.TotalUser</span>
                                </div>
                            </div>
                            <div class="flex items-center gap-2 pt-3 border-t border-[#f0ede5] justify-end">
                                <button type="button" @onclick="() => NavigateToDetail(role.Id)"
                                        class="flex-1 text-center text-xs font-bold text-[#e8a000] hover:text-[#d49300] py-2 rounded bg-[#fefaf0] border border-[#fbe8c0] transition cursor-pointer">
                                    View
                                </button>
                                <button type="button" @onclick="() => OpenEditModal(role)"
                                        class="flex-1 text-center text-xs font-bold text-[#3a3835] hover:text-[#1a1a1a] py-2 rounded bg-white border border-[#e5e3dc] hover:bg-[#f0ede5] transition cursor-pointer">
                                    Edit
                                </button>
                                <button type="button" @onclick="() => DeleteRole(role)"
                                        class="flex-1 text-center text-xs font-bold text-[#d94040] hover:text-[#b83535] py-2 rounded bg-[#fef0f0] border border-[#f8c0c0] hover:bg-[#fee2e2] transition cursor-pointer">
                                    Delete
                                </button>
                            </div>
                        </div>
                    }
                }
            </div>
            
            @if (TotalPages > 1)
            {
                <div class="mt-4 px-6 py-4 border border-[#e5e3dc] rounded-xl flex justify-between items-center bg-white shadow-sm">
                    <span class="text-xs text-[#8a8880]">Halaman @CurrentPage dari @TotalPages</span>
                    <div class="flex gap-2">
                        <button disabled="@(CurrentPage == 1)" @onclick="() => LoadData(CurrentPage - 1)" class="px-3 py-1 bg-white border border-[#e5e3dc] rounded text-sm disabled:opacity-50 hover:bg-gray-50">Prev</button>
                        <button disabled="@(CurrentPage == TotalPages)" @onclick="() => LoadData(CurrentPage + 1)" class="px-3 py-1 bg-white border border-[#e5e3dc] rounded text-sm disabled:opacity-50 hover:bg-gray-50">Next</button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@* Add/Edit Dialog Modal *@
@if (ShowModal)
{
    <div class="fixed inset-0 z-[1050] flex items-center justify-center bg-black/50 backdrop-blur-[2px] transition-opacity duration-300">
        <div class="bg-white rounded-2xl border border-[#e5e3dc] shadow-2xl w-full max-w-md mx-4 overflow-hidden transform transition-all scale-100 duration-300">
            <div class="px-6 py-4 border-b border-[#f0ede5] bg-[#faf9f5] flex justify-between items-center">
                <h3 class="text-sm font-bold text-[#1a1a1a] font-syne">@(IsEditMode ? "Edit Role Admin" : "Add New Role Admin")</h3>
                <button type="button" @onclick="CloseModal" class="text-gray-400 hover:text-gray-600 transition cursor-pointer">
                    <svg class="w-5 h-5 stroke-current fill-none stroke-[2]" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
            
            <form @onsubmit="SaveRole">
                <div class="p-6 space-y-4">
                    @if (!string.IsNullOrEmpty(ModalErrorMessage))
                    {
                        <div class="flex items-center gap-2 bg-[#fef0f0] border border-[#f8c0c0] text-[#d94040] p-3 rounded-lg text-xs" role="alert">
                            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            @ModalErrorMessage
                        </div>
                    }

                    <div>
                        <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Role Name</label>
                        <input type="text" @bind="Model.RoleName" required placeholder="Role Name (e.g. PIC Studio)"
                               class="block w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none transition-colors duration-150 text-[#1a1a1a]">
                    </div>

                    <div>
                        <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Description</label>
                        <textarea @bind="Model.Description" placeholder="Description (optional)" rows="3"
                                  class="block w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none transition-colors duration-150 text-[#1a1a1a] resize-none"></textarea>
                    </div>

                    <div class="flex items-center gap-3">
                        <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880]">Status</label>
                        <div class="flex items-center gap-4">
                            <label class="inline-flex items-center text-xs text-gray-700 cursor-pointer">
                                <input type="radio" checked="@Model.IsActive" @onclick="() => Model.IsActive = true" class="mr-1.5 accent-[#e8a000]"> Active
                            </label>
                            <label class="inline-flex items-center text-xs text-gray-700 cursor-pointer">
                                <input type="radio" checked="@(!Model.IsActive)" @onclick="() => Model.IsActive = false" class="mr-1.5 accent-[#e8a000]"> Inactive
                            </label>
                        </div>
                    </div>
                </div>

                <div class="px-6 py-4 border-t border-[#f0ede5] bg-[#faf9f5] flex justify-end gap-2">
                    <button type="button" @onclick="CloseModal" class="px-4 py-2 bg-white border border-[#e5e3dc] hover:bg-[#f0ede5] text-[#3a3835] text-xs font-bold rounded-lg transition cursor-pointer">Cancel</button>
                    <button type="submit" class="px-4 py-2 bg-[#e8a000] hover:bg-[#d49300] text-[#1a1a1a] text-xs font-bold rounded-lg transition active:scale-95 cursor-pointer">
                        @(IsEditMode ? "Save Changes" : "Create Role")
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@code {
    private List<AdminRoleDto>? RolesList;
    private int CurrentPage = 1;
    private int TotalPages = 1;
    private int PageSize = 10;

    private string SearchQuery = "";
    private string SortColumn = "RoleName";
    private bool SortDescending = false;

    private AdminRoleViewModel Model = new();
    private Guid EditingRoleId;

    private string? SuccessMessage;
    private string? ErrorMessage;
    private string? ModalErrorMessage;

    private bool ShowModal = false;
    private bool IsEditMode = false;
    private string CurrentUsername = "System";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        

        if (!user.HasPermission(WMS_UnitedTracors_Blazor.Helpers.Permissions.RolesManage))
        {
            Navigation.NavigateTo("/");
            return;
        }

        CurrentUsername = user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "System";
        await LoadData(1);
    }

    private async Task LoadData(int page)
    {
        CurrentPage = page;
        var result = await AdminRoleService.GetAdminRolesAsync(SearchQuery, SortColumn, SortDescending, CurrentPage, PageSize);
        RolesList = result.Roles;
        TotalPages = result.TotalPages;
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        await LoadData(1);
    }

    private async Task TriggerSort(string columnName)
    {
        if (SortColumn == columnName)
        {
            SortDescending = !SortDescending;
        }
        else
        {
            SortColumn = columnName;
            SortDescending = false;
        }
        await LoadData(1);
    }

    private RenderFragment GetSortIcon(string columnName)
    {
        if (SortColumn != columnName) return@<span class="text-gray-400 opacity-20">↕</span>;
        return SortDescending ?@<span class="text-[#e8a000]">↓</span>:@<span class="text-[#e8a000]">↑</span>;
    }

    private void OpenAddModal()
    {
        Model = new AdminRoleViewModel { IsActive = true };
        IsEditMode = false;
        ModalErrorMessage = null;
        ShowModal = true;
    }

    private void OpenEditModal(AdminRoleDto role)
    {
        EditingRoleId = role.Id;
        Model = new AdminRoleViewModel
        {
            RoleName = role.RoleName,
            Description = role.Description,
            IsActive = role.IsActive
        };
        IsEditMode = true;
        ModalErrorMessage = null;
        ShowModal = true;
    }

    private void CloseModal()
    {
        ShowModal = false;
    }

    private async Task SaveRole()
    {
        if (string.IsNullOrWhiteSpace(Model.RoleName))
        {
            ModalErrorMessage = "Role Name wajib diisi.";
            return;
        }

        ModalErrorMessage = null;
        string? error;

        if (IsEditMode)
        {
            error = await AdminRoleService.UpdateAdminRoleAsync(EditingRoleId, Model, CurrentUsername);
        }
        else
        {
            error = await AdminRoleService.CreateAdminRoleAsync(Model, CurrentUsername);
        }

        if (error != null)
        {
            ModalErrorMessage = error;
        }
        else
        {
            SuccessMessage = IsEditMode ? "Role admin berhasil diperbarui." : "Role admin baru berhasil ditambahkan.";
            ShowModal = false;
            await LoadData(CurrentPage);
        }
    }

    private async Task DeleteRole(AdminRoleDto role)
    {
        ErrorMessage = null;
        SuccessMessage = null;

        if (role.TotalUser > 0)
        {
            ErrorMessage = "Role cannot be deleted because it is assigned to one or more users.";
            return;
        }

        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Apakah Anda yakin ingin menghapus Role \"{role.RoleName}\"?");
        if (confirmed)
        {
            var error = await AdminRoleService.DeleteAdminRoleAsync(role.Id);
            if (error != null)
            {
                ErrorMessage = error;
            }
            else
            {
                SuccessMessage = "Role admin berhasil dihapus.";
                await LoadData(CurrentPage);
            }
        }
    }

    private void NavigateToDetail(Guid id)
    {
        Navigation.NavigateTo($"/MasterData/RoleAdmin/{id}");
    }
}
