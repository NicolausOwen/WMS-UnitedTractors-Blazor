@page "/Unit"
@using UT_WMSDotnet.Models
@using UT_WMSDotnet.ViewModels
@using WMS_UnitedTracors_Blazor.Services
@using WMS_UnitedTracors_Blazor.Components.Shared
@inject UnitService UnitService
@inject ProductService ProductService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>Units</PageTitle>

<div class="py-8 bg-[#f5f4f0] min-h-screen">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="flex justify-between items-center mb-6">
            <h2 class="font-semibold text-xl text-gray-800 leading-tight font-syne">
                Manage Units
            </h2>
        </div>

        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="mb-6 flex items-center gap-3 bg-[#eef9f0] border border-[#b8e8c0] text-[#1a7a30] px-4 py-3 rounded-lg text-sm" role="alert">
                <svg class="w-4 h-4 shrink-0 text-[#1a7a30]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                @SuccessMessage
            </div>
        }
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="mb-6 flex items-center gap-3 bg-[#fef0f0] border border-[#f8c0c0] text-[#d94040] px-4 py-3 rounded-lg text-sm" role="alert">
                <svg class="w-4 h-4 shrink-0 text-[#d94040]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                @ErrorMessage
            </div>
        }

        @* Add Unit *@
        @if (IsSuperAdmin)
        {
            <div class="bg-white rounded-xl border border-[#e5e3dc] mb-6 overflow-hidden shadow-sm">
                <div class="px-6 py-4 border-b border-[#f0ede5] bg-[#faf9f5]">
                    <h3 class="text-sm font-bold text-[#1a1a1a] font-syne">Add New Unit</h3>
                </div>
                <div class="px-6 py-5">
                    <form @onsubmit="SaveUnit" class="flex flex-col sm:flex-row gap-3">
                        <div class="flex-1">
                            <input type="text" @bind="Model.name" required placeholder="Unit name (e.g. pcs, pack, set)"
                                   class="block w-full px-3.5 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none transition-colors duration-150 text-[#1a1a1a]">
                        </div>
                        <button type="submit" class="px-5 py-2 bg-[#e8a000] hover:bg-[#d49300] text-[#1a1a1a] text-xs font-bold rounded-lg transition active:scale-95 cursor-pointer whitespace-nowrap">
                            Add Unit
                        </button>
                    </form>
                </div>
            </div>
        }

        @* Units List *@
        <div class="bg-transparent md:bg-white md:rounded-xl md:border md:border-[#e5e3dc] md:overflow-hidden md:shadow-sm">
            <!-- Desktop Table View -->
            <div class="hidden md:block overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-[#1a1a1a]">
                            <th class="px-6 py-3.5 text-[0.68rem] font-bold tracking-wider uppercase text-[#c8c5bc] w-12">#</th>
                            <th class="px-6 py-3.5 text-[0.68rem] font-bold tracking-wider uppercase text-[#c8c5bc]">Name</th>
                            <th class="px-6 py-3.5 text-[0.68rem] font-bold tracking-wider uppercase text-[#c8c5bc]">Products</th>
                            @if (IsSuperAdmin)
                            {
                                <th class="px-6 py-3.5 text-[0.68rem] font-bold tracking-wider uppercase text-[#c8c5bc] w-32"></th>
                            }
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[#f0ede5]">
                        @if (UnitsList == null || !UnitsList.Any())
                        {
                            <tr>
                                <td colspan="@(IsSuperAdmin ? 4 : 3)" class="px-6 py-16 text-center">
                                    <p class="text-sm text-gray-500">No units yet.</p>
                                    @if (IsSuperAdmin)
                                    {
                                        <p class="text-xs text-gray-400 mt-1">Add a unit above to organize your products' measurements.</p>
                                    }
                                </td>
                            </tr>
                        }
                        else
                        {
                            int index = (CurrentPage - 1) * 10;
                            foreach (var unit in UnitsList)
                            {
                                index++;
                                bool isEditing = EditingUnitId == unit.Id;
                                
                                <tr class="@(isEditing ? "hidden" : "") hover:bg-[#faf9f5] border-b border-[#f0ede5] transition-colors duration-100">
                                    <td class="px-6 py-4 text-sm text-gray-400 align-middle">@index</td>
                                    <td class="px-6 py-4 text-sm font-semibold text-[#1a1a1a] whitespace-nowrap align-middle">@unit.Name</td>
                                    <td class="px-6 py-4 whitespace-nowrap align-middle">
                                        <span @onclick="() => OpenProductsModal(unit.Id, unit.Name)" class="inline-flex items-center px-2 py-0.5 rounded bg-[#eef9f0] border border-[#b8e8c0] text-[#1a7a30] hover:bg-[#1a7a30] hover:text-white transition cursor-pointer text-xs font-bold shadow-sm">
                                            @unit.ProductsCount
                                        </span>
                                        <span class="text-xs text-gray-400 ml-1">items</span>
                                    </td>
                                    @if (IsSuperAdmin)
                                    {
                                        <td class="px-6 py-4 whitespace-nowrap align-middle">
                                            <div class="flex items-center gap-2 justify-end">
                                                <button type="button" @onclick="() => StartEdit(unit)"
                                                        class="text-xs font-bold text-[#3a3835] hover:text-[#1a1a1a] px-3 py-1.5 rounded bg-white border border-[#e5e3dc] hover:bg-[#f0ede5] transition cursor-pointer">
                                                    Edit
                                                </button>
                                                <button type="button" @onclick="() => DeleteUnit(unit.Id)"
                                                        class="text-xs font-bold text-[#d94040] hover:text-[#b83535] px-3 py-1.5 rounded bg-[#fef0f0] border border-[#f8c0c0] hover:bg-[#fee2e2] transition cursor-pointer">
                                                    Delete
                                                </button>
                                            </div>
                                        </td>
                                    }
                                </tr>
                                
                                @if (IsSuperAdmin)
                                {
                                    <tr class="@(isEditing ? "" : "hidden") bg-[#faf9f5]">
                                        <td class="px-6 py-4" colspan="4">
                                            <form @onsubmit="() => UpdateUnit(unit.Id)" class="flex flex-col sm:flex-row gap-3 items-end">
                                                <div class="flex-1 w-full">
                                                    <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Name</label>
                                                    <input type="text" @bind="EditModel.name" required
                                                           class="block w-full px-3 py-1.5 text-xs bg-white border border-[#e5e3dc] focus:border-[#e8a000] focus:ring-0 rounded-lg outline-none text-[#1a1a1a] transition-all duration-150">
                                                </div>
                                                <div class="flex gap-2 w-full sm:w-auto">
                                                    <button type="submit" class="flex-1 sm:flex-none px-4 py-2 bg-[#e8a000] hover:bg-[#d49300] text-[#1a1a1a] text-xs font-bold rounded-lg transition cursor-pointer">Save</button>
                                                    <button type="button" @onclick="CancelEdit" class="flex-1 sm:flex-none px-4 py-2 bg-white border border-[#e5e3dc] hover:bg-[#f0ede5] text-[#3a3835] text-xs font-bold rounded-lg transition cursor-pointer">Cancel</button>
                                                </div>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mobile Card View -->
            <div class="block md:hidden space-y-3">
                @if (UnitsList == null || !UnitsList.Any())
                {
                    <div class="px-6 py-16 text-center bg-white rounded-xl border border-[#e5e3dc] shadow-sm">
                        <p class="text-sm text-gray-500">No units yet.</p>
                        @if (IsSuperAdmin)
                        {
                            <p class="text-xs text-gray-400 mt-1">Add a unit above to organize your products' measurements.</p>
                        }
                    </div>
                }
                else
                {
                    int index = (CurrentPage - 1) * 10;
                    foreach (var unit in UnitsList)
                    {
                        index++;
                        bool isEditing = EditingUnitId == unit.Id;
                        
                        @if (!isEditing)
                        {
                            <div class="p-5 bg-white border border-[#e5e3dc] rounded-xl shadow-sm hover:shadow transition-shadow">
                                <div class="flex justify-between items-start mb-2">
                                    <div>
                                        <span class="text-xs text-gray-400 font-bold">#@index</span>
                                        <h4 class="text-sm font-semibold text-[#1a1a1a] mt-0.5">@unit.Name</h4>
                                    </div>
                                    <span @onclick="() => OpenProductsModal(unit.Id, unit.Name)" class="cursor-pointer inline-flex items-center px-2 py-0.5 rounded bg-[#eef9f0] border border-[#b8e8c0] text-[#1a7a30] text-[10px] font-bold hover:bg-[#1a7a30] hover:text-white transition shadow-sm">
                                        @unit.ProductsCount items
                                    </span>
                                </div>
                                
                                @if (IsSuperAdmin)
                                {
                                    <div class="flex items-center gap-2 pt-3 border-t border-[#f0ede5] justify-end">
                                        <button type="button" @onclick="() => StartEdit(unit)"
                                                class="flex-1 text-center text-xs font-bold text-[#3a3835] hover:text-[#1a1a1a] py-2 rounded bg-white border border-[#e5e3dc] hover:bg-[#f0ede5] transition cursor-pointer">
                                            Edit
                                        </button>
                                        <button type="button" @onclick="() => DeleteUnit(unit.Id)"
                                                class="flex-1 text-center text-xs font-bold text-[#d94040] hover:text-[#b83535] py-2 rounded bg-[#fef0f0] border border-[#f8c0c0] hover:bg-[#fee2e2] transition cursor-pointer">
                                            Delete
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="p-5 bg-[#faf9f5] border border-[#e5e3dc] rounded-xl shadow-sm">
                                <form @onsubmit="() => UpdateUnit(unit.Id)" class="space-y-4">
                                    <div>
                                        <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1">Name</label>
                                        <input type="text" @bind="EditModel.name" required
                                               class="block w-full px-3 py-2 text-xs bg-white border border-[#e5e3dc] focus:border-[#e8a000] focus:ring-0 rounded-lg outline-none text-[#1a1a1a] transition-all duration-150">
                                    </div>
                                    <div class="flex gap-2 pt-2">
                                        <button type="submit" class="flex-1 px-4 py-2 bg-[#e8a000] hover:bg-[#d49300] text-[#1a1a1a] text-xs font-bold rounded-lg transition cursor-pointer">Save</button>
                                        <button type="button" @onclick="CancelEdit" class="flex-1 px-4 py-2 bg-white border border-[#e5e3dc] hover:bg-[#f0ede5] text-[#3a3835] text-xs font-bold rounded-lg transition cursor-pointer">Cancel</button>
                                    </div>
                                </form>
                            </div>
                        }
                    }
                }
            </div>
            
            @if (TotalPages > 1)
            {
                <div class="mt-4 px-6 py-4 border border-[#e5e3dc] rounded-xl flex justify-between items-center bg-white shadow-sm">
                    <span class="text-xs text-[#8a8880]">Halaman @CurrentPage dari @TotalPages</span>
                    <div class="flex gap-2">
                        <button disabled="@(CurrentPage == 1)" @onclick="() => LoadData(CurrentPage - 1)" class="px-3 py-1 bg-white border border-[#e5e3dc] rounded text-sm disabled:opacity-50 hover:bg-gray-50">Prev</button>
                        <button disabled="@(CurrentPage == TotalPages)" @onclick="() => LoadData(CurrentPage + 1)" class="px-3 py-1 bg-white border border-[#e5e3dc] rounded text-sm disabled:opacity-50 hover:bg-gray-50">Next</button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<ProductsModal 
    Show="ShowProductsModal" 
    OnClose="CloseProductsModal" 
    Title="@ModalTitle" 
    Type="unit" 
    TargetId="ModalTargetId" 
    IsSuperAdmin="IsSuperAdmin" 
    OnProductDeleted="() => LoadData(CurrentPage)" />

@code {
    private List<UnitDto>? UnitsList;
    private int CurrentPage = 1;
    private int TotalPages = 1;
    
    private UnitViewModel Model = new();
    private UnitViewModel EditModel = new();
    private int? EditingUnitId;
    
    private string? ErrorMessage;
    private string? SuccessMessage;
    private bool IsSuperAdmin = false;

    private bool ShowProductsModal = false;
    private string ModalTitle = "";
    private int ModalTargetId;

    private async Task OpenProductsModal(int id, string name)
    {
        ModalTargetId = id;
        ModalTitle = $"Products with Unit: {name}";
        ShowProductsModal = true;
    }

    private void CloseProductsModal()
    {
        ShowProductsModal = false;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userRole = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
        IsSuperAdmin = userRole == "superadmin";

        await LoadData(1);
    }

    private async Task LoadData(int page)
    {
        CurrentPage = page;
        var result = await UnitService.GetUnitsAsync(CurrentPage, 10);
        UnitsList = result.Units;
        TotalPages = result.TotalPages;
    }

    private async Task SaveUnit()
    {
        if (string.IsNullOrWhiteSpace(Model.name))
        {
            ErrorMessage = "Nama unit wajib diisi.";
            return;
        }

        ErrorMessage = null;
        SuccessMessage = null;

        string? error = await UnitService.CreateUnitAsync(Model);

        if (error != null)
        {
            ErrorMessage = error;
        }
        else
        {
            SuccessMessage = "Unit berhasil ditambahkan.";
            Model = new UnitViewModel(); // Reset form
            await LoadData(CurrentPage);
        }
    }

    private void StartEdit(UnitDto unit)
    {
        EditingUnitId = unit.Id;
        EditModel = new UnitViewModel { name = unit.Name };
        ErrorMessage = null;
        SuccessMessage = null;
    }

    private void CancelEdit()
    {
        EditingUnitId = null;
    }

    private async Task UpdateUnit(int id)
    {
        if (string.IsNullOrWhiteSpace(EditModel.name))
        {
            ErrorMessage = "Nama unit wajib diisi.";
            return;
        }

        ErrorMessage = null;
        SuccessMessage = null;

        string? error = await UnitService.UpdateUnitAsync(id, EditModel);

        if (error != null)
        {
            ErrorMessage = error;
        }
        else
        {
            SuccessMessage = "Unit berhasil diupdate.";
            EditingUnitId = null;
            await LoadData(CurrentPage);
        }
    }

    private async Task DeleteUnit(int id)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Apakah Anda yakin ingin menghapus unit ini?");
        if (confirmed)
        {
            await UnitService.DeleteUnitAsync(id);
            SuccessMessage = "Unit berhasil dihapus.";
            await LoadData(CurrentPage);
        }
    }
}