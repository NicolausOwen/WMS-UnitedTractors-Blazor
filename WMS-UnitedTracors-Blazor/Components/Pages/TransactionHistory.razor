@page "/TransactionHistory"
@page "/Transactions/History"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using UT_WMSDotnet.Models
@using WMS_UnitedTracors_Blazor.Services
@inject TransactionService TransactionService
@inject DivisionService DivisionService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>WMS - Transaction History</PageTitle>

<div class="py-8 md:py-12 bg-[#f5f4f0] min-h-screen font-sans">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="mb-6">
            <h1 class="text-[1.6rem] font-bold text-[#1a1a1a] leading-none tracking-tight">Riwayat <span class="text-[#e8a000]">Transaksi</span></h1>
            <div class="text-[0.72rem] font-medium text-[#a09e99] mt-1">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</div>
        </div>

        <div class="bg-white rounded-xl border border-[#e5e3dc] overflow-hidden shadow-sm mb-8">
            @* Collapsible Header *@
            <div @onclick="ToggleFilters" 
                 role="button"
                 tabindex="0"
                 class="@(ShowFilters ? "border-b border-[#e5e3dc]" : "") px-5 py-3.5 bg-[#faf9f5] flex items-center justify-between cursor-pointer select-none hover:bg-[#f3f2eb] transition duration-150 group outline-none focus:bg-[#f3f2eb]">
                <div class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-[#8a8880] group-hover:text-gray-700 transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 0 1-.659 1.591l-5.432 5.432a2.25 2.25 0 0 0-.659 1.591v2.927a2.25 2.25 0 0 1-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 0 0-.659-1.591L3.659 7.409A2.25 2.25 0 0 1 3 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0 1 12 3Z"/>
                    </svg>
                    <span class="text-[0.68rem] font-extrabold text-[#5a5855] group-hover:text-gray-900 tracking-wider uppercase transition">Filter Pencarian</span>
                    @if(HasActiveFilters)
                    {
                        <span class="px-2 py-0.5 rounded text-[9px] font-extrabold bg-[#fff8e6] text-[#b37a00] border border-[#ffe099] uppercase tracking-wider">
                            Aktif: @GetActiveFiltersText()
                        </span>
                    }
                </div>
                <div class="text-[#8a8880] group-hover:text-gray-700 transition">
                    <svg class="w-4 h-4 transition-transform duration-200 @(!ShowFilters ? "rotate-180" : "")" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
                    </svg>
                </div>
            </div>

            @* Collapsible Content *@
            @if (ShowFilters)
            {
                <div class="px-5 py-4 bg-white transition-all duration-200">
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:flex lg:items-end gap-4">
                        <div class="flex-1 min-w-[150px]">
                            <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Start Date</label>
                            <input type="date" @bind="StartDate" class="block w-full px-3 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none transition-colors duration-150 text-[#1a1a1a]">
                        </div>
                        <div class="flex-1 min-w-[150px]">
                            <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">End Date</label>
                            <input type="date" @bind="EndDate" class="block w-full px-3 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none transition-colors duration-150 text-[#1a1a1a]">
                        </div>
                        <div class="min-w-[150px]">
                            <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Filter Type</label>
                            <select @bind="FilterType" @bind:after="OnFilterTypeChanged" class="block w-full px-3 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none transition-colors duration-150 text-[#1a1a1a]">
                                <option value="">All Types</option>
                                <option value="IN">STOCK IN</option>
                                <option value="OUT">STOCK OUT</option>
                            </select>
                        </div>
                        @if (FilterType == "OUT")
                        {
                            <div class="min-w-[150px]">
                                <label class="block text-[0.62rem] font-bold tracking-wider uppercase text-[#8a8880] mb-1.5">Request Type</label>
                                <select @bind="FilterRequestType" @bind:after="OnFilterRequestTypeChanged" class="block w-full px-3 py-2 text-[0.82rem] bg-[#f5f4f0] focus:bg-white border border-[#e5e3dc] focus:border-[#e8a000] rounded-lg outline-none transition-colors duration-150 text-[#1a1a1a]">
                                    <option value="">All Request Types</option>
                                    <option value="GIVEAWAY">Diminta / Giveaway</option>
                                    <option value="BORROW">Dipinjam / Borrow</option>
                                </select>
                            </div>
                        }
                        <div class="flex gap-2 w-full lg:w-auto justify-end">
                            <button type="button" @onclick="() => LoadData(1)" class="px-5 py-2 bg-[#e8a000] text-[#1a1a1a] text-xs font-bold rounded-lg transition active:scale-95 cursor-pointer whitespace-nowrap hover:bg-[#d49300]">Apply</button>
                            <button type="button" @onclick="ResetFilters" class="px-5 py-2 bg-white border border-[#e5e3dc] text-[#3a3835] text-xs font-bold rounded-lg cursor-pointer hover:bg-gray-50 transition">Reset</button>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="mb-6 flex items-center gap-3 bg-[#eef9f0] border border-[#b8e8c0] text-[#1a7a30] px-4 py-3 rounded-lg text-sm font-semibold">
                <svg class="w-4 h-4 shrink-0 text-[#1a7a30]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                @SuccessMessage
            </div>
        }
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="mb-6 flex items-center gap-3 bg-[#fef0f0] border border-[#f8c0c0] text-[#d94040] px-4 py-3 rounded-lg text-sm font-semibold">
                <svg class="w-4 h-4 shrink-0 text-[#d94040]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                @ErrorMessage
            </div>
        }

        @if (Transactions == null || !Transactions.Any())
        {
            <div class="bg-white p-16 rounded-xl border border-[#e5e3dc] text-center shadow-sm">
                <svg class="w-16 h-16 text-[#d1d0cb] mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
                <p class="text-base font-bold text-[#8a8880] tracking-wide">Tidak ada riwayat transaksi.</p>
                <p class="text-xs text-[#a09e99] mt-1">Coba sesuaikan filter atau rentang tanggal Anda.</p>
            </div>
        }
        else
        {
            <div class="space-y-4">
                @foreach (var group in GroupedTransactions)
                {
                    var items = group.Value;
                    var firstItem = items.First();
                    bool isExpanded = ExpandedGroups.Contains(group.Key);
                    var groupId = group.Key;
                    
                    var isGiveaway = firstItem.type == "OUT" && firstItem.request_type == "GIVEAWAY";
                    var isBorrow = firstItem.type == "OUT" && firstItem.request_type == "BORROW";
                    var isStockIn = firstItem.type == "IN";

                    string borderColor = isGiveaway ? "border-[#d8eadb]" : (isBorrow ? "border-[#d9e6f3]" : "border-[#e5e3dc]");
                    string hoverBg = isGiveaway ? "hover:bg-[#f6fbf7]" : (isBorrow ? "hover:bg-[#f8fbff]" : "hover:bg-[#faf9f5]");
                    string iconBg = isGiveaway ? "bg-[#eef9f0] border-[#d8eadb]" : (isBorrow ? "bg-[#eef6fd] border-[#d9e6f3]" : "bg-[#f5f4f0] border-[#e5e3dc]");

                    <div class="bg-white rounded-xl border overflow-hidden shadow-sm transition-all duration-200 @borderColor">
                        <!-- Header Accordion -->
                        <div @onclick="() => ToggleGroup(groupId)" class="px-5 py-4 cursor-pointer transition flex flex-row items-center justify-between gap-4 @hoverBg">
                            <div class="flex items-center gap-4 flex-1 min-w-0">
                                <div class="w-10 h-10 rounded-full @iconBg border flex items-center justify-center shrink-0">
                                    @if(isGiveaway) {
                                        <svg class="w-5 h-5 text-[#1a7a30]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                                    } else if(isBorrow) {
                                        <svg class="w-5 h-5 text-[#1a6b8a]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                    } else {
                                        <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/></svg>
                                    }
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="flex flex-col sm:flex-row sm:items-center gap-2 mb-1">
                                        <h3 class="font-syne font-bold text-[#1a1a1a] text-sm sm:text-base truncate">
                                            @(firstItem.type == "IN" ? "Stock In" : (string.IsNullOrEmpty(firstItem.event_name) ? (isGiveaway ? "Request Barang" : "Peminjaman Barang") : firstItem.event_name))
                                        </h3>
                                        <div class="flex flex-wrap items-center gap-1.5 shrink-0">
                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#f5f4f0] text-[#8a8780] border border-[#e5e3dc]">@items.Count Items</span>
                                            @if(isGiveaway) {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#eef9f0] text-[#1a7a30] border border-[#b8e8c0]">Giveaway</span>
                                            } else if (isBorrow) {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#eef6fd] text-[#1a6b8a] border border-[#d9e6f3]">Borrow</span>
                                            } else {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-white text-gray-600 border border-gray-200">Stock In</span>
                                            }
                                            
                                            @if(firstItem.status == "PENDING" || firstItem.status == "PENDING_STAFF_INVENTORY" || firstItem.status == "PENDING_ADMIN" || firstItem.status == "PENDING_MANAGER") {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#fff8e6] text-[#b37a00] border border-[#ffe099]">Waiting</span>
                                            } else if(firstItem.status == "APPROVED" || firstItem.status == "COMPLETED") {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#eef9f0] text-[#1a7a30] border border-[#b8e8c0]">Approved</span>
                                            } else if(firstItem.status == "REVISION" || firstItem.status == "REVISION_BY_STAFF_INVENTORY" || firstItem.status == "REVISION_BY_ADMIN" || firstItem.status == "REVISION_BY_MANAGER") {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#fffbeb] text-[#d97706] border border-[#fde68a]">Revision</span>
                                            } else if(firstItem.status == "REJECTED") {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#fef0f0] text-[#d94040] border border-[#f8c0c0]">Rejected</span>
                                            } else if(firstItem.status == "WAITING_HANDOVER" || firstItem.status == "WAITING_ADMIN_HANDOVER" || firstItem.status == "WAITING_HANDOVER_CONFIRM") {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#e0f2fe] text-[#1a6b8a] border border-[#bae6fd]">Handover Process</span>
                                            } else {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#f5f4f0] text-[#8a8780] border border-[#e5e3dc]">@firstItem.status</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-gray-500">
                                        <div class="flex items-center gap-1.5">
                                            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                                            @(firstItem.applicant_name ?? firstItem.Requester?.name ?? "-")
                                        </div>
                                        <div class="flex items-center gap-1.5">
                                            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                            @(firstItem.created_at.ToString("MMM dd, yyyy"))
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="flex items-center gap-3 shrink-0">
                                <div class="w-8 h-8 rounded-full flex items-center justify-center text-gray-400 hover:text-[#1a1a1a] hover:bg-[#f0ede5] transition">
                                    <svg class="w-5 h-5 transition-transform duration-200 @(isExpanded ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                                </div>
                            </div>
                        </div>

                        @if(isExpanded)
                        {
                            <div class="border-t border-[#e5e3dc] bg-[#faf9f5] p-5">
                                <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
                                    
                                    <!-- Kolom 1: Vertical Timeline (1/4 Lebar pada Desktop) -->
                                    <div class="lg:col-span-1 bg-white p-5 rounded-2xl border border-[#e5e3dc] shadow-sm flex flex-col">
                                        <h4 class="text-xs font-bold text-[#1a1a1a] uppercase tracking-wider mb-5 pb-2 border-b border-[#f0ede5] flex items-center gap-2">
                                            <svg class="w-4 h-4 text-[#e8a000]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                                            Status Pelacakan
                                        </h4>
                                        
                                        <div class="relative flex flex-col space-y-6 my-2 pl-2">
                                            <!-- Vertical connecting line -->
                                            <div class="absolute top-2 bottom-2 bg-gray-300 z-0" style="width: 2px; left: 15px;"></div>

                                            @{ var steps = GetGroupSteps(items); }
                                            @for (int i = 0; i < steps.Count; i++)
                                            {
                                                var step = steps[i];
                                                <div class="flex items-start gap-4 relative z-10">
                                                    <!-- Circle indicator wrapper -->
                                                    <div class="w-4 h-4 flex items-center justify-center shrink-0 mt-0.5 bg-white border rounded-full z-10
                                                        @(step.Status == "DONE" ? "border-emerald-600" :
                                                          step.Status == "ACTIVE" ? "border-blue-600 animate-pulse" :
                                                          step.Status == "WARNING" ? "border-rose-600" :
                                                          "border-gray-300")">
                                                        @if (step.Status == "DONE") {
                                                            <div class="w-full h-full rounded-full bg-[#1a7a30] flex items-center justify-center shrink-0">
                                                                <svg class="w-2.5 h-2.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                                                            </div>
                                                        } else if (step.Status == "ACTIVE") {
                                                            <span class="relative flex h-2 w-2 items-center justify-center">
                                                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
                                                                <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-600"></span>
                                                            </span>
                                                        } else if (step.Status == "WARNING") {
                                                            <div class="w-full h-full rounded-full bg-[#d94040] flex items-center justify-center shrink-0">
                                                                <svg class="w-2.5 h-2.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                                                            </div>
                                                        } else {
                                                            <div class="w-1.5 h-1.5 rounded-full bg-gray-300"></div>
                                                        }
                                                    </div>
                                                    <!-- Text Info -->
                                                    <div class="flex flex-col min-w-0">
                                                        <span class="text-xs font-bold @(step.Status == "DONE" ? "text-[#1a7a30]" : step.Status == "ACTIVE" ? "text-blue-600" : step.Status == "WARNING" ? "text-[#d94040]" : "text-gray-500")">@step.Name</span>
                                                        <span class="text-[10px] text-gray-400 leading-tight">
                                                            @if (step.Status == "DONE") {
                                                                <span>Selesai dilakukan</span>
                                                            } else if (step.Status == "ACTIVE") {
                                                                <span>Sedang diproses</span>
                                                            } else if (step.Status == "WARNING") {
                                                                <span>Butuh perhatian / revisi</span>
                                                            } else {
                                                                <span>Menunggu antrean</span>
                                                            }
                                                        </span>
                                                        @if (step.CompletedAt.HasValue) {
                                                            <span class="text-[9px] text-gray-400 mt-0.5 flex items-center gap-1">
                                                                <svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0"/></svg>
                                                                @step.CompletedAt.Value.ToString("dd MMM yyyy HH:mm")
                                                            </span>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- Kolom 2: Detail, Aksi, & Daftar Produk (3/4 Lebar pada Desktop) -->
                                    <div class="lg:col-span-3 space-y-4">
                                    
                                    <!-- Dokumen Pembukuan (PDF) -->
                                    @if (firstItem.type == "OUT") {
                                        <div class="bg-white p-4 rounded-xl border border-[#e5e3dc] shadow-sm flex flex-wrap gap-2.5 items-center">
                                            <span class="text-[0.65rem] font-bold uppercase tracking-wider text-[#8a8780] mr-2 block w-full sm:w-auto">Dokumen Pembukuan (PDF):</span>

                                            <a href="/api/pdf/receipt-request/@groupId" target="_blank" @onclick:stopPropagation="true" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-gray-50 hover:bg-gray-100 border border-gray-200 text-gray-700 rounded-lg text-xs font-semibold transition shadow-sm">
                                                <svg class="w-3.5 h-3.5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                                1. Bukti Pengajuan
                                            </a>
                                            
                                            @if (firstItem.status == "WAITING_HANDOVER" || firstItem.status == "WAITING_ADMIN_HANDOVER" || firstItem.status == "APPROVED" || firstItem.status == "COMPLETED" || firstItem.status == "REJECTED") {
                                                <a href="/api/pdf/receipt/@groupId" target="_blank" @onclick:stopPropagation="true" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-purple-50 hover:bg-purple-100 border border-purple-200 text-purple-700 rounded-lg text-xs font-semibold transition shadow-sm">
                                                    <svg class="w-3.5 h-3.5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                                    2. Bukti Penyerahan
                                                </a>
                                            } else {
                                                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-gray-100/50 border border-gray-200/50 text-gray-400 rounded-lg text-xs font-semibold cursor-not-allowed">
                                                    <svg class="w-3.5 h-3.5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                                    2. Bukti Penyerahan
                                                </span>
                                            }
                                            
                                            @if (isBorrow) {
                                                if (firstItem.returned_quantity >= firstItem.quantity && firstItem.status == "APPROVED") {
                                                    <a href="/api/pdf/return-receipt/@groupId" target="_blank" @onclick:stopPropagation="true" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 text-emerald-700 rounded-lg text-xs font-semibold transition shadow-sm">
                                                        <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                                        3. Bukti Pengembalian
                                                    </a>
                                                } else {
                                                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-gray-100/50 border border-gray-200/50 text-gray-400 rounded-lg text-xs font-semibold cursor-not-allowed">
                                                        <svg class="w-3.5 h-3.5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                                        3. Bukti Pengembalian
                                                    </span>
                                                }
                                            }
                                        </div>
                                    }

                                    <div class="bg-white p-4 rounded-xl border border-[#e5e3dc] shadow-sm">
                                        <div class="grid grid-cols-1 sm:grid-cols-4 gap-4 divide-y sm:divide-y-0 sm:divide-x divide-[#e5e3dc]">
                                            <!-- APPLICANT -->
                                            <div class="flex flex-col justify-center sm:px-4 first:pl-0">
                                                <span class="block text-[10px] font-bold text-[#8a8880] uppercase tracking-wider mb-1">Applicant</span>
                                                <span class="text-xs font-bold text-[#1a1a1a] leading-tight">@(firstItem.applicant_name ?? firstItem.Requester?.name ?? "-")</span>
                                                <span class="text-[10px] text-gray-500 mt-0.5">NRP: @(firstItem.applicant_nrp ?? "-")</span>
                                            </div>
                                            <!-- DIVISION -->
                                            <div class="flex flex-col justify-center sm:px-4 pt-3 sm:pt-0">
                                                <span class="block text-[10px] font-bold text-[#8a8880] uppercase tracking-wider mb-1">Division</span>
                                                <span class="text-xs font-bold text-[#1a1a1a] leading-tight">@(firstItem.Division?.name ?? "-")</span>
                                            </div>
                                            <!-- EVENT / PROGRAM -->
                                            <div class="flex flex-col justify-center sm:px-4 pt-3 sm:pt-0">
                                                <span class="block text-[10px] font-bold text-[#8a8880] uppercase tracking-wider mb-1">Event / Program</span>
                                                @if (firstItem.type == "OUT") {
                                                    <span class="text-xs font-bold text-[#1a1a1a] leading-tight">@(firstItem.event_name ?? "-")</span>
                                                    <span class="text-[10px] text-gray-500 mt-0.5">@(firstItem.event_date?.ToString("dd MMM yyyy") ?? "-")</span>
                                                } else {
                                                    <span class="text-gray-400 text-xs font-medium">-</span>
                                                }
                                            </div>
                                            <!-- TOTAL CREDIT -->
                                            <div class="flex flex-col justify-center sm:px-4 pt-3 sm:pt-0">
                                                <span class="block text-[10px] font-bold text-[#8a8880] uppercase tracking-wider mb-1">Total Credit</span>
                                                @if (firstItem.type == "OUT") {
                                                    <span class="text-xs font-bold text-[#e8a000] flex items-center gap-1.5 leading-tight">
                                                        @{ var totalCredit = items.Where(i => i.request_type == "GIVEAWAY").Sum(i => i.quantity * (i.Product?.value ?? 0)); }
                                                        @if(totalCredit > 0)
                                                        {
                                                            <svg class="w-3.5 h-3.5 text-[#e8a000] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                                            @(((double)totalCredit).ToString("N0")) <span class="text-[10px] font-normal text-gray-500">pts</span>
                                                        } else {
                                                            <span class="text-gray-400 font-normal">-</span>
